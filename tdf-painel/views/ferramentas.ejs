    <a href="/ferramentas/gerador-propostas" target="_blank" style="position:relative;display:block;background:linear-gradient(135deg, #0F1420 0%, #20191f 100%);border:1px solid #EC489940;border-radius:16px;padding:24px;text-decoration:none;color:#fff;transition:all 0.3s;box-shadow:0 0 20px rgba(236,72,153,0.12);">

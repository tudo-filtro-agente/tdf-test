}
function ixFiltrarTpls(){
  ixRenderTpls();
  // Mostra/esconde botão de limpar
  const inp = document.getElementById('ix-tpl-search');
  const clr = document.getElementById('ix-tpl-clear');
  if (clr) clr.style.display = inp && inp.value ? 'block' : 'none';
}
function ixRenderTpls(){
  const q = (document.getElementById('ix-tpl-search')?.value || '').toLowerCase().trim();
  const list = _IX_TEMPLATES.filter(t => {
    const txt = (t.elementName||t.name||'') + ' ' + (t.bodyOriginal||t.body||'');
    return !q || txt.toLowerCase().includes(q);
  });
  // Atualiza contador no header
  const cnt = document.getElementById('ix-tpl-count');
  if (cnt) cnt.textContent = q ? `${list.length}/${_IX_TEMPLATES.length}` : `${_IX_TEMPLATES.length} templates`;
  if (!list.length) {
    document.getElementById('ix-tpl-list').innerHTML = `<div style="color:#888;padding:30px;text-align:center;font-size:12px">Nenhum template combina com "<strong style=\"color:#fbbf24\">${q.replace(/</g,'&lt;')}</strong>"</div>`;
    return;
  }
  document.getElementById('ix-tpl-list').innerHTML = list.map(t => {
    const nome = t.elementName || t.name || '?';
    const body = t.bodyOriginal || t.body || '';
    const params = (body.match(/\{\{\d+\}\}/g) || []).length;
    return `<div class="ix-tpl-item" onclick="ixUsarTemplate('${nome}',${params})">
      <div class="nome">${nome}${params?` <span style="color:#fbbf24;font-size:10px">${params} parâmetro(s)</span>`:''}</div>
      <div class="body">${body.slice(0, 200)}${body.length>200?'...':''}</div>
    </div>`;
  }).join('');
}
async function ixUsarTemplate(nome, qtdParams){
  const conv = _IX_CONVS.find(c => c.dealId === _IX_ATUAL);
  if (!conv) return;
  let params = [];
  if (qtdParams > 0) {
    for (let i = 1; i <= qtdParams; i++) {
      const v = prompt(`Parâmetro {{${i}}}:`, i === 1 ? (conv.nome?.split(' ')[0]||'') : '');
      if (v === null) return;
      params.push(v);
    }
  }
  document.getElementById('ix-tpl-modal').style.display = 'none';
  const btn = document.getElementById('ix-send');
  btn.disabled = true; btn.textContent = '⏳ Enviando template...';
  try {
    const r = await fetch('/inbox/template', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ phone: conv.phone, templateName: nome, params }) });
    const d = await r.json();
    if (d.error) { alert('❌ ' + d.error); }
    else { alert('✅ Template enviado!'); await ixAbrir(_IX_ATUAL, conv.phone); }
  } catch(e) { alert(e.message); }
  btn.disabled = false; btn.textContent = 'Enviar';
}


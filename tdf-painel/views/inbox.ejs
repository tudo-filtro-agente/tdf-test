<% const activePage = 'inbox'; const pageTitle = 'Inbox WATI'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
/* ============================================================
   INBOX WATI — DESIGN SYSTEM
   Tokens locais (não tocam em :root global)
   ============================================================ */
.ix-wrap{
  --ix-bg:#0a0a0a;
  --ix-surface:#0e0e0e;
  --ix-surface-2:#141414;
  --ix-surface-3:#1a1a1a;
  --ix-border:#1f2329;
  --ix-border-strong:#2a2f37;
  --ix-text:#e8eaed;
  --ix-text-muted:#8a9099;
  --ix-text-faint:#5b6068;
  --ix-accent:#5ba3f5;
  --ix-wa-green:#00a884;
  --ix-wa-bubble:#005c4b;
  --ix-wa-bubble-end:#017561;
  --ix-purple:#a371f7;
  --ix-gold:#f0c040;
  --ix-danger:#ef4444;
  max-width:1500px;margin:0 auto;padding:0;display:flex;
  height:calc(100vh - 64px);max-height:calc(100vh - 64px);
  background:var(--ix-bg);overflow:hidden;width:100%;
  font-feature-settings:"cv11","ss01";
}
html[data-theme="light"] .ix-wrap{
  --ix-bg:#F2F4F8;
  --ix-surface:#FFFFFF;
  --ix-surface-2:#F6F8FA;
  --ix-surface-3:#EDF1F5;
  --ix-border:#D8DEE6;
  --ix-border-strong:#C4CCD6;
  --ix-text:#1F2328;
  --ix-text-muted:#59636E;
  --ix-text-faint:#77808B;
  --ix-accent:#2563EB;
  --ix-wa-bubble:#D9FDD3;
  --ix-wa-bubble-end:#C8F5C0;
  --ix-purple:#8250DF;
  --ix-gold:#9A6700;
  --ix-danger:#DC2626;
}

.tdf-app-main:has(.ix-wrap){padding:0 !important}

/* ============================================================
   COLUNA 1 — LISTA DE CONVERSAS
   ============================================================ */
.ix-side{width:332px;border-right:1px solid var(--ix-border);display:flex;flex-direction:column;background:var(--ix-surface);overflow:hidden;flex-shrink:0}
.ix-side-h{padding:12px 16px;border-bottom:1px solid var(--ix-border);display:flex;align-items:center;gap:6px;background:var(--ix-surface)}
.ix-side-h h2{margin:0;font-size:14px;color:var(--ix-text);flex:1;font-weight:700;letter-spacing:-.2px}
.ix-side-h .badge{background:var(--ix-danger);color:var(--text);font-size:10px;font-weight:800;padding:2px 7px;border-radius:10px;line-height:1.4}
.ix-search{padding:8px 14px;border-bottom:1px solid var(--ix-border)}
.ix-search input{width:100%;padding:8px 12px 8px 32px;background:var(--ix-surface-2);border:1px solid var(--ix-border-strong);border-radius:8px;color:var(--ix-text);font-size:12px;outline:none;transition:border-color .15s,background .15s;
  background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%238a9099' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='11' cy='11' r='8'/><line x1='21' y1='21' x2='16.65' y2='16.65'/></svg>");
  background-repeat:no-repeat;background-position:10px center;
}
.ix-search input::placeholder{color:var(--ix-text-faint)}
.ix-search input:focus{border-color:var(--ix-accent);background:var(--ix-surface-3)}
.ix-list{flex:1;overflow-y:auto;scrollbar-width:thin;scrollbar-color:#2a2a2a transparent}
.ix-list::-webkit-scrollbar{width:6px}
.ix-list::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:3px}

/* Item de conversa — denso, hierárquico, sem ruído */
.ix-conv{padding:9px 14px 9px 16px;cursor:pointer;transition:background .12s ease;position:relative;border-bottom:1px solid rgba(255,255,255,.025);display:grid;grid-template-columns:36px 1fr auto;gap:10px;align-items:start}
.ix-conv:hover{background:rgba(255,255,255,.025)}
.ix-conv.active{background:rgba(91,163,245,.08)}
.ix-conv.active::before{content:'';position:absolute;left:0;top:6px;bottom:6px;width:3px;background:var(--ix-accent);border-radius:0 2px 2px 0}
/* Indicador "novo" — ponto verde lateral discreto */
.ix-conv.novo::after{content:'';position:absolute;right:14px;top:50%;transform:translateY(-50%);width:8px;height:8px;background:var(--ix-wa-green);border-radius:50%;box-shadow:0 0 0 3px rgba(0,168,132,.18);animation:ixPulse 1.6s infinite}
.ix-conv.novo .preview{color:#cbd5db;font-weight:600}
/* Avatar/iniciais */
.ix-conv .avatar{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,#1f2937,#374151);display:flex;align-items:center;justify-content:center;color:#cbd5db;font-size:13px;font-weight:700;flex-shrink:0;letter-spacing:-.2px;border:1px solid rgba(255,255,255,.05)}
.ix-conv .avatar.tier-d{background:linear-gradient(135deg,#3a1d63,#7c3aed);color:#fff;border-color:#a371f7}
.ix-conv .avatar.tier-o{background:linear-gradient(135deg,#5a4310,#d4a017);color:#1a1a00;border-color:#f0c040}
.ix-conv .avatar.tier-p{background:linear-gradient(135deg,#374151,#6b7280);color:#f3f4f6}
.ix-conv .avatar.tier-b{background:linear-gradient(135deg,#3a2a18,#87592a);color:#fff8e7}
.ix-conv .avatar.ia{background:linear-gradient(135deg,#4c1d95,#a371f7);color:#fff;border-color:#a371f7;box-shadow:0 0 0 2px rgba(167,113,247,.18)}
.ix-conv .body{min-width:0;display:flex;flex-direction:column;gap:1px;padding-right:18px}
.ix-conv .nome{font-size:13px;font-weight:600;color:var(--ix-text);display:flex;align-items:center;gap:5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;letter-spacing:-.1px}
.ix-conv .nome .name-text{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1;min-width:0}
.ix-conv .nome .tier-icon{font-size:11px;flex-shrink:0;line-height:1}
.ix-conv .preview{font-size:11.5px;color:var(--ix-text-muted);line-height:1.35;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ix-conv .meta{font-size:10px;color:var(--ix-text-faint);display:flex;align-items:center;gap:4px;flex-wrap:wrap;line-height:1.4}
.ix-conv .meta .dot{opacity:.5}
.ix-conv .right{display:flex;flex-direction:column;align-items:flex-end;gap:3px;flex-shrink:0}
.ix-conv .ts{font-size:10px;color:var(--ix-text-faint);font-variant-numeric:tabular-nums;font-weight:500;white-space:nowrap}
.ix-conv.novo .ts{color:var(--ix-wa-green);font-weight:700}
.ix-conv .badge-count{background:var(--ix-wa-green);color:var(--text);font-size:10px;font-weight:700;padding:1px 6px;border-radius:9px;min-width:18px;text-align:center;line-height:1.4}
/* Mini-badges (PRÉ-LEAD, IA, fonte) */
.ix-mini{display:inline-flex;align-items:center;gap:3px;padding:1px 6px;border-radius:6px;font-size:9px;font-weight:700;line-height:1.4;letter-spacing:.2px;flex-shrink:0;text-transform:uppercase}
.ix-mini.ia{background:rgba(167,113,247,.16);color:#c4a4ff;border:1px solid rgba(167,113,247,.3)}
.ix-mini.prelead{background:rgba(156,163,175,.1);color:#9ca3af;border:1px dashed #4a5260}
.ix-mini.semdeal{background:rgba(239,68,68,.14);color:#fca5a5;border:1px solid rgba(239,68,68,.45);animation:semDealPulse 2s infinite}
@keyframes semDealPulse{0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,.4)}50%{box-shadow:0 0 0 4px rgba(239,68,68,0)}}
.ix-mini.fonte{padding:1px 6px}
/* Tier text colors (re-export) */
.tier-d{color:#A371F7}.tier-o{color:#F0C040}.tier-p{color:#9ca3af}.tier-b{color:#a87c5e}
@keyframes ixPulse{0%,100%{opacity:1;transform:translateY(-50%) scale(1)}50%{opacity:.5;transform:translateY(-50%) scale(.85)}}

/* ============================================================
   COLUNA 2 — CONVERSA (centro)
   ============================================================ */
.ix-main{flex:1;display:flex;flex-direction:column;background:var(--ix-bg);overflow:hidden;min-width:0;position:relative}

/* Header da conversa: avatar + nome + presença + menu de ações */
.ix-main-h{padding:10px 18px;border-bottom:1px solid var(--ix-border);background:var(--ix-surface);display:flex;align-items:center;gap:12px;flex-shrink:0;min-height:60px}
.ix-main-h .avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#1f2937,#374151);display:flex;align-items:center;justify-content:center;color:#cbd5db;font-size:14px;font-weight:700;flex-shrink:0;border:1px solid rgba(255,255,255,.06);letter-spacing:-.3px}
.ix-main-h .info{flex:1;min-width:0}
.ix-main-h .info .nome{font-size:15px;font-weight:700;color:var(--ix-text);letter-spacing:-.2px;display:flex;align-items:center;gap:6px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.ix-main-h .info .meta{font-size:11px;color:var(--ix-text-muted);margin-top:1px;display:flex;align-items:center;gap:6px;flex-wrap:wrap;line-height:1.4}
.ix-main-h .info .meta .sep{opacity:.4}
.ix-main-h .info .meta .online{color:var(--ix-wa-green);display:inline-flex;align-items:center;gap:4px;font-weight:600}
.ix-main-h .info .meta .online::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--ix-wa-green)}
.ix-main-h .actions{display:flex;align-items:center;gap:4px;flex-shrink:0}
.ix-actbtn{background:transparent;color:var(--ix-text-muted);border:1px solid transparent;border-radius:8px;width:36px;height:36px;display:inline-flex;align-items:center;justify-content:center;font-size:15px;cursor:pointer;transition:all .12s;text-decoration:none;line-height:1}
.ix-actbtn:hover{background:var(--ix-surface-3);color:var(--ix-text);border-color:var(--ix-border-strong);text-decoration:none}
.ix-actbtn.copied{background:rgba(0,168,132,.15);color:var(--ix-wa-green);border-color:var(--ix-wa-green)}
/* Menu drop pra ações secundárias */
.ix-actmenu{position:relative}
.ix-actmenu-pop{display:none;position:absolute;right:0;top:calc(100% + 6px);background:var(--bg-card);border:1px solid var(--ix-border-strong);border-radius:8px;min-width:180px;padding:4px;z-index:50;box-shadow:0 12px 28px rgba(0,0,0,.55)}
.ix-actmenu.open .ix-actmenu-pop{display:block}
.ix-actmenu-pop a,.ix-actmenu-pop button{display:flex;align-items:center;gap:8px;padding:8px 10px;color:var(--ix-text);text-decoration:none;font-size:12px;border-radius:6px;background:transparent;border:none;width:100%;text-align:left;cursor:pointer;font-family:inherit}
.ix-actmenu-pop a:hover,.ix-actmenu-pop button:hover{background:var(--ix-surface-3);text-decoration:none}

/* FIX SCROLL */
#ix-conversa[style*="flex"]{min-height:0;height:100%;flex:1 1 0;overflow:hidden}
.ix-input{flex-shrink:0}

/* ============================================================
   MENSAGENS — bolhas estilo WhatsApp Business + tipografia clean
   ============================================================ */
.ix-msgs{
  flex:1 1 0 !important;min-height:0 !important;
  overflow-y:auto !important;overflow-x:hidden !important;
  padding:18px 24px 22px;display:flex;flex-direction:column;gap:4px;
  height:0 !important;
  background:
    radial-gradient(circle at 20% 10%, rgba(167,113,247,.025), transparent 40%),
    radial-gradient(circle at 80% 90%, rgba(0,168,132,.025), transparent 40%),
    var(--ix-bg);
}
.ix-msgs::-webkit-scrollbar{width:8px}
.ix-msgs::-webkit-scrollbar-track{background:transparent}
.ix-msgs::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:4px}
.ix-msgs::-webkit-scrollbar-thumb:hover{background:#3a3a3a}

/* Bolha base */
.ix-msg{
  max-width:65%;padding:7px 11px 18px;border-radius:8px;
  font-size:13.5px;line-height:1.42;word-break:break-word;
  position:relative;letter-spacing:-.05px;
  box-shadow:0 1px 1px rgba(0,0,0,.35);
  animation:ixMsgIn .18s ease-out;
}
@keyframes ixMsgIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:translateY(0)}}
/* Bolha cliente — esquerda, escuro neutro */
.ix-msg.lead{background:#1f2937;color:#fff;align-self:flex-start;border-bottom-left-radius:2px;margin-top:4px}
.ix-msg.lead.same-author{margin-top:1px;border-top-left-radius:8px}
/* Bolha nossa — direita, verde WhatsApp Business */
.ix-msg.nos{background:var(--ix-wa-bubble);color:var(--text);align-self:flex-end;border-bottom-right-radius:2px;margin-top:4px}
.ix-msg.nos.same-author{margin-top:1px;border-top-right-radius:8px}
/* Tail (rabinho) só na primeira bolha do bloco */
.ix-msg.lead:not(.same-author)::before{
  content:'';position:absolute;left:-6px;bottom:0;
  width:0;height:0;
  border:6px solid transparent;
  border-right-color:#1f2937;border-bottom-color:#1f2937;
  border-bottom-left-radius:2px;
}
.ix-msg.nos:not(.same-author)::before{
  content:'';position:absolute;right:-6px;bottom:0;
  width:0;height:0;
  border:6px solid transparent;
  border-left-color:var(--ix-wa-bubble);border-bottom-color:var(--ix-wa-bubble);
  border-bottom-right-radius:2px;
}
/* Mensagem de sistema — discreta, centralizada */
.ix-msg.sistema{
  align-self:center;max-width:85%;
  background:rgba(255,255,255,.04);
  color:var(--ix-text-faint);font-size:11px;font-style:italic;
  text-align:center;padding:5px 14px;border-radius:12px;
  box-shadow:none;letter-spacing:.1px;
  margin:8px 0;
}
.ix-msg.sistema::before{display:none}
/* Timestamp inline no canto da bolha */
.ix-msg .ts{
  position:absolute;right:9px;bottom:3px;
  font-size:10px;color:rgba(255,255,255,.55);
  font-weight:500;font-variant-numeric:tabular-nums;
  display:inline-flex;align-items:center;gap:3px;
  white-space:nowrap;letter-spacing:.1px;
}
.ix-msg.lead .ts{color:rgba(232,234,237,.45)}
.ix-msg.nos .ts{color:rgba(220,255,240,.7)}
.ix-msg .ts .checks{font-size:11px;line-height:1}
.ix-msg.nos .ts .checks.read{color:#53bdeb}
/* Nome do operador acima da bolha */
.ix-msg .op{
  font-size:11px;color:#86efac;margin-bottom:3px;
  font-weight:700;letter-spacing:.1px;
  display:flex;align-items:center;gap:5px;
}
.ix-msg.lead .op{color:var(--ix-purple)}
.ix-msg .op .op-avatar{
  width:16px;height:16px;border-radius:50%;
  background:linear-gradient(135deg,#16a34a,#22c55e);
  display:inline-flex;align-items:center;justify-content:center;
  font-size:8px;color:#fff;font-weight:800;
}
.ix-msg.lead .op .op-avatar{background:linear-gradient(135deg,#6d28d9,#a371f7)}
/* Espaço pra timestamp não sobrepor o texto */
.ix-msg:not(.sistema){padding-right:60px}

/* Date separator (opcional, futuro) */
.ix-date-sep{align-self:center;background:rgba(255,255,255,.05);color:var(--ix-text-muted);font-size:10px;font-weight:600;padding:4px 12px;border-radius:10px;text-transform:uppercase;letter-spacing:.5px;margin:10px 0}

/* ============================================================
   INPUT — área de digitação
   ============================================================ */
.ix-input{padding:10px 18px;border-top:1px solid var(--ix-border);background:var(--ix-surface);display:flex;gap:8px;align-items:flex-end}
.ix-input textarea{flex:1;padding:10px 14px;background:var(--ix-surface-2);border:1px solid var(--ix-border-strong);border-radius:10px;color:var(--ix-text);font-size:13.5px;font-family:inherit;resize:none;min-height:44px;max-height:120px;line-height:1.4;outline:none;transition:border-color .15s,background .15s}
.ix-input textarea:focus{border-color:var(--ix-accent);background:var(--ix-surface-3)}
.ix-input textarea::placeholder{color:var(--ix-text-faint)}
.ix-input button{padding:10px 18px;background:var(--ix-wa-green);color:var(--text);border:none;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;transition:background .15s,transform .1s;letter-spacing:.1px}
.ix-input button:hover{background:#019174}
.ix-input button:active{transform:scale(.97)}
.ix-input button:disabled{opacity:.5;cursor:not-allowed}
.ix-input .hint{font-size:10px;color:var(--ix-text-faint);align-self:center;text-align:right;line-height:1.3}
.ix-btn-tool{padding:8px !important;background:transparent !important;color:var(--ix-text-muted) !important;border:1px solid transparent !important;border-radius:8px !important;font-size:16px !important;font-weight:400 !important;cursor:pointer;width:38px;height:38px;display:flex !important;align-items:center;justify-content:center;transition:all .12s}
.ix-btn-tool:hover{background:var(--ix-surface-3) !important;color:var(--ix-text) !important;border-color:var(--ix-border-strong) !important}
.ix-tpl-item{padding:10px 12px;border:1px solid var(--ix-border-strong);border-radius:8px;margin-bottom:6px;cursor:pointer;background:var(--ix-surface-2);transition:all .15s}
.ix-tpl-item:hover{border-color:var(--ix-accent);background:var(--ix-surface-3)}
.ix-tpl-item .nome{color:var(--ix-text);font-weight:700;font-size:12px}
.ix-tpl-item .body{color:var(--ix-text-muted);font-size:11px;margin-top:3px;line-height:1.4}

.ix-empty{flex:1;display:flex;align-items:center;justify-content:center;color:var(--ix-text-faint);font-size:14px;text-align:center;padding:40px;line-height:1.6}

/* ============================================================
   COLUNA 3 — PAINEL DO LEAD (lateral direita)
   ============================================================ */
.ix-lead{width:320px;border-left:1px solid var(--ix-border);background:var(--ix-surface);display:flex;flex-direction:column;overflow-y:auto;scrollbar-width:thin;scrollbar-color:#2a2a2a transparent}
.ix-lead::-webkit-scrollbar{width:6px}
.ix-lead::-webkit-scrollbar-thumb{background:#2a2a2a;border-radius:3px}
.ix-lead.empty{display:none}
/* Header com avatar grande + nome + tier */
.ix-lead-h{padding:18px 16px 14px;border-bottom:1px solid var(--ix-border);background:linear-gradient(180deg,rgba(91,163,245,.04),transparent);text-align:center}
.ix-lead-h .avatar{width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#1f2937,#374151);display:flex;align-items:center;justify-content:center;color:#cbd5db;font-size:22px;font-weight:700;margin:0 auto 10px;border:2px solid rgba(255,255,255,.08);letter-spacing:-.3px}
.ix-lead-h .nome{color:var(--ix-text);font-weight:700;font-size:15px;margin-bottom:4px;letter-spacing:-.2px}
.ix-lead-h .meta{color:var(--ix-text-muted);font-size:11px;line-height:1.5;display:flex;flex-direction:column;gap:3px;align-items:center}
.ix-lead-h .meta br{display:none}
.ix-lead-h .tier{display:inline-block;padding:2px 8px;border-radius:10px;font-size:9px;font-weight:800;text-transform:uppercase;margin-right:5px;letter-spacing:.4px}
.ix-lead-h .tier.diamante{background:rgba(167,113,247,.18);color:#c4a4ff;border:1px solid rgba(167,113,247,.35)}
.ix-lead-h .tier.ouro{background:rgba(240,192,64,.18);color:#fbd968;border:1px solid rgba(240,192,64,.35)}
.ix-lead-h .tier.prata{background:rgba(156,163,175,.15);color:#cbd5db;border:1px solid rgba(156,163,175,.3)}
.ix-lead-h .tier.bronze{background:rgba(168,124,94,.18);color:#d4a878;border:1px solid rgba(168,124,94,.35)}
/* Section header (separa grupos) */
.ix-lead-section{padding:10px 16px 4px;font-size:9.5px;font-weight:700;color:var(--ix-text-faint);text-transform:uppercase;letter-spacing:1.2px;display:flex;align-items:center;gap:6px;background:transparent;margin-top:6px}
.ix-lead-section::after{content:'';flex:1;height:1px;background:linear-gradient(90deg,var(--ix-border),transparent)}
.ix-lead-section:first-of-type{margin-top:0}
.ix-lead-block{padding:8px 16px 12px}
.ix-lead-block + .ix-lead-block{padding-top:0}
.ix-lead-block h4{color:var(--ix-text-muted);font-size:10px;text-transform:uppercase;letter-spacing:.5px;margin:0 0 5px;font-weight:700}
.ix-lead-block select,.ix-lead-block textarea,.ix-lead-block input{width:100%;background:var(--ix-surface-2);border:1px solid var(--ix-border-strong);color:var(--ix-text);border-radius:7px;padding:7px 10px;font-size:12px;font-family:inherit;outline:none;transition:border-color .15s}
.ix-lead-block select:focus,.ix-lead-block textarea:focus,.ix-lead-block input:focus{border-color:var(--ix-accent)}
.ix-lead-block textarea{resize:vertical;min-height:60px;line-height:1.45}
.ix-lead-block .row{display:flex;gap:6px;font-size:11.5px;color:var(--ix-text);margin:3px 0;align-items:baseline;line-height:1.5}
.ix-lead-block .row .k{color:var(--ix-text-faint);min-width:80px;font-size:10.5px;text-transform:uppercase;letter-spacing:.3px;font-weight:600}
.ix-lead-block .row .v{color:var(--ix-text);font-weight:600;flex:1;word-break:break-word}
/* Ações */
.ix-lead-acts{padding:14px 16px 18px;display:flex;flex-direction:column;gap:6px;border-top:1px solid var(--ix-border);margin-top:6px;background:rgba(0,0,0,.15)}
.ix-lead-acts button,.ix-lead-acts a{width:100%;padding:9px 12px;border-radius:8px;border:1px solid;font-size:12px;font-weight:600;cursor:pointer;background:transparent;text-align:left;display:flex;align-items:center;gap:8px;transition:all .12s;font-family:inherit;text-decoration:none;line-height:1.3}
.ix-lead-acts button:hover,.ix-lead-acts a:hover{transform:translateY(-1px);text-decoration:none}
.ix-lead-acts .nubia{color:var(--ix-purple);border-color:rgba(167,113,247,.4);background:rgba(167,113,247,.05)}

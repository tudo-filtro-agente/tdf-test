let _IX_TEMPLATES = [];
async function ixAbrirTemplates(){
  if (!_IX_ATUAL) { alert('Selecione uma conversa primeiro.'); return; }
  const modal = document.getElementById('ix-tpl-modal');
  modal.style.display = 'flex';

async function ixUploadFile(input){
  const f = input.files?.[0];
  if (!f) return;
  if (f.size > 8 * 1024 * 1024) { alert('Arquivo muito grande (máx 8MB)'); return; }
  const conv = _IX_CONVS.find(c => c.dealId === _IX_ATUAL);
  if (!conv) return;
  const reader = new FileReader();
  reader.onload = async () => {
    const btn = document.getElementById('ix-send');
    btn.disabled = true; btn.textContent = '⏳ Enviando...';
    try {
      const r = await fetch('/inbox/anexar', { method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ phone: conv.phone, dataUrl: reader.result, filename: f.name }) });
      const d = await r.json();
      if (d.error) { alert('❌ ' + d.error + '\n\nDica: se passou da janela 24h, use 📋 template.'); return; }
      input.value = ''; // reset
      await ixAbrir(_IX_ATUAL, conv.phone);
    } catch(e) { alert(e.message); }
    btn.disabled = false; btn.textContent = 'Enviar';
  };
  reader.readAsDataURL(f);
}


<script>
let _IX_CONVS = [];
let _IX_ATUAL = null;
let _IX_LEAD = null; // info do lead atual no painel
let _IX_PHONE_ATUAL = null;

// Helper: detecta fonte do lead (Facebook/Instagram/Google/etc.) por source_url e Lead_Source
function ixDetectarFonte(sourceUrl, leadSource) {
  const all = ((sourceUrl||'') + ' ' + (leadSource||'')).toLowerCase();
  if (/fb\.me|facebook|fbclid|fbads/.test(all)) return { ico:'📘', label:'Facebook', cor:'#1877F2', bg:'rgba(24,119,242,.15)' };
  if (/ig\.me|instagram|igsh|instagramads/.test(all)) return { ico:'📷', label:'Instagram', cor:'#E4405F', bg:'rgba(228,64,95,.15)' };
  if (/google|gclid|gads|googleads/.test(all)) return { ico:'🔍', label:'Google', cor:'#4285F4', bg:'rgba(66,133,244,.15)' };
  if (/tiktok|tt\.me/.test(all)) return { ico:'🎵', label:'TikTok', cor:'#000', bg:'rgba(255,255,255,.1)' };
  if (/youtube|yt\.be/.test(all)) return { ico:'▶️', label:'YouTube', cor:'#FF0000', bg:'rgba(255,0,0,.15)' };
  if (/whatsapp orgânico|whatsapp organic|wa\.me/.test(all)) return { ico:'💬', label:'WhatsApp', cor:'#25D366', bg:'rgba(37,211,102,.15)' };
  if (/indica/.test(all)) return { ico:'👥', label:'Indicação', cor:'#a371f7', bg:'rgba(167,113,247,.15)' };
  if (/site|website|tudodefiltro/.test(all)) return { ico:'🌐', label:'Site', cor:'#5ba3f5', bg:'rgba(91,163,245,.15)' };
  if (/loja|física|fisica/.test(all)) return { ico:'🏪', label:'Loja', cor:'#f97316', bg:'rgba(249,115,22,.15)' };
  if (/wati/.test(all)) return { ico:'💚', label:'WATI', cor:'#22c55e', bg:'rgba(34,197,94,.1)' };
  return null;
}
function ixBadgeFonte(sourceUrl, leadSource){
  const f = ixDetectarFonte(sourceUrl, leadSource);
  if (!f) return '';
  return `<span style="display:inline-block;padding:1px 7px;border-radius:8px;font-size:9px;font-weight:700;background:${f.bg};color:${f.cor};white-space:nowrap;border:1px solid ${f.cor}33">${f.ico} ${f.label}</span>`;
}

// Helper protegido contra HTML response (sessão expirada / 500 error)
async function ixSafeJson(url, opts) {
  try {
    const r = await fetch(url, opts);
    const ct = r.headers.get('content-type') || '';
    if (!ct.includes('json')) {
      if (r.status === 401) return { error: 'Sessão expirada — recarregue (F5) e faça login.' };
      const txt = await r.text().catch(() => '');
      return { error: `Servidor retornou HTML (${r.status}): ${txt.slice(0,80)}` };
    }
    return await r.json();
  } catch(e) { return { error: e.message }; }
}

function ixFmtTs(ts){
  if (!ts) return '';
  const d = new Date(ts);
  const hoje = new Date(); hoje.setHours(0,0,0,0);
  const ontem = new Date(hoje); ontem.setDate(ontem.getDate()-1);
  if (d >= hoje) return d.toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'});
  if (d >= ontem) return 'ontem';
  return d.toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'2-digit'});
}
// Versão completa pra bolhas do chat: sempre dd/mm HH:MM
function ixFmtTsFull(ts){
  if (!ts) return '';
  const d = new Date(ts);
  const hoje = new Date(); hoje.setHours(0,0,0,0);
  if (d >= hoje) return d.toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'});
  return d.toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
}

// === Helpers visuais (iniciais, tier, etc.) ===
function ixIniciais(nome){
  if (!nome) return '?';
  const limpo = String(nome).replace(/[^a-zA-ZÀ-ÿ0-9 ]/g,'').trim();
  if (!limpo) return '?';
  const partes = limpo.split(/\s+/).filter(p => p.length > 1);
  if (partes.length >= 2) return (partes[0][0] + partes[partes.length-1][0]).toUpperCase();
  return (partes[0] || limpo).slice(0,2).toUpperCase();
}
function ixTierClass(tier){
  if (!tier) return '';
  const t = String(tier).toLowerCase();
  if (t.includes('diam')) return 'tier-d';
  if (t.includes('our')) return 'tier-o';
  if (t.includes('prat')) return 'tier-p';
  if (t.includes('bron')) return 'tier-b';
  return '';
}
function ixTierIcon(tier){
  if (!tier) return '';
  const t = String(tier);
  if (t === 'Diamante') return '💎';
  if (t === 'Ouro') return '🥇';
  if (t === 'Prata') return '🥈';
  if (t === 'Bronze') return '🥉';
  return '';
}

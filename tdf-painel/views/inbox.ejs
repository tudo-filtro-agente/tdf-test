    const score = d.score_qualidade_conversa;
    const corS = score >= 70 ? '#22c55e' : score >= 50 ? '#fbbf24' : score >= 25 ? '#f97316' : '#ef4444';
    const corP = d.perda_provavel === 'alta' ? '#ef4444' : d.perda_provavel === 'media' ? '#fbbf24' : '#22c55e';
    let html = `<div style="background:linear-gradient(135deg,rgba(13,17,23,.95),rgba(26,14,42,.95));border:2px solid #a371f7;border-radius:10px;padding:11px">`;
    html += `<div style="display:flex;align-items:center;gap:6px;margin-bottom:8px;flex-wrap:wrap">
      <strong style="color:#c084fc;font-size:12px">🔍 Análise de Funil</strong>
      <span style="background:${corS}22;color:${corS};padding:2px 7px;border-radius:4px;font-size:10px;font-weight:800;margin-left:auto">Score ${score}/100</span>
      <span style="background:${corP}22;color:${corP};padding:2px 7px;border-radius:4px;font-size:10px;font-weight:800">Perda ${d.perda_provavel}</span>

async function ixLeadCarregar(dealId){
  const lead = document.getElementById('ix-lead');
  lead.classList.remove('empty');
  // Limpa estado anterior
  document.getElementById('ix-lead-nome').textContent = 'Carregando...';
  try {
    const d = await ixSafeJson('/manutencao/cliente-info/'+encodeURIComponent(dealId));
    if (d.error) { document.getElementById('ix-lead-nome').textContent = '⚠️ '+d.error; return; }
    _IX_LEAD = d;
    const c = d.cliente || {};
    const cl = d.closy || {};
    document.getElementById('ix-lead-nome').textContent = c.nome || c.telefone || '?';
    // Avatar grande
    const avLeadEl = document.getElementById('ix-lead-avatar');
    if (avLeadEl) {
      avLeadEl.textContent = ixIniciais(c.nome || c.telefone);
      avLeadEl.className = 'avatar';
    }
    const tierBadge = c.tier ? `<span class="tier ${(c.tier||'').toLowerCase()}">${c.tier}</span>` : '';
    const cidadeLine = (c.cidade || c.empresa) ? `<span style="color:var(--ix-text-muted);font-size:11px">${c.cidade||'sem cidade'}${c.empresa?' · '+c.empresa:''}</span>` : '';
    document.getElementById('ix-lead-meta').innerHTML =
      `<span style="display:inline-flex;align-items:center;gap:4px">${tierBadge}<span style="font-variant-numeric:tabular-nums">📞 ${c.telefone||'—'}</span> <button onclick="event.stopPropagation();ixCopiarTelLead('${(c.telefone||'').replace(/\D/g,'')}',this)" title="Copiar telefone" style="background:transparent;border:1px solid var(--ix-border-strong);color:var(--ix-text-muted);border-radius:4px;padding:1px 5px;font-size:10px;cursor:pointer;line-height:1">📋</button></span>${cidadeLine}`;
    // Etapas Closy dropdown
    const sel = document.getElementById('ix-lead-etapa');
    sel.innerHTML = (d.etapas||[]).map(e =>
      `<option value="${e.id}" ${e.id===cl.etapa?'selected':''}>${e.icon} ${e.label}</option>`
    ).join('');
    // Stage Zoho dropdown — usa stages do pipeline atual (zohoStagesAtuais)
    const stageSel = document.getElementById('ix-lead-zoho-stage');
    const stagesValid = d.zohoStagesAtuais || d.zohoStages || [];
    const labelPipe = c.pipeline ? ` (Pipeline: ${c.pipeline})` : '';
    stageSel.innerHTML = '<option value="">— Stage Zoho'+labelPipe+' —</option>' +
      stagesValid.map(s => `<option value="${s}" ${s===c.stage?'selected':''}>${s}</option>`).join('');
    // Layout Zoho dropdown
    const layoutSel = document.getElementById('ix-lead-zoho-layout');
    const currentLayoutName = c.layout || '';
    layoutSel.innerHTML = '<option value="">— Layout —</option>' +
      (d.zohoLayouts||[]).map(l => `<option value="${l.id}" ${l.nome===currentLayoutName?'selected':''}>${l.nome}</option>`).join('');
    // Operadoras dropdown
    const opSel = document.getElementById('ix-lead-op');
    opSel.innerHTML = '<option value="">— Sem operadora —</option>' +
      (d.operadoras||[]).map(o => `<option value="${o.username}" ${o.username===cl.operadora?'selected':''}>${o.name} (${o.team})</option>`).join('');
    // Observação
    document.getElementById('ix-lead-obs').value = cl.observacao || '';
    // Dados
    document.getElementById('ix-lead-pipeline').textContent = c.pipeline || '—';
    document.getElementById('ix-lead-layout').textContent = c.layout || '—';
    document.getElementById('ix-lead-tier').textContent = c.tier || '—';
    const sc = c.scoreLead;
    document.getElementById('ix-lead-score').textContent = sc != null ? sc + '/100' : '—';
    document.getElementById('ix-lead-tipoagua').textContent = c.tipoAgua || '—';
    document.getElementById('ix-lead-source').textContent = c.leadSource || '—';
    document.getElementById('ix-lead-produto').textContent = (c.produto||'—').slice(0,60);
    document.getElementById('ix-lead-valor').textContent = c.valor ? 'R$ '+Math.round(c.valor).toLocaleString('pt-BR') : '—';
    if (c.criadoEm) {
      const dtCr = new Date(c.criadoEm);
      const diasAtras = Math.floor((Date.now() - dtCr.getTime())/86400000);
      document.getElementById('ix-lead-criado').textContent = dtCr.toLocaleDateString('pt-BR') + ` · ${diasAtras}d atrás`;
    } else document.getElementById('ix-lead-criado').textContent = '—';
    // Origem rica
    ixLeadRenderOrigem(c.attribParsed, c.leadSource);
    // Tags
    ixLeadRenderTags(c.tags || []);
    if (cl.proposta) {
      document.getElementById('ix-lead-prop-row').style.display = 'flex';
      document.getElementById('ix-lead-prop').innerHTML = `<strong style="color:#f0c040">R$ ${Math.round(cl.proposta.total||0).toLocaleString('pt-BR')}</strong> · ${cl.proposta.items?.length||0} item(s)`;
    } else {
      document.getElementById('ix-lead-prop-row').style.display = 'none';
    }
    // Timeline mini
    const tl = document.getElementById('ix-lead-tl');
    if (cl.timeline?.length) {
      tl.innerHTML = [...cl.timeline].reverse().map(ev => {
        const dt = new Date(ev.at).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
        return `<div class="ev"><span class="lbl">${(ev.label||'').replace(/</g,'&lt;')}</span><span class="at">${dt} · ${ev.by||'?'}</span></div>`;
      }).join('');
    } else {
      tl.innerHTML = '<div style="color:#666;font-size:10px;padding:8px;text-align:center">Sem eventos ainda</div>';
    }
    // CRM link
    const crmA = document.getElementById('ix-lead-crm');
    if (d.crmLink) { crmA.href = d.crmLink; crmA.style.display = 'block'; }
    else crmA.style.display = 'none';
    // Última atividade (cruza GoTo + WATI + timeline + tarefas)
    ixLeadCarregarUltimaAtividade(dealId);
  } catch(e) {
    document.getElementById('ix-lead-nome').textContent = 'Erro: '+e.message;
  }
}

// === ORIGEM (atribuição) ===
function ixLeadRenderOrigem(attrib, raw){
  const card = document.getElementById('ix-lead-origem-card');
  const plat = document.getElementById('ix-lead-origem-plat');
  const det = document.getElementById('ix-lead-origem-detalhe');
  if (!attrib && !raw) {
    card.style.background = 'rgba(136,136,136,.05)';
    card.style.borderColor = 'rgba(136,136,136,.3)';
    plat.textContent = '❓ Sem origem definida';
    plat.style.color = '#888';
    det.innerHTML = 'Lead sem Lead_Source preenchido — pode ser orgânico, indicação ou base antiga. <em>Considere preencher manualmente.</em>';
    return;
  }
  const platCores = { Meta:'#1877f2', Google:'#fbbc04', WhatsApp:'#25d366', 'RD Station':'#22c55e', 'E-mail':'#a371f7', 'Lista interna':'#fbbf24', 'Orgânico':'#22c55e', 'Outros':'#888' };
  const platIcons = { Meta:'📘', Google:'🔍', WhatsApp:'💬', 'RD Station':'🚀', 'E-mail':'📧', 'Lista interna':'📋', 'Orgânico':'🌱', 'Outros':'❓' };
  const p = attrib?.plataforma || 'Outros';
  const cor = platCores[p] || '#888';
  const ico = platIcons[p] || '❓';
  card.style.background = `${cor}11`;
  card.style.borderColor = `${cor}44`;
  plat.style.color = cor;
  plat.textContent = `${ico} ${p}`;
  let html = '';
  if (attrib?.tipo) html += `<div><strong style="color:#fff">Tipo:</strong> ${attrib.tipo}</div>`;
  if (attrib?.campanha) html += `<div><strong style="color:#fff">Campanha:</strong> ${attrib.campanha}</div>`;
  if (attrib?.tokens?.length) html += `<div style="margin-top:4px"><strong style="color:#888;font-size:10px">Detalhes:</strong> ${attrib.tokens.slice(0,5).map(t=>'<span style="background:'+cor+'22;color:'+cor+';padding:1px 5px;border-radius:3px;font-size:10px;margin-right:2px">'+t+'</span>').join('')}</div>`;
  if (!html) html = `<em>${raw||'sem detalhes'}</em>`;
  det.innerHTML = html;
}

// === TAGS ===
const TAGS_SUGERIDAS = [
  'cliente_vip','recorrente','urgente','sem_orçamento','espera_aprovacao',
  'refazer_proposta','condominio','restaurante','industria','obra_nova',
  'tem_concorrente','negociando_preco','quer_visita','quer_amostra','aguardando_pagamento'
];
function ixLeadRenderTags(tags){
  const cont = document.getElementById('ix-lead-tags');
  const cnt = document.getElementById('ix-lead-tags-count');
  cnt.textContent = tags.length ? `(${tags.length})` : '';
  if (!tags.length) {
    cont.innerHTML = '<span style="color:var(--ix-text-muted);font-size:11px;font-style:italic">Sem tags ainda</span>';
  } else {
    cont.innerHTML = tags.map(t => `
      <span style="display:inline-flex;align-items:center;gap:3px;background:rgba(167,113,247,.15);color:#c084fc;padding:3px 6px 3px 8px;border-radius:12px;font-size:11px;font-weight:600;border:1px solid rgba(167,113,247,.4)">
        ${ixEscape(t)}
        <button onclick="ixLeadRemoverTag('${ixEscape(t).replace(/'/g,'&#39;')}')" title="Remover tag" style="background:transparent;border:none;color:#c084fc;cursor:pointer;padding:0;width:14px;height:14px;border-radius:50%;font-size:11px;line-height:1;display:inline-flex;align-items:center;justify-content:center">×</button>
      </span>
    `).join('');
  }
  // Sugestões: tags que ainda não estão aplicadas
  const naoAplicadas = TAGS_SUGERIDAS.filter(t => !tags.some(x => x.toLowerCase() === t.toLowerCase()));
  document.getElementById('ix-lead-tags-sugestoes').innerHTML = naoAplicadas.slice(0, 8).map(t => `
    <button onclick="ixLeadAdicionarTagDireta('${t}')" title="Aplicar tag rápida" style="background:rgba(255,255,255,.05);color:var(--ix-text-muted);border:1px dashed var(--ix-border);border-radius:10px;padding:1px 7px;font-size:9px;cursor:pointer;font-weight:500">+ ${t}</button>
  `).join('');
}
function ixEscape(s){
  return String(s).replace(/[<>&"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c]));
}
async function ixLeadAdicionarTag(){
  if (!_IX_ATUAL) return;
  const inp = document.getElementById('ix-lead-tag-novo');
  const tag = inp.value.trim();
  if (!tag) return;
  await ixLeadAdicionarTagDireta(tag);
  inp.value = '';
}
async function ixLeadAdicionarTagDireta(tag){
  if (!_IX_ATUAL || !tag) return;
  try {
    const r = await fetch('/manutencao/cliente/'+encodeURIComponent(_IX_ATUAL)+'/tags', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ tags: [tag] }),
    });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    // Atualiza local
    const cur = (_IX_LEAD?.cliente?.tags) || [];
    const novo = [...new Set([...cur, ...d.added])];
    if (_IX_LEAD?.cliente) _IX_LEAD.cliente.tags = novo;
    ixLeadRenderTags(novo);
  } catch(e) { alert('Erro: '+e.message); }
}
async function ixLeadRemoverTag(tag){
  if (!_IX_ATUAL || !tag) return;
  if (!confirm(`Remover tag "${tag}"?`)) return;
  try {
    const r = await fetch('/manutencao/cliente/'+encodeURIComponent(_IX_ATUAL)+'/tags/'+encodeURIComponent(tag), { method: 'DELETE' });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    const cur = (_IX_LEAD?.cliente?.tags) || [];
    const novo = cur.filter(t => t !== tag);
    if (_IX_LEAD?.cliente) _IX_LEAD.cliente.tags = novo;
    ixLeadRenderTags(novo);
  } catch(e) { alert('Erro: '+e.message); }
}


      const r = await fetch('/inbox/templates');
      const d = await r.json();
      _IX_TEMPLATES = d.messageTemplates || d.templates || d.data || [];
    } catch(e) { _IX_TEMPLATES = []; }
  }
  ixRenderTpls();
  // Autofocus no campo de busca + limpa busca anterior
  setTimeout(() => {
    const inp = document.getElementById('ix-tpl-search');
    if (inp) { inp.value = ''; inp.focus(); }
    const clr = document.getElementById('ix-tpl-clear'); if (clr) clr.style.display = 'none';

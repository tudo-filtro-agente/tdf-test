      Travou em: <span style="background:rgba(239,68,68,.15);color:#fca5a5;padding:1px 6px;border-radius:3px;font-weight:700">${IX_STAGE_LABELS[d.stage_travou_em]||d.stage_travou_em}</span>
    </div>`;
    html += `<div style="background:rgba(255,255,255,.04);border-left:3px solid #a371f7;padding:8px;margin-bottom:8px;border-radius:3px;font-size:11.5px;color:#fff;line-height:1.4">${d.diagnostico_curto}</div>`;
    if (d.sintomas?.length) {
      d.sintomas.forEach(s => {
        const m = IX_SINT_LABELS[s.tipo] || { label: s.tipo, icon: '⚠️', cor: '#888' };
        html += `<div style="background:rgba(255,255,255,.03);border-left:2px solid ${m.cor};padding:6px 8px;margin-bottom:4px;border-radius:3px;font-size:10.5px">
          <strong style="color:${m.cor}">${m.icon} ${m.label}</strong>
          <div style="color:#aaa;font-style:italic;margin-top:2px">"${(s.evidencia||'').slice(0,160)}"</div>
        </div>`;
      });

async function ixCriarOrfao(idx, btn){
  const o = window._IX_ORFAOS?.[idx];
  if (!o) return;
  btn.disabled = true; btn.textContent = '⏳';
  const d = await ixSafeJson('/inbox/cadastrar-lead', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ nome: o.nome||('Lead '+o.phone), telefone: o.phone, produto: o.produto, leadSource: 'WATI · '+(o.source?o.source.includes('fb.me')?'Facebook':o.source.includes('ig.me')?'Instagram':'WhatsApp':'Inbound') })
  });
  if (d.error) { alert('❌ '+d.error); btn.disabled=false; btn.textContent='+ Criar'; return; }
  btn.style.background = '#666'; btn.textContent = '✅ criado'; btn.disabled = true;
}


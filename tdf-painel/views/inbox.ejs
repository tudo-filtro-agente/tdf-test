      <div style="color:#ddd;font-size:11px;line-height:1.4">${(r.texto||'').slice(0,140)}${(r.texto||'').length>140?'...':''}</div>
    </div>
  `).join('') || '<div style="color:#888;padding:20px;text-align:center">nenhuma</div>';
}
function ixFiltrarRapidas(){ ixRenderRapidas(); }
function ixUsarRapida(id){
  const r = _IX_RAPIDAS.find(x => x.id === id);
  if (!r) return;
  document.getElementById('ix-text').value = r.texto;
  document.querySelector('div[style*="z-index:200"]')?.remove();
  document.getElementById('ix-text').focus();
}

ixCarregar();
// Aplica filtros persistidos
ixSetFiltroOwner(_IX_FILTRO_OWNER);
ixSetFiltroCanal(_IX_FILTRO_CANAL);
// Fallback agressivo: 5s (era 30s) — garante que lista atualiza mesmo se SSE cair
setInterval(ixCarregar, 5000);

// === SSE: tempo real (push do server quando webhook WATI/Z-API chega) ===
function ixIniciarStream(){
  let _evt;
  try {
    _evt = new EventSource('/inbox/stream');
  } catch(e) { console.warn('SSE indisponível:', e); return; }
  _evt.addEventListener('hello', () => console.log('[inbox] SSE conectado'));
  _evt.addEventListener('nova_mensagem', e => {
    try {
      const d = JSON.parse(e.data);
      console.log('[inbox] nova msg:', d.dealId, d.text);
      // Recarrega lista imediatamente (atualiza badge "novo" e ordenação)
      ixCarregar();
      // Se a conversa atual é a que recebeu mensagem: insere bolha no DOM AGORA
      // (sem refetch — WATI getMessages tem 1-3min de latência depois do webhook)
      if (_IX_ATUAL === d.dealId) {
        const msgsEl = document.getElementById('ix-msgs');
        if (msgsEl && d.text) {
          const wasAtBottom = msgsEl.scrollTop + msgsEl.clientHeight >= msgsEl.scrollHeight - 30;
          const ts = d.ts || Date.now();
          const tsLabel = ixFmtTsFull(ts);
          const safeText = String(d.text).replace(/</g,'&lt;').replace(/\n/g,'<br>');
          const div = document.createElement('div');
          div.className = 'ix-msg lead';
          div.dataset.sseTs = String(ts);
          div.innerHTML = safeText + '<div class="ts">' + tsLabel + '</div>';
          msgsEl.appendChild(div);
          if (wasAtBottom) msgsEl.scrollTop = msgsEl.scrollHeight;
        }
        // Reconciliação eventual com o histórico WATI em 30s (quando o getMessages já tem a msg)
        clearTimeout(window._ixReconcileTimer);
        window._ixReconcileTimer = setTimeout(() => {
          const conv = _IX_CONVS.find(c => c.dealId === d.dealId);
          if (conv && _IX_ATUAL === d.dealId) ixAtualizarConversa(conv.phone);
        }, 30000);
      }
      // Som ICQ/MSN clássico (configurável via header — botão 🔔)
      try { window.tdfSons?.tocar(); } catch(_){}
    } catch(err) { console.warn('SSE parse:', err); }
  });
  _evt.onerror = () => {
    console.warn('[inbox] SSE caiu, reconectando em 5s...');
    try { _evt.close(); } catch(_){}
    setTimeout(ixIniciarStream, 5000);
  };
}
ixIniciarStream();
</script>


async function ixSalvarRapidas(btn){
  btn.disabled = true; btn.textContent = '⏳ Salvando...';
  const d = await ixSafeJson('/inbox/respostas-rapidas', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ respostas: _IX_RAPIDAS })
  });
  btn.disabled = false; btn.textContent = '💾 Salvar tudo';
  if (d.error) { alert('❌ '+d.error); return; }
  _IX_RAPIDAS = d.respostas;
  alert('✅ Respostas salvas: '+d.respostas.length);
  document.querySelector('div[style*="z-index:250"]')?.remove();
  ixAbrirRapidas();
}
function ixRenderRapidas(){
  const q = (document.getElementById('ix-rap-busca')?.value || '').toLowerCase();
  const list = _IX_RAPIDAS.filter(r => !q || (r.label+' '+r.texto).toLowerCase().includes(q));
  document.getElementById('ix-rap-list').innerHTML = list.map(r => `
    <div onclick="ixUsarRapida(${JSON.stringify(r.id).replace(/"/g,'&quot;')})" style="padding:10px 12px;border:1px solid #333;border-radius:6px;margin-bottom:6px;cursor:pointer;background:#161616">

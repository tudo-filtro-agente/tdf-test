// === ABRIR CONVERSA POR NÚMERO ===
async function ixAbrirNovoNumero(){
  const inp = document.getElementById('ix-novo-num');
  const num = (inp.value || '').replace(/\D/g, '');
  if (num.length < 10) { alert('Digite o número com DDD (mínimo 10 dígitos)'); return; }
  const nome = prompt('Nome do contato (opcional):', '');
  const d = await ixSafeJson('/inbox/abrir-numero', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ phone: num, nome: nome || '' })
  });
  if (d.error) { alert('❌ ' + d.error); return; }
  inp.value = '';
  if (d.criado) alert('✅ Deal criado no Zoho! Abrindo conversa...');
  // Adiciona conversa fake na lista pra abrir
  const novaConv = {
    dealId: d.dealId, phone: d.phone, nome: nome || ('Lead ' + d.phone),
    ultimaMsg: '(conversa nova)', count: 0, ts: Date.now(), visto: true,
    operadora: null, etapa: 'base_sem_contato',
  };
  if (!_IX_CONVS.find(c => c.dealId === d.dealId)) _IX_CONVS.unshift(novaConv);
  ixRenderLista();
  ixAbrir(d.dealId, d.phone);
}

// === CADASTRAR LEAD MANUAL ===
async function ixCadastrarLead(){
  const nome = prompt('Nome completo do lead:');
  if (!nome) return;
  const telefone = prompt('Telefone (com DDD):');
  if (!telefone) return;
  const cidade = prompt('Cidade (opcional):', '') || '';
  const produto = prompt('Produto de interesse (Bebedouro/Filtro Entrada/Iron Free/etc.) opcional:', '') || '';
  const observacao = prompt('Observação (opcional):', '') || '';
  const d = await ixSafeJson('/inbox/cadastrar-lead', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ nome, telefone, cidade, produto, observacao })
  });
  if (d.error) { alert('❌ '+d.error); return; }
  if (d.jaExiste) { alert('Esse número já existe como deal: '+d.message); ixAbrir(d.dealId, telefone.replace(/\D/g,'')); return; }
  alert('✅ Lead cadastrado! Abrindo conversa...');
  // Adiciona conversa na lista
  _IX_CONVS.unshift({
    dealId: d.dealId, phone: d.phone, nome,
    ultimaMsg: '(novo lead cadastrado)', count: 0, ts: Date.now(), visto: true,
    operadora: null, etapa: 'base_sem_contato',
  });
  ixRenderLista();
  ixAbrir(d.dealId, d.phone);
}

// Cadastra lead órfão direto do header da conversa atual (placeholder wati:phone)
async function ixCadastrarOrfaoNoHeader(phone, nomeWati){
  const nome = prompt('Nome completo do lead:', nomeWati || '');
  if (!nome) return;
  const cidade = prompt('Cidade (opcional):', '') || '';
  const produto = prompt('Produto de interesse (Bebedouro/Filtro Entrada/Iron Free/etc.) opcional:', '') || '';
  const observacao = prompt('Observação (opcional):', 'Lead órfão WATI — cadastrado via header da conversa') || '';
  const d = await ixSafeJson('/inbox/cadastrar-lead', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ nome, telefone: phone, cidade, produto, observacao })
  });
  if (d.error) { alert('❌ '+d.error); return; }
  if (d.jaExiste) {
    alert('Já existe deal: '+d.message);
    ixAbrir(d.dealId, phone.replace(/\D/g,''));
    return;
  }
  // Migra a conversa do placeholder 'wati:phone' pro novo dealId real
  const phoneClean = String(phone).replace(/\D/g,'');
  const oldKey = 'wati:' + phoneClean;
  await ixSafeJson('/inbox/migrar-orfao', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ oldKey, newDealId: d.dealId }),
  }).catch(()=>{});
  alert('✅ Lead cadastrado no Zoho! Atualizando conversa...');
  await ixCarregar();
  ixAbrir(d.dealId, d.phone);
}


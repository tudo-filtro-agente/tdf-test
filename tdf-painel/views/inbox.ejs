            <button onclick="_IX_RAPIDAS.splice(${i},1);ixRecargarEditor()" style="background:transparent;color:#f87171;border:1px solid #ef4444;border-radius:4px;padding:4px 8px;font-size:10px;cursor:pointer">×</button>

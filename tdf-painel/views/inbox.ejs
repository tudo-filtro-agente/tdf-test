let _IX_BUSCA_TIMER = null;
function ixFiltrar(){
  ixRenderLista();
  // Busca live no WATI se digitar 3+ chars (debounced 500ms)
  clearTimeout(_IX_BUSCA_TIMER);
  const q = (document.getElementById('ix-search').value || '').trim();
  if (q.length < 3) return;
  _IX_BUSCA_TIMER = setTimeout(async () => {
    const d = await ixSafeJson('/inbox/buscar?q='+encodeURIComponent(q));
    if (d.error || !d.contatos?.length) return;
    // Mescla com lista local (evita duplicar)
    const phones = new Set(_IX_CONVS.map(c => (c.phone||'').replace(/\D/g,'')));
    let adicionados = 0;
    for (const ct of d.contatos) {
      const ph = (ct.phone||'').replace(/\D/g,'');
      if (!ph || phones.has(ph)) continue;
      _IX_CONVS.push({
        dealId: ct.dealId || ('wati-busca:'+ph),
        phone: ph,
        nome: ct.nome,
        ultimaMsg: ct.statusConversa || '(busca WATI)',
        count: 0,
        ts: Date.now() - 1000000, // mais antigo que conversas locais
        visto: true,
        operadora: null,
        etapa: 'base_sem_contato',
        _busca: true,
      });
      adicionados++;
    }
    if (adicionados) ixRenderLista();
  }, 500);
}

// Auto-refresh agressivo: 3s na conversa ativa (era 8s)
// — webhook WATI tem latência variável, polling rápido garante real-time
let _IX_AUTO_REFRESH = null;
function ixIniciarAutoRefresh(dealId, phone){
  if (_IX_AUTO_REFRESH) clearInterval(_IX_AUTO_REFRESH);
  _IX_AUTO_REFRESH = setInterval(() => {
    if (_IX_ATUAL === dealId) ixAtualizarConversa(phone);
  }, 3000); // 3s — agressivo pra real-time
}
async function ixAtualizarConversa(phone){
  // Busca mensagens novas sem mostrar loading (silencioso)
  try {
    const d = await ixSafeJson('/inbox/mensagens?phone=' + encodeURIComponent(phone));
    if (d.error || !d.mensagens) return;
    const msgsEl = document.getElementById('ix-msgs');
    const wasAtBottom = msgsEl.scrollTop + msgsEl.clientHeight >= msgsEl.scrollHeight - 30;
    // Conta msgs atual vs nova
    const msgsAtuais = msgsEl.querySelectorAll('.ix-msg').length;
    if (d.mensagens.length === msgsAtuais) return; // sem mudança
    // Re-render
    msgsEl.innerHTML = ixRenderMsgsHTML(d.mensagens);
    if (wasAtBottom) msgsEl.scrollTop = msgsEl.scrollHeight;
    // Toca som se chegou mensagem nova do cliente (não nossa)
    const ultima = d.mensagens[d.mensagens.length - 1];
    if (ultima && !ultima.owner && !ultima.isSystem && d.mensagens.length > msgsAtuais) {
      try { window.tdfSons?.tocar(); } catch(_){}
    }
  } catch(_){}
}

async function ixCopiarTelLead(tel, btn){
  if (!tel) return;
  try {
    await navigator.clipboard.writeText(tel);
    const t = btn.textContent;
    btn.textContent = '✓';
    btn.style.color = '#22c55e';
    setTimeout(() => { btn.textContent = t; btn.style.color = '#888'; }, 1500);
  } catch(_) { prompt('Copie:', tel); }
}

async function ixCopiarTel(){
  if (!_IX_ATUAL) return;
  const conv = _IX_CONVS.find(c => c.dealId === _IX_ATUAL);
  if (!conv?.phone) return;
  const tel = String(conv.phone).replace(/\D/g, '');
  // Formata bonito: 5511999999999 → +55 (11) 99999-9999
  let formatado = tel;
  if (tel.length >= 12) {
    const ddi = tel.slice(0, 2), ddd = tel.slice(2, 4), num = tel.slice(4);
    formatado = `+${ddi} (${ddd}) ${num.slice(0, num.length-4)}-${num.slice(-4)}`;
  } else if (tel.length === 11) {
    formatado = `(${tel.slice(0,2)}) ${tel.slice(2,7)}-${tel.slice(7)}`;
  }
  try {
    await navigator.clipboard.writeText(tel);
    const btn = document.getElementById('ix-h-copy');
    if (btn) {
      const t = btn.textContent;
      btn.textContent = '✓ ' + formatado.slice(0, 18);
      btn.style.color = '#22c55e';
      setTimeout(() => { btn.textContent = t; btn.style.color = '#aaa'; }, 2000);
    }
  } catch(e) {
    prompt('Copie o número:', tel);
  }
}

async function ixAbrir(dealId, phone){
  _IX_ATUAL = dealId;
  const conv = _IX_CONVS.find(c => c.dealId === dealId);
  ixIniciarAutoRefresh(dealId, phone);
  // Mostra indicador "AO VIVO" enquanto conversa está aberta
  const ind = document.getElementById('ix-live-indicator');
  if (ind) ind.style.display = 'inline-flex';
  document.getElementById('ix-empty').style.display = 'none';
  const _conv = document.getElementById('ix-conversa');
  _conv.style.display = 'flex';
  _conv.style.minHeight = '0';
  _conv.style.height = '100%';
  _conv.style.flex = '1 1 0';
  _conv.style.overflow = 'hidden';
  // Carrega painel lateral do lead em paralelo
  ixLeadCarregar(dealId);
  // Header: nome em destaque + avatar/iniciais + meta enriquecido
  const nomeEl = document.getElementById('ix-h-nome');
  const avEl = document.getElementById('ix-h-avatar');
  const metaEl = document.getElementById('ix-h-meta');
  const tierIco = ixTierIcon(conv?.tier);
  nomeEl.innerHTML = `${tierIco?`<span title="Tier ${conv.tier}">${tierIco}</span> `:''}${(conv?.nome || phone).replace(/</g,'&lt;')}`;
  if (avEl) {
    avEl.textContent = ixIniciais(conv?.nome || phone);
    avEl.className = 'avatar ' + (conv?.iaAtendendo ? 'ia' : ixTierClass(conv?.tier));
  }
  // Format phone: 5511999999999 → +55 (11) 99999-9999
  const tel = String(phone||'').replace(/\D/g,'');
  let telFmt = tel;
  if (tel.length >= 12) telFmt = `+${tel.slice(0,2)} (${tel.slice(2,4)}) ${tel.slice(4,-4)}-${tel.slice(-4)}`;
  else if (tel.length === 11) telFmt = `(${tel.slice(0,2)}) ${tel.slice(2,7)}-${tel.slice(7)}`;
  // Última atividade legível
  const lastSeen = conv?.ts ? ixFmtTs(conv.ts) : '';
  const metaParts = [`📞 ${telFmt}`];
  if (conv?.operadora) metaParts.push(`<span class="sep">·</span> 👤 ${conv.operadora.split('.')[0]}`);
  if (conv?.etapa) metaParts.push(`<span class="sep">·</span> ${conv.etapa.replace(/_/g,' ')}`);
  if (lastSeen) metaParts.push(`<span class="sep">·</span> <span title="Última atividade">⏱️ ${lastSeen}</span>`);
  if (conv?.iaAtendendo) metaParts.push(`<span class="sep">·</span> <span style="color:#a371f7;font-weight:600">🤖 Núbia atendendo</span>`);
  // Aviso SEM DEAL: lead não está no Zoho — botão pra cadastrar manualmente
  if (conv?.semDealZoho || String(dealId||'').startsWith('wati:')) {
    metaParts.push(`<span class="sep">·</span> <span style="background:rgba(239,68,68,.18);color:#fca5a5;padding:2px 8px;border-radius:6px;font-weight:700;border:1px solid rgba(239,68,68,.4)">⚠️ SEM DEAL ZOHO</span> <button onclick="ixCadastrarOrfaoNoHeader('${phone}','${(conv?.nomeWati||'').replace(/'/g,"\\'")}')" style="background:#22c55e;color:#000;border:none;border-radius:5px;padding:3px 10px;font-size:10px;font-weight:800;cursor:pointer;margin-left:6px">+ Cadastrar agora</button>`);
  }
  metaEl.innerHTML = metaParts.join(' ');
  document.getElementById('ix-h-crm').href = `https://crmplus.zoho.com/tudodefiltro3711/index.do/cxapp/crm/org856385701/tab/Potentials/${dealId}`;
  document.getElementById('ix-h-wati').href = `https://live-2708.wati.io/2708/teamInbox/${phone.replace(/\D/g,'')}`;
  document.getElementById('ix-msgs').innerHTML = '<div style="color:#888;text-align:center;padding:20px">Carregando histórico...</div>';
  ixRenderLista();

  try{
    const r = await fetch('/inbox/mensagens?phone=' + encodeURIComponent(phone));
    const d = await r.json();
    if (d.error) { document.getElementById('ix-msgs').innerHTML = `<div style="color:#ef4444;padding:20px;text-align:center">${d.error}</div>`; return; }
    const msgs = d.mensagens || [];
    if (!msgs.length) { document.getElementById('ix-msgs').innerHTML = '<div style="color:#666;text-align:center;padding:30px;font-size:12px">Sem mensagens ainda</div>'; return; }
    document.getElementById('ix-msgs').innerHTML = ixRenderMsgsHTML(msgs);
    // Scroll bottom
    const m = document.getElementById('ix-msgs');
    m.scrollTop = m.scrollHeight;
  }catch(e){ document.getElementById('ix-msgs').innerHTML = `<div style="color:#ef4444;padding:20px;text-align:center">${e.message}</div>`; }
}


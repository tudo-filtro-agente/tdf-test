      <strong style="color:#22c55e">⚡ Próxima ação:</strong> <span style="color:#fff">${d.proxima_acao}</span>
    </div>`;
    if (d.padrao_recorrente_suspeita) {
      html += `<div style="background:rgba(251,191,36,.08);border:1px dashed #fbbf24;border-radius:5px;padding:6px 8px;margin-top:6px;font-size:10px;color:#fbbf24">

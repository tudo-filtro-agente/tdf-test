// Renderiza mensagens com agrupamento por autor (same-author = sem rabinho/sem avatar repetido)
// e checks de leitura WhatsApp-like (✓ enviado, ✓✓ entregue, ✓✓ azul = lido)
function ixRenderMsgsHTML(msgs){
  if (!Array.isArray(msgs) || !msgs.length) return '';
  let prevAuthor = null;
  return msgs.map((m, i) => {
    if (m.isSystem) {
      prevAuthor = null;
      return `<div class="ix-msg sistema">${(m.texto||'').replace(/</g,'&lt;')}</div>`;
    }
    const cls = m.owner ? 'nos' : 'lead';
    // Identidade: pra "nos" é o operatorName; pra lead é o phone (consistente)
    const author = m.owner ? (m.operatorName || m.templateName || 'nos') : 'lead';
    const sameAuthor = author === prevAuthor;
    prevAuthor = author;
    let checks = '';
    if (m.owner) {
      if (m.status === 'READ') checks = ' <span class="checks read" title="Lido">✓✓</span>';
      else if (m.status === 'DELIVERED') checks = ' <span class="checks" title="Entregue">✓✓</span>';
      else checks = ' <span class="checks" title="Enviado">✓</span>';
    }
    let op = '';
    if (!sameAuthor && m.owner && (m.operatorName || m.templateName)) {
      const nome = m.operatorName || ('📨 '+m.templateName);
      const ini = ixIniciais(nome.replace(/^📨\s*/,''));
      op = `<div class="op"><span class="op-avatar">${ini}</span>${nome}</div>`;
    }
    const txt = (m.texto||'').replace(/</g,'&lt;').replace(/\n/g,'<br>');
    const ts = ixFmtTsFull(m.timestamp*1000 || m.timestamp);
    return `<div class="ix-msg ${cls}${sameAuthor?' same-author':''}">${op}${txt}<div class="ts">${ts}${checks}</div></div>`;
  }).join('');
}

// Snapshot prévio das conversas pra detectar mensagens novas e tocar som filtrado
let _IX_PREV_SNAPSHOT = {};

async function ixCarregar(){
  try{
    const r = await fetch('/inbox/conversas');
    const d = await r.json();
    if (d.error) { document.getElementById('ix-list').innerHTML = `<div style="color:#ef4444;padding:20px;text-align:center;font-size:12px">${d.error}</div>`; return; }
    const novas = d.conversas || [];
    // Detecta novas mensagens (count subiu OU ts mudou)
    if (Object.keys(_IX_PREV_SNAPSHOT).length > 0) {
      let tocouSom = false;
      for (const c of novas) {
        const prev = _IX_PREV_SNAPSHOT[c.dealId];
        if (!prev) continue; // primeira load não dispara
        const tsMudou = (c.ts || 0) > (prev.ts || 0);
        const countSubiu = (c.count || 0) > (prev.count || 0);
        if (!tsMudou && !countSubiu) continue;
        // Filtro: só toca se a conversa for minha OU órfã
        const minha = ixConvIsMinha(c);
        const orfa = ixConvIsOrfao(c);
        const isAdmin = '<%= user.role %>' === 'admin';
        if (!tocouSom && (minha || orfa || isAdmin)) {
          try { window.tdfSons?.tocar(); } catch(_){}
          tocouSom = true; // só toca uma vez por ciclo
        }
      }
    }
    // Atualiza snapshot
    _IX_PREV_SNAPSHOT = {};
    for (const c of novas) _IX_PREV_SNAPSHOT[c.dealId] = { ts: c.ts, count: c.count };
    _IX_CONVS = novas;
    const naoVistos = d.naoVistos || 0;
    const badge = document.getElementById('ix-not-vistos');
    if (naoVistos > 0) { badge.style.display='inline-block'; badge.textContent = naoVistos; }
    else badge.style.display = 'none';
    ixRenderLista();
    if (_IX_VIEW === 'kanban') ixRenderKanban();
  }catch(e){ console.error(e); }
}

// Filtro de owner: 'todas' | 'minhas' | 'orfaos'
let _IX_FILTRO_OWNER = localStorage.getItem('ix_filtro_owner') || 'todas';
// Filtro de canal: 'todos' | 'wati' | 'zapi'
let _IX_FILTRO_CANAL = localStorage.getItem('ix_filtro_canal') || 'todos';
const _IX_USER = '<%= user.username %>';
const _IX_USER_NAME = '<%= user.name %>';
const _IX_USER_CRM = '<%- (typeof user !== "undefined" && user.crmOwner) ? user.crmOwner.replace(/'/g,"\\'") : "" %>';

function ixSetFiltroCanal(modo){
  _IX_FILTRO_CANAL = modo;
  localStorage.setItem('ix_filtro_canal', modo);
  ['todos','wati','zapi'].forEach(m => {
    const el = document.getElementById('ix-c-'+m);
    if (!el) return;
    if (m === modo) {
      el.style.background = m === 'wati' ? '#22c55e' : m === 'zapi' ? '#1f6feb' : '#a371f7';
      el.style.color = m === 'wati' ? '#000' : '#fff';
      el.style.border = 'none';
    } else {
      el.style.background = '#1a1a1a';
      el.style.color = m === 'wati' ? '#22c55e' : m === 'zapi' ? '#7cb9f5' : '#fff';
      el.style.border = m === 'wati' ? '1px solid #22c55e' : m === 'zapi' ? '1px solid #1f6feb' : '1px solid #a371f7';
    }
  });
  ixRenderLista();
}

function ixConvIsMinha(c){
  if (!c) return false;
  if (c.operadora && c.operadora === _IX_USER) return true;
  if (c.ownerZoho && _IX_USER_CRM && (c.ownerZoho.toLowerCase() === _IX_USER_CRM.toLowerCase() || c.ownerZoho.toLowerCase().split(' ')[0] === _IX_USER_CRM.toLowerCase().split(' ')[0])) return true;
  return false;
}
function ixConvIsOrfao(c){
  return !c.operadora && !c.ownerZoho;
}
function ixSetFiltroOwner(modo){
  _IX_FILTRO_OWNER = modo;
  localStorage.setItem('ix_filtro_owner', modo);
  ['todas','minhas','orfaos'].forEach(m => {
    const el = document.getElementById('ix-f-'+m);
    if (!el) return;
    if (m === modo) {
      el.style.background = m === 'orfaos' ? '#fbbf24' : '#1f6feb';
      el.style.color = m === 'orfaos' ? '#000' : '#fff';
      el.style.border = 'none';
    } else {
      el.style.background = '#1a1a1a';
      el.style.color = m === 'orfaos' ? '#fbbf24' : '#888';
      el.style.border = m === 'orfaos' ? '1px solid #fbbf24' : '1px solid #333';
    }
  });
  ixRenderLista();
}
async function ixAtribuirOrfaosBatch(){
  if (!confirm('Atribuir auto TODOS os órfãos? (CRM owner ativo ou round-robin por team)')) return;
  try {
    const r = await fetch('/inbox/atribuir-orfaos', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ limite: 50 }) });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    alert(`✅ ${d.sucesso} atribuídos · ${d.erros} erros (de ${d.total_orfaos} órfãos no total)`);
    ixCarregar();
  } catch(e) { alert('Erro: '+e.message); }
}

function ixRenderLista(){
  const filtro = (document.getElementById('ix-search').value || '').toLowerCase();
  // Atualiza contador de órfãos
  const orfaosCnt = _IX_CONVS.filter(ixConvIsOrfao).length;
  const cntEl = document.getElementById('ix-f-orfaos-count');
  if (cntEl) cntEl.textContent = orfaosCnt > 0 ? '('+orfaosCnt+')' : '';
  // Contador por canal
  const watiCnt = _IX_CONVS.filter(c => (c.canal||'wati') === 'wati').length;
  const zapiCnt = _IX_CONVS.filter(c => c.canal === 'zapi').length;
  const cw = document.getElementById('ix-c-wati-count'); if (cw) cw.textContent = watiCnt > 0 ? '('+watiCnt+')' : '';
  const cz = document.getElementById('ix-c-zapi-count'); if (cz) cz.textContent = zapiCnt > 0 ? '('+zapiCnt+')' : '';
  const ct = document.getElementById('ix-c-todos-count'); if (ct) ct.textContent = '('+_IX_CONVS.length+')';
  const list = _IX_CONVS.filter(c => {
    if (filtro) {
      if (!((c.nome||'').toLowerCase().includes(filtro) || (c.phone||'').includes(filtro) || (c.ultimaMsg||'').toLowerCase().includes(filtro))) return false;
    }
    if (_IX_FILTRO_OWNER === 'minhas' && !ixConvIsMinha(c)) return false;
    if (_IX_FILTRO_OWNER === 'orfaos' && !ixConvIsOrfao(c)) return false;
    // Canal: 'wati' default se não tiver. Z-API só aparece se canal='zapi'.
    const canalDaConv = c.canal || 'wati';
    if (_IX_FILTRO_CANAL === 'wati' && canalDaConv !== 'wati') return false;
    if (_IX_FILTRO_CANAL === 'zapi' && canalDaConv !== 'zapi') return false;
    return true;
  });
  if (!list.length) {
    document.getElementById('ix-list').innerHTML = '<div style="color:#888;text-align:center;padding:30px;font-size:12px">Nenhuma conversa</div>';
    return;
  }
  document.getElementById('ix-list').innerHTML = list.map(c => {
    const tierCls = ixTierClass(c.tier);
    const tierIco = ixTierIcon(c.tier);
    const iniciais = ixIniciais(c.nome || c.phone);
    const avatarCls = c.iaAtendendo ? 'ia' : (tierCls || '');
    const fonteBadge = ixBadgeFonte(c.sourceWati, c.leadSource);
    const iaBadge = c.iaAtendendo ? '<span class="ix-mini ia">🤖 IA</span>' : '';
    const preLeadBadge = c.preLead ? '<span class="ix-mini prelead" title="Pré-lead — só vira lead após Qualificado">Pré-lead</span>' : '';
    const semDealBadge = c.semDealZoho ? '<span class="ix-mini semdeal" title="⚠️ Lead não tem deal Zoho — clique em Cadastrar para criar">⚠️ SEM DEAL</span>' : '';
    // Badge de canal (WATI ou Z-API) — sempre visível pra identificar fonte da msg
    const canalAtual = c.canal || 'wati';
    const canalBadge = canalAtual === 'zapi'
      ? '<span class="ix-mini" style="background:rgba(31,111,235,.15);color:#7cb9f5;border:1px solid #1f6feb;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:800" title="Mensagem chegou via Z-API (WhatsApp pessoal/Business)">⚡ Z-API</span>'
      : '<span class="ix-mini" style="background:rgba(34,197,94,.15);color:#22c55e;border:1px solid #22c55e;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:800" title="Mensagem chegou via WATI (oficial Meta)">📱 WATI</span>';
    const opShort = c.operadora ? c.operadora.split('.')[0] : '';
    const ownerShort = c.ownerZoho ? c.ownerZoho.split(' ')[0] : '';
    const metaParts = [];
    if (opShort) metaParts.push('👤 '+opShort);
    if (ownerShort) metaParts.push('📂 '+ownerShort);
    const metaLine = metaParts.length ? `<div class="meta">${metaParts.join('<span class="dot">·</span>')}</div>` : '';
    return `
    <div class="ix-conv ${c.visto?'':'novo'} ${_IX_ATUAL===c.dealId?'active':''}" onclick="ixAbrir('${c.dealId}','${c.phone}')">
      <div class="avatar ${avatarCls}" title="${(c.tier||'').replace(/"/g,'&quot;')}">${tierIco || iniciais}</div>
      <div class="body">
        <div class="nome"><span class="name-text">${c.nome || c.nomeWati || c.phone}</span>${canalBadge}${iaBadge}${preLeadBadge}${semDealBadge}</div>
        <div class="preview">${(c.ultimaMsg||'').replace(/</g,'&lt;').slice(0,80) || '<em style="color:#5b6068">sem mensagens</em>'}</div>
        ${metaLine}
        ${fonteBadge ? '<div style="margin-top:3px">'+fonteBadge+'</div>' : ''}
      </div>
      <div class="right">
        <span class="ts">${ixFmtTs(c.ts)}</span>
        ${!c.visto && c.count ? `<span class="badge-count">${c.count}</span>` : ''}
      </div>
    </div>
  `;}).join('');
}


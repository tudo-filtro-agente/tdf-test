<% var pageTitle = 'Script de Ligação'; var activePage = ''; %>
<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>📞 Script — <%= ctx.nome %></title>
<link rel="icon" href="/favicon.png">
<style>
  :root { --bg:#0d1117; --bg-card:#161b22; --border:#30363d; --text:#e6edf3; --text-muted:#8b949e; --azul:#00AAFF; }
  * { box-sizing: border-box; }
  body { margin:0; font-family: -apple-system, 'Segoe UI', Roboto, sans-serif; background:var(--bg); color:var(--text); }
  header { position:sticky; top:0; z-index:50; background:var(--bg-card); border-bottom:1px solid var(--border); padding:10px 16px; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  header .lead { font-weight:800; font-size:1.02rem; }
  header .meta { color:var(--text-muted); font-size:.82rem; }
  .tabs { position:sticky; top:52px; z-index:49; display:flex; gap:6px; padding:8px 16px; background:var(--bg); border-bottom:1px solid var(--border); overflow-x:auto; }
  .tab { border:1px solid var(--border); background:var(--bg-card); color:var(--text-muted); border-radius:18px; padding:7px 14px; font-weight:700; font-size:.83rem; cursor:pointer; white-space:nowrap; }
  .tab.on { background:rgba(0,170,255,.15); color:var(--azul); border-color:var(--azul); }
  main { max-width:860px; margin:0 auto; padding:16px; }
  .painel { display:none; }
  .painel.on { display:block; }
  .md h1 { font-size:1.25rem; border-bottom:2px solid var(--azul); padding-bottom:6px; margin-top:34px; }
  .md h2 { font-size:1.05rem; color:var(--azul); margin-top:26px; }
  .md h3 { font-size:.95rem; margin-top:18px; }
  .md blockquote { background:var(--bg-card); border-left:3px solid #3fb950; margin:10px 0; padding:10px 14px; border-radius:0 8px 8px 0; font-size:.95rem; line-height:1.65; }
  .md blockquote p { margin:4px 0; }
  .md code { background:#21262d; border-radius:4px; padding:1px 6px; }
  .md table { border-collapse:collapse; width:100%; font-size:.85rem; }
  .md th, .md td { border:1px solid var(--border); padding:6px 8px; text-align:left; }
  .busca { width:100%; margin:10px 0 4px; padding:10px 14px; border-radius:10px; border:1px solid var(--border); background:var(--bg-card); color:var(--text); font-size:.95rem; }
  mark { background:#e8b93b; color:#000; border-radius:3px; padding:0 2px; }
  .copiar { position:absolute; right:8px; top:6px; background:var(--bg); border:1px solid var(--border); color:var(--text-muted); border-radius:6px; font-size:.72rem; padding:3px 8px; cursor:pointer; }
  .md blockquote { position:relative; }
</style>
<script src="https://cdn.jsdelivr.net/npm/marked@12.0.0/marked.min.js"></script>
</head>
<body>
<header>
  <span style="font-size:1.3rem;">📞</span>
  <div>
    <div class="lead"><%= ctx.nome %><% if (ctx.cidade !== '[Cidade]') { %> · <%= ctx.cidade %><% } %></div>
    <div class="meta">Script oficial TDF — tags [Nome]/[Cidade] já preenchidas · você: <%= user.name %></div>
  </div>
  <% if (ctx.dealId) { %>
    <a href="https://crmplus.zoho.com/tudodefiltro3711/index.do/cxapp/crm/org856385701/tab/Potentials/<%= ctx.dealId %>" target="_blank" style="margin-left:auto;color:var(--azul);text-decoration:none;font-weight:700;font-size:.85rem;">↩ Voltar pro deal</a>
  <% } %>
</header>

<div class="tabs">
  <span style="align-self:center;font-size:.72rem;font-weight:800;color:var(--text-muted);text-transform:uppercase;letter-spacing:.5px;margin-right:2px;">Papel:</span>
  <a class="tab <%= papel==='sdr'?'on':'' %>" href="?<%= new URLSearchParams(Object.assign({}, ctx.dealId?{deal:ctx.dealId}:{}, {nome:ctx.nome,cidade:ctx.cidade,produto:ctx.produto,pipeline:ctx.pipeline,papel:'sdr'})).toString() %>" style="text-decoration:none;">🎯 SDR</a>
  <a class="tab <%= papel==='closer'?'on':'' %>" href="?<%= new URLSearchParams(Object.assign({}, ctx.dealId?{deal:ctx.dealId}:{}, {nome:ctx.nome,cidade:ctx.cidade,produto:ctx.produto,pipeline:ctx.pipeline,papel:'closer'})).toString() %>" style="text-decoration:none;">💰 Closer</a>
  <span style="width:1px;background:var(--border);margin:0 4px;"></span>
  <% abas.forEach(function(a, i){ %>
    <button class="tab <%= i===0?'on':'' %>" data-aba="<%= a.slug %>"><%= a.icon %> <%= a.titulo %></button>
  <% }); %>
</div>

<main>
  <input class="busca" id="busca" placeholder="🔍 Buscar no script (ex.: tá caro, vazão, síndico...)" autocomplete="off">
  <% abas.forEach(function(a, i){ %>
    <section class="painel <%= i===0?'on':'' %>" id="painel-<%= a.slug %>">
      <div class="md" data-md="<%= encodeURIComponent(a.md) %>"></div>
    </section>
  <% }); %>
</main>

<script>
(function(){
  var ANCORA = <%- JSON.stringify(ancora) %>;
  // render de cada aba
  document.querySelectorAll('.md').forEach(function(el){
    el.innerHTML = marked.parse(decodeURIComponent(el.dataset.md));
  });
  // botao copiar em cada bloco de fala
  document.querySelectorAll('.md blockquote').forEach(function(bq){
    var b = document.createElement('button');
    b.className = 'copiar'; b.textContent = '📋 copiar';
    b.onclick = function(){ navigator.clipboard.writeText(bq.innerText).then(function(){ b.textContent = '✅'; setTimeout(function(){ b.textContent = '📋 copiar'; }, 1500); }); };
    bq.appendChild(b);
  });
  // tabs
  document.querySelectorAll('.tab').forEach(function(t){
    if (!t.dataset.aba) return;
    t.onclick = function(){
      document.querySelectorAll('.tab').forEach(function(x){ x.classList.remove('on'); });
      document.querySelectorAll('.painel').forEach(function(x){ x.classList.remove('on'); });
      t.classList.add('on');
      document.getElementById('painel-' + t.dataset.aba).classList.add('on');
      irParaAncora();
    };
  });
  // pula direto pra seção do produto do deal
  function irParaAncora(){
    if (!ANCORA) return;
    var painel = document.querySelector('.painel.on');
    var hs = painel.querySelectorAll('h1, h2');
    for (var i = 0; i < hs.length; i++) {
      if (hs[i].textContent.toLowerCase().indexOf(ANCORA) !== -1) { hs[i].scrollIntoView({behavior:'smooth'}); return; }
    }
  }
  setTimeout(irParaAncora, 250);
  // busca com highlight
  var t0 = null;
  document.getElementById('busca').addEventListener('input', function(e){
    clearTimeout(t0);
    var q = e.target.value.trim().toLowerCase();
    t0 = setTimeout(function(){
      document.querySelectorAll('.md mark').forEach(function(m){ m.replaceWith(m.textContent); });
      if (q.length < 3) return;
      var painel = document.querySelector('.painel.on .md');
      var walker = document.createTreeWalker(painel, NodeFilter.SHOW_TEXT);
      var alvo = null, node;
      while ((node = walker.nextNode())) {
        var idx = node.textContent.toLowerCase().indexOf(q);
        if (idx !== -1) {
          var r = document.createRange();
          r.setStart(node, idx); r.setEnd(node, idx + q.length);
          var mk = document.createElement('mark');
          try { r.surroundContents(mk); if (!alvo) alvo = mk; walker.currentNode = mk; } catch(_){}
        }
      }
      if (alvo) alvo.scrollIntoView({behavior:'smooth', block:'center'});
    }, 250);
  });
})();
</script>
</body>
</html>

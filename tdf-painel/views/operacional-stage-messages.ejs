<% const activePage = 'operacional'; const pageTitle = 'Operacional · Mensagens por Etapa'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
  .sm-shell { background:var(--bg); border:1px solid var(--border); border-radius:10px; padding:14px; max-width:1100px; margin:0 auto; }
  .sm-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px }
  .sm-head h2 { margin:0; font-size:16px; color:var(--text) }
  .sm-head .sub { color:var(--text-muted); font-size:12px }
  .sm-tabs { display:flex; gap:4px; background:var(--bg-card); border-radius:8px; padding:4px; margin-bottom:14px; width:fit-content }
  .sm-tab { padding:7px 14px; border-radius:6px; cursor:pointer; font-size:12px; color:var(--text-muted); font-weight:600 }
  .sm-tab.active { background:#1f6feb; color:#fff }
  .sm-list { background:var(--bg-card); border:1px solid var(--border); border-radius:8px; overflow:hidden }
  .sm-row { display:grid; grid-template-columns:24px 1fr 100px 90px 70px 90px; gap:10px; padding:10px 14px; align-items:center; border-bottom:1px solid var(--border); transition:background .1s }
  .sm-row:hover { background:var(--bg) }
  .sm-row:last-child { border-bottom:0 }
  .sm-row.disabled { opacity:.5 }
  .sm-stage-dot { width:10px; height:10px; border-radius:50%; }
  .sm-stage-info .code { color:var(--text); font-size:12px; font-weight:700 }
  .sm-stage-info .label { color:var(--text-muted); font-size:11px }
  .sm-mode { font-size:10px; padding:3px 7px; border-radius:4px; text-align:center; font-weight:700 }
  .sm-mode.session { background:rgba(34,197,94,.15); color:#22c55e }
  .sm-mode.template { background:rgba(31,111,235,.15); color:#1f6feb }
  .sm-mode.none { background:var(--border); color:var(--text-muted) }
  .sm-trigger-on { font-size:10px; color:#22c55e; text-align:center }
  .sm-trigger-off { font-size:10px; color:var(--text-muted); text-align:center }
  .sm-actions { display:flex; gap:4px; justify-content:flex-end }
  .sm-actions button { background:var(--border); border:1px solid var(--border); color:var(--text); padding:5px 8px; border-radius:4px; cursor:pointer; font-size:11px }
  .sm-actions button:hover { background:#1f6feb }
  .sm-toggle { width:36px; height:18px; background:#475569; border-radius:10px; position:relative; cursor:pointer; transition:background .15s }
  .sm-toggle.on { background:#22c55e }
  .sm-toggle::after { content:''; width:14px; height:14px; background:#fff; border-radius:50%; position:absolute; top:2px; left:2px; transition:left .15s }
  .sm-toggle.on::after { left:20px }

  /* Editor */
  .sm-editor { display:none; position:fixed; inset:0; background:rgba(0,0,0,.7); z-index:9000; align-items:center; justify-content:center }
  .sm-editor.show { display:flex }
  .sm-editor-card { background:var(--bg-card); border:1px solid var(--border); border-radius:12px; width:780px; max-width:95vw; max-height:90vh; display:flex; flex-direction:column }
  .sm-editor-h { padding:14px 18px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center }
  .sm-editor-h h3 { margin:0; font-size:14px; color:var(--text) }
  .sm-editor-body { flex:1; overflow-y:auto; padding:18px }
  .sm-field { margin-bottom:14px }
  .sm-field label { display:block; font-size:11px; color:#93c5fd; text-transform:uppercase; letter-spacing:.5px; margin-bottom:5px }
  .sm-field input, .sm-field select, .sm-field textarea { width:100%; background:var(--bg); border:1px solid var(--border); color:var(--text); padding:8px 10px; border-radius:5px; font-size:13px; font-family:inherit; box-sizing:border-box }
  .sm-field textarea { min-height:120px; resize:vertical }
  .sm-row-2 { display:grid; grid-template-columns:1fr 1fr; gap:12px }
  .sm-placeholders { background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:10px; max-height:120px; overflow-y:auto }
  .sm-placeholder-chip { display:inline-block; background:var(--border); color:#93c5fd; padding:3px 8px; border-radius:4px; font-size:11px; cursor:pointer; margin:2px; font-family:monospace }
  .sm-placeholder-chip:hover { background:#1f6feb; color:#fff }
  .sm-preview { background:var(--bg); border:1px dashed var(--border); border-radius:6px; padding:10px; color:#cbd5e1; font-size:12px; white-space:pre-wrap; min-height:40px }
  .sm-editor-foot { padding:14px 18px; border-top:1px solid var(--border); display:flex; justify-content:space-between; gap:10px; align-items:center; flex-wrap:wrap }
  .btn { padding:7px 14px; border-radius:6px; font-size:11px; font-weight:700; cursor:pointer; border:1px solid; background:transparent }
  .btn-sec { color:#93c5fd; border-color:#1f6feb }
  .btn-warn { color:#fbbf24; border-color:#eab308 }
  .btn-danger { color:#ef4444; border-color:#ef4444 }
  .btn-prim { background:#1f6feb; color:#fff; border-color:#1f6feb }
</style>

<div class="sm-shell">
  <div class="sm-head">
    <div>
      <h2>⚙️ Mensagens automáticas por etapa</h2>
      <div class="sub">Configure qual mensagem WATI dispara quando um cliente entra em cada etapa do kanban. Sem código.</div>
    </div>
    <a href="/operacional" class="btn btn-sec" style="text-decoration:none">← Voltar ao painel</a>
  </div>

  <div class="sm-tabs">
    <div class="sm-tab active" data-kanban="delivery" onclick="smSwitch('delivery')">🚚 Entregas TDF</div>
    <div class="sm-tab" data-kanban="shipment" onclick="smSwitch('shipment')">📦 Transportadora</div>
  </div>

  <div class="sm-list" id="sm-list"><div style="padding:30px;text-align:center;color:var(--text-muted)">Carregando…</div></div>
</div>

<!-- Editor Modal -->
<div class="sm-editor" id="sm-editor" onclick="if(event.target===this)smClose()">
  <div class="sm-editor-card">
    <div class="sm-editor-h">
      <h3 id="sm-editor-title">Editar mensagem</h3>
      <button class="btn btn-sec" onclick="smClose()">✕</button>
    </div>
    <div class="sm-editor-body">
      <div class="sm-row-2">
        <div class="sm-field">
          <label>Kanban</label>
          <input id="sm-f-kanban" disabled>
        </div>
        <div class="sm-field">
          <label>Etapa (code)</label>
          <input id="sm-f-stage" disabled>
        </div>
      </div>
      <div class="sm-row-2">
        <div class="sm-field">
          <label>Habilitada</label>
          <select id="sm-f-enabled"><option value="true">✅ Sim — dispara automaticamente</option><option value="false">❌ Não — só rascunho</option></select>
        </div>
        <div class="sm-field">
          <label>Modo</label>
          <select id="sm-f-mode" onchange="smModeChanged()">
            <option value="session">💬 Texto livre (sessão aberta)</option>
            <option value="template">📋 Template aprovado (ia_*)</option>
          </select>
        </div>
      </div>

      <!-- Modo session: textarea + placeholders -->
      <div id="sm-mode-session">
        <div class="sm-field">
          <label>Mensagem (use placeholders entre chaves)</label>
          <textarea id="sm-f-body" placeholder="Olá {customer_first_name}! Seu produto {product} está saindo pra entrega..." oninput="smPreview()"></textarea>
        </div>
        <div class="sm-field">
          <label>Placeholders disponíveis (click pra inserir)</label>
          <div class="sm-placeholders" id="sm-placeholders">—</div>
        </div>
        <div class="sm-field">
          <label>Preview com dados fictícios</label>
          <div class="sm-preview" id="sm-preview-text">—</div>
        </div>
      </div>

      <!-- Modo template -->
      <div id="sm-mode-template" style="display:none">
        <div class="sm-field">
          <label>Template name (deve começar com <code>ia_</code>)</label>
          <input id="sm-f-template-name" placeholder="ia_delivery_saiu_entrega">
        </div>
        <div class="sm-field">
          <label>Parâmetros (mapeia placeholder do template → variável)</label>
          <div id="sm-template-params"></div>
          <button class="btn btn-sec" style="margin-top:6px" onclick="smAddParam()">+ Parâmetro</button>
        </div>
      </div>

      <div class="sm-row-2">
        <div class="sm-field">
          <label>Disparar ao entrar na etapa</label>
          <select id="sm-f-trigger"><option value="true">Sim</option><option value="false">Não (manual)</option></select>
        </div>
        <div class="sm-field">
          <label>SLA (horas) — alerta se demora</label>
          <input type="number" id="sm-f-sla" min="0" placeholder="Ex: 48">
        </div>
      </div>
      <div class="sm-field">
        <label>Responsável padrão (opcional)</label>
        <input id="sm-f-resp" placeholder="email ou nome">
      </div>
    </div>
    <div class="sm-editor-foot">
      <div style="display:flex;gap:8px;align-items:center">
        <input id="sm-test-phone" placeholder="Phone teste (ex: 11999999999)" style="background:var(--bg);border:1px solid var(--border);color:var(--text);padding:6px 10px;border-radius:4px;font-size:12px;width:180px">
        <button class="btn btn-warn" onclick="smTest()">🚀 Testar envio</button>
      </div>
      <div style="display:flex;gap:8px">
        <button class="btn btn-danger" id="sm-btn-delete" onclick="smDelete()" style="display:none">🗑 Excluir</button>
        <button class="btn btn-sec" onclick="smClose()">Cancelar</button>
        <button class="btn btn-prim" onclick="smSave()">Salvar</button>
      </div>
    </div>
  </div>
</div>

<script>
let SM = {
  currentKanban: 'delivery',
  stages: {},        // kanban → [{code,label,color,sequence}]
  msgs: {},          // kanban → {stage_code → StageMessage}
  placeholders: {},  // kanban → [vars]
  editing: null,     // StageMessage atual no editor
  editStage: null,   // stage atual no editor
};

async function smLoad() {
  // Carrega placeholders + stages (delivery + shipment) + msgs do kanban atual
  try {
    SM.placeholders = await fetch('/operacional/api/stage-messages/placeholders').then(r => r.json());
    const [stagesDelivery, stagesShipment, msgsAll] = await Promise.all([
      fetch('/operacional/api/kanban/stages?kanban=delivery&active=true').then(r => r.json()),
      fetch('/operacional/api/kanban/stages?kanban=shipment&active=true').then(r => r.json()),
      fetch('/operacional/api/stage-messages').then(r => r.json()),
    ]);
    SM.stages = { delivery: stagesDelivery, shipment: stagesShipment };
    SM.msgs = { delivery: {}, shipment: {} };
    for (const m of msgsAll) {
      if (!SM.msgs[m.kanban]) SM.msgs[m.kanban] = {};
      SM.msgs[m.kanban][m.stage_code] = m;
    }
    smRender();
  } catch (e) {
    document.getElementById('sm-list').innerHTML = `<div style="padding:30px;color:#f87171">${e.message}</div>`;
  }
}

function smRender() {
  const stages = SM.stages[SM.currentKanban] || [];
  const list = document.getElementById('sm-list');
  if (!stages.length) {
    list.innerHTML = '<div style="padding:30px;text-align:center;color:#666">Sem etapas configuradas pra esse kanban</div>';
    return;
  }
  list.innerHTML = stages.map(s => {
    const m = SM.msgs[SM.currentKanban]?.[s.code];
    const enabled = m?.enabled;
    const mode = m ? m.mode : 'none';
    const modeLabel = m ? (m.mode === 'session' ? 'texto' : 'template') : '—';
    const trigger = m?.trigger_on_entry ? '✓ on' : '— off';
    const triggerClass = m?.trigger_on_entry ? 'sm-trigger-on' : 'sm-trigger-off';
    return `
      <div class="sm-row ${enabled === false ? 'disabled' : ''}">
        <div class="sm-stage-dot" style="background:${s.color}"></div>
        <div class="sm-stage-info">
          <div class="code">${s.label}</div>
          <div class="label"><code>${s.code}</code> · seq ${s.sequence}</div>
        </div>
        <span class="sm-mode ${mode}">${modeLabel}</span>
        <span class="${triggerClass}">${trigger}</span>
        <div onclick="smToggle('${s.code}')" class="sm-toggle ${enabled ? 'on' : ''}" title="Ativar/desativar"></div>
        <div class="sm-actions">
          <button onclick="smEdit('${s.code}')">${m ? '✏️ Editar' : '+ Criar'}</button>
        </div>
      </div>
    `;
  }).join('');
}

function smSwitch(kanban) {
  SM.currentKanban = kanban;
  document.querySelectorAll('.sm-tab').forEach(t => t.classList.toggle('active', t.dataset.kanban === kanban));
  smRender();
}

async function smToggle(stageCode) {
  const m = SM.msgs[SM.currentKanban]?.[stageCode];
  if (!m) {
    // Não existe — abre editor pra criar
    return smEdit(stageCode);
  }
  // Toggle enabled
  try {
    const updated = await fetch(`/operacional/api/stage-messages/${m.id}`, {
      method: 'PUT', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ ...m, enabled: !m.enabled })
    }).then(r => r.json());
    SM.msgs[SM.currentKanban][stageCode] = updated;
    smRender();
  } catch (e) { alert(e.message); }
}

function smEdit(stageCode) {
  const m = SM.msgs[SM.currentKanban]?.[stageCode];
  const stage = (SM.stages[SM.currentKanban] || []).find(s => s.code === stageCode);
  SM.editing = m;
  SM.editStage = stage;
  document.getElementById('sm-editor-title').textContent = `${m ? 'Editar' : 'Criar'} — ${stage?.label || stageCode}`;
  document.getElementById('sm-f-kanban').value = SM.currentKanban;
  document.getElementById('sm-f-stage').value = stageCode;
  document.getElementById('sm-f-enabled').value = m ? String(m.enabled) : 'true';
  document.getElementById('sm-f-mode').value = m?.mode || 'session';
  document.getElementById('sm-f-body').value = m?.body || '';
  document.getElementById('sm-f-template-name').value = m?.template_name || '';
  document.getElementById('sm-f-trigger').value = m ? String(m.trigger_on_entry) : 'true';
  document.getElementById('sm-f-sla').value = m?.sla_hours || '';
  document.getElementById('sm-f-resp').value = m?.default_responsible || '';
  document.getElementById('sm-btn-delete').style.display = m ? 'inline-block' : 'none';

  // Placeholders
  const phs = SM.placeholders[SM.currentKanban] || [];
  document.getElementById('sm-placeholders').innerHTML = phs.map(p =>
    `<span class="sm-placeholder-chip" onclick="smInsert('{${p}}')">{${p}}</span>`
  ).join('');

  // Template params
  smRenderParams(m?.template_params || []);

  smModeChanged();
  smPreview();
  document.getElementById('sm-editor').classList.add('show');
}

function smClose() {
  document.getElementById('sm-editor').classList.remove('show');
  SM.editing = null;
}

function smModeChanged() {
  const mode = document.getElementById('sm-f-mode').value;
  document.getElementById('sm-mode-session').style.display = mode === 'session' ? 'block' : 'none';
  document.getElementById('sm-mode-template').style.display = mode === 'template' ? 'block' : 'none';
}

function smInsert(text) {
  const ta = document.getElementById('sm-f-body');
  const start = ta.selectionStart || ta.value.length;
  ta.value = ta.value.slice(0, start) + text + ta.value.slice(start);
  ta.focus(); ta.selectionStart = ta.selectionEnd = start + text.length;
  smPreview();
}

const DUMMY = {
  customer_name: 'Maria Silva', customer_first_name: 'Maria',
  product: 'Bebedouro Industrial Inox', delivery_date: '15/05/2026',
  delivery_window: 'manhã', technician: 'Carlos Souza',
  technician_first_name: 'Carlos', city: 'São José dos Campos',
  state: 'SP', address: 'Av. Brasil, 100', stage_label: 'Saiu p/ Entrega',
  tracking_code: 'BR1234567890', expected_delivery: '17/05/2026',
  route_id: '13', responsible: 'Operador',
};

function smPreview() {
  const body = document.getElementById('sm-f-body').value;
  let preview = body;
  for (const [k, v] of Object.entries(DUMMY)) {
    preview = preview.replace(new RegExp(`\\{${k}\\}`, 'gi'), v);
  }
  document.getElementById('sm-preview-text').textContent = preview || '—';
}

function smRenderParams(params) {
  const phs = SM.placeholders[SM.currentKanban] || [];
  const optHTML = phs.map(p => `<option value="${p}">${p}</option>`).join('');
  document.getElementById('sm-template-params').innerHTML = params.map((p, i) => `
    <div style="display:grid;grid-template-columns:80px 1fr 30px;gap:6px;margin-bottom:4px">
      <input value="${p.name||''}" placeholder="1" id="sm-pn-${i}" style="background:#0D1117;border:1px solid #30363D;color:#fff;padding:5px;border-radius:4px;font-size:11px">
      <select id="sm-ps-${i}" style="background:#0D1117;border:1px solid #30363D;color:#fff;padding:5px;border-radius:4px;font-size:11px">${optHTML.replace(`value="${p.source}"`, `value="${p.source}" selected`)}</select>
      <button onclick="smRemoveParam(${i})" style="background:#21262D;border:0;color:#ef4444;border-radius:4px;cursor:pointer">×</button>
    </div>
  `).join('');
}

function _collectParams() {
  const phs = SM.placeholders[SM.currentKanban] || [];
  const out = [];
  let i = 0;
  while (document.getElementById(`sm-pn-${i}`)) {
    out.push({
      name: document.getElementById(`sm-pn-${i}`).value,
      source: document.getElementById(`sm-ps-${i}`).value,
    });
    i++;
  }
  return out;
}

function smAddParam() {
  const cur = _collectParams();
  cur.push({ name: String(cur.length + 1), source: 'customer_first_name' });
  smRenderParams(cur);
}

function smRemoveParam(i) {
  const cur = _collectParams();
  cur.splice(i, 1);
  smRenderParams(cur);
}

async function smSave() {
  const body = {
    kanban: SM.currentKanban,
    stage_code: SM.editStage.code,
    enabled: document.getElementById('sm-f-enabled').value === 'true',
    mode: document.getElementById('sm-f-mode').value,
    template_name: document.getElementById('sm-f-template-name').value || null,
    template_params: _collectParams(),
    body: document.getElementById('sm-f-body').value || null,
    trigger_on_entry: document.getElementById('sm-f-trigger').value === 'true',
    sla_hours: parseInt(document.getElementById('sm-f-sla').value) || null,
    default_responsible: document.getElementById('sm-f-resp').value || null,
  };
  try {
    let resp;
    if (SM.editing) {
      resp = await fetch(`/operacional/api/stage-messages/${SM.editing.id}`, {
        method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
      });
    } else {
      resp = await fetch('/operacional/api/stage-messages', {
        method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
      });
    }
    if (!resp.ok) throw new Error((await resp.json()).error || `HTTP ${resp.status}`);
    smClose();
    smLoad();
  } catch (e) { alert(e.message); }
}

async function smDelete() {
  if (!SM.editing) return;
  if (!confirm(`Excluir configuração da etapa "${SM.editStage?.label}"?`)) return;
  try {
    await fetch(`/operacional/api/stage-messages/${SM.editing.id}`, { method:'DELETE' });
    smClose(); smLoad();
  } catch (e) { alert(e.message); }
}

async function smTest() {
  if (!SM.editing) return alert('Salve primeiro antes de testar (precisa de ID).');
  const phone = document.getElementById('sm-test-phone').value.replace(/\D/g, '');
  if (!phone) return alert('Informe um phone de teste');
  try {
    const r = await fetch(`/operacional/api/stage-messages/${SM.editing.id}/test`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ phone })
    }).then(r => r.json());
    if (r.sent) alert('✅ Mensagem enviada com sucesso!\n\n' + (r.preview || r.template || ''));
    else alert(`❌ Falhou: ${r.error || r.skipped_reason || 'desconhecido'}`);
  } catch (e) { alert(e.message); }
}

smLoad();
</script>

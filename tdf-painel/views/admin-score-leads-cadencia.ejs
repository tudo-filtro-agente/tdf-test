// Cada step vira uma linha resumida, clicável (abre modal pra editar).
// Buttons de mover ↑↓ e remover ficam ao lado.
function stepRowHtml(tier, idx, s, cadenceCfg){
  let offsetMin = s.offset_minutes;
  if (offsetMin == null && s.day != null) {
    offsetMin = (Number(s.day)||0) * 1440 + (Number(s.hour)||9) * 60 + (Number(s.minute)||0);
  }
  if (offsetMin == null) offsetMin = 0;
  let unit = 'min', value = offsetMin;
  if (offsetMin >= 1440 && offsetMin % 1440 === 0) { unit = 'd'; value = offsetMin/1440; }
  else if (offsetMin >= 60 && offsetMin % 60 === 0) { unit = 'h'; value = offsetMin/60; }
  const whenLabel = s.day != null && s.hour != null
    ? `D+${s.day||0} ${String(s.hour).padStart(2,'0')}:${String(s.minute||0).padStart(2,'0')}`
    : `+${value}${unit}`;
  const withReminder = s.with_reminder != null ? s.with_reminder : (cadenceCfg.remind_default !== false);
  const businessHoursOnly = s.business_hours_only !== false;
  const isFarewell = s.is_farewell === true;
  const chIcon = s.channel === 'call' ? '📞' : s.channel === 'whatsapp' ? '💬' : s.channel === 'email' ? '📧' : s.channel === 'wait' ? '⏸️' : '⚠️';
  const labelDisplay = isFarewell ? '🙏 ' + (s.label || 'Despedida final') : (s.label || `(sem nome — ${s.channel})`);
  // armazena step inteiro como JSON no dataset pra abrir modal de edição
  const dataJson = encodeURIComponent(JSON.stringify(s));
  return `
    <div class="lsc-step-summary" data-tier="${tier}" data-idx="${idx}" data-json="${dataJson}"
         draggable="true"
         ondragstart="lscDragStart(event, '${tier}', ${idx})"
         ondragover="lscDragOver(event, this)"
         ondragleave="lscDragLeave(event, this)"
         ondrop="lscDrop(event, '${tier}', ${idx}, this)"
         ondragend="lscDragEnd(event, this)"
         onclick="if (event.target.classList.contains('drag-handle')) return; lscOpenStepModal('${tier}', ${idx}, decodeURIComponent(this.dataset.json))"
         title="Arraste pelo ⋮⋮ pra reordenar — clique no resto pra editar">
      <div class="drag-handle" title="Arraste pra reordenar">⋮⋮</div>
      <div class="idx">${idx+1}</div>
      <div class="when">${whenLabel}</div>
      <div class="abs">—</div>
      <div class="ch">${chIcon} ${s.channel}</div>
      <div class="lab">${escapeHtml(labelDisplay)}</div>
      <div class="pri ${s.priority||'Normal'}">${s.priority||'Normal'}</div>
      <div class="badge" title="${withReminder?'popup ON':'popup OFF'}">${withReminder?'🔔':'·'}</div>
      <div class="badge" title="${businessHoursOnly?'só horário comercial':'qualquer hora'}">${businessHoursOnly?'🕐':'·'}</div>
      <div class="moveb" onclick="event.stopPropagation()">
        <button onclick="lscMoveStep('${tier}', ${idx}, -1)" title="mover acima">▲</button>
        <button onclick="lscMoveStep('${tier}', ${idx}, 1)" title="mover abaixo">▼</button>
        <button class="d" onclick="lscDeleteStep('${tier}', ${idx})" title="excluir">×</button>
      </div>
    </div>
  `;
}

// _LSC_STEPS_BUFFER[tier] = array de steps em edição (estado client-side)
const _LSC_STEPS_BUFFER = {};

// ============== DRAG-AND-DROP REORDER ==============
let _LSC_DRAG = null;   // { tier, idx }

function lscDragStart(e, tier, idx) {
  _LSC_DRAG = { tier, idx };
  e.dataTransfer.effectAllowed = 'move';
  // necessário pra Firefox aceitar o drag
  try { e.dataTransfer.setData('text/plain', `${tier}:${idx}`); } catch (_) {}
  e.currentTarget.classList.add('dragging');
}

function lscDragOver(e, el) {
  if (!_LSC_DRAG) return;
  const tier = el.dataset.tier;
  if (_LSC_DRAG.tier !== tier) return; // só reordena no mesmo tier
  e.preventDefault();
  e.dataTransfer.dropEffect = 'move';
  // mostra indicador de top/bottom
  const rect = el.getBoundingClientRect();
  const mid = rect.top + rect.height / 2;
  el.classList.remove('drag-over-top', 'drag-over-bottom');
  if (e.clientY < mid) el.classList.add('drag-over-top');
  else el.classList.add('drag-over-bottom');
}

function lscDragLeave(e, el) {
  el.classList.remove('drag-over-top', 'drag-over-bottom');
}

function lscDrop(e, tier, dropIdx, el) {
  e.preventDefault();
  el.classList.remove('drag-over-top', 'drag-over-bottom');
  if (!_LSC_DRAG || _LSC_DRAG.tier !== tier) { _LSC_DRAG = null; return; }
  const fromIdx = _LSC_DRAG.idx;
  if (fromIdx === dropIdx) { _LSC_DRAG = null; return; }

  // Decide se vai acima ou abaixo do alvo
  const rect = el.getBoundingClientRect();
  const mid = rect.top + rect.height / 2;
  const before = e.clientY < mid;

  const arr = _LSC_STEPS_BUFFER[tier] || [];
  const item = arr[fromIdx];
  arr.splice(fromIdx, 1);
  let insertAt = dropIdx;
  // ajusta índice depois da remoção
  if (fromIdx < dropIdx) insertAt = dropIdx - 1;
  if (!before) insertAt += 1;
  arr.splice(insertAt, 0, item);

  // Despedida sempre forçada ao final
  const fw = arr.filter(s => s.is_farewell);
  const norm = arr.filter(s => !s.is_farewell);
  _LSC_STEPS_BUFFER[tier] = norm.concat(fw);

  _LSC_DRAG = null;
  lscRerenderSteps(tier);
}

function lscDragEnd(e, el) {
  el.classList.remove('dragging');
  document.querySelectorAll('.drag-over-top, .drag-over-bottom').forEach(x => {
    x.classList.remove('drag-over-top', 'drag-over-bottom');
  });
  _LSC_DRAG = null;
}

function lscMoveStep(tier, idx, delta){
  const arr = _LSC_STEPS_BUFFER[tier] || [];
  const j = idx + delta;
  if (j < 0 || j >= arr.length) return;
  const tmp = arr[idx]; arr[idx] = arr[j]; arr[j] = tmp;
  lscRerenderSteps(tier);
}

function lscDeleteStep(tier, idx){
  const arr = _LSC_STEPS_BUFFER[tier] || [];
  arr.splice(idx, 1);
  lscRerenderSteps(tier);
}

function lscRerenderSteps(tier){
  const cardEl = document.getElementById(`ls-c-${tier}-steps`);
  if (!cardEl) return;
  const cadCfg = _LSC_DATA.find(c => c.tier === tier) || { remind_default: true };
  const arr = _LSC_STEPS_BUFFER[tier] || [];
  cardEl.innerHTML = arr.map((s, i) => stepRowHtml(tier, i, s, cadCfg)).join('');
  lscRefreshAbsTimes(tier);
}

// Adiciona passo direto no buffer (usado por pacotes prontos).
function lscAddStep(tier, value, unit, channel, labelDefault, extras){
  if (!_LSC_STEPS_BUFFER[tier]) _LSC_STEPS_BUFFER[tier] = [];
  const offset_minutes = unit === 'd' ? value*1440 : (unit === 'h' ? value*60 : value);
  const label = labelDefault || `${channel === 'call' ? 'Ligação' : channel === 'whatsapp' ? 'WhatsApp' : channel} (+${value}${unit})`;
  _LSC_STEPS_BUFFER[tier].push(Object.assign({
    offset_minutes, channel: channel || 'whatsapp',
    label, priority: channel === 'call' ? 'High' : 'Normal',
    with_reminder: true, business_hours_only: true,
  }, extras || {}));
  lscRerenderSteps(tier);
}

function lscAddPack3Calls(tier){
  lscAddStep(tier, 30, 'min', 'call', '📞 Ligação 1 (imediato)');
  lscAddStep(tier, 2, 'h', 'call', '📞 Ligação 2 (2h depois)');
  lscAddStep(tier, 4, 'h', 'call', '📞 Ligação 3 (4h depois)');
}

function lscAddPack5Days(tier){
  for (let d = 1; d <= 5; d++) {
    lscAddStep(tier, d*24, 'h', 'call', `📞 Ligação D+${d}`);
    lscAddStep(tier, d*24+4, 'h', 'whatsapp', `💬 WhatsApp D+${d} (tarde)`);
  }
}

// ============== MODAL DE PASSO ==============
let _LSC_MODAL_CTX = null;  // { tier, idx, is_farewell }

function lscOpenStepModal(tier, idx, jsonOrEmpty){
  // idx === -1 → novo passo
  // idx >= 0  → editar existente
  const isNew = idx == null || idx < 0;
  let s = {};
  try { s = typeof jsonOrEmpty === 'string' ? JSON.parse(jsonOrEmpty) : (jsonOrEmpty || {}); } catch(_) { s = {}; }
  _LSC_MODAL_CTX = { tier, idx: isNew ? -1 : Number(idx), is_farewell: !!s.is_farewell };
  document.getElementById('lsc-step-modal-title').textContent = isNew
    ? (s.is_farewell ? '🙏 Tarefa de despedida (última)' : '➕ Novo passo da cadência')
    : (s.is_farewell ? '🙏 Editar tarefa de despedida' : '✏️ Editar passo da cadência');
  document.getElementById('lsc-step-tier').value = tier;
  document.getElementById('lsc-step-idx').value = isNew ? '' : idx;
  document.getElementById('lsc-step-label').value = s.label || (s.is_farewell ? '🙏 Última tentativa — despedida' : '');
  document.getElementById('lsc-step-channel').value = s.channel || (s.is_farewell ? 'whatsapp' : 'whatsapp');
  document.getElementById('lsc-step-priority').value = s.priority || 'Normal';
  document.getElementById('lsc-step-desc').value = s.description || '';
  document.getElementById('lsc-step-duration').value = s.duration_minutes || 15;
  document.getElementById('lsc-step-remind').checked = s.with_reminder !== false;
  document.getElementById('lsc-step-bh').checked = s.business_hours_only !== false;
  // when
  let offsetMin = s.offset_minutes;
  if (offsetMin == null && s.day != null) {
    offsetMin = (Number(s.day)||0)*1440 + (Number(s.hour)||9)*60 + (Number(s.minute)||0);
  }
  if (offsetMin == null) offsetMin = 30;
  let unit = 'min', value = offsetMin;
  if (offsetMin >= 1440 && offsetMin % 1440 === 0) { unit = 'd'; value = offsetMin/1440; }
  else if (offsetMin >= 60 && offsetMin % 60 === 0) { unit = 'h'; value = offsetMin/60; }
  if (s.day != null && s.hour != null) {
    document.querySelector('input[name="lsc-when"][value="fixed"]').checked = true;
    document.getElementById('lsc-step-day').value = s.day;
    document.getElementById('lsc-step-time').value = `${String(s.hour).padStart(2,'0')}:${String(s.minute||0).padStart(2,'0')}`;
    document.getElementById('lsc-step-off-value').value = value;
    document.getElementById('lsc-step-off-unit').value = unit;
  } else {
    document.querySelector('input[name="lsc-when"][value="offset"]').checked = true;
    document.getElementById('lsc-step-off-value').value = value;
    document.getElementById('lsc-step-off-unit').value = unit;
    document.getElementById('lsc-step-day').value = 0;
    document.getElementById('lsc-step-time').value = '09:00';
  }
  lscWhenSwitch();
  document.getElementById('lsc-step-modal').classList.add('open');
}

function lscWhenSwitch(){
  const mode = document.querySelector('input[name="lsc-when"]:checked').value;
  document.getElementById('lsc-when-offset').style.display = mode === 'offset' ? '' : 'none';
  document.getElementById('lsc-when-fixed').style.display = mode === 'fixed' ? '' : 'none';
}

function lscCloseStepModal(){
  document.getElementById('lsc-step-modal').classList.remove('open');
  _LSC_MODAL_CTX = null;
}

function lscSaveStepModal(){
  if (!_LSC_MODAL_CTX) return;
  const { tier, idx, is_farewell } = _LSC_MODAL_CTX;
  const channel = document.getElementById('lsc-step-channel').value;
  const label = document.getElementById('lsc-step-label').value.trim() || `(${channel} sem nome)`;
  const priority = document.getElementById('lsc-step-priority').value;
  const description = document.getElementById('lsc-step-desc').value.trim() || undefined;
  const duration_minutes = Number(document.getElementById('lsc-step-duration').value) || 15;
  const with_reminder = document.getElementById('lsc-step-remind').checked;
  const business_hours_only = document.getElementById('lsc-step-bh').checked;
  const whenMode = document.querySelector('input[name="lsc-when"]:checked').value;
  const step = { channel, label, priority, description, duration_minutes, with_reminder, business_hours_only };
  if (whenMode === 'offset') {
    const v = Number(document.getElementById('lsc-step-off-value').value) || 0;
    const u = document.getElementById('lsc-step-off-unit').value;
    step.offset_minutes = u === 'd' ? v*1440 : (u === 'h' ? v*60 : v);
  } else {
    step.day = Number(document.getElementById('lsc-step-day').value) || 0;
    const [hh, mm] = (document.getElementById('lsc-step-time').value || '09:00').split(':').map(n => Number(n)||0);
    step.hour = hh; step.minute = mm;
    step.offset_minutes = step.day*1440 + step.hour*60 + step.minute;
  }
  if (is_farewell) step.is_farewell = true;

  if (!_LSC_STEPS_BUFFER[tier]) _LSC_STEPS_BUFFER[tier] = [];
  if (idx === -1) {
    if (is_farewell) {
      // remove despedida anterior, se houver
      _LSC_STEPS_BUFFER[tier] = _LSC_STEPS_BUFFER[tier].filter(s => !s.is_farewell);
    }
    _LSC_STEPS_BUFFER[tier].push(step);
  } else {
    _LSC_STEPS_BUFFER[tier][idx] = step;
  }
  // se é despedida, força ela ser sempre o último: ordena por offset_minutes e move farewell ao fim
  if (is_farewell) {
    const fw = _LSC_STEPS_BUFFER[tier].filter(s => s.is_farewell);
    const norm = _LSC_STEPS_BUFFER[tier].filter(s => !s.is_farewell);
    _LSC_STEPS_BUFFER[tier] = norm.concat(fw);
  }
  lscRerenderSteps(tier);
  lscCloseStepModal();
}

function lscOpenFarewellModal(tier){
  // Procura despedida existente
  const arr = _LSC_STEPS_BUFFER[tier] || [];
  const existingIdx = arr.findIndex(s => s.is_farewell);
  if (existingIdx >= 0) {
    lscOpenStepModal(tier, existingIdx, JSON.stringify(arr[existingIdx]));
  } else {
    // Default: offset = último + 1 dia
    const maxOffset = arr.length ? Math.max(...arr.map(s => s.offset_minutes||0)) : 0;
    lscOpenStepModal(tier, -1, JSON.stringify({
      is_farewell: true,
      offset_minutes: maxOffset + 1440,
      channel: 'whatsapp',
      label: '🙏 Última tentativa — despedida',
      priority: 'Normal',
      with_reminder: true,
      business_hours_only: true,
      description: 'Última mensagem antes de encerrar a cadência. Use tom respeitoso, deixa porta aberta.',
    }));
  }
}

// Recalcula horário absoluto previsto (relativo a agora) pra cada passo
function lscRefreshAbsTimes(tier){
  const now = new Date();
  const arr = _LSC_STEPS_BUFFER[tier] || [];
  document.querySelectorAll(`#ls-c-${tier}-steps .lsc-step-summary`).forEach((row, i) => {
    const s = arr[i]; if (!s) return;
    let minutes = s.offset_minutes;
    if (minutes == null && s.day != null) {
      minutes = (Number(s.day)||0)*1440 + (Number(s.hour)||9)*60 + (Number(s.minute)||0);
    }
    if (minutes == null) minutes = 0;
    let when = new Date(now.getTime() + minutes*60000);
    const bhOnly = s.business_hours_only !== false;
    if (bhOnly) when = lscBumpBusinessHours(when);
    const el = row.querySelector('.abs');
    if (el) {
      const pad = n => String(n).padStart(2, '0');
      el.textContent = `${pad(when.getDate())}/${pad(when.getMonth()+1)} ${pad(when.getHours())}:${pad(when.getMinutes())}`;
    }
  });
}

function lscBumpBusinessHours(date){
  const isIn = (d) => {
    const dow = d.getDay();
    if (dow === 0) return false;
    const cur = d.getHours()*60 + d.getMinutes();
    if (dow === 6) return cur >= 540 && cur < 780;
    return cur >= 540 && cur < 1080;
  };
  if (isIn(date)) return date;
  const d = new Date(date);
  const dow = d.getDay();
  if (dow >= 1 && dow <= 6) {
    const cur = d.getHours()*60 + d.getMinutes();
    if (cur < 540) { d.setHours(9, 0, 0, 0); return d; }
  }
  for (let i = 1; i <= 14; i++) {
    const next = new Date(d);
    next.setDate(next.getDate() + i);
    const nd = next.getDay();
    if (nd === 0) continue;
    next.setHours(9, 0, 0, 0);
    return next;
  }
  return date;
}

async function lscSave(tier){
  // Buffer já mantém ordem do usuário. Salva como tá (despedida já foi forçada ao final no save do modal).
  const steps = (_LSC_STEPS_BUFFER[tier] || []).slice();

  const payload = {
    product_type: _LSC_PRODUCT || null,
    layout: _LSC_LAYOUT || null,
    pipeline: _LSC_PIPELINE || null,
    stage: _LSC_STAGE || null,
    sla_first_call_minutes: Number(document.getElementById(`ls-c-${tier}-sla`).value),
    max_attempts: Number(document.getElementById(`ls-c-${tier}-max`).value),
    assignee_role: document.getElementById(`ls-c-${tier}-role`).value,
    remind_default: document.getElementById(`ls-c-${tier}-remind`).value === '1',
    is_active: document.getElementById(`ls-c-${tier}-active`).value === '1',
    steps,
    assignee_pool: _LSC_POOL_BUFFER[tier] || [],
    reason: 'edit via UI',
  };
  const r = await fetch(`/api/lead-score/cadences/${tier}`, {
    method:'PUT', headers:{'Content-Type':'application/json'},
    body: JSON.stringify(payload)
  }).then(r=>r.json());
  if (!r.ok) { alert(r.error||'erro'); return; }
  let msg = `✅ Cadência ${tier} salva (${steps.length} passos) · ${lscFilterLabel()}.`;
  if (r.reapply) {
    msg += `\n\n⚡ Handoff (assignee_role mudou): reforçado em ${r.reapply.redispatched||0} runs ativos`;
    if (r.reapply.errors) msg += ` (${r.reapply.errors} erros)`;
  }
  alert(msg);
  lscLoad();
}

async function lscCreateSpecific(tier){
  // Copia do fallback puro como base (tier sozinho, todos NULL)
  const fb = await fetch('/api/lead-score/cadences?product=&layout=&pipeline=&stage=').then(r=>r.json());
  const base = (fb.items||[]).find(c => c.tier === tier && !c.product_type && !c.layout && !c.pipeline && !c.stage);
  if (!base) { alert('fallback puro não encontrado pra '+tier); return; }
  const payload = {
    product_type: _LSC_PRODUCT || null,
    layout: _LSC_LAYOUT || null,
    pipeline: _LSC_PIPELINE || null,
    stage: _LSC_STAGE || null,
    sla_first_call_minutes: base.sla_first_call_minutes,
    max_attempts: base.max_attempts,
    assignee_role: base.assignee_role,
    remind_default: base.remind_default,
    is_active: true,
    steps: base.steps_json || [],
    reason: `clonada do fallback ${tier} pra ${lscFilterLabel()}`,
  };
  const r = await fetch(`/api/lead-score/cadences/${tier}`, {
    method:'PUT', headers:{'Content-Type':'application/json'},
    body: JSON.stringify(payload)
  }).then(r=>r.json());
  if (!r.ok) { alert(r.error||'erro'); return; }
  lscLoad();
}

async function lscDeleteSpecific(id){
  if (!confirm('Apagar essa cadência específica? (volta a usar o fallback do tier)')) return;
  await fetch(`/api/lead-score/cadences/${id}?reason=manual delete via UI`, { method:'DELETE' });
  lscLoad();
}

async function lscReseed(){
  if (!confirm('Recriar os 5 fallbacks default? (só sobrescreve se nunca foram editados)')) return;
  // chama /api/lead-score/reseed que também seeda critérios — vamos limitar
  // pra cadência não tem endpoint dedicado; vou fazer chamadas individuais via PUT
  alert('Pra forçar reseed das cadências, set LEAD_SCORE_FORCE_RESEED=1 e restart o portal.\nPor enquanto, basta cliques individuais no Salvar pra cada fallback.');
}

async function lscLoadRuns(){
  const r = await fetch('/api/lead-score/cadence-runs?status=active&limit=100').then(r=>r.json());
  if (!r.ok) { document.getElementById('lsc-runs').innerHTML = `<div style="color:#ef4444">${r.error}</div>`; return; }
  const items = r.items || [];
  document.getElementById('lsc-runs-count').textContent = `${items.length} runs ativos`;
  if (!items.length) {
    document.getElementById('lsc-runs').innerHTML = '<div style="color:#888;padding:14px;text-align:center;background:#161725;border:1px solid #30363D;border-radius:8px">Nenhuma cadência em execução no momento.</div>';
    return;
  }
  document.getElementById('lsc-runs').innerHTML = `
    <table class="lsc-runs-tbl">
      <thead><tr><th>Deal</th><th>Tier</th><th>Produto</th><th>Layout</th><th>Funil</th><th>Etapa</th><th>Passo</th><th>Próxima ação</th><th>Última atividade Zoho</th><th>Iniciado</th><th></th></tr></thead>
      <tbody>
        ${items.map(r=>`
          <tr>
            <td>
              <code style="color:#a371f7;cursor:pointer;padding:3px 6px;border-radius:3px;background:rgba(167,113,247,.08);border:1px solid rgba(167,113,247,.3)"
                    onclick="copyText('${escapeHtml(r.deal_id)}', this, 'Deal ID')"
                    title="Clique pra copiar">📋 ${escapeHtml(r.deal_id)}</code>
              <a href="https://crmplus.zoho.com/tudodefiltro3711/index.do/cxapp/crm/org856385701/tab/Potentials/${escapeHtml(r.deal_id)}" target="_blank" style="margin-left:4px;color:#06b6d4;text-decoration:none" title="Abrir no Zoho">↗</a>
            </td>
            <td><strong>${escapeHtml(r.cadence_tier)}</strong></td>
            <td>${escapeHtml(r.cadence_product_type||'—')}</td>
            <td>${escapeHtml(r.cadence_layout||'—')}</td>
            <td>${escapeHtml(r.cadence_pipeline||'—')}</td>
            <td>${escapeHtml(r.cadence_stage||'—')}</td>
            <td>${r.step_index_current+1}</td>
            <td>${r.next_action_at?new Date(r.next_action_at).toLocaleString('pt-BR'):'-'}</td>
            <td>${r.last_zoho_task_id?'<code style="font-size:10px">'+r.last_zoho_task_id+'</code>':'-'}</td>
            <td>${new Date(r.started_at).toLocaleString('pt-BR')}</td>
            <td><button class="lsc-btn d" onclick="lscCancelRun('${r.deal_id}')">✋ Cancelar</button></td>
          </tr>
        `).join('')}
      </tbody>
    </table>
  `;
}

async function lscCancelRun(dealId){
  const reason = prompt('Motivo do cancelamento:'); if (!reason) return;
  await fetch(`/api/lead-score/cadence-runs/${encodeURIComponent(dealId)}?reason=${encodeURIComponent(reason)}`, { method:'DELETE' });
  lscLoadRuns();
}

async function lscRunNow(){
  const btn = event.target; btn.disabled = true; btn.textContent = '⏳ Processando...';
  try {
    const r = await fetch('/api/lead-score/cadence-progress/run-now', { method:'POST', headers:{'Content-Type':'application/json'}, body:'{}' }).then(r=>r.json());
    if (!r.ok) { alert(r.error||'erro'); return; }
    alert(`processed=${r.processed} · advanced=${r.advanced} · completed=${r.completed} · errors=${r.errors}`);
    lscLoadRuns();
  } finally { btn.disabled = false; btn.textContent = '⚡ Forçar avanço cron agora'; }
}

function escapeHtml(s){ return String(s||'').replace(/[&<>"']/g, c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }
function escapeAttr(s){ return escapeHtml(s); }

lscLoad();
</script>

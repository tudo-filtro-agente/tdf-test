<script>
let cwOpen = false;
let cwHistory = [];

function toggleChatWidget() {
  cwOpen = !cwOpen;
  document.getElementById('chat-widget').style.display = cwOpen ? 'flex' : 'none';
  if (cwOpen) document.getElementById('cw-input').focus();
}

async function sendChatWidget() {
  const input = document.getElementById('cw-input');
  const msg = input.value.trim();
  if (!msg) return;
  input.value = '';

  const container = document.getElementById('cw-messages');

  // Add user message
  const userDiv = document.createElement('div');
  userDiv.className = 'cw-msg cw-user';
  userDiv.textContent = msg;
  container.appendChild(userDiv);

  // Add typing indicator
  const typing = document.createElement('div');
  typing.className = 'cw-typing';
  typing.textContent = 'Pensando';
  container.appendChild(typing);
  container.scrollTop = container.scrollHeight;

  cwHistory.push({ role: 'user', content: msg });

  try {
    const res = await fetch('/ia/ask', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message: msg, history: cwHistory.slice(-10) })
    });
    const data = await res.json();
    typing.remove();

    const aiDiv = document.createElement('div');
    aiDiv.className = 'cw-msg cw-ai';
    aiDiv.textContent = data.response || 'Desculpe, tive um problema. Tenta de novo!';
    container.appendChild(aiDiv);

    cwHistory.push({ role: 'assistant', content: data.response || '' });
  } catch (e) {
    typing.remove();
    const errDiv = document.createElement('div');
    errDiv.className = 'cw-msg cw-ai';
    errDiv.textContent = 'Erro de conexão. Tenta de novo!';
    container.appendChild(errDiv);
  }

  container.scrollTop = container.scrollHeight;
}
</script>

<script>
  // Anti-copy protection
  document.addEventListener('contextmenu', e => e.preventDefault());
  document.addEventListener('keydown', e => {
    if (e.key === 'F12' ||
        (e.ctrlKey && ['c','a','u','s','p'].includes(e.key.toLowerCase())) ||
        e.key === 'PrintScreen') {
      e.preventDefault();
    }
  });
  document.addEventListener('dragstart', e => {
    // permite drag em elementos explicitamente marcados (kanban, sortable etc.)
    const t = e.target;
    if (t && t.nodeType === 1) {
      if (t.getAttribute && t.getAttribute('draggable') === 'true') return;
      if (t.closest && t.closest('[draggable="true"]')) return;
    }
    e.preventDefault();
  });

  // ============= SOM DE NOTIFICAÇÃO (ICQ "uh-oh", MSN "ding", nudge) =============
  // Gerados via Web Audio API — não precisa de arquivo mp3.
  // IMPORTANTE: navegadores bloqueiam AudioContext até o user interagir com a página.
  // Por isso, no primeiro click/keydown, "destravamos" o contexto.
  window.tdfSons = (function(){
    const KEY_MUTE = 'tdf_som_mute_v1';
    const KEY_TIPO = 'tdf_som_tipo_v1';
    let _ctx = null;
    let _unlocked = false;
    function ctx() {
      if (_ctx) return _ctx;
      try { _ctx = new (window.AudioContext || window.webkitAudioContext)(); } catch(_){}
      return _ctx;
    }
    // Desbloqueia AudioContext no 1º gesto do usuário (click, key, touch)
    function unlock() {
      if (_unlocked) return;
      const c = ctx();
      if (!c) return;
      try {
        if (c.state === 'suspended') c.resume();
        // Toca um buffer SILENCIOSO pra "ativar" o contexto definitivamente
        const buf = c.createBuffer(1, 1, 22050);
        const src = c.createBufferSource();
        src.buffer = buf;
        src.connect(c.destination);
        src.start(0);
        _unlocked = true;
        console.log('[tdfSons] AudioContext desbloqueado');
      } catch(e) { console.warn('[tdfSons] unlock:', e.message); }
    }
    document.addEventListener('click', unlock, { once: false, passive: true });
    document.addEventListener('keydown', unlock, { once: false, passive: true });
    document.addEventListener('touchstart', unlock, { once: false, passive: true });
    function tone(c, freq, start, dur, type, vol) {
      const osc = c.createOscillator();
      const gain = c.createGain();
      osc.frequency.value = freq;
      osc.type = type || 'sine';
      const t0 = c.currentTime + start;
      gain.gain.setValueAtTime(0.0001, t0);
      gain.gain.exponentialRampToValueAtTime(vol || 0.15, t0 + 0.005);
      gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
      osc.connect(gain); gain.connect(c.destination);
      osc.start(t0); osc.stop(t0 + dur + 0.01);
    }
    // Tone com pitch slide (portamento) e envelope ataque-decay customizado
    function toneSlide(c, freqStart, freqEnd, start, dur, type, vol, attackPct) {
      const osc = c.createOscillator();
      const gain = c.createGain();
      osc.type = type || 'sine';
      const t0 = c.currentTime + start;
      osc.frequency.setValueAtTime(freqStart, t0);
      osc.frequency.exponentialRampToValueAtTime(Math.max(20, freqEnd), t0 + dur);
      const att = (attackPct ?? 0.08) * dur;
      gain.gain.setValueAtTime(0.0001, t0);
      gain.gain.exponentialRampToValueAtTime(vol || 0.15, t0 + att);
      gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);
      osc.connect(gain); gain.connect(c.destination);
      osc.start(t0); osc.stop(t0 + dur + 0.01);
    }
    // Bell-like tone: harmônicos múltiplos com decays diferentes (mais autêntico que sine sozinho)
    function bell(c, fund, start, dur, vol) {
      const harm = [
        { mult: 1.0, vol: 1.0,  decay: 1.0 },
        { mult: 2.0, vol: 0.5,  decay: 0.7 },
        { mult: 3.0, vol: 0.25, decay: 0.5 },
        { mult: 4.2, vol: 0.15, decay: 0.4 },
      ];
      harm.forEach(h => {
        const osc = c.createOscillator();
        const g = c.createGain();
        osc.type = 'sine';
        osc.frequency.value = fund * h.mult;
        const t0 = c.currentTime + start;
        const d = dur * h.decay;
        g.gain.setValueAtTime(0.0001, t0);
        g.gain.exponentialRampToValueAtTime((vol || 0.15) * h.vol, t0 + 0.003);
        g.gain.exponentialRampToValueAtTime(0.0001, t0 + d);
        osc.connect(g); g.connect(c.destination);
        osc.start(t0); osc.stop(t0 + d + 0.01);
      });
    }
    return {
      isMute(){ return localStorage.getItem(KEY_MUTE) === '1'; },
      setMute(v){ localStorage.setItem(KEY_MUTE, v?'1':'0'); },
      getTipo(){ return localStorage.getItem(KEY_TIPO) || 'icq'; },
      setTipo(t){ localStorage.setItem(KEY_TIPO, t); },
      tocar(forcaTipo){
        if (this.isMute()) { console.log('[tdfSons] não tocou: muted'); return; }
        const c = ctx();
        if (!c) { console.warn('[tdfSons] não tocou: sem AudioContext'); return; }
        if (c.state === 'suspended') {
          console.log('[tdfSons] ctx suspended, tentando resume...');
          c.resume().then(() => {
            console.log('[tdfSons] resume OK, tocando');
            this._tocarReal(forcaTipo);
          }).catch(e => console.warn('[tdfSons] resume falhou (precisa interação do user):', e.message));
          return;
        }
        this._tocarReal(forcaTipo);
      },
      _tocarReal(forcaTipo){
        const c = ctx();
        if (!c) { console.warn('[tdfSons] _tocarReal: sem ctx'); return; }
        if (c.state !== 'running') { console.warn('[tdfSons] _tocarReal: ctx state =', c.state); return; }
        console.log('[tdfSons] tocando:', forcaTipo || this.getTipo());
        const t = forcaTipo || this.getTipo();
        if (t === 'icq') {
          // ICQ "Uh-oh!" — 2 sílabas vocais com portamento descendente.
          // Sílaba "uh!": sawtooth filtrado parecendo formante vocal, glide 480→340Hz
          // Sílaba "oh!": glide 380→260Hz, mais grave e mais longa
          toneSlide(c, 480, 340, 0,    0.16, 'sawtooth', 0.16, 0.04);
          toneSlide(c, 720, 510, 0,    0.16, 'sawtooth', 0.05, 0.04); // 2º harmônico (formante F2)
          toneSlide(c, 380, 260, 0.20, 0.26, 'sawtooth', 0.18, 0.05);
          toneSlide(c, 570, 390, 0.20, 0.26, 'sawtooth', 0.06, 0.05);
        } else if (t === 'msn' || t === 'msn_msg') {
          // MSN Messenger "Nova mensagem" — 2 dings rápidos tipo sino
          // Reproduz a sensação ding-ding clássica do MSN incoming
          bell(c, 1568, 0,    0.35, 0.18); // G6
          bell(c, 1175, 0.10, 0.40, 0.20); // D6 (5ª descendente)
        } else if (t === 'msn_login') {
          // MSN login/online — 4 notas ascendentes "ba-da-bi-da" estilo "porta abrindo"
          bell(c, 784, 0,    0.18, 0.16); // G5
          bell(c, 988, 0.10, 0.18, 0.16); // B5
          bell(c, 1175,0.20, 0.18, 0.16); // D6
          bell(c, 1568,0.30, 0.32, 0.20); // G6
        } else if (t === 'nudge') {
          // MSN nudge — vibração rítmica grave (3 pulsos mais densos)
          tone(c, 180, 0,    0.09, 'sawtooth', 0.22);
          tone(c, 220, 0.005,0.09, 'square',   0.10);
          tone(c, 180, 0.12, 0.09, 'sawtooth', 0.22);
          tone(c, 220, 0.125,0.09, 'square',   0.10);
          tone(c, 180, 0.24, 0.09, 'sawtooth', 0.22);
          tone(c, 220, 0.245,0.09, 'square',   0.10);
        } else if (t === 'sino') {
          // Sino suave (campainha) — usa bell helper
          bell(c, 1318, 0,    0.55, 0.16);
        } else if (t === 'pop') {
          tone(c, 1200, 0, 0.05, 'sine', 0.18);
        }
      },
    };
  })();

  // ============= CHAT FLUTUANTE (mini-janelas empilhadas tipo Messenger) =============
  // window.abrirChat(dealId, phone, nome) — abre uma janela 320×460 no canto inferior
  // Múltiplas janelas empilham horizontalmente (até 3). Botão ↗ vai pra inbox full.
  (function(){
    const css = `
      .tdf-chat-bar{position:fixed;bottom:0;right:380px;z-index:9998;display:flex;gap:6px;align-items:flex-end}
      .tdf-chat-win{width:320px;height:460px;background:#0d0d0d;border:1px solid #444;border-bottom:none;border-radius:10px 10px 0 0;display:flex;flex-direction:column;overflow:hidden;box-shadow:0 -4px 24px rgba(0,0,0,.5);font-size:12px;color:#fff;font-family:inherit}
      .tdf-chat-win.min{height:38px;cursor:pointer}
      .tdf-chat-h{display:flex;align-items:center;gap:8px;padding:9px 12px;background:linear-gradient(135deg,#0f3a1a,#22c55e22);border-bottom:1px solid #25D366}
      .tdf-chat-h .ico{font-size:14px}
      .tdf-chat-h .nome{flex:1;font-weight:700;color:#fff;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
      .tdf-chat-h .canal{font-size:9px;background:#22c55e;color:#000;font-weight:800;padding:1px 6px;border-radius:8px;text-transform:uppercase}
      .tdf-chat-h .b{background:transparent;border:none;color:#aaa;cursor:pointer;font-size:14px;padding:2px 6px;line-height:1;border-radius:4px}
      .tdf-chat-h .b:hover{background:#222;color:#fff}
      .tdf-chat-msgs{flex:1;overflow-y:auto;padding:10px 12px;display:flex;flex-direction:column;gap:6px;background:#0a0a0a}
      .tdf-chat-msg{max-width:80%;padding:7px 10px;border-radius:10px;font-size:12px;line-height:1.35;word-break:break-word}
      .tdf-chat-msg.lead{background:#1f2937;border:1px solid #374151;align-self:flex-start;border-bottom-left-radius:3px;color:#f3f4f6}
      .tdf-chat-msg.sistema{align-self:center;max-width:90%;background:rgba(91,163,245,.06);border:1px dashed #1f6feb55;color:#7cb9f5;font-style:italic;font-size:10px;text-align:center;padding:4px 10px;border-radius:10px}
      .tdf-chat-msg.nos{background:linear-gradient(135deg,#0d3a1a,#22c55e22);border:1px solid #22c55e;align-self:flex-end;border-bottom-right-radius:2px;color:#dcfce7}
      .tdf-chat-msg .ts{font-size:9px;color:#666;margin-top:3px}
      .tdf-chat-empty{text-align:center;color:#666;font-size:11px;padding:20px}
      .tdf-chat-loading{text-align:center;color:#888;font-size:11px;padding:20px}
      .tdf-chat-input{display:flex;gap:6px;padding:8px;border-top:1px solid #222;background:#0f0f0f}
      .tdf-chat-input textarea{flex:1;resize:none;background:#161616;border:1px solid #333;color:#fff;border-radius:6px;padding:6px 8px;font-size:11px;font-family:inherit;min-height:34px;max-height:80px}
      .tdf-chat-input button{padding:0 10px;background:#22c55e;color:#000;border:none;border-radius:6px;font-weight:800;font-size:11px;cursor:pointer}
      .tdf-chat-input button:disabled{opacity:.5;cursor:not-allowed}
      .tdf-chat-warn{padding:6px 10px;background:rgba(251,191,36,.1);border-bottom:1px solid #fbbf24;color:#fbbf24;font-size:10px;text-align:center}
    `;
    const st = document.createElement('style'); st.textContent = css; document.head.appendChild(st);
    const bar = document.createElement('div'); bar.className = 'tdf-chat-bar'; bar.id = 'tdf-chat-bar'; document.body.appendChild(bar);

    const _chats = {}; // dealId → DOM element
    const MAX_CHATS = 3;

    function fmtHora(ts){
      const d = new Date(typeof ts === 'number' && ts < 1e12 ? ts * 1000 : ts);
      return isNaN(d) ? '' : d.toLocaleTimeString('pt-BR',{timeZone:'America/Sao_Paulo',hour:'2-digit',minute:'2-digit'});
    }

    async function safeJson(url, opts) {
      try {
        const r = await fetch(url, opts);
        const ct = r.headers.get('content-type') || '';
        if (!ct.includes('json')) return { error: r.status === 401 ? 'Sessão expirada (F5)' : 'Erro '+r.status };
        return await r.json();
      } catch(e) { return { error: e.message }; }
    }

    async function carregarMensagens(win, phone, todas, canalOverride){
      const msgsEl = win.querySelector('.tdf-chat-msgs');
      const canal = canalOverride || (win.dataset.canalEnvio || 'wati');
      // guarda o phone no win pra usar quando trocar canal
      if (phone) win.dataset.phone = phone;
      msgsEl.innerHTML = '<div class="tdf-chat-loading">Carregando'+(todas?' histórico completo':'')+' ('+canal.toUpperCase()+')...</div>';
      const d = await safeJson('/inbox/mensagens?phone=' + encodeURIComponent(phone) + (todas?'&todas=1':'') + '&canal=' + canal);
      if (d.error) { msgsEl.innerHTML = '<div class="tdf-chat-empty" style="color:#f87171">'+d.error+'</div>'; return; }
      const msgs = d.mensagens || [];
      if (!msgs.length) { msgsEl.innerHTML = '<div class="tdf-chat-empty">Sem histórico ainda</div>'; return; }
      const btnMais = (!todas && d.completo) ? '<div style="text-align:center;padding:8px"><button onclick="window._carregarTodasMsgs(this,\''+phone+'\')" style="background:#1f6feb;color:#fff;border:none;border-radius:6px;padding:5px 12px;font-size:10px;cursor:pointer;font-weight:700">⬆️ Carregar histórico completo</button></div>' : '';
      msgsEl.innerHTML = btnMais + msgs.map(m => {
        const cls = m.isSystem ? 'sistema' : (m.owner ? 'nos' : 'lead');
        return `
        <div class="tdf-chat-msg ${cls}">
          ${(m.texto||'').replace(/</g,'&lt;').replace(/\n/g,'<br>')}
          <div class="ts">${fmtHora(m.timestamp)}${m.owner&&(m.operatorName||m.templateName)?' · '+(m.operatorName||'📨 '+m.templateName):''}</div>
        </div>`;
      }).join('');
      msgsEl.scrollTop = msgsEl.scrollHeight;
    }
    // Helper global pro botão "Carregar todas" do chat flutuante
    window._carregarTodasMsgs = (btn, phone) => {
      const win = btn.closest('.tdf-chat-win');
      if (win) carregarMensagens(win, phone, true);
    };

    function getCanalAtivo(win){ return win.dataset.canalEnvio || 'wati'; }
    function setCanalAtivo(win, canal){
      const previo = win.dataset.canalEnvio || 'wati';
      win.dataset.canalEnvio = canal;
      const btnW = win.querySelector('[data-canal="wati"]');
      const btnZ = win.querySelector('[data-canal="zapi"]');
      if (btnW) { btnW.style.background = canal==='wati' ? '#22c55e' : '#1a1a1a'; btnW.style.color = canal==='wati' ? '#000' : '#aaa'; }
      if (btnZ) { btnZ.style.background = canal==='zapi' ? '#1f6feb' : '#1a1a1a'; btnZ.style.color = canal==='zapi' ? '#fff' : '#aaa'; }
      const ta = win.querySelector('textarea');
      if (ta) ta.placeholder = canal === 'zapi' ? 'Z-API · sem janela 24h... (Enter envia)' : 'WATI · janela 24h... (Enter envia)';
      // Recarrega histórico do novo canal
      if (previo !== canal) {
        const phone = win.dataset.phone;
        if (phone) carregarMensagens(win, phone, false, canal);
      }
    }

    async function enviarMsg(win, phone){
      const ta = win.querySelector('textarea');
      const txt = ta.value.trim();
      if (!txt) return;
      const canal = getCanalAtivo(win);
      const btn = win.querySelector('.tdf-chat-send-main');
      btn.disabled = true; btn.textContent = '...';
      const endpoint = canal === 'zapi' ? '/inbox/zapi-enviar' : '/inbox/responder';
      const body = canal === 'zapi' ? { phone, text: txt } : { phone, text: txt };
      const d = await safeJson(endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
      btn.disabled = false; btn.textContent = '➤';
      if (d.error) {
        if (canal === 'wati') {
          if (confirm('❌ WATI falhou: ' + d.error + '\n\n💡 Tentar enviar via Z-API (sem janela 24h)?')) {
            setCanalAtivo(win, 'zapi');
            return enviarMsg(win, phone);
          }
        } else {
          alert('❌ Z-API falhou: ' + d.error);
        }
        return;
      }
      ta.value = '';
      await carregarMensagens(win, phone);
    }

    async function enviarArquivo(win, phone, file){
      if (!file) return;
      if (file.size > 8*1024*1024) { alert('Arquivo muito grande (max 8MB)'); return; }
      const canal = getCanalAtivo(win);
      const indicator = win.querySelector('.tdf-chat-warn');
      indicator.style.display = 'block';
      indicator.textContent = `⏳ Enviando ${file.name} via ${canal.toUpperCase()}...`;
      indicator.style.background = 'rgba(91,163,245,.1)';
      indicator.style.borderBottomColor = '#1f6feb';
      indicator.style.color = '#7cb9f5';
      const reader = new FileReader();
      reader.onload = async () => {
        const dataUrl = reader.result;
        const endpoint = canal === 'zapi' ? '/inbox/zapi-anexar' : '/inbox/anexar';
        const d = await safeJson(endpoint, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone, dataUrl, filename: file.name }) });
        if (d.error) {
          indicator.textContent = '❌ ' + d.error;
          indicator.style.color = '#f87171';
          indicator.style.background = 'rgba(239,68,68,.1)';
          indicator.style.borderBottomColor = '#ef4444';
          setTimeout(() => { indicator.style.display = 'none'; }, 5000);
          return;
        }
        indicator.style.display = 'none';
        await carregarMensagens(win, phone);
      };
      reader.readAsDataURL(file);
    }

    async function gravarAudio(win, phone){
      const canal = getCanalAtivo(win);
      const indicator = win.querySelector('.tdf-chat-warn');
      const recBtn = win.querySelector('[data-act="audio"]');
      // Toggle: se já gravando, para e envia
      if (win._mediaRec) {
        win._mediaRec.stop();
        return;
      }
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        const mime = MediaRecorder.isTypeSupported('audio/webm;codecs=opus') ? 'audio/webm;codecs=opus' :
                     MediaRecorder.isTypeSupported('audio/ogg;codecs=opus') ? 'audio/ogg;codecs=opus' : 'audio/webm';
        const rec = new MediaRecorder(stream, { mimeType: mime });
        const chunks = [];
        rec.ondataavailable = e => chunks.push(e.data);
        const startedAt = Date.now();
        rec.onstop = async () => {
          stream.getTracks().forEach(t => t.stop());
          win._mediaRec = null;
          recBtn.style.background = '';
          recBtn.textContent = '🎙️';
          const dur = Math.round((Date.now() - startedAt)/1000);
          if (dur < 1) { indicator.style.display = 'none'; return; }
          const blob = new Blob(chunks, { type: mime });
          const reader = new FileReader();
          reader.onload = async () => {
            indicator.textContent = `⏳ Enviando áudio (${dur}s) via ${canal.toUpperCase()}...`;
            const endpoint = canal === 'zapi' ? '/inbox/zapi-anexar' : '/inbox/anexar';
            const d = await safeJson(endpoint, {
              method:'POST', headers:{'Content-Type':'application/json'},
              body: JSON.stringify({ phone, dataUrl: reader.result, filename: 'audio.ogg', tipo: 'audio' }),
            });
            if (d.error) {
              indicator.textContent = '❌ ' + d.error;
              indicator.style.color = '#f87171';
              setTimeout(() => { indicator.style.display = 'none'; }, 5000);
              return;
            }
            indicator.style.display = 'none';
            await carregarMensagens(win, phone);
          };
          reader.readAsDataURL(blob);
        };
        rec.start();
        win._mediaRec = rec;
        recBtn.style.background = '#dc2626';
        recBtn.textContent = '⏹️';
        indicator.style.display = 'block';
        indicator.textContent = '🔴 Gravando... clica novamente pra parar';
        indicator.style.background = 'rgba(220,38,38,.1)';
        indicator.style.borderBottomColor = '#dc2626';
        indicator.style.color = '#f87171';
      } catch(e) {
        alert('Erro ao acessar microfone: ' + e.message);
      }
    }

    // Cache global de templates (compartilhado entre instâncias do chat)
    let _TPL_CACHE = null;
    let _TPL_CACHE_AT = 0;

    async function abrirTemplates(win, phone){
      const ia = win.querySelector('.tdf-chat-ia');
      ia.style.display = 'block';
      // Cache de 5min — evita refetch toda hora que abre
      if (!_TPL_CACHE || Date.now() - _TPL_CACHE_AT > 5*60000) {
        ia.innerHTML = '<div style="color:#22c55e;font-size:11px;padding:6px">📨 Carregando templates WATI...</div>';
        const d = await safeJson('/inbox/templates');
        if (d.error || !Array.isArray(d.templates) || !d.templates.length) {
          ia.innerHTML = '<div style="color:#f87171;font-size:11px;padding:6px">'+(d.error || 'Sem templates aprovados')+'</div>';
          return;
        }
        _TPL_CACHE = d.templates;
        _TPL_CACHE_AT = Date.now();
      }
      win.dataset.tplOpen = '1';
      _renderTplPicker(win, phone, '');
    }

    function _renderTplPicker(win, phone, query){
      const ia = win.querySelector('.tdf-chat-ia');
      const q = (query || '').toLowerCase().trim();
      const filtrados = _TPL_CACHE.filter(t => {
        if (!q) return true;
        const nome = (t.elementName || t.name || '').toLowerCase();
        const corpo = (t.body || t.bodyOriginal || '').toLowerCase();
        return nome.includes(q) || corpo.includes(q);
      });

      const dealId = win.dataset.dealId;
      const opts = filtrados.slice(0, 50).map(t => {
        const nome = t.elementName || t.name || '?';
        const body = (t.body || t.bodyOriginal || '').replace(/'/g,"\\'").replace(/\n/g,' ').slice(0, 120);
        return `<div onclick="window._enviarTpl('${dealId}','${phone}','${nome}')" style="background:#0f3a1a;border:1px solid #22c55e;border-radius:5px;padding:6px 8px;margin-bottom:3px;font-size:10px;color:#dcfce7;cursor:pointer">
          <strong style="color:#22c55e">${nome}</strong><br>
          <span style="color:#aaa;font-size:9px">${body}</span>
        </div>`;
      }).join('');
      const total = _TPL_CACHE.length;
      const visiveis = filtrados.length;
      ia.innerHTML = `
        <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px">
          <span style="color:#22c55e;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.4px">📨 ${visiveis === total ? `${total} templates` : `${visiveis}/${total}`}</span>
          <button onclick="this.closest('.tdf-chat-ia').style.display='none'" style="margin-left:auto;background:transparent;border:none;color:#666;cursor:pointer;font-size:14px;padding:0 4px">×</button>
        </div>
        <div style="position:relative;margin-bottom:6px">
          <span style="position:absolute;left:8px;top:50%;transform:translateY(-50%);color:#666;font-size:11px;pointer-events:none">🔍</span>
          <input type="text" id="tpl-search-${dealId}" placeholder="Buscar template (nome ou texto)..." value="${(q||'').replace(/"/g,'&quot;')}"
            style="width:100%;padding:6px 8px 6px 26px;background:#0a0a0a;border:1px solid #22c55e44;border-radius:5px;color:#fff;font-size:11px;outline:none;font-family:inherit"
            oninput="window._tplFiltro('${dealId}','${phone}',this.value)" autofocus>
        </div>
        ${filtrados.length === 0
          ? '<div style="color:#666;text-align:center;padding:14px;font-size:11px">Nenhum template combina com "<strong style=\"color:#fbbf24\">'+q.replace(/</g,'&lt;')+'</strong>"</div>'
          : '<div style="max-height:280px;overflow-y:auto">'+opts+'</div>'
        }
      `;
      // Refoca o input após re-render (mantém digitação fluida)
      const input = document.getElementById('tpl-search-'+dealId);
      if (input && q) {
        input.focus();
        input.setSelectionRange(q.length, q.length);
      }
    }

    // Helper global pra filtrar conforme digita
    window._tplFiltro = (dealId, phone, valor) => {
      const w = _chats[dealId]; if (!w) return;
      _renderTplPicker(w, phone, valor);
    };

    window._enviarTpl = async (dealId, phone, templateName) => {
      const w = _chats[dealId]; if (!w) return;
      // Detecta parâmetros {{N}} no body do template e prompta
      const tpl = (_TPL_CACHE || []).find(t => (t.elementName||t.name) === templateName);
      let params = [];
      if (tpl) {
        const body = tpl.body || tpl.bodyOriginal || '';
        const matches = body.match(/\{\{\d+\}\}/g) || [];
        if (matches.length) {
          for (let i = 1; i <= matches.length; i++) {
            const v = prompt(`Parâmetro {{${i}}} do template "${templateName}":`, '');
            if (v === null) return; // cancelou
            params.push(v);
          }
        }
      }
      const ia = w.querySelector('.tdf-chat-ia');
      ia.innerHTML = '<div style="color:#22c55e;font-size:11px;padding:6px">📤 Enviando template '+templateName+'...</div>';
      const d = await safeJson('/inbox/template', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone, templateName, params })});
      if (d.error) { ia.innerHTML = '<div style="color:#f87171;font-size:10px;padding:6px">'+d.error+'</div>'; return; }
      ia.style.display = 'none';
      await carregarMensagens(w, phone);
    };

    function fechar(dealId){
      const w = _chats[dealId];
      if (w) { w.remove(); delete _chats[dealId]; }
    }

    function minimizar(dealId){
      const w = _chats[dealId];
      if (!w) return;
      w.classList.toggle('min');
    }

    function expandir(dealId, phone){
      window.location.href = '/inbox#phone=' + encodeURIComponent(phone);
    }

    window.abrirChat = function(dealId, phone, nome, canal){
      // Já aberto? só foca/destaca
      if (_chats[dealId]) {
        _chats[dealId].classList.remove('min');
        _chats[dealId].querySelector('textarea')?.focus();
        return;
      }
      // Limita a MAX_CHATS — fecha o mais antigo se exceder
      const ids = Object.keys(_chats);
      while (ids.length >= MAX_CHATS) {
        fechar(ids.shift());
      }
      const w = document.createElement('div');
      w.className = 'tdf-chat-win';
      w.dataset.dealId = dealId;
      // Canal de origem (vindo da inbox: WATI ou Z-API). Default = WATI se não veio.
      const canalOrigem = canal === 'zapi' ? 'zapi' : 'wati';
      // Canal de envio default = mesmo da origem (espelha a conversa)
      w.dataset.canalEnvio = canalOrigem;
      const canalOrigemLabel = canalOrigem === 'zapi' ? 'Z-API' : 'WATI';
      const canalOrigemColor = canalOrigem === 'zapi' ? '#1f6feb' : '#22c55e';
      w.innerHTML = `
        <div class="tdf-chat-h" style="border-bottom-color:${canalOrigemColor}">
          <span class="ico">💬</span>
          <span class="nome" title="${nome||phone}">${nome||phone}</span>
          <span class="canal" style="background:${canalOrigemColor};color:${canalOrigem==='zapi'?'#fff':'#000'}">${canalOrigemLabel}</span>
          <button class="b" data-act="expandir" title="Abrir em tela cheia">↗</button>
          <button class="b" data-act="min" title="Minimizar">—</button>
          <button class="b" data-act="fechar" title="Fechar">×</button>
        </div>
        <!-- Toggle WATI/Z-API -->
        <div style="display:flex;gap:4px;padding:6px 10px;background:#080808;border-bottom:1px solid #1a1a1a;align-items:center">
          <span style="font-size:9px;color:#666;font-weight:700;text-transform:uppercase;margin-right:4px">Enviar via</span>
          <button data-canal="wati" style="background:#22c55e;color:#000;border:none;border-radius:4px;padding:3px 9px;font-size:10px;font-weight:800;cursor:pointer" title="WATI (oficial Meta) — só na janela 24h">📱 WATI</button>
          <button data-canal="zapi" style="background:#1a1a1a;color:#aaa;border:none;border-radius:4px;padding:3px 9px;font-size:10px;font-weight:800;cursor:pointer" title="Z-API (seu WhatsApp pessoal) — sem janela 24h">⚡ Z-API</button>
        </div>
        <div class="tdf-chat-warn" style="display:none"></div>
        <div class="tdf-chat-msgs"></div>
        <div class="tdf-chat-ia" style="display:none;padding:6px 8px;border-top:1px solid #2a2a2a;background:#0f0820;max-height:160px;overflow-y:auto"></div>
        <!-- Botões de mídia/template -->
        <div style="display:flex;gap:3px;padding:6px 8px;background:#0f0f0f;border-top:1px solid #222;flex-wrap:wrap">
          <button data-act="audio" title="Gravar áudio (click pra começar/parar)" style="background:#0f0f0f;border:1px solid #333;color:#aaa;border-radius:5px;padding:4px 8px;font-size:13px;cursor:pointer">🎙️</button>
          <button data-act="anexar" title="Enviar arquivo/imagem (max 8MB)" style="background:#0f0f0f;border:1px solid #333;color:#aaa;border-radius:5px;padding:4px 8px;font-size:13px;cursor:pointer">📎</button>
          <button data-act="template" title="Enviar template aprovado (WATI)" style="background:#0f0f0f;border:1px solid #333;color:#aaa;border-radius:5px;padding:4px 8px;font-size:13px;cursor:pointer">📨</button>
          <input type="file" data-act="file-input" style="display:none" accept="image/*,application/pdf,audio/*,video/*,.doc,.docx,.xlsx,.csv">
          <span style="flex:1"></span>
          <button data-act="diretor" style="font-size:10px;padding:3px 8px;background:#dc2626;color:#fff;border:none;border-radius:5px;cursor:pointer" title="🎙️ Diretor de Vendas IA">🎯</button>
          <button data-act="ia" style="font-size:10px;padding:3px 8px;background:#7c3aed;color:#fff;border:none;border-radius:5px;cursor:pointer" title="IA: sugerir 3 respostas">🤖</button>
          <button data-act="resumo" style="font-size:10px;padding:3px 8px;background:#1f6feb;color:#fff;border:none;border-radius:5px;cursor:pointer" title="IA: resumir conversa">📝</button>
          <button data-act="nubia" style="font-size:10px;padding:3px 8px;background:#a371f7;color:#fff;border:none;border-radius:5px;cursor:pointer" title="🤖 Iniciar conversa Núbia neste lead (dispara template + addContact)">✨ Núbia</button>
        </div>
        <div class="tdf-chat-input">
          <textarea placeholder="Digite... (Enter envia)" rows="1"></textarea>
          <button class="tdf-chat-send-main">➤</button>
        </div>
      `;
      // Aplica estado inicial do toggle de canal
      setTimeout(() => setCanalAtivo(w, canalOrigem), 0);
      // Header: clica no minimizado pra restaurar
      w.querySelector('.tdf-chat-h').addEventListener('click', e => {
        if (w.classList.contains('min') && !e.target.matches('button')) {
          w.classList.remove('min');
        }
      });
      // Botões header
      w.querySelector('[data-act="fechar"]').addEventListener('click', e => { e.stopPropagation(); fechar(dealId); });
      w.querySelector('[data-act="min"]').addEventListener('click', e => { e.stopPropagation(); minimizar(dealId); });
      w.querySelector('[data-act="expandir"]').addEventListener('click', e => { e.stopPropagation(); expandir(dealId, phone); });
      // Input
      const ta = w.querySelector('textarea');
      ta.addEventListener('keydown', e => {
        if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); enviarMsg(w, phone); }
      });
      // Botão enviar
      w.querySelector('.tdf-chat-send-main').addEventListener('click', () => enviarMsg(w, phone));
      // Toggle canal WATI/Z-API
      w.querySelector('[data-canal="wati"]').addEventListener('click', () => setCanalAtivo(w, 'wati'));
      w.querySelector('[data-canal="zapi"]').addEventListener('click', () => setCanalAtivo(w, 'zapi'));
      // Botão Áudio (gravar/parar)
      w.querySelector('[data-act="audio"]').addEventListener('click', () => gravarAudio(w, phone));
      // Botão Anexar
      const fileInput = w.querySelector('[data-act="file-input"]');
      w.querySelector('[data-act="anexar"]').addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', e => { if (e.target.files[0]) enviarArquivo(w, phone, e.target.files[0]); e.target.value = ''; });
      // Botão Template
      w.querySelector('[data-act="template"]').addEventListener('click', () => abrirTemplates(w, phone));
      // Botão DIRETOR DE VENDAS IA — análise completa + msg pronta
      w.querySelector('[data-act="diretor"]').addEventListener('click', async () => {
        const ia = w.querySelector('.tdf-chat-ia');
        ia.style.display = 'block';
        ia.innerHTML = '<div style="color:#dc2626;font-size:11px;padding:6px">🎙️ Diretor analisando...</div>';
        const r = await safeJson('/inbox/diretor-vendas', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone, dealId }) });
        if (r.error) { ia.innerHTML = '<div style="color:#f87171;font-size:10px;padding:6px">'+r.error+'</div>'; return; }
        const msg = (r.mensagemSugerida || '').replace(/'/g,"\\'").replace(/\n/g,' ');
        const estrategiaHtml = Array.isArray(r.estrategia)
          ? r.estrategia.map(e => '<li style="margin-bottom:2px">'+e.replace(/</g,'&lt;')+'</li>').join('')
          : (r.estrategia || '').replace(/</g,'&lt;');
        ia.innerHTML = `
          <div style="background:#1a0a0a;border:1px solid #dc2626;border-radius:6px;padding:8px;font-size:10px">
            <div style="color:#dc2626;font-weight:800;font-size:9px;text-transform:uppercase;margin-bottom:3px">🎙️ Diretor de Vendas</div>
            <div style="color:#fbbf24;font-size:10px;margin-bottom:4px"><strong>📍 Diagnóstico:</strong> ${(r.diagnostico||'').replace(/</g,'&lt;')}</div>
            <div style="color:#a371f7;font-size:10px;margin-bottom:6px"><strong>🎯 Estratégia:</strong> <ul style="margin:2px 0 0 14px;padding:0">${estrategiaHtml}</ul></div>
            <div style="background:#0a0a0a;border:1px dashed #dc2626;border-radius:5px;padding:6px;color:#fff;cursor:pointer" onclick="this.closest('.tdf-chat-win').querySelector('textarea').value='${msg}';this.closest('.tdf-chat-ia').style.display='none'" title="Click pra usar essa mensagem">
              <strong style="color:#22c55e;font-size:9px">💬 MENSAGEM PRONTA · click pra usar:</strong><br>
              ${(r.mensagemSugerida||'').replace(/</g,'&lt;')}
            </div>
          </div>
        `;
      });
      // Botão IA sugerir
      w.querySelector('[data-act="ia"]').addEventListener('click', async () => {
        const ia = w.querySelector('.tdf-chat-ia');
        ia.style.display = 'block';
        ia.innerHTML = '<div style="color:#a371f7;font-size:11px">🤖 Pensando...</div>';
        const r = await safeJson('/inbox/ia-sugerir', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone, dealId }) });
        if (r.error) { ia.innerHTML = '<div style="color:#f87171;font-size:10px">'+r.error+'</div>'; return; }
        if (!r.sugestoes?.length) { ia.innerHTML = '<div style="color:#666;font-size:10px">Sem sugestões</div>'; return; }
        ia.innerHTML = '<div style="color:#a371f7;font-size:9px;font-weight:700;margin-bottom:4px">💡 SUGESTÕES IA · clica pra usar</div>'
          + r.sugestoes.map(s => `<div style="background:#1a1030;border:1px solid #4c1d95;border-radius:5px;padding:6px 8px;margin-bottom:3px;font-size:11px;color:#ddd;cursor:pointer" onclick="this.closest('.tdf-chat-win').querySelector('textarea').value='${s.replace(/'/g,"\\'").replace(/\n/g,' ')}';this.closest('.tdf-chat-ia').style.display='none'">${s.replace(/</g,'&lt;')}</div>`).join('');
      });
      // Botão resumir
      w.querySelector('[data-act="resumo"]').addEventListener('click', async (e) => {
        if (!confirm('Gerar resumo IA da conversa e salvar nas notas do Closy?')) return;
        const btn = e.currentTarget;
        btn.disabled = true; btn.textContent = '⏳';
        const r = await safeJson('/inbox/ia-resumir', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone, dealId }) });
        btn.disabled = false; btn.textContent = '📝';
        if (r.error) { alert('❌ '+r.error); return; }
        alert('✅ Resumo salvo nas notas do cliente:\n\n'+r.resumo);
      });
      // Botão Núbia: dispara /webhook/new-deal (addContact + sendTemplate)
      w.querySelector('[data-act="nubia"]').addEventListener('click', async (e) => {
        if (!confirm('🤖 Iniciar conversa da Núbia com este lead?\n\nVai disparar template "Primeiro contato" + iniciar atendimento automatizado.')) return;
        const btn = e.currentTarget;
        btn.disabled = true; const orig = btn.textContent; btn.textContent = '⏳';
        const r = await safeJson('/cockpit/nubia-meu-lead', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ dealId }) });
        btn.disabled = false; btn.textContent = orig;
        if (r.error) { alert('❌ '+r.error); return; }
        if (r.ok) {

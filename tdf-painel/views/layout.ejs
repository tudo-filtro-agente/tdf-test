          const amt = l.amount ? ' <span style="color:#4ade80;font-weight:700">R$ '+Math.round(l.amount).toLocaleString('pt-BR')+'</span>' : '';
          const wb = ph ? '<a href="https://live-2708.wati.io/2708/teamInbox/'+ph+'" target="_blank" style="color:#25D366;font-size:10px;margin-left:6px;text-decoration:none">💬</a>' : '';
          const cb = l.id ? '<a href="https://crmplus.zoho.com/tudodefiltro3711/index.do/cxapp/crm/org856385701/tab/Potentials/'+_esc(l.id)+'" target="_blank" style="color:#7cb9f5;font-size:10px;margin-left:4px;text-decoration:none">📂</a>' : '';
          const chatBtn = ph && l.id ? '<button onclick="event.stopPropagation();window.abrirChat&&abrirChat(\''+_esc(l.id)+'\',\''+ph+'\',\''+_esc(l.nome||'')+'\')" style="background:transparent;border:none;color:#22c55e;cursor:pointer;font-size:11px;margin-left:2px">💬</button>' : '';
          return '<div style="display:flex;align-items:center;gap:4px;padding:4px 6px;border-bottom:1px solid #1f0d2e;font-size:11px;color:#ddd">'
            + tier + '<span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">'+_esc(l.nome||l.phone||'?')+amt+owner+'</span>'

// ====== 🎉 KA-CHING: som + toast estilo Shopify quando sai venda ======
(function(){
  let _kachingMuted = localStorage.getItem('tdf_kaching_muted') === '1';
  let _kachingCtx = null;
  function getCtx(){
    if (!_kachingCtx) {
      try { _kachingCtx = new (window.AudioContext || window.webkitAudioContext)(); } catch(_){}
    }
    return _kachingCtx;
  }
  // Sintetiza um "ka-ching" de caixa registradora — bell tom + secundário + percussão de moedas
  function tocarKaching(){
    if (_kachingMuted) return;
    const ctx = getCtx();
    if (!ctx) return;
    if (ctx.state === 'suspended') ctx.resume().catch(() => {});
    const t0 = ctx.currentTime;
    // 1) "Ka" — clique grave (tom curto baixo)
    const ka = ctx.createOscillator();
    const kaG = ctx.createGain();
    ka.frequency.value = 380;
    ka.type = 'square';
    kaG.gain.setValueAtTime(.0001, t0);
    kaG.gain.exponentialRampToValueAtTime(.25, t0 + 0.005);
    kaG.gain.exponentialRampToValueAtTime(.0001, t0 + 0.08);
    ka.connect(kaG); kaG.connect(ctx.destination);
    ka.start(t0); ka.stop(t0 + 0.1);
    // 2) "Ching" — sino agudo (mistura de senos com decay)
    const freqs = [1318.5, 1567.98, 1975.53, 2349.32]; // E6, G6, B6, D7
    freqs.forEach((freq, i) => {
      const o = ctx.createOscillator();
      const g = ctx.createGain();
      o.type = 'sine';
      o.frequency.value = freq;
      const start = t0 + 0.06 + i * 0.005;
      g.gain.setValueAtTime(.0001, start);
      g.gain.exponentialRampToValueAtTime(.18 / (i + 1), start + 0.01);
      g.gain.exponentialRampToValueAtTime(.0001, start + 1.4);
      o.connect(g); g.connect(ctx.destination);
      o.start(start); o.stop(start + 1.5);
    });
    // 3) "Ting" — armônico bem agudo (caixa metálica)
    const ting = ctx.createOscillator();
    const tingG = ctx.createGain();
    ting.type = 'triangle';
    ting.frequency.value = 3200;
    tingG.gain.setValueAtTime(.0001, t0 + 0.12);
    tingG.gain.exponentialRampToValueAtTime(.1, t0 + 0.13);
    tingG.gain.exponentialRampToValueAtTime(.0001, t0 + 0.5);
    ting.connect(tingG); tingG.connect(ctx.destination);
    ting.start(t0 + 0.12); ting.stop(t0 + 0.55);
    // 4) Moedas: ruído branco curto modulado
    const buf = ctx.createBuffer(1, ctx.sampleRate * 0.3, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < data.length; i++) {
      data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / data.length, 2);
    }
    const noise = ctx.createBufferSource();
    noise.buffer = buf;
    const noiseG = ctx.createGain();
    noiseG.gain.value = .04;
    const filter = ctx.createBiquadFilter();
    filter.type = 'highpass';
    filter.frequency.value = 4000;
    noise.connect(filter); filter.connect(noiseG); noiseG.connect(ctx.destination);
    noise.start(t0 + 0.18);
  }
  function fmtR(v){ return 'R$ ' + Math.round(v||0).toLocaleString('pt-BR'); }
  function mostrarToast(d){
    // Toast central grande estilo Shopify celebration
    const el = document.createElement('div');
    el.style.cssText = 'position:fixed;top:80px;left:50%;transform:translateX(-50%) translateY(-20px);background:linear-gradient(135deg,#10b981,#22c55e);color:#fff;padding:16px 28px;border-radius:14px;font-weight:800;font-size:15px;z-index:99999;box-shadow:0 12px 40px rgba(34,197,94,.5);opacity:0;transition:all .4s cubic-bezier(.16,1,.3,1);display:flex;align-items:center;gap:14px;font-family:inherit;border:2px solid rgba(255,255,255,.2);max-width:90vw';
    el.innerHTML = `
      <div style="font-size:36px;animation:tdfRingShake .6s ease 2">💰</div>
      <div style="text-align:left;line-height:1.3">
        <div style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.6px;opacity:.85">🎉 Nova venda · TDF</div>
        <div style="font-size:18px;font-weight:900;margin-top:2px">${fmtR(d.amount)}</div>
        <div style="font-size:12px;font-weight:600;opacity:.9;margin-top:1px">${(d.nome||'?').slice(0,40)}${d.owner?' · '+d.owner:''}</div>
      </div>
    `;

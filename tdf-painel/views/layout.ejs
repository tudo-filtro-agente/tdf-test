<script>
let _MB_DATA = null;
async function mbLoad(){
  try{
    const res = await fetch('/gestao/meta-bar');
    if (!res.ok) return;
    const d = await res.json();
    if (d.error) return;
    _MB_DATA = d;
    mbRender();
  }catch(e){ console.error('meta-bar:', e); }
}
function mbFmt(v){ return 'R$ ' + (Math.round(v||0)/1000).toFixed(1) + 'k'; }
function mbMetaCls(p){ return p>=80?'green':p>=50?'yellow':'red'; }

function mbRender(){
  if (!_MB_DATA) return;
  const c = _MB_DATA.canais;
  const t = _MB_DATA.total;

  document.getElementById('mb-beb-hoje').textContent = mbFmt(c.bebedouro.hoje);
  document.getElementById('mb-beb-mes').textContent = mbFmt(c.bebedouro.mes);
  const bMeta = document.getElementById('mb-beb-meta');
  bMeta.textContent = c.bebedouro.pctMeta+'%'; bMeta.className = 'v-meta '+mbMetaCls(c.bebedouro.pctMeta);

  document.getElementById('mb-fil-hoje').textContent = mbFmt(c.filtro.hoje);
  document.getElementById('mb-fil-mes').textContent = mbFmt(c.filtro.mes);
  const fMeta = document.getElementById('mb-fil-meta');
  fMeta.textContent = c.filtro.pctMeta+'%'; fMeta.className = 'v-meta '+mbMetaCls(c.filtro.pctMeta);

  document.getElementById('mb-loja-hoje').textContent = mbFmt(c.loja.hoje);
  document.getElementById('mb-loja-mes').textContent = mbFmt(c.loja.mes);
  const lMeta = document.getElementById('mb-loja-meta');
  lMeta.textContent = c.loja.pctMeta+'%'; lMeta.className = 'v-meta '+mbMetaCls(c.loja.pctMeta);

  if (c.refil) {
    document.getElementById('mb-refil-hoje').textContent = mbFmt(c.refil.hoje);
    document.getElementById('mb-refil-mes').textContent = mbFmt(c.refil.mes);
    const rMeta = document.getElementById('mb-refil-meta');
    rMeta.textContent = c.refil.pctMeta+'%'; rMeta.className = 'v-meta '+mbMetaCls(c.refil.pctMeta);
  }

  document.getElementById('mb-total-mes').textContent = mbFmt(t.mes);
  const tMeta = document.getElementById('mb-total-meta');
  tMeta.textContent = t.pctMeta+'%'; tMeta.className = 'v-meta '+mbMetaCls(t.pctMeta);
}

function mbAbrirCanal(canal){
  if (!_MB_DATA) return;
  const c = _MB_DATA.canais[canal];
  if (!c) return;
  document.getElementById('mb-modal-titulo').textContent = `${c.icon} ${c.label} — Vendas do Mês`;
  document.getElementById('mb-modal-sub').textContent = `${c.deals.length} venda(s) no mês • Meta R$ ${(c.meta/1000).toFixed(0)}k`;

  document.getElementById('mb-modal-summary').innerHTML = `
    <div><div class="l">Hoje</div><div class="n" style="color:#22c55e">${mbFmt(c.hoje)}</div><div style="font-size:10px;color:#888">${c.hojeQtd} venda(s)</div></div>
    <div><div class="l">Mês</div><div class="n">${mbFmt(c.mes)}</div><div style="font-size:10px;color:#888">${c.mesQtd} venda(s)</div></div>
    <div><div class="l">Meta</div><div class="n" style="color:#5ba3f5">${mbFmt(c.meta)}</div></div>
    <div><div class="l">% Meta</div><div class="n" style="color:${c.pctMeta>=80?'#22c55e':c.pctMeta>=50?'#eab308':'#ef4444'}">${c.pctMeta}%</div></div>
    <div><div class="l">Ticket Médio</div><div class="n">${mbFmt(c.mesQtd>0?c.mes/c.mesQtd:0)}</div></div>
  `;

  // Agrega por vendedor (sub-resumo)
  const porVend = {};
  for (const d of c.deals) {
    if (!porVend[d.owner]) porVend[d.owner] = { qtd:0, total:0 };
    porVend[d.owner].qtd++;
    porVend[d.owner].total += d.amount;
  }
  const vRows = Object.entries(porVend).sort((a,b)=>b[1].total-a[1].total)
    .map(([n,v]) => `<span style="display:inline-block;background:#161616;border:1px solid #222;border-radius:6px;padding:4px 10px;margin:2px 4px 2px 0;font-size:11px"><strong>${n}</strong>: ${v.qtd}× = ${mbFmt(v.total)}</span>`).join('');
  if (vRows) document.getElementById('mb-modal-summary').insertAdjacentHTML('afterend',
    `<div style="margin-bottom:14px;padding:10px;background:#161616;border:1px solid #222;border-radius:8px"><div style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700;margin-bottom:4px">Por Vendedor</div>${vRows}</div>`
  );

  document.getElementById('mb-modal-tbody').innerHTML = c.deals.map(d => `
    <tr id="mb-row-${d.id}">
      <td style="color:#888;font-size:11px">${d.data}</td>
      <td style="font-weight:600">${d.owner}</td>
      <td>${d.name}</td>
      <td style="color:#aaa;font-size:11px" class="mb-prod-cell" data-deal="${d.id}">
        <span style="color:#666;font-style:italic">carregando produtos...</span>
      </td>
      <td style="font-weight:700;color:#fff">R$ ${(d.amount||0).toLocaleString('pt-BR')}</td>
      <td>${d.crmLink?`<a href="${d.crmLink}" target="_blank">Abrir</a>`:'-'}</td>
    </tr>
  `).join('');

  document.getElementById('mb-modal-bg').classList.add('open');

  // Carrega produtos REAIS via Quotes/Quoted_Items em background
  const dealIds = c.deals.map(d => d.id).filter(Boolean);
  if (dealIds.length) carregarProdutosDeals(dealIds);
}

async function carregarProdutosDeals(dealIds){
  // Quebra em batches de 30 por requisição
  for (let i = 0; i < dealIds.length; i += 30) {
    const lote = dealIds.slice(i, i+30);
    try {
      const res = await fetch('/gestao/deal-products', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ dealIds: lote })
      });
      const d = await res.json();
      if (d.error) continue;
      for (const id of Object.keys(d.products||{})) {
        const cell = document.querySelector(`.mb-prod-cell[data-deal="${id}"]`);
        if (!cell) continue;
        const items = d.products[id] || [];
        if (!items.length) {
          cell.innerHTML = '<span style="color:#444">—</span>';
          continue;
        }
        // Mostra até 2 produtos + tooltip com todos
        const top = items.slice(0, 2).map(it => `${it.nome}${it.qtd>1?` (${it.qtd}x)`:''}`).join(' • ');
        const todos = items.map(it => `${it.qtd}x ${it.nome} — R$ ${(it.valor||0).toLocaleString('pt-BR')}`).join('\n');
        const extra = items.length > 2 ? ` <span style="color:#5ba3f5;font-weight:600">+${items.length-2}</span>` : '';
        cell.innerHTML = `<span title="${todos.replace(/"/g,'&quot;')}" style="cursor:help">${top}${extra}</span>`;
      }
    } catch(e) { console.warn('produtos:', e); }
  }
}

function mbFechar(){
  document.getElementById('mb-modal-bg').classList.remove('open');
  // Remove o sub-resumo "Por Vendedor" se existir (foi inserido dinamicamente)
  document.querySelectorAll('.mb-modal > div[style*="Por Vendedor"]').forEach(el => el.remove());
}

mbLoad();
setInterval(mbLoad, 60*1000); // refresh 60s

// Relógio BRT
function tickClockBR(){
  const opts = { timeZone:'America/Sao_Paulo', hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:false };
  const dateOpts = { timeZone:'America/Sao_Paulo', weekday:'short', day:'2-digit', month:'2-digit' };
  const t = new Intl.DateTimeFormat('pt-BR', opts).format(new Date());
  const d = new Intl.DateTimeFormat('pt-BR', dateOpts).format(new Date());
  const c = document.getElementById('mb-clock'); if (c) c.textContent = t;
  const dt = document.getElementById('mb-date'); if (dt) dt.textContent = d + ' • BRT';
}
setInterval(tickClockBR, 1000); tickClockBR();
</script>

    proj.classList.remove('green','yellow','red');
    risco.classList.remove('green','yellow','red');
    if (d.risco === 'no_caminho') {
      proj.classList.add('green'); risco.classList.add('green');
      r.textContent = '✓ NO CAMINHO';
    } else if (d.risco === 'atencao') {
      proj.classList.add('yellow'); risco.classList.add('yellow');
      r.textContent = '! ATENÇÃO';
    } else {
      proj.classList.add('red'); risco.classList.add('red');
      r.textContent = '⚠ RISCO';
    }
    const cor = d.pctMeta >= 80 ? '#22c55e' : d.pctMeta >= 50 ? '#eab308' : '#ef4444';
    document.getElementById('cb-pct').style.color = cor;
    const fill = document.getElementById('cb-bar-fill');
    fill.style.width = Math.min(d.pctMeta, 100) + '%';
    fill.style.background = cor;
  }catch(e){ console.error('cbLoad:', e); }
}
cbLoad();
setInterval(cbLoad, 60000);

// Relógio BRT (closer)
function tickClockCB(){
  const opts = { timeZone:'America/Sao_Paulo', hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:false };
  const dateOpts = { timeZone:'America/Sao_Paulo', weekday:'short', day:'2-digit', month:'2-digit' };
  const t = new Intl.DateTimeFormat('pt-BR', opts).format(new Date());
  const d = new Intl.DateTimeFormat('pt-BR', dateOpts).format(new Date());
  const c = document.getElementById('cb-clock'); if (c) c.textContent = t;
  const dt = document.getElementById('cb-date'); if (dt) dt.textContent = d + ' • BRT';
}
setInterval(tickClockCB, 1000); tickClockCB();
</script>
<% } %>


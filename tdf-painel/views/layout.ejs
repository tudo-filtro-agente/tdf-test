          + (watiUrl ? '<a href="'+watiUrl+'" target="_blank" style="font-size:10px;background:rgba(37,211,102,.2);color:#25D366;padding:3px 8px;border-radius:4px;text-decoration:none;font-weight:700">💬 WATI</a>' : '')
          + '</div>'
        : '';
      // Lista de leads vinculados — clicável + botão de ação

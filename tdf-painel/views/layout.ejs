// ============= DIRETOR IA — FAB PRO-ATIVO + NOTIFICAÇÕES =============
let _DIR_LAST_IDS = new Set();
let _DIR_DATA = null;
let _DIR_AUTO_POPUP_DONE = false;

async function dirRefresh(btn){
  if (btn) { btn.disabled = true; btn.textContent = '⏳'; }
  await dirLoad(true);
  if (btn) { btn.disabled = false; btn.textContent = '🔄 Atualizar'; }
}
async function dirLoad(force){
  try{
    const res = await fetch('/cockpit/director-live' + (force ? '?nocache=1' : ''));
    if (!res.ok) {
      console.warn('director-live HTTP', res.status);
      return;
    }
    const txt = await res.text();
    let d;
    try { d = JSON.parse(txt); }
    catch (parseErr) {
      console.warn('director-live JSON inválido:', txt.slice(0,200));
      _DIR_DATA = { messages:[], error: 'json inválido' };
      // Mostra estado discreto sem quebrar
      const fab = document.getElementById('dir-fab');
      if (fab) { fab.classList.remove('alerta'); }
      return;
    }
    _DIR_DATA = d;
    if (d.error) {
      console.warn('director-live erro:', d.error);
      return;
    }
    dirRender(d);
  }catch(e){ console.warn('dir:', e); }
}

function dirRender(d){
  const msgs = d?.messages || [];
  const fab = document.getElementById('dir-fab');
  const badge = document.getElementById('dir-badge');
  const criticas = msgs.filter(m => m.tipo === 'critico' || m.tipo === 'urgente' || m.intensidade === 'critico');

  // FAB pulsing se tem crítica
  if (criticas.length > 0) {
    fab.classList.add('alerta');
    badge.textContent = criticas.length;
  } else {
    fab.classList.remove('alerta');
    badge.style.display = 'none';
  }

  // Detecta mensagens NOVAS (não estavam no último refresh)
  const currentIds = new Set();
  let novasCriticas = [];
  for (const m of msgs) {
    const id = m.msgId || (m.titulo + '|' + (m.texto||'').slice(0,50));
    currentIds.add(id);
    if (!_DIR_LAST_IDS.has(id) && (m.tipo === 'critico' || m.tipo === 'urgente' || m.intensidade === 'critico')) {
      novasCriticas.push(m);
    }
  }

  // Não auto-abre — apenas pulsa FAB + badge contador. User clica pra ver detalhe.
  if (_DIR_LAST_IDS.size > 0 && novasCriticas.length > 0) {
    novasCriticas.forEach(m => dirNotificar(m));
    tkYabadabadooo && tkYabadabadooo();
  }
  _DIR_LAST_IDS = currentIds;

  // Sempre atualiza badge do FAB — mostra contagem de críticas
  const fab = document.getElementById('dir-fab');
  const badge = document.getElementById('dir-badge');
  if (fab && badge) {
    if (criticas.length > 0) {
      fab.classList.add('alerta');
      badge.style.display = 'inline-block';
      badge.textContent = criticas.length > 9 ? '9+' : String(criticas.length);
    } else {
      fab.classList.remove('alerta');
      badge.style.display = 'none';
    }
  }

  // Atualiza popup se aberto
  if (document.getElementById('dir-popup').style.display !== 'none') {
    dirPopupRender();
  }
}

function _esc(s){
  return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
function dirPopupRender(){

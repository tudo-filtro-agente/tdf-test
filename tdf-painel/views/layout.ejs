  <header>
    <h2>🎙️ Live Director + 📋 Tarefas</h2>
    <button class="close-x" onclick="tkMinimize()" title="Minimizar — fecha a janela mas mantém o FAB visível pulsando" style="background:#1e3a5f;border-radius:6px;padding:0 10px;font-size:18px;color:#5ba3f5">− Minimizar</button>
    <button class="close-x" onclick="tkToggle()" title="Fechar drawer">×</button>
  </header>

  <!-- Live Director -->
  <div id="tk-director" style="padding:14px 18px;border-bottom:1px solid #2a1a1a;background:linear-gradient(180deg,rgba(167,113,247,.05),transparent)">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px">
      <span style="font-size:11px;color:#c084fc;font-weight:800;text-transform:uppercase;letter-spacing:.5px;display:flex;align-items:center;gap:6px">
        <span style="width:8px;height:8px;background:#c084fc;border-radius:50%;animation:tkLive 1.5s infinite"></span>
        DIRETOR IA — AO VIVO
      </span>
      <span style="font-size:10px;color:var(--text-muted)" id="tk-director-ts"></span>
      <button onclick="tkToggleDirector()" id="tk-director-toggle" title="Esconder/mostrar Live Director" style="margin-left:auto;background:var(--bg-hover);color:var(--text-muted);border:1px solid var(--border);border-radius:6px;padding:3px 10px;font-size:10px;cursor:pointer;font-weight:700;text-transform:uppercase;letter-spacing:.3px">Esconder</button>
    </div>
    <div id="tk-director-msgs"><div style="color:var(--text-muted);font-size:12px">Analisando situação...</div></div>
  </div>

  <div class="tk-stats">
    <div><div class="n" id="tk-pend" style="color:#ef4444">0</div><div class="l">Pendentes</div></div>
    <div><div class="n" id="tk-done" style="color:#22c55e">0</div><div class="l">Concluídas</div></div>
    <div><div class="n" id="tk-tot" style="color:#5ba3f5">0</div><div class="l">Total 48h</div></div>
  </div>
  <div class="tk-list" id="tk-list"><div class="tk-empty">Carregando...</div></div>
</div>

<style>
@keyframes tkLive{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.4)}}
.tk-msg{padding:10px 12px;background:var(--bg-card);border-left:3px solid var(--border);border-radius:6px;margin-bottom:6px;font-size:12px;line-height:1.5}
.tk-msg.critico{border-left-color:#ef4444;background:linear-gradient(90deg,rgba(239,68,68,.1),var(--bg-card))}
.tk-msg.urgente{border-left-color:#f97316;background:linear-gradient(90deg,rgba(249,115,22,.08),var(--bg-card))}
.tk-msg.media{border-left-color:#eab308}
.tk-msg.info{border-left-color:#5ba3f5}
.tk-msg.positivo{border-left-color:#22c55e;background:linear-gradient(90deg,rgba(34,197,94,.08),var(--bg-card))}
.tk-msg.manual{border-left-width:4px;border-left-color:#c084fc;background:linear-gradient(90deg,rgba(192,132,252,.1),var(--bg-card))}
.tk-msg.manual.critico{border-left-color:#ef4444;background:linear-gradient(90deg,rgba(239,68,68,.18),var(--bg-card))}
.tk-msg-row{display:flex;gap:10px}
.tk-msg .ic{font-size:18px;line-height:1.2}
.tk-msg .ttl{color:var(--text);font-weight:800;font-size:12px;margin-bottom:2px}
.tk-msg .txt{color:#bbb;font-size:11px}
.tk-msg .acts{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.tk-msg .btn-act{display:inline-flex;align-items:center;gap:3px;padding:3px 9px;border-radius:5px;font-size:10px;font-weight:700;text-decoration:none;border:1px solid;cursor:pointer;background:transparent}
.tk-msg .btn-act.crm{color:#5ba3f5;border-color:#5ba3f5}
.tk-msg .btn-act.wati{color:#25D366;border-color:#25D366}
.tk-msg .btn-act.dismiss{color:var(--text-muted);border-color:#444}
.tk-msg .btn-act:hover{background:rgba(255,255,255,.06)}
.tk-msg .meta-sender{font-size:10px;color:var(--text-muted);margin-top:4px;font-style:italic}
.tk-drawer.minimized{right:-380px}
.tk-list{padding:6px 10px}
.tk-item{padding:8px 10px;margin-bottom:6px;border-radius:6px}
.tk-item .ttl{font-size:12px;margin-bottom:2px}
.tk-item .meta{font-size:10px;margin-bottom:4px}
.tk-item .body{font-size:11px;max-height:60px;line-height:1.35}
.tk-item .acts{gap:4px}
.tk-item button.done-btn{padding:4px 10px;font-size:10px}
.tk-fab.live-burst{animation:liveBurst .6s ease}
@keyframes liveBurst{0%{transform:scale(1)}50%{transform:scale(1.25);box-shadow:0 0 30px rgba(239,68,68,.9)}100%{transform:scale(1)}}

/* ============= SHAKE DA TELA (mensagem crítica) ============= */
@keyframes tcShake{
  0%,100%{transform:translate3d(0,0,0)}
  10%{transform:translate3d(-12px,2px,0)}
  20%{transform:translate3d(10px,-3px,0)}
  30%{transform:translate3d(-8px,4px,0)}
  40%{transform:translate3d(7px,-2px,0)}
  50%{transform:translate3d(-6px,3px,0)}
  60%{transform:translate3d(5px,-1px,0)}
  70%{transform:translate3d(-4px,2px,0)}
  80%{transform:translate3d(3px,-1px,0)}
  90%{transform:translate3d(-2px,1px,0)}
}
body.tk-shake{animation:tcShake .8s cubic-bezier(.36,.07,.19,.97) both}

/* Banner overlay crítico */
.tk-overlay{position:fixed;top:0;left:0;right:0;background:linear-gradient(135deg,#7f1d1d,#dc2626);color:#fff;padding:16px 22px;z-index:400;box-shadow:0 6px 24px rgba(239,68,68,.6);border-bottom:3px solid #fff;display:flex;align-items:center;gap:14px;animation:tkSlideDown .3s}
@keyframes tkSlideDown{from{transform:translateY(-100%)}to{transform:translateY(0)}}
.tk-overlay .ico{font-size:28px;flex-shrink:0}
.tk-overlay .body{flex:1;min-width:0}
.tk-overlay .ttl{font-weight:900;font-size:15px;text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px}
.tk-overlay .txt{font-size:13px;line-height:1.4}
.tk-overlay .sender{font-size:10px;opacity:.85;margin-top:4px}
.tk-overlay .acts{display:flex;gap:8px;flex-shrink:0}
.tk-overlay button{background:#fff;color:#dc2626;border:none;border-radius:6px;padding:8px 14px;font-weight:800;font-size:12px;cursor:pointer;text-transform:uppercase;letter-spacing:.3px}
.tk-overlay button:hover{background:#fee2e2}
.tk-overlay a.crm-btn{background:rgba(255,255,255,.2);color:var(--text);border:1px solid #fff;border-radius:6px;padding:8px 14px;font-weight:800;font-size:12px;text-decoration:none;text-transform:uppercase;letter-spacing:.3px}
</style>
<script>
let _TK_DATA = { tasks: [] };
let _TK_LAST_IDS = new Set();
let _TK_MUTED = (localStorage.getItem('tk-muted') === '1');
let _TK_AUDIO_CTX = null;

// === YABADABADOOOOO sintetizado via Web Audio ===
function tkInitAudio(){
  if (_TK_AUDIO_CTX) return _TK_AUDIO_CTX;
  try {
    _TK_AUDIO_CTX = new (window.AudioContext || window.webkitAudioContext)();
  } catch(e) { console.warn('Web Audio não disponível'); }
  return _TK_AUDIO_CTX;
}

// Pré-carrega o sample real do Yabba Dabba Doo (voz do Fred Flintstone)
let _TK_YABA_AUDIO = null;
function tkLoadYaba(){
  if (_TK_YABA_AUDIO) return _TK_YABA_AUDIO;
  try {
    _TK_YABA_AUDIO = new Audio('/sfx/yabadabadoo.mp3');
    _TK_YABA_AUDIO.preload = 'auto';
    _TK_YABA_AUDIO.volume = 0.85;
  } catch(e) {}
  return _TK_YABA_AUDIO;
}

function tkYabadabadooo(){
  if (_TK_MUTED) return;
  const a = tkLoadYaba();
  if (a) {
    try {
      a.currentTime = 0;
      a.play().catch(err => console.warn('Audio play falhou:', err.message));
    } catch(e) { console.warn(e); }
  }
  // Burst visual no FAB
  const fab = document.getElementById('tk-fab');
  if (fab) {
    fab.classList.add('live-burst');
    setTimeout(()=>fab.classList.remove('live-burst'), 700);
  }
}

function tkToggleMute(){
  _TK_MUTED = !_TK_MUTED;
  localStorage.setItem('tk-muted', _TK_MUTED ? '1' : '0');
  document.getElementById('tk-mute').textContent = _TK_MUTED ? '🔇' : '🔊';
  if (!_TK_MUTED) tkYabadabadooo(); // toca uma vez pra confirmar
}

function tkToggle(){
  const d = document.getElementById('tk-drawer');
  d.classList.remove('minimized');
  d.classList.toggle('open');
}

function tkMinimize(){
  document.getElementById('tk-drawer').classList.remove('open');
}

function tkToggleDirector(){
  const d = document.getElementById('tk-director-msgs');
  const ts = document.getElementById('tk-director-ts');
  const btn = document.getElementById('tk-director-toggle');
  const escondido = d.style.display === 'none';
  if (escondido) {
    d.style.display = '';
    if (ts) ts.style.display = '';
    btn.textContent = 'Esconder';
    localStorage.setItem('tk-director-hidden', '0');
  } else {
    d.style.display = 'none';
    if (ts) ts.style.display = 'none';
    btn.textContent = 'Mostrar';
    localStorage.setItem('tk-director-hidden', '1');
  }
}
// Restaura estado do toggle
if (localStorage.getItem('tk-director-hidden') === '1') {
  setTimeout(() => {
    const d = document.getElementById('tk-director-msgs');
    const ts = document.getElementById('tk-director-ts');
    const btn = document.getElementById('tk-director-toggle');
    if (d) d.style.display = 'none';
    if (ts) ts.style.display = 'none';
    if (btn) btn.textContent = 'Mostrar';
  }, 100);
}

function tkToast(msg, isErr){
  const t = document.createElement('div');
  t.className = 'tk-toast-task' + (isErr?' err':'');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(()=>t.remove(), 4000);
}

async function tkLoad(){
  try{
    const [r1, r2, r3] = await Promise.all([
      fetch('/cockpit/tarefas').then(r => r.json()).catch(() => ({tasks:[]})),
      fetch('/cockpit/director-live').then(r => r.json()).catch(() => ({messages:[]})),
      fetch('/tarefas/minhas').then(r => r.json()).catch(() => ({tarefas:[]})),
    ]);
    _TK_DATA = r1.error ? { tasks:[] } : r1;
    // Mescla tarefas agendadas (manuais — distribuição em massa) com alertas sistema
    _TK_DATA.userTasks = (r3.tarefas || []).filter(t => t.status === 'aberta');
    tkRender();
    tkRenderDirector(r2);
    tkDetectNew();
  }catch(e){ console.error('Tasks load:', e); }
}

let _TK_LAST_MSG_IDS = new Set();
let _TK_LAST_MANUAL_IDS = new Set();

function tkRenderDirector(d){
  const cont = document.getElementById('tk-director-msgs');
  const ts = document.getElementById('tk-director-ts');
  if (ts) ts.textContent = 'atualizado ' + new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'});
  const msgs = (d?.messages) || [];

  // Detecta NOVAS mensagens manuais críticas e ativa shake/overlay/yabadabadoo
  const currentManualIds = new Set();
  let novasCriticas = [];
  let novasImportantes = [];
  for (const m of msgs) {
    if (m.manual && m.msgId) {
      currentManualIds.add(m.msgId);
      if (!_TK_LAST_MANUAL_IDS.has(m.msgId)) {
        if (m.intensidade === 'critico') novasCriticas.push(m);
        else if (m.intensidade === 'importante') novasImportantes.push(m);
      }
    }
  }
  if (_TK_LAST_MANUAL_IDS.size > 0 || _TK_LAST_MSG_IDS.size > 0) {
    if (novasCriticas.length) {
      tkShakeScreen();
      tkShowCriticalOverlay(novasCriticas[0]);
      tkYabadabadooo();
      setTimeout(tkYabadabadooo, 800); // dobra
    } else if (novasImportantes.length) {
      tkYabadabadooo();
    }
  }
  _TK_LAST_MANUAL_IDS = currentManualIds;

  if (!msgs.length) {
    cont.innerHTML = '<div style="color:#666;font-size:12px">Tudo no controle por aqui agora.</div>';
    return;
  }
  cont.innerHTML = msgs.map(m => {
    const phoneClean = m.phone ? String(m.phone).replace(/\D/g,'') : '';
    const watiUrl = phoneClean ? `https://live-2708.wati.io/2708/teamInbox/${phoneClean}` : null;
    const acts = [];
    if (m.crmLink) acts.push(`<a class="btn-act crm" href="${m.crmLink}" target="_blank">📂 Abrir CRM</a>`);
    if (watiUrl) acts.push(`<a class="btn-act wati" href="${watiUrl}" target="_blank">💬 WATI</a>`);
    if (m.manual && m.msgId) acts.push(`<button class="btn-act dismiss" onclick="tkDismissMsg('${m.msgId}', this)">✓ ok, entendi</button>`);
    const senderTxt = m.manual ? `<div class="meta-sender">enviada por ${m.sender||'admin'} • ${tkAgo(m.createdAt)}</div>` : '';
    return `<div class="tk-msg ${m.tipo||'info'} ${m.manual?'manual':''}">
      <div class="tk-msg-row">
        <div class="ic">${m.icon||'💬'}</div>
        <div style="flex:1;min-width:0">
          <div class="ttl">${m.titulo||''}</div>
          <div class="txt">${(m.texto||'').replace(/</g,'&lt;')}</div>
          ${senderTxt}
        </div>
      </div>
      ${acts.length?`<div class="acts">${acts.join('')}</div>`:''}
    </div>`;
  }).join('');
}

function tkAgo(ts){
  if (!ts) return '';
  const min = Math.round((Date.now() - ts) / 60000);
  if (min < 1) return 'agora';
  if (min < 60) return min + 'min atrás';
  return Math.round(min/60) + 'h atrás';
}

function tkShakeScreen(){
  document.body.classList.remove('tk-shake');
  void document.body.offsetWidth; // reset animation
  document.body.classList.add('tk-shake');
  setTimeout(() => document.body.classList.remove('tk-shake'), 1000);
}

function tkShowCriticalOverlay(msg){
  const o = document.getElementById('tk-critical-overlay');
  if (!o) return;
  const phoneClean = msg.phone ? String(msg.phone).replace(/\D/g,'') : '';
  const watiUrl = phoneClean ? `https://live-2708.wati.io/2708/teamInbox/${phoneClean}` : null;
  o.className = 'tk-overlay';
  o.style.display = 'flex';
  o.innerHTML = `
    <div class="ico">🚨</div>
    <div class="body">
      <div class="ttl">${msg.titulo || 'MENSAGEM URGENTE'}</div>
      <div class="txt">${(msg.texto||'').replace(/</g,'&lt;')}</div>
      <div class="sender">de ${msg.sender||'Diretor'} — ${tkAgo(msg.createdAt)}</div>
    </div>
    <div class="acts">
      ${msg.crmLink?`<a class="crm-btn" href="${msg.crmLink}" target="_blank">📂 Abrir CRM</a>`:''}
      ${watiUrl?`<a class="crm-btn" href="${watiUrl}" target="_blank">💬 WATI</a>`:''}
      <button onclick="tkDismissMsg('${msg.msgId}'); document.getElementById('tk-critical-overlay').style.display='none';">✓ Recebi</button>
    </div>
  `;
}

async function tkDismissMsg(msgId, btn){
  if (btn) btn.disabled = true;
  try {
    await fetch('/cockpit/director-message/'+encodeURIComponent(msgId)+'/dismiss', { method:'POST' });
    const o = document.getElementById('tk-critical-overlay');
    if (o) o.style.display = 'none';
    tkLoad();
  } catch(e) { console.error(e); }
}

function tkDetectNew(){
  // Detecta tasks novas (que não existiam no último load) e toca yabadabadoo
  const currentIds = new Set((_TK_DATA.tasks||[]).filter(t => t.status === 'pendente').map(t => t.id));
  if (_TK_LAST_IDS.size > 0) {
    let newOnes = 0;
    currentIds.forEach(id => { if (!_TK_LAST_IDS.has(id)) newOnes++; });
    if (newOnes > 0) {
      tkYabadabadooo();
      tkToast('🔔 ' + newOnes + ' nova(s) tarefa(s)!');
    }
  }
  _TK_LAST_IDS = currentIds;
}

function tkRender(){
  const tasks = _TK_DATA.tasks || [];
  const userTasks = _TK_DATA.userTasks || [];
  const pend = tasks.filter(t => t.status === 'pendente');
  const done = tasks.filter(t => t.status === 'concluida');

  // === Conta vencidas vs a vencer (combina sistema + manuais) ===
  const now = Date.now();
  const em24h = now + 24*60*60*1000;
  // Tarefas manuais (com dataHora)
  const manuaisVencidas = userTasks.filter(t => new Date(t.dataHora).getTime() < now - 5*60000);
  const manuaisAVencer = userTasks.filter(t => {
    const dh = new Date(t.dataHora).getTime();
    return dh >= now - 5*60000 && dh < em24h;
  });
  // Alertas sistema: priority alta/crit conta como vencido (urgência)
  const sistemaUrgentes = pend.filter(t => t.priority === 'crit' || t.priority === 'alta');
  const sistemaPendentes = pend.filter(t => !(t.priority === 'crit' || t.priority === 'alta'));
  const totalVencidas = manuaisVencidas.length + sistemaUrgentes.length;
  const totalAVencer = manuaisAVencer.length + sistemaPendentes.length;
  const totalPend = totalVencidas + totalAVencer + (userTasks.length - manuaisVencidas.length - manuaisAVencer.length);

  // === Badges no FAB ===
  const elV = document.getElementById('tk-c-vencidas');
  const elA = document.getElementById('tk-c-avencer');
  const elT = document.getElementById('tk-count');
  if (elV) {
    if (totalVencidas > 0) {
      elV.style.display = 'inline-flex';
      document.getElementById('tk-c-vencidas-n').textContent = totalVencidas;
    } else elV.style.display = 'none';
  }
  if (elA) {
    if (totalAVencer > 0) {
      elA.style.display = 'inline-flex';
      document.getElementById('tk-c-avencer-n').textContent = totalAVencer;
    } else elA.style.display = 'none';
  }
  // Badge total só aparece se tiver tarefa fora dos 2 buckets (futuras >24h)
  const futuras = totalPend - totalVencidas - totalAVencer;
  if (elT) {
    if (totalVencidas === 0 && totalAVencer === 0 && totalPend > 0) {
      elT.textContent = totalPend;
      elT.style.display = 'inline-block';
    } else {
      elT.style.display = 'none';
    }
  }

  document.getElementById('tk-pend').textContent = totalPend;
  document.getElementById('tk-done').textContent = done.length;
  document.getElementById('tk-tot').textContent = tasks.length + userTasks.length;

  const fab = document.getElementById('tk-fab');
  if (totalVencidas > 0) {
    fab.classList.remove('calm');
    fab.classList.add('pulse');
  } else {
    fab.classList.add('calm');
    fab.classList.remove('pulse');
  }

  const list = document.getElementById('tk-list');
  if (totalPend === 0 && tasks.length === 0 && userTasks.length === 0){
    list.innerHTML = '<div class="tk-empty good">✓ Nenhuma tarefa pendente — manda bala!</div>';
    return;
  }

  let html = '';

  // === SEÇÃO 1: Tarefas agendadas (manual / distribuição em massa) ===
  if (userTasks.length) {
    userTasks.sort((a,b) => new Date(a.dataHora) - new Date(b.dataHora));
    html += `<div style="padding:8px 4px 4px;color:#fbbf24;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px">📋 Tarefas Agendadas (${userTasks.length})</div>`;
    html += userTasks.map(t => {
      const dh = new Date(t.dataHora).getTime();
      const min = Math.round((dh - Date.now())/60000);
      const atrasada = min < -5;
      const hoje = !atrasada && min < 1440;
      const cor = atrasada ? '#ef4444' : hoje ? '#fbbf24' : '#22c55e';
      const labelTempo = Math.abs(min) < 60 ? (min>=0?`em ${min}min`:`há ${-min}min`) : Math.abs(min) < 1440 ? (min>=0?`em ${Math.round(min/60)}h`:`há ${Math.round(-min/60)}h`) : (min>=0?`em ${Math.round(min/1440)}d`:`há ${Math.round(-min/1440)}d`);
      const phoneClean = String(t.phone||'').replace(/\D/g,'');
      const watiUrl = phoneClean ? `https://live-2708.wati.io/2708/teamInbox/${phoneClean}` : '';
      const nomeEsc = (t.dealNome||'').replace(/'/g,"\\'");
      return `<div class="tk-item" style="border-left-color:${cor}">
        <div class="ttl">${atrasada ? '🔴' : hoje ? '🟡' : '🟢'} ${(t.titulo||'').replace(/</g,'&lt;')}</div>
        <div class="meta">
          ${t.dealNome ? '<strong style="color:#fff">'+t.dealNome.replace(/</g,'&lt;')+'</strong> · ' : ''}
          ${t.phone ? '📞 '+t.phone+' · ' : ''}
          <span style="color:${cor};font-weight:700">${labelTempo}</span>
        </div>
        ${t.observacao ? `<div style="color:#aaa;font-size:11px;font-style:italic;margin-bottom:6px">${t.observacao.replace(/</g,'&lt;')}</div>` : ''}
        <div class="acts" style="gap:4px">
          ${phoneClean ? `<a href="tel:+${phoneClean}" onclick="tkRegContato('${t.id}','${t.dealId||''}','goto')" style="background:rgba(31,111,235,.1);color:#5ba3f5;border:1px solid #1f6feb;border-radius:5px;padding:4px 8px;font-size:10px;font-weight:700;text-decoration:none">📞 Ligar</a>` : ''}
          ${phoneClean && t.dealId ? `<button onclick="window.abrirChat&&abrirChat('${t.dealId}','${phoneClean}','${nomeEsc}');tkRegContato('${t.id}','${t.dealId}','wati');" style="background:linear-gradient(135deg,#0f3a1a,#22c55e22);color:#22c55e;border:1px solid #22c55e;border-radius:5px;padding:4px 8px;font-size:10px;font-weight:700;cursor:pointer">💬 Chat</button>` : ''}
          ${phoneClean ? `<a href="${watiUrl}" target="_blank" onclick="tkRegContato('${t.id}','${t.dealId||''}','wati')" style="background:rgba(34,197,94,.08);color:#22c55e;border:1px solid #22c55e;border-radius:5px;padding:4px 8px;font-size:10px;font-weight:700;text-decoration:none">📱 WATI</a>` : ''}
          ${phoneClean ? `<button onclick="tkZapiQuick('${t.id}','${t.dealId||''}','${phoneClean}','${nomeEsc}')" style="background:rgba(31,111,235,.08);color:#7cb9f5;border:1px solid #1f6feb;border-radius:5px;padding:4px 8px;font-size:10px;font-weight:700;cursor:pointer">⚡ Z-API</button>` : ''}
          <button onclick="tkConcluirAgenda('${t.id}', this)" style="background:linear-gradient(135deg,#10b981,#22c55e);color:#fff;border:none;border-radius:5px;padding:4px 10px;font-size:10px;font-weight:800;cursor:pointer">✅ Concluir</button>
          <button onclick="tkAdiarAgenda('${t.id}')" style="background:rgba(249,115,22,.1);color:#fb923c;border:1px solid #f97316;border-radius:5px;padding:4px 8px;font-size:10px;font-weight:700;cursor:pointer">⏰ Adiar</button>
        </div>
      </div>`;
    }).join('');
  }

  // === SEÇÃO 2: Tasks sistema (alertas automáticos) ===
  if (tasks.length) {
    if (userTasks.length) html += `<div style="padding:14px 4px 4px;color:#5ba3f5;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px">⚡ Alertas do Sistema (${tasks.length})</div>`;
    html += tasks.map(t => {
      const icons = { lead_sem_contato:'⏰', proposta_parada:'💸', baixa_atividade:'😴', diamante_parado:'💎', sem_venda:'🚨' };
      const ic = icons[t.type] || '⚡';
      const ageMin = Math.round((Date.now() - t.createdAt) / 60000);
      const age = ageMin < 60 ? ageMin+'min' : Math.round(ageMin/60)+'h';
      const cls = t.status === 'concluida' ? 'done' : (t.priority || 'media');
      const concluiBtn = t.status === 'concluida'
        ? `<div class="feedback">✓ Concluída ${Math.round((t.concluidoEm - t.createdAt)/60000)}min após disparo</div>`
        : `<button class="done-btn" onclick="tkConcluir('${t.id}', this)">✓ Concluir</button>`;
      return `<div class="tk-item ${cls}" id="tk-${t.id}">
        <div class="ttl"><span class="ic">${ic}</span> ${t.title}</div>
        <div class="meta">${age} atrás • ${t.source||'sistema'}</div>
        <div class="body" id="tk-body-${t.id}">${t.body.replace(/</g,'&lt;')}</div>
        <button class="body-toggle" onclick="tkExpandBody('${t.id}', this)">ver mensagem completa</button>
        <div class="acts">${concluiBtn}</div>
      </div>`;
    }).join('');
  }

  list.innerHTML = html;
}

// === Helpers de execução de tarefas (FAB drawer + Tarefas tab CRM) ===
async function tkRegContato(tarefaId, dealId, canal){
  if (!dealId) return;
  try {
    await fetch('/manutencao/cliente/'+dealId+'/registrar-contato', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ canal, observacao: 'via tarefa (FAB)' })
    });
  } catch(_){}
}

async function tkConcluirAgenda(id, btn){
  if (btn) { btn.disabled = true; btn.textContent = '⏳'; }
  try {
    const r = await fetch('/tarefas/'+id+'/concluir', { method:'POST' });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); if (btn) { btn.disabled = false; btn.textContent = '✅ Concluir'; } return; }
    tkLoad();
  } catch(e) { alert('Erro: '+e.message); if (btn) { btn.disabled = false; btn.textContent = '✅ Concluir'; } }
}

async function tkAdiarAgenda(id){
  const min = prompt('Adiar por quantos minutos?', '30');
  const num = parseInt(min);
  if (!num || num < 1) return;
  try {
    const r = await fetch('/tarefas/'+id+'/adiar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ minutos: num })});
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    tkLoad();
  } catch(e) { alert('Erro: '+e.message); }
}

async function tkZapiQuick(tarefaId, dealId, phone, nome){
  const txt = prompt(`Mensagem rápida via Z-API pra ${nome||phone}:`, '');
  if (!txt || !txt.trim()) return;
  try {
    const r = await fetch('/inbox/zapi-enviar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone, text: txt }) });
    const d = await r.json();
    if (d.error) { alert('Erro Z-API: '+d.error); return; }
    if (dealId) await tkRegContato(tarefaId, dealId, 'zapi');
    tkToast('✅ Enviado via Z-API');
    tkLoad();
  } catch(e) { alert('Erro: '+e.message); }
}

function tkExpandBody(id, btn){
  const b = document.getElementById('tk-body-'+id);
  b.classList.toggle('expanded');
  btn.textContent = b.classList.contains('expanded') ? 'ocultar' : 'ver mensagem completa';
}

async function tkConcluir(id, btn){
  if (btn) { btn.disabled = true; btn.textContent = 'Enviando...'; }
  try{
    const res = await fetch('/cockpit/tarefa/'+encodeURIComponent(id)+'/concluir', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ observacao: '' })
    });
    const r = await res.json();
    if (r.error) { tkToast('Erro: '+r.error, true); if(btn){btn.disabled=false;btn.textContent='✓ Concluir';} return; }
    tkToast('✓ Tarefa concluída — gestão notificada');
    tkLoad();
  }catch(e){
    tkToast('Erro: '+e.message, true);
    if(btn){btn.disabled=false;btn.textContent='✓ Concluir';}
  }
}


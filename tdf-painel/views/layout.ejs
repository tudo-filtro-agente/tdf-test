  }
  // === 🏆 TEMA DA VITÓRIA — Senna (sintetizado) — toca quando venda > R$ 10k ===
  // Inspirado em "Tema da Vitória" de Eduardo Souto Neto (sintetizado, não o original)
  // Sequência de notas reconhecível: brass fanfare ascendente + sustain orquestral
  function tocarTemaVitoria(){
    if (_kachingMuted) return;
    const ctx = getCtx();
    if (!ctx) return;
    if (ctx.state === 'suspended') ctx.resume().catch(() => {});
    const t0 = ctx.currentTime;

    // Master gain pra controlar volume geral
    const master = ctx.createGain();
    master.gain.value = 0.45;
    master.connect(ctx.destination);

    // Reverb leve pra dar ambiência orquestral
    const conv = ctx.createConvolver();
    const rDur = 1.2;
    const rBuf = ctx.createBuffer(2, ctx.sampleRate * rDur, ctx.sampleRate);
    for (let ch = 0; ch < 2; ch++) {
      const data = rBuf.getChannelData(ch);
      for (let i = 0; i < data.length; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / data.length, 3) * 0.3;
      }
    }
    conv.buffer = rBuf;
    const wet = ctx.createGain(); wet.gain.value = 0.3;
    conv.connect(wet); wet.connect(master);

    // Helper: nota de "brass" (sawtooth + filter + envelope)
    function brass(freq, start, dur, vol = 0.5) {
      const o1 = ctx.createOscillator();
      const o2 = ctx.createOscillator(); // detune leve pra encorpar
      o1.type = 'sawtooth'; o2.type = 'sawtooth';
      o1.frequency.value = freq;
      o2.frequency.value = freq * 1.005;
      const filter = ctx.createBiquadFilter();
      filter.type = 'lowpass';
      filter.frequency.setValueAtTime(800, start);
      filter.frequency.exponentialRampToValueAtTime(3500, start + 0.05);
      filter.frequency.exponentialRampToValueAtTime(2200, start + dur);
      filter.Q.value = 2;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, start);
      g.gain.exponentialRampToValueAtTime(vol, start + 0.04);
      g.gain.setValueAtTime(vol, start + dur - 0.1);
      g.gain.exponentialRampToValueAtTime(0.0001, start + dur);
      o1.connect(filter); o2.connect(filter);
      filter.connect(g); g.connect(master); g.connect(conv);
      o1.start(start); o2.start(start);
      o1.stop(start + dur + 0.1); o2.stop(start + dur + 0.1);
    }
    // Helper: nota de "string" (sine longa)
    function string(freq, start, dur, vol = 0.18) {
      const o = ctx.createOscillator();
      o.type = 'sine';
      o.frequency.value = freq;
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.0001, start);
      g.gain.linearRampToValueAtTime(vol, start + 0.4);
      g.gain.setValueAtTime(vol, start + dur - 0.5);
      g.gain.linearRampToValueAtTime(0.0001, start + dur);
      o.connect(g); g.connect(master); g.connect(conv);
      o.start(start); o.stop(start + dur + 0.1);
    }
    // Timpani hit (forte impacto inicial)
    function timpani(start) {
      const o = ctx.createOscillator();
      o.type = 'sine';
      o.frequency.setValueAtTime(80, start);
      o.frequency.exponentialRampToValueAtTime(40, start + 0.5);
      const g = ctx.createGain();
      g.gain.setValueAtTime(0.7, start);
      g.gain.exponentialRampToValueAtTime(0.0001, start + 0.6);
      o.connect(g); g.connect(master);
      o.start(start); o.stop(start + 0.7);
    }

    // Notas (Hz): C5=523.25 D5=587.33 E5=659.25 F5=698.46 G5=783.99 A5=880 Bb5=932.33 C6=1046.5 D6=1174.66 E6=1318.51 F6=1396.91 G6=1567.98
    // Acordes em fundo: C maior (C, E, G) e F maior (F, A, C)
    const C4=261.63, E4=329.63, G4=392, C5=523.25, E5=659.25, G5=783.99, A5=880, C6=1046.5, E6=1318.51, G6=1567.98;
    const F4=349.23, A4=440, F5=698.46, A5b=466.16, B4=493.88, D5=587.33, F5_=698.46;

    // === FRASE 1: Impacto + brass ascendente (0-2s) ===
    timpani(t0);
    timpani(t0 + 0.3);
    brass(C5, t0 + 0.0, 0.4, 0.5);
    brass(E5, t0 + 0.4, 0.4, 0.5);
    brass(G5, t0 + 0.8, 0.4, 0.5);
    brass(C6, t0 + 1.2, 0.7, 0.6);
    // Strings sustentam acorde C
    string(C4, t0 + 0.0, 2.0, 0.15);
    string(E4, t0 + 0.0, 2.0, 0.15);
    string(G4, t0 + 0.0, 2.0, 0.18);

    // === FRASE 2: Pico triunfal (2-4.5s) ===
    timpani(t0 + 2.0);
    brass(E5, t0 + 2.0, 0.3, 0.5);
    brass(G5, t0 + 2.3, 0.3, 0.5);
    brass(C6, t0 + 2.6, 0.4, 0.55);
    brass(E6, t0 + 3.0, 0.6, 0.6);
    brass(G6, t0 + 3.6, 0.9, 0.65);
    string(C5, t0 + 2.0, 2.5, 0.18);
    string(E5, t0 + 2.0, 2.5, 0.18);
    string(G5, t0 + 2.0, 2.5, 0.2);

    // === FRASE 3: Resolução (4.5-7s) — desce e prepara o final ===
    timpani(t0 + 4.5);
    brass(F5_, t0 + 4.5, 0.5, 0.55);
    brass(A5, t0 + 5.0, 0.5, 0.55);
    brass(C6, t0 + 5.5, 0.7, 0.6);
    string(F4, t0 + 4.5, 2.5, 0.18);
    string(A4, t0 + 4.5, 2.5, 0.18);
    string(C5, t0 + 4.5, 2.5, 0.2);

    // === FRASE 4: Final glorioso (7-10s) — acorde maior cheio sustentado ===
    timpani(t0 + 7.0);
    timpani(t0 + 7.4);
    brass(C6, t0 + 7.0, 2.8, 0.7);
    brass(E6, t0 + 7.0, 2.8, 0.6);
    brass(G6, t0 + 7.0, 2.8, 0.55);
    string(C4, t0 + 7.0, 3.0, 0.2);
    string(E4, t0 + 7.0, 3.0, 0.2);
    string(G4, t0 + 7.0, 3.0, 0.22);
    string(C5, t0 + 7.0, 3.0, 0.22);
    // Cymbal hit no clímax (ruído branco filtrado)
    const cymbalBuf = ctx.createBuffer(1, ctx.sampleRate * 1.5, ctx.sampleRate);
    const cd = cymbalBuf.getChannelData(0);
    for (let i = 0; i < cd.length; i++) cd[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / cd.length, 1.5);
    const cs = ctx.createBufferSource();
    cs.buffer = cymbalBuf;
    const cf = ctx.createBiquadFilter();
    cf.type = 'highpass'; cf.frequency.value = 5000;
    const cg = ctx.createGain();
    cg.gain.setValueAtTime(0.18, t0 + 7.0);
    cg.gain.exponentialRampToValueAtTime(0.0001, t0 + 8.5);
    cs.connect(cf); cf.connect(cg); cg.connect(master);
    cs.start(t0 + 7.0);
  }

  function mostrarToastVitoria(d){
    // Overlay GIGANTE no centro pra venda grande
    const el = document.createElement('div');
    el.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(.5);background:linear-gradient(135deg,#fbbf24,#f59e0b,#dc2626);color:#fff;padding:30px 50px;border-radius:20px;font-weight:900;z-index:99999;box-shadow:0 20px 80px rgba(220,38,38,.7),0 0 0 4px rgba(255,255,255,.1);opacity:0;transition:all .6s cubic-bezier(.16,1,.3,1);text-align:center;font-family:inherit;border:3px solid #fff;max-width:90vw';
    el.innerHTML = `
      <div style="font-size:64px;animation:tdfTrofeu 1s infinite alternate;line-height:1">🏆</div>
      <div style="font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:2px;margin-top:8px;opacity:.95">🏎️ Venda Bandeirada</div>
      <div style="font-size:42px;font-weight:900;margin-top:6px;text-shadow:0 4px 12px rgba(0,0,0,.4)">${fmtR(d.amount)}</div>
      <div style="font-size:16px;font-weight:700;margin-top:6px;opacity:.95">${(d.nome||'?').slice(0,50)}</div>
      ${d.owner ? `<div style="font-size:14px;font-weight:700;margin-top:4px;opacity:.85">por ${d.owner}</div>` : ''}
      <div style="font-size:10px;font-weight:700;margin-top:14px;opacity:.7;letter-spacing:1px">🇧🇷 NA BRASIL VOLTA POR CIMA 🇧🇷</div>
    `;
    document.body.appendChild(el);
    requestAnimationFrame(() => {
      el.style.opacity = '1';
      el.style.transform = 'translate(-50%,-50%) scale(1)';
    });
    // Confetti rápido
    for (let i = 0; i < 40; i++) {
      const c = document.createElement('div');
      const cores = ['#fbbf24','#22c55e','#1f6feb','#dc2626','#fff'];
      c.style.cssText = `position:fixed;top:50%;left:50%;width:10px;height:14px;background:${cores[i%cores.length]};z-index:99998;pointer-events:none;border-radius:2px`;
      document.body.appendChild(c);
      const angle = Math.random() * Math.PI * 2;
      const vel = 200 + Math.random() * 300;
      const dx = Math.cos(angle) * vel;
      const dy = Math.sin(angle) * vel - 100;
      c.animate([
        { transform: 'translate(-50%,-50%) rotate(0)', opacity: 1 },
        { transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) rotate(${Math.random()*720-360}deg)`, opacity: 0 },
      ], { duration: 2500 + Math.random() * 1500, easing: 'cubic-bezier(.2,.6,.4,1)' });
      setTimeout(() => c.remove(), 4500);
    }
    setTimeout(() => {
      el.style.opacity = '0';
      el.style.transform = 'translate(-50%,-50%) scale(.85)';
      setTimeout(() => el.remove(), 600);
    }, 10500);
  }

  // Anti-duplicação (caso SSE entregue 2x ou refresh dispare de novo)
  const _seen = new Set();
  window.tdfKaChing = function(d){
    if (!d || !d.id) return;
    if (_seen.has(d.id)) return;
    _seen.add(d.id);
    // Limpa set após 1h pra não vazar memória
    setTimeout(() => _seen.delete(d.id), 60*60*1000);
    const valor = parseFloat(d.amount) || 0;
    if (valor >= 10000) {
      // 🏆 VENDA GIGANTE — Tema da Vitória 10s + overlay especial
      tocarTemaVitoria();
      mostrarToastVitoria(d);
    } else {
      // Venda normal — ka-ching curto
      tocarKaching();
      mostrarToast(d);
    }
    // Notificação sistema (se permitida)
    try {
      if (typeof Notification !== 'undefined' && Notification.permission === 'granted') {
        new Notification(valor >= 10000 ? '🏆 VENDA BANDEIRADA' : '🎉 Nova venda TDF', {
          body: `${fmtR(d.amount)} · ${(d.nome||'?').slice(0,40)}${d.owner?' · '+d.owner:''}`,
          icon: '/icon-192.png',
          tag: 'venda-' + d.id,
        });
      }
    } catch(_){}
  };
  // Helper pra mute/teste
  window.tdfKaChingMute = function(){ _kachingMuted = !_kachingMuted; localStorage.setItem('tdf_kaching_muted', _kachingMuted ? '1' : '0'); console.log('Ka-ching mute:', _kachingMuted); };

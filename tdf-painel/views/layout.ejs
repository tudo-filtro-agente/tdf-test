<script>
// === TEMA DIA/NOITE — aplica ANTES do primeiro paint (sem flash). Padrão: escuro.
try { if (localStorage.getItem('tdf-theme') === 'light') document.documentElement.setAttribute('data-theme', 'light'); } catch(_) {}
window.tdfTemaToggle = function(){
  var root = document.documentElement;
  var eraLight = root.getAttribute('data-theme') === 'light';
  if (eraLight) root.removeAttribute('data-theme'); else root.setAttribute('data-theme', 'light');
  try { localStorage.setItem('tdf-theme', eraLight ? 'dark' : 'light'); } catch(_) {}
  window.tdfTemaAtualizarBtn && tdfTemaAtualizarBtn();
};
window.tdfTemaAtualizarBtn = function(){
  var b = document.getElementById('tdf-tema-btn');
  if (!b) return;
  var light = document.documentElement.getAttribute('data-theme') === 'light';
  b.textContent = light ? '☀️' : '🌙';
  b.title = light ? 'Tema: dia (clique pra noite)' : 'Tema: noite (clique pra dia)';
};
document.addEventListener('DOMContentLoaded', function(){ tdfTemaAtualizarBtn(); });
</script>
<link rel="stylesheet" href="/style.css?v=20260713-tema">
<script src="/cliente-drawer.js?v=20260502-1" defer></script>
<script>
window.TDF_ROLE = '<%= (user && user.role) || "" %>';
// === PREFERÊNCIA DE NOTIFICAÇÕES ===
// Modos: 'icon' (default — minimizado, só ícone com badge) | 'right' (popups direita) | 'left' (popups esquerda)
// Default mudado pra 'icon' em 05/Mai/2026 — popups eram intrusivos (Paulo pediu minimizar).
window.tdfNotifSide = (function(){
  const KEY = 'tdf_notif_side';
  function get(){ return localStorage.getItem(KEY) || 'icon'; }
  function set(v){ localStorage.setItem(KEY, v); aplicar(v); }
  function aplicar(v){
    const root = document.documentElement;
    if (v === 'left') {
      root.style.setProperty('--tdf-notif-x', 'left');
      root.style.setProperty('--tdf-notif-x-px', '20px');
      root.style.setProperty('--tdf-notif-x-px-r', 'auto');
      document.body.classList.remove('tdf-notif-icon-mode');
      document.body.classList.add('tdf-notif-left');
    } else if (v === 'right') {
      root.style.setProperty('--tdf-notif-x', 'right');
      document.body.classList.remove('tdf-notif-icon-mode', 'tdf-notif-left');
    } else {
      // 'icon' (default)
      root.style.setProperty('--tdf-notif-x', 'right');
      document.body.classList.add('tdf-notif-icon-mode');
      document.body.classList.remove('tdf-notif-left');
      criarFloatingNotifIcon();
    }
    // Atualiza botão do menu
    const btn = document.getElementById('tdf-notif-side-btn');
    if (btn) btn.textContent = '🔔 Notif: ' + (v === 'left' ? '←' : v === 'icon' ? '·' : '→');
  }
  function criarFloatingNotifIcon(){
    // Revendedor é externo: nada de notificação de WhatsApp de lead.
    if (window.TDF_ROLE === 'revendedor') return;
    if (document.getElementById('tdf-floating-notif-icon')) return;
    const btn = document.createElement('button');
    btn.id = 'tdf-floating-notif-icon';
    btn.title = 'Notificações WhatsApp — click pra abrir lista';
    btn.style.cssText = 'position:fixed;bottom:80px;right:18px;z-index:9999;background:linear-gradient(135deg,#25D366,#128C7E);color:#fff;border:2px solid #fff;border-radius:50%;width:54px;height:54px;font-size:22px;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;font-weight:800;transition:all .15s';
    btn.innerHTML = '💬<span id="tdf-floating-notif-count" style="position:absolute;top:-4px;right:-4px;background:#ef4444;color:#fff;font-size:10px;font-weight:800;min-width:20px;height:20px;border-radius:10px;padding:0 5px;display:none;align-items:center;justify-content:center;border:2px solid #0a0a0a">0</span>';
    btn.onclick = () => { window.tdfNotifAbrirPainel?.(); };
    document.body.appendChild(btn);
    // Painel deslizante de notificações
    if (!document.getElementById('tdf-notif-painel')) {
      const painel = document.createElement('div');
      painel.id = 'tdf-notif-painel';
      painel.style.cssText = 'position:fixed;bottom:140px;right:18px;width:340px;max-width:calc(100vw - 36px);max-height:480px;background:#0a0a0a;border:1px solid #25D366;border-radius:12px;box-shadow:0 12px 40px rgba(37,211,102,.3);z-index:9999;display:none;flex-direction:column;overflow:hidden';
      painel.innerHTML = `
        <div style="padding:12px 14px;border-bottom:1px solid #1a1a1a;display:flex;align-items:center;gap:8px;background:linear-gradient(135deg,#0f3a1a,#22c55e22)">
          <span style="font-size:18px">💬</span>
          <div style="flex:1;color:#fff;font-weight:800;font-size:13px">Notificações WhatsApp</div>
          <button id="tdf-notif-marcar-todas" style="background:transparent;border:none;color:#aaa;font-size:10px;cursor:pointer" title="Marcar todas como lidas">✓ Limpar</button>
          <button onclick="window.tdfNotifAbrirPainel(false)" style="background:transparent;border:none;color:#888;font-size:18px;cursor:pointer">×</button>
        </div>
        <div id="tdf-notif-lista" style="flex:1;overflow-y:auto;padding:8px"></div>
        <div style="padding:8px 14px;border-top:1px solid #1a1a1a;background:#0d0d0d;display:flex;justify-content:space-between;align-items:center">
          <a href="/inbox" style="color:#25D366;font-size:11px;font-weight:700;text-decoration:none">→ Abrir Inbox completo</a>
          <span id="tdf-notif-painel-info" style="color:#666;font-size:10px"></span>
        </div>
      `;
      document.body.appendChild(painel);
      document.getElementById('tdf-notif-marcar-todas').onclick = () => {
        window.tdfNotifLimparTodas?.();
      };
    }
  }
  document.addEventListener('DOMContentLoaded', () => aplicar(get()));
  return { get, set, aplicar };
})();
function tdfNotifTrocarLado(btn){
  const atual = window.tdfNotifSide.get();
  // Cycle: icon → right → left → icon
  const proximo = atual === 'icon' ? 'right' : atual === 'right' ? 'left' : 'icon';
  window.tdfNotifSide.set(proximo);
}

// Helper global pra copiar telefone (usado no CRM Closy, leads parados, etc)
// Se o user passar string formato BR ('5512991234567'), formata pra '+55 12 99123-4567' antes de copiar.
window.copyTel = async function(tel, btn) {
  const limpo = String(tel || '').replace(/\D/g, '');
  if (!limpo) return;
  try {
    await navigator.clipboard.writeText(limpo);
    if (btn) {
      const orig = btn.textContent;
      const origStyle = btn.style.cssText;
      btn.textContent = '✓';
      btn.style.background = '#22c55e';
      btn.style.color = '#000';
      btn.style.borderColor = '#22c55e';
      setTimeout(() => { btn.textContent = orig; btn.style.cssText = origStyle; }, 1200);
    }
  } catch(e) {
    // Fallback pra browsers antigos
    const ta = document.createElement('textarea');
    ta.value = limpo; ta.style.position = 'fixed'; ta.style.left = '-9999px';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); if (btn) { btn.textContent = '✓'; setTimeout(() => btn.textContent = '📋', 1200); } }
    catch(_){ alert('Erro: ' + e.message); }
    document.body.removeChild(ta);
  }
};

// Helper global pra copiar qualquer texto (ID de deal, código, etc) com feedback visual
window.copyText = async function(text, srcEl, label) {
  const value = String(text || '').trim();
  if (!value) return;
  try { await navigator.clipboard.writeText(value); }
  catch(e) {
    const ta = document.createElement('textarea');
    ta.value = value; ta.style.position = 'fixed'; ta.style.left = '-9999px';
    document.body.appendChild(ta); ta.select();
    try { document.execCommand('copy'); } catch(_){}
    document.body.removeChild(ta);
  }
  // Toast curto no canto
  const toast = document.createElement('div');
  toast.textContent = '✓ Copiado: ' + (label || (value.length > 30 ? value.slice(0,30)+'…' : value));
  toast.style.cssText = 'position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#10b981;color:#000;font-weight:700;padding:8px 16px;border-radius:6px;z-index:99999;font-size:13px;box-shadow:0 4px 12px rgba(0,0,0,.4);animation:tdfFadeOut .25s ease 1.5s forwards';
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 1800);
  // Pisca o elemento clicado
  if (srcEl) {
    const orig = srcEl.style.background;
    srcEl.style.background = 'rgba(16,185,129,.3)';
    setTimeout(() => srcEl.style.background = orig, 400);
  }
};
// CSS pro fade do toast
(function(){
  if (document.getElementById('tdf-copytext-style')) return;
  const st = document.createElement('style'); st.id = 'tdf-copytext-style';
  st.textContent = '@keyframes tdfFadeOut{from{opacity:1}to{opacity:0;transform:translate(-50%,10px)}}';
  document.head.appendChild(st);
})();

// Buffer de notificações pendentes (modo ícone)
window._TDF_NOTIFS_PENDENTES = [];
window.tdfNotifAdd = function(n){
  // Adiciona ao buffer (deduplica por dealId, mantém última msg)
  const buf = window._TDF_NOTIFS_PENDENTES;
  const idx = buf.findIndex(x => x.dealId === n.dealId);
  if (idx >= 0) {
    buf[idx] = { ...buf[idx], ...n, count: (buf[idx].count||1) + 1 };
  } else {
    buf.push({ ...n, count: 1, addedAt: Date.now() });
  }
  // Mantém só últimas 30
  if (buf.length > 30) buf.splice(0, buf.length - 30);
  tdfNotifAtualizarBadge();
  tdfNotifRenderPainel();
};
window.tdfNotifAtualizarBadge = function(){
  const cnt = (window._TDF_NOTIFS_PENDENTES || []).reduce((s, n) => s + (n.count || 1), 0);
  const el = document.getElementById('tdf-floating-notif-count');
  if (el) {
    if (cnt > 0) {
      el.textContent = cnt > 99 ? '99+' : cnt;
      el.style.display = 'flex';
    } else {
      el.style.display = 'none';
    }
  }
};
window.tdfNotifAbrirPainel = function(forceState){
  const p = document.getElementById('tdf-notif-painel');
  if (!p) return;
  const aberto = p.style.display === 'flex';
  const novoEstado = forceState !== undefined ? forceState : !aberto;
  p.style.display = novoEstado ? 'flex' : 'none';
  if (novoEstado) tdfNotifRenderPainel();
};
window.tdfNotifLimparTodas = function(){
  window._TDF_NOTIFS_PENDENTES = [];
  tdfNotifAtualizarBadge();
  tdfNotifRenderPainel();
};
window.tdfNotifRemover = function(dealId){
  window._TDF_NOTIFS_PENDENTES = (window._TDF_NOTIFS_PENDENTES || []).filter(n => n.dealId !== dealId);
  tdfNotifAtualizarBadge();
  tdfNotifRenderPainel();
};
window.tdfNotifRenderPainel = function(){
  const list = document.getElementById('tdf-notif-lista');
  const info = document.getElementById('tdf-notif-painel-info');
  if (!list) return;
  const buf = (window._TDF_NOTIFS_PENDENTES || []).slice().sort((a,b) => (b.ts||b.addedAt||0) - (a.ts||a.addedAt||0));
  if (info) info.textContent = buf.length ? `${buf.length} conversa${buf.length>1?'s':''}` : '';
  if (!buf.length) {
    list.innerHTML = '<div style="color:#666;text-align:center;padding:30px;font-size:12px">Sem notificações pendentes ✓</div>';
    return;
  }
  list.innerHTML = buf.map(n => {
    const fmt = (ts) => { const d = new Date(ts); return d.toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}); };
    const canal = n.canal === 'zapi' ? '⚡ Z-API' : '📱 WATI';
    const cor = n.canal === 'zapi' ? '#7cb9f5' : '#22c55e';
    const corpo = (n.text || '').replace(/</g,'&lt;').slice(0, 80);
    const nomeEsc = (n.nome || n.phone || '').replace(/'/g,"\\'");
    return `<div onclick="window.abrirChat&&abrirChat('${n.dealId}','${n.phone}','${nomeEsc}','${n.canal||'wati'}');tdfNotifRemover('${n.dealId}');tdfNotifAbrirPainel(false);" style="background:#161616;border-left:3px solid ${cor};border-radius:6px;padding:10px;margin-bottom:6px;cursor:pointer;transition:background .15s">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px">
        <span style="background:${cor}22;color:${cor};font-size:9px;font-weight:800;padding:1px 6px;border-radius:3px">${canal}</span>
        <span style="flex:1;font-weight:800;color:#fff;font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${n.nome || n.phone}</span>
        <span style="color:#888;font-size:10px">${fmt(n.ts || n.addedAt)}</span>
        ${n.count > 1 ? `<span style="background:#ef4444;color:#fff;font-size:9px;font-weight:800;padding:1px 5px;border-radius:8px">+${n.count}</span>` : ''}
        <button onclick="event.stopPropagation();tdfNotifRemover('${n.dealId}')" style="background:transparent;border:none;color:#666;cursor:pointer;font-size:14px;padding:0 2px">×</button>
      </div>
      <div style="color:#aaa;font-size:11px;line-height:1.3">${corpo}</div>
    </div>`;
  }).join('');
};
</script>
<style>
/* Quando 'left' ativo, flipa lado das notificações principais */
body.tdf-notif-left .tdf-notif-stack { right: auto !important; left: 18px !important; }
body.tdf-notif-left .tdf-fab-cluster { right: auto !important; left: 18px !important; align-items: flex-start !important; }
body.tdf-notif-left .tdf-chat-bar { right: auto !important; left: 18px !important; }
body.tdf-notif-left .tk-toast-task { right: auto !important; left: 24px !important; }
/* Modo ícone: esconde popups grandes e mostra só o ícone flutuante */
body.tdf-notif-icon-mode .tdf-notif-stack { display: none !important; }
body.tdf-notif-icon-mode .tk-toast-task { right: 80px !important; bottom: 80px !important; max-width: 280px; transform: scale(.85); transform-origin: bottom right }
</style>
<script>
// === POPUP NOTIFICAÇÃO DE TAREFAS (global em todas páginas) ===
(function(){
  const SHOWN_KEY = 'tdf_tarefas_alertadas_v1';
  function getShown(){ try { return JSON.parse(sessionStorage.getItem(SHOWN_KEY) || '[]'); } catch(_){ return []; } }
  function setShown(arr){ try { sessionStorage.setItem(SHOWN_KEY, JSON.stringify(arr.slice(-100))); } catch(_){} }
  async function check(){
    try {
      const r = await fetch('/tarefas/minhas', { credentials: 'same-origin' });
      if (!r.ok) return;
      const d = await r.json();
      const lista = Array.isArray(d.tarefas) ? d.tarefas : (Array.isArray(d) ? d : []);
      const agora = Date.now();
      const shown = getShown();
      for (const t of lista) {
        if (t.status !== 'aberta') continue;
        const ts = new Date(t.dataHora).getTime();
        const lembreteMs = (parseInt(t.lembreteMin)||5) * 60000;
        if (agora >= (ts - lembreteMs) && agora <= (ts + 5*60000) && !shown.includes(t.id)) {
          mostrarPopupTarefa(t);
          shown.push(t.id);
          setShown(shown);
        }
      }
    } catch(_){}
  }
  function mostrarPopupTarefa(t){
    try { window.tdfSons?.tocar(); } catch(_){}
    if (window.Notification && Notification.permission === 'granted') {
      try {
        const n = new Notification('📋 ' + t.titulo, {
          body: (t.dealNome ? t.dealNome + ' · ' : '') + 'Vence em ' + Math.round((new Date(t.dataHora).getTime() - Date.now())/60000) + 'min',
          tag: 'tarefa-' + t.id,
          requireInteraction: true,
        });
        n.onclick = () => { window.focus(); if (t.dealId) location.href = '/manutencao#'+t.dealId; n.close(); };
      } catch(_){}
    }
    const pop = document.createElement('div');
    const lado = (window.tdfNotifSide?.get && window.tdfNotifSide.get()) || 'right';
    const posStyle = lado === 'left' ? 'left:20px' : 'right:20px';
    pop.style.cssText = `position:fixed;bottom:20px;${posStyle};background:linear-gradient(135deg,#0d1117,#1a0e2a);border:2px solid #fbbf24;border-radius:12px;padding:14px 16px;box-shadow:0 8px 24px rgba(0,0,0,.5);z-index:9999;max-width:380px;color:#fff;animation:tdfTarefaIn .3s ease-out`;
    pop.innerHTML = `
      <div style="display:flex;align-items:start;gap:10px">
        <span style="font-size:24px">⏰</span>
        <div style="flex:1">
          <div style="color:#fbbf24;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px">TAREFA AGORA</div>
          <div style="font-weight:800;font-size:13px;margin-bottom:4px">${(t.titulo||'').replace(/</g,'&lt;')}</div>
          ${t.dealNome ? '<div style="color:#aaa;font-size:11px">Cliente: '+(t.dealNome||'').replace(/</g,'&lt;')+'</div>' : ''}
          ${t.atribuidos_nomes && t.atribuidos_nomes.length > 1 ? '<div style="color:#a371f7;font-size:10px;margin-top:2px">👥 '+t.atribuidos_nomes.join(', ')+'</div>' : ''}
          ${t.observacao ? '<div style="color:#888;font-size:10px;margin-top:4px;font-style:italic">'+(t.observacao||'').replace(/</g,'&lt;')+'</div>' : ''}
          <div style="color:#666;font-size:10px;margin-top:4px">${new Date(t.dataHora).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'})}</div>
        </div>
      </div>
      <div style="display:flex;gap:6px;margin-top:10px;flex-wrap:wrap">
        ${t.dealId ? '<a href="/manutencao#'+t.dealId+'" style="flex:1;background:#1f6feb;color:#fff;text-decoration:none;text-align:center;border-radius:5px;padding:6px 10px;font-size:11px;font-weight:700">📂 Ver cliente</a>' : ''}
        <button onclick="tdfTarefaConcluir('${t.id}', this.parentElement.parentElement)" style="flex:1;background:#22c55e;color:#000;border:none;border-radius:5px;padding:6px 10px;font-size:11px;font-weight:800;cursor:pointer">✓ Concluir</button>
        <button onclick="tdfTarefaAdiar('${t.id}', this.parentElement.parentElement)" style="background:#fbbf24;color:#000;border:none;border-radius:5px;padding:6px 10px;font-size:11px;font-weight:800;cursor:pointer">+15min</button>
        <button onclick="this.parentElement.parentElement.remove()" style="background:transparent;color:#888;border:1px solid #444;border-radius:5px;padding:6px 10px;font-size:11px;cursor:pointer">✕</button>
      </div>
    `;
    document.body.appendChild(pop);
    setTimeout(() => { if (pop.parentElement) pop.remove(); }, 90000);
  }
  window.tdfTarefaConcluir = async function(id, el) {
    try { await fetch('/tarefas/'+id+'/concluir', { method:'POST' }); if (el) el.remove(); } catch(_){}
  };
  window.tdfTarefaAdiar = async function(id, el) {
    try {
      await fetch('/tarefas/'+id+'/adiar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ minutos: 15 }) });
      if (el) el.remove();
      try { const arr = JSON.parse(sessionStorage.getItem('tdf_tarefas_alertadas_v1')||'[]'); sessionStorage.setItem('tdf_tarefas_alertadas_v1', JSON.stringify(arr.filter(x => x !== id))); } catch(_){}
    } catch(_){}
  };
  const cssNode = document.createElement('style');
  cssNode.textContent = '@keyframes tdfTarefaIn { from { transform: translateX(120%); opacity: 0; } to { transform: translateX(0); opacity: 1; } }';
  document.head.appendChild(cssNode);
  setTimeout(() => { check(); setInterval(check, 30000); }, 5000);
  document.addEventListener('click', () => {
    if (window.Notification && Notification.permission === 'default') Notification.requestPermission().catch(()=>{});
  }, { once: true });
})();
</script>
<style>
/* Override absoluto pro dropdown abrir, no caso de CSS antigo cacheado */
.nav-drop.open .nav-drop-menu { display: block !important; opacity: 1 !important; visibility: visible !important; }
.nav-drop-btn { pointer-events: auto !important; cursor: pointer !important; }
</style>
<script>
// FIX dropdowns nav — função global + auto-bind via attribute observer
window.navDropToggle = function(btn, e) {
  if (e) { try { e.preventDefault(); e.stopPropagation(); } catch(_){} }
  // Remove qualquer popup anterior
  var prev = document.getElementById('__navPopup');
  if (prev) {
    var btnPrev = prev.dataset.btnRef;
    prev.remove();
    if (btnPrev === btn.textContent.trim()) return; // re-click no mesmo = só fecha
  }
  var drop = btn && btn.parentElement;
  if (!drop || !drop.classList.contains('nav-drop')) return;
  var menuOriginal = drop.querySelector('.nav-drop-menu');
  if (!menuOriginal) return;
  // Cria popup novo direto no body (bypass total de CSS antigo)
  var rect = btn.getBoundingClientRect();
  var popup = document.createElement('div');
  popup.id = '__navPopup';
  popup.dataset.btnRef = btn.textContent.trim();
  popup.style.cssText = [
    'position:fixed',
    'top:' + (rect.bottom + 4) + 'px',
    'left:' + rect.left + 'px',
    'background:#0d1117',
    'border:1px solid #30363d',
    'border-radius:8px',
    'min-width:240px',
    'padding:6px',
    'z-index:99999',
    'box-shadow:0 12px 32px rgba(0,0,0,.6)',
    'display:block',
  ].join(';');
  // Copia os links do menu original
  var links = menuOriginal.querySelectorAll('a');
  for (var i = 0; i < links.length; i++) {
    var a = links[i];
    var clone = document.createElement('a');
    clone.href = a.getAttribute('href') || '#';
    clone.innerHTML = a.innerHTML;
    clone.target = a.getAttribute('target') || '';
    clone.style.cssText = 'display:block;padding:9px 14px;color:' + (a.style.color || '#c9d1d9') + ';text-decoration:none;font-size:13px;border-radius:5px;white-space:nowrap';
    clone.addEventListener('mouseenter', function(){ this.style.background = '#161b22'; this.style.color = '#fff'; });
    clone.addEventListener('mouseleave', function(){ this.style.background = ''; });
    // Se tinha onclick inline, copia
    var oc = a.getAttribute('onclick');
    if (oc) clone.setAttribute('onclick', oc + ';document.getElementById("__navPopup")?.remove();');
    else clone.addEventListener('click', function(){ var p = document.getElementById('__navPopup'); if (p) p.remove(); });
    popup.appendChild(clone);
  }
  document.body.appendChild(popup);
};

// Bind programmático — APENAS UM método de click pra evitar double-toggle.
// (versão anterior tinha addEventListener + onclick property → ambos disparavam,
//  toggle abria e fechava no mesmo click → banner "FECHADO" sempre)
function _navBindAll(){
  var btns = document.querySelectorAll('.nav-drop-btn');
  for (var i = 0; i < btns.length; i++) {
    var btn = btns[i];
    if (btn.__navBound) continue;
    btn.__navBound = true;
    // Único listener click (cobre mouse + touch via Atlas)
    btn.addEventListener('click', function(e){ window.navDropToggle(this, e); });
    // Acessibilidade: Enter/Space também abre
    btn.addEventListener('keydown', function(e){
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); window.navDropToggle(this, e); }
    });
  }
}

// Tenta múltiplas vezes (caso DOM ainda não esteja pronto)
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', _navBindAll);
} else {
  _navBindAll();
}
setTimeout(_navBindAll, 100);
setTimeout(_navBindAll, 500);
setTimeout(_navBindAll, 2000);

// Click fora fecha popup do nav
document.addEventListener('click', function(e){
  try {
    if (e.target.closest && (e.target.closest('.nav-drop-btn') || e.target.closest('#__navPopup'))) return;
    var p = document.getElementById('__navPopup');
    if (p) p.remove();
    var abertos = document.querySelectorAll('.nav-drop.open');
    for (var i = 0; i < abertos.length; i++) abertos[i].classList.remove('open');
  } catch(_){}
});
</script>


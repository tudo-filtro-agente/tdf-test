let _DIR_LEADS_PERIODO = 'hoje';
let _DIR_LEADS_VISAO = 'closer'; // 'closer' | 'fonte'
function dirRenderLeadsTime(){
  const el = document.getElementById('dir-leads-time');
  if (!el) return;
  const d = _DIR_DATA?.leadsPorCloser;
  if (!d) { el.innerHTML = ''; return; }
  const periodo = _DIR_LEADS_PERIODO;
  const visao = _DIR_LEADS_VISAO;
  const data = d[periodo] || {};
  // Monta agrupamento por closer ou por fonte
  let grupos = [];
  if (visao === 'closer') {
    grupos = Object.entries(data).filter(([_,c]) => c.total > 0).sort((a,b) => b[1].total - a[1].total);
  } else {
    // Agrupar por Lead_Source
    const porFonte = {};
    Object.values(data).forEach(c => {
      c.leads.forEach(l => {
        const f = l.source || 'Sem origem';
        if (!porFonte[f]) porFonte[f] = { nome: f, team: 'origem', leads: [], total: 0, porEtapa: {} };
        porFonte[f].leads.push(l);
        porFonte[f].total++;
        porFonte[f].porEtapa[l.stage] = (porFonte[f].porEtapa[l.stage] || 0) + 1;
      });
    });
    grupos = Object.entries(porFonte).sort((a,b) => b[1].total - a[1].total);
  }
  el.innerHTML = `
    <div style="padding:10px 14px;display:flex;align-items:center;gap:6px;border-bottom:1px solid #2a1a3a;flex-wrap:wrap">
      <strong style="color:#fff;font-size:12px">📋 Leads</strong>
      <span style="color:#888;font-size:10px">por</span>
      <button onclick="dirSetVisao('closer')" style="background:${visao==='closer'?'#7c3aed':'#222'};color:#fff;border:none;border-radius:5px;padding:4px 9px;font-size:10px;cursor:pointer;font-weight:700">👤 Closer</button>
      <button onclick="dirSetVisao('fonte')" style="background:${visao==='fonte'?'#7c3aed':'#222'};color:#fff;border:none;border-radius:5px;padding:4px 9px;font-size:10px;cursor:pointer;font-weight:700">📡 Fonte</button>
      <span style="flex:1"></span>
      <button onclick="dirSetPeriodo('hoje')" style="background:${periodo==='hoje'?'#1f6feb':'#222'};color:#fff;border:none;border-radius:5px;padding:4px 9px;font-size:10px;cursor:pointer;font-weight:700">📅 Hoje</button>
      <button onclick="dirSetPeriodo('mes')" style="background:${periodo==='mes'?'#1f6feb':'#222'};color:#fff;border:none;border-radius:5px;padding:4px 9px;font-size:10px;cursor:pointer;font-weight:700">🗓️ Mês</button>
    </div>
    <div style="max-height:50vh;overflow-y:auto;padding:8px 12px">
      ${grupos.length === 0 ? '<div style="color:#666;text-align:center;padding:14px;font-size:11px">Nenhum lead '+(periodo==='hoje'?'hoje':'no mês')+' ainda</div>' :
      grupos.map(([key, c]) => {
        const etapasResumo = Object.entries(c.porEtapa).map(([s,n]) => `<span style="background:#1a0f2e;color:#a371f7;padding:2px 7px;border-radius:8px;font-size:9px;margin-right:3px">${_esc(s)} ${n}</span>`).join('');
        const leadsHtml = c.leads.slice(0, 10).map(l => {
          const tier = l.tier ? `<span style="color:#fbbf24;font-size:9px;font-weight:700">${_esc(l.tier)}</span> ` : '';
          const cor = l.paradoH >= 24 ? '#ef4444' : l.paradoH >= 8 ? '#fbbf24' : '#888';
          return `<div style="display:flex;align-items:center;gap:4px;padding:3px 5px;border-bottom:1px solid #1f0d2e;font-size:10px">
            ${tier}
            <span style="flex:1;color:#ddd;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${_esc(l.nome)}</span>
            <span style="color:${cor};font-size:9px;min-width:36px;text-align:right">${l.paradoH<24?l.paradoH+'h':Math.round(l.paradoH/24)+'d'}</span>
            <span style="background:#222;color:#888;padding:1px 5px;border-radius:5px;font-size:8px;text-transform:uppercase;max-width:90px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${_esc(l.stage)}">${_esc(l.stage).slice(0,16)}</span>
            <button onclick="dirNubiaLead('${_esc(l.id)}',this)" title="Acionar Núbia neste lead" style="background:transparent;border:1px solid #a371f7;color:#a371f7;border-radius:4px;font-size:9px;padding:2px 5px;cursor:pointer;font-weight:700">🤖</button>
            ${l.phone ? `<button onclick="window.abrirChat&&abrirChat('${_esc(l.id)}','${_esc(l.phone)}','${_esc(l.nome)}')" title="Abrir chat" style="background:transparent;border:1px solid #22c55e;color:#22c55e;border-radius:4px;font-size:9px;padding:2px 5px;cursor:pointer">💬</button>` : ''}
          </div>`;
        }).join('');
        return `<details style="margin-bottom:5px;background:rgba(167,113,247,.06);border-radius:5px;padding:6px 8px">
          <summary style="cursor:pointer;display:flex;align-items:center;gap:6px;font-size:11px">
            <span style="color:#fff;font-weight:700;flex:1">${_esc(c.nome)} <span style="color:#888;font-size:9px;font-weight:400">${c.team!=='origem'?'('+_esc(c.team)+')':''}</span></span>
            <span style="background:#7c3aed;color:#fff;font-weight:800;padding:1px 7px;border-radius:8px;font-size:10px">${c.total}</span>
          </summary>
          <div style="margin-top:5px;padding-top:5px;border-top:1px solid #2a1a3a">
            <div style="margin-bottom:4px">${etapasResumo}</div>
            ${leadsHtml}
            ${c.leads.length > 10 ? `<div style="text-align:center;color:#666;font-size:9px;padding:4px">+ ${c.leads.length-10} leads</div>` : ''}
          </div>
        </details>`;
      }).join('')}
    </div>
  `;
}
function dirSetPeriodo(p){ _DIR_LEADS_PERIODO = p; dirRenderLeadsTime(); }
function dirSetVisao(v){ _DIR_LEADS_VISAO = v; dirRenderLeadsTime(); }

async function dirNubiaLead(dealId, btn){
  if (!confirm('Acionar Núbia neste lead?')) return;
  if (btn) { btn.disabled = true; btn.textContent = '⏳'; }
  try {
    const r = await fetch('/cockpit/nubia-meu-lead', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ dealId })
    });
    const ct = r.headers.get('content-type')||'';
    if (!ct.includes('json')) { alert('Erro: '+(r.status===401?'sessão expirada':'resposta inválida')); return; }
    const d = await r.json();
    if (d.error) alert('Erro: '+d.error);
    else { alert('🤖 Núbia disparada!'); if (btn) btn.style.color='#22c55e'; }
  } catch(e) { alert(e.message); }
  if (btn) { btn.disabled = false; btn.textContent = '🤖'; }
}

// Aciona Núbia em massa nos leads do alerta atual (chamado pelos botões do diretor)
async function dirAcionarNubia(modo, btn){
  if (!confirm('Disparar Núbia em modo "'+modo+'" pros leads listados?')) return;
  if (btn) { btn.disabled = true; btn.textContent = '⏳ Disparando...'; }
  try {
    const r = await fetch('/gestao/nubia-reengaja', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ tipo: modo }) });
    const ct = r.headers.get('content-type') || '';
    if (!ct.includes('json')) { alert('Erro: ' + (r.status === 401 ? 'sessão expirada' : 'resposta inválida ' + r.status)); return; }
    const d = await r.json();
    if (d.error) alert('Erro: '+d.error);
    else alert('✅ Núbia disparou pra '+(d.sent||0)+' leads ('+(d.candidates||0)+' candidatos)');
  } catch(e) { alert(e.message); }
  if (btn) { btn.disabled = false; btn.textContent = '🤖 Acionar Núbia'; }
}

function dirPopupOpen(){
  document.getElementById('dir-popup').style.display = 'block';
  dirPopupRender();
}
function dirPopupClose(){
  document.getElementById('dir-popup').style.display = 'none';
}
function dirPopupToggle(){
  const p = document.getElementById('dir-popup');
  if (p.style.display === 'none' || !p.style.display) dirPopupOpen();
  else dirPopupClose();
}

// === NOTIFICAÇÕES NATIVAS ===
async function dirAtivarNotif(){
  if (!('Notification' in window)) { alert('Seu navegador não suporta notificações'); return; }
  if (Notification.permission === 'granted') {
    document.getElementById('dir-notif-btn').textContent = '🔔 Notificações ativas';
    document.getElementById('dir-notif-btn').disabled = true;
    new Notification('🎙️ Diretor IA', { body: 'Notificações ativadas. Vou te avisar quando algo precisar de atenção.', icon: '/icon-192.png' });
    return;
  }
  const r = await Notification.requestPermission();
  if (r === 'granted') {
    document.getElementById('dir-notif-btn').textContent = '🔔 Ativas';
    new Notification('🎙️ Diretor IA', { body: 'Pronto. Vou te avisar das urgências.', icon: '/icon-192.png' });
  }
}
function dirNotificar(msg){
  if (!('Notification' in window)) return;
  if (Notification.permission !== 'granted') return;
  const titulo = (msg.icon||'🚨') + ' ' + (msg.titulo || 'Diretor IA');
  const corpo = (msg.texto||'').slice(0, 200);
  try {
    const n = new Notification(titulo, {
      body: corpo,
      icon: '/icon-192.png',
      badge: '/favicon.png',
      tag: 'diretor-ia-' + (msg.msgId || msg.titulo),
      requireInteraction: msg.tipo === 'critico' || msg.intensidade === 'critico',
    });
    n.onclick = () => {
      window.focus();
      dirPopupOpen();
      n.close();
    };
  } catch(e) { console.warn('notif:', e); }
}

// Atualiza estado do botão notif na abertura
setTimeout(() => {
  const btn = document.getElementById('dir-notif-btn');
  if (btn && 'Notification' in window && Notification.permission === 'granted') {
    btn.textContent = '🔔 Notificações ativas';
    btn.disabled = true;
  }
}, 100);

dirLoad();
setInterval(dirLoad, 60000);

// Permite abrir via âncora #tarefas
if (location.hash === '#tarefas') tkToggle();
window.addEventListener('hashchange', () => { if (location.hash === '#tarefas') tkToggle(); });
</script>
<% } %>

<!-- ============= UX #5: BADGE "atualizado há X" GLOBAL ============= -->
<script>
// Helper global: registra um "freshness badge" pra qualquer elemento
// Uso: tdfFresh('id-do-elemento', () => loadDataAgain())
//   - Mostra "Atualizado há Xs" abaixo do ts atual
//   - Botão clicável força refresh
//   - Auto-update do label a cada 5s
window.tdfFresh = (function(){
  const tracked = new Map(); // id → { lastFresh, refreshFn }
  function fmtTs(ts){
    const s = Math.floor((Date.now() - ts) / 1000);
    if (s < 5) return 'agora';
    if (s < 60) return `há ${s}s`;
    const m = Math.floor(s / 60);
    if (m < 60) return `há ${m}min`;
    const h = Math.floor(m / 60);
    return `há ${h}h${m%60>0?(m%60)+'min':''}`;
  }
  function render(id){
    const el = document.getElementById(id);
    if (!el) return;
    const t = tracked.get(id);
    if (!t) return;
    el.innerHTML = `<span style="color:#22c55e;font-size:10px">●</span> Atualizado ${fmtTs(t.lastFresh)} <span style="opacity:.5;font-size:9px">(↻)</span>`;
  }
  setInterval(() => {
    for (const id of tracked.keys()) render(id);
  }, 5000);
  return function tdfFresh(id, refreshFn){
    const el = document.getElementById(id);
    if (!el) return;
    el.style.cssText = 'cursor:pointer;color:#888;font-size:11px;font-weight:600;padding:2px 8px;border-radius:6px;border:1px solid #2a2a2a;background:#0d0d0d;display:inline-flex;align-items:center;gap:5px;transition:border-color .15s';
    el.title = 'Click pra atualizar agora';
    el.onmouseenter = () => el.style.borderColor = '#22c55e';
    el.onmouseleave = () => el.style.borderColor = '#2a2a2a';
    el.onclick = async () => {
      const old = el.innerHTML;
      el.innerHTML = '<span style="color:#7cb9f5;font-size:10px">↻</span> Atualizando...';
      try { await refreshFn(); } catch(_){}
      tracked.set(id, { lastFresh: Date.now(), refreshFn });
      render(id);
    };
    tracked.set(id, { lastFresh: Date.now(), refreshFn });
    render(id);
  };
})();
</script>

<!-- ============= COMMAND PALETTE Cmd+K (UX #6) ============= -->
<style>
.cmdk-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:9000;align-items:flex-start;justify-content:center;padding-top:80px}
.cmdk-overlay.show{display:flex}
.cmdk-card{background:var(--bg-card);border:1px solid #1f6feb;border-radius:12px;width:560px;max-width:calc(100vw - 40px);max-height:70vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 12px 40px rgba(31,111,235,.3)}
.cmdk-input-wrap{border-bottom:1px solid var(--border);padding:12px 16px;display:flex;align-items:center;gap:10px}
.cmdk-input-wrap .icon{font-size:18px;color:var(--text-muted)}
.cmdk-input{flex:1;background:transparent;border:none;color:var(--text);font-size:14px;outline:none;font-family:inherit}
.cmdk-input::placeholder{color:#5b6068}
.cmdk-kbd{background:var(--bg-card);border:1px solid var(--border);color:var(--text-muted);padding:2px 6px;border-radius:4px;font-size:10px;font-family:monospace}
.cmdk-results{flex:1;overflow-y:auto;padding:6px 0}
.cmdk-empty{padding:30px;text-align:center;color:var(--text-muted);font-size:12px}
.cmdk-loading{padding:18px;text-align:center;color:var(--text-muted);font-size:12px}
.cmdk-item{display:grid;grid-template-columns:24px 1fr auto;gap:10px;padding:9px 16px;cursor:pointer;align-items:center;border-left:3px solid transparent}
.cmdk-item:hover,.cmdk-item.active{background:var(--bg-card);border-left-color:#1f6feb}
.cmdk-item .ico{font-size:14px;text-align:center}
.cmdk-item .nome{color:var(--text);font-weight:700;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cmdk-item .sub{color:var(--text-muted);font-size:10px;display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin-top:1px}
.cmdk-item .sub .pill{background:#1f2937;color:#9ca3af;padding:1px 6px;border-radius:6px;font-size:9px;font-weight:700}
.cmdk-item .stage{color:#7cb9f5;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.3px}
.cmdk-foot{border-top:1px solid var(--border);padding:8px 16px;color:var(--text-muted);font-size:10px;display:flex;justify-content:space-between;background:var(--bg-card)}
</style>
<div id="cmdk" class="cmdk-overlay" onclick="if(event.target===this)cmdkClose()">
  <div class="cmdk-card">
    <div class="cmdk-input-wrap">
      <span class="icon">🔍</span>
      <input id="cmdk-input" class="cmdk-input" placeholder="Buscar cliente por nome, telefone, cidade..." autocomplete="off">
      <span class="cmdk-kbd">esc</span>
    </div>
    <div id="cmdk-results" class="cmdk-results"><div class="cmdk-empty">Digite pelo menos 2 caracteres pra buscar</div></div>
    <div class="cmdk-foot"><span>↑↓ navegar · ↵ abrir · esc fechar</span><span><span class="cmdk-kbd">⌘K</span> ou <span class="cmdk-kbd">Ctrl+K</span></span></div>
  </div>
</div>
<script>
(function(){
  const overlay = document.getElementById('cmdk');
  const input = document.getElementById('cmdk-input');
  const results = document.getElementById('cmdk-results');
  let _cmdkResults = []; let _cmdkIdx = 0; let _cmdkAbort = null; let _cmdkDebounce = null;

  window.cmdkOpen = function(){
    overlay.classList.add('show');
    input.value = '';
    input.focus();
    results.innerHTML = '<div class="cmdk-empty">Digite pelo menos 2 caracteres pra buscar</div>';
  };
  window.cmdkClose = function(){ overlay.classList.remove('show'); };

  // Atalho global Cmd+K / Ctrl+K
  document.addEventListener('keydown', e => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      cmdkOpen();
      return;
    }
    if (overlay.classList.contains('show')) {
      if (e.key === 'Escape') { e.preventDefault(); cmdkClose(); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); _cmdkIdx = Math.min(_cmdkResults.length-1, _cmdkIdx+1); cmdkRenderActive(); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); _cmdkIdx = Math.max(0, _cmdkIdx-1); cmdkRenderActive(); }
      else if (e.key === 'Enter' && _cmdkResults[_cmdkIdx]) {
        e.preventDefault();
        cmdkAbrir(_cmdkResults[_cmdkIdx]);
      }
    }
  });

  input.addEventListener('input', () => {
    clearTimeout(_cmdkDebounce);
    const q = input.value.trim();
    if (q.length < 2) {
      results.innerHTML = '<div class="cmdk-empty">Digite pelo menos 2 caracteres pra buscar</div>';
      _cmdkResults = []; return;
    }
    _cmdkDebounce = setTimeout(() => cmdkBuscar(q), 220);
  });

  async function cmdkBuscar(q){
    if (_cmdkAbort) _cmdkAbort.abort();
    _cmdkAbort = new AbortController();
    results.innerHTML = '<div class="cmdk-loading">⏳ Buscando...</div>';
    try {
      const r = await fetch('/api/v1/search?q=' + encodeURIComponent(q), { signal: _cmdkAbort.signal });
      const d = await r.json();
      _cmdkResults = d.results || []; _cmdkIdx = 0;
      cmdkRender();
    } catch(e) {
      if (e.name === 'AbortError') return;
      results.innerHTML = `<div class="cmdk-empty" style="color:#ef4444">Erro: ${e.message}</div>`;
    }
  }

  function cmdkRender(){
    if (!_cmdkResults.length) { results.innerHTML = '<div class="cmdk-empty">Nenhum cliente encontrado</div>'; return; }
    const tierIco = t => t==='Diamante'?'💎':t==='Ouro'?'🥇':t==='Prata'?'🥈':t==='Bronze'?'🥉':'👤';
    results.innerHTML = _cmdkResults.map((r, i) => `
      <div class="cmdk-item ${i===_cmdkIdx?'active':''}" onclick="cmdkAbrirIdx(${i})" data-idx="${i}">
        <div class="ico">${tierIco(r.tier)}</div>
        <div>
          <div class="nome">${(r.nome||'?').replace(/</g,'&lt;')}</div>
          <div class="sub">
            ${r.phone?`<span>📞 ${r.phone}</span>`:''}
            ${r.cidade?`<span class="pill">📍 ${r.cidade}</span>`:''}
            ${r.owner?`<span class="pill">${r.owner.split(' ')[0]}</span>`:''}
          </div>
        </div>
        <div class="stage">${r.stage||''}</div>
      </div>
    `).join('');
  }

  function cmdkRenderActive(){
    document.querySelectorAll('.cmdk-item').forEach(el => {
      el.classList.toggle('active', Number(el.dataset.idx) === _cmdkIdx);
    });
    const active = document.querySelector('.cmdk-item.active');
    if (active) active.scrollIntoView({ block: 'nearest' });
  }

  window.cmdkAbrirIdx = function(idx){ if (_cmdkResults[idx]) cmdkAbrir(_cmdkResults[idx]); };

  function cmdkAbrir(r){
    cmdkClose();
    if (window.abrirChat) {
      window.abrirChat(r.id, r.phone, r.nome, 'wati');
    } else {
      window.location.href = '/closy?dealId=' + encodeURIComponent(r.id);
    }
  }
})();
</script>


<script>
// === Diretor IA: drag pelo header + minimizar (vira só FAB) + salva posição ===
(function(){
  function setup(){
    const popup = document.getElementById('dir-popup');
    const header = document.getElementById('dir-popup-header');
    if (!popup || !header) return;
    // Restaura posição salva
    try {
      const saved = JSON.parse(localStorage.getItem('tdf-dir-pos') || 'null');
      if (saved && typeof saved.left === 'number') {
        popup.style.left = saved.left + 'px';
        popup.style.top = saved.top + 'px';
        popup.style.right = 'auto';
      }
    } catch(_){}
    let drag = null;
    header.addEventListener('mousedown', e => {
      if (e.target.tagName === 'BUTTON') return;
      const r = popup.getBoundingClientRect();
      drag = { dx: e.clientX - r.left, dy: e.clientY - r.top };
      e.preventDefault();
    });
    document.addEventListener('mousemove', e => {
      if (!drag) return;
      const left = Math.max(4, Math.min(window.innerWidth - 100, e.clientX - drag.dx));
      const top = Math.max(4, Math.min(window.innerHeight - 60, e.clientY - drag.dy));
      popup.style.left = left + 'px';
      popup.style.top = top + 'px';
      popup.style.right = 'auto';
    });
    document.addEventListener('mouseup', () => {
      if (!drag) return;
      const r = popup.getBoundingClientRect();
      try { localStorage.setItem('tdf-dir-pos', JSON.stringify({ left: r.left, top: r.top })); } catch(_){}
      drag = null;
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup);
  else setup();
  // Função global pra minimizar
  window.dirPopupMinimizar = function(){
    document.getElementById('dir-popup').style.display = 'none';
    // FAB fica como ele é; o badge sinaliza que tem alerta novo
  };
})();
</script>

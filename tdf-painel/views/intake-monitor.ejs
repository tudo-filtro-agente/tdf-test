// ═══ CHAT ═══
let _chatPhone='';
async function openChat(phone,name){
  _chatPhone=phone;
  document.getElementById('chatTitle').textContent=`${name} (...${phone.slice(-4)})`;
  document.getElementById('chatMsgs').innerHTML='<div class="chat-loading">Carregando conversa...</div>';
  document.getElementById('chatInput').value='';
  document.getElementById('chatBg').classList.add('show');
  try{
    const r=await fetch(`/intake-monitor/chat?phone=${phone}`);
    const d=await r.json();
    if(!d.ok)throw new Error(d.error);
    const box=document.getElementById('chatMsgs');
    if(!d.messages.length){box.innerHTML='<div class="chat-loading">Nenhuma mensagem encontrada</div>';return}
    box.innerHTML=d.messages.map(m=>{
      if(!m.text)return '';
      const cls=m.owner?'nubia':'lead';
      const who=m.owner?(m.operator||'Nubia'):'Lead';
      const time=m.time?m.time.slice(11,16):'';
      return `<div class="chat-msg ${cls}"><div>${m.text}</div><div class="meta">${who} ${time}</div></div>`;
    }).join('');
    box.scrollTop=box.scrollHeight;
  }catch(e){
    document.getElementById('chatMsgs').innerHTML=`<div class="chat-loading" style="color:#f87171">Erro: ${e.message}</div>`;
  }
  setTimeout(()=>document.getElementById('chatInput').focus(),200);
}
function closeChat(){document.getElementById('chatBg').classList.remove('show');_chatPhone=''}
async function sendChat(){
  const msg=document.getElementById('chatInput').value.trim();
  if(!msg||!_chatPhone)return;
  const btn=document.getElementById('chatSendBtn');
  btn.disabled=true;
  try{
    const r=await fetch('/intake-monitor/send-wati',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({phone:_chatPhone,message:msg})});
    const d=await r.json();
    if(d.ok){
      const box=document.getElementById('chatMsgs');
      box.innerHTML+=`<div class="chat-msg nubia"><div>${msg}</div><div class="meta">Voce agora</div></div>`;
      box.scrollTop=box.scrollHeight;
      document.getElementById('chatInput').value='';
      toast('Mensagem enviada!',true);
    }else{
      toast(d.detail||'Janela fechada (>24h)',false);
    }
  }catch(e){toast('Erro: '+e.message,false)}
  btn.disabled=false;
}
</script>

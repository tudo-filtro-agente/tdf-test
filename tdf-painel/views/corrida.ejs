<% const activePage = 'corrida'; const pageTitle = 'Corrida da Meta'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
.race-track { background: linear-gradient(180deg, var(--bg-card) 0%, #111827 100%); border: 1px solid #1f2937; border-radius: 16px; padding: 24px; margin-bottom: 20px; overflow: hidden; }
.race-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
.car-row { display: flex; align-items: center; gap: 10px; padding: 10px 0; border-bottom: 1px solid #1f2937; position: relative; }
.car-pos { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; border-radius: 50%; font-size: 12px; font-weight: 800; }
.car-name { width: 120px; font-weight: 700; font-size: 13px; color: var(--text); }
.car-track { flex: 1; height: 32px; background: #1f2937; border-radius: 16px; position: relative; overflow: hidden; }
.car-fill { height: 100%; border-radius: 16px; transition: width 1.5s ease; display: flex; align-items: center; justify-content: flex-end; padding-right: 8px; min-width: 30px; }
.car-icon { font-size: 20px; filter: drop-shadow(0 0 6px rgba(255,255,255,0.3)); }
.car-stats { width: 160px; text-align: right; font-size: 12px; color: var(--text-muted); }
.finish-line { position: absolute; right: 0; top: 0; bottom: 0; width: 3px; background: repeating-linear-gradient(0deg, #fff 0px, #fff 4px, #000 4px, #000 8px); opacity: 0.3; }
.nitro { animation: nitro-glow 0.5s ease infinite alternate; }
@keyframes nitro-glow { from { filter: drop-shadow(0 0 8px #F0C040); } to { filter: drop-shadow(0 0 16px #ff6b00); } }
.risk-zone { background: repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(239,68,68,0.05) 10px, rgba(239,68,68,0.05) 20px); }
.car-alert { position: absolute; right: -24px; font-size: 14px; }
</style>

<div class="page-header">
  <h1 style="display:flex;align-items:center;gap:12px;">
    <span style="font-size:28px;">🏎️</span> Corrida da Meta
  </h1>
  <p class="subtitle" id="race-sub">Carregando...</p>
</div>

<div class="container">
  <div id="race-loading" style="text-align:center;padding:40px;color:var(--text-muted);">Carregando corrida...</div>
  <div id="race-content" style="display:none;">
    <div class="race-track" id="race-track"></div>
    <div id="race-insights" style="background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:16px;margin-bottom:24px"></div>
  </div>

  <!-- RANKING ANUAL POR GRUPOS -->
  <div id="anual-content" style="margin-top:24px">
    <h2 style="color:#F0C040;font-size:1.2rem;margin:0 0 14px;display:flex;align-items:center;gap:10px"><span style="font-size:24px">🏆</span> Ranking Anual <span id="anual-year" style="color:var(--text-muted);font-size:1rem;font-weight:400"></span></h2>
    <div id="anual-loading" style="color:var(--text-muted);font-size:13px">Carregando ranking anual...</div>
    <div id="anual-grupos" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:14px"></div>
  </div>
</div>

<script>
(async function loadAnual(){
  try{
    const res = await fetch('/cockpit/anual-ranking');
    const d = await res.json();
    if (d.error) { document.getElementById('anual-loading').textContent = 'Erro: '+d.error; return; }
    document.getElementById('anual-loading').style.display = 'none';
    document.getElementById('anual-year').textContent = '· '+d.ano;
    const grupos = [
      { id:'filtro',    label:'Filtros de Entrada', icon:'💧', cor:'#5ba3f5' },
      { id:'bebedouro', label:'Bebedouros',         icon:'🚰', cor:'#F0C040' },
      { id:'loja',      label:'Loja Física',        icon:'🏪', cor:'#A371F7' },
    ];
    const fmt = v => 'R$ '+(Math.round(v||0)/1000).toFixed(0)+'k';
    const medalhas = ['🥇','🥈','🥉'];
    document.getElementById('anual-grupos').innerHTML = grupos.map(g => {
      const lista = d[g.id] || [];
      const total = d.total[g.id] || 0;
      return `<div style="background:#161B22;border:2px solid ${g.cor};border-radius:14px;padding:18px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
          <span style="font-size:22px">${g.icon}</span>
          <h3 style="color:${g.cor};font-size:1rem;margin:0;flex:1">${g.label}</h3>
          <span style="color:#fff;font-weight:800;font-size:14px">${fmt(total)}</span>
        </div>
        ${lista.length === 0
          ? '<div style="color:#888;font-size:12px;text-align:center;padding:20px">Sem vendas no ano</div>'
          : lista.map((r, i) => `
            <div style="display:flex;align-items:center;gap:10px;padding:8px 4px;border-bottom:1px solid #21262D;font-size:13px">
              <span style="width:28px;text-align:center;font-size:${i<3?'18px':'12px'};font-weight:800;color:${i===0?'#F0C040':i===1?'#C0C0C0':i===2?'#CD7F32':'#888'}">${medalhas[i] || '#'+(i+1)}</span>
              <span style="flex:1;color:#E6EDF3;font-weight:600">${r.name}</span>
              <span style="color:#888;font-size:11px;width:60px;text-align:right">${r.vendas} venda(s)</span>
              <span style="color:${g.cor};font-weight:800;width:90px;text-align:right">${fmt(r.fat)}</span>
            </div>
          `).join('')
        }
      </div>`;
    }).join('');
  }catch(e){ document.getElementById('anual-loading').textContent = 'Erro: '+e.message; }
})();
</script>

<script>
(async () => {
  try {
    const res = await fetch('/cockpit/corrida');
    const d = await res.json();
    if (d.error) throw new Error(d.error);

    document.getElementById('race-loading').style.display = 'none';
    document.getElementById('race-content').style.display = 'block';
    document.getElementById('race-sub').textContent = `${d.carros.length} closers | Lider: ${d.lider} (R$ ${(d.liderFat/1000).toFixed(0)}k)`;

    const posColors = ['#F0C040', '#C0C0C0', '#CD7F32'];
    const statusColors = { normal: '#3b82f6', amarelo: '#eab308', vermelho: '#ef4444', chegou: '#22c55e' };

    const filtro = d.carros.filter(c => c.team !== 'bebedouro');
    const bebedouro = d.carros.filter(c => c.team === 'bebedouro');

    function renderTrack(carros, titulo, cor) {
      return `<div style="margin-bottom:16px;">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;">
          <h3 style="color:${cor};font-size:1rem;margin:0;">${titulo}</h3>
          <span style="color:#8B949E;font-size:12px;">Meta = 100%</span>
        </div>
        ${carros.map((c, i) => {
        const posColor = i < 3 ? posColors[i] : '#6b7280';
        const fillColor = statusColors[c.status] || '#3b82f6';
        const pctDisplay = Math.min(c.pct, 100);
        const carEmoji = c.status === 'chegou' ? '🏆' : c.nitro ? '🏎️💨' : '🚗';
        const alert = c.status === 'vermelho' ? '🔴' : c.status === 'amarelo' ? '🟡' : '';

        return `<div class="car-row ${c.zonaRisco ? 'risk-zone' : ''}">
          <div class="car-pos" style="background:${posColor}20;color:${posColor};">${i + 1}</div>
          <div class="car-name">${c.nome}<br><span style="font-size:10px;color:#6b7280;">${c.team}</span></div>
          <div class="car-track">
            <div class="finish-line"></div>
            <div class="car-fill" style="width:${pctDisplay}%;background:linear-gradient(90deg,${fillColor}40,${fillColor});">
              <span class="car-icon ${c.nitro ? 'nitro' : ''}">${carEmoji}</span>
            </div>
          </div>
          <div class="car-stats">
            <div style="color:#fff;font-weight:700;">${c.pct}% | R$ ${(c.fat/1000).toFixed(0)}k</div>
            <div>${c.vendas} vendas | ${c.diasSemVenda > 0 ? '<span style="color:' + (c.diasSemVenda >= 3 ? '#ef4444' : c.diasSemVenda >= 2 ? '#eab308' : '#8B949E') + ';">' + c.diasSemVenda + 'd sem venda</span>' : '<span style="color:#22c55e;">vendeu hoje!</span>'}</div>
            ${c.faltaMeta > 0 ? '<div style="color:#8B949E;">Falta R$ ' + (c.faltaMeta/1000).toFixed(0) + 'k</div>' : '<div style="color:#22c55e;">META BATIDA!</div>'}
          </div>
          ${alert ? '<div class="car-alert">' + alert + '</div>' : ''}
        </div>`;
      }).join('')}
      </div>`;
    }

    document.getElementById('race-track').innerHTML =
      renderTrack(filtro, '🔧 Corrida Filtro de Entrada', '#58A6FF') +
      renderTrack(bebedouro, '🚰 Corrida Bebedouro', '#F0C040');

    // Insights
    const chegaram = d.carros.filter(c => c.status === 'chegou');
    const risco = d.carros.filter(c => c.zonaRisco);
    const nitros = d.carros.filter(c => c.nitro);
    document.getElementById('race-insights').innerHTML = `
      <h3 style="color:#E6EDF3;font-size:1rem;margin:0 0 10px;">📊 Insights da Corrida</h3>
      <div style="font-size:13px;color:#ccc;line-height:1.8;">
        ${chegaram.length > 0 ? '🏆 <strong style="color:#22c55e;">' + chegaram.map(c=>c.nome).join(', ') + '</strong> cruzaram a linha de chegada!<br>' : ''}
        ${nitros.length > 0 ? '🏎️💨 <strong style="color:#F0C040;">' + nitros.map(c=>c.nome).join(', ') + '</strong> ativaram Nitro Boost (venderam hoje)<br>' : ''}
        ${risco.length > 0 ? '⚠️ <strong style="color:#ef4444;">' + risco.map(c=>c.nome).join(', ') + '</strong> na zona de risco (abaixo de 30% na metade do mes)<br>' : ''}
        🥇 Lider: <strong>${d.lider}</strong> com R$ ${(d.liderFat/1000).toFixed(0)}k
      </div>
    `;
  } catch(e) {
    document.getElementById('race-loading').textContent = 'Erro: ' + e.message;
  }
})();
</script>

</div></body></html>

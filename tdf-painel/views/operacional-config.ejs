<% const activePage = 'operacional'; const pageTitle = 'Operacional · Configurações'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
  .cfg-shell { max-width:1200px; margin:0 auto; padding:0 14px }
  .cfg-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px }
  .cfg-head h1 { margin:0; font-size:18px; color:var(--text) }
  .cfg-head .sub { color:var(--text-muted); font-size:12px }
  .cfg-tabs { display:flex; gap:4px; background:var(--bg-card); border-radius:8px; padding:4px; margin-bottom:14px; flex-wrap:wrap }
  .cfg-tab { padding:8px 14px; border-radius:6px; cursor:pointer; font-size:12px; color:var(--text-muted); font-weight:600; display:flex; align-items:center; gap:6px }
  .cfg-tab:hover { color:#cbd5e1 }
  .cfg-tab.active { background:#1f6feb; color:#fff }
  .cfg-panel { background:var(--bg-card); border:1px solid var(--border); border-radius:10px; padding:18px; display:none }
  .cfg-panel.active { display:block }

  /* === Etapas === */
  .cfg-kanban-block { margin-bottom:18px }
  .cfg-kanban-block h3 { font-size:13px; color:#93c5fd; margin:0 0 10px; padding-bottom:6px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center }
  .cfg-stage-row { display:grid; grid-template-columns:30px 1fr 80px 80px 80px 80px 32px; gap:8px; padding:8px 10px; align-items:center; background:var(--bg); border:1px solid var(--border); border-radius:6px; margin-bottom:4px }
  .cfg-stage-row .dot { width:14px; height:14px; border-radius:50%; border:2px solid #fff }
  .cfg-stage-row .info .lbl { color:var(--text); font-size:12px; font-weight:700 }
  .cfg-stage-row .info .code { color:var(--text-muted); font-size:10px; font-family:monospace }
  .cfg-stage-row .badge-flag { font-size:9px; padding:2px 5px; border-radius:3px; background:var(--border); color:var(--text-muted); text-align:center; font-weight:700 }

  /* === Settings (route fit etc) === */
  .cfg-settings-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px }
  @media (max-width:800px) { .cfg-settings-grid { grid-template-columns:1fr } }
  .cfg-setting { background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:12px 14px }
  .cfg-setting .k { color:var(--text); font-size:12px; font-weight:700; margin-bottom:4px; font-family:monospace }
  .cfg-setting .desc { color:var(--text-muted); font-size:11px; margin-bottom:8px }
  .cfg-setting input, .cfg-setting select, .cfg-setting textarea { width:100%; background:var(--bg); border:1px solid var(--border); color:var(--text); padding:6px 9px; border-radius:4px; font-size:13px; box-sizing:border-box; font-family:inherit }
  .cfg-setting .save-row { display:flex; justify-content:space-between; align-items:center; margin-top:6px }
  .cfg-setting .save-row button { background:var(--border); border:1px solid var(--border); color:#22c55e; padding:5px 12px; border-radius:4px; cursor:pointer; font-size:11px; font-weight:700 }
  .cfg-setting .save-row button:hover { background:#22c55e; color:#000 }
  .cfg-setting .save-row .meta { color:var(--text-muted); font-size:10px }

  /* === Técnicos === */
  .cfg-tech-row { display:grid; grid-template-columns:1fr 130px 1fr 60px 90px; gap:8px; padding:8px 10px; align-items:center; background:var(--bg); border:1px solid var(--border); border-radius:6px; margin-bottom:4px }
  .cfg-tech-row input { background:var(--bg); border:1px solid var(--border); color:var(--text); padding:5px 8px; border-radius:4px; font-size:12px }
  .cfg-tech-row .name { color:var(--text); font-weight:700; font-size:12px }
  .cfg-tech-row .name small { color:var(--text-muted); font-weight:400; font-size:10px; display:block }
  .cfg-tech-row .toggle { width:36px; height:18px; background:#475569; border-radius:10px; position:relative; cursor:pointer; transition:background .15s }
  .cfg-tech-row .toggle.on { background:#22c55e }
  .cfg-tech-row .toggle::after { content:''; width:14px; height:14px; background:#fff; border-radius:50%; position:absolute; top:2px; left:2px; transition:left .15s }
  .cfg-tech-row .toggle.on::after { left:20px }
  .cfg-tech-row button { background:var(--border); border:1px solid var(--border); color:#22c55e; padding:5px 8px; border-radius:4px; cursor:pointer; font-size:11px }
  .cfg-tech-row button:hover { background:#22c55e; color:#000 }

  /* === Link cards === */
  .cfg-links { display:grid; grid-template-columns:1fr 1fr; gap:12px }
  @media (max-width:700px) { .cfg-links { grid-template-columns:1fr } }
  .cfg-link { background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:18px; text-decoration:none; display:block; transition:all .15s }
  .cfg-link:hover { border-color:#1f6feb; transform:translateY(-1px) }
  .cfg-link .icon { font-size:24px; margin-bottom:8px }
  .cfg-link .title { color:var(--text); font-size:13px; font-weight:700; margin-bottom:4px }
  .cfg-link .sub { color:var(--text-muted); font-size:11px }
  .btn { padding:7px 14px; border-radius:6px; font-size:11px; font-weight:700; cursor:pointer; border:1px solid; background:transparent }
  .btn-sec { color:#93c5fd; border-color:#1f6feb }
</style>

<div class="cfg-shell">
  <div class="cfg-head">
    <div>
      <h1>⚙️ Configurações Operacional</h1>
      <div class="sub">Personalize etapas, mensagens, regras de IA, técnicos e cadastros — tudo num lugar só, sem código.</div>
    </div>
    <a href="/operacional" class="btn btn-sec" style="text-decoration:none">← Voltar ao painel</a>
  </div>

  <div class="cfg-tabs" id="cfg-tabs">
    <div class="cfg-tab active" data-panel="etapas" onclick="cfgSwitch('etapas')">🏷 Etapas dos Kanbans</div>
    <div class="cfg-tab" data-panel="msgs" onclick="cfgSwitch('msgs')">💬 Mensagens WATI por etapa</div>
    <div class="cfg-tab" data-panel="ia" onclick="cfgSwitch('ia')">🤖 Regras IA encaixe rota</div>
    <div class="cfg-tab" data-panel="tecnicos" onclick="cfgSwitch('tecnicos')">👷 Técnicos / Equipe</div>
    <div class="cfg-tab" data-panel="prompts" onclick="cfgSwitch('prompts')">🤖 Prompts IA</div>
    <div class="cfg-tab" data-panel="skills" onclick="cfgSwitch('skills')">🛠 Skills</div>
    <div class="cfg-tab" data-panel="scheduler" onclick="cfgSwitch('scheduler')">📊 Jobs/Scheduler</div>
    <div class="cfg-tab" data-panel="cadastros" onclick="cfgSwitch('cadastros')">📚 Cadastros gerais</div>
  </div>

  <!-- Etapas -->
  <div class="cfg-panel active" id="cfg-panel-etapas">
    <div id="cfg-stages-content"><div style="padding:30px;text-align:center;color:var(--text-muted)">Carregando…</div></div>
  </div>

  <!-- Msgs -->
  <div class="cfg-panel" id="cfg-panel-msgs">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
      <div>
        <h3 style="margin:0;font-size:14px;color:var(--text)">💬 Mensagens automáticas por etapa</h3>
        <div style="color:var(--text-muted);font-size:11px;margin-top:4px">Configure qual mensagem WATI dispara quando um cliente entra em cada etapa — sem código.</div>
      </div>
      <a href="/operacional/config/stage-messages" class="btn btn-sec" style="text-decoration:none">Abrir painel completo →</a>
    </div>

    <!-- Atalho: enviar 12 templates pro Lucas -->
    <div style="background:var(--bg);border:1px solid #f59e0b;border-left:4px solid #f59e0b;border-radius:8px;padding:14px;margin-bottom:14px">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap">
        <div>
          <div style="color:#fbbf24;font-weight:700;font-size:13px;margin-bottom:4px">📨 Solicitar criação dos 12 templates pro Lucas</div>
          <div style="color:var(--text-muted);font-size:11px">Dispara Z-API (12996240914) + email (marketing@tudodefiltro.com.br) com a lista completa de templates ia_* necessários (intake filtro entrada, bebedouro, entregas TDF, transportadora).</div>
        </div>
        <button id="btn-send-lucas" onclick="sendLucasTemplates()" style="background:#fbbf24;color:#000;border:0;padding:8px 16px;border-radius:6px;font-weight:700;font-size:12px;cursor:pointer;white-space:nowrap">📨 Enviar pro Lucas</button>
      </div>
      <div id="lucas-result" style="margin-top:10px;font-size:11px"></div>
    </div>

    <iframe src="/operacional/config/stage-messages" style="width:100%;height:600px;border:1px solid var(--border);border-radius:8px;background:var(--bg)"></iframe>
  </div>

  <script>
  async function sendLucasTemplates() {
    if (!confirm('Confirma envio dos 12 templates ia_* pro Lucas (Z-API 12996240914 + email marketing@)?')) return;
    const btn = document.getElementById('btn-send-lucas');
    const result = document.getElementById('lucas-result');
    btn.disabled = true; btn.textContent = '⏳ Enviando…';
    result.innerHTML = '';
    try {
      const r = await fetch('/operacional/admin/send-lucas-templates', {
        method: 'POST', headers: {'Content-Type':'application/json'}, credentials: 'same-origin'
      });
      const j = await r.json();
      const wa = j.results?.whatsapp;
      const em = j.results?.email;
      const waBadge = wa?.sent ? '<span style="color:#22c55e">✅ WhatsApp enviado</span>' : `<span style="color:#f87171">❌ WhatsApp falhou: ${wa?.error || '?'}</span>`;
      const emBadge = em?.sent ? '<span style="color:#22c55e">✅ Email enviado</span>' : `<span style="color:#f87171">❌ Email falhou: ${em?.error || '?'}</span>`;
      result.innerHTML = `<div style="background:#161B22;border:1px solid #30363D;border-radius:6px;padding:8px 12px"><div>${waBadge}</div><div style="margin-top:4px">${emBadge}</div></div>`;
      btn.textContent = j.ok ? '✅ Enviado' : '⚠ Erro';
      setTimeout(() => { btn.disabled = false; btn.textContent = '📨 Enviar pro Lucas'; }, 5000);
    } catch (e) {
      result.innerHTML = `<div style="color:#f87171">Erro: ${e.message}</div>`;
      btn.disabled = false; btn.textContent = '📨 Enviar pro Lucas';
    }
  }
  </script>

  <!-- IA -->
  <div class="cfg-panel" id="cfg-panel-ia">
    <h3 style="margin:0 0 10px;font-size:14px;color:var(--text)">🤖 Regras de IA — Encaixe de entrega em rota</h3>
    <div style="color:var(--text-muted);font-size:11px;margin-bottom:14px">Parâmetros do algoritmo que cruza Entregas TDF pendentes com Routes futuras (aba Entregas TDF → painel laranja "💡 Sugestões IA").</div>
    <div class="cfg-settings-grid" id="cfg-ia-settings"><div style="padding:14px;color:var(--text-muted)">Carregando…</div></div>
  </div>

  <!-- Técnicos -->
  <div class="cfg-panel" id="cfg-panel-tecnicos">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
      <h3 style="margin:0;font-size:14px;color:var(--text)">👷 Técnicos / Equipe</h3>
      <button class="btn btn-sec" onclick="cfgTechSync()">🔄 Sincronizar com Auvo</button>
    </div>
    <div style="color:var(--text-muted);font-size:11px;margin-bottom:14px">Edite phone, skills (separadas por vírgula) e ative/desative. Phone é necessário pra envio Z-API direto pelo técnico no mapa.</div>
    <div id="cfg-tech-list"><div style="padding:14px;color:var(--text-muted)">Carregando…</div></div>
  </div>

  <!-- Prompts IA -->
  <div class="cfg-panel" id="cfg-panel-prompts">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
      <div>
        <h3 style="margin:0;font-size:14px;color:var(--text)">🤖 Prompts dos Agentes IA</h3>
        <div style="color:var(--text-muted);font-size:11px;margin-top:4px">Edite as instruções da Núbia (e outros agentes). Mudança vai pra produção na hora, sem deploy.</div>
      </div>
      <a href="/operacional/config/prompts" class="btn btn-sec" style="text-decoration:none">Abrir editor completo →</a>
    </div>
    <div id="cfg-prompts-list" style="display:grid;grid-template-columns:1fr 1fr;gap:10px"><div style="grid-column:1/-1;padding:14px;color:var(--text-muted)">Carregando…</div></div>
  </div>

  <!-- Skills -->
  <div class="cfg-panel" id="cfg-panel-skills">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <div>
        <h3 style="margin:0;font-size:14px;color:var(--text)">🛠 Catálogo de Skills / Especialidades</h3>
        <div style="color:var(--text-muted);font-size:11px;margin-top:4px">Skills disponíveis pra atribuir aos técnicos e exigir em vendas. Auto-distribuição de rota usa esses critérios.</div>
      </div>
      <button class="btn btn-warn" onclick="skillCreate()">+ Nova skill</button>
    </div>
    <div id="cfg-skills-list" style="display:grid;grid-template-columns:1fr 1fr;gap:8px"><div style="grid-column:1/-1;padding:14px;color:var(--text-muted)">Carregando…</div></div>
  </div>

  <!-- Scheduler -->
  <div class="cfg-panel" id="cfg-panel-scheduler">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
      <div>
        <h3 style="margin:0;font-size:14px;color:var(--text)">📊 Jobs em background</h3>
        <div style="color:var(--text-muted);font-size:11px;margin-top:4px">Status de cada job do APScheduler. Verde = rodou OK recentemente, vermelho = travou. Auto-refresh 30s.</div>
      </div>
      <button class="btn btn-sec" onclick="loadScheduler()">🔄 Atualizar agora</button>
    </div>
    <div id="cfg-jobs-list"><div style="padding:14px;color:var(--text-muted)">Carregando…</div></div>
  </div>

  <!-- Cadastros -->
  <div class="cfg-panel" id="cfg-panel-cadastros">
    <h3 style="margin:0 0 10px;font-size:14px;color:var(--text)">📚 Cadastros gerais</h3>
    <div style="color:var(--text-muted);font-size:11px;margin-bottom:14px">Editor completo de tipos de serviço, veículos, preços de combustível e custos. Útil pra auditoria de campo.</div>
    <div class="cfg-links">
      <a href="/operacional/cadastros" class="cfg-link">
        <div class="icon">🛠</div>
        <div class="title">Tipos de Serviço</div>
        <div class="sub">Duração padrão, skill necessária, queue, prioridade default</div>
      </a>
      <a href="/operacional/cadastros" class="cfg-link">
        <div class="icon">🚗</div>
        <div class="title">Veículos</div>
        <div class="sub">Placa, modelo, técnico vinculado, GPS BrasilSat</div>
      </a>
      <a href="/operacional/cadastros" class="cfg-link">
        <div class="icon">⛽</div>
        <div class="title">Preços de combustível</div>
        <div class="sub">Histórico de preços pra cálculo de custo de rota</div>
      </a>
      <a href="/operacional/auditoria" class="cfg-link">
        <div class="icon">🔍</div>
        <div class="title">Auditoria de campo</div>
        <div class="sub">KM, tempo, geofence, scores técnicos, narrativa IA</div>
      </a>
    </div>
  </div>
</div>

<script>
const CFG = { settings: {}, stages: {delivery:[], shipment:[]}, technicians: [] };

async function _api(path, opts={}) {
  const r = await fetch(path, {
    method: opts.method || 'GET',
    headers: {'Content-Type':'application/json'},
    body: opts.body ? JSON.stringify(opts.body) : undefined,
    credentials: 'same-origin',
  });
  if (!r.ok) {
    const t = await r.text();
    throw new Error(`${r.status} — ${t.substring(0,200)}`);
  }
  return r.json();
}

function cfgSwitch(panel) {
  document.querySelectorAll('.cfg-tab').forEach(t => t.classList.toggle('active', t.dataset.panel === panel));
  document.querySelectorAll('.cfg-panel').forEach(p => p.classList.toggle('active', p.id === `cfg-panel-${panel}`));
  if (panel === 'etapas') loadStages();
  if (panel === 'ia') loadIASettings();
  if (panel === 'tecnicos') loadTechnicians();
  if (panel === 'prompts') loadPrompts();
  if (panel === 'skills') loadSkills();
  if (panel === 'scheduler') loadScheduler();
}

let _schTimer = null;
async function loadScheduler() {
  clearInterval(_schTimer);
  try {
    const r = await _api('/operacional/api/scheduler/status');
    const c = document.getElementById('cfg-jobs-list');
    if (!r.running) { c.innerHTML = '<div style="padding:14px;color:#f87171">⚠ Scheduler não está rodando</div>'; return; }
    const jobs = r.jobs || [];
    // Ordena por status (problemas primeiro)
    jobs.sort((a, b) => {
      const aBad = a.last_status === 'error' || (a.minutes_since_last_run != null && a.minutes_since_last_run > 30);
      const bBad = b.last_status === 'error' || (b.minutes_since_last_run != null && b.minutes_since_last_run > 30);
      return (bBad?1:0) - (aBad?1:0);
    });
    c.innerHTML = `
      <div style="background:#0D1117;border:1px solid #21262D;border-radius:6px;padding:10px 14px;margin-bottom:10px;font-size:12px;color:#cbd5e1">
        📋 ${r.total_jobs} jobs registrados · agora: <code>${new Date(r.now).toLocaleTimeString('pt-BR')}</code>
      </div>
      ${jobs.map(j => {
        let cls = 'info';
        let badge = '⏸ nunca rodou';
        if (j.last_status === 'ok') { cls = 'ok'; badge = `✅ ${j.last_run_at ? new Date(j.last_run_at).toLocaleTimeString('pt-BR') : 'ok'}`; }
        if (j.last_status === 'error') { cls = 'err'; badge = `❌ erro`; }
        if (j.minutes_since_last_run != null && j.minutes_since_last_run > 30) { cls = 'warn'; badge = `⚠ ${j.minutes_since_last_run.toFixed(0)}min parado`; }
        const color = cls === 'ok' ? '#22c55e' : (cls === 'err' ? '#ef4444' : (cls === 'warn' ? '#fbbf24' : '#475569'));
        const canTrigger = ['brasilsat_sync','gps_sync','intake_watcher'].includes(j.id);
        return `
          <div style="background:#0D1117;border:1px solid #21262D;border-left:3px solid ${color};border-radius:6px;padding:10px 14px;margin-bottom:6px;display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center">
            <div>
              <div style="color:#fff;font-weight:700;font-size:12px;font-family:monospace">${j.id} <span style="color:${color};font-weight:400">· ${badge}</span></div>
              <div style="color:#888;font-size:10px;margin-top:3px">${j.trigger || ''} · próximo: ${j.next_run_time ? new Date(j.next_run_time).toLocaleString('pt-BR') : '—'} ${j.duration_s ? '· última durou ' + j.duration_s.toFixed(1) + 's' : ''}</div>
              ${j.last_error ? `<div style="color:#fca5a5;font-size:10px;margin-top:4px;font-family:monospace">↳ ${j.last_error}</div>` : ''}
            </div>
            ${canTrigger ? `<button onclick="triggerJob('${j.id}')" style="background:#21262D;border:1px solid #30363D;color:#93c5fd;padding:5px 10px;border-radius:4px;cursor:pointer;font-size:11px">▶ Rodar agora</button>` : '<span></span>'}
          </div>
        `;
      }).join('')}
    `;
    // Auto-refresh
    _schTimer = setTimeout(loadScheduler, 30000);
  } catch (e) {
    document.getElementById('cfg-jobs-list').innerHTML = `<div style="color:#f87171;padding:14px">${e.message}</div>`;
  }
}

async function triggerJob(jobId) {
  if (!confirm(`Rodar job ${jobId} manualmente agora?`)) return;
  try {
    const r = await _api(`/operacional/api/scheduler/trigger/${jobId}`, { method:'POST', body:{} });
    alert(`✓ ${jobId} disparado:\n\n${JSON.stringify(r, null, 2).substring(0, 500)}`);
    loadScheduler();
  } catch (e) { alert(e.message); }
}

async function loadSkills() {
  try {
    const list = await _api('/operacional/api/skills');
    const c = document.getElementById('cfg-skills-list');
    if (!list.length) {
      c.innerHTML = '<div style="grid-column:1/-1;padding:14px;color:#666">Sem skills cadastradas</div>';
      return;
    }
    // Agrupa por category
    const byCat = {};
    for (const s of list) { (byCat[s.category] = byCat[s.category] || []).push(s); }
    c.innerHTML = Object.entries(byCat).map(([cat, items]) => `
      <div style="grid-column:1/-1;margin-top:10px">
        <div style="color:#93c5fd;font-size:11px;text-transform:uppercase;letter-spacing:.5px;font-weight:700;margin-bottom:6px">${cat}</div>
      </div>
      ${items.map(s => `
        <div style="background:#0D1117;border:1px solid #21262D;border-left:3px solid ${s.color};border-radius:6px;padding:10px 12px;display:flex;justify-content:space-between;align-items:center;gap:10px">
          <div>
            <div style="color:#fff;font-weight:700;font-size:12px">${s.label} ${s.requires_certification?'<span style="color:#fbbf24;font-size:10px">🎓 cert</span>':''} ${!s.active?'<span style="color:#666;font-size:10px">(inativa)</span>':''}</div>
            <div style="color:#888;font-size:10px;font-family:monospace;margin-top:2px">${s.key}</div>
            ${s.description ? `<div style="color:#aaa;font-size:11px;margin-top:4px;line-height:1.4">${s.description}</div>` : ''}
          </div>
          <div style="display:flex;gap:4px">
            <button onclick="skillEdit('${s.key}')" style="background:#21262D;border:1px solid #30363D;color:#93c5fd;padding:5px 8px;border-radius:4px;cursor:pointer;font-size:11px">✏️</button>
            <button onclick="skillRemove('${s.key}')" style="background:#21262D;border:1px solid #30363D;color:#ef4444;padding:5px 8px;border-radius:4px;cursor:pointer;font-size:11px">🗑</button>
          </div>
        </div>
      `).join('')}
    `).join('');
  } catch (e) {
    document.getElementById('cfg-skills-list').innerHTML = `<div style="grid-column:1/-1;color:#f87171;padding:14px">${e.message}</div>`;
  }
}

function skillCreate() {
  const key = prompt('Chave única (snake_case, ex: eletrica_leve):');
  if (!key) return;
  skillEdit(key.toLowerCase().replace(/[^a-z0-9_]/g, '_'), true);
}

async function skillEdit(key, isNew=false) {
  let current = { key, label: '', category: 'geral', description: '', requires_certification: false, color: '#475569', active: true, sort_order: 0 };
  if (!isNew) {
    try { current = await _api(`/operacional/api/skills/${encodeURIComponent(key)}`); } catch (e) { return alert(e.message); }
  }
  const label = prompt('Label (nome legível):', current.label) || current.label;
  const category = prompt('Categoria (geral|eletrica|hidraulica|instalacao|manutencao|atendimento):', current.category) || current.category;
  const description = prompt('Descrição:', current.description || '') ?? current.description;
  const requires = confirm('Requer certificação? OK=sim, Cancelar=não');
  const color = prompt('Cor hex (ex: #ef4444):', current.color || '#475569') || current.color;
  if (!label) return;
  try {
    await _api(`/operacional/api/skills/${encodeURIComponent(key)}`, {
      method:'POST', body:{ label, category, description, requires_certification: requires, color, active: true, sort_order: current.sort_order || 0 }
    });
    loadSkills();
  } catch (e) { alert(e.message); }
}

async function skillRemove(key) {
  if (!confirm(`Excluir skill "${key}"? Técnicos com essa skill mantêm referência (string), mas o catálogo perde a entrada.`)) return;
  try { await _api(`/operacional/api/skills/${encodeURIComponent(key)}`, { method:'DELETE' }); loadSkills(); }
  catch (e) { alert(e.message); }
}

async function loadPrompts() {
  try {
    const list = await _api('/operacional/api/agent-prompts');
    const c = document.getElementById('cfg-prompts-list');
    if (!list.length) {
      c.innerHTML = '<div style="grid-column:1/-1;padding:14px;color:#666">Nenhum prompt cadastrado</div>';
      return;
    }
    c.innerHTML = list.map(p => `
      <a href="/operacional/config/prompts#${encodeURIComponent(p.key)}" class="cfg-link" style="text-decoration:none">
        <div class="icon">🤖</div>
        <div class="title">${p.label}</div>
        <div class="sub" style="margin-top:4px"><code>${p.key}</code> · ${p.agent} · v${p.version} · ${p.active?'<span style="color:#22c55e">ativo</span>':'<span style="color:#888">inativo</span>'}</div>
        <div class="sub" style="margin-top:6px">${(p.description || '').substring(0,140)}</div>
      </a>
    `).join('');
  } catch (e) {
    document.getElementById('cfg-prompts-list').innerHTML = `<div style="grid-column:1/-1;color:#f87171;padding:14px">${e.message}</div>`;
  }
}

// === Etapas ===
async function loadStages() {
  try {
    const [delivery, shipment] = await Promise.all([
      _api('/operacional/api/kanban/stages?kanban=delivery'),
      _api('/operacional/api/kanban/stages?kanban=shipment'),
    ]);
    CFG.stages = { delivery, shipment };
    renderStages();
  } catch (e) {
    document.getElementById('cfg-stages-content').innerHTML = `<div style="color:#f87171;padding:14px">${e.message}</div>`;
  }
}

function renderStages() {
  document.getElementById('cfg-stages-content').innerHTML = `
    ${renderStageBlock('🚚 Entregas TDF', 'delivery')}
    ${renderStageBlock('📦 Transportadora', 'shipment')}
  `;
}

function renderStageBlock(title, kanban) {
  const stages = CFG.stages[kanban] || [];
  return `
    <div class="cfg-kanban-block">
      <h3>${title} <a href="/operacional/config/stage-messages" style="font-size:11px;color:#93c5fd;text-decoration:none">Configurar mensagens →</a></h3>
      ${stages.map(s => `
        <div class="cfg-stage-row">
          <div class="dot" style="background:${s.color}"></div>
          <div class="info"><div class="lbl">${s.label}</div><div class="code">${s.code}</div></div>
          <span class="badge-flag">seq ${s.sequence}</span>
          ${s.is_initial ? '<span class="badge-flag" style="color:#22c55e">INICIAL</span>' : '<span></span>'}
          ${s.is_terminal ? '<span class="badge-flag" style="color:#fbbf24">FINAL</span>' : '<span></span>'}
          <span class="badge-flag" style="color:${s.active?'#22c55e':'#666'}">${s.active?'ATIVA':'inativa'}</span>
          <span></span>
        </div>
      `).join('')}
      <div style="margin-top:8px;color:#666;font-size:11px">Pra editar/criar/reordenar etapas, vá ao kanban e clique em "⚙️ Gerenciar etapas".</div>
    </div>
  `;
}

// === IA Settings ===
async function loadIASettings() {
  try {
    const all = await _api('/operacional/api/settings?prefix=route_fit');
    CFG.settings = all;
    const grid = document.getElementById('cfg-ia-settings');
    grid.innerHTML = Object.entries(all).map(([key, info]) => `
      <div class="cfg-setting">
        <div class="k">${key}</div>
        <div class="desc">${info.description || '—'}</div>
        <input type="number" id="cfg-s-${key.replace(/\./g,'_')}" value="${info.value}" step="any">
        <div class="save-row">
          <div class="meta">Atualizado ${new Date(info.updated_at).toLocaleString('pt-BR')}</div>
          <button onclick="cfgSaveSetting('${key}')">💾 Salvar</button>
        </div>
      </div>
    `).join('');
  } catch (e) {
    document.getElementById('cfg-ia-settings').innerHTML = `<div style="color:#f87171;padding:14px">${e.message}</div>`;
  }
}

async function cfgSaveSetting(key) {
  const el = document.getElementById(`cfg-s-${key.replace(/\./g,'_')}`);
  let v = parseFloat(el.value);
  if (isNaN(v)) return alert('Valor inválido');
  try {
    await _api(`/operacional/api/settings/${encodeURIComponent(key)}`, {
      method:'PUT', body:{ value: v }
    });
    alert(`✓ ${key} = ${v}`);
    loadIASettings();
  } catch (e) { alert(e.message); }
}

// === Técnicos ===
async function loadTechnicians() {
  try {
    const techs = await _api('/operacional/api/technicians');
    const list = Array.isArray(techs) ? techs : (techs.items || []);
    CFG.technicians = list;
    const container = document.getElementById('cfg-tech-list');
    if (!list.length) {
      container.innerHTML = '<div style="padding:14px;color:#666">Nenhum técnico cadastrado</div>';
      return;
    }
    container.innerHTML = `
      <div class="cfg-tech-row" style="background:#161B22;font-size:10px;color:#666;text-transform:uppercase;letter-spacing:.5px">
        <div>NOME</div><div>PHONE</div><div>SKILLS (vírgula)</div><div>ATIVO</div><div></div>
      </div>
      ${list.map(t => `
        <div class="cfg-tech-row" data-id="${t.id}">
          <div class="name">${t.name}<small>${t.email || 'sem email'} · ${t.base_city || 'sem cidade'}</small></div>
          <input id="cfg-tp-${t.id}" type="text" value="${t.phone || ''}" placeholder="Ex: 12996240914">
          <input id="cfg-ts-${t.id}" type="text" value="${(t.skills||[]).join(', ')}" placeholder="filtro_entrada, bebedouro">
          <div class="toggle ${t.active?'on':''}" onclick="cfgTechToggle(${t.id})" title="Ativo/Inativo"></div>
          <button onclick="cfgTechSave(${t.id})">💾</button>
        </div>
        <div style="background:#0D1117;border:1px solid #21262D;border-top:0;border-radius:0 0 6px 6px;padding:8px 12px;margin-bottom:6px;display:grid;grid-template-columns:repeat(5,1fr);gap:8px;font-size:11px;align-items:center">
          <label style="color:#888">Início<br><input id="cfg-tws-${t.id}" type="time" value="${t.work_start_time||'08:00'}" style="background:#0D1117;border:1px solid #30363D;color:#fff;padding:4px;border-radius:3px;font-size:12px;width:90%"></label>
          <label style="color:#888">Fim<br><input id="cfg-twe-${t.id}" type="time" value="${t.work_end_time||'18:00'}" style="background:#0D1117;border:1px solid #30363D;color:#fff;padding:4px;border-radius:3px;font-size:12px;width:90%"></label>
          <label style="color:#888">Almoço<br><input id="cfg-tls-${t.id}" type="time" value="${t.lunch_start_time||'12:00'}" style="background:#0D1117;border:1px solid #30363D;color:#fff;padding:4px;border-radius:3px;font-size:12px;width:90%"></label>
          <label style="color:#888">Duração almoço (min)<br><input id="cfg-tld-${t.id}" type="number" value="${t.lunch_duration_min||60}" min="0" max="180" style="background:#0D1117;border:1px solid #30363D;color:#fff;padding:4px;border-radius:3px;font-size:12px;width:90%"></label>
          <label style="color:#888">Cap. diária<br><input id="cfg-tdc-${t.id}" type="number" value="${t.daily_capacity||8}" min="1" max="20" style="background:#0D1117;border:1px solid #30363D;color:#fff;padding:4px;border-radius:3px;font-size:12px;width:90%"></label>
        </div>
        <div style="background:#0D1117;border:1px solid #21262D;border-top:0;border-radius:0 0 6px 6px;padding:8px 12px;margin-bottom:6px;font-size:11px">
          <div style="color:#888;margin-bottom:5px">Dias úteis</div>
          <div style="display:flex;gap:8px;flex-wrap:wrap" id="cfg-wd-${t.id}-wrap">
            ${['Seg','Ter','Qua','Qui','Sex','Sab','Dom'].map((d, idx) => {
              const checked = ((t.work_days_mask||31) >> idx) & 1;
              return `<label style="color:${idx>=5?'#fbbf24':'#cbd5e1'};display:flex;align-items:center;gap:3px;cursor:pointer;padding:3px 8px;background:${checked?'#1f6feb':'#21262D'};border-radius:4px;font-weight:700">
                <input type="checkbox" data-tech="${t.id}" data-dow="${idx}" ${checked?'checked':''} onchange="cfgWdToggle(${t.id},${idx},this.checked)" style="cursor:pointer">${d}
              </label>`;
            }).join('')}
          </div>
        </div>
      `).join('')}
    `;
  } catch (e) {
    document.getElementById('cfg-tech-list').innerHTML = `<div style="color:#f87171;padding:14px">${e.message}</div>`;
  }
}

function cfgWdToggle(techId, dow, checked) {
  // Toggle visual imediato
  const lbl = document.querySelector(`#cfg-wd-${techId}-wrap input[data-dow="${dow}"]`)?.parentElement;
  if (lbl) lbl.style.background = checked ? '#1f6feb' : '#21262D';
}

function cfgWdCollectMask(techId) {
  const wrap = document.getElementById(`cfg-wd-${techId}-wrap`);
  if (!wrap) return null;
  let mask = 0;
  wrap.querySelectorAll('input[type=checkbox]').forEach(cb => {
    if (cb.checked) mask |= (1 << parseInt(cb.dataset.dow));
  });
  return mask;
}

async function cfgTechSave(id) {
  const t = CFG.technicians.find(x => x.id === id);
  if (!t) return;
  const phone = document.getElementById(`cfg-tp-${id}`).value.trim();
  const skillsRaw = document.getElementById(`cfg-ts-${id}`).value;
  const skills = skillsRaw.split(',').map(s => s.trim()).filter(Boolean);
  const body = { phone, skills, active: t.active };
  const ws = document.getElementById(`cfg-tws-${id}`)?.value;
  const we = document.getElementById(`cfg-twe-${id}`)?.value;
  const ls = document.getElementById(`cfg-tls-${id}`)?.value;
  const ld = parseInt(document.getElementById(`cfg-tld-${id}`)?.value);
  const dc = parseInt(document.getElementById(`cfg-tdc-${id}`)?.value);
  const mask = cfgWdCollectMask(id);
  if (ws) body.work_start_time = ws;
  if (we) body.work_end_time = we;
  if (ls) body.lunch_start_time = ls;
  if (!isNaN(ld)) body.lunch_duration_min = ld;
  if (!isNaN(dc)) body.daily_capacity = dc;
  if (mask !== null) body.work_days_mask = mask;
  try {
    await _api(`/operacional/api/technicians/${id}`, { method:'PATCH', body });
    const days = ['Seg','Ter','Qua','Qui','Sex','Sab','Dom'].filter((_,i) => (mask >> i) & 1).join('/');
    alert(`✓ ${t.name} atualizado\n• Jornada ${ws}-${we}\n• Almoço ${ls} (+${ld}min)\n• Cap. ${dc}\n• Dias: ${days || 'NENHUM!'}`);
    loadTechnicians();
  } catch (e) { alert(e.message); }
}

async function cfgTechToggle(id) {
  const t = CFG.technicians.find(x => x.id === id);
  if (!t) return;
  try {
    await _api(`/operacional/api/technicians/${id}`, { method:'PATCH', body:{ active: !t.active } });
    loadTechnicians();
  } catch (e) { alert(e.message); }
}

async function cfgTechSync() {
  if (!confirm('Forçar sync de técnicos com Auvo agora?')) return;
  try {
    await _api('/operacional/api/internal/auvo/sync', { method:'POST' });
    alert('Sync disparado ✓');
    loadTechnicians();
  } catch (e) { alert(e.message); }
}

// Patch helper pra technicians (PATCH não está direto em ops.js)
// Reusa proxy /operacional/api/technicians/:id que já existe — precisa ser PATCH
// Mas o handler é apenas GET — usar /api/ops/internal/technicians/{id} se existir
// Para evitar quebrar, mantenho PATCH simples via fetch direto (server.js precisa expor)

loadStages();
</script>

<% const activePage = 'admin'; const pageTitle = 'Administração'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
.adm-wrap{max-width:1200px;margin:0 auto;padding:24px}
.adm-tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:24px}
.adm-tab{padding:12px 24px;background:none;border:none;color:var(--text-muted);font-size:13px;font-weight:700;cursor:pointer;border-bottom:3px solid transparent;text-transform:uppercase;letter-spacing:.5px}
.adm-tab:hover{color:#bbb}
.adm-tab.active{color:#5ba3f5;border-bottom-color:#5ba3f5}
.adm-pane{display:none}
.adm-pane.active{display:block}
.adm-card{background:#151515;border:1px solid var(--border);border-radius:10px;padding:20px;margin-bottom:16px}
.adm-card h3{margin:0 0 12px;font-size:15px;color:var(--text)}
.adm-table{width:100%;border-collapse:collapse;font-size:13px}
.adm-table th{text-align:left;padding:10px;font-size:10px;color:var(--text-muted);text-transform:uppercase;font-weight:700;border-bottom:1px solid var(--border);background:var(--bg-card)}
.adm-table td{padding:10px;border-bottom:1px solid #1a1a1a;color:var(--text)}
.adm-table tr:hover td{background:var(--bg-hover)}
.adm-input{padding:8px 10px;background:var(--bg-hover);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:13px;font-family:inherit}
.adm-input:focus{outline:none;border-color:#5ba3f5}
.adm-input.compact{padding:5px 8px;font-size:12px;width:100px}
.adm-btn{padding:6px 14px;border-radius:6px;border:1px solid;background:transparent;font-size:11px;font-weight:700;cursor:pointer;text-transform:uppercase;letter-spacing:.3px}
.adm-btn.save{color:#22c55e;border-color:#22c55e}
.adm-btn.save:hover{background:rgba(34,197,94,.1)}
.adm-btn.del{color:#ef4444;border-color:#ef4444}
.adm-btn.del:hover{background:rgba(239,68,68,.1)}
.adm-btn.add{background:#1e3a5f;color:#7cb9f5;border:1px solid #5ba3f5;padding:10px 18px;font-size:13px}
.adm-btn.add:hover{background:#2a4a72}
.role-tag{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;text-transform:uppercase}
.role-tag.admin{background:rgba(239,68,68,.2);color:#f87171}
.role-tag.closer{background:rgba(34,197,94,.2);color:#4ade80}
.role-tag.sdr{background:rgba(167,113,247,.2);color:#c084fc}
.adm-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:14px}
.adm-grid label{display:block;font-size:10px;color:var(--text-muted);text-transform:uppercase;font-weight:700;margin-bottom:4px;letter-spacing:.4px}
.toast-adm{position:fixed;bottom:24px;right:24px;background:var(--bg-hover);border:1px solid #22c55e;color:#4ade80;padding:14px 20px;border-radius:10px;font-size:13px;font-weight:700;z-index:200}
.toast-adm.err{border-color:#ef4444;color:#f87171}
</style>

<div class="adm-wrap">
  <h1 style="font-size:22px;color:var(--text);margin:0 0 6px">⚙️ Administração</h1>
  <p style="color:var(--text-muted);font-size:13px;margin:0 0 18px">Configurar usuários do portal e metas mensais por vendedor/canal.</p>

  <div class="adm-tabs">
    <button class="adm-tab active" onclick="admTab('users')">👤 Usuários</button>
    <button class="adm-tab" onclick="admTab('metas')">🎯 Metas</button>
  </div>

  <!-- USUÁRIOS -->
  <div class="adm-pane active" id="pane-users">
    <div class="adm-card">
      <h3>➕ Criar novo usuário</h3>
      <div class="adm-grid">
        <div><label>Username</label><input type="text" id="nu-username" class="adm-input" style="width:100%" placeholder="ex: gabriel.s"></div>
        <div><label>Nome</label><input type="text" id="nu-name" class="adm-input" style="width:100%" placeholder="Gabriel Silva"></div>
        <div><label>Senha</label><input type="text" id="nu-password" class="adm-input" style="width:100%" placeholder="senha123"></div>
        <div><label>Email</label><input type="email" id="nu-email" class="adm-input" style="width:100%" placeholder="gabriel@tudodefiltro.com.br"></div>
        <div><label>Role</label><select id="nu-role" class="adm-input" style="width:100%"><option value="closer">Closer</option><option value="admin">Admin</option><option value="sdr">SDR</option></select></div>
        <div><label>CRM Owner (Zoho)</label><input type="text" id="nu-crmowner" class="adm-input" style="width:100%" placeholder="Gabriel Silva"></div>
        <div><label>Time</label><select id="nu-team" class="adm-input" style="width:100%"><option value="filtro">Filtro</option><option value="poco">Poço</option><option value="bebedouro">Bebedouro</option><option value="loja">Loja</option><option value="admin">Admin</option></select></div>
        <div style="display:flex;align-items:flex-end"><button class="adm-btn add" onclick="criarUsuario()">Criar Usuário</button></div>
      </div>
    </div>

    <div class="adm-card">
      <h3>📋 Usuários atuais</h3>
      <div style="overflow-x:auto"><table class="adm-table" id="tbl-users">
        <thead><tr><th>Username</th><th>Nome</th><th>Email</th><th>Role</th><th>CRM Owner</th><th>Time</th><th>Senha</th><th>Ações</th></tr></thead>
        <tbody id="tbody-users"><tr><td colspan="8" style="text-align:center;color:var(--text-muted)">Carregando...</td></tr></tbody>
      </table></div>
    </div>
  </div>

  <!-- METAS -->
  <div class="adm-pane" id="pane-metas">
    <div class="adm-card">
      <h3>🏪 Meta da Loja Física (mensal)</h3>
      <div style="display:flex;gap:10px;align-items:center">
        <span style="color:var(--text-muted);font-size:13px">Faturamento meta:</span>
        <input type="number" id="meta-loja" class="adm-input" placeholder="80000" style="width:160px">
        <button class="adm-btn save" onclick="salvarMetaLoja()">Salvar Meta Loja</button>
        <span style="color:var(--text-muted);font-size:11px;margin-left:auto">Layout=Loja (vendas balcão)</span>
      </div>
    </div>

    <div class="adm-card">
      <h3>🔧 Meta de Refil/Elemento Filtrante (Online — mensal)</h3>
      <div style="display:flex;gap:10px;align-items:center">
        <span style="color:var(--text-muted);font-size:13px">Faturamento meta:</span>
        <input type="number" id="meta-refil" class="adm-input" placeholder="15000" style="width:160px">
        <button class="adm-btn save" onclick="salvarMetaRefil()">Salvar Meta Refil</button>
        <span style="color:var(--text-muted);font-size:11px;margin-left:auto">Pipeline="Fúnil Base" (refil/manutenção/peças online)</span>
      </div>
    </div>

    <div class="adm-card">
      <h3>👥 Metas individuais por vendedor</h3>
      <p style="color:var(--text-muted);font-size:12px;margin:0 0 12px">Edite vendas/mês e faturamento/mês de cada um. As metas são usadas em toda a Torre de Comando, Score 80/20, Projeção de Meta etc.</p>
      <div style="overflow-x:auto"><table class="adm-table" id="tbl-metas">
        <thead><tr><th>Nome</th><th>Time</th><th>CRM Owner</th><th>Meta Vendas/mês</th><th>Meta Faturamento/mês</th><th>Ações</th></tr></thead>
        <tbody id="tbody-metas"><tr><td colspan="6" style="text-align:center;color:var(--text-muted)">Carregando...</td></tr></tbody>
      </table></div>
    </div>

    <div class="adm-card" style="background:rgba(91,163,245,.05);border-color:#1e3a5f">
      <h3 style="color:#7cb9f5">📊 Resumo por time</h3>
      <div id="resumo-team"></div>
    </div>
  </div>
</div>

<script>
function admTab(name){
  document.querySelectorAll('.adm-tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.adm-pane').forEach(p => p.classList.remove('active'));
  // Acha botão correspondente (mais robusto que event.target)
  const btn = Array.from(document.querySelectorAll('.adm-tab')).find(t => t.getAttribute('onclick')?.includes(`'${name}'`));
  if (btn) btn.classList.add('active');
  document.getElementById('pane-'+name).classList.add('active');
  if (name === 'metas') loadMetas();
}
// Auto-abrir aba via ?tab=
(function(){
  const params = new URLSearchParams(location.search);
  const tab = params.get('tab');
  if (tab) {
    document.addEventListener('DOMContentLoaded', () => admTab(tab));
  }
})();

function tAdm(msg, isErr){
  const t = document.createElement('div');
  t.className = 'toast-adm' + (isErr?' err':'');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(()=>t.remove(), 3500);
}

// === USUÁRIOS ===
async function loadUsuarios(){
  try{
    const res = await fetch('/gestao/usuarios');
    const d = await res.json();
    if (d.error) { tAdm('Erro: '+d.error, true); return; }
    const tbody = document.getElementById('tbody-users');
    tbody.innerHTML = d.usuarios.map(u => `
      <tr id="u-${u.username}">
        <td><strong>${u.username}</strong></td>
        <td><input type="text" class="adm-input compact" value="${u.name||''}" id="u-${u.username}-name" style="width:140px"></td>
        <td><input type="email" class="adm-input compact" value="${u.email||''}" id="u-${u.username}-email" style="width:200px"></td>
        <td>
          <select class="adm-input compact" id="u-${u.username}-role" style="width:100px">
            <option value="closer" ${u.role==='closer'?'selected':''}>Closer</option>
            <option value="admin" ${u.role==='admin'?'selected':''}>Admin</option>
            <option value="sdr" ${u.role==='sdr'?'selected':''}>SDR</option>
          </select>
        </td>
        <td><input type="text" class="adm-input compact" value="${u.crmOwner||''}" id="u-${u.username}-crm" style="width:160px"></td>
        <td>
          <select class="adm-input compact" id="u-${u.username}-team" style="width:110px">
            <option value="filtro" ${u.team==='filtro'?'selected':''}>Filtro</option>
            <option value="poco" ${u.team==='poco'?'selected':''}>Poço</option>
            <option value="bebedouro" ${u.team==='bebedouro'?'selected':''}>Bebedouro</option>
            <option value="loja" ${u.team==='loja'?'selected':''}>Loja</option>
            <option value="admin" ${u.team==='admin'?'selected':''}>Admin</option>
          </select>
        </td>
        <td><input type="text" class="adm-input compact" placeholder="nova senha" id="u-${u.username}-pass" style="width:110px"></td>
        <td>
          <button class="adm-btn save" onclick="salvarUsuario('${u.username}')">💾 Salvar</button>
          <button class="adm-btn del" onclick="deletarUsuario('${u.username}')">🗑️</button>
        </td>
      </tr>
    `).join('');
  }catch(e){ tAdm('Erro: '+e.message, true); }
}

async function criarUsuario(){
  const body = {
    username: document.getElementById('nu-username').value.trim(),
    name: document.getElementById('nu-name').value.trim(),
    password: document.getElementById('nu-password').value.trim(),
    email: document.getElementById('nu-email').value.trim(),
    role: document.getElementById('nu-role').value,
    crmOwner: document.getElementById('nu-crmowner').value.trim() || document.getElementById('nu-name').value.trim(),
    team: document.getElementById('nu-team').value,
  };
  if (!body.username || !body.name || !body.password) {
    tAdm('Username, nome e senha obrigatórios', true); return;
  }
  try{
    const res = await fetch('/gestao/usuarios', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const r = await res.json();
    if (r.error) { tAdm('Erro: '+r.error, true); return; }
    tAdm('✅ Usuário '+body.username+' criado');
    ['username','name','password','email','crmowner'].forEach(id => document.getElementById('nu-'+id).value = '');
    loadUsuarios();
  }catch(e){ tAdm('Erro: '+e.message, true); }
}

async function salvarUsuario(username){
  const body = {
    name: document.getElementById(`u-${username}-name`).value,
    email: document.getElementById(`u-${username}-email`).value,
    role: document.getElementById(`u-${username}-role`).value,
    crmOwner: document.getElementById(`u-${username}-crm`).value,
    team: document.getElementById(`u-${username}-team`).value,
  };
  const novaSenha = document.getElementById(`u-${username}-pass`).value;
  if (novaSenha) body.password = novaSenha;
  try{
    const res = await fetch('/gestao/usuarios/'+encodeURIComponent(username), {
      method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
    });
    const r = await res.json();
    if (r.error) { tAdm('Erro: '+r.error, true); return; }
    tAdm('✅ '+username+' atualizado');
    document.getElementById(`u-${username}-pass`).value = '';
  }catch(e){ tAdm('Erro: '+e.message, true); }
}

async function deletarUsuario(username){
  if (!confirm(`Deletar usuário ${username}?`)) return;
  try{
    const res = await fetch('/gestao/usuarios/'+encodeURIComponent(username), { method:'DELETE' });
    const r = await res.json();
    if (r.error) { tAdm('Erro: '+r.error, true); return; }
    tAdm('🗑️ '+username+' deletado');
    loadUsuarios();
  }catch(e){ tAdm('Erro: '+e.message, true); }
}

// === METAS ===
async function loadMetas(){
  try{
    const res = await fetch('/gestao/metas');
    const d = await res.json();
    if (d.error) { tAdm('Erro: '+d.error, true); return; }

    document.getElementById('meta-loja').value = d.metaLoja?.faturamento || 0;
    if (document.getElementById('meta-refil')) document.getElementById('meta-refil').value = d.metaRefil?.faturamento || 0;

    const tbody = document.getElementById('tbody-metas');
    tbody.innerHTML = d.closers.map(c => `
      <tr>
        <td><strong>${c.name}</strong></td>
        <td><span style="color:#888;font-size:11px;text-transform:uppercase">${c.team||'-'}</span></td>
        <td style="color:#aaa;font-size:11px">${c.crmOwner}</td>
        <td><input type="number" class="adm-input compact" id="m-${c.username}-vendas" value="${c.meta.vendas||0}" style="width:90px"></td>
        <td><input type="number" class="adm-input compact" id="m-${c.username}-fat" value="${c.meta.faturamento||0}" style="width:140px" placeholder="R$"></td>
        <td><button class="adm-btn save" onclick="salvarMeta('${c.username}','${c.crmOwner.replace(/'/g,"\\'")}')">💾 Salvar</button></td>
      </tr>
    `).join('');

    // Resumo por time
    const porTime = {};
    for (const c of d.closers) {
      const t = c.team || 'outros';
      if (!porTime[t]) porTime[t] = { count:0, vendas:0, faturamento:0 };
      porTime[t].count++;
      porTime[t].vendas += c.meta.vendas || 0;
      porTime[t].faturamento += c.meta.faturamento || 0;
    }
    porTime.loja = porTime.loja || { count:0, vendas:0, faturamento:0 };
    porTime.loja.faturamento += d.metaLoja?.faturamento || 0;

    document.getElementById('resumo-team').innerHTML = Object.entries(porTime).map(([t,v]) =>
      `<div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid #222;font-size:13px">
        <span style="text-transform:uppercase;color:#7cb9f5;font-weight:700;width:120px">${t}</span>
        <span>${v.count} pessoa(s)</span>
        <span style="margin-left:auto">📊 ${v.vendas} vendas/mês</span>
        <span style="font-weight:700;color:#fff">💰 R$ ${(v.faturamento/1000).toFixed(0)}k</span>
      </div>`
    ).join('');
  }catch(e){ tAdm('Erro: '+e.message, true); }
}

async function salvarMeta(username, crmOwner){
  const vendas = parseInt(document.getElementById('m-'+username+'-vendas').value) || 0;
  const faturamento = parseInt(document.getElementById('m-'+username+'-fat').value) || 0;
  try{
    const res = await fetch('/gestao/metas', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ crmOwner, vendas, faturamento })
    });
    const r = await res.json();
    if (r.error) { tAdm('Erro: '+r.error, true); return; }
    tAdm('✅ Meta '+username+' salva (R$ '+faturamento.toLocaleString('pt-BR')+'/mês)');
    loadMetas(); // refresh resumo
  }catch(e){ tAdm('Erro: '+e.message, true); }
}

async function salvarMetaLoja(){
  const _loja = parseInt(document.getElementById('meta-loja').value) || 0;
  try{
    const res = await fetch('/gestao/metas', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ _loja })
    });
    const r = await res.json();
    if (r.error) { tAdm('Erro: '+r.error, true); return; }
    tAdm('✅ Meta da Loja salva: R$ '+_loja.toLocaleString('pt-BR')+'/mês');
    loadMetas();
  }catch(e){ tAdm('Erro: '+e.message, true); }
}

async function salvarMetaRefil(){
  const _refil = parseInt(document.getElementById('meta-refil').value) || 0;
  try{
    const res = await fetch('/gestao/metas', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ _refil })
    });
    const r = await res.json();
    if (r.error) { tAdm('Erro: '+r.error, true); return; }
    tAdm('✅ Meta de Refil salva: R$ '+_refil.toLocaleString('pt-BR')+'/mês');
    loadMetas();
  }catch(e){ tAdm('Erro: '+e.message, true); }
}

loadUsuarios();
</script>

</div></body></html>

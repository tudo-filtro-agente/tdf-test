<% const activePage = 'coins'; const pageTitle = 'TDF Coins'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<div class="container" style="max-width:680px;margin:60px auto;padding:0 20px">
  <div style="background:linear-gradient(135deg,#2d2513 0%,#1a0e2a 100%);border:2px solid #F0C040;border-radius:24px;padding:48px 32px;text-align:center;box-shadow:0 10px 40px rgba(240,192,64,.15)">
    <div style="font-size:80px;margin-bottom:14px;animation:coinSpin 3s ease-in-out infinite">🪙</div>
    <h1 style="font-size:2rem;color:#F0C040;margin:0 0 12px;font-weight:800">TDF Coins</h1>
    <div style="background:#ef4444;color:#fff;display:inline-block;padding:6px 18px;border-radius:20px;font-size:13px;font-weight:800;letter-spacing:1px;margin-bottom:20px;animation:coinPulse 2s infinite">EM BREVE</div>

    <p style="font-size:1.05rem;color:var(--text);line-height:1.6;margin:14px 0">
      A área de <strong style="color:#F0C040">TDF Coins</strong> está em construção e será liberada em breve.
    </p>
    <p style="font-size:0.95rem;color:var(--text-muted);line-height:1.6;margin:14px 0">
      Você vai poder ganhar coins por cada venda fechada e trocar por <strong>prêmios reais</strong>:
      jantares premium, smartwatch, PS5, viagens, moto Honda Lead 0km e muito mais.
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:24px 0">
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px"><div style="font-size:24px;margin-bottom:6px">🍽️</div><div style="font-size:11px;color:var(--text-muted);font-weight:700">Almoço</div></div>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px"><div style="font-size:24px;margin-bottom:6px">🥂</div><div style="font-size:11px;color:var(--text-muted);font-weight:700">Jantar Premium</div></div>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px"><div style="font-size:24px;margin-bottom:6px">⌚</div><div style="font-size:11px;color:var(--text-muted);font-weight:700">Smartwatch</div></div>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px"><div style="font-size:24px;margin-bottom:6px">📺</div><div style="font-size:11px;color:var(--text-muted);font-weight:700">TV 50"</div></div>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px"><div style="font-size:24px;margin-bottom:6px">🎮</div><div style="font-size:11px;color:var(--text-muted);font-weight:700">PlayStation 5</div></div>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px"><div style="font-size:24px;margin-bottom:6px">🚢</div><div style="font-size:11px;color:var(--text-muted);font-weight:700">Cruzeiro</div></div>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px;border-color:#F0C040"><div style="font-size:24px;margin-bottom:6px">🏍️</div><div style="font-size:11px;color:#F0C040;font-weight:700">Moto Honda Lead</div></div>
    </div>

    <div style="background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px;margin-top:24px;text-align:left">
      <div style="font-size:12px;color:#F0C040;text-transform:uppercase;font-weight:800;letter-spacing:.5px;margin-bottom:8px">⚡ Enquanto isso...</div>
      <div style="font-size:13px;color:var(--text);line-height:1.7">
        Continue vendendo e batendo metas — todas as vendas que você fechar agora vão acumular coins quando a área for liberada. Nenhuma venda fica para trás.
      </div>
    </div>

    <a href="/cockpit" style="display:inline-block;margin-top:24px;background:#F0C040;color:#000;border:none;padding:12px 28px;border-radius:10px;font-size:14px;font-weight:800;text-decoration:none;cursor:pointer">Ir pro Meu Painel</a>
  </div>
</div>

<style>
@keyframes coinSpin { 0%,100%{transform:rotateY(0deg)} 50%{transform:rotateY(360deg)} }
@keyframes coinPulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.7;transform:scale(1.05)} }
</style>

</div></body></html>

async function cmpPreview(){
  const fase = document.getElementById('cmp-fase').value;
  document.getElementById('cmp-status').textContent = 'Buscando candidatos...';
  document.getElementById('cmp-resultado').innerHTML = '<div style="color:#888;text-align:center;padding:20px">Carregando...</div>';
  document.getElementById('cmp-acoes').style.display = 'none';
  document.getElementById('cmp-fases-resumo').style.display = 'none';
  try {
    const url = '/manutencao/automacao/preview' + (fase?'?fase='+encodeURIComponent(fase):'');
    const r = await fetch(url);
    const d = await r.json();
    if (d.error) { document.getElementById('cmp-resultado').innerHTML = `<div style="color:#ef4444">Erro: ${d.error}</div>`; return; }
    _CANDIDATOS_PREVIEW = d.candidatos || [];
    document.getElementById('cmp-status').textContent = `${d.total} candidatos`;

    // Resumo por fase (quando "todas")
    if (!fase && d.porFase) {
      const fasesUI = document.getElementById('cmp-fases-resumo');
      fasesUI.style.display = 'grid';
      fasesUI.innerHTML = Object.values(d.porFase).map(f => {
        const cor = f.fase.tipo==='recuperacao'||f.fase.tipo==='ultimo_aviso'?'#ef4444' : f.fase.tipo==='vencimento'?'#f97316' : f.fase.tipo==='aviso_proximo'?'#fbbf24' : '#5ba3f5';
        return `<div onclick="document.getElementById('cmp-fase').value='${f.fase.id}';cmpPreview()" style="background:#101010;border:1px solid ${cor};border-left:4px solid ${cor};border-radius:8px;padding:10px;cursor:pointer">
          <div style="font-size:10px;color:${cor};font-weight:700;text-transform:uppercase">${f.fase.label}</div>
          <div style="font-size:18px;font-weight:800;color:#fff">${f.items.length}</div>
          <div style="font-size:10px;color:#888">${f.fase.canais.join('+')}</div>
        </div>`;
      }).join('');

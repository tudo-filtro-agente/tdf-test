function renderKanban(){
  if (!_MT || !_ETAPAS.length) return;
  const list = clientesFiltrados();
  const board = document.getElementById('kanban-board');
  // Agrupa por etapa
  const porEtapa = {};
  _ETAPAS.forEach(e => porEtapa[e.id] = []);
  for (const c of list) {
    const et = c.etapa || 'base_sem_contato';
    if (!porEtapa[et]) porEtapa[et] = [];
    porEtapa[et].push(c);
  }
  // Sort: leads com msg WATI nova vão pro TOPO de cada coluna
  const watiNovos = window._WATI_NOVOS || {};
  Object.keys(porEtapa).forEach(et => {
    porEtapa[et].sort((a,b) => {
      const aNovo = watiNovos[a.id] ? 1 : 0;
      const bNovo = watiNovos[b.id] ? 1 : 0;
      if (aNovo !== bNovo) return bNovo - aNovo;
      // Se ambos têm msg, mais recente primeiro
      if (aNovo && bNovo) return (watiNovos[b.id].ts||0) - (watiNovos[a.id].ts||0);
      // Senão, prioridade alta primeiro
      const ord = { alta:0, media:1, baixa:2 };
      return (ord[a.prioridade]??9) - (ord[b.prioridade]??9);
    });
  });
  // LAZY LOAD: render inicial 25 cards, scroll na coluna carrega +25
  if (!window._KB_VISIVEL) window._KB_VISIVEL = {}; // por etapa: quantos visíveis
  board.innerHTML = _ETAPAS.map(e => {
    const todos = (porEtapa[e.id] || []);
    const limite = window._KB_VISIVEL[e.id] || 25;
    const cards = todos.slice(0, limite);
    const total = todos.length;
    // Soma de valor em aberto da etapa = soma do total da proposta (se houver) OU ticketEstimado
    const valorEtapa = todos.reduce((s, c) => s + (c.proposta?.total || c.ticketEstimado || 0), 0);
    const valorFmt = valorEtapa >= 1000000 ? 'R$ '+(valorEtapa/1000000).toFixed(1)+'M'
                  : valorEtapa >= 1000 ? 'R$ '+(valorEtapa/1000).toFixed(0)+'k'
                  : 'R$ '+Math.round(valorEtapa);
    return `
      <div class="kb-col" data-etapa="${e.id}">
        <div class="kb-col-head" style="border-bottom-color:${e.cor}">
          <span class="ic">${e.icon}</span>
          <span class="lbl" style="color:${e.cor}">${e.label}</span>
          <span class="badge">${total}</span>
        </div>
        <div style="padding:6px 12px;border-bottom:1px solid #1a1a1a;background:#0d0d0d;font-size:10px;display:flex;justify-content:space-between;align-items:center">
          <span style="color:#888">💰 em aberto</span>
          <span style="color:${e.cor};font-weight:800;font-size:11px">${valorFmt}</span>
        </div>
        <div class="kb-col-body" data-etapa="${e.id}" onscroll="kbAutoLoad(event,'${e.id}',${total})" ondragover="kbDragOver(event)" ondragleave="kbDragLeave(event)" ondrop="kbDrop(event)">
          ${cards.map(c => kbCard(c)).join('')}
          ${total > limite ? `<div style="text-align:center;color:#888;font-size:10px;padding:10px;background:#0a0a0a;border-radius:5px;margin:4px 6px;border:1px dashed #333">⌄ Role pra carregar mais (${total - limite} restantes)</div>`:''}
          ${total > 200 ? `<div style="text-align:center;color:#666;font-size:9px;padding:4px">— máximo 200 por coluna · use filtros —</div>`:''}
        </div>
      </div>
    `;
  }).join('');
}

function kbCard(c){
  const op = c.operadora ? (_MT.operadoras.find(o => o.username === c.operadora)?.name || c.operadora) : null;
  const opIcon = '<span class="op '+(op?'':'sem')+'">'+(op?'👤 '+op:'sem operadora')+'</span>';
  const dias = c.diasParaVencer < 0 ? `<span style="color:#ef4444;font-weight:700">⚠️ ${Math.abs(c.diasParaVencer)}d vencido</span>` : `<span style="color:#888">${c.diasParaVencer}d</span>`;
  const pri = c.prioridade || 'baixa';
  const watiNovo = (window._WATI_NOVOS||{})[c.id];
  const cls = `kb-card ${pri}${watiNovo?' wati-novo':''}`;
  const badge = watiNovo ? `<span class="wati-badge">💬 ${watiNovo.count||1}</span>` : '';
  return `<div class="${cls}" draggable="true" data-id="${c.id}" ondragstart="kbDragStart(event,'${c.id}')" ondragend="kbDragEnd(event)" onclick="kbCardClick(event,'${c.id}')">
    ${badge}
    <div class="nome">
      <span class="pri-${pri}" title="prioridade ${pri}">${pri==='alta'?'🔴':pri==='media'?'🟡':'⚪'}</span>
      ${c.nome}
    </div>
    <div class="meta">
      ${CAT_ICONS[c.categoria]||'📦'} ${c.categoriaLabel}<br>
      ${dias}${c.cidade?` · 📍 ${c.cidade}`:''}
      ${watiNovo?`<br><span style="color:#25D366;font-weight:700;font-size:10px">"${(watiNovo.text||'').slice(0,50)}${(watiNovo.text||'').length>50?'...':''}"</span>`:''}
    </div>
    <div class="footer">
      ${opIcon}
      <span class="vlr">${fmt(c.ticketEstimado)}</span>
    </div>
  </div>`;
}

let _DRAG_DEAL_ID = null;
let _DRAG_MOVED_TO_NEW_COL = false;
function kbDragStart(ev, id){
  _DRAG_DEAL_ID = id;
  _DRAG_MOVED_TO_NEW_COL = false;
  ev.dataTransfer.setData('text/plain', id);
  ev.dataTransfer.effectAllowed = 'move';
  const card = ev.target.closest('.kb-card');
  if (card) card.classList.add('dragging');
}
function kbDragEnd(ev){
  const card = ev.target.closest('.kb-card');
  if (card) card.classList.remove('dragging');
  document.querySelectorAll('.kb-col-body').forEach(b => b.classList.remove('dragover'));
  const id = _DRAG_DEAL_ID;
  const moved = _DRAG_MOVED_TO_NEW_COL;
  _DRAG_DEAL_ID = null;
  _DRAG_MOVED_TO_NEW_COL = false;
  // dragstart dispara em qualquer movimento e o navegador suprime o click;
  // se o drag terminou SEM mudar de coluna, tratamos como click → abre drawer.
  if (!moved && id) abrirDrawer(id);
}
function kbCardClick(ev, id){
  // se um drag estiver em curso, ignora — dragend cuida
  if (_DRAG_DEAL_ID) return;
  abrirDrawer(id);
}
// Lazy load: scroll na coluna chega perto do fim → carrega +25
function kbAutoLoad(ev, etapaId, total){
  const el = ev.target;
  if (el.scrollTop + el.clientHeight >= el.scrollHeight - 80) {
    const atual = window._KB_VISIVEL[etapaId] || 25;
    if (atual >= total || atual >= 200) return; // já tem tudo ou bateu cap
    window._KB_VISIVEL[etapaId] = Math.min(atual + 25, total, 200);
    renderKanban(); // re-render só da coluna seria melhor, mas re-render geral é ok
  }
}

function kbDragOver(ev){
  ev.preventDefault();
  ev.currentTarget.classList.add('dragover');
}
function kbDragLeave(ev){
  ev.currentTarget.classList.remove('dragover');
}
async function kbDrop(ev){
  ev.preventDefault();
  ev.currentTarget.classList.remove('dragover');
  const novaEtapa = ev.currentTarget.dataset.etapa;
  if (!_DRAG_DEAL_ID || !novaEtapa) return;
  const cliente = _MT.clientes.find(c => c.id === _DRAG_DEAL_ID);
  if (!cliente) return;
  if (cliente.etapa === novaEtapa) return;

  // marca antes da chamada async pra dragend saber que houve mudança de coluna
  _DRAG_MOVED_TO_NEW_COL = true;

  let payload = { etapa: novaEtapa };
  // Se for finalizado_perdido, pede motivo
  if (novaEtapa === 'finalizado_perdido') {
    const motivo = prompt('Motivo da perda?\n\n' + (window._MOTIVOS_PERDA||[]).map((m,i) => `${i+1}. ${m}`).join('\n') + '\n\nDigite o número OU escreva o motivo:');
    if (!motivo) return;
    const idx = parseInt(motivo) - 1;
    payload.motivoPerda = (window._MOTIVOS_PERDA && window._MOTIVOS_PERDA[idx]) || motivo;
  }
  // Se for "agendado" e ainda não tem OS Auvo → pergunta se cria automática
  if (novaEtapa === 'agendado' && !cliente.auvoTaskId) {
    const querOs = confirm(`Movido pra "Agendado". Criar OS no Auvo agora?\n\nOK = abre formulário com data/técnico/tipo\nCancel = só muda etapa, sem OS`);
    if (querOs) {
      // Move etapa primeiro (sem auto-os), depois abre o modal
      try {
        const res = await fetch('/manutencao/etapa/' + encodeURIComponent(_DRAG_DEAL_ID), {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)
        });
        const r = await res.json();
        if (r.error) { alert('Erro: '+r.error); return; }
        cliente.etapa = novaEtapa;
        renderKanban(); renderTabela();
        criarOsAuvo(_DRAG_DEAL_ID);
      } catch(e) { alert('Erro: '+e.message); }
      return;
    }
  }
  try {
    const res = await fetch('/manutencao/etapa/' + encodeURIComponent(_DRAG_DEAL_ID), {
      method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload)
    });
    const r = await res.json();
    if (r.error) { alert('Erro: '+r.error); return; }
    cliente.etapa = novaEtapa;
    if (payload.motivoPerda) cliente.motivoPerda = payload.motivoPerda;
    renderKanban();
    renderTabela();
  } catch(e) { alert('Erro: '+e.message); }
}

function toggleAll(checked){
  if (checked) clientesFiltrados().forEach(c => _SELECIONADOS.add(c.id));
  else _SELECIONADOS.clear();
  atualizarBulk();
  renderTabela();
}
function toggleSel(id, el){
  if (_SELECIONADOS.has(id)) _SELECIONADOS.delete(id);
  else _SELECIONADOS.add(id);
  atualizarBulk();
  el.closest('tr').classList.toggle('selected');
}
function limparSelecao(){ _SELECIONADOS.clear(); atualizarBulk(); renderTabela(); }

// 14/Mai/2026: seleção em lote — Paulo quer disparar pra N clientes por vez (ex: 70 a 70)
function selecionarPrimeirosN() {
  const input = document.getElementById('mt-batch-n');
  const n = parseInt(input.value, 10);
  if (!n || n < 1) { alert('Digite uma quantidade válida (ex: 70)'); input.focus(); return; }
  _SELECIONADOS.clear();
  const lista = clientesFiltrados();
  if (!lista.length) { alert('Nenhum cliente visível com filtros atuais.'); return; }
  const alvo = lista.slice(0, n);
  alvo.forEach(c => _SELECIONADOS.add(c.id));
  atualizarBulk(); renderTabela();
  // Scroll suave pro topo da tabela pra ver os selecionados
  document.querySelector('.mt-tbl')?.scrollIntoView({behavior:'smooth', block:'start'});
  if (alvo.length < n) {
    console.log(`[lote] pediu ${n} mas só tem ${alvo.length} visíveis após filtros`);
  }
}

function selecionarProximosN() {
  const input = document.getElementById('mt-batch-n');
  const n = parseInt(input.value, 10);
  if (!n || n < 1) { alert('Digite uma quantidade válida (ex: 70)'); input.focus(); return; }
  const lista = clientesFiltrados();
  if (!lista.length) { alert('Nenhum cliente visível com filtros atuais.'); return; }
  // Pega APENAS os ainda NÃO selecionados, na ordem visível
  const naoSelecionados = lista.filter(c => !_SELECIONADOS.has(c.id));
  if (!naoSelecionados.length) { alert('Todos os clientes visíveis já foram selecionados. Use "Limpar" pra começar de novo.'); return; }
  const alvo = naoSelecionados.slice(0, n);
  alvo.forEach(c => _SELECIONADOS.add(c.id));
  atualizarBulk(); renderTabela();
  if (alvo.length < n) {
    console.log(`[lote] pediu ${n} novos mas só ${alvo.length} ainda disponíveis`);
  }
}
function atualizarBulk(){
  const n = _SELECIONADOS.size;
  const bulk = document.getElementById('mt-bulk');
  bulk.classList.toggle('active', n > 0);
  document.getElementById('mt-bulk-count').textContent = n;
}

async function distribuirSelecionados(modo){
  if (!_SELECIONADOS.size) return;
  const dealIds = [...(_SELECIONADOS)];
  if (modo === 'manual') {
    const op = document.getElementById('mt-bulk-op').value;
    if (!op) { alert('Selecione uma operadora'); return; }
    if (!confirm(`Atribuir ${dealIds.length} clientes para esta operadora?`)) return;
    const body = { dealIds, operadora: op };
    const res = await fetch('/manutencao/distribuir', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
    const r = await res.json();
    if (r.error) { alert('Erro: '+r.error); return; }
    alert(`✅ ${r.atribuidos} clientes atribuídos`);
    limparSelecao();
    carregar();
    return;
  }
  // Equilibrado — 14/Mai/2026: Paulo pediu pra escolher quais operadoras participam
  abrirModalDistribuir(dealIds);
}

function abrirModalDistribuir(dealIds) {
  let ops = _MT.operadoras || [];
  // Gestor (não admin) distribui só entre operadores do MESMO time
  if (window.IS_GESTOR && !window.IS_ADMIN && window.USER_TEAM) {
    ops = ops.filter(o => o.team === window.USER_TEAM);

<% const activePage = 'manutencao'; const pageTitle = 'CRM Closy'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
.mt-wrap{max-width:1500px;margin:0 auto;padding:18px 24px 80px}
.mt-h{font-size:22px;color:var(--text);margin:0 0 4px;font-weight:800;display:flex;align-items:center;gap:10px}
.mt-sub{color:var(--text-muted);font-size:13px;margin:0 0 18px}
.mt-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:10px;margin-bottom:18px}
.mt-card{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:14px;cursor:pointer;transition:all .15s}
.mt-card:hover{border-color:#5ba3f5;transform:translateY(-1px)}
.mt-card.red{border-color:#ef4444;background:linear-gradient(135deg,rgba(239,68,68,.1),var(--bg-card))}
.mt-card.yellow{border-color:#eab308;background:linear-gradient(135deg,rgba(234,179,8,.08),var(--bg-card))}
.mt-card.green{border-color:#22c55e}
.mt-card.purple{border-color:#a371f7}
.mt-card .l{font-size:11px;color:var(--text-muted);text-transform:uppercase;font-weight:700;letter-spacing:.4px}
.mt-card .v{font-size:24px;font-weight:800;color:var(--text);line-height:1.1;margin:4px 0 2px}
.mt-card .v.red{color:#f87171}.mt-card .v.yellow{color:#fbbf24}.mt-card .v.green{color:#4ade80}.mt-card .v.purple{color:#c084fc}
.mt-card .s{font-size:11px;color:var(--text-muted)}

.mt-cats{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;padding:12px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px}
.mt-cat{padding:8px 14px;background:var(--bg-hover);border:1px solid var(--border);border-radius:8px;cursor:pointer;font-size:12px;font-weight:700;color:var(--text-muted);display:flex;align-items:center;gap:6px}
.mt-cat.active{background:#1e3a5f;border-color:#5ba3f5;color:#7cb9f5}
.mt-cat .badge{background:var(--bg-hover);color:var(--text);padding:1px 7px;border-radius:10px;font-size:10px}
.mt-cat.active .badge{background:#5ba3f5;color:#000}

.mt-filters{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:8px;margin-bottom:14px;padding:12px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px}
.mt-filters input,.mt-filters select{width:100%;padding:7px 10px;background:var(--bg-hover);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:12px}

.mt-bulk{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;padding:10px 14px;background:#1e3a5f;border:1px solid #5ba3f5;border-radius:8px;display:none}
.mt-bulk.active{display:flex}
.mt-bulk select,.mt-bulk button{padding:7px 12px;background:var(--bg-hover);color:var(--text);border:1px solid var(--border);border-radius:6px;font-size:12px;font-weight:700;cursor:pointer}
.mt-bulk button.purple{background:#4c1d95;color:#c084fc;border-color:#a371f7}
.mt-bulk button.success{background:#0d2818;color:#4ade80;border-color:#22c55e}

.mt-tbl{width:100%;border-collapse:collapse;font-size:12px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;overflow:hidden}
.mt-tbl th{text-align:left;padding:10px 8px;font-size:10px;color:var(--text-muted);text-transform:uppercase;font-weight:700;letter-spacing:.4px;border-bottom:1px solid var(--border);background:var(--bg-card)}
.mt-tbl td{padding:9px 8px;border-bottom:1px solid #1a1a1a;color:var(--text)}
.mt-tbl tr:hover td{background:var(--bg-hover);cursor:pointer}
.mt-tbl tr.selected td{background:rgba(91,163,245,.08)}
.mt-tbl input[type=checkbox]{cursor:pointer}
.mt-pill{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;text-transform:uppercase}
.mt-pill.vencido_90{background:rgba(127,29,29,.4);color:#fca5a5}
.mt-pill.vencido_60{background:rgba(239,68,68,.2);color:#f87171}
.mt-pill.vencido_30{background:rgba(239,68,68,.15);color:#f87171}
.mt-pill.vencido{background:rgba(249,115,22,.18);color:#fb923c}
.mt-pill.vence_30{background:rgba(234,179,8,.18);color:#fbbf24}
.mt-pill.vence_60{background:rgba(91,163,245,.18);color:#7cb9f5}
.mt-pill.vence_90{background:rgba(91,163,245,.1);color:#5ba3f5}
.mt-pill.futuro{background:rgba(34,197,94,.15);color:#4ade80}
.mt-act{display:flex;gap:4px;flex-wrap:wrap}
.mt-act a,.mt-act button{display:inline-flex;align-items:center;gap:3px;padding:3px 7px;border-radius:5px;font-size:10px;font-weight:700;text-decoration:none;border:1px solid;cursor:pointer;background:transparent}
.mt-act .wati{color:#25D366;border-color:#25D366}
.mt-act .zapi{color:#22c55e;border-color:#16a34a;background:rgba(34,197,94,.08)}
.mt-act .goto{color:#fbbf24;border-color:#d97706}
.mt-act .crm{color:#5ba3f5;border-color:#5ba3f5}
.mt-act .nubia{color:#c084fc;border-color:#a371f7}

/* Drawer perfil */
.mt-drawer{position:fixed;top:0;right:-560px;width:540px;max-width:100vw;height:100vh;background:var(--bg-card);border-left:1px solid var(--border);z-index:200;transition:right .3s;overflow-y:auto;color:var(--text)}
.mt-drawer.open{right:0}
.mt-drawer header{position:sticky;top:0;background:linear-gradient(135deg,var(--bg),var(--bg-card));border-bottom:1px solid var(--border);padding:16px 22px;display:flex;align-items:center;gap:8px;z-index:1}
.mt-drawer header h2{margin:0;font-size:16px;font-weight:800;color:var(--text);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.mt-drawer header button{background:var(--bg-hover);border:1px solid var(--border);color:var(--text-muted);font-size:13px;cursor:pointer;line-height:1;padding:6px 12px;border-radius:6px;font-weight:700}
.mt-drawer header button:hover{background:#222;color:#fff}
.mt-drawer header button.minimize{color:#5ba3f5;border-color:#5ba3f5}
.mt-drawer header button.close{color:#ef4444;border-color:#ef4444}
/* Botão flutuante quando minimizado */
.mt-drawer-mini{position:fixed;bottom:80px;right:170px;z-index:90;background:#5ba3f5;color:#000;border:none;border-radius:50px;padding:10px 16px;font-size:12px;font-weight:800;cursor:pointer;box-shadow:0 4px 12px rgba(91,163,245,.4);display:none}
.mt-drawer-mini.visible{display:block}
.mt-drawer .body{padding:18px 22px}
.mt-drawer .row{display:flex;justify-content:space-between;padding:7px 0;border-bottom:1px solid #1a1a1a;font-size:13px}
.mt-drawer .row .k{color:var(--text-muted);font-size:11px;text-transform:uppercase;font-weight:700;letter-spacing:.3px}
.mt-drawer .row .v{color:var(--text);font-weight:600;text-align:right}
.mt-drawer textarea,.mt-drawer select,.mt-drawer input{width:100%;padding:9px 11px;background:var(--bg-hover);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:13px;font-family:inherit;margin-top:4px}
.mt-drawer .lbl{display:block;font-size:10px;color:var(--text-muted);text-transform:uppercase;font-weight:700;margin:14px 0 4px;letter-spacing:.4px}
.mt-drawer .acts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:18px 0 8px}
.mt-drawer .acts a,.mt-drawer .acts button{padding:10px;border-radius:8px;font-size:12px;font-weight:700;text-decoration:none;text-align:center;border:1px solid;cursor:pointer;background:transparent}
.mt-drawer .acts .wati{color:#25D366;border-color:#25D366}
.mt-drawer .acts .zapi{color:#22c55e;border-color:#16a34a;background:rgba(34,197,94,.08)}
.mt-drawer .acts .goto{color:#fbbf24;border-color:#d97706}
.mt-drawer .acts .osauvo{color:#06b6d4;border-color:#06b6d4;background:rgba(6,182,212,.08)}
.mt-drawer .acts .proposta{color:#f0c040;border-color:#f0c040;background:rgba(240,192,64,.08)}
.mt-drawer .acts .tarefa{color:#3b82f6;border-color:#3b82f6;background:rgba(59,130,246,.08)}
.mt-drawer .acts .crm{color:#5ba3f5;border-color:#5ba3f5}
.mt-drawer .acts .nubia{color:#c084fc;border-color:#a371f7;background:rgba(167,113,247,.1)}
.mt-drawer .acts .save{background:#22c55e;color:#000;border:none}

/* ===== MOBILE RESPONSIVE (Onda 1 do roadmap CRM) ===== */
/* Tablet ≤ 1024px */
@media (max-width: 1024px){
  .mt-wrap{padding:14px 14px 80px}
  .mt-grid{grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px}
  .mt-card .v{font-size:20px}
  .mt-filters{grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:6px}
  .mt-drawer{width:100%;max-width:100%;right:-100%}
}
/* Phone ≤ 768px */
@media (max-width: 768px){
  .mt-wrap{padding:10px 8px 90px}
  .mt-h{font-size:17px}
  .mt-sub{font-size:11px}
  .mt-grid{grid-template-columns:repeat(2,1fr);gap:6px}
  .mt-card{padding:10px}
  .mt-card .v{font-size:16px}
  .mt-card .l{font-size:9px}
  .mt-card .s{font-size:9px}
  .mt-cats{padding:8px;gap:5px;overflow-x:auto;flex-wrap:nowrap;-webkit-overflow-scrolling:touch}
  .mt-cats::-webkit-scrollbar{height:4px}
  .mt-cats::-webkit-scrollbar-thumb{background:#333;border-radius:4px}
  .mt-cat{padding:6px 10px;font-size:11px;white-space:nowrap;flex-shrink:0}
  .mt-filters{grid-template-columns:1fr 1fr;gap:6px;padding:8px}
  .mt-filters input, .mt-filters select{padding:8px 10px;font-size:13px} /* >=13px previne zoom no iOS */
  .mt-bulk{flex-direction:column;align-items:stretch;gap:6px;padding:10px}
  .mt-bulk select, .mt-bulk button{width:100%;padding:9px 12px;font-size:13px}
  .mt-bulk > span{order:-1;text-align:center}

  /* Toolbar topo (view switch e ações) */
  .mt-wrap > div[style*="display:flex"]:first-of-type{flex-direction:column;align-items:stretch;gap:8px}

  /* TABELA VIRA CARDS: hide table, render via flex/grid de tr */
  .mt-tbl{display:block;background:transparent;border:none;border-radius:0}
  .mt-tbl thead{display:none}
  .mt-tbl tbody{display:block}
  .mt-tbl tr{display:block;background:#0d0d12;border:1px solid var(--border);border-radius:10px;padding:10px 12px;margin-bottom:8px;position:relative}
  .mt-tbl tr.selected{border-color:#5ba3f5;background:rgba(91,163,245,.05)}
  .mt-tbl td{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;padding:4px 0;border:none;font-size:12px;color:var(--text)}
  .mt-tbl td:first-child{position:absolute;top:8px;right:8px;width:auto;padding:0}
  .mt-tbl td:nth-child(2){font-size:14px;font-weight:700;color:var(--text);padding-right:32px;border-bottom:1px solid #1a1a1a;margin-bottom:4px;padding-bottom:6px}
  /* Label antes do conteúdo de cada coluna */
  .mt-tbl td:not(:first-child):not(:nth-child(2))::before{
    content: attr(data-col);
    color:var(--text-muted);font-size:10px;text-transform:uppercase;font-weight:700;letter-spacing:.4px;
    min-width:75px;flex-shrink:0
  }
  /* Ações last child em row */
  .mt-tbl td:last-child{flex-wrap:wrap;border-top:1px solid #1a1a1a;padding-top:8px;margin-top:6px}
  .mt-tbl td:last-child::before{display:none}
  .mt-act{flex-wrap:wrap;gap:6px;width:100%}
  .mt-act a, .mt-act button{padding:6px 9px;font-size:11px}

  /* Drawer ocupa tela inteira */
  .mt-drawer{width:100vw;max-width:100vw;right:-100vw}
  .mt-drawer header{padding:12px 16px}
  .mt-drawer .body{padding:14px 16px}
  .mt-drawer .acts{grid-template-columns:1fr}
  .mt-drawer-mini{bottom:70px;right:14px;padding:8px 14px;font-size:11px}
}
/* Phone pequeno ≤ 480px */
@media (max-width: 480px){
  .mt-grid{grid-template-columns:1fr 1fr}
  .mt-filters{grid-template-columns:1fr}
  .mt-tbl tr{padding:8px 10px}
  .mt-tbl td:nth-child(2){font-size:13px}
}
</style>

<div class="mt-wrap">
  <% const isAdmin = user.role === 'admin'; %>
  <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:6px">
    <h1 class="mt-h" style="margin:0;flex:1">🗂️ CRM Closy <span style="color:var(--text-muted);font-size:14px;font-weight:500">· <% if (isAdmin) { %>Base Ativa & Recompra<% } else { %><%= user.name %><% } %></span></h1>
    <% if (!isAdmin) { %>
      <div style="display:flex;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;overflow:hidden" title="Filtro de visualização">
        <button id="vw-minha" onclick="trocarViewCarteira('minha')" style="background:#1e3a5f;color:#7cb9f5;border:none;padding:7px 12px;font-size:11px;font-weight:700;cursor:pointer">👤 Minha</button>
        <button id="vw-orfaos" onclick="trocarViewCarteira('orfaos')" style="background:none;color:#fbbf24;border:none;padding:7px 12px;font-size:11px;font-weight:700;cursor:pointer">🆓 Sem op.</button>
        <button id="vw-todos" onclick="trocarViewCarteira('todos')" style="background:none;color:var(--text-muted);border:none;padding:7px 12px;font-size:11px;font-weight:700;cursor:pointer" title="Top 800 vencendo nos próximos 60d">🌐 Todos (top)</button>
      </div>
    <% } %>
    <% if (isAdmin) { %>
      <button onclick="autoAtribuirTodos()" style="background:#0d2818;color:#4ade80;border:1px solid #22c55e;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer" title="Distribui TODOS clientes vencidos/vencendo entre TODAS as operadoras (round-robin)">⚖️ Auto-atribuir Tudo</button>
      <button onclick="abrirDistribuicaoMassa()" style="background:linear-gradient(135deg,#a371f7,#7c3aed);color:#fff;border:none;border-radius:8px;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer" title="Distribuição segmentada: filtra por data + categoria, escolhe operadoras, distribui">🎯 Distribuição em Massa</button>
    <% } %>
    <span id="wati-inbox-badge" style="display:none;background:#25D366;color:#fff;font-size:11px;font-weight:800;padding:5px 12px;border-radius:14px;cursor:pointer;animation:watiPulse 1.4s infinite" onclick="trocarView('inbox')" title="Cliente respondeu — abre o Inbox"></span>
    <div style="display:flex;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;overflow:hidden">
      <button id="btn-prioridade" onclick="togglePrioridade()" style="background:none;color:#fb923c;border:none;border-right:1px solid var(--border);padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer" title="Top 30 contatos priorizados — abre, liga, vende. Prioriza por vencimento + ticket + recência do último template">🔥 Top Hoje</button>
      <button id="vw-lista" onclick="trocarView('lista')" style="background:#1e3a5f;color:#7cb9f5;border:none;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer">📋 Lista</button>
      <button id="vw-kanban" onclick="trocarView('kanban')" style="background:none;color:var(--text-muted);border:none;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer">🗂️ Kanban</button>
      <button id="vw-tarefas" onclick="trocarView('tarefas')" style="background:none;color:#fbbf24;border:none;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer;position:relative" title="Suas tarefas com botões de execução (ligar/chat/wati/zapi)">📋 Tarefas <span id="vw-tarefas-badge" style="display:none;background:#fbbf24;color:#000;font-size:9px;font-weight:800;padding:1px 6px;border-radius:8px;margin-left:4px"></span></button>
      <button id="vw-inbox" onclick="trocarView('inbox')" style="background:none;color:var(--text-muted);border:none;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer;position:relative">💬 Inbox <span id="vw-inbox-badge" style="display:none;background:#22c55e;color:#fff;font-size:9px;font-weight:800;padding:1px 6px;border-radius:8px;margin-left:4px"></span></button>
      <% if (typeof isGestor !== 'undefined' && isGestor) { %><button id="vw-painel" onclick="trocarView('painel')" style="background:none;color:#fb923c;border:none;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer" title="Painel de desempenho do seu time (KPIs, ranking operadoras, atenção)">📊 Painel</button><button id="vw-gestao" onclick="trocarView('gestao')" style="background:none;color:#22c55e;border:none;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer" title="Painel de gestão · só gestor/CEO">📊 Gestão</button><% } %>
      <% if (isAdmin) { %><button id="vw-auto" onclick="trocarView('auto')" style="background:none;color:var(--text-muted);border:none;padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer">⚙️ Automação</button><% } %>
      <% if (isAdmin) { %><a href="/manutencao/funis-page" style="background:none;color:#a371f7;text-decoration:none;padding:8px 14px;font-size:12px;font-weight:700">🪜 Funis</a><% } %>
    </div>
  </div>
  <p class="mt-sub">
    <% if (isAdmin) { %>
      Central de manutenção, recompra e retenção da base — pipeline com 8 etapas, drag-drop, timeline. Base: vendas dos últimos 36 meses + Quoted_Items + vida útil padrão.
    <% } else { %>
      Sua carteira de manutenção — clientes atribuídos a você. Arraste cards no Kanban entre etapas conforme avança no atendimento.
    <% } %>
  </p>

  <!-- CARDS DE VENCIMENTO -->
  <div class="mt-grid" id="mt-cards"></div>

  <!-- CATEGORIAS -->
  <div class="mt-cats" id="mt-cats"></div>

  <!-- FILTROS -->
  <div class="mt-filters">
    <input type="text" id="f-search" placeholder="🔍 Nome, telefone, cidade...">
    <select id="f-status">
      <option value="">📅 Todos status</option>
      <option value="vencido">⚠️ Vencidos</option>
      <option value="vence_30">🟡 Vence em 30 dias</option>
      <option value="vence_60">🔵 Vence em 60 dias</option>
      <option value="vence_90">🔵 Vence em 90 dias</option>
      <option value="vencido_30">🔴 Vencido +30d</option>
      <option value="vencido_60">🔴 Vencido +60d</option>
      <option value="vencido_90">🔴 Vencido +90d</option>
      <option value="futuro">🟢 Futuro (+90d)</option>
    </select>
    <select id="f-cat">
      <option value="">📦 Todas categorias</option>
    </select>
    <!-- 14/Mai/2026: cidade vira input com lupa + autocomplete (datalist) — Paulo pediu -->
    <div style="display:inline-flex;align-items:center;gap:4px;background:var(--bg-hover);border:1px solid var(--border);border-radius:6px;padding:3px 6px">
      <span style="color:var(--text-muted);font-size:13px">🔍</span>
      <input type="search" id="f-cidade" list="f-cidade-list" placeholder="Cidade..." autocomplete="off"
             style="background:transparent;border:none;color:var(--text);font-size:12px;width:140px;outline:none">
      <% if (isAdmin) { %>
      <button onclick="abrirUnificarCidades()" title="Unificar cidades duplicadas (TAUBATE/TAUBATÉ/Taubaté/SP → Taubaté)" style="background:transparent;border:none;color:#fbbf24;font-size:14px;cursor:pointer;padding:0 2px">🔧</button>
      <% } %>
    </div>
    <datalist id="f-cidade-list"><!-- populado por popularFiltros() --></datalist>
    <% if (isAdmin) { %>
    <select id="f-operadora">
      <option value="">👤 Todas operadoras</option>
      <option value="__sem">— Sem operadora —</option>
    </select>
    <% } else { %><input type="hidden" id="f-operadora" value=""><% } %>
    <select id="f-status-manual">
      <option value="">🏷️ Todos status manuais</option>
      <option value="em_contato">Em contato</option>
      <option value="sem_resposta">Sem resposta</option>
      <option value="agendado">Agendado</option>
      <option value="vendido">Vendido</option>
      <option value="perdido">Perdido</option>
      <option value="nao_quer">Não quer agora</option>
      <option value="ja_fez">Já fez manutenção</option>
    </select>
    <select id="f-refil-tipo" style="display:none" title="Sub-filtro dentro de Refis/Elementos">
      <option value="">🔧 Refil/Elemento — todos</option>
      <option value="refil_bebedouro">💧 Refil de bebedouro</option>
      <option value="elemento_filtrante">🔩 Elemento filtrante</option>
      <option value="indefinido">❓ Sem classificação clara</option>
    </select>

    <!-- 14/Mai/2026: filtros por histórico de envio WATI — saber quem já recebeu template e quando -->
    <div style="display:inline-flex;align-items:center;gap:4px;background:#0d1f3a;border:1px solid #1e3a5f;border-radius:6px;padding:3px 6px">
      <select id="f-envio-op" title="Operador do filtro de envio" style="background:transparent;border:none;color:#7cb9f5;font-size:11px;font-weight:700">
        <option value="">📨 Envio WATI...</option>
        <option value="nunca">🚫 Nunca recebeu</option>
        <option value="exato">📅 Recebeu EM</option>
        <option value="apos">↗ Recebeu DEPOIS de</option>
        <option value="antes">↘ Recebeu ANTES de</option>
        <option value="sem_desde">🆕 SEM envio DESDE</option>
      </select>
      <input type="date" id="f-envio-data" title="Data de referência" style="background:var(--bg-hover);border:1px solid var(--border);border-radius:4px;color:var(--text);padding:3px 6px;font-size:11px">

async function carregarAuvo(dealId){
  const el = document.getElementById('d-auvo');
  if (!el) return;
  el.innerHTML = '<span style="color:#888">Buscando visitas Auvo...</span>';
  const d = await fetchJson('/manutencao/cliente/'+dealId+'/auvo');
  try {
    if (d.error) { el.innerHTML = '<span style="color:#f87171">⚠️ '+d.error+'</span>'; return; }
    if (d.aviso) { el.innerHTML = '<span style="color:#888">'+d.aviso+'</span>'; return; }
    if (!d.visitas || !d.visitas.length) {
      el.innerHTML = '<span style="color:#666">Nenhuma visita técnica encontrada nos últimos 12 meses.</span>';
      return;
    }
    const STATUS_AUVO = { 0:'Aberta', 1:'Em deslocamento', 2:'Em execução', 3:'Pausada', 4:'Concluída', 5:'Cancelada' };
    const STAT_COR = { 4:'#22c55e', 5:'#ef4444', 0:'#5ba3f5', 1:'#a371f7', 2:'#fbbf24', 3:'#fbbf24' };
    el.innerHTML = `
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:6px">
        <span style="color:#aaa;font-size:10px">${d.total} visita(s) · indexado ${new Date(d.indexedAt).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'})}</span>
        <span style="flex:1"></span>
        <button id="btn-fotos-${dealId}" onclick="carregarFotosAuvo('${dealId}')" style="background:#1a1a1a;color:#a371f7;border:1px solid #a371f7;border-radius:5px;padding:4px 10px;font-size:10px;cursor:pointer;font-weight:700">📷 Buscar fotos</button>
      </div>
      ${d.visitas.map(v => {
        const dt = v.checkIn || v.taskDate;
        const dtStr = dt ? new Date(String(dt).replace(' ','T')).toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'}) : '—';
        const cor = STAT_COR[v.status] || '#888';
        return `<div style="padding:7px 0;border-bottom:1px solid #222;font-size:11px">
          <div style="display:flex;align-items:center;gap:8px">
            <span style="color:${cor};font-weight:700;font-size:10px;text-transform:uppercase">${STATUS_AUVO[v.status]||'Status '+v.status}</span>
            <span style="color:#fff;font-weight:700">${v.tipo||'visita'}</span>
            <span style="color:#888;font-size:10px">${dtStr}</span>
          </div>
          <div style="color:#aaa;font-size:10px;margin-top:3px">👷 ${v.tecnico||'?'} ${v.endereco?`· 📍 ${v.endereco.slice(0,60)}`:''}</div>
          ${v.resumo ? `<div style="color:#bbb;font-size:11px;margin-top:4px;font-style:italic">${v.resumo}</div>` : ''}
        </div>`;
      }).join('')}
      <div id="fotos-${dealId}"></div>
    `;
  } catch(e) {
    el.innerHTML = '<span style="color:#f87171">Erro ao buscar Auvo: '+e.message+'</span>';
  }
}

async function carregarFotosAuvo(dealId){
  const cont = document.getElementById('fotos-'+dealId);
  const btn = document.getElementById('btn-fotos-'+dealId);
  if (!cont) return;
  cont.innerHTML = '<div style="color:#888;font-size:11px;padding:8px">Buscando fotos das visitas...</div>';
  if (btn) btn.disabled = true;
  const d = await fetchJson('/manutencao/cliente/'+dealId+'/auvo-fotos');
  try {
    if (d.error) { cont.innerHTML = '<div style="color:#f87171;font-size:11px;padding:8px">⚠️ '+d.error+'</div>'; if (btn) btn.disabled = false; return; }
    if (!d.visitas || !d.visitas.length) {
      cont.innerHTML = '<div style="color:#666;font-size:11px;padding:8px">Nenhuma foto encontrada nas visitas.</div>';
      if (btn) btn.disabled = false;
      return;
    }
    cont.innerHTML = `
      <div style="margin-top:10px;padding:10px;background:rgba(167,113,247,.06);border:1px solid #a371f7;border-radius:8px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span style="color:#c084fc;font-weight:700;font-size:12px">📷 ${d.totalFotos} foto(s) das visitas</span>
          <span style="flex:1"></span>
          <button onclick="anexarFotosZoho('${dealId}')" style="background:#a371f7;color:#fff;border:none;border-radius:5px;padding:5px 12px;font-size:10px;cursor:pointer;font-weight:700">📎 Anexar tudo no Zoho</button>
        </div>
        ${d.visitas.map(v => {
          const dt = v.checkIn ? new Date(String(v.checkIn).replace(' ','T')).toLocaleDateString('pt-BR',{timeZone:'America/Sao_Paulo'}) : '';
          return `<div style="margin-top:8px;padding-top:8px;border-top:1px solid #222">
            <div style="font-size:10px;color:#aaa;margin-bottom:6px">📅 ${dt} · ${v.tipo||'visita'} · 👷 ${v.tecnico||'?'}</div>
            <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(80px,1fr));gap:4px">

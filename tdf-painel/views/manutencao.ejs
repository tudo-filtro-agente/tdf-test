async function analisarFunilDeal(dealId, telefone){
  const out = document.getElementById('af-resultado-'+dealId);
  if (!out) return;
  out.style.display = 'block';
  out.innerHTML = `<div style="background:#0d1117;border:1px solid #a371f7;border-radius:10px;padding:14px;color:#c084fc;font-size:12px">⏳ Lendo conversa WATI + contexto Zoho... (10-20s)</div>`;
  try {
    const r = await fetch('/manutencao/cliente/'+dealId+'/analise-funil', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ phone: telefone }),
    });
    const d = await r.json();
    if (d.error) { out.innerHTML = `<div style="background:#3a0a0a;border:1px solid #ef4444;border-radius:8px;padding:12px;color:#fca5a5;font-size:12px">❌ ${d.error}</div>`; return; }
    if (!d.sintomas) {
      out.innerHTML = `<div style="background:#1a1a1a;border:1px solid #555;border-radius:8px;padding:12px;color:#aaa;font-size:12px">${d.diagnostico_curto || 'Sem dados suficientes'}</div>`;
      return;
    }
    const score = d.score_qualidade_conversa;
    const corScore = score >= 70 ? '#22c55e' : score >= 50 ? '#fbbf24' : score >= 25 ? '#f97316' : '#ef4444';
    const corPerda = d.perda_provavel === 'alta' ? '#ef4444' : d.perda_provavel === 'media' ? '#fbbf24' : '#22c55e';
    let html = `<div style="background:linear-gradient(135deg,#0d1117 0%,#1a0e2a 100%);border:2px solid #a371f7;border-radius:12px;padding:14px">`;
    // Header
    html += `<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap">
      <span style="font-size:18px">🔍</span>
      <strong style="color:#c084fc;font-size:13px">Análise de Funil</strong>
      <span style="background:${corScore}22;color:${corScore};padding:3px 10px;border-radius:6px;font-size:11px;font-weight:800;margin-left:auto">Score ${score}/100</span>
      <span style="background:${corPerda}22;color:${corPerda};padding:3px 10px;border-radius:6px;font-size:11px;font-weight:800">Perda ${d.perda_provavel}</span>
    </div>`;
    // Stage
    html += `<div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap;font-size:11px">
      <span style="color:#888">Stage Zoho:</span><span style="color:#fff;font-weight:700">${d.stage_atual_zoho || '?'}</span>
      <span style="color:#666;margin:0 4px">→</span>
      <span style="color:#888">Etapa real do funil:</span><span style="color:#fbbf24;font-weight:700">${STAGE_FUNIL_LABELS[d.stage_funil_real] || d.stage_funil_real}</span>
      <span style="color:#666;margin:0 4px">·</span>
      <span style="color:#888">Travou em:</span><span style="background:#3a0a0a;color:#fca5a5;padding:2px 8px;border-radius:4px;font-weight:700">${STAGE_FUNIL_LABELS[d.stage_travou_em] || d.stage_travou_em}</span>
    </div>`;
    // Diagnóstico
    html += `<div style="background:#161b22;border-left:3px solid #a371f7;padding:10px 12px;margin-bottom:10px;border-radius:4px">
      <div style="color:#888;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:3px">Diagnóstico</div>
      <div style="color:#fff;font-size:13px;font-weight:600;line-height:1.4">${d.diagnostico_curto}</div>
    </div>`;
    // Sintomas
    if (d.sintomas?.length) {
      html += `<div style="margin-bottom:10px">
        <div style="color:#888;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px">Sintomas detectados (${d.sintomas.length})</div>`;
      d.sintomas.forEach(s => {
        const meta = SINTOMA_LABELS[s.tipo] || { label: s.tipo, icon: '⚠️', cor: '#888' };
        const corSev = s.severidade === 'alta' ? '#ef4444' : s.severidade === 'media' ? '#fbbf24' : '#888';
        html += `<div style="background:#0d0d0d;border:1px solid #30363D;border-left:3px solid ${meta.cor};border-radius:4px;padding:8px 10px;margin-bottom:6px">
          <div style="display:flex;gap:6px;align-items:center;margin-bottom:3px">
            <span>${meta.icon}</span>
            <strong style="color:${meta.cor};font-size:11px">${meta.label}</strong>
            <span style="background:${corSev}22;color:${corSev};padding:1px 6px;border-radius:3px;font-size:9px;font-weight:700;text-transform:uppercase">${s.severidade}</span>
          </div>
          <div style="color:#aaa;font-size:11px;font-style:italic">"${(s.evidencia||'').slice(0,200)}"</div>
        </div>`;
      });
      html += `</div>`;
    }
    // Próxima ação
    html += `<div style="background:#0d2818;border:1px solid #22c55e;border-left:4px solid #22c55e;border-radius:6px;padding:10px 12px">
      <div style="color:#22c55e;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:3px">⚡ Próxima Ação</div>
      <div style="color:#fff;font-size:12px;font-weight:600;line-height:1.4">${d.proxima_acao}</div>
    </div>`;
    // Padrão recorrente
    if (d.padrao_recorrente_suspeita) {
      html += `<div style="margin-top:8px;background:#2d1f08;border:1px dashed #fbbf24;border-radius:6px;padding:8px 10px">
        <div style="color:#fbbf24;font-size:10px;font-weight:700;margin-bottom:2px">🚨 PADRÃO SUSPEITO DESSE CLOSER</div>
        <div style="color:#fbbf24;font-size:11px">${d.padrao_recorrente_suspeita}</div>
      </div>`;
    }
    html += `<div style="text-align:right;margin-top:8px;color:#666;font-size:9px">${d.total_mensagens} msgs analisadas · ${d.owner||''}</div>`;
    html += `</div>`;
    out.innerHTML = html;
  } catch(e) {
    out.innerHTML = `<div style="background:#3a0a0a;border:1px solid #ef4444;border-radius:8px;padding:12px;color:#fca5a5;font-size:12px">❌ Erro: ${e.message}</div>`;
  }
}


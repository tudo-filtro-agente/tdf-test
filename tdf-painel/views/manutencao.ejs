  if (opSel1) opSel1.innerHTML = '<option value="">👤 Todas operadoras</option><option value="__sem">— Sem operadora —</option>' +
    ops.map(o => `<option value="${o.username}">${o.name} (${o.team})</option>`).join('');
  const bulkOp = document.getElementById('mt-bulk-op');

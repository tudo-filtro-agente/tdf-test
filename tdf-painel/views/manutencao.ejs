let _TF_DATA = { tarefas: [] };
let _TF_FILTRO = { status: 'abertas', quando: 'todas', scope: 'todas' };

async function tfCarregar(){
  try {
    const r = await fetch('/tarefas/minhas' + (_TF_FILTRO.scope === 'minhas' ? '?scope=minhas' : ''));
    const d = await r.json();
    if (d.error) { document.getElementById('tf-list').innerHTML = `<div style="color:#ef4444;padding:20px">${d.error}</div>`; return; }
    _TF_DATA = d;
    tfRender();
    tfAtualizarBadge();
  } catch(e) { document.getElementById('tf-list').innerHTML = `<div style="color:#ef4444;padding:20px">${e.message}</div>`; }
}

function tfSetFiltro(tipo, valor){
  _TF_FILTRO[tipo] = valor;
  // Update active button
  document.querySelectorAll('#tf-'+tipo+'-grp button, #tf-status-grp button, #tf-quando-grp button, #tf-scope-grp button').forEach(b => {
    const grp = b.parentElement.id;
    if ((grp==='tf-status-grp' && tipo==='status') || (grp==='tf-quando-grp' && tipo==='quando') || (grp==='tf-scope-grp' && tipo==='scope')) {
      const v = b.dataset.st || b.dataset.q || b.dataset.sc;
      b.classList.toggle('active', v === valor);
    }
  });
  if (tipo === 'scope') tfCarregar(); // scope muda payload
  else tfRender();
}

function tfWhenClass(t){
  if (t.status === 'concluida') return 'concluida';
  const dh = new Date(t.dataHora).getTime();
  const now = Date.now();
  if (dh < now - 5*60000) return 'atrasada';
  const hoje0 = new Date(); hoje0.setHours(0,0,0,0);
  const amanha0 = new Date(hoje0); amanha0.setDate(amanha0.getDate()+1);
  if (dh < amanha0.getTime()) return 'hoje';
  return 'futura';
}

function tfFmtData(iso){
  const d = new Date(iso);
  return d.toLocaleString('pt-BR', { timeZone:'America/Sao_Paulo', day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
}

function tfFmtDelta(iso){
  const dh = new Date(iso).getTime();
  const now = Date.now();
  const min = Math.round((dh - now)/60000);
  if (Math.abs(min) < 60) return min >= 0 ? `em ${min}min` : `há ${-min}min`;
  const h = Math.round(min/60);
  if (Math.abs(h) < 24) return h >= 0 ? `em ${h}h` : `há ${-h}h`;
  const d = Math.round(h/24);
  return d >= 0 ? `em ${d}d` : `há ${-d}d`;
}

function tfRender(){
  const all = _TF_DATA.tarefas || [];
  const search = (document.getElementById('tf-search')?.value || '').toLowerCase();
  const hoje0 = new Date(); hoje0.setHours(0,0,0,0);
  const amanha0 = new Date(hoje0); amanha0.setDate(amanha0.getDate()+1);
  const depAmanha = new Date(amanha0); depAmanha.setDate(depAmanha.getDate()+1);
  const fimSemana = new Date(hoje0); fimSemana.setDate(fimSemana.getDate()+7);

  const list = all.filter(t => {
    // status
    if (_TF_FILTRO.status === 'abertas' && t.status !== 'aberta') return false;
    if (_TF_FILTRO.status === 'concluidas' && t.status !== 'concluida') return false;
    // quando
    const dh = new Date(t.dataHora).getTime();
    if (_TF_FILTRO.quando === 'atrasadas' && !(t.status === 'aberta' && dh < Date.now() - 5*60000)) return false;
    if (_TF_FILTRO.quando === 'hoje' && !(dh >= hoje0.getTime() && dh < amanha0.getTime())) return false;
    if (_TF_FILTRO.quando === 'amanha' && !(dh >= amanha0.getTime() && dh < depAmanha.getTime())) return false;
    if (_TF_FILTRO.quando === 'semana' && !(dh >= hoje0.getTime() && dh < fimSemana.getTime())) return false;
    // search
    if (search) {
      const blob = (t.titulo + ' ' + (t.dealNome||'') + ' ' + (t.observacao||'') + ' ' + (t.phone||'')).toLowerCase();
      if (!blob.includes(search)) return false;
    }
    return true;
  });

  // Stats
  const abertas = all.filter(t => t.status === 'aberta');
  const atrasadas = abertas.filter(t => new Date(t.dataHora).getTime() < Date.now() - 5*60000);
  const hoje = abertas.filter(t => { const dh = new Date(t.dataHora).getTime(); return dh >= hoje0.getTime() && dh < amanha0.getTime(); });
  const concluidasHoje = all.filter(t => t.status === 'concluida' && t.completedAt && new Date(t.completedAt) >= hoje0);
  document.getElementById('tf-stats').innerHTML = `
    <div class="tf-stat" onclick="tfSetFiltro('quando','atrasadas');tfSetFiltro('status','abertas')"><div class="v" style="color:${atrasadas.length>0?'#ef4444':'#666'}">${atrasadas.length}</div><div class="k">Atrasadas</div></div>
    <div class="tf-stat" onclick="tfSetFiltro('quando','hoje');tfSetFiltro('status','abertas')"><div class="v" style="color:#fbbf24">${hoje.length}</div><div class="k">Hoje</div></div>
    <div class="tf-stat" onclick="tfSetFiltro('quando','todas');tfSetFiltro('status','abertas')"><div class="v" style="color:#5ba3f5">${abertas.length}</div><div class="k">Total abertas</div></div>
    <div class="tf-stat" onclick="tfSetFiltro('status','concluidas')"><div class="v" style="color:#22c55e">${concluidasHoje.length}</div><div class="k">Concluídas hoje</div></div>
  `;

  if (!list.length) {
    document.getElementById('tf-list').innerHTML = `<div style="text-align:center;color:#666;padding:40px;font-size:13px">${
      _TF_FILTRO.status === 'abertas' && abertas.length === 0 ? '✅ Nenhuma tarefa aberta. Manda bala!' : 'Nenhuma tarefa com esses filtros.'
    }</div>`;
    return;
  }

  document.getElementById('tf-list').innerHTML = list.map(t => {
    const cls = tfWhenClass(t);
    const phoneClean = String(t.phone||'').replace(/\D/g,'');
    const watiUrl = phoneClean ? `https://live-2708.wati.io/2708/teamInbox/${phoneClean}` : '';
    const nomeEsc = (t.dealNome||'').replace(/'/g,"\\'").replace(/"/g,'&quot;');
    return `<div class="tf-card ${cls}">
      <div class="tf-head">
        <span class="tf-pill ${cls}">${cls === 'atrasada' ? '🔴 ATRASADA' : cls === 'hoje' ? '🟡 HOJE' : cls === 'concluida' ? '✅ FEITA' : '🟢 FUTURA'}</span>
        <span class="tf-titulo">${(t.titulo||'').replace(/</g,'&lt;')}</span>
        <span class="tf-when" style="color:${cls==='atrasada'?'#ef4444':cls==='hoje'?'#fbbf24':'#22c55e'}">${tfFmtData(t.dataHora)} · ${tfFmtDelta(t.dataHora)}</span>
      </div>
      <div class="tf-meta">
        ${t.dealNome ? `<span>👤 <strong style="color:#fff">${t.dealNome.replace(/</g,'&lt;')}</strong></span>` : ''}
        ${t.phone ? `<span>📞 <span onclick="window.copyTel&&copyTel('${t.phone.replace(/'/g,"\\'")}',this)" title="Click pra copiar" style="cursor:pointer;user-select:all;padding:1px 6px;border-radius:4px;background:rgba(34,197,94,.08);border:1px solid #22c55e44;color:#86efac;font-family:monospace">${t.phone}</span> <button onclick="window.copyTel&&copyTel('${t.phone.replace(/'/g,"\\'")}',this)" style="background:transparent;border:1px solid #30363D;color:#9ca3af;border-radius:4px;padding:1px 5px;font-size:9px;cursor:pointer" title="Copiar">📋</button></span>` : ''}
        ${t.tier ? `<span>🏆 ${t.tier}</span>` : ''}
        ${t.etapa ? `<span>📋 ${t.etapa}</span>` : ''}
        ${t.atribuidos_nomes?.length ? `<span>👥 ${t.atribuidos_nomes.join(', ')}</span>` : ''}
        ${t.criadoPorNome && t.criadoPorNome !== t.atribuidos_nomes?.[0] ? `<span style="color:#666">por ${t.criadoPorNome}</span>` : ''}
        ${t.ultimoContato ? `<span style="color:#666">último contato: ${t.ultimoContato}</span>` : ''}
      </div>
      ${t.observacao ? `<div style="color:#bbb;font-size:11px;font-style:italic;margin-bottom:8px">📝 ${t.observacao.replace(/</g,'&lt;')}</div>` : ''}
      <div class="tf-acts">
        ${t.status === 'aberta' ? `
          ${phoneClean ? `<a class="ligar" href="tel:+${phoneClean}" onclick="tfRegistrarContato('${t.id}','${t.dealId||''}','goto','Ligação iniciada')" title="Liga e marca tarefa como em andamento">📞 Ligar</a>` : ''}
          ${phoneClean && t.dealId ? `<button class="chat" onclick="window.abrirChat&&abrirChat('${t.dealId}','${phoneClean}','${nomeEsc}')" title="Abre chat flutuante WATI/Z-API">💬 Chat</button>` : ''}
          ${phoneClean ? `<a class="wati" href="${watiUrl}" target="_blank" onclick="tfRegistrarContato('${t.id}','${t.dealId||''}','wati','WATI Inbox aberto')">📱 WATI Inbox</a>` : ''}
          ${phoneClean ? `<button class="zapi" onclick="tfEnviarZapiPrompt('${t.id}','${t.dealId||''}','${phoneClean}','${nomeEsc}')" title="Envia mensagem rápida via Z-API (sem janela 24h)">⚡ Z-API</button>` : ''}
          <button class="concluir" onclick="tfConcluir('${t.id}', this)">✅ Concluir</button>
          <button class="adiar" onclick="tfAdiar('${t.id}')">⏰ Adiar</button>
          ${t.crmLink ? `<a href="${t.crmLink}" target="_blank">🌐 Zoho</a>` : ''}
          ${t.dealId ? `<a href="/manutencao?open=${t.dealId}" target="_blank">📂 Drawer</a>` : ''}
          <button class="delete" onclick="tfDeletar('${t.id}', this)" title="Deletar tarefa">🗑️</button>
        ` : `
          <span style="color:#22c55e;font-size:11px">✅ Concluída ${t.completedAt ? tfFmtData(t.completedAt) : ''} ${t.completedBy ? '· por '+t.completedBy : ''}</span>
        `}
      </div>
    </div>`;
  }).join('');
}

function tfAtualizarBadge(){
  const abertas = (_TF_DATA.tarefas||[]).filter(t => t.status === 'aberta');
  const atrasadas = abertas.filter(t => new Date(t.dataHora).getTime() < Date.now() - 5*60000);
  const badge = document.getElementById('vw-tarefas-badge');
  if (badge) {
    if (atrasadas.length > 0) {
      badge.textContent = atrasadas.length;
      badge.style.background = '#ef4444';
      badge.style.color = '#fff';
      badge.style.display = 'inline-block';
    } else if (abertas.length > 0) {
      badge.textContent = abertas.length;
      badge.style.background = '#fbbf24';
      badge.style.color = '#000';
      badge.style.display = 'inline-block';
    } else {
      badge.style.display = 'none';
    }
  }
}

async function tfRegistrarContato(tarefaId, dealId, canal, label){
  if (!dealId) return;
  try {
    await fetch('/manutencao/cliente/'+dealId+'/registrar-contato', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ canal, observacao: 'via Tarefa Closy' })
    });
  } catch(_){}
  // Recarrega depois pra refletir ultimoContato
  setTimeout(tfCarregar, 1500);
}

async function tfConcluir(id, btn){
  if (!confirm('Concluir essa tarefa?')) return;
  btn.disabled = true; btn.textContent = '⏳';
  try {
    const r = await fetch('/tarefas/'+id+'/concluir', { method:'POST' });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); btn.disabled = false; btn.textContent = '✅ Concluir'; return; }
    tfCarregar();
  } catch(e) { alert('Erro: '+e.message); btn.disabled = false; btn.textContent = '✅ Concluir'; }
}

async function tfAdiar(id){
  const min = prompt('Adiar por quantos minutos?', '30');
  const num = parseInt(min);
  if (!num || num < 1) return;
  try {
    const r = await fetch('/tarefas/'+id+'/adiar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ minutos: num })});
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    tfCarregar();
  } catch(e) { alert('Erro: '+e.message); }
}

async function tfDeletar(id, btn){
  if (!confirm('Deletar essa tarefa? Não dá pra desfazer.')) return;
  btn.disabled = true;
  try {
    const r = await fetch('/tarefas/'+id, { method:'DELETE' });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); btn.disabled = false; return; }
    tfCarregar();
  } catch(e) { alert('Erro: '+e.message); btn.disabled = false; }
}

async function tfEnviarZapiPrompt(tarefaId, dealId, phone, nome){
  const txt = prompt(`Enviar mensagem via Z-API pra ${nome}:`, '');
  if (!txt || !txt.trim()) return;
  try {
    const r = await fetch('/inbox/zapi-enviar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone, text: txt }) });
    const d = await r.json();
    if (d.error) { alert('Erro Z-API: '+d.error); return; }
    if (dealId) await tfRegistrarContato(tarefaId, dealId, 'zapi', 'Mensagem via Z-API');
    alert('✅ Enviado via Z-API!');
    tfCarregar();
  } catch(e) { alert('Erro: '+e.message); }
}

function tfAbrirNova(){
  const titulo = prompt('Título da tarefa:');
  if (!titulo) return;
  const dealId = prompt('ID do deal Zoho (opcional, deixa em branco se não tiver):');
  const dataHoraStr = prompt('Data/hora (YYYY-MM-DD HH:MM, ex: 2026-05-05 14:30):', new Date(Date.now()+3600000).toISOString().slice(0,16).replace('T',' '));
  if (!dataHoraStr) return;
  const dataHora = new Date(dataHoraStr.replace(' ', 'T') + ':00-03:00').toISOString();
  fetch('/tarefas', {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify({ titulo, dealId: dealId||null, dataHora, lembreteMin: 5 })
  }).then(r => r.json()).then(d => {
    if (d.error) { alert('Erro: '+d.error); return; }
    tfCarregar();
  }).catch(e => alert('Erro: '+e.message));
}


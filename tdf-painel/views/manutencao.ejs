}
function dmAtalho(t){
  const de = document.getElementById('dm-data-de');
  const ate = document.getElementById('dm-data-ate');
  const semOp = document.getElementById('dm-sem-op');
  if (t === 'limpar') { de.value = ''; ate.value = ''; semOp.checked = true; return; }
  if (t === 'jan23') { de.value = '2023-01-01'; ate.value = '2023-01-31'; }
  else if (t === '2023') { de.value = '2023-01-01'; ate.value = '2023-12-31'; }
  else if (t === '2024') { de.value = '2024-01-01'; ate.value = '2024-12-31'; }
  else if (t === 'vencidos') {
    const hoje = new Date().toISOString().slice(0,10);
    de.value = '2020-01-01';
    ate.value = hoje;
  } else if (t === 'vence30') {
    const hoje = new Date();
    const trinta = new Date(hoje.getTime() + 30 * 86400000);
    de.value = hoje.toISOString().slice(0,10);
    ate.value = trinta.toISOString().slice(0,10);
  }
}
function dmTodasOps(check){
  document.querySelectorAll('input[name="dm-op-cb"]').forEach(cb => cb.checked = check);
}
function dmTimeBebedouro(){
  document.querySelectorAll('input[name="dm-op-cb"]').forEach(cb => {
    cb.checked = cb.dataset.team === 'bebedouro';
  });
}
function dmTimeFiltro(){
  document.querySelectorAll('input[name="dm-op-cb"]').forEach(cb => {
    cb.checked = cb.dataset.team === 'filtro' || cb.dataset.team === 'poco';
  });
}
function dmFiltrarLeads(){
  const de = document.getElementById('dm-data-de').value;
  const ate = document.getElementById('dm-data-ate').value;
  const semOp = document.getElementById('dm-sem-op').checked;
  const cats = Array.from(document.querySelectorAll('input[name="dm-cat-cb"]:checked')).map(c => c.value);
  const todasCats = cats.includes('') || cats.length === 0;
  return (_MT?.clientes||[]).filter(c => {
    if (semOp && c.operadora) return false;
    if (!todasCats && !cats.includes(c.categoria)) return false;
    if (de && c.proximaTroca && c.proximaTroca < de) return false;
    if (ate && c.proximaTroca && c.proximaTroca > ate) return false;
    return true;
  });
}
function dmCalcularPreview(){
  const leads = dmFiltrarLeads();
  const ops = Array.from(document.querySelectorAll('input[name="dm-op-cb"]:checked')).map(c => c.value);
  const preview = document.getElementById('dm-preview');
  const btnGo = document.getElementById('dm-btn-go');
  if (!leads.length) {
    preview.style.background = '#3a0a0a';
    preview.style.borderColor = '#ef4444';
    preview.style.color = '#fca5a5';
    preview.innerHTML = '⚠️ Nenhum lead encontrado com esses filtros. Ajuste os critérios.';
    btnGo.style.display = 'none';
    return;
  }
  if (!ops.length) {
    preview.style.background = '#3a0a0a';
    preview.style.borderColor = '#ef4444';
    preview.style.color = '#fca5a5';
    preview.innerHTML = `<strong>${leads.length} leads</strong> encontrados — <strong>mas selecione ao menos 1 operadora</strong>.`;
    btnGo.style.display = 'none';
    return;
  }
  const porOp = Math.ceil(leads.length / ops.length);
  // Breakdown por categoria
  const porCat = {};
  leads.forEach(l => { porCat[l.categoria] = (porCat[l.categoria]||0) + 1; });
  const catLabels = { refil:'💧 Refil', elemento:'🔩 Elemento', bebedouro_refil:'🚰 Bebedouro', iron_free:'⚙️ Iron Free', scale_stop:'🪨 Scale Stop', outros:'📦 Outros' };
  const catBreak = Object.entries(porCat).sort((a,b) => b[1]-a[1]).map(([k,v]) => `${catLabels[k]||k}: ${v}`).join(' · ');
  preview.style.background = '#0d2818';
  preview.style.borderColor = '#22c55e';
  preview.style.color = '#86efac';
  preview.innerHTML = `
    ✅ <strong style="color:#fff;font-size:14px">${leads.length} leads</strong> serão distribuídos entre <strong style="color:#fff">${ops.length} operadora(s)</strong>
    <div style="font-size:11px;color:#aaa;margin-top:6px">Cada operadora receberá ~<strong>${porOp}</strong> leads (round-robin equilibrado)</div>
    <div style="font-size:10px;color:#888;margin-top:4px">📊 ${catBreak}</div>
  `;
  btnGo.style.display = 'inline-block';
}
function dmToggleTarefa(){
  const cb = document.getElementById('dm-criar-tarefa');
  const fields = document.getElementById('dm-tarefa-fields');
  if (fields) fields.style.display = cb.checked ? 'grid' : 'none';
  const inp = document.getElementById('dm-t-data');
  if (cb.checked && inp && !inp.value) {
    const d = new Date(); d.setHours(d.getHours()+1, 0, 0, 0);
    inp.value = d.toISOString().slice(0,16);
  }
}

function dmSugerirMotivo(){
  const cats = Array.from(document.querySelectorAll('input[name="dm-cat-cb"]:checked')).map(c => c.value).filter(Boolean);
  const de = document.getElementById('dm-data-de').value;
  const ate = document.getElementById('dm-data-ate').value;
  const hoje = new Date().toISOString().slice(0,10);
  const catLabels = { refil:'refil', elemento:'elemento', bebedouro_refil:'refil de bebedouro', iron_free:'Iron Free', scale_stop:'Scale Stop', outros:'manutenção' };
  const catTxt = cats.length === 0 ? 'manutenção'
    : cats.length === 1 ? (catLabels[cats[0]] || cats[0])
    : cats.map(c => catLabels[c]||c).join('/');
  let janela = 'manutenção';
  if (ate && ate < hoje) janela = `troca atrasada (vencido até ${new Date(ate+'T12:00:00').toLocaleDateString('pt-BR')})`;
  else if (ate) janela = `vencimento próximo (até ${new Date(ate+'T12:00:00').toLocaleDateString('pt-BR')})`;
  const titulo = `Ligar — ${catTxt} · ${janela}`;
  document.getElementById('dm-t-titulo').value = titulo.slice(0, 200);
  // Default obs também
  const obsInp = document.getElementById('dm-t-obs');
  if (obsInp && !obsInp.value) {
    obsInp.value = `Cliente da base de ${catTxt}. Confirmar interesse + agendar troca/visita.`;
  }
}

async function dmGerarMotivoIA(btn){
  const cats = Array.from(document.querySelectorAll('input[name="dm-cat-cb"]:checked')).map(c => c.value).filter(Boolean);
  const de = document.getElementById('dm-data-de').value;
  const ate = document.getElementById('dm-data-ate').value;
  const leads = dmFiltrarLeads();
  if (!leads.length) { alert('Nenhum lead encontrado nos filtros — ajuste antes'); return; }
  btn.disabled = true; const orig = btn.textContent; btn.textContent = '⏳';
  try {
    const r = await fetch('/manutencao/gerar-motivo-ia', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        categorias: cats,
        periodo: { de, ate },
        amostra_count: leads.length,
        amostra_clientes: leads.slice(0, 8).map(l => ({ nome: l.nome, categoria: l.categoria, dataCompra: l.dataCompra, proximaTroca: l.proximaTroca, diasParaVencer: l.diasParaVencer, valor: l.valor })),
      }),
    });
    const d = await r.json();
    if (d.error) { alert('IA falhou: '+d.error); return; }
    if (d.titulo) document.getElementById('dm-t-titulo').value = d.titulo.slice(0,200);
    if (d.observacao) document.getElementById('dm-t-obs').value = d.observacao.slice(0,500);
    btn.style.background = '#22c55e';
    btn.textContent = '✓';
    setTimeout(() => { btn.style.background = '#a371f7'; btn.textContent = orig; }, 1500);
  } catch(e) { alert(e.message); }
  finally { btn.disabled = false; }
}
async function dmDistribuir(btn){
  const leads = dmFiltrarLeads();
  const ops = Array.from(document.querySelectorAll('input[name="dm-op-cb"]:checked')).map(c => c.value);
  if (!leads.length || !ops.length) { alert('Recalcule preview'); return; }
  // Tarefa opcional
  const criarTarefaCheck = document.getElementById('dm-criar-tarefa').checked;
  let criarTarefa = null;
  let dadosCliente = {};
  if (criarTarefaCheck) {
    const titulo = document.getElementById('dm-t-titulo').value.trim();
    const dataHora = document.getElementById('dm-t-data').value;
    if (!titulo || !dataHora) { alert('Preencha título e data da tarefa'); return; }
    criarTarefa = {
      titulo,
      dataHora: new Date(dataHora).toISOString(),
      espacarMin: parseInt(document.getElementById('dm-t-espacar').value, 10) || 0,
      lembreteMin: parseInt(document.getElementById('dm-t-lembrete').value, 10) || 5,
      observacao: document.getElementById('dm-t-obs').value || '',
    };
    // Mapa dealId → { nome, telefone } pras tarefas terem o nome do cliente
    leads.forEach(l => { dadosCliente[l.id] = { nome: l.nome, telefone: l.telefone }; });
  }
  const msg = `Distribuir ${leads.length} leads entre ${ops.length} operadora(s)?\nMédia: ${Math.ceil(leads.length/ops.length)} leads/op.${criarTarefaCheck?`\n\n📋 ${leads.length} tarefas serão criadas (1 por cliente).`:''}`;
  if (!confirm(msg)) return;
  btn.disabled = true; btn.textContent = '⏳ Distribuindo...';
  try {
    const res = await fetch('/manutencao/distribuir', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ dealIds: leads.map(c => c.id), operadora: ops, modo: 'equilibrado', criarTarefa, dadosCliente }),
    });
    const r = await res.json();
    if (r.error) { alert('Erro: '+r.error); btn.disabled = false; btn.textContent = '⚡ Distribuir'; return; }
    btn.closest('div[style*=fixed]').remove();
    let success = `✅ ${r.atribuidos} leads distribuídos entre ${ops.length} operadoras.`;
    if (r.tarefas_criadas) success += `\n📋 ${r.tarefas_criadas} tarefas criadas.`;
    alert(success);
    carregar();
  } catch(e) { alert('Erro: '+e.message); btn.disabled = false; btn.textContent = '⚡ Distribuir'; }
}

async function autoAtribuirTodos(){
  if (!_MT?.clientes?.length) { alert('Aguarde os dados carregarem'); return; }
  // Pega só clientes vencidos OU vencendo nos próximos 30 dias E sem operadora
  const candidatos = _MT.clientes.filter(c => c.diasParaVencer <= 30 && !c.operadora);
  if (!candidatos.length) { alert('✓ Todos os clientes vencendo já têm operadora atribuída.'); return; }
  const ops = (_MT.operadoras||[]).map(o => o.username);
  if (!ops.length) { alert('Nenhuma operadora cadastrada'); return; }
  if (!confirm(`Distribuir ${candidatos.length} clientes (vencidos + vencendo 30d sem operadora) entre ${ops.length} operadoras (round-robin equilibrado)?\n\nMédia: ${Math.ceil(candidatos.length/ops.length)} clientes/operadora.`)) return;
  try {
    const res = await fetch('/manutencao/distribuir', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ dealIds: candidatos.map(c => c.id), operadora: ops, modo: 'equilibrado' })
    });
    const r = await res.json();
    if (r.error) { alert('Erro: '+r.error); return; }
    alert(`✅ ${r.atribuidos} clientes distribuídos`);
    carregar();
  } catch(e){ alert('Erro: '+e.message); }
}

// ============= WATI INBOX POLLING =============
window._WATI_NOVOS = {};
async function pollWatiInbox(){
  try {
    const res = await fetch('/manutencao/wati-inbox');
    if (!res.ok) return;
    const d = await res.json();
    const novosMap = {};
    let mudou = false;
    for (const m of (d.mensagens||[])) {
      novosMap[m.dealId] = m;
      if (!_WATI_NOVOS[m.dealId] || _WATI_NOVOS[m.dealId].ts !== m.ts) mudou = true;
    }
    _WATI_NOVOS = novosMap;
    const badge = document.getElementById('wati-inbox-badge');
    if (d.total > 0) {
      badge.style.display = 'inline-block';
      badge.textContent = `💬 ${d.total} cliente(s) responderam no WATI`;
    } else {
      badge.style.display = 'none';
    }
    // Badge na tab Inbox do CRM Closy
    const tabBadge = document.getElementById('vw-inbox-badge');
    if (tabBadge) {
      if (d.total > 0) { tabBadge.style.display = 'inline-block'; tabBadge.textContent = d.total; }
      else tabBadge.style.display = 'none';
    }
    // Re-render Kanban se visível e algo mudou
    if (mudou && document.getElementById('view-kanban').style.display !== 'none') {
      renderKanban();
    }
  } catch(e){ console.warn('wati inbox:', e); }
}
pollWatiInbox();
setInterval(pollWatiInbox, 30000); // 30s

// Aplica estado inicial dos botões de view carteira (closer)
(function aplicarViewInicial(){
  const isAdmin = '<%= user.role %>' === 'admin';
  if (isAdmin) return;
  const v = _VIEW_CARTEIRA || 'todos';
  ['todos','minha','orfaos'].forEach(x => {
    const el = document.getElementById('vw-'+x);
    if (!el) return;
    if (x === v) {
      el.style.background = '#1e3a5f';
      el.style.color = '#7cb9f5';
    } else {
      el.style.background = 'none';
      el.style.color = x === 'orfaos' ? '#fbbf24' : '#888';
    }
  });
})();
</script>


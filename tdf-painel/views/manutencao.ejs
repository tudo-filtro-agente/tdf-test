async function dmDisparar(modoTeste){
  const templateName = document.getElementById('dm-template').value;
  if (!templateName) { alert('Selecione um template'); return; }
  const limite = parseInt(document.getElementById('dm-limite').value) || 50;
  const ids = [...(_SELECIONADOS)].slice(0, limite);
  if (!ids.length) { alert('Sem clientes'); return; }

  const t = _DM_TEMPLATES.find(x => x.name === templateName);
  const varCount = t?.varCount || 0;

  // Constrói paramsPorDeal a partir dos inputs (substitui {{nome}} pelo nome real)
  const paramsPorDeal = {};
  for (const id of ids) {
    const cliente = _MT.clientes.find(c => c.id === id);
    const nome = (cliente?.nome || '').split(' ')[0];
    const params = [];
    for (let i = 0; i < varCount; i++) {
      const tpl = (document.getElementById('dm-param-'+i)?.value || '').trim();
      params.push(tpl.replace(/\{\{nome\}\}/gi, nome));
    }
    paramsPorDeal[id] = params;
  }

  const tipo = modoTeste ? '🧪 MODO TESTE (nada é enviado)' : '🚀 DISPARO REAL';
  const restante = _SELECIONADOS.size - ids.length;
  const linhaRestante = restante > 0 ? `\n⚠️ ${restante} selecionados FORA do lote (aumente limite ou dispare em rodadas)` : '';
  if (!confirm(`${tipo}\n\n📨 Template: ${templateName}\n👥 Vai disparar pra: ${ids.length} clientes\n🎯 Total selecionado: ${_SELECIONADOS.size}${linhaRestante}\n⏱  Tempo estimado: ~${Math.round(ids.length*1.5/60)} min (1,5s/cada)\n\nConfirma?`)) return;

  try {
    const r = await fetch('/manutencao/disparo-massa', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ dealIds: ids, templateName, paramsPorDeal, canal: 'wati', modoTeste })
    });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    alert(`✅ Disparo iniciado em background.\n\nProcessando ${d.total} clientes${modoTeste?' (TESTE)':''}.\nVocê será notificado no Z-API ao final com resultado completo (sucessos/falhas).`);
    fecharDisparoMassa();
  } catch(e) { alert('Erro: '+e.message); }
}


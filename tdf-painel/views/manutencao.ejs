        <div style="margin-bottom:8px">
          <div style="color:#fbbf24;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;padding:4px 6px">
            ${time} (${lista.length})
            <button onclick="distToggleTeam('${time.replace(/'/g, "&#39;")}', true)" style="background:transparent;border:none;color:#7cb9f5;font-size:10px;cursor:pointer;float:right">marcar time</button>
          </div>
          ${lista.map(o => `
            <label style="display:flex;align-items:center;gap:8px;padding:6px 10px;cursor:pointer;border-radius:4px" onmouseover="this.style.background='#1a1a1a'" onmouseout="this.style.background='transparent'">
              <input type="checkbox" name="dist-op-cb" value="${o.username}" data-team="${time.replace(/"/g, '&quot;')}" checked>
              <span style="color:#fff;font-size:13px">${o.name || o.username}</span>
              <span style="color:#666;font-size:10px;margin-left:auto">${o.username}</span>
            </label>
          `).join('')}
        </div>
      `).join('')}
    </div>

    <div style="background:#0d2818;border:1px solid #22c55e;border-radius:8px;padding:10px 12px;margin-bottom:14px;font-size:11px;color:#4ade80">
      📊 <strong id="dist-resumo">Cada operadora vai receber ~${Math.ceil(dealIds.length / ops.length)} cliente(s)</strong>

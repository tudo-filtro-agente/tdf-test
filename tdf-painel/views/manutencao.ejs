async function cmpDisparar(modoTeste){
  if (!_CANDIDATOS_PREVIEW.length) { alert('Faça preview primeiro'); return; }
  const msg = modoTeste
    ? `🧪 MODO TESTE: simular disparo pra ${_CANDIDATOS_PREVIEW.length} candidatos? (NADA é enviado de verdade)`
    : `🚨 DISPARAR de verdade pra ${_CANDIDATOS_PREVIEW.length} clientes? Vai mandar WhatsApp via Núbia, criar Tarefa no Zoho e enfileirar email.`;
  if (!confirm(msg)) return;
  document.getElementById('cmp-status').textContent = 'Disparando...';
  try {
    const r = await fetch('/manutencao/automacao/disparar', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ dealIds: _CANDIDATOS_PREVIEW.map(c => c.dealId), modoTeste })
    });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    alert(`${modoTeste?'🧪 Teste OK':'✅ Disparado!'}: ${d.sucesso}/${d.total}${d.falhas?.length?`\n\nFalhas: ${d.falhas.length}`:''}`);
    if (!modoTeste) cmpPreview();
  } catch(e) { alert('Erro: '+e.message); }
  document.getElementById('cmp-status').textContent = '';
}


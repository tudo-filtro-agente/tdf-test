      </select>

      <label style="display:block;font-size:11px;color:#aaa;text-transform:uppercase;font-weight:700;margin-bottom:4px">Local da compra *</label>
      <select id="fv-local" style="width:100%;padding:10px 12px;background:#1a1a1a;border:1px solid #333;border-radius:6px;color:#fff;font-size:13px;margin-bottom:14px">
        <option value="">— selecione —</option>
        ${FECHAR_LOCAIS.map(l => `<option value="${l}" ${l===localExistente?'selected':''}>${l}</option>`).join('')}
      </select>

      <label style="display:block;font-size:11px;color:#aaa;text-transform:uppercase;font-weight:700;margin-bottom:4px">Observação (opcional)</label>
      <textarea id="fv-obs" rows="2" placeholder="Ex: parcelado em 3x, instalação combinada pra 05/06..." style="width:100%;padding:10px 12px;background:#1a1a1a;border:1px solid #333;border-radius:6px;color:#fff;font-size:13px;margin-bottom:18px;resize:vertical;font-family:inherit"></textarea>

      <div style="display:flex;gap:8px;justify-content:flex-end">
        <button id="fv-cancel" style="background:#1a1a1a;color:#aaa;border:1px solid #30363d;border-radius:6px;padding:10px 18px;font-size:13px;font-weight:700;cursor:pointer">Cancelar</button>
        <button id="fv-save" style="background:linear-gradient(135deg,#22c55e,#16a34a);color:#000;border:none;border-radius:6px;padding:10px 20px;font-size:13px;font-weight:800;cursor:pointer">✅ Confirmar venda</button>
      </div>
    </div>`;
  document.body.appendChild(overlay);
  const close = () => overlay.remove();
  overlay.addEventListener('click', e => { if (e.target === overlay) close(); });
  overlay.querySelector('#fv-cancel').onclick = close;
  overlay.querySelector('#fv-cancel-x').onclick = close;
  overlay.querySelector('#fv-valor').focus();
  overlay.querySelector('#fv-save').onclick = async () => {
    const valor = parseFloat(overlay.querySelector('#fv-valor').value);
    const produtoSel = overlay.querySelector('#fv-produto').value;
    const produtoCustom = overlay.querySelector('#fv-produto-custom').value.trim();
    const produto = produtoCustom ? (produtoSel ? `${produtoSel} — ${produtoCustom}` : produtoCustom) : produtoSel;
    const formaPagamento = overlay.querySelector('#fv-pagamento').value;
    const localCompra = overlay.querySelector('#fv-local').value;
    const observacao = overlay.querySelector('#fv-obs').value.trim();
    if (!valor || valor <= 0) { alert('Valor obrigatório e > 0'); return; }
    if (!produto) { alert('Selecione o produto vendido'); return; }
    if (!localCompra) { alert('Selecione o local da compra'); return; }
    const btn = overlay.querySelector('#fv-save');
    btn.disabled = true; btn.textContent = 'Salvando…';
    try {
      const r = await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/fechar-venda', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ valor, produto, formaPagamento, localCompra, observacao }),
      });
      const d = await r.json();
      if (d.error) throw new Error(d.error);
      close();
      const zohoMsg = d.zoho?.ok ? 'Zoho atualizado.' : 'Zoho falhou (verifique manualmente).';
      alert(`🎉 Venda fechada!\nR$ ${valor.toLocaleString('pt-BR',{minimumFractionDigits:2})} · ${produto}\n${zohoMsg}`);
      if (c) c.etapa = 'finalizado_ganho';
      if (typeof carregarManutencao === 'function') carregarManutencao();
      else if (typeof renderTabela === 'function') renderTabela();
      if (typeof fecharDrawer === 'function') fecharDrawer();
    } catch(e) {
      btn.disabled = false; btn.textContent = '✅ Confirmar venda';
      alert('Erro: '+e.message);
    }
  };
}


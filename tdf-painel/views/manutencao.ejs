function _norm(s){ return String(s||'').trim().toLowerCase(); }
function _normCidade(s){
  return _norm(s).normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[\s/.,_-]+/g,' ').replace(/\s+sp$|\s*-\s*sp$/,'');
}

// === FILA DO DIA: priorização de quem ligar agora ===
// Score 0-100. Considera urgência de vencimento + ticket + status manual + recência template.
window.PRIORIDADE_MODE = false;
function _calcPrioridade(c) {
  if (!c) return 0;
  if (c.iaAtendendo) return 0;                          // Núbia já tá cuidando
  if (['ja_fez','perdido'].includes(c.statusManual)) return 0;
  let s = 0;
  // Urgência por vencimento (0-50)
  const d = c.diasParaVencer;
  if (d <= -90) s += 50;
  else if (d <= -60) s += 42;
  else if (d <= -30) s += 34;
  else if (d <= 0)   s += 26;
  else if (d <= 30)  s += 16;
  else if (d <= 60)  s += 8;
  // Ticket estimado (0-30)
  const v = c.ticketEstimado || 0;
  if (v >= 1000)      s += 30;
  else if (v >= 500)  s += 22;
  else if (v >= 200)  s += 14;
  else if (v >= 50)   s += 6;
  // Status manual (boost ou penalty)
  if (c.statusManual === 'agendado')         s += 25;   // não esquecer dia marcado
  else if (c.statusManual === 'sem_resposta') s += 10;
  else if (c.statusManual === 'em_contato')   s += 5;
  else if (c.statusManual === 'nao_quer')     s -= 15;
  // Recência do último template (penaliza spam)
  if (c.ultimoTemplateData) {
    try {
      const dias = (Date.now() - new Date(c.ultimoTemplateData).getTime()) / 86400000;
      if (dias < 1)      s -= 18;
      else if (dias < 3) s -= 8;
      else if (dias > 14) s += 5;
    } catch(_){}
  } else {
    s += 6; // nunca foi contatado por template = mais prioritário
  }
  return Math.max(0, Math.min(100, Math.round(s)));
}
function togglePrioridade() {
  window.PRIORIDADE_MODE = !window.PRIORIDADE_MODE;
  const btn = document.getElementById('btn-prioridade');
  if (btn) {
    btn.style.background = window.PRIORIDADE_MODE ? 'linear-gradient(135deg,#fb923c,#ef4444)' : 'none';
    btn.style.color = window.PRIORIDADE_MODE ? '#fff' : '#fb923c';
  }
  renderTabela();
}

// Classifica produto como refil_bebedouro / elemento_filtrante / indefinido
// (apenas usado quando categoria principal é refil/bebedouro_refil/elemento)
function classifyRefilTipo(c) {
  const blob = `${c.produto || ''} ${c.produtoReal || ''} ${c.nomeProduto || ''}`.toLowerCase();
  if (!blob.trim()) return 'indefinido';
  // Sinais de refil de bebedouro / purificador: AF, bebedouro, BBL, sana, planeta agua, wfs, overflow, soft, bliss
  if (/bebedour|\baf\b|af\s*\d+|bbl|aguasana|sana|planeta\s*agua|wfs|over\s*flow|soft|bliss|noblesse|da\s*vinci|europa\s*(fluir|for\s*pet|bliss|hf)/i.test(blob)) {
    return 'refil_bebedouro';
  }
  // Sinais de elemento filtrante (filtro de entrada): cartucho, carbon block, elemento, american filter, FE\d, inox, fibra, tanque
  if (/cartucho|carbon\s*block|elemento|american\s*filter|filtro\s*de\s*entrada|\bfe\b\s*\d+|inox\s*\d+|fibra\s*\d+|tanque/i.test(blob)) {
    return 'elemento_filtrante';
  }
  // Genérico "refil" sem identificador → indefinido
  if (/refil/i.test(blob)) return 'indefinido';
  return 'indefinido';
}

// Mostra/esconde o sub-filtro Refil/Elemento baseado na categoria principal
function _toggleRefilSubFilter() {
  const sel = document.getElementById('f-refil-tipo');
  if (!sel) return;

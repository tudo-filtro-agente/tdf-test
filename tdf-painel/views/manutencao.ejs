    if (!porTime[t]) porTime[t] = [];
    porTime[t].push(o);
  });

  const html = `
<div id="dist-modal" style="position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:400;overflow-y:auto;padding:30px 20px" onclick="if(event.target===this)document.getElementById('dist-modal').remove()">
  <div style="max-width:620px;margin:30px auto;background:#101010;border:2px solid #a855f7;border-radius:14px;padding:24px 28px;color:#e6edf3">

function distToggleAll(checked) {
  document.querySelectorAll('input[name="dist-op-cb"]').forEach(cb => cb.checked = checked);
  const total = parseInt(document.getElementById('dist-resumo')?.dataset.total || '0', 10) ||
                (typeof _SELECIONADOS !== 'undefined' ? _SELECIONADOS.size : 0);
  distAtualizarResumo(total);
}

function distToggleTeam(time, checked) {
  document.querySelectorAll(`input[name="dist-op-cb"][data-team="${time}"]`).forEach(cb => cb.checked = checked);
  distAtualizarResumo(_SELECIONADOS?.size || 0);
}

function distAtualizarResumo(totalClientes) {
  const checked = document.querySelectorAll('input[name="dist-op-cb"]:checked').length;
  const resumo = document.getElementById('dist-resumo');
  if (!resumo) return;
  if (!checked) {
    resumo.textContent = '⚠️ Selecione pelo menos 1 operadora';
    resumo.parentElement.style.background = '#2d1215';
    resumo.parentElement.style.borderColor = '#ef4444';
    resumo.style.color = '#f87171';
  } else {
    resumo.textContent = `📊 ${checked} operadora(s) vão receber ~${Math.ceil(totalClientes / checked)} cliente(s) cada`;
    resumo.parentElement.style.background = '#0d2818';
    resumo.parentElement.style.borderColor = '#22c55e';
    resumo.style.color = '#4ade80';
  }
}

async function executarDistribuicao(dealIds) {
  const selecionadas = [...document.querySelectorAll('input[name="dist-op-cb"]:checked')].map(cb => cb.value);
  if (!selecionadas.length) { alert('Selecione pelo menos 1 operadora'); return; }
  if (!confirm(`🚀 Distribuir ${dealIds.length} cliente(s) equilibrado entre ${selecionadas.length} operadora(s) selecionada(s)?`)) return;
  try {
    const res = await fetch('/manutencao/distribuir', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ dealIds, operadora: selecionadas, modo: 'equilibrado' })
    });
    const r = await res.json();
    if (r.error) { alert('Erro: '+r.error); return; }
    alert(`✅ ${r.atribuidos} clientes atribuídos entre ${selecionadas.length} operadora(s)`);
    document.getElementById('dist-modal').remove();
    limparSelecao();
    carregar();
  } catch(e) { alert('Erro: '+e.message); }
}

function exportarSelecionados(){
  const list = clientesFiltrados().filter(c => _SELECIONADOS.has(c.id));
  if (!list.length) return;
  const csv = ['Nome,Telefone,Cidade,Produto,Categoria,Compra,Próx. Troca,Status,Operadora,Ticket'].concat(
    list.map(c => `"${c.nome}","${c.telefone}","${c.cidade}","${c.produto}","${c.categoriaLabel}","${c.dataCompra}","${c.proximaTroca}","${STATUS_LABELS[c.status]}","${c.operadora||''}",${c.ticketEstimado}`)
  ).join('\n');
  const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `manutencao-${new Date().toISOString().slice(0,10)}.csv`;
  a.click();
  URL.revokeObjectURL(url);
}

// === REGISTRAR CONTATO (Z-API / WATI / GoTo) — log timeline + auto-move etapa ===
async function registrarContato(dealId, canal, mensagem) {
  const body = { canal };
  if (mensagem) body.mensagem = mensagem;
  const res = await fetch(`/manutencao/cliente/${dealId}/registrar-contato`, {
    method:'POST', headers:{'Content-Type':'application/json'},
    body: JSON.stringify(body),
  });
  const r = await res.json();
  return r;
}

// Z-API: prompt → envia → log
async function contatoQuick(dealId, canal) {
  const c = _MT.clientes.find(x => x.id === dealId);
  if (!c) return;
  const labelCanal = canal === 'zapi' ? 'Z-API (não tem janela 24h)' : 'WATI';
  const sugerido = `Olá ${c.nome.split(' ')[0]}, aqui é da Tudo de Filtro. Tudo bem?`;
  const msg = prompt(`📱 Enviar mensagem via ${labelCanal} para ${c.nome}\nTel: ${c.telefone}\n\nDigite a mensagem:`, sugerido);
  if (!msg || !msg.trim()) return;
  try {
    const r = await registrarContato(dealId, canal, msg);
    if (r.error) { alert('❌ ' + r.error + (r.fallback ? '\n\n💡 ' + r.fallback : '')); return; }
    alert('✅ Mensagem enviada via ' + canal.toUpperCase() + '\n\nEtapa: ' + (r.etapa || '?') + '\nLogado na timeline.');
    _MT.clientes.find(x => x.id === dealId).etapa = r.etapa;
    _MT.clientes.find(x => x.id === dealId).ultimoContato = r.ultimoContato;
    if (document.getElementById('view-kanban').style.display !== 'none') renderKanban();
    renderTabela();
    if (_CLIENTE_ATUAL?.id === dealId) abrirDrawer(dealId); // refresh
  } catch(e) { alert('Erro: '+e.message); }
}

// WATI: abre o link + log "inbox aberto" (não envia automático — operador digita lá)
async function contatoWati(dealId, watiUrl) {
  // Abre o WATI numa nova aba
  window.open(watiUrl, '_blank');
  // Pergunta se quer registrar como tentativa de contato
  const msg = prompt('💬 Abriu o WATI. Se você ENVIOU uma mensagem, copie e cole aqui pra registrar na timeline (deixe vazio se só visualizou):', '');
  try {
    if (msg && msg.trim()) {
      // Tenta enviar via API session (se ainda dentro da janela 24h)
      const r = await registrarContato(dealId, 'wati', msg);
      if (r.error) {
        alert('⚠️ WATI rejeitou: ' + r.error + '\n\n💡 Use 📱 Z-API ou Disparo em Massa (template).');
      } else {
        alert('✅ Enviado via WATI session + logado.');
        _MT.clientes.find(x => x.id === dealId).etapa = r.etapa;
        _MT.clientes.find(x => x.id === dealId).ultimoContato = r.ultimoContato;
        renderTabela();
        if (document.getElementById('view-kanban').style.display !== 'none') renderKanban();
        if (_CLIENTE_ATUAL?.id === dealId) abrirDrawer(dealId);
      }
    } else {
      // Só registra que abriu
      const r = await registrarContato(dealId, 'wati', null);
      if (!r.error) {
        _MT.clientes.find(x => x.id === dealId).etapa = r.etapa;
        renderTabela();
        if (document.getElementById('view-kanban').style.display !== 'none') renderKanban();
      }
    }
  } catch(e) { alert(e.message); }
}

// GoTo: abre o discador do GoTo (call://) + registra na timeline
async function contatoGoto(dealId, telefone) {
  const phoneClean = String(telefone).replace(/\D/g,'');
  // Abre o app GoTo Connect (URL scheme) — se não estiver instalado, abre web
  window.open(`https://app.goto.com/connect/calls?destination=${encodeURIComponent('+55'+phoneClean)}`, '_blank');
  setTimeout(async () => {
    if (!confirm('📞 Você fez a ligação pelo GoTo? OK = registrar na timeline')) return;
    const obs = prompt('Resumo da ligação (opcional):', '');
    try {
      const r = await registrarContato(dealId, 'goto', obs || null);
      if (r.error) { alert('Erro: '+r.error); return; }
      alert('✅ Ligação GoTo registrada na timeline.\nEtapa: ' + (r.etapa||'?'));
      _MT.clientes.find(x => x.id === dealId).etapa = r.etapa;
      _MT.clientes.find(x => x.id === dealId).ultimoContato = r.ultimoContato;
      renderTabela();
      if (document.getElementById('view-kanban').style.display !== 'none') renderKanban();
      if (_CLIENTE_ATUAL?.id === dealId) abrirDrawer(dealId);
    } catch(e) { alert(e.message); }
  }, 500);
}

// === TAREFAS + LEMBRETES ===
function criarTarefa(dealId, nome){
  const proxHora = new Date(); proxHora.setHours(proxHora.getHours()+1, 0, 0, 0);
  const default_dt = proxHora.toISOString().slice(0,16);
  const ops = (_MT?.operadoras || []);
  const modal = document.createElement('div');
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:2500;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.innerHTML = `
    <div style="background:#0d0d0d;border:1px solid #3b82f6;border-radius:10px;padding:20px;max-width:520px;width:100%;color:#fff;max-height:90vh;overflow-y:auto">
      <h3 style="margin:0 0 12px;color:#3b82f6;font-size:15px">📋 Nova Tarefa · ${nome||''}</h3>

      <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700;display:block;margin-top:8px">Assunto/Título</label>
      <input type="text" id="tk-titulo" placeholder="Ex: Ligar pra confirmar visita às 14h" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:8px 10px;font-size:12px">

      <div style="display:grid;grid-template-columns:1fr 110px 110px;gap:8px;margin-top:10px">
        <div>
          <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700">Data e hora</label>
          <input type="datetime-local" id="tk-data" value="${default_dt}" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:8px 10px;font-size:12px">
        </div>
        <div>
          <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700">Lembrar (min)</label>
          <input type="number" id="tk-lembrete" value="5" min="0" max="120" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:8px 10px;font-size:12px">
        </div>
        <div>
          <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700">Atalho</label>
          <select id="tk-atalho" onchange="tkAtalhoSet()" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px 8px;font-size:11px">
            <option value="">— manual —</option>
            <option value="30m">+30min</option>
            <option value="1h">+1h</option>
            <option value="3h">+3h</option>
            <option value="amanha9">Amanhã 9h</option>
            <option value="amanha14">Amanhã 14h</option>
            <option value="prox-seg9">Próx. seg. 9h</option>
          </select>
        </div>
      </div>

      <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700;display:block;margin-top:10px">Responsáveis (1 ou mais)</label>
      <div id="tk-resp" style="background:#0a0a0a;border:1px solid #333;border-radius:5px;padding:8px;max-height:140px;overflow-y:auto">
        ${ops.length === 0 ? '<div style="color:#666;font-size:11px">Nenhum operador</div>' : ops.map(o => `
          <label style="display:inline-flex;align-items:center;gap:5px;background:#161616;border:1px solid #333;border-radius:4px;padding:4px 8px;margin:2px;cursor:pointer;font-size:11px">
            <input type="checkbox" name="tk-resp-cb" value="${o.username}" ${o.username===_TDF_USER?'checked':''} style="margin:0">
            ${o.name||o.username}
          </label>
        `).join('')}
      </div>

      <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700;display:block;margin-top:10px">Observação (opcional)</label>
      <textarea id="tk-obs" rows="2" placeholder="Detalhes..." style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:8px 10px;font-size:12px;resize:vertical"></textarea>

      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px">
        <button onclick="this.closest('div[style*=fixed]').remove()" style="background:#222;border:1px solid #444;color:#aaa;border-radius:5px;padding:8px 14px;cursor:pointer;font-size:12px">Cancelar</button>
        <button onclick="salvarTarefa('${dealId}','${(nome||'').replace(/'/g,"\\'")}',this)" style="background:#3b82f6;border:none;color:#fff;border-radius:5px;padding:8px 16px;cursor:pointer;font-weight:800;font-size:12px">📋 Criar</button>
      </div>
    </div>
  `;
  document.body.appendChild(modal);
  setTimeout(() => document.getElementById('tk-titulo')?.focus(), 100);
}
function tkAtalhoSet(){
  const v = document.getElementById('tk-atalho').value;
  if (!v) return;
  const dt = new Date();
  if (v === '30m') dt.setMinutes(dt.getMinutes()+30);
  else if (v === '1h') dt.setHours(dt.getHours()+1);
  else if (v === '3h') dt.setHours(dt.getHours()+3);
  else if (v === 'amanha9') { dt.setDate(dt.getDate()+1); dt.setHours(9,0,0,0); }
  else if (v === 'amanha14') { dt.setDate(dt.getDate()+1); dt.setHours(14,0,0,0); }
  else if (v === 'prox-seg9') {
    const dow = dt.getDay();
    const ate = (8 - dow) % 7 || 7;
    dt.setDate(dt.getDate() + ate);
    dt.setHours(9,0,0,0);
  }
  document.getElementById('tk-data').value = dt.toISOString().slice(0,16);
}
async function salvarTarefa(dealId, nome, btn){
  const titulo = document.getElementById('tk-titulo').value.trim();
  const dataHora = document.getElementById('tk-data').value;
  const lembreteMin = parseInt(document.getElementById('tk-lembrete').value) || 5;
  const observacao = document.getElementById('tk-obs').value;
  const checks = Array.from(document.querySelectorAll('input[name="tk-resp-cb"]:checked')).map(el => el.value);
  if (!titulo || !dataHora) { alert('Título e data são obrigatórios'); return; }
  if (!checks.length) { alert('Selecione ao menos 1 responsável'); return; }
  btn.disabled = true; btn.textContent = '⏳ Criando...';
  try {
    const r = await fetch('/tarefas', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ dealId, dealNome: nome, titulo, dataHora: new Date(dataHora).toISOString(), lembreteMin, observacao, atribuidos: checks })});
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); btn.disabled=false; btn.textContent='📋 Criar'; return; }
    btn.closest('div[style*=fixed]').remove();
    // Solicita permissão de notificação se for o caso
    if (window.Notification && Notification.permission === 'default') {
      Notification.requestPermission();
    }
    alert(`✅ Tarefa criada pra ${checks.length} pessoa(s). Avisa ${lembreteMin}min antes na tela.`);
  } catch(e) { alert(e.message); btn.disabled=false; btn.textContent='📋 Criar'; }
}

// === MÓDULO DE PROPOSTA ===
async function abrirProposta(dealId){
  const d = await fetchJson('/manutencao/cliente/'+dealId+'/proposta');
  if (d.error) { alert('Erro: '+d.error); return; }
  const p = d.proposta || { items: [] };
  const cliente = d.cliente || {};
  const empresa = d.empresa || {};
  // Garante 1 linha vazia se sem itens
  if (!p.items.length) p.items.push({ produto:'', qtd:1, valor:0, obs:'' });

  const modal = document.createElement('div');
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:2500;display:flex;align-items:center;justify-content:center;padding:14px';
  const renderItens = () => p.items.map((it, i) => `
    <div style="display:grid;grid-template-columns:50px 1fr 100px 100px 30px;gap:6px;margin-bottom:6px;align-items:center">
      <input type="number" min="1" step="1" value="${it.qtd||1}" onchange="_propUpd(${i},'qtd',this.value)" style="background:#161616;border:1px solid #333;color:#fff;border-radius:4px;padding:6px;font-size:11px">
      <input type="text" value="${(it.produto||'').replace(/"/g,'&quot;')}" placeholder="Produto/descrição" onchange="_propUpd(${i},'produto',this.value)" style="background:#161616;border:1px solid #333;color:#fff;border-radius:4px;padding:6px;font-size:11px">
      <input type="number" min="0" step="0.01" value="${it.valor||0}" onchange="_propUpd(${i},'valor',this.value)" placeholder="R$" style="background:#161616;border:1px solid #333;color:#fff;border-radius:4px;padding:6px;font-size:11px">
      <div style="color:#4ade80;font-weight:700;font-size:11px;text-align:right">R$ ${(((it.qtd||1)*(it.valor||0))||0).toFixed(2)}</div>
      <button onclick="_propRem(${i})" style="background:transparent;color:#f87171;border:1px solid #ef4444;border-radius:4px;font-size:11px;cursor:pointer;padding:5px">×</button>
    </div>
  `).join('');
  const subtotal = () => p.items.reduce((s,i) => s + ((i.qtd||1)*(i.valor||0)), 0);
  const desconto = () => parseFloat(document.getElementById('p-desc')?.value || 0);
  const total = () => Math.max(0, subtotal() - desconto());

  modal.innerHTML = `
    <div style="background:#0d0d0d;border:1px solid #f0c040;border-radius:12px;padding:18px;max-width:760px;width:100%;max-height:92vh;overflow-y:auto;color:#fff">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px">
        <span style="font-size:20px">📨</span>
        <h3 style="margin:0;font-size:16px;flex:1">Proposta · ${cliente.nome||'?'}</h3>
        <button onclick="this.closest('div[style*=fixed]').remove()" style="background:#222;border:1px solid #444;color:#aaa;border-radius:5px;padding:5px 10px;cursor:pointer;font-size:11px">✕ Fechar</button>
      </div>
      <div style="background:#161616;border-radius:6px;padding:10px;margin-bottom:12px;font-size:11px;color:#888">
        <strong style="color:#fff">${cliente.nome}</strong>${cliente.empresa?` · ${cliente.empresa}`:''}<br>
        ${cliente.telefone||'—'} · ${cliente.email||'—'} · ${cliente.cidade||'—'}
      </div>
      <h4 style="font-size:12px;color:#aaa;text-transform:uppercase;margin:0 0 8px;font-weight:700">Itens da proposta (até 10)</h4>
      <div style="display:grid;grid-template-columns:50px 1fr 100px 100px 30px;gap:6px;margin-bottom:6px;font-size:9px;color:#666;text-transform:uppercase">
        <span>Qtd</span><span>Produto</span><span>Unit.</span><span style="text-align:right">Total</span><span></span>
      </div>
      <div id="p-items">${renderItens()}</div>
      <button onclick="_propAdd()" style="background:#1f6feb;color:#fff;border:none;border-radius:5px;padding:6px 12px;font-size:11px;cursor:pointer;margin-top:6px;font-weight:700">+ Adicionar item</button>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px">
        <div><label style="font-size:10px;color:#888">Validade (data limite)</label><input type="date" id="p-val" value="${p.validade||''}" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px;font-size:11px"></div>
        <div><label style="font-size:10px;color:#888">Desconto (R$)</label><input type="number" min="0" step="0.01" id="p-desc" value="${p.desconto||0}" oninput="_propTotal()" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px;font-size:11px"></div>
        <div><label style="font-size:10px;color:#888">Forma de pagamento</label><input type="text" id="p-pag" value="${(p.formaPagamento||'').replace(/"/g,'&quot;')}" placeholder="Ex: Pix à vista, 3x cartão" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px;font-size:11px"></div>
        <div><label style="font-size:10px;color:#888">Prazo de entrega</label><input type="text" id="p-prazo" value="${(p.prazoEntrega||'').replace(/"/g,'&quot;')}" placeholder="Ex: 7 dias úteis" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px;font-size:11px"></div>
      </div>
      <label style="font-size:10px;color:#888;margin-top:10px;display:block">Observações</label>
      <textarea id="p-obs" rows="3" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px;font-size:11px;resize:vertical">${(p.observacoes||'')}</textarea>

      <div style="display:flex;gap:14px;align-items:flex-end;margin-top:14px;padding-top:14px;border-top:1px solid #333">
        <div style="flex:1">
          <div style="font-size:11px;color:#aaa">Subtotal: <strong id="p-sub" style="color:#fff">R$ ${subtotal().toFixed(2)}</strong></div>
          <div style="font-size:18px;color:#f0c040;font-weight:800;margin-top:4px">TOTAL: <span id="p-tot">R$ ${total().toFixed(2)}</span></div>
        </div>
        <button onclick="_propSalvar('${dealId}',this)" style="background:#22c55e;color:#000;border:none;border-radius:6px;padding:10px 18px;font-weight:800;font-size:12px;cursor:pointer">💾 Salvar</button>
        <button onclick="_propPDF('${dealId}',this)" style="background:#f0c040;color:#000;border:none;border-radius:6px;padding:10px 18px;font-weight:800;font-size:12px;cursor:pointer">📄 Gerar PDF</button>
      </div>
    </div>
  `;
  document.body.appendChild(modal);
  // Expõe state pro modal manipular
  window._PROPOSTA_ATUAL = p;
  window._propUpd = (i, k, v) => { p.items[i][k] = (k==='qtd'||k==='valor') ? parseFloat(v)||0 : v; _propRender(); };
  window._propAdd = () => { if (p.items.length >= 10) { alert('Máx 10 itens'); return; } p.items.push({produto:'',qtd:1,valor:0,obs:''}); _propRender(); };
  window._propRem = (i) => { p.items.splice(i,1); if(!p.items.length) p.items.push({produto:'',qtd:1,valor:0,obs:''}); _propRender(); };
  window._propTotal = () => { document.getElementById('p-sub').textContent = 'R$ '+subtotal().toFixed(2); document.getElementById('p-tot').textContent = 'R$ '+total().toFixed(2); };
  window._propRender = () => { document.getElementById('p-items').innerHTML = renderItens(); _propTotal(); };
}

function _propColetar(){
  const p = window._PROPOSTA_ATUAL;
  return {
    items: p.items.filter(i => i.produto),
    desconto: parseFloat(document.getElementById('p-desc').value) || 0,
    validade: document.getElementById('p-val').value,
    formaPagamento: document.getElementById('p-pag').value,
    prazoEntrega: document.getElementById('p-prazo').value,
    observacoes: document.getElementById('p-obs').value,
  };
}

async function _propSalvar(dealId, btn){
  const dados = _propColetar();
  if (!dados.items.length) { alert('Adicione pelo menos 1 item'); return; }
  btn.disabled = true; btn.textContent = '⏳ Salvando...';
  const d = await fetchJson('/manutencao/cliente/'+dealId+'/proposta', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(dados) });
  btn.disabled = false; btn.textContent = '💾 Salvar';
  if (d.error) { alert('❌ '+d.error); return; }
  alert('✅ Proposta salva! Total: R$ '+(d.proposta?.total||0).toFixed(2));
  // Atualiza cliente local pra refletir no kanban (soma da etapa)
  const cli = _MT.clientes.find(c => c.id === dealId);
  if (cli) { cli.proposta = d.proposta; }
  if (document.getElementById('view-kanban').style.display !== 'none') renderKanban();
}

async function _propPDF(dealId, btn){
  // Salva primeiro pra garantir que PDF reflete últimas alterações
  const dados = _propColetar();
  if (!dados.items.length) { alert('Adicione pelo menos 1 item'); return; }
  btn.disabled = true; btn.textContent = '⏳ Gerando...';
  const sav = await fetchJson('/manutencao/cliente/'+dealId+'/proposta', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(dados) });
  btn.disabled = false; btn.textContent = '📄 Gerar PDF';
  if (sav.error) { alert('❌ '+sav.error); return; }
  // Abre rota PDF em nova janela — usuário usa Cmd+P do navegador pra salvar
  window.open('/manutencao/cliente/'+dealId+'/proposta/pdf', '_blank');
}

// === CRIAR OS NO AUVO ===
let _AUVO_REFS = null;
async function carregarAuvoRefs() {
  if (_AUVO_REFS) return _AUVO_REFS;
  try {
    const r = await fetch('/auvo/refs');
    _AUVO_REFS = await r.json();
  } catch(e) { _AUVO_REFS = { taskTypes: [], users: [] }; }
  return _AUVO_REFS;
}

async function criarOsAuvo(dealId, presetEtapa) {
  const refs = await carregarAuvoRefs();
  if (!refs.taskTypes?.length || !refs.users?.length) {
    alert('Auvo sem TaskTypes ou Técnicos configurados. Verifique o painel Auvo primeiro.');
    return;
  }
  const c = _MT.clientes.find(x => x.id === dealId);
  if (!c) return;
  // Sugere próximo dia útil 09:00
  const dt = new Date();
  do { dt.setDate(dt.getDate() + 1); } while (dt.getDay() === 0 || dt.getDay() === 6);
  const sugestaoData = dt.toISOString().slice(0, 10) + 'T09:00';

  // Modal
  const modal = document.createElement('div');
  modal.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.7);z-index:2000;display:flex;align-items:center;justify-content:center;padding:20px';
  modal.innerHTML = `
    <div style="background:#0d0d0d;border:1px solid #06b6d4;border-radius:10px;padding:20px;max-width:480px;width:100%">
      <h3 style="margin:0 0 14px;color:#06b6d4;font-size:16px">📅 Criar OS Auvo · ${c.nome}</h3>
      <p style="color:#aaa;font-size:11px;margin:0 0 12px">Cliente: ${c.nome}<br>Tel: ${c.telefone||'—'} · Cidade: ${c.cidade||'—'}<br>Produto: ${c.produto||'—'}</p>
      <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700;display:block;margin-top:8px">Tipo de visita</label>
      <select id="os-tipo" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px 9px;font-size:12px">
        ${refs.taskTypes.map(t => `<option value="${t.id}">${t.descricao}</option>`).join('')}
      </select>
      <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700;display:block;margin-top:8px">Técnico</label>
      <select id="os-tecnico" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px 9px;font-size:12px">
        ${refs.users.map(u => `<option value="${u.id}">${u.nome}</option>`).join('')}
      </select>
      <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700;display:block;margin-top:8px">Data e hora</label>
      <input type="datetime-local" id="os-data" value="${sugestaoData}" style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px 9px;font-size:12px">
      <label style="font-size:10px;color:#888;text-transform:uppercase;font-weight:700;display:block;margin-top:8px">Observação (opcional)</label>
      <textarea id="os-obs" rows="3" placeholder="Ex: cliente prefere período da manhã..." style="width:100%;background:#161616;border:1px solid #333;color:#fff;border-radius:5px;padding:7px 9px;font-size:12px;resize:vertical"></textarea>
      <div style="display:flex;gap:8px;margin-top:14px;justify-content:flex-end">
        <button onclick="this.closest('div[style*=fixed]').remove()" style="background:#222;border:1px solid #444;color:#aaa;border-radius:5px;padding:7px 14px;cursor:pointer;font-size:12px">Cancelar</button>
        <button onclick="confirmarOsAuvo('${dealId}',this)" style="background:#06b6d4;border:none;color:#fff;border-radius:5px;padding:7px 14px;cursor:pointer;font-weight:700;font-size:12px">📅 Criar OS</button>
      </div>
    </div>
  `;
  document.body.appendChild(modal);
}

async function confirmarOsAuvo(dealId, btn) {
  const modal = btn.closest('div[style*=fixed]');
  const taskTypeId = parseInt(document.getElementById('os-tipo').value);
  const userTo = parseInt(document.getElementById('os-tecnico').value);
  const taskDate = document.getElementById('os-data').value;
  const obs = document.getElementById('os-obs').value;
  if (!taskTypeId || !userTo || !taskDate) { alert('Preencha tipo, técnico e data'); return; }
  btn.disabled = true; btn.textContent = '⏳ Criando...';
  try {
    const r = await fetch(`/manutencao/cliente/${dealId}/criar-os-auvo`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ taskTypeId, userTo, taskDate, observacao: obs }),
    });
    const d = await r.json();
    if (d.error) { alert('❌ ' + d.error); btn.disabled = false; btn.textContent = '📅 Criar OS'; return; }
    modal.remove();
    alert(`✅ OS Auvo criada!\n\nTask #${d.taskId}\nData: ${d.taskDate}\nEtapa atualizada: ${d.etapa}`);
    // Refresh local
    const cli = _MT.clientes.find(x => x.id === dealId);
    if (cli) cli.etapa = d.etapa;
    renderTabela();
    if (document.getElementById('view-kanban').style.display !== 'none') renderKanban();
    if (_CLIENTE_ATUAL?.id === dealId) abrirDrawer(dealId);
  } catch(e) { alert(e.message); btn.disabled = false; btn.textContent = '📅 Criar OS'; }
}

// === FUNIL TIPO ===
async function mudarFunilTipo(dealId, tipo){
  try {
    const r = await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/funil', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ tipo }),
    });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    const c = (_MT?.clientes||[]).find(x => x.id === dealId);
    if (c) c.funilTipo = tipo;
    abrirDrawer(dealId); // re-render drawer com etapas do funil novo
  } catch(e) { alert(e.message); }
}

// === IA IDENTIFICAR PRODUTO ===
async function identificarProdutoIA(dealId){
  const out = document.getElementById('ia-produto-out-'+dealId);
  if (!out) return;
  out.innerHTML = `<div style="background:#1f0d2a;border:1px solid #a371f7;border-radius:8px;padding:10px;color:#c084fc;font-size:12px">⏳ IA lendo conversa WATI + contexto Zoho... (10-20s)</div>`;
  try {
    const r = await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/identificar-produto-ia', { method: 'POST' });
    const d = await r.json();
    if (d.error) { out.innerHTML = `<div style="background:#3a0a0a;border:1px solid #ef4444;border-radius:8px;padding:10px;color:#fca5a5;font-size:12px">❌ ${d.error}</div>`; return; }
    if (!d.produto_provavel) { out.innerHTML = `<div style="background:#1a1a1a;border:1px solid #555;border-radius:8px;padding:10px;color:#aaa;font-size:11px">${d.explicacao_curta || 'Sem dados suficientes'}</div>`; return; }
    const corConfianca = d.confianca === 'alta' ? '#22c55e' : d.confianca === 'media' ? '#fbbf24' : '#ef4444';
    let html = `
      <div style="background:linear-gradient(135deg,#0d1117,#1f0d2a);border:2px solid #a371f7;border-radius:10px;padding:14px">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap">
          <span style="background:${corConfianca}22;color:${corConfianca};padding:3px 8px;border-radius:4px;font-size:10px;font-weight:800">Confiança ${d.confianca}</span>
          <strong style="color:#fff;font-size:14px">🎯 ${d.produto_provavel}${d.modelo_sugerido ? ' · '+d.modelo_sugerido : ''}</strong>
        </div>
        <div style="color:#aaa;font-size:11px;line-height:1.4;margin-bottom:8px">${d.explicacao_curta||''}</div>
        <div style="margin-bottom:8px"><span style="color:#888;font-size:10px;font-weight:700;text-transform:uppercase">Etapa atual:</span> <span style="color:#fbbf24;font-size:11px;font-weight:700">${d.etapa_atual||'?'}</span></div>
        ${d.perguntas_faltando?.length ? `
          <div style="margin-bottom:8px">
            <div style="color:#888;font-size:10px;font-weight:700;text-transform:uppercase;margin-bottom:4px">Falta perguntar:</div>
            ${d.perguntas_faltando.map(p => '<div style="color:#fff;font-size:11px;padding:3px 0">• '+p+'</div>').join('')}
          </div>
        ` : ''}
        ${d.sugestao_proxima_msg ? `
          <div style="background:rgba(34,197,94,.08);border:1px solid #22c55e;border-radius:6px;padding:10px;margin-top:8px">
            <div style="color:#22c55e;font-size:10px;font-weight:800;text-transform:uppercase;margin-bottom:4px">⚡ Mensagem sugerida</div>
            <div style="color:#fff;font-size:11.5px;line-height:1.4">${d.sugestao_proxima_msg.replace(/</g,'&lt;')}</div>
            <button onclick="navigator.clipboard.writeText(\`${(d.sugestao_proxima_msg||'').replace(/`/g,'\\`').replace(/'/g,"\\'")}\`);this.textContent='✅ Copiado'" style="margin-top:6px;background:#22c55e;color:#000;border:none;border-radius:4px;padding:4px 10px;font-size:10px;font-weight:800;cursor:pointer">📋 Copiar</button>
          </div>
        ` : ''}
        <div style="text-align:right;margin-top:8px;color:#666;font-size:9px">${d.total_mensagens} msgs analisadas</div>
      </div>
    `;
    out.innerHTML = html;
  } catch(e) { out.innerHTML = `<div style="color:#ef4444;font-size:11px">❌ ${e.message}</div>`; }
}

// === ATALHO FECHADO GANHO — modal completo ===
// 2026-06-01: modal substitui o prompt simples. Captura valor, produto, forma de
// pagamento, local da compra e observação. Atualiza Zoho + portal de uma vez.
const FECHAR_PRODUTOS = [
  'Refil de bebedouro',
  'Elemento filtrante (cartucho)',
  'Kit completo (refil + elemento)',
  'Filtro de entrada / membrana',
  'Bebedouro novo',
  'Purificador novo',
  'Iron Free',
  'Scale Stop',
  'Serviço de manutenção',
  'Outro',
];
const FECHAR_PAGAMENTOS = ['PIX', 'Cartão de crédito', 'Cartão de débito', 'Boleto', 'Dinheiro', 'Crédito em conta', 'Outro'];
const FECHAR_LOCAIS = ['Loja física','Online (site)','Tele ativo','Receptivo','WhatsApp','Visita técnica','Indicação','Outro'];

async function fecharGanhoRapido(dealId, nome) {
  return abrirModalFecharVenda(dealId, nome);
}

async function abrirModalFecharVenda(dealId, nome) {
  const c = (_MT?.clientes||[]).find(x => x.id === dealId);
  // Pré-carrega Local_Compra se já preenchido
  let localExistente = '';
  let valorSugerido = c?.ticketEstimado || '';
  let produtoSugerido = '';
  try {
    const r = await fetch('/manutencao/cliente-info/'+encodeURIComponent(dealId));
    const d = await r.json();
    localExistente = d.cliente?.localCompra || d.Local_Compra || (d.customFields||{}).Local_Compra || '';
    if (d.cliente?.amount) valorSugerido = d.cliente.amount;
    produtoSugerido = d.cliente?.produto || d.Produto_Vendido || '';
  } catch(_){}

  const overlay = document.createElement('div');
  overlay.id = 'fv-modal';
  overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:2500;display:flex;align-items:center;justify-content:center;padding:20px';
  overlay.innerHTML = `
    <div style="background:#0d0d12;border:2px solid #22c55e;border-radius:14px;padding:24px 28px;max-width:520px;width:100%;color:#e6edf3;font-family:inherit;max-height:90vh;overflow-y:auto">
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
        <span style="font-size:24px">✅</span>
        <h3 style="margin:0;color:#22c55e;font-size:17px;flex:1">Fechar Venda</h3>
        <button id="fv-cancel-x" style="background:none;border:none;color:#aaa;font-size:22px;cursor:pointer;line-height:1">×</button>
      </div>
      <div style="font-size:12px;color:#888;margin-bottom:18px;word-break:break-word">Cliente: <strong style="color:#fff">${(nome||'').replace(/[<>]/g,'')}</strong> · id ${dealId}</div>

      <label style="display:block;font-size:11px;color:#aaa;text-transform:uppercase;font-weight:700;margin-bottom:4px">Valor da venda (R$) *</label>
      <input type="number" id="fv-valor" step="0.01" min="0" placeholder="0,00" value="${valorSugerido}" style="width:100%;padding:10px 12px;background:#1a1a1a;border:1px solid #333;border-radius:6px;color:#fff;font-size:15px;font-weight:700;margin-bottom:14px">

      <label style="display:block;font-size:11px;color:#aaa;text-transform:uppercase;font-weight:700;margin-bottom:4px">Produto vendido *</label>
      <select id="fv-produto" style="width:100%;padding:10px 12px;background:#1a1a1a;border:1px solid #333;border-radius:6px;color:#fff;font-size:13px;margin-bottom:6px">
        <option value="">— selecione —</option>
        ${FECHAR_PRODUTOS.map(p => `<option value="${p}" ${p===produtoSugerido?'selected':''}>${p}</option>`).join('')}
      </select>

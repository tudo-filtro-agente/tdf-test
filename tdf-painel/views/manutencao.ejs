<script>
// Coexistência (UX #4 — opção B): drawer rico de /manutencao mantém Auvo,
// Proposta, Núbia, etc. Botão "✏️ Editor" abre drawer compartilhado por cima
// pra edição rápida campo-a-campo (com save individual + status visual).
function abrirEditorRapido(){
  if (!window._CLIENTE_ATUAL) { alert('Selecione um cliente primeiro'); return; }
  const c = window._CLIENTE_ATUAL;
  if (!window.abrirClienteDrawer) { alert('Drawer compartilhado não carregou. Recarregue a página.'); return; }
  window.abrirClienteDrawer(c.id, {
    phone: c.telefone,
    nome: c.nome,
    onAfterSave: () => {
      // Reabre o drawer rico pra ver atualização (se mantém aberto)
      if (typeof abrirDrawer === 'function' && window._CLIENTE_ATUAL?.id === c.id) abrirDrawer(c.id);
    },
  });
}
</script>


    <div class="qc-row"><span class="k">Próx. troca</span><span class="v" style="color:${c.diasParaVencer<0?'#ef4444':c.diasParaVencer<30?'#fbbf24':'#22c55e'}">${fmtData(c.proximaTroca)} <small>(${c.diasParaVencer}d)</small></span></div>
    <div class="qc-row"><span class="k">Status</span><span class="v"><span class="mt-pill ${c.status}" style="font-size:9px">${STATUS_LABELS[c.status]||c.status}</span></span></div>
    <div class="qc-row"><span class="k">Operadora</span><span class="v">${c.operadora ? '👤 '+c.operadora : '<em style="color:#666">— sem op —</em>'}</span></div>
    <div class="qc-row"><span class="k">Etapa</span><span class="v">${c.etapa||'—'}</span></div>
    <div class="qc-row"><span class="k">Ticket</span><span class="v" style="color:#22c55e;font-weight:800">${fmt(c.ticketEstimado)}</span></div>
    ${c.iaAtendendo?'<div class="qc-row"><span class="k">Núbia</span><span class="v" style="color:#c084fc">🤖 ATIVA</span></div>':''}
    ${(c.tagsLocais||[]).length ? '<div class="qc-section"><h4>Tags</h4><div class="qc-tags">' + (c.tagsLocais||[]).map(t => '<span class="qc-tag">'+t+'</span>').join('') + '</div></div>' : ''}
    <div class="qc-acts">
      ${c.telefone?`<button onclick="window.abrirChat&&abrirChat('${c.id}','${phoneClean}','${(c.nome||'').replace(/'/g,"\\'")}')">💬 Chat</button>`:''}
      ${c.telefone?`<a href="${watiUrl}" target="_blank">🌐 WATI</a>`:''}
      ${c.telefone?`<button onclick="contatoQuick('${c.id}','zapi')">📱 Z-API</button>`:''}
      <button onclick="qcAbrirCompleto()" style="background:#a371f7;color:#fff;border-color:#a371f7">📂 Drawer completo</button>
      ${c.crmLink?`<a href="${c.crmLink}" target="_blank" style="grid-column:span 2">🌐 Abrir Zoho CRM</a>`:''}
    </div>
  `;
  document.getElementById('qc-panel').classList.add('open');
}
function qcFechar(){
  document.getElementById('qc-panel').classList.remove('open');
  _QC_DEAL_ID = null;
}
function qcAbrirCompleto(){
  if (!_QC_DEAL_ID) return;
  const id = _QC_DEAL_ID;
  qcFechar();
  abrirDrawer(id);
}


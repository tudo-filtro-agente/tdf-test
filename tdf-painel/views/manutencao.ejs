      <label style="display:block;font-size:11px;color:#aaa;text-transform:uppercase;font-weight:700;margin-bottom:4px">Forma de pagamento</label>
      <select id="fv-pagamento" style="width:100%;padding:10px 12px;background:#1a1a1a;border:1px solid #333;border-radius:6px;color:#fff;font-size:13px;margin-bottom:14px">

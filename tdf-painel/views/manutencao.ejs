  if (!show) sel.value = '';
}

function clientesFiltrados(){
  if (!_MT) return [];
  const search = document.getElementById('f-search').value.toLowerCase();
  const status = document.getElementById('f-status').value;
  const cat = document.getElementById('f-cat').value;
  const cidade = document.getElementById('f-cidade').value;
  const op = _norm(document.getElementById('f-operadora').value);
  const sm = document.getElementById('f-status-manual').value;
  const refilTipo = (document.getElementById('f-refil-tipo')||{}).value || '';
  const cidadeKey = cidade ? _normCidade(cidade) : '';
  return _MT.clientes.filter(c => {
    if (search) {
      const blob = `${c.nome} ${c.telefone} ${c.cidade}`.toLowerCase();
      if (!blob.includes(search)) return false;
    }
    if (status) {
      if (status === 'vencido' && c.diasParaVencer >= 0) return false;
      if (status === 'vence_30' && (c.diasParaVencer < 0 || c.diasParaVencer > 30)) return false;
      if (status === 'vence_60' && (c.diasParaVencer < 31 || c.diasParaVencer > 60)) return false;
      if (status === 'vence_90' && (c.diasParaVencer < 61 || c.diasParaVencer > 90)) return false;
      if (status === 'vencido_30' && (c.diasParaVencer >= 0 || c.diasParaVencer < -30)) return false;
      if (status === 'vencido_60' && (c.diasParaVencer >= -30 || c.diasParaVencer < -60)) return false;
      if (status === 'vencido_90' && c.diasParaVencer >= -60) return false;
      if (status === 'futuro' && c.diasParaVencer <= 90) return false;
    }
    if (cat && c.categoria !== cat) return false;
    // Sub-filtro Refil/Elemento — só aplica se categoria selecionada e refilTipo escolhido
    if (refilTipo && ['refil','bebedouro_refil','elemento'].includes(cat)) {
      if (classifyRefilTipo(c) !== refilTipo) return false;
    }
    // Cidade — match normalizado (acentos, espaços, "- SP")
    // Cidade: busca por substring (input text com lupa, 14/Mai/2026)
    if (cidadeKey && !_normCidade(c.cidade).includes(cidadeKey)) return false;
    // Operadora — case-insensitive trim
    const cOp = _norm(c.operadora);
    if (op === '__sem' && cOp) return false;
    else if (op && op !== '' && op !== '__sem' && cOp !== op) return false;
    if (sm && c.statusManual !== sm) return false;

    // 14/Mai/2026: filtros por histórico de envio WATI (data flexível + template)
    const fOp = (document.getElementById('f-envio-op')||{}).value || '';
    const fData = (document.getElementById('f-envio-data')||{}).value || '';
    const fTpl = (document.getElementById('f-template')||{}).value || '';
    if (fOp || fTpl) {
      const ultISO = c.ultimoTemplateData ? c.ultimoTemplateData.slice(0,10) : '';
      const ultTpl = c.ultimoTemplate || '';

      // Operador "nunca recebeu" não usa data
      if (fOp === 'nunca' && ultISO) return false;
      // Demais operadores precisam de data setada
      if (fOp && fOp !== 'nunca' && !fData) return true; // sem data, ignora operador
      if (fOp === 'exato' && ultISO !== fData) return false;
      if (fOp === 'apos' && (!ultISO || ultISO <= fData)) return false;
      if (fOp === 'antes' && (!ultISO || ultISO >= fData)) return false;
      // "Sem envio desde X" = (último envio < X) OU (nunca recebeu)
      if (fOp === 'sem_desde') {
        if (ultISO && ultISO >= fData) return false;
      }

      if (fTpl && ultTpl !== fTpl) return false;
    }

    return true;
  })
  // MODO PRIORIDADE: anexa score + ordena desc + filtra score>0 + limita top 30
  .map(c => window.PRIORIDADE_MODE ? Object.assign({_prio: _calcPrioridade(c)}, c) : c)
  .filter(c => window.PRIORIDADE_MODE ? (c._prio || 0) > 0 : true)
  .sort((a, b) => window.PRIORIDADE_MODE ? (b._prio || 0) - (a._prio || 0) : 0)
  .slice(0, window.PRIORIDADE_MODE ? 30 : 99999);
}

// 14/Mai/2026: Modal pra unificar cidades duplicadas (TAUBATE/TAUBATÉ/Taubaté → Taubaté)
async function abrirUnificarCidades() {
  if (!window._CIDADE_GRUPOS) { alert('Aguarde os dados carregarem.'); return; }
  const grupos = Object.values(window._CIDADE_GRUPOS).filter(g => g.variacoes.size > 1);
  if (!grupos.length) { alert('✅ Nenhuma cidade duplicada encontrada!'); return; }
  grupos.sort((a,b) => b.variacoes.size - a.variacoes.size);

  const html = `
<div id="unif-modal" style="position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:400;overflow-y:auto;padding:30px 20px" onclick="if(event.target===this)document.getElementById('unif-modal').remove()">
  <div style="max-width:780px;margin:30px auto;background:#101010;border:2px solid #fbbf24;border-radius:14px;padding:24px 28px;color:#e6edf3">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
      <h2 style="font-size:18px;color:#fff;margin:0;flex:1">🔧 Unificar Cidades Duplicadas</h2>
      <button onclick="document.getElementById('unif-modal').remove()" style="background:none;border:none;color:#aaa;font-size:24px;cursor:pointer">×</button>
    </div>
    <div style="background:#0d1f3a;border:1px solid #1e3a5f;border-radius:8px;padding:12px;margin-bottom:14px;font-size:12px;color:#7cb9f5">
      Encontrei <strong>${grupos.length} cidade(s)</strong> com variações duplicadas. Marque as que quer unificar (vai atualizar todos os deals no Zoho pra forma canônica escolhida).
    </div>
    <div style="max-height:50vh;overflow-y:auto;border:1px solid #333;border-radius:8px;padding:8px;margin-bottom:14px">
      ${grupos.map((g, i) => `
        <label style="display:flex;align-items:flex-start;gap:10px;padding:10px;border-bottom:1px solid #222;cursor:pointer">
          <input type="checkbox" name="unif-cb" value="${i}" checked style="margin-top:3px">
          <div style="flex:1">
            <div style="color:#fbbf24;font-weight:700;font-size:13px">
              Canônica: <input type="text" id="unif-canon-${i}" value="${g.canonica}" style="background:#1a1a1a;border:1px solid #333;border-radius:4px;color:#fff;padding:3px 8px;font-size:12px;width:200px;font-weight:700">
              <span style="color:#888;font-weight:400;margin-left:8px">${g.count} cliente(s)</span>
            </div>
            <div style="color:#888;font-size:11px;margin-top:4px">
              Variações: ${[...g.variacoes].map(v => `<span style="background:#222;padding:2px 6px;border-radius:3px;margin-right:4px">${v}</span>`).join('')}
            </div>
          </div>
        </label>
      `).join('')}
    </div>
    <div style="display:flex;gap:8px;justify-content:flex-end">
      <button onclick="document.getElementById('unif-modal').remove()" style="background:#1a1a1a;color:#aaa;border:1px solid #333;border-radius:8px;padding:9px 14px;font-size:12px;font-weight:700;cursor:pointer">Cancelar</button>
      <button onclick="executarUnificacao(${JSON.stringify(grupos).replace(/"/g,'&quot;')})" style="background:#0d2818;color:#4ade80;border:2px solid #22c55e;border-radius:8px;padding:9px 18px;font-size:13px;font-weight:800;cursor:pointer">🚀 Unificar Selecionadas</button>
    </div>
  </div>
</div>`;
  document.body.insertAdjacentHTML('beforeend', html);
}

async function executarUnificacao(grupos) {
  const checks = document.querySelectorAll('input[name="unif-cb"]:checked');
  if (!checks.length) { alert('Selecione pelo menos 1 cidade pra unificar'); return; }
  const ops = [];
  checks.forEach(cb => {
    const i = parseInt(cb.value, 10);
    const g = grupos[i];
    const canonInp = document.getElementById('unif-canon-'+i);
    const canon = (canonInp?.value || g.canonica).trim();
    if (!canon) return;
    // variações = todas EXCETO a canônica final (se a canônica final estiver entre variações, mantém)
    const variacoes = [...g.variacoes].filter(v => v !== canon);
    if (!variacoes.length) return; // nada pra mudar
    ops.push({ canonica: canon, variacoes });
  });
  if (!ops.length) { alert('Nada pra fazer (cidade canônica = todas as variações)'); return; }
  const total = ops.reduce((s, o) => s + o.variacoes.length, 0);
  if (!confirm(`🚀 Vai unificar ${ops.length} cidade(s) (${total} variações).\n\nTodos os deals com variação vão ser atualizados pra cidade canônica.\n\nConfirma?`)) return;

  try {
    const r = await fetch('/manutencao/unificar-cidades', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ ops })
    });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    alert(`✅ Unificação iniciada em background.\n\n${d.totalGrupos} grupo(s), ${d.totalDeals} deal(s) a atualizar.\nVocê será notificado no Z-API quando terminar.`);
    document.getElementById('unif-modal').remove();
  } catch(e) { alert('Erro: '+e.message); }
}


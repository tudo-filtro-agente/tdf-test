async function edSalvarCampo(dealId, campo, tipo){
  const id = `ed-${dealId}-${campo}`;
  const inp = document.getElementById(id+'-input');
  const status = document.getElementById(id+'-status');
  if (!inp) return;
  const valor = inp.value;
  status.textContent = '⏳';
  status.style.color = '#888';
  try {
    const r = await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/campo', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ campo, valor }),
    });
    const d = await r.json();
    if (d.error) { status.textContent = '❌ '+d.error; status.style.color = '#ef4444'; return; }
    const localOnly = ['Telefone_2','Tipo_Pessoa','Nome_Empresa','Contato_Nome','Contato_Cargo','Data_Compra','Proxima_Manutencao','Frequencia_Refil_Meses','Observacao_Recorrencia'].includes(campo);
    if (localOnly) {
      status.textContent = '✅ salvo (local)';
      status.style.color = '#22c55e';
    } else {
      status.textContent = '✅ salvo' + (!d.zoho_atualizado ? ' (local; Zoho falhou)' : '');
      status.style.color = d.zoho_atualizado ? '#22c55e' : '#fbbf24';
    }
    // Atualiza view
    const viewEl = document.getElementById(id+'-view').querySelector('span');
    if (viewEl) {
      let txt;
      if (tipo === 'money') txt = edFmtMoney(d.valor_novo);
      else if (tipo === 'date' && d.valor_novo) {
        try { txt = new Date(String(d.valor_novo)+'T12:00:00').toLocaleDateString('pt-BR'); }
        catch(_) { txt = d.valor_novo; }
      } else txt = d.valor_novo || 'vazio';
      viewEl.textContent = txt;
    }
    setTimeout(() => edCancelar(dealId, campo), 800);
  } catch(e) { status.textContent = '❌ '+e.message; status.style.color = '#ef4444'; }
}
async function edBuscarCep(dealId){
  const inp = document.getElementById('ed-cep-'+dealId);
  const msg = document.getElementById('ed-cep-msg-'+dealId);
  const cep = (inp.value || '').replace(/\D/g, '');
  if (cep.length !== 8) { msg.textContent = '❌ CEP precisa ter 8 dígitos'; msg.style.color = '#ef4444'; return; }
  msg.textContent = '⏳ Consultando ViaCEP...';
  msg.style.color = '#888';
  try {
    const r = await fetch('/cep/'+cep);
    const d = await r.json();
    if (d.error) { msg.textContent = '❌ '+d.error; msg.style.color = '#ef4444'; return; }
    msg.innerHTML = `✅ ${d.logradouro}, ${d.bairro} — ${d.cidade}/${d.estado}. <button onclick="edPreencherEndereco('${dealId}',${JSON.stringify(d).replace(/"/g,'&quot;')})" style="background:#22c55e;color:#000;border:none;border-radius:3px;padding:2px 8px;font-size:10px;font-weight:800;cursor:pointer">Preencher tudo</button>`;
    msg.style.color = '#22c55e';
  } catch(e) { msg.textContent = '❌ '+e.message; msg.style.color = '#ef4444'; }
}
async function edPreencherEndereco(dealId, endereco){
  // Aplica nos 4 campos do Zoho via batch
  const campos = [
    ['CEP', endereco.cep || ''],
    ['Endere_o', endereco.logradouro || ''],
    ['Bairro', endereco.bairro || ''],
    ['Cidade', endereco.cidade || ''],
    ['Estado', endereco.estado || ''],
  ];
  for (const [campo, valor] of campos) {
    if (!valor) continue;
    try {
      const r = await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/campo', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ campo, valor }),
      });
      const j = await r.json();
      if (!j.error) {
        const viewEl = document.querySelector(`#ed-${dealId}-${campo}-view span`);
        if (viewEl) viewEl.textContent = valor;
      }
    } catch(_){}
  }
  alert('✅ Endereço preenchido a partir do CEP. Histórico de mudanças registrado.');
}

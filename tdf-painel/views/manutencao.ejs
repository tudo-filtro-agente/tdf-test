let _DM_TEMPLATES = [];

async function abrirDisparoMassa(){
  if (!_SELECIONADOS.size) { alert('Selecione clientes primeiro'); return; }
  const totalSel = _SELECIONADOS.size;
  document.getElementById('dm-info-count').textContent = `${totalSel} cliente(s) selecionados`;
  // 14/Mai/2026: auto-ajustar input "Limite" pra refletir seleção real (até 200 max).
  // Antes ficava fixo em 50 e enganava o Paulo: ele selecionava 100 mas popup dizia "50".
  const limInp = document.getElementById('dm-limite');
  if (limInp) limInp.value = Math.min(200, totalSel);
  document.getElementById('dm-modal').style.display = 'block';
  // Carrega templates uma vez
  if (!_DM_TEMPLATES.length) {
    try {
      const r = await fetch('/manutencao/wati-templates');
      const d = await r.json();
      _DM_TEMPLATES = d.templates || [];
      const sel = document.getElementById('dm-template');
      if (d.error || !_DM_TEMPLATES.length) {
        sel.innerHTML = `<option value="">⚠️ ${d.error||'Nenhum template aprovado'} — configure WATI_TOKEN no Railway</option>`;
      } else {
        sel.innerHTML = '<option value="">Selecione um template...</option>' +
          _DM_TEMPLATES.map(t => `<option value="${t.name}">${t.name} ${t.varCount?`(${t.varCount} vars)`:''}</option>`).join('');
      }
    } catch(e) {
      document.getElementById('dm-template').innerHTML = `<option value="">Erro: ${e.message}</option>`;
    }
  }
}
function fecharDisparoMassa(){ document.getElementById('dm-modal').style.display = 'none'; }


async function fecharPerdidoConfirma(dealId, nome, btn){
  const motivo = document.getElementById('fp-motivo').value;
  if (!motivo) { alert('Selecione o motivo'); return; }
  btn.disabled = true; btn.textContent = '⏳';
  try {
    // Caso especial: motivos que reagendam pra base
    if (motivo === 'Comprou refil em outro lugar (volta pra base)' || motivo === 'Não quer agora') {
      const dataRecontato = document.getElementById('fp-recontato')?.value;
      if (!dataRecontato) { alert('Defina data de recontato'); btn.disabled=false; btn.textContent='Confirmar'; return; }
      const r = await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/reagendar-base', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ dataRecontato, motivo }),
      });
      const d = await r.json();
      if (d.error) { alert('Erro: '+d.error); btn.disabled=false; btn.textContent='Confirmar'; return; }
      btn.closest('div[style*=fixed]').remove();
      alert(`🔄 ${nome} voltou pra base. Recontato agendado pra ${dataRecontato}.`);
    } else if (motivo === 'Trocou de aparelho (precisa reabrir)') {
      const novoProduto = document.getElementById('fp-novoProduto')?.value?.trim();
      const ultimaManut = document.getElementById('fp-ultimaManut')?.value;
      const proxManut = document.getElementById('fp-proxManut')?.value;
      if (!novoProduto) { alert('Informe o novo aparelho'); btn.disabled=false; btn.textContent='Confirmar'; return; }
      // Atualiza produto + datas + volta pra base
      const updates = [
        { campo: 'Produto_Vendido', valor: novoProduto },
      ];
      if (ultimaManut) updates.push({ campo: 'ultima_manuten_o', valor: ultimaManut });
      if (proxManut) updates.push({ campo: 'Proxima_Manutencao', valor: proxManut });
      for (const u of updates) {
        await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/campo', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify(u),
        });
      }
      // Volta pra base
      await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/reagendar-base', {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ dataRecontato: proxManut || new Date(Date.now()+330*86400000).toISOString().slice(0,10), motivo: 'Trocou de aparelho · novo: '+novoProduto }),
      });
      btn.closest('div[style*=fixed]').remove();
      alert(`🔄 ${nome} reaberto. Novo aparelho: ${novoProduto}.`);
    } else {
      // Perdido normal
      const obs = document.getElementById('fp-obs')?.value || '';
      const r = await fetch('/manutencao/etapa/'+encodeURIComponent(dealId), {
        method: 'POST', headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ etapa: 'finalizado_perdido', motivoPerda: motivo, observacaoEtapa: obs }),
      });
      const d = await r.json();
      if (d.error) { alert('Erro: '+d.error); btn.disabled=false; btn.textContent='Confirmar'; return; }
      btn.closest('div[style*=fixed]').remove();
      alert(`❌ ${nome} marcado como perdido. Motivo: ${motivo}`);
    }
    if (typeof carregarManutencao === 'function') carregarManutencao();
    fecharDrawer();
  } catch(e) {
    alert(e.message);
    btn.disabled = false; btn.textContent = 'Confirmar';
  }
}

async function toggleNubiaAtende(dealId, btn){
  const cliente = (_MT?.clientes||[]).find(x => x.id === dealId);
  const novo = !(cliente?.iaAtendendo);
  if (novo && !confirm('🤖 Ativar Núbia pra atender este lead automaticamente quando ele responder?')) return;
  try {
    const r = await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/iaAtende', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ ativo: novo }),
    });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    if (cliente) cliente.iaAtendendo = novo;
    if (btn) {
      btn.style.background = novo ? '#a371f7' : 'transparent';
      btn.style.color = novo ? '#fff' : '#a371f7';
      btn.textContent = novo ? '🤖 Núbia ATIVA' : '🤖 Ativar Núbia';
    }
    // Re-render tabela pra atualizar ícone na linha
    if (typeof renderTabela === 'function') renderTabela();
  } catch(e) { alert(e.message); }
}

async function dispararNubia(dealId, nome){
  if (!confirm(`Pedir pra Núbia entrar em contato com "${nome}"?`)) return;
  try {
    const res = await fetch('/cockpit/nubia-meu-lead', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ dealId })
    });
    const r = await res.json();
    if (r.error) { alert('Erro: '+r.error); return; }
    alert('🤖 Núbia disparada!');
  } catch(e) { alert('Erro: '+e.message); }
}


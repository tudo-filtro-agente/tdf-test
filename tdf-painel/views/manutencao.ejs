async function salvarMeta(){
  if (!_CLIENTE_ATUAL) return;
  const body = {
    operadora: document.getElementById('d-op').value || null,
    statusManual: document.getElementById('d-sm').value || null,
    observacao: document.getElementById('d-obs').value || '',
    ultimoContato: document.getElementById('d-uc').value || null,
  };
  const novaEtapa = document.getElementById('d-etapa')?.value;

  // Se etapa mudou, salva separadamente (endpoint próprio que registra timeline)
  if (novaEtapa && novaEtapa !== _CLIENTE_ATUAL.etapa) {
    let etapaPayload = { etapa: novaEtapa };
    if (novaEtapa === 'finalizado_perdido') {
      const motivo = prompt('Motivo da perda?\n\n' + (window._MOTIVOS_PERDA||[]).map((m,i) => `${i+1}. ${m}`).join('\n') + '\n\nDigite o número OU escreva o motivo:');
      if (!motivo) return;
      const idx = parseInt(motivo) - 1;
      etapaPayload.motivoPerda = (window._MOTIVOS_PERDA && window._MOTIVOS_PERDA[idx]) || motivo;
    }
    const r1 = await fetch('/manutencao/etapa/'+_CLIENTE_ATUAL.id, { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(etapaPayload) });
    const j1 = await r1.json();
    if (j1.error) { alert('Erro etapa: '+j1.error); return; }
    _CLIENTE_ATUAL.etapa = novaEtapa;
    if (etapaPayload.motivoPerda) _CLIENTE_ATUAL.motivoPerda = etapaPayload.motivoPerda;
  }

  const res = await fetch('/manutencao/cliente/'+_CLIENTE_ATUAL.id, {
    method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
  });
  const r = await res.json();
  if (r.error) { alert('Erro: '+r.error); return; }
  Object.assign(_CLIENTE_ATUAL, body);
  alert('✅ Salvo');
  fecharDrawer();
  carregar(); // recarrega pra pegar timeline atualizada
}


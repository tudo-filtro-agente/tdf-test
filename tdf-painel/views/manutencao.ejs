// === EDITOR TABBED COM HISTÓRICO ===
function edEscape(s){ return String(s||'').replace(/[<>&"']/g, c => ({'<':'&lt;','>':'&gt;','&':'&amp;','"':'&quot;',"'":'&#39;'}[c])); }
function edFmtMoney(v){ return v != null && v !== '' ? 'R$ '+Number(v).toLocaleString('pt-BR',{minimumFractionDigits:2,maximumFractionDigits:2}) : '—'; }
function edRenderField(dealId, campo, label, valor, tipo, opcoes){
  const id = `ed-${dealId}-${campo}`;
  const val = valor == null ? '' : String(valor);
  let display = val ? edEscape(val) : '<em style="color:#666">vazio</em>';
  if (tipo === 'money') display = edFmtMoney(valor);
  else if (tipo === 'date' && val) {
    try { display = new Date(val + (val.length === 10 ? 'T12:00:00' : '')).toLocaleDateString('pt-BR'); }
    catch(_) { display = val; }
  }
  let inputHtml;
  if (tipo === 'textarea') {
    inputHtml = `<textarea id="${id}-input" rows="3" style="width:100%;padding:6px 8px;background:#161616;border:1px solid #a371f7;color:#fff;border-radius:4px;font-size:12px;resize:vertical">${edEscape(val)}</textarea>`;
  } else if (tipo === 'select' && Array.isArray(opcoes)) {
    inputHtml = `<select id="${id}-input" style="width:100%;padding:6px 8px;background:#161616;border:1px solid #a371f7;color:#fff;border-radius:4px;font-size:12px"><option value="">— selecione —</option>${opcoes.map(o => `<option value="${edEscape(o)}" ${o===val?'selected':''}>${edEscape(o)}</option>`).join('')}</select>`;
  } else {
    const inpType = tipo === 'money' || tipo === 'number' ? 'number' : tipo === 'date' ? 'date' : (tipo === 'tel' ? 'tel' : (tipo === 'email' ? 'email' : 'text'));
    const stepAttr = tipo === 'money' ? 'step="0.01"' : tipo === 'number' ? 'step="1"' : '';
    inputHtml = `<input id="${id}-input" type="${inpType}" ${stepAttr} value="${edEscape(val)}" style="width:100%;padding:6px 8px;background:#161616;border:1px solid #a371f7;color:#fff;border-radius:4px;font-size:12px">`;
  }
  return `
    <div style="display:flex;align-items:start;gap:8px;padding:6px 0;border-bottom:1px solid #1a1a1a;margin-bottom:2px">
      <span style="color:#888;font-size:10px;font-weight:700;text-transform:uppercase;width:130px;flex-shrink:0;padding-top:5px">${label}</span>
      <div style="flex:1;min-width:0" id="${id}-wrap">
        <div id="${id}-view" style="display:flex;align-items:center;gap:6px">
          <span style="color:#fff;font-size:12px;flex:1;word-break:break-word">${display}</span>
          <button onclick="edEditar('${dealId}','${campo}','${tipo}',this)" title="Editar campo (com auditoria)" style="background:transparent;border:1px solid #30363D;color:#888;border-radius:4px;padding:2px 7px;font-size:11px;cursor:pointer">✏️</button>
        </div>
        <div id="${id}-edit" style="display:none">
          ${inputHtml}
          <div style="display:flex;gap:4px;margin-top:5px">
            <button onclick="edSalvarCampo('${dealId}','${campo}','${tipo}')" style="background:#22c55e;color:#000;border:none;border-radius:4px;padding:5px 10px;font-size:10px;font-weight:800;cursor:pointer">💾 Salvar</button>
            <button onclick="edCancelar('${dealId}','${campo}')" style="background:transparent;color:#888;border:1px solid #30363D;border-radius:4px;padding:5px 10px;font-size:10px;font-weight:700;cursor:pointer">Cancelar</button>
            <span id="${id}-status" style="margin-left:auto;font-size:10px"></span>
          </div>
        </div>
      </div>
    </div>
  `;
}
function edTab(dealId, tab){
  ['geral','pj','endereco','recorrencia','hist','compras'].forEach(t => {
    const btn = document.getElementById(`edt-${dealId}-${t}`);
    const pane = document.getElementById(`edp-${dealId}-${t}`);
    if (!btn || !pane) return;
    if (t === tab) {
      btn.style.background = '#2d1525';
      btn.style.color = '#c084fc';
      btn.style.borderBottom = '2px solid #c084fc';
      pane.style.display = '';
    } else {
      btn.style.background = 'transparent';
      btn.style.color = t === 'recorrencia' ? '#fbbf24' : '#888';
      btn.style.borderBottom = 'none';
      pane.style.display = 'none';
    }
  });
  if (tab === 'hist') edCarregarHist(dealId);
  if (tab === 'compras') edCarregarCompras(dealId);
  if (tab === 'recorrencia') edAtualizarBannerRecorrencia(dealId);
}

// Calcula próxima manutenção: data_compra (ou ultima_manuten_o) + freq_meses
async function edCalcularProximaManut(dealId){
  // Pega valores atuais via cliente-info
  try {
    const r = await fetch('/manutencao/cliente-info/'+encodeURIComponent(dealId));
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    const cli = d.cliente || {};
    const baseDate = cli.ultimaManutencao || cli.dataCompra || '';
    const freq = parseInt(cli.frequenciaRefilMeses, 10);
    if (!baseDate || !freq) { alert('Preencha primeiro: Data da compra (ou Última manutenção) + Frequência refil em meses.'); return; }
    const base = new Date(baseDate + 'T12:00:00');
    base.setMonth(base.getMonth() + freq);
    const proxima = base.toISOString().slice(0,10);
    // Salva via endpoint
    const r2 = await fetch('/manutencao/cliente/'+encodeURIComponent(dealId)+'/campo', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ campo: 'Proxima_Manutencao', valor: proxima }),
    });
    const j2 = await r2.json();
    if (j2.error) { alert('Erro: '+j2.error); return; }
    alert(`✅ Próxima manutenção: ${new Date(proxima+'T12:00:00').toLocaleDateString('pt-BR')}`);
    // Atualiza view + banner
    const viewSpan = document.querySelector(`#ed-${dealId}-Proxima_Manutencao-view span`);
    if (viewSpan) viewSpan.textContent = new Date(proxima+'T12:00:00').toLocaleDateString('pt-BR');
    edAtualizarBannerRecorrencia(dealId);
  } catch(e) { alert(e.message); }
}

async function edAtualizarBannerRecorrencia(dealId){
  const banner = document.getElementById(`ed-rec-banner-${dealId}`);
  if (!banner) return;
  try {
    const r = await fetch('/manutencao/cliente-info/'+encodeURIComponent(dealId));
    const d = await r.json();
    if (d.error || !d.cliente) return;
    const cli = d.cliente;
    const proxima = cli.proximaManutencao;
    if (!proxima) {
      banner.innerHTML = '<div style="background:#1a1a1a;border:1px dashed #555;border-radius:6px;padding:10px;font-size:11px;color:#888;text-align:center">Sem próxima manutenção definida.<br>Preencha Data da compra + Frequência e clique em "⚙️ Calcular".</div>';
      return;
    }
    const dt = new Date(proxima + 'T12:00:00');
    const hoje = new Date(); hoje.setHours(12,0,0,0);
    const dias = Math.round((dt.getTime() - hoje.getTime()) / 86400000);
    let cor, icon, status, urgencia;
    if (dias < 0) { cor = '#ef4444'; icon = '🔥'; status = `ATRASADO ${Math.abs(dias)}d`; urgencia = 'CHAME AGORA — recorrência vencida'; }
    else if (dias <= 30) { cor = '#f97316'; icon = '⚡'; status = `${dias}d pra venda`; urgencia = 'Aproveitar momento — cliente provavelmente já lembrou'; }
    else if (dias <= 90) { cor = '#fbbf24'; icon = '💡'; status = `${dias}d pra venda`; urgencia = 'Programar contato 15-30d antes'; }
    else { cor = '#22c55e'; icon = '✅'; status = `${dias}d pra venda`; urgencia = 'No prazo — só monitorar'; }
    banner.innerHTML = `
      <div style="background:linear-gradient(135deg,${cor}11,${cor}22);border:2px solid ${cor};border-radius:8px;padding:12px;display:flex;gap:10px;align-items:center">
        <span style="font-size:28px">${icon}</span>
        <div style="flex:1">
          <div style="color:${cor};font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.4px">Oportunidade de venda recorrente</div>
          <div style="color:#fff;font-size:14px;font-weight:800;margin:3px 0">${status} · ${dt.toLocaleDateString('pt-BR')}</div>
          <div style="color:#aaa;font-size:11px">${urgencia}</div>
        </div>
      </div>
    `;
  } catch(e) { console.warn('banner rec:', e); }
}

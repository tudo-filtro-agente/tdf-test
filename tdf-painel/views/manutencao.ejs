async function edEnriquecerDoZoho(dealId){
  // Faz fetch ao /manutencao/cliente-info pra puxar campos não disponíveis em _MT.clientes
  // (CPF, CEP, Endereço, Bairro, Estado, Email, Tipo_de_Agua, Telefone_2, Description)
  // e atualiza apenas as views dos fields no editor sem re-renderizar o drawer todo.
  try {
    const r = await fetch('/manutencao/cliente-info/'+encodeURIComponent(dealId));
    const d = await r.json();
    if (d.error || !d.cliente) return;
    const cli = d.cliente;
    const closy = d.closy || {};
    const updates = {
      Email: { v: cli.email || '', tipo: 'text' },
      CPF: { v: cli.cpf || '', tipo: 'text' },
      CEP: { v: cli.cep || '', tipo: 'text' },
      Endere_o: { v: cli.endereco || '', tipo: 'text' },
      N_mero: { v: cli.numero || '', tipo: 'text' },
      Bairro: { v: cli.bairro || '', tipo: 'text' },
      Estado: { v: cli.estado || '', tipo: 'text' },
      Tipo_de_Agua: { v: cli.tipoAgua || '', tipo: 'text' },
      Description: { v: cli.description || '', tipo: 'text' },
      Telefone_2: { v: cli.telefone2 || '', tipo: 'text' },
      // Campos locais novos
      Tipo_Pessoa: { v: cli.tipoPessoa || '', tipo: 'text' },
      Nome_Empresa: { v: cli.nomeEmpresa || '', tipo: 'text' },
      Contato_Nome: { v: cli.contatoNome || '', tipo: 'text' },
      Contato_Cargo: { v: cli.contatoCargo || '', tipo: 'text' },
      Data_Compra: { v: cli.dataCompra || '', tipo: 'date' },
      ultima_manuten_o: { v: cli.ultimaManutencao || '', tipo: 'date' },
      Proxima_Manutencao: { v: cli.proximaManutencao || '', tipo: 'date' },
      Frequencia_Refil_Meses: { v: cli.frequenciaRefilMeses || '', tipo: 'number' },
      Observacao_Recorrencia: { v: cli.observacaoRecorrencia || '', tipo: 'text' },
    };
    for (const [campo, info] of Object.entries(updates)) {
      const viewSpan = document.querySelector(`#ed-${dealId}-${campo}-view span`);
      if (!viewSpan) continue;
      if (info.v || info.v === 0) {
        let txt = info.v;
        if (info.tipo === 'date') {
          try { txt = new Date(String(info.v)+'T12:00:00').toLocaleDateString('pt-BR'); }
          catch(_) { txt = info.v; }
        }
        viewSpan.textContent = txt;
        viewSpan.style.fontStyle = 'normal';
      }
    }
    // Pré-preenche campo CEP standalone na aba Endereço
    const cepInp = document.getElementById('ed-cep-'+dealId);
    if (cepInp && cli.cep && !cepInp.value) cepInp.value = cli.cep;
  } catch(e) { console.warn('edEnriquecerDoZoho:', e); }
}

// === CALCULADORA DE MANUTENÇÃO NO DRAWER ===
let _CALC_PRODS = null;
async function carregarProdutosCalc(categoriaPriorizar){
  const sel = document.getElementById('d-calc-prod');
  if (!sel) return;
  if (!_CALC_PRODS) {
    try {
      const r = await fetch('/closy/produtos');
      const d = await r.json();
      _CALC_PRODS = d.produtos || [];
    } catch(e) { _CALC_PRODS = []; }
  }
  const ativos = _CALC_PRODS.filter(p => p.ativo !== false);
  // Categoria do cliente vem primeiro, depois resto
  const daCat = ativos.filter(p => p.categoria === categoriaPriorizar);
  const outros = ativos.filter(p => p.categoria !== categoriaPriorizar);
  const ordenado = [...daCat, ...outros];
  sel.innerHTML = '<option value="">— só deslocamento —</option>' +
    ordenado.map(p => `<option value="${p.id}">${p.nome} · R$ ${Number(p.precoManutencao).toLocaleString('pt-BR')}</option>`).join('');
  // Se houver produtos da categoria, pré-seleciona o primeiro
  if (daCat.length) sel.value = daCat[0].id;
}

async function calcManutencao(dealId){
  const cep = (document.getElementById('d-calc-cep').value || '').replace(/\D/g, '');
  const prod = document.getElementById('d-calc-prod').value;
  const out = document.getElementById('d-calc-out');
  if (cep.length !== 8) { out.innerHTML = '<div style="color:#ef4444;font-size:11px;padding:6px">CEP inválido (precisa 8 dígitos)</div>'; return; }
  out.innerHTML = '<div style="color:#888;font-size:11px;padding:6px">⏳ Calculando...</div>';
  try {
    const r = await fetch('/manutencao/calcular-preco?cep=' + cep + (prod ? '&produtoId='+prod : ''));
    const d = await r.json();
    if (d.error) { out.innerHTML = '<div style="color:#ef4444;font-size:11px;padding:6px">'+d.error+'</div>'; return; }
    window._CALC_RESULT = { dealId, cep, total: d.total, produto: d.produto?.nome||null };
    out.innerHTML = `
      <div style="background:#161616;border-radius:6px;padding:8px 10px;font-size:11px">
        <div style="display:flex;justify-content:space-between;padding:3px 0"><span style="color:#aaa">📐 Distância</span><span style="color:#fff;font-weight:700">${d.distanciaKm} km</span></div>
        <div style="display:flex;justify-content:space-between;padding:3px 0"><span style="color:#aaa">🎯 Destino</span><span style="color:#fff">${d.destino.city}/${d.destino.state}</span></div>
        ${d.produto ? `<div style="display:flex;justify-content:space-between;padding:3px 0;border-top:1px solid #222;margin-top:3px;padding-top:6px"><span style="color:#aaa">📦 ${d.produto.nome}</span><span style="color:#22c55e;font-weight:700">R$ ${Number(d.produto.precoManutencao).toLocaleString('pt-BR')}</span></div>`:''}
        <div style="display:flex;justify-content:space-between;padding:3px 0"><span style="color:#aaa">🚚 Deslocamento</span><span style="color:#22c55e;font-weight:700">R$ ${Number(d.deslocamento.valor).toLocaleString('pt-BR')}</span></div>
        <div style="font-size:9px;color:#666;font-style:italic;margin-top:1px">${d.deslocamento.detalhe}</div>
        <div style="display:flex;justify-content:space-between;padding:6px 0 2px;border-top:1px solid #1f6feb;margin-top:5px;font-weight:800;font-size:13px"><span style="color:#fff">TOTAL</span><span style="color:#22c55e">R$ ${Number(d.total).toLocaleString('pt-BR')}</span></div>
      </div>
    `;
    document.getElementById('d-calc-save').style.display = 'block';
  } catch(e) {
    out.innerHTML = '<div style="color:#ef4444;font-size:11px;padding:6px">Erro: '+e.message+'</div>';
  }
}

async function salvarPrecoManut(dealId){
  const r = window._CALC_RESULT;
  if (!r || r.dealId !== dealId) { alert('Calcule primeiro'); return; }
  if (!confirm(`Salvar R$ ${Number(r.total).toLocaleString('pt-BR')} como preço de manutenção deste cliente?\n\nIsso vai sobrescrever o preço default da categoria — só pra ESTE cliente.`)) return;
  try {
    const resp = await fetch('/manutencao/cliente/'+dealId+'/preco-manut', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ preco: r.total }),
    });
    const d = await resp.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    alert('✅ Preço salvo!');
    abrirDrawer(dealId); // refresh drawer
  } catch(e) { alert('Erro: '+e.message); }
}

async function removerPrecoManut(dealId){
  if (!confirm('Remover preço customizado e voltar ao default da categoria?')) return;
  try {

<script>
// Helper global pra fetches com proteção contra resposta HTML (sessão expirada / 500)
async function fetchJson(url, opts) {
  try {
    const r = await fetch(url, opts);
    const ct = r.headers.get('content-type') || '';
    if (!ct.includes('json')) {
      const t = await r.text();
      // Detecta redirect pro login (HTML) ou error page
      if (r.status === 401 || /login|<!DOCTYPE/i.test(t.slice(0,100))) {
        return { error:'Sessão expirada. Recarregue a página e faça login.', code:'session_expired', status:r.status };
      }
      return { error: `Erro ${r.status}: resposta inválida do servidor`, status:r.status };
    }
    const d = await r.json().catch(() => ({ error:'JSON inválido' }));
    if (!r.ok && !d.error) d.error = `HTTP ${r.status}`;
    return d;
  } catch(e) {
    return { error: e.message || 'Erro de rede' };
  }
}

let _MT = null;
const _TDF_USER = '<%= user.username %>';
// IS_ADMIN e admMenu vêm do layout.ejs → /admin-deal-override.js (shared)
window.IS_GESTOR = <%= typeof isGestor !== 'undefined' && isGestor ? 'true' : 'false' %>;
window.USER_TEAM = '<%= typeof userTeam !== 'undefined' ? userTeam : '' %>';
let _SELECIONADOS = new Set();
let _CLIENTE_ATUAL = null;

function fmt(v){ return 'R$ '+(Math.round(v||0)).toLocaleString('pt-BR'); }
function fmtData(s){ if(!s) return '—'; const [y,m,d]=s.split('-'); return `${d}/${m}/${y.slice(2)}`; }

const STATUS_LABELS = {
  vencido_90:'Vencido +90d', vencido_60:'Vencido +60d', vencido_30:'Vencido +30d',
  vencido:'Vencido', vence_30:'Vence 30d', vence_60:'Vence 60d', vence_90:'Vence 90d', futuro:'Futuro'
};

const CAT_ICONS = {
  refil:'💧', elemento:'🔩', elemento_filtrante:'🔩', bebedouro_refil:'🚰', bebedouro:'🚰',
  iron_free:'⚙️', scale_stop:'🪨', purificador:'🥤', filtro_entrada:'💧',
  condominio:'🏢', loja:'🏪', outros:'📦'
};

// View do closer: 'minha' (default) | 'todos' | 'orfaos' (admin sempre vê tudo)
let _VIEW_CARTEIRA = localStorage.getItem('vw_carteira') || 'minha';
function trocarViewCarteira(v){
  _VIEW_CARTEIRA = v;
  localStorage.setItem('vw_carteira', v);
  ['todos','minha','orfaos'].forEach(x => {
    const el = document.getElementById('vw-'+x);
    if (!el) return;
    if (x === v) {
      el.style.background = '#1e3a5f';
      el.style.color = '#7cb9f5';
    } else {
      el.style.background = 'none';
      el.style.color = x === 'orfaos' ? '#fbbf24' : '#888';
    }
  });
  carregar();
}
// Alias pra outras chamadas
if (typeof window.carregarManutencao === 'undefined') window.carregarManutencao = () => carregar();
async function carregar(){
  try{
    const isAdmin = '<%= user.role %>' === 'admin';
    const qs = isAdmin ? '' : '?view=' + encodeURIComponent(_VIEW_CARTEIRA);
    const res = await fetch('/manutencao/data' + qs);
    const d = await res.json();
    if (d.error) { document.getElementById('mt-tbody').innerHTML = `<tr><td colspan="13" style="color:#ef4444;padding:20px;text-align:center">Erro: ${d.error}</td></tr>`; return; }
    _MT = d;
    renderCards();
    renderCategorias();
    popularFiltros();
    if (typeof renderFiltroTemplate === 'function') renderFiltroTemplate();
    renderTabela();
    // Deeplink: ?open=DEAL_ID abre drawer direto (vindo de leads-parados-hoje, dossiê, etc)
    try {
      const params = new URLSearchParams(window.location.search);
      const openId = params.get('open');
      if (openId) {
        if (_MT.clientes.find(c => c.id === openId)) {
          setTimeout(() => abrirDrawer(openId), 200);
        } else {
          // Lead não está na carteira de manutenção — abre Zoho direto
          alert('Esse lead não está na base de Manutenção (provavelmente é lead novo). Abrindo no Zoho CRM...');
          window.open('https://crm.zoho.com/crm/org670700395/tab/Potentials/' + openId, '_blank');
        }
      }
    } catch(_){}
  }catch(e){ console.error(e); }
}

function renderCards(){
  const s = _MT.stats;
  document.getElementById('mt-cards').innerHTML = `
    <div class="mt-card red"   onclick="filtrarStatus('vencido')"><div class="l">⚠️ Vencidos</div><div class="v red">${s.vencidos}</div><div class="s">manutenção atrasada</div></div>
    <div class="mt-card yellow" onclick="filtrarStatus('vence_30')"><div class="l">🟡 Vence Este Mês</div><div class="v yellow">${s.vencendoMes}</div><div class="s">próximos 30 dias</div></div>
    <div class="mt-card"        onclick="filtrarStatus('vence_60')"><div class="l">🔵 Próx. 60 dias</div><div class="v">${s.prox60}</div><div class="s">31-60 dias</div></div>
    <div class="mt-card"        onclick="filtrarStatus('vence_90')"><div class="l">🔵 Próx. 90 dias</div><div class="v">${s.prox90}</div><div class="s">61-90 dias</div></div>
    <div class="mt-card green"  onclick="document.getElementById('f-status').value='';renderTabela()"><div class="l">📋 Total Base</div><div class="v green">${s.total}</div><div class="s">últimos 36 meses</div></div>
    <div class="mt-card purple" onclick="alert('Potencial de recompra estimado:\\n\\n' + fmt(${s.potencial}))"><div class="l">💰 Potencial Recompra</div><div class="v purple">${fmt(s.potencial)}</div><div class="s">±90 dias</div></div>
    <div class="mt-card"        onclick="document.getElementById('f-operadora').value='__sem';renderTabela()"><div class="l">👤 Sem Operadora</div><div class="v yellow">${s.semOperadora}</div><div class="s">vencendo até 30d</div></div>
  `;
}

function renderCategorias(){
  const cats = Object.entries(_MT.porCategoria || {}).sort((a,b) => b[1].count - a[1].count);
  document.getElementById('mt-cats').innerHTML = `
    <div class="mt-cat ${(window._catAtiva||'')===''?'active':''}" onclick="filtrarCat('')">📦 Todas <span class="badge">${_MT.stats.total}</span></div>
    ${cats.map(([k,v]) => `
      <div class="mt-cat ${window._catAtiva===k?'active':''}" onclick="filtrarCat('${k}')">
        ${CAT_ICONS[k]||'📦'} ${v.label} <span class="badge">${v.count}</span>
      </div>
    `).join('')}
    <div id="mt-vendas-mes-banner" style="display:none;width:100%;margin-top:8px"></div>
  `;
  // Se há categoria ativa, busca vendas do mês × meta
  if (window._catAtiva) carregarVendasMesCategoria(window._catAtiva);
}

async function carregarVendasMesCategoria(cat){
  const banner = document.getElementById('mt-vendas-mes-banner');
  if (!banner) return;
  banner.style.display = 'block';
  banner.innerHTML = `<div style="background:#0d1f3a;border:1px solid #1f6feb;border-radius:8px;padding:10px 14px;color:#7cb9f5;font-size:11px">⏳ Carregando vendas do mês...</div>`;
  try {
    const r = await fetch('/manutencao/vendas-mes-categoria?cat='+encodeURIComponent(cat));
    const d = await r.json();
    if (d.error) { banner.style.display = 'none'; return; }
    const pct = d.pct;
    const corBar = pct == null ? '#666' : pct >= 100 ? '#22c55e' : pct >= 70 ? '#fbbf24' : '#ef4444';
    const widthBar = Math.min(100, pct||0);
    const catLabels = (_MT.porCategoria||{})[cat]?.label || cat;
    banner.innerHTML = `
      <div style="background:linear-gradient(135deg,#0d1f3a,#1a0e2a);border:2px solid ${corBar};border-radius:10px;padding:12px 16px">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <div style="font-size:24px">${CAT_ICONS[cat]||'📦'}</div>
          <div style="flex:1;min-width:200px">
            <div style="font-size:10px;color:#9ca3af;text-transform:uppercase;font-weight:800;letter-spacing:.4px">Vendas do mês · ${catLabels}</div>
            <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:4px;font-size:13px">
              <span style="color:#fff;font-weight:800">${d.vendas_count} venda(s)</span>
              <span style="color:#22c55e;font-weight:800">R$ ${Math.round(d.vendas_rs).toLocaleString('pt-BR')}</span>
              ${d.meta_rs > 0 ? `<span style="color:${corBar};font-weight:800">${pct}% da meta (R$ ${Math.round(d.meta_rs).toLocaleString('pt-BR')})</span>` : '<span style="color:#888">— sem meta definida —</span>'}
              ${d.ticket_medio ? `<span style="color:#aaa;font-size:11px">ticket méd. R$ ${Math.round(d.ticket_medio).toLocaleString('pt-BR')}</span>` : ''}
            </div>
            ${d.meta_rs > 0 ? `<div style="height:8px;background:#0a0a0a;border-radius:4px;overflow:hidden;margin-top:6px"><div style="height:100%;background:${corBar};width:${widthBar}%;transition:width .4s"></div></div>` : ''}
          </div>
          ${d.meta_rs === 0 ? `<a href="/admin/metas-time-produto-page" style="color:#fbbf24;font-size:11px;font-weight:700;text-decoration:none;border:1px solid #fbbf24;border-radius:5px;padding:6px 12px">⚙️ Definir meta</a>` : ''}
        </div>
      </div>
    `;
  } catch(e) { banner.style.display = 'none'; }
}

function popularFiltros(){
  // Categorias
  const cats = Object.entries(_MT.porCategoria || {});
  document.getElementById('f-cat').innerHTML = '<option value="">📦 Todas categorias</option>' +
    cats.map(([k,v]) => `<option value="${k}">${CAT_ICONS[k]||'📦'} ${v.label} (${v.count})</option>`).join('');
  // Cidades — datalist agrupado por chave normalizada (TAUBATE/TAUBATÉ/Taubaté/SP → 1 entrada)
  // Paulo pediu 14/Mai/2026: tinha muita duplicata da mesma cidade
  const grupos = {};
  _MT.clientes.forEach(c => {
    if (!c.cidade) return;
    const key = _normCidade(c.cidade);
    if (!key) return;
    if (!grupos[key]) grupos[key] = { canonica: c.cidade, count: 1, variacoes: new Set([c.cidade]) };
    else {
      grupos[key].count++;
      grupos[key].variacoes.add(c.cidade);
      // Prefere a versão mais "bonita" (mais longa = provavelmente com acentos/case correto)
      const atual = grupos[key].canonica;
      const cand = c.cidade;
      const score = (s) => s.length + (/[À-ÿ]/.test(s) ? 5 : 0) + (/[A-Z][a-z]/.test(s) ? 3 : 0);
      if (score(cand) > score(atual)) grupos[key].canonica = cand;
    }
  });
  window._CIDADE_GRUPOS = grupos; // exposto pro botão "Unificar"
  const cdList = document.getElementById('f-cidade-list');
  if (cdList) {
    const ordenadas = Object.values(grupos).sort((a,b) => a.canonica.localeCompare(b.canonica));
    cdList.innerHTML = ordenadas.map(g => `<option value="${g.canonica}">${g.canonica} (${g.count})</option>`).join('');
  }

    <div style="display:flex;gap:8px;justify-content:flex-end">
      <button onclick="document.getElementById('dist-modal').remove()" style="background:#1a1a1a;color:#aaa;border:1px solid #333;border-radius:8px;padding:9px 14px;font-size:12px;font-weight:700;cursor:pointer">Cancelar</button>
      <button onclick="executarDistribuicao(${JSON.stringify(dealIds).replace(/"/g, '&quot;')})" style="background:#2a1a4e;color:#c084fc;border:2px solid #a855f7;border-radius:8px;padding:9px 18px;font-size:13px;font-weight:800;cursor:pointer">🚀 Distribuir</button>

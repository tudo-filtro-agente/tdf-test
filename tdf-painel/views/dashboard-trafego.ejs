    const todas = [
      ...(d.campanhas_google||[]).map(c => ({ plat:'Google', ...c, invest:c.cost_brl||0, leads:c.conversions||0 })),
      ...(d.campanhas_meta||[]).map(c => ({ plat:'Meta', ...c, invest:c.spend_brl||0, leads:c.leads||0 })),
    ];
    todas.forEach(c => { c.cpl = c.leads > 0 ? c.invest / c.leads : null; });
    todas.sort((a,b) => b.invest - a.invest);
    // Calcula CPL médio (excluindo aprendizado) pra usar como baseline
    const maduras = todas.filter(c => !c.em_aprendizado && c.invest >= 10 && c.cpl != null);
    const cplMedio = maduras.length ? maduras.reduce((s,c) => s+c.cpl, 0) / maduras.length : null;
    let html = `
      <div class="dt-table-card">
        <h3>📋 Campanhas — ordenadas por investimento ${cplMedio ? '(CPL médio do período: <strong style="color:var(--text)">'+dtFmtR(cplMedio)+'</strong>)' : ''}</h3>
        <div style="overflow-x:auto"><table class="dt-table">
          <thead><tr>
            <th>Plat</th><th>Campanha</th>
            <th class="num">Idade</th>
            <th class="num">Invest</th><th class="num">Impr.</th><th class="num">Cliques</th><th class="num">CTR</th>
            <th class="num">Leads</th><th class="num">CPL</th><th class="num">CPM</th>
            <th>Status auto</th>
          </tr></thead>
          <tbody>
    `;
    todas.forEach(c => {
      const ctr = c.ctr ? c.ctr.toFixed(2)+'%' : '—';
      const cpm = c.impressions > 0 ? (c.invest/c.impressions*1000) : null;
      const corCpl = c.cpl == null ? '#666' : c.cpl < 30 ? '#10b981' : c.cpl < 80 ? '#f59e0b' : '#ef4444';
      const ativo = c.status === 'ENABLED' || c.status === 'ACTIVE';
      // Status automático
      let auto, autoCor;
      if (c.em_aprendizado) { auto = '🆕 Aprendizado'; autoCor = '#3b82f6'; }
      else if (!ativo) { auto = '⏸ Pausada'; autoCor = '#666'; }
      else if (c.invest >= 50 && c.leads === 0) { auto = '🔴 Pausar'; autoCor = '#ef4444'; }
      else if (cplMedio && c.cpl != null && c.cpl < cplMedio * 0.7 && c.leads >= 3) { auto = '🚀 Escalar'; autoCor = '#10b981'; }
      else if (cplMedio && c.cpl != null && c.cpl > cplMedio * 1.5) { auto = '🟡 Otimizar'; autoCor = '#f59e0b'; }
      else if (c.cpl != null && c.leads >= 1) { auto = '✅ Manter'; autoCor = '#22c55e'; }
      else { auto = '⚪ Monitorar'; autoCor = '#9ca3af'; }
      const idadeStr = c.idade_dias != null ? c.idade_dias+'d' : '—';
      html += `<tr>
        <td><span class="dt-pill ${c.plat.toLowerCase()}">${c.plat}</span></td>
        <td style="color:var(--text);font-weight:600;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${(c.name||'').replace(/"/g,'&quot;')}">${c.name||'(sem nome)'}</td>
        <td class="num" style="color:${c.idade_dias != null && c.idade_dias < 7 ? '#3b82f6' : 'var(--dt-muted)'}">${idadeStr}</td>
        <td class="num">${dtFmtR(c.invest)}</td>
        <td class="num">${dtFmtN(c.impressions)}</td>
        <td class="num">${dtFmtN(c.clicks)}</td>
        <td class="num">${ctr}</td>
        <td class="num"><strong>${c.leads||0}</strong></td>
        <td class="num" style="color:${corCpl};font-weight:700">${c.cpl != null ? dtFmtR(c.cpl) : '—'}</td>
        <td class="num">${cpm != null ? dtFmtR(cpm) : '—'}</td>
        <td><span style="background:${autoCor}22;color:${autoCor};padding:2px 7px;border-radius:4px;font-size:10px;font-weight:800">${auto}</span></td>
      </tr>`;
    });
    html += '</tbody></table></div></div>';
    pane.innerHTML = html;
  } catch(e) { pane.innerHTML = `<div class="dt-empty" style="color:var(--dt-red)">❌ ${e.message}</div>`; }
}

// ========== ABA CRIATIVOS (Meta) ou KEYWORDS (Google) ==========
let _DT_CRIA_PLAT = localStorage.getItem('dt_cria_plat') || 'meta';
function dtCriaSetPlat(p){ _DT_CRIA_PLAT = p; localStorage.setItem('dt_cria_plat', p); dtRenderCriativos(); }
async function dtRenderCriativos(){
  const pane = document.getElementById('dt-pane-criativos');
  pane.innerHTML = '<div class="dt-loading">⏳ Carregando ranking...</div>';
  // Toggle plataforma
  const toggle = `
    <div style="display:flex;gap:6px;margin-bottom:14px;background:var(--dt-card);border:1px solid var(--dt-border);border-radius:10px;padding:4px;width:fit-content">
      <button onclick="dtCriaSetPlat('meta')" style="background:${_DT_CRIA_PLAT==='meta'?'var(--dt-meta)':'transparent'};color:${_DT_CRIA_PLAT==='meta'?'#fff':'var(--dt-muted)'};border:none;border-radius:6px;padding:7px 14px;font-size:12px;font-weight:800;cursor:pointer">📘 Meta (criativos)</button>
      <button onclick="dtCriaSetPlat('google')" style="background:${_DT_CRIA_PLAT==='google'?'var(--dt-google)':'transparent'};color:${_DT_CRIA_PLAT==='google'?'#000':'var(--dt-muted)'};border:none;border-radius:6px;padding:7px 14px;font-size:12px;font-weight:800;cursor:pointer">🔍 Google (keywords)</button>
    </div>
  `;
  try {
    if (_DT_CRIA_PLAT === 'meta') {
      const r = await fetch('/trafego/meta/creatives?'+dtBuildQS());
      const d = await r.json();
      if (d.error) throw new Error(d.error);
      const ads = (d.ads || d.list || d || []).filter(a => (a.spend_brl||0) > 5);
      ads.forEach(a => { a.cpl = a.leads > 0 ? a.spend_brl / a.leads : null; });
      ads.sort((a,b) => (a.cpl||1e9) - (b.cpl||1e9));
      let html = toggle + `
        <div class="dt-table-card">
          <h3>🎨 Top 30 criativos Meta — ordenados pelo melhor CPL</h3>
          <div style="overflow-x:auto"><table class="dt-table">
            <thead><tr>
              <th>#</th><th>Criativo</th><th>Campanha</th>
              <th class="num">Spend</th><th class="num">CTR</th><th class="num">Freq</th>
              <th class="num">Leads</th><th class="num">CPL</th><th>Recomendação</th>
            </tr></thead>
            <tbody>
      `;
      if (!ads.length) {
        html += `<tr><td colspan="9" class="dt-empty">Sem criativos com spend &gt;R$5 no período</td></tr>`;
      }
      ads.slice(0, 30).forEach((a, i) => {
        const rec = a.cpl == null ? '⏸ Pausar (0 leads)' : a.cpl < 25 ? '🚀 Escalar verba' : a.cpl < 60 ? '✅ Manter' : '⚠️ Trocar criativo';
        const corRec = a.cpl == null ? '#ef4444' : a.cpl < 25 ? '#10b981' : a.cpl < 60 ? '#9ca3af' : '#f59e0b';
        html += `<tr>
          <td><strong style="color:${i<3?'#f59e0b':'#666'}">#${i+1}</strong></td>
          <td style="color:var(--text);font-weight:600;max-width:280px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${(a.name||'').replace(/"/g,'&quot;')}">${a.name||'(sem nome)'}</td>
          <td style="color:var(--dt-muted);font-size:11px">${a.campaign_name||'—'}</td>
          <td class="num">${dtFmtR(a.spend_brl||0)}</td>
          <td class="num">${a.ctr ? a.ctr.toFixed(2)+'%' : '—'}</td>
          <td class="num">${a.frequency ? a.frequency.toFixed(1) : '—'}</td>
          <td class="num"><strong>${a.leads||0}</strong></td>
          <td class="num" style="color:${a.cpl==null?'#ef4444':a.cpl<30?'#10b981':a.cpl<60?'#f59e0b':'#ef4444'};font-weight:700">${a.cpl != null ? dtFmtR(a.cpl) : '—'}</td>
          <td style="color:${corRec};font-weight:700;font-size:11px">${rec}</td>
        </tr>`;
      });
      html += '</tbody></table></div></div>';
      pane.innerHTML = html;
    } else {
      // GOOGLE: keywords ranking
      const r = await fetch('/trafego/google/keywords?'+dtBuildQS());
      const d = await r.json();
      if (d.error) throw new Error(d.error);
      const kws = (d.keywords || d.list || d || []).filter(k => (k.cost_brl||0) > 5);
      kws.forEach(k => { k.cpl = k.conversions > 0 ? k.cost_brl / k.conversions : null; });
      kws.sort((a,b) => (a.cpl||1e9) - (b.cpl||1e9));
      let html = toggle + `
        <div class="dt-table-card">
          <h3>🔍 Top 30 keywords Google — ordenadas pelo melhor CPL</h3>
          <div style="overflow-x:auto"><table class="dt-table">
            <thead><tr>
              <th>#</th><th>Keyword</th><th>Match Type</th><th>Campanha</th>
              <th class="num">Spend</th><th class="num">Cliques</th><th class="num">CTR</th>
              <th class="num">Conv</th><th class="num">CPL</th><th>Ação</th>
            </tr></thead>
            <tbody>
      `;
      if (!kws.length) {
        html += `<tr><td colspan="10" class="dt-empty">Sem keywords com spend &gt;R$5 no período</td></tr>`;
      }
      kws.slice(0, 30).forEach((k, i) => {
        const rec = k.cpl == null ? '⏸ Pausar (0 conv)' : k.cpl < 30 ? '🚀 Aumentar lance' : k.cpl < 80 ? '✅ Manter' : '⚠️ Reduzir/pausar';
        const corRec = k.cpl == null ? '#ef4444' : k.cpl < 30 ? '#10b981' : k.cpl < 80 ? '#9ca3af' : '#f59e0b';
        const corCpl = k.cpl == null ? '#ef4444' : k.cpl < 30 ? '#10b981' : k.cpl < 80 ? '#f59e0b' : '#ef4444';
        html += `<tr>
          <td><strong style="color:${i<3?'#f59e0b':'#666'}">#${i+1}</strong></td>
          <td style="color:var(--text);font-weight:600;max-width:240px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${(k.text||k.keyword||'').replace(/"/g,'&quot;')}">${k.text||k.keyword||'(?)'}</td>
          <td style="color:var(--dt-muted);font-size:10px">${k.match_type||'—'}</td>
          <td style="color:var(--dt-muted);font-size:11px">${k.campaign_name||'—'}</td>
          <td class="num">${dtFmtR(k.cost_brl||0)}</td>
          <td class="num">${dtFmtN(k.clicks||0)}</td>
          <td class="num">${k.ctr ? (k.ctr*100).toFixed(2)+'%' : '—'}</td>
          <td class="num"><strong>${k.conversions||0}</strong></td>
          <td class="num" style="color:${corCpl};font-weight:700">${k.cpl != null ? dtFmtR(k.cpl) : '—'}</td>
          <td style="color:${corRec};font-weight:700;font-size:11px">${rec}</td>
        </tr>`;
      });
      html += '</tbody></table></div></div>';
      pane.innerHTML = html;
    }
  } catch(e) { pane.innerHTML = `<div class="dt-empty" style="color:var(--dt-red)">❌ ${e.message}</div>`; }
}


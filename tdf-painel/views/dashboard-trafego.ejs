  const offsetDay = (n) => new Date(Date.now() - n * 86400000).toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });
  // Defaults: período A = últimos 7d, período B = 7d anteriores
  const aDefStart = offsetDay(6), aDefEnd = hoje;
  const bDefStart = offsetDay(13), bDefEnd = offsetDay(7);
  pane.innerHTML = `
    <div class="dt-chart-card">
      <h3>🆚 Comparar 2 períodos</h3>
      <p style="color:var(--dt-muted);font-size:12px;margin:0 0 14px">Compare qualquer faixa de datas com outra. Mostra delta % e absoluto pra cada métrica + breakdown por canal (Google / IG / FB).</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">
        <div style="background:rgba(163,113,247,.08);border:1px solid rgba(163,113,247,.3);border-radius:8px;padding:12px">
          <div style="color:var(--dt-accent);font-size:11px;font-weight:800;margin-bottom:8px;text-transform:uppercase;letter-spacing:.4px">📅 Período A (atual)</div>
          <div style="display:flex;gap:6px">
            <input id="cmp-a-start" type="date" value="${aDefStart}" style="flex:1;background:#0a0a0f;border:1px solid var(--border);color:#fff;border-radius:5px;padding:6px;font-size:12px">
            <input id="cmp-a-end" type="date" value="${aDefEnd}" style="flex:1;background:#0a0a0f;border:1px solid var(--border);color:#fff;border-radius:5px;padding:6px;font-size:12px">
          </div>
        </div>
        <div style="background:rgba(156,163,175,.08);border:1px solid rgba(156,163,175,.3);border-radius:8px;padding:12px">
          <div style="color:var(--dt-muted);font-size:11px;font-weight:800;margin-bottom:8px;text-transform:uppercase;letter-spacing:.4px">📅 Período B (referência)</div>
          <div style="display:flex;gap:6px">
            <input id="cmp-b-start" type="date" value="${bDefStart}" style="flex:1;background:#0a0a0f;border:1px solid var(--border);color:#fff;border-radius:5px;padding:6px;font-size:12px">
            <input id="cmp-b-end" type="date" value="${bDefEnd}" style="flex:1;background:#0a0a0f;border:1px solid var(--border);color:#fff;border-radius:5px;padding:6px;font-size:12px">
          </div>
        </div>
      </div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">
        <button onclick="dtCmpPreset('semana')" style="background:#1f1f2e;color:#9ca3af;border:1px solid var(--border);border-radius:5px;padding:6px 12px;font-size:11px;cursor:pointer">Esta sem. vs anterior</button>
        <button onclick="dtCmpPreset('mes')" style="background:#1f1f2e;color:#9ca3af;border:1px solid var(--border);border-radius:5px;padding:6px 12px;font-size:11px;cursor:pointer">Este mês vs anterior</button>
        <button onclick="dtCmpPreset('7d')" style="background:#1f1f2e;color:#9ca3af;border:1px solid var(--border);border-radius:5px;padding:6px 12px;font-size:11px;cursor:pointer">7d vs 7d anteriores</button>
        <button onclick="dtCmpPreset('30d')" style="background:#1f1f2e;color:#9ca3af;border:1px solid var(--border);border-radius:5px;padding:6px 12px;font-size:11px;cursor:pointer">30d vs 30d anteriores</button>
        <button onclick="dtCmpRodar()" style="background:linear-gradient(135deg,#a371f7,#7c5cff);color:#fff;border:none;border-radius:6px;padding:7px 18px;font-size:12px;font-weight:800;cursor:pointer;margin-left:auto">▶ Comparar</button>
      </div>
      <div id="cmp-result"></div>
    </div>
  `;
}
function dtCmpPreset(p){
  const offsetDay = (n) => new Date(Date.now() - n * 86400000).toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });
  const hoje = new Date();
  const hojeStr = hoje.toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });
  let aS, aE, bS, bE;
  if (p === '7d') { aS = offsetDay(6); aE = hojeStr; bS = offsetDay(13); bE = offsetDay(7); }
  else if (p === '30d') { aS = offsetDay(29); aE = hojeStr; bS = offsetDay(59); bE = offsetDay(30); }
  else if (p === 'semana') {
    const dow = hoje.getDay() || 7; // domingo=0 → 7
    aS = offsetDay(dow - 1); aE = hojeStr;
    bS = offsetDay(dow - 1 + 7); bE = offsetDay(dow);
  } else if (p === 'mes') {
    const y = hoje.getFullYear(), m = hoje.getMonth();
    aS = `${y}-${String(m+1).padStart(2,'0')}-01`;
    aE = hojeStr;
    const prev = new Date(y, m-1, 1);
    bS = prev.toLocaleDateString('en-CA');
    const prevEnd = new Date(y, m, 0);
    bE = prevEnd.toLocaleDateString('en-CA');
  }
  document.getElementById('cmp-a-start').value = aS;
  document.getElementById('cmp-a-end').value = aE;
  document.getElementById('cmp-b-start').value = bS;
  document.getElementById('cmp-b-end').value = bE;
  dtCmpRodar();
}
async function dtCmpRodar(){
  const a_start = document.getElementById('cmp-a-start').value;
  const a_end = document.getElementById('cmp-a-end').value;
  const b_start = document.getElementById('cmp-b-start').value;
  const b_end = document.getElementById('cmp-b-end').value;
  if (!a_start || !a_end || !b_start || !b_end) { alert('Preencha as 4 datas'); return; }
  const out = document.getElementById('cmp-result');
  out.innerHTML = '<div class="dt-loading">⏳ Comparando períodos... (15-30s)</div>';
  try {
    const qs = new URLSearchParams({ a_start, a_end, b_start, b_end }).toString();
    const r = await fetch('/trafego/comparar-periodos?'+qs);
    const d = await r.json();
    if (d.error) { out.innerHTML = `<div class="dt-empty" style="color:var(--dt-red)">❌ ${d.error}</div>`; return; }
    const A = d.a, B = d.b;
    const fmtPeriod = (s, e) => `${s.slice(8,10)}/${s.slice(5,7)} → ${e.slice(8,10)}/${e.slice(5,7)}`;
    function deltaCell(deltaObj, fmt, inverso){
      if (deltaObj == null || deltaObj.pct == null) return '<span style="color:var(--text-muted)">—</span>';
      const positivo = inverso ? deltaObj.pct < 0 : deltaObj.pct > 0;
      const cls = deltaObj.pct === 0 ? 'neutral' : positivo ? 'up' : 'down';
      const cor = cls === 'up' ? '#10b981' : cls === 'down' ? '#ef4444' : '#9ca3af';
      const sym = deltaObj.pct > 0 ? '↑' : deltaObj.pct < 0 ? '↓' : '→';
      const absStr = fmt === 'money' ? dtFmtR(Math.abs(deltaObj.abs)) : (fmt === 'pct' ? Math.abs(deltaObj.abs).toFixed(2)+'pp' : Math.abs(deltaObj.abs));
      return `<span style="color:${cor};font-weight:800">${sym} ${Math.abs(deltaObj.pct)}%</span><span style="color:#9ca3af;font-size:10px;margin-left:4px">(${deltaObj.abs > 0 ? '+' : ''}${absStr})</span>`;
    }
    function row(label, valA, valB, delta, fmt, inverso){
      return `<tr>
        <td style="color:#9ca3af;font-weight:600">${label}</td>
        <td class="num" style="color:var(--text);font-weight:700">${valA}</td>
        <td class="num" style="color:#9ca3af">${valB}</td>
        <td class="num">${deltaCell(delta, fmt, inverso)}</td>
      </tr>`;
    }
    let html = `
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
        <div style="background:rgba(163,113,247,.06);border:1px solid var(--dt-accent);border-radius:8px;padding:10px;text-align:center">
          <div style="font-size:10px;color:var(--dt-accent);font-weight:800;text-transform:uppercase;margin-bottom:4px">Período A</div>
          <div style="color:var(--text);font-weight:700">${fmtPeriod(a_start, a_end)}</div>
        </div>

async function dtChamarIA(persona){
  const out = document.getElementById('dt-ia-out');
  const platLabel = _DT_IA_PLAT === 'ambos' ? 'Google+Meta' : _DT_IA_PLAT === 'google' ? 'Google' : 'Meta';
  out.innerHTML = `<div class="dt-loading">⏳ ${persona} analisando ${platLabel}... (15-30s)</div>`;
  try {
    const qs = dtBuildQS() + '&plataforma=' + _DT_IA_PLAT;
    const r = await fetch('/trafego/gestor-ia?persona='+persona+'&'+qs, { method: 'POST' });
    const d = await r.json();
    if (d.error) { out.innerHTML = '<div class="dt-empty" style="color:var(--dt-red)">❌ '+d.error+'</div>'; return; }
    out.innerHTML = `
      <div class="dt-chart-card" style="background:rgba(163,113,247,.04);border:1px solid var(--dt-accent)">
        <h3>🎯 ${persona.toUpperCase()} · ${platLabel} <span style="margin-left:auto;font-size:10px;color:var(--dt-faint);font-weight:500">${d.modelo||''}</span></h3>
        <div style="white-space:pre-wrap;color:var(--text);font-size:12.5px;line-height:1.6">${(d.output||d.resposta||'').replace(/</g,'&lt;')}</div>
      </div>
    `;
  } catch(e) { out.innerHTML = '<div class="dt-empty" style="color:var(--dt-red)">❌ '+e.message+'</div>'; }
}
async function dtChamarAgente(){
  const out = document.getElementById('dt-ia-out');
  const platLabel = _DT_IA_PLAT === 'ambos' ? 'Google+Meta' : _DT_IA_PLAT === 'google' ? 'Google' : 'Meta';
  out.innerHTML = `<div class="dt-loading">⏳ Agente investigando ${platLabel} com tools... 30-90s</div>`;
  try {
    const foco = _DT_IA_PLAT === 'ambos' ? '' : ` Foque APENAS em ${platLabel}.`;
    const r = await fetch('/trafego/agente-ia', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ mensagem: `Faça diagnóstico completo dos últimos 7 dias e me dê 5 ações priorizadas por impacto financeiro.${foco}` }),
    });
    const d = await r.json();
    if (d.error) { out.innerHTML = '<div class="dt-empty" style="color:var(--dt-red)">❌ '+d.error+'</div>'; return; }
    out.innerHTML = `
      <div class="dt-chart-card" style="background:rgba(163,113,247,.04);border:1px solid var(--dt-accent)">
        <h3>🤖 AGENTE AUTÔNOMO · ${platLabel} · ${d.iterations} iterações <span style="margin-left:auto;font-size:10px;color:var(--dt-faint);font-weight:500">tool use</span></h3>
        <details style="margin-bottom:12px;background:rgba(0,0,0,.3);border-radius:6px;padding:10px"><summary style="cursor:pointer;color:var(--dt-accent);font-size:11px;font-weight:700">▸ ${d.trace?.length||0} passos do agente</summary>
        <div style="margin-top:8px;font-family:monospace;font-size:11px">${(d.trace||[]).map(t => `<div style="color:#9ca3af;padding:3px 0">${t.tipo === 'tool_call' ? '🔧 '+t.tool : t.tipo === 'tool_result' ? '✅ '+(t.resultado||'') : t.tipo === 'tool_error' ? '❌' : '💭'} ${(t.conteudo||'').slice(0,180)}</div>`).join('')}</div>
        </details>
        <div style="white-space:pre-wrap;color:var(--text);font-size:12.5px;line-height:1.6">${(d.resposta_final||'').replace(/</g,'&lt;')}</div>
      </div>
    `;
  } catch(e) { out.innerHTML = '<div class="dt-empty" style="color:var(--dt-red)">❌ '+e.message+'</div>'; }
}

function dtRecarregar(){
  const ativa = document.querySelector('.dt-tab.active')?.id?.replace('dt-tab-','') || 'hoje';
  dtAba(ativa);
}


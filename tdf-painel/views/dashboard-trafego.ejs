async function dtExecAcao(endpoint, titulo){
  if (!confirm('Executar ação: '+titulo+'?')) return;
  try {
    const r = await fetch(endpoint, { method: 'POST' });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    alert('✅ Executado');
    dtRenderAlertas();
  } catch(e) { alert(e.message); }
}


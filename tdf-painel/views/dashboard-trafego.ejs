function dtSpeedKpi(label, sub, count, total, cor){
  const pct = total > 0 ? Math.round(count/total*100) : 0;
  return `
    <div style="background:rgba(255,255,255,.02);border:1px solid var(--dt-border);border-radius:6px;padding:8px;text-align:center">
      <div style="color:${cor};font-size:18px;font-weight:800">${count}</div>
      <div style="color:var(--dt-muted);font-size:9px;font-weight:700">${label}</div>
      <div style="color:var(--dt-faint);font-size:9px">${sub} (${pct}%)</div>
    </div>
  `;
}


// ========== RECOMENDAÇÃO CRUZADA Google × Meta ==========
function dtRecomendacaoCruzada(canais){
  const g = canais.google;
  const ig = canais.meta_ig;
  const fb = canais.meta_fb;
  const meta = { invest: ig.invest+fb.invest, leads: ig.leads+fb.leads, vendas: ig.vendas+fb.vendas, receita: ig.receita+fb.receita };
  const cplG = g.invest > 0 && g.leads > 0 ? g.invest/g.leads : null;
  const cplM = meta.invest > 0 && meta.leads > 0 ? meta.invest/meta.leads : null;
  const cacG = g.invest > 0 && g.vendas > 0 ? g.invest/g.vendas : null;
  const cacM = meta.invest > 0 && meta.vendas > 0 ? meta.invest/meta.vendas : null;
  const roasG = g.invest > 0 ? g.receita/g.invest : null;
  const roasM = meta.invest > 0 ? meta.receita/meta.invest : null;

  let recomendacao = '';
  let cor = '#a371f7';
  if (g.invest === 0 && meta.invest === 0) {
    return ''; // sem dados
  }
  if (cplG != null && cplM != null) {
    if (cplG < cplM * 0.7 && cacG != null && cacM != null && cacG < cacM) {
      recomendacao = `Google está com CPL ${dtFmtR(cplG)} e CAC ${dtFmtR(cacG)} — ambos melhores que Meta (${dtFmtR(cplM)} / ${dtFmtR(cacM)}). <strong>Considere migrar 20-30% do orçamento Meta pro Google.</strong>`;
      cor = '#fbbc04';
    } else if (cplM < cplG * 0.7 && meta.leads > g.leads * 1.5) {
      recomendacao = `Meta gera <strong>volume</strong> (${meta.leads} leads vs ${g.leads}), Google gera <strong>conversão melhor</strong> (CAC ${cacG != null ? dtFmtR(cacG) : '—'} vs ${cacM != null ? dtFmtR(cacM) : '—'}). <strong>Mantenha o mix mas otimize qualificação dos leads Meta.</strong>`;
      cor = '#a371f7';
    } else if (roasG != null && roasM != null && roasG > roasM * 2) {
      recomendacao = `Google está com ROAS ${roasG.toFixed(2)}x e Meta ${roasM.toFixed(2)}x. <strong>Reforce campanhas Google que vendem.</strong>`;
      cor = '#fbbc04';
    } else if (roasM != null && roasG != null && roasM > roasG * 2) {
      recomendacao = `Meta está vendendo melhor (ROAS ${roasM.toFixed(2)}x vs ${roasG.toFixed(2)}x Google). <strong>Considere escalar Meta.</strong>`;
      cor = '#1877f2';
    }
  }
  if (!recomendacao) {
    recomendacao = `Investimento balanceado: Google ${dtFmtR(g.invest)} (${g.leads} leads), Meta ${dtFmtR(meta.invest)} (${meta.leads} leads). Continue monitorando.`;
    cor = '#9ca3af';
  }
  return `
    <div style="margin-top:14px;padding:12px;background:rgba(255,255,255,.02);border-left:3px solid ${cor};border-radius:6px">
      <div style="color:${cor};font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px">⚔️ Google vs Meta — Recomendação</div>
      <div style="color:var(--text);font-size:12px;line-height:1.5">${recomendacao}</div>
    </div>
  `;
}


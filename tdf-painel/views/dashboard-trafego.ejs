<% const activePage = 'gestao'; const pageTitle = 'Dashboard Tráfego — Painel Executivo'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
:root {
  --dt-bg: #0a0a0f;
  --dt-bg-2: #11121a;
  --dt-card: #161725;
  --dt-card-2: #1d1f30;
  --dt-border: rgba(255,255,255,.06);
  --dt-border-strong: rgba(255,255,255,.12);
  --dt-text: #e5e7eb;
  --dt-muted: #9ca3af;
  --dt-faint: #6b7280;
  --dt-accent: #a371f7;
  --dt-green: #10b981;
  --dt-yellow: #f59e0b;
  --dt-red: #ef4444;
  --dt-blue: #3b82f6;
  --dt-meta: #1877f2;
  --dt-google: #fbbc04;
}
html[data-theme="light"] {
  --dt-bg: #F2F4F8;
  --dt-bg-2: #FFFFFF;
  --dt-card: #FFFFFF;
  --dt-card-2: #F0F3F7;
  --dt-border: rgba(0,0,0,.08);
  --dt-border-strong: rgba(0,0,0,.16);
  --dt-text: #1F2328;
  --dt-muted: #59636E;
  --dt-faint: #77808B;
  --dt-accent: #8250DF;
  --dt-green: #0E9F6E;
  --dt-yellow: #B45309;
  --dt-red: #DC2626;
  --dt-blue: #2563EB;
}

.dt-container{padding:24px 28px;max-width:1600px;margin:0 auto;color:var(--dt-text);font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Inter,sans-serif}
.dt-header{display:flex;align-items:center;gap:16px;margin-bottom:20px;flex-wrap:wrap}
.dt-header h1{font-size:22px;font-weight:800;margin:0;background:linear-gradient(135deg,#fff,#a371f7);-webkit-background-clip:text;background-clip:text;color:transparent}
.dt-period{display:flex;gap:6px;background:var(--dt-card);border:1px solid var(--dt-border);border-radius:10px;padding:4px}
.dt-period button{background:transparent;color:var(--dt-muted);border:none;border-radius:6px;padding:6px 12px;font-size:12px;font-weight:700;cursor:pointer;transition:all .15s}
.dt-period button:hover{color:var(--text);background:rgba(255,255,255,.04)}
.dt-period button.active{background:linear-gradient(135deg,var(--dt-accent),#7c5cff);color:#fff;box-shadow:0 4px 12px rgba(163,113,247,.3)}
.dt-tabs{display:flex;gap:4px;margin:18px 0;border-bottom:1px solid var(--dt-border-strong);overflow-x:auto;scrollbar-width:none}
.dt-tabs::-webkit-scrollbar{display:none}
.dt-tab{background:transparent;color:var(--dt-muted);border:none;padding:10px 18px;font-size:13px;font-weight:700;cursor:pointer;border-bottom:2px solid transparent;white-space:nowrap;transition:color .15s,border-color .15s}
.dt-tab:hover{color:var(--text)}
.dt-tab.active{color:var(--text);border-bottom-color:var(--dt-accent)}

/* Resumo do Dia (hero card) */
.dt-hero{background:linear-gradient(135deg,#1a0e2a,var(--bg));border:1px solid rgba(163,113,247,.3);border-radius:16px;padding:20px;margin-bottom:18px;position:relative;overflow:hidden}
.dt-hero::before{content:'';position:absolute;top:0;right:0;width:300px;height:200px;background:radial-gradient(circle,rgba(163,113,247,.15),transparent 70%);pointer-events:none}
.dt-hero h2{font-size:14px;font-weight:800;color:var(--dt-accent);margin:0 0 4px;text-transform:uppercase;letter-spacing:.6px}
.dt-hero-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:14px;margin-top:14px}
.dt-hero-stat{background:rgba(255,255,255,.03);border:1px solid var(--dt-border);border-radius:10px;padding:12px}
.dt-hero-stat .label{color:var(--dt-faint);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px}
.dt-hero-stat .value{color:var(--text);font-size:22px;font-weight:800;font-variant-numeric:tabular-nums}
.dt-hero-stat .delta{font-size:10px;font-weight:700;margin-top:3px}
.dt-acao{margin-top:14px;padding:14px 16px;background:rgba(255,255,255,.04);border-left:4px solid var(--dt-accent);border-radius:8px;font-size:13px;font-weight:600;color:var(--text)}

/* KPI grid */
.dt-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px;margin-bottom:20px}
.dt-kpi{background:var(--dt-card);border:1px solid var(--dt-border);border-radius:12px;padding:14px;transition:transform .2s,border-color .2s}
.dt-kpi:hover{transform:translateY(-2px);border-color:var(--dt-border-strong)}
.dt-kpi .top{display:flex;justify-content:space-between;align-items:start;margin-bottom:8px}
.dt-kpi .top .ico{font-size:18px;opacity:.6}
.dt-kpi .top .label{color:var(--dt-faint);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.dt-kpi .value{color:var(--text);font-size:24px;font-weight:800;font-variant-numeric:tabular-nums;margin-bottom:4px}
.dt-kpi .subv{color:var(--dt-muted);font-size:10px}
.dt-kpi .delta{display:inline-flex;align-items:center;gap:3px;font-size:11px;font-weight:700;padding:2px 6px;border-radius:4px;margin-top:4px}
.dt-kpi .delta.up{color:var(--dt-green);background:rgba(16,185,129,.1)}
.dt-kpi .delta.down{color:var(--dt-red);background:rgba(239,68,68,.1)}
.dt-kpi .delta.neutral{color:var(--dt-muted);background:rgba(255,255,255,.04)}

/* Charts */
.dt-chart-card{background:var(--dt-card);border:1px solid var(--dt-border);border-radius:14px;padding:18px;margin-bottom:18px}
.dt-chart-card h3{margin:0 0 14px;font-size:14px;font-weight:800;color:var(--text);display:flex;align-items:center;gap:8px}
.dt-chart-toggle{display:flex;gap:4px;margin-left:auto;background:var(--dt-bg-2);border-radius:6px;padding:3px}
.dt-chart-toggle button{background:transparent;color:var(--dt-muted);border:none;border-radius:4px;padding:4px 10px;font-size:10px;font-weight:700;cursor:pointer}
.dt-chart-toggle button.active{background:var(--dt-accent);color:var(--text)}

/* Tables */
.dt-table-card{background:var(--dt-card);border:1px solid var(--dt-border);border-radius:14px;padding:0;overflow:hidden;margin-bottom:18px}
.dt-table-card h3{margin:0;padding:14px 18px;font-size:14px;font-weight:800;color:var(--text);border-bottom:1px solid var(--dt-border)}
.dt-table{width:100%;border-collapse:collapse;font-size:12px}
.dt-table th{background:var(--dt-bg-2);color:var(--dt-faint);font-weight:700;text-transform:uppercase;letter-spacing:.4px;font-size:10px;padding:10px 12px;text-align:left;border-bottom:1px solid var(--dt-border)}
.dt-table td{padding:10px 12px;border-bottom:1px solid var(--dt-border);color:var(--text);font-variant-numeric:tabular-nums}
.dt-table tr:hover td{background:rgba(255,255,255,.02)}
.dt-table .num{text-align:right}
.dt-pill{display:inline-flex;align-items:center;gap:4px;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.3px}
.dt-pill.google{background:rgba(251,188,4,.15);color:var(--dt-google)}
.dt-pill.meta{background:rgba(24,119,242,.15);color:var(--dt-meta)}

/* Alertas */
.dt-alertas{display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px}
.dt-alerta{background:var(--dt-card);border:1px solid var(--dt-border);border-left:4px solid var(--dt-muted);border-radius:10px;padding:14px;transition:transform .15s}
.dt-alerta:hover{transform:translateX(2px)}
.dt-alerta.alta{border-left-color:var(--dt-red);background:linear-gradient(90deg,rgba(239,68,68,.06),var(--dt-card) 30%)}
.dt-alerta.media{border-left-color:var(--dt-yellow);background:linear-gradient(90deg,rgba(245,158,11,.05),var(--dt-card) 30%)}
.dt-alerta.oportunidade{border-left-color:var(--dt-green);background:linear-gradient(90deg,rgba(16,185,129,.05),var(--dt-card) 30%)}
.dt-alerta.info{border-left-color:var(--dt-blue);background:linear-gradient(90deg,rgba(59,130,246,.05),var(--dt-card) 30%)}
.dt-alerta .head{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px}
.dt-alerta .titulo{color:var(--text);font-size:13px;font-weight:800;flex:1}
.dt-alerta .sev{font-size:9px;font-weight:800;padding:2px 7px;border-radius:4px;text-transform:uppercase}
.dt-alerta .sev.alta{background:rgba(239,68,68,.15);color:var(--dt-red)}
.dt-alerta .sev.media{background:rgba(245,158,11,.15);color:var(--dt-yellow)}
.dt-alerta .sev.oportunidade{background:rgba(16,185,129,.15);color:var(--dt-green)}
.dt-alerta .sev.info{background:rgba(59,130,246,.15);color:var(--dt-blue)}
.dt-alerta .camp{color:var(--dt-muted);font-size:11px;margin-bottom:4px;font-weight:600}
.dt-alerta .det{color:var(--dt-faint);font-size:11px;margin-bottom:8px;line-height:1.4}
.dt-alerta .acao{display:flex;gap:6px;align-items:center}
.dt-alerta .acao-text{color:var(--text);font-size:11px;font-weight:700;flex:1}
.dt-alerta .acao-btn{background:var(--dt-accent);color:var(--text);border:none;border-radius:5px;padding:5px 10px;font-size:10px;font-weight:800;cursor:pointer}

.dt-empty{text-align:center;padding:40px 20px;color:var(--dt-faint)}
.dt-loading{text-align:center;padding:30px;color:var(--dt-muted);font-size:12px}
.dt-skeleton{background:linear-gradient(90deg,var(--dt-card),var(--dt-card-2),var(--dt-card));background-size:200% 100%;animation:skel 1.5s infinite;border-radius:8px}
@keyframes skel{0%{background-position:200% 0}100%{background-position:-200% 0}}
</style>

<div class="dt-container">
  <div class="dt-header">
    <h1>📊 Dashboard Tráfego Pago</h1>
    <div class="dt-period">
      <button onclick="dtSetPeriodo('hoje')" id="dtp-hoje" class="active">Hoje</button>
      <button onclick="dtSetPeriodo('ontem')" id="dtp-ontem">Ontem</button>
      <button onclick="dtSetPeriodo('7d')" id="dtp-7d">7d</button>
      <button onclick="dtSetPeriodo('14d')" id="dtp-14d">14d</button>
      <button onclick="dtSetPeriodo('30d')" id="dtp-30d">30d</button>
      <button onclick="dtAbrirCustom()" id="dtp-custom">📅 Custom</button>
    </div>
    <div id="dt-custom-pop" style="display:none;position:absolute;top:60px;left:50%;transform:translateX(-50%);background:#161725;border:1px solid #a371f7;border-radius:10px;padding:14px;z-index:100;box-shadow:0 8px 24px rgba(0,0,0,.5);min-width:280px">
      <div style="font-size:11px;color:#9ca3af;margin-bottom:8px;font-weight:700">📅 PERÍODO CUSTOMIZADO</div>
      <div style="display:flex;gap:6px;align-items:center;margin-bottom:8px">
        <input id="dtc-start" type="date" style="flex:1;background:#0a0a0f;border:1px solid var(--border);color:#fff;border-radius:5px;padding:6px;font-size:12px">
        <span style="color:var(--text-muted)">→</span>
        <input id="dtc-end" type="date" style="flex:1;background:#0a0a0f;border:1px solid var(--border);color:#fff;border-radius:5px;padding:6px;font-size:12px">
      </div>
      <div style="display:flex;gap:6px">
        <button onclick="dtAplicarCustom()" style="flex:1;background:#a371f7;color:#fff;border:none;border-radius:5px;padding:7px;font-size:11px;font-weight:800;cursor:pointer">Aplicar</button>
        <button onclick="dtFecharCustom()" style="background:transparent;color:#9ca3af;border:1px solid var(--border);border-radius:5px;padding:7px 12px;font-size:11px;cursor:pointer">Cancelar</button>
      </div>
    </div>
    <span id="dt-status" style="color:var(--dt-faint);font-size:11px;margin-left:auto">⏳ Carregando...</span>
    <button onclick="dtRecarregar()" style="background:var(--dt-card);color:var(--dt-muted);border:1px solid var(--dt-border);border-radius:8px;padding:7px 12px;font-size:12px;cursor:pointer" title="Atualizar tudo">🔄</button>
  </div>

  <!-- TABS -->
  <div class="dt-tabs">
    <button onclick="dtAba('hoje')" id="dt-tab-hoje" class="dt-tab active">⚡ Resumo do Dia</button>
    <button onclick="dtAba('overview')" id="dt-tab-overview" class="dt-tab">📈 Overview</button>
    <button onclick="dtAba('alertas')" id="dt-tab-alertas" class="dt-tab">🚨 Alertas <span id="dt-alertas-badge" style="background:var(--dt-red);color:var(--text);border-radius:10px;padding:1px 6px;font-size:9px;font-weight:800;margin-left:4px;display:none"></span></button>
    <button onclick="dtAba('comparar')" id="dt-tab-comparar" class="dt-tab">🆚 Comparar</button>
    <button onclick="dtAba('speed')" id="dt-tab-speed" class="dt-tab">🚀 Speed to Lead</button>
    <button onclick="dtAba('produto')" id="dt-tab-produto" class="dt-tab">💰 CAC por Produto</button>
    <button onclick="dtAba('campanhas')" id="dt-tab-campanhas" class="dt-tab">📋 Campanhas</button>
    <button onclick="dtAba('criativos')" id="dt-tab-criativos" class="dt-tab">🎨 Ranking Criativos</button>
    <button onclick="dtAba('vendas')" id="dt-tab-vendas" class="dt-tab">💰 Vendas × Campanha</button>
    <button onclick="dtAba('ia')" id="dt-tab-ia" class="dt-tab">🎯 Diretor de Tráfego (IA)</button>
  </div>

  <div id="dt-pane-hoje"></div>
  <div id="dt-pane-overview" style="display:none"></div>
  <div id="dt-pane-comparar" style="display:none"></div>
  <div id="dt-pane-speed" style="display:none"></div>
  <div id="dt-pane-produto" style="display:none"></div>
  <div id="dt-pane-alertas" style="display:none"></div>
  <div id="dt-pane-campanhas" style="display:none"></div>
  <div id="dt-pane-criativos" style="display:none"></div>
  <div id="dt-pane-vendas" style="display:none"></div>
  <div id="dt-pane-ia" style="display:none"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
let _DT_PERIODO = 'hoje'; // hoje | ontem | 7d | 14d | 30d (default 'hoje' pra aba Resumo carregar dados reais ao abrir)
let _DT_DATA = {};

function dtFmtR(v, big){
  if (v == null) return '—';
  v = Number(v);
  if (big && v >= 1000000) return 'R$ '+(v/1000000).toFixed(1).replace('.',',')+'M';
  if (big && v >= 1000) return 'R$ '+(v/1000).toFixed(1).replace('.',',')+'k';
  return 'R$ '+Math.round(v).toLocaleString('pt-BR');
}
function dtFmtN(v){ if (v==null) return '—'; return Number(v).toLocaleString('pt-BR'); }
function dtFmtPct(v, dec){ if (v==null) return '—'; return Number(v).toFixed(dec||1).replace('.',',')+'%'; }
function dtDelta(d, inverso){
  if (d == null) return '<span class="delta neutral">—</span>';
  const positivo = inverso ? d < 0 : d > 0;
  const cls = d === 0 ? 'neutral' : positivo ? 'up' : 'down';
  const sym = d > 0 ? '↑' : d < 0 ? '↓' : '→';
  return `<span class="delta ${cls}">${sym} ${Math.abs(d)}%</span>`;
}

let _DT_CUSTOM = null; // { start, end }

function dtBuildQS(){
  // Calcula start/end em horário Brasil (America/Sao_Paulo)
  const hoje = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });
  const offsetDay = (n) => new Date(Date.now() - n * 86400000).toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });
  let start, end;
  if (_DT_PERIODO === 'hoje') { start = hoje; end = hoje; }
  else if (_DT_PERIODO === 'ontem') { start = offsetDay(1); end = offsetDay(1); }
  else if (_DT_PERIODO === '7d') { start = offsetDay(6); end = hoje; }
  else if (_DT_PERIODO === '14d') { start = offsetDay(13); end = hoje; }
  else if (_DT_PERIODO === '30d') { start = offsetDay(29); end = hoje; }
  else if (_DT_PERIODO === 'custom' && _DT_CUSTOM) { start = _DT_CUSTOM.start; end = _DT_CUSTOM.end; }
  else { start = offsetDay(6); end = hoje; }
  const dias = Math.max(1, Math.round((new Date(end+'T00:00:00').getTime() - new Date(start+'T00:00:00').getTime())/86400000) + 1);
  return new URLSearchParams({ start, end, days: dias, dias }).toString();
}

function dtSetPeriodo(p){
  _DT_PERIODO = p;
  ['hoje','ontem','7d','14d','30d','custom'].forEach(x => {
    const el = document.getElementById('dtp-'+x);
    if (el) el.classList.toggle('active', x === p);
  });
  const ativa = document.querySelector('.dt-tab.active')?.id?.replace('dt-tab-','') || 'hoje';
  dtAba(ativa);
}

function dtAbrirCustom(){
  const pop = document.getElementById('dt-custom-pop');
  pop.style.display = 'block';
  if (_DT_CUSTOM) {
    document.getElementById('dtc-start').value = _DT_CUSTOM.start;
    document.getElementById('dtc-end').value = _DT_CUSTOM.end;
  } else {
    const hoje = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });
    const semana = new Date(Date.now() - 7*86400000).toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });
    document.getElementById('dtc-start').value = semana;
    document.getElementById('dtc-end').value = hoje;
  }
}
function dtFecharCustom(){ document.getElementById('dt-custom-pop').style.display = 'none'; }
function dtAplicarCustom(){
  const s = document.getElementById('dtc-start').value;
  const e = document.getElementById('dtc-end').value;
  if (!s || !e) { alert('Preencha as duas datas'); return; }
  if (s > e) { alert('Data inicial deve ser ≤ data final'); return; }
  _DT_CUSTOM = { start: s, end: e };
  document.getElementById('dtp-custom').textContent = '📅 ' + s.slice(8,10)+'/'+s.slice(5,7) + '–' + e.slice(8,10)+'/'+e.slice(5,7);
  dtFecharCustom();
  dtSetPeriodo('custom');
}

function dtAba(nome){
  ['hoje','overview','comparar','speed','produto','alertas','campanhas','criativos','vendas','ia'].forEach(x => {
    const tab = document.getElementById('dt-tab-'+x);
    const pane = document.getElementById('dt-pane-'+x);
    if (tab) tab.classList.toggle('active', x === nome);
    if (pane) pane.style.display = x === nome ? '' : 'none';
  });
  if (nome === 'hoje') dtRenderHoje();
  if (nome === 'overview') dtRenderOverview();
  if (nome === 'comparar') dtRenderComparar();
  if (nome === 'speed') dtRenderSpeed();
  if (nome === 'produto') dtRenderProduto();
  if (nome === 'alertas') dtRenderAlertas();
  if (nome === 'campanhas') dtRenderCampanhas();
  if (nome === 'criativos') dtRenderCriativos();
  if (nome === 'vendas') dtRenderVendas();
  if (nome === 'ia') dtRenderIA();
}

// ========== ABA RESUMO DO DIA (com breakdown por canal) ==========
async function dtRenderHoje(){
  const pane = document.getElementById('dt-pane-hoje');
  // Pra períodos longos, sugere ir pro Overview
  if (['7d','14d','30d','custom'].includes(_DT_PERIODO)) {
    pane.innerHTML = `
      <div class="dt-hero" style="text-align:center;padding:30px">
        <h2>📅 Você selecionou ${_DT_PERIODO === 'custom' ? 'período customizado' : _DT_PERIODO}</h2>
        <div style="color:var(--dt-muted);font-size:13px;margin:10px 0 16px">"Resumo do Dia" mostra dados de UM dia. Para ver o período completo:</div>
        <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap">
          <button onclick="dtAba('overview')" style="background:linear-gradient(135deg,#a371f7,#7c5cff);color:#fff;border:none;border-radius:8px;padding:10px 20px;font-weight:800;cursor:pointer">→ Overview</button>
          <button onclick="dtAba('comparar')" style="background:linear-gradient(135deg,#10b981,#059669);color:#fff;border:none;border-radius:8px;padding:10px 20px;font-weight:800;cursor:pointer">🆚 Comparar Períodos</button>
          <button onclick="dtSetPeriodo('hoje')" style="background:transparent;color:var(--dt-muted);border:1px solid var(--dt-border);border-radius:8px;padding:10px 16px;cursor:pointer">Voltar pra Hoje</button>
        </div>
      </div>
    `;
    return;
  }
  pane.innerHTML = '<div class="dt-loading">⏳ Carregando resumo...</div>';
  // Calcula a data alvo: hoje ou ontem
  const dataAlvo = _DT_PERIODO === 'ontem'
    ? new Date(Date.now() - 86400000).toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' })
    : new Date().toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });
  try {
    const r = await fetch('/trafego/resumo-dia?data=' + encodeURIComponent(dataAlvo));
    const d = await r.json();
    if (d.error) { pane.innerHTML = `<div class="dt-empty" style="color:var(--dt-red)">❌ ${d.error}</div>`; return; }
    const k = d.kpis;
    let html = `
      <div class="dt-hero">
        <h2>⚡ Resumo do Dia · ${new Date(d.hoje+'T12:00:00-03:00').toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long'})}</h2>
        <div style="color:var(--dt-muted);font-size:11px;margin-top:2px">Compara com ${new Date(d.ontem+'T12:00:00-03:00').toLocaleDateString('pt-BR',{weekday:'long',day:'2-digit',month:'long'})}</div>
        <div class="dt-hero-grid">
          ${dtHeroStat('💰 Investido', dtFmtR(k.invest.hoje), k.invest.delta_pct, true)}
          ${dtHeroStat('🎯 Leads', dtFmtN(k.leads.hoje), k.leads.delta_pct, false)}
          ${dtHeroStat('💸 CPL', dtFmtR(k.cpl.hoje), k.cpl.delta_pct, true)}
          ${dtHeroStat('🏆 Vendas', dtFmtN(k.vendas.hoje), k.vendas.delta_pct, false)}

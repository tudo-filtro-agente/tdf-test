async function dtRenderVendas(){
  const pane = document.getElementById('dt-pane-vendas');
  pane.innerHTML = '<div class="dt-loading">⏳ Cruzando spend × Fechado Ganho...</div>';
  try {
    const r = await fetch('/trafego/vendas-por-campanha?'+dtBuildQS());
    const d = await r.json();
    if (d.error) throw new Error(d.error);
    const T = d.total;
    const atribPct = (T.revenue_atribuido_pct * 100).toFixed(0);
    let html = `
      <div class="dt-kpis">
        ${dtKpi('💰','SPEND TOTAL',dtFmtR(T.spend,true),'')}
        ${dtKpi('💵','RECEITA ATRIB.',dtFmtR(T.revenue,true),T.deals_won+' deals')}
        ${dtKpi('📈','ROAS REAL',T.roas != null ? T.roas.toFixed(2)+'x' : '—','vs declarado pelas plataformas')}
        ${dtKpi('🎯','COBERTURA',atribPct+'%',dtFmtR(T.revenue_total_zoho,true)+' total Zoho')}
      </div>
    `;
    const comReceita = d.campanhas.filter(c => c.revenue > 0);
    if (comReceita.length) {
      html += `
        <div class="dt-table-card">
          <h3>🏆 Campanhas que VENDERAM (${comReceita.length})</h3>
          <div style="overflow-x:auto"><table class="dt-table">
            <thead><tr><th>Plat</th><th>Campanha</th><th class="num">Spend</th><th class="num">Vendas</th><th class="num">Receita</th><th class="num">ROAS Real</th><th class="num">CPA</th></tr></thead>
            <tbody>
      `;
      comReceita.forEach(c => {
        const rCor = c.roas_real >= 3 ? '#10b981' : c.roas_real >= 1 ? '#f59e0b' : '#ef4444';
        html += `<tr>
          <td><span class="dt-pill ${c.platform.toLowerCase()}">${c.platform}</span></td>
          <td style="color:var(--text);font-weight:600">${c.name}</td>
          <td class="num">${dtFmtR(c.spend)}</td>
          <td class="num"><strong style="color:#10b981">${c.deals_won}</strong></td>
          <td class="num" style="color:#10b981;font-weight:700">${dtFmtR(c.revenue)}</td>
          <td class="num" style="color:${rCor};font-weight:800">${c.roas_real != null ? c.roas_real.toFixed(2)+'x' : '—'}</td>
          <td class="num">${c.cpa_real != null ? dtFmtR(c.cpa_real) : '—'}</td>
        </tr>`;
      });
      html += '</tbody></table></div></div>';
    }
    if (d.sem_match.count > 0) {
      html += `<div class="dt-table-card" style="border-left:3px solid var(--dt-yellow)">
        <h3>🌫️ Vendas SEM atribuição (${d.sem_match.count} deals · ${dtFmtR(d.sem_match.revenue, true)})</h3>
        <div style="padding:12px;color:var(--dt-faint);font-size:11px">Lead_Source não match com nenhuma campanha. Pode ser orgânico, indicação ou base antiga. Use /trafego/reconciliar pra melhorar.</div>
      </div>`;
    }
    pane.innerHTML = html;
  } catch(e) { pane.innerHTML = `<div class="dt-empty" style="color:var(--dt-red)">❌ ${e.message}</div>`; }
}


<% var pageTitle = 'Scripts & Modelos'; var activePage = 'scripts'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<div class="page-header">
  <h1>📞 Scripts & Modelos de Ligação</h1>
  <p class="subtitle">Extraídos de ligações reais que funcionaram. Não é pra decorar palavra por palavra — é pra seguir a ORDEM dos passos e usar as falas como base. Última revisão: <%= atualizadoEm.split('-').reverse().join('/') %>.</p>
</div>

<div class="container" style="max-width:920px;">
  <% scripts.forEach(function(s){ %>
    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:26px 28px;margin-bottom:26px;">
      <h2 style="margin:0 0 6px;font-size:1.25rem;color:var(--text);"><%= s.titulo %></h2>
      <p style="color:var(--text-muted);font-size:.88rem;margin:0 0 18px;"><%= s.origem %></p>

      <% if (s.audio) { %>
      <div style="background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:16px 20px;margin:0 0 20px;">
        <div style="font-weight:800;color:var(--text);margin-bottom:8px;">🎧 Ouça a ligação-gabarito na íntegra (15min30s)</div>
        <audio controls preload="metadata" style="width:100%;">
          <source src="<%= s.audio %>" type="audio/mpeg">
        </audio>
        <div style="color:var(--text-muted);font-size:.82rem;margin-top:8px;">Escute acompanhando os passos abaixo — repare como cada etapa aparece na conversa real (e onde até essa ligação deixou pontos na mesa: os "Por quês" em amarelo contam).</div>
      </div>
      <% } %>

      <% if (s.aula) { %>
      <div style="background:rgba(94,193,245,.07);border:1px solid rgba(94,193,245,.35);border-radius:12px;padding:16px 20px;margin:0 0 20px;">
        <div style="font-weight:800;color:#5ec1f5;margin-bottom:8px;">🎓 <%= s.aula.titulo %></div>
        <audio controls preload="metadata" style="width:100%;">
          <source src="<%= s.aula.arq %>" type="audio/mp4">
        </audio>
        <div style="color:var(--text-muted);font-size:.82rem;margin-top:8px;">Formato podcast: dois apresentadores destrincham o script — bom pra ouvir no carro antes do expediente.</div>
      </div>
      <% } %>
      <% if (s.nubia) { %>
      <div style="background:rgba(122,214,160,.07);border:1px solid rgba(122,214,160,.4);border-radius:12px;padding:16px 20px;margin:0 0 20px;">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:8px;">
          <div style="font-weight:800;color:#7ad6a0;">&#129302; <%= s.nubia.titulo %></div>
          <span style="background:rgba(122,214,160,.18);color:#7ad6a0;border:1px solid rgba(122,214,160,.45);border-radius:999px;padding:2px 10px;font-size:.76rem;font-weight:800;white-space:nowrap;">nota <%= s.nubia.nota %>/100 &middot; r&eacute;gua de SDR</span>
        </div>
        <p style="color:var(--text-muted);font-size:.86rem;margin:0 0 12px;"><%= s.nubia.resumo %></p>
        <audio controls preload="metadata" style="width:100%;">
          <source src="<%= s.nubia.arq %>" type="audio/mpeg">
        </audio>
        <ul style="color:var(--text-muted);font-size:.84rem;margin:12px 0 0;padding-left:18px;">
          <% s.nubia.destaques.forEach(function(d){ %><li style="margin-bottom:5px;"><%= d %></li><% }) %>
        </ul>
      </div>
      <% } %>

      <% s.passos.forEach(function(p){ %>
        <div style="border:1px solid var(--border);border-radius:12px;padding:18px 20px;margin-bottom:14px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <span style="min-width:34px;height:34px;border-radius:50%;background:rgba(0,170,255,.15);color:#00AAFF;font-weight:900;display:inline-flex;align-items:center;justify-content:center;font-size:1rem;"><%= p.n %></span>
            <div>
              <div style="font-weight:800;color:var(--text);font-size:1rem;"><%= p.nome %></div>
              <div style="color:var(--text-muted);font-size:.85rem;"><%= p.objetivo %></div>
            </div>
          </div>
          <div style="margin:12px 0 0 46px;">
            <% p.falas.forEach(function(f){ %>
              <div style="background:var(--bg);border-left:3px solid #00AAFF;border-radius:0 8px 8px 0;padding:8px 14px;margin:7px 0;color:var(--text);font-size:.9rem;line-height:1.5;"><%= f %></div>
            <% }); %>
            <div style="margin-top:10px;color:#eab308;font-size:.85rem;line-height:1.55;"><b>Por quê:</b> <%= p.porque %></div>
          </div>
        </div>
      <% }); %>

      <% if (s.checklist) { %>
      <div style="background:rgba(34,197,94,.08);border:1px solid rgba(34,197,94,.35);border-radius:12px;padding:18px 22px;margin-top:18px;">
        <div style="font-weight:800;color:#22c55e;margin-bottom:10px;">✅ Checklist — antes de desligar, você fez isso?</div>
        <% s.checklist.forEach(function(c){ %>
          <label style="display:flex;gap:10px;align-items:flex-start;margin:7px 0;color:var(--text);font-size:.9rem;cursor:pointer;">
            <input type="checkbox" style="margin-top:3px;accent-color:#22c55e;"> <span><%= c %></span>
          </label>
        <% }); %>
      </div>
      <% } %>
    </div>
  <% }); %>
</div>

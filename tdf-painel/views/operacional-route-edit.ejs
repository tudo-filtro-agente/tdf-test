<% const activePage = 'operacional'; const pageTitle = 'Operacional · Editor de Rota'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
  .re-shell { max-width:1200px; margin:0 auto; padding:0 14px }
  .re-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; flex-wrap:wrap; gap:10px }
  .re-head h1 { margin:0; font-size:18px; color:var(--text) }
  .re-head .sub { color:var(--text-muted); font-size:12px; margin-top:2px }
  .btn { padding:7px 14px; border-radius:6px; font-size:11px; font-weight:700; cursor:pointer; border:1px solid; background:transparent }
  .btn-sec { color:#93c5fd; border-color:#1f6feb }
  .btn-warn { color:#fbbf24; border-color:#eab308 }
  .btn-danger { color:#ef4444; border-color:#ef4444 }
  .btn-prim { background:#1f6feb; color:#fff; border-color:#1f6feb }
  .btn-success { background:#25D366; color:#000; border-color:#25D366 }

  .re-meta { background:var(--bg-card); border:1px solid var(--border); border-radius:10px; padding:14px 18px; margin-bottom:14px }
  .re-meta-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:10px }
  @media (max-width:800px) { .re-meta-grid { grid-template-columns:1fr 1fr } }
  .re-meta-field label { font-size:10px; color:var(--text-muted); text-transform:uppercase; letter-spacing:.5px; display:block; margin-bottom:3px }
  .re-meta-field input, .re-meta-field select { width:100%; background:var(--bg); border:1px solid var(--border); color:var(--text); padding:6px 9px; border-radius:5px; font-size:12px }
  .re-meta-actions { display:flex; gap:8px; flex-wrap:wrap; padding-top:10px; border-top:1px solid var(--border) }

  .re-grid { display:grid; grid-template-columns:1fr 320px; gap:12px }
  @media (max-width:1000px) { .re-grid { grid-template-columns:1fr } }

  .re-stops-panel { background:var(--bg-card); border:1px solid var(--border); border-radius:10px; padding:14px }
  .re-stops-panel h3 { margin:0 0 10px; font-size:13px; color:#93c5fd; text-transform:uppercase; letter-spacing:.5px }
  .re-stop { background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:10px 12px; margin-bottom:6px; display:grid; grid-template-columns:24px 32px 1fr auto; gap:10px; align-items:center; cursor:grab; transition:all .15s; border-left:3px solid var(--c, #475569) }
  .re-stop.dragging { opacity:.5 }
  .re-stop.dragover { border-color:#22c55e; box-shadow:inset 0 0 0 2px rgba(34,197,94,.3) }
  .re-stop .handle { color:var(--text-muted); cursor:grab; user-select:none; text-align:center; font-size:14px }
  .re-stop .seq { background:var(--border); color:var(--text); border-radius:50%; width:28px; height:28px; line-height:28px; text-align:center; font-weight:800; font-size:12px }
  .re-stop .info .name { color:var(--text); font-weight:700; font-size:12px }
  .re-stop .info .meta { color:var(--text-muted); font-size:10px; margin-top:2px }
  .re-stop .info .badges { margin-top:3px }
  .re-stop .info .badges .b { display:inline-block; background:var(--border); color:var(--text-muted); padding:1px 6px; border-radius:3px; font-size:9px; margin-right:3px; font-weight:700 }
  .re-stop .info .badges .b.condo { background:rgba(251,191,36,.15); color:#fbbf24 }
  .re-stop .info .badges .b.urgent { background:rgba(239,68,68,.15); color:#ef4444 }
  .re-stop .info .badges .b.pickup { background:rgba(34,211,238,.15); color:#22d3ee }
  .re-stop .rm { background:transparent; border:0; color:#ef4444; cursor:pointer; font-size:18px; opacity:.5; transition:opacity .1s }
  .re-stop .rm:hover { opacity:1 }

  .re-add-panel { background:var(--bg-card); border:1px solid var(--border); border-radius:10px; padding:14px; max-height:600px; overflow-y:auto }
  .re-add-panel h3 { margin:0 0 10px; font-size:13px; color:#93c5fd; text-transform:uppercase; letter-spacing:.5px }
  .re-add-search { width:100%; background:var(--bg); border:1px solid var(--border); color:var(--text); padding:7px 10px; border-radius:5px; font-size:12px; margin-bottom:10px }
  .re-add-list { display:flex; flex-direction:column; gap:4px }
  .re-add-item { background:var(--bg); border:1px solid var(--border); border-radius:5px; padding:8px 10px; font-size:12px; cursor:pointer; transition:all .1s }
  .re-add-item:hover { border-color:#22c55e }
  .re-add-item .n { color:var(--text); font-weight:700 }
  .re-add-item .m { color:var(--text-muted); font-size:10px }

  .re-briefing { background:var(--bg); border:1px dashed var(--border); border-radius:6px; padding:12px; color:#cbd5e1; font-size:12px; white-space:pre-wrap; font-family:'SF Mono', Monaco, monospace; margin-top:10px; max-height:300px; overflow-y:auto; display:none }
  .re-briefing.show { display:block }
</style>

<div class="re-shell">
  <div class="re-head">
    <div>
      <h1>🛣 Editor de Rota <span style="color:var(--text-muted);font-size:11px;font-weight:400">#<%= routeId %></span></h1>
      <div class="sub" id="re-sub">Carregando…</div>
    </div>
    <div style="display:flex;gap:8px;flex-wrap:wrap">
      <a href="/operacional" class="btn btn-sec" style="text-decoration:none">← Painel</a>
    </div>
  </div>

  <!-- Meta + Actions -->
  <div class="re-meta" id="re-meta-card">
    <div class="re-meta-grid">
      <div class="re-meta-field">
        <label>Data</label>
        <input type="date" id="re-f-date" onchange="reSaveMeta()">
      </div>
      <div class="re-meta-field">
        <label>Técnico</label>
        <select id="re-f-tech" onchange="reSaveMeta()"></select>
      </div>
      <div class="re-meta-field">
        <label>Status</label>
        <select id="re-f-status" onchange="reSaveMeta()">
          <option value="pendente">Pendente</option>
          <option value="agendado">Agendado</option>
          <option value="em_rota">Em Rota</option>
          <option value="concluido">Concluído</option>
          <option value="cancelado">Cancelado</option>
        </select>
      </div>
      <div class="re-meta-field">
        <label>Auvo ID</label>
        <input type="text" id="re-f-auvo" readonly style="opacity:.6">
      </div>
    </div>
    <div class="re-meta-actions">
      <button class="btn btn-warn" onclick="reOptimize()">🔀 Otimizar ordem</button>
      <button class="btn btn-warn" onclick="reSchedule()">📅 Calcular cronograma</button>
      <button class="btn btn-warn" onclick="reBriefing()">📋 Ver briefing</button>
      <button class="btn btn-success" onclick="reNotify()">📱 Z-API resumo</button>
      <button class="btn btn-warn" onclick="reAiBriefing()" style="border-color:#a371f7;color:#a371f7">🪄 Reescrever com IA</button>
      <button class="btn btn-success" onclick="reSendDaily()" style="background:#25D366;color:#000;border-color:#25D366">📨 Enviar roteiro detalhado</button>
      <button class="btn btn-warn" onclick="reSyncAuvo()" style="border-color:#fb923c;color:#fb923c">🔗 Sync Auvo</button>
      <button class="btn btn-prim" onclick="reConfirm()" id="re-btn-confirm">✅ Confirmar rota</button>
      <span style="flex:1"></span>
      <span id="re-status" style="font-size:11px;color:var(--text-muted);align-self:center"></span>
    </div>
    <div class="re-briefing" id="re-briefing"></div>
  </div>

  <div class="re-grid">
    <div class="re-stops-panel">
      <h3>📍 Paradas (<span id="re-stops-count">0</span>) — arraste pelo ☰ pra reordenar</h3>
      <div id="re-stops"></div>
    </div>
    <div class="re-add-panel">
      <h3>➕ Adicionar parada</h3>
      <input class="re-add-search" id="re-add-search" placeholder="filtrar por nome, cidade…" oninput="reFilterAdd()">
      <div id="re-add-list" class="re-add-list"></div>
    </div>
  </div>
</div>

<script>
const RE = {
  routeId: <%= routeId %>,
  route: null,
  stops: [],
  technicians: [],
  eligible: [], // sales aguardando_rota
};

async function _api(path, opts={}) {
  const r = await fetch(path, {
    method: opts.method || 'GET',
    headers: {'Content-Type':'application/json'},
    body: opts.body ? JSON.stringify(opts.body) : undefined,
    credentials:'same-origin',
  });
  if (!r.ok) {
    const t = await r.text();
    throw new Error(`${r.status} — ${t.substring(0,200)}`);
  }
  return r.json();
}

function setStatus(t, color='#666') {
  const el = document.getElementById('re-status');
  el.textContent = t || '';
  el.style.color = color;
  if (t && !t.startsWith('⏳') && !t.startsWith('❌')) {
    setTimeout(() => { el.textContent = ''; }, 3000);
  }
}

async function reLoad() {
  try {
    const [route, techs, eligibleResp] = await Promise.all([
      _api(`/operacional/api/routes/${RE.routeId}`),
      _api('/operacional/api/technicians'),
      _api('/operacional/api/sales?status=aguardando_rota&page_size=200'),
    ]);
    RE.route = route;
    RE.stops = route.stops || [];
    RE.technicians = Array.isArray(techs) ? techs.filter(t=>t.active) : [];
    RE.eligible = eligibleResp.items || [];
    reRenderMeta();
    reRenderStops();
    reRenderAdd();
  } catch (e) {
    setStatus('❌ ' + e.message, '#f87171');
  }
}

function reRenderMeta() {
  const r = RE.route;
  document.getElementById('re-sub').textContent = `${r.technician_name || '—'} · ${r.route_date} · ${r.stops_count || 0} paradas · status: ${r.status}`;
  document.getElementById('re-f-date').value = r.route_date;
  document.getElementById('re-f-status').value = r.status;
  document.getElementById('re-f-auvo').value = r.auvo_route_id || '';
  const techSel = document.getElementById('re-f-tech');
  techSel.innerHTML = '<option value="">— sem técnico —</option>' + RE.technicians.map(t =>
    `<option value="${t.id}" ${t.id===r.technician_id?'selected':''}>${t.name} (cap ${t.daily_capacity||8})</option>`
  ).join('');
}

function reRenderStops() {
  document.getElementById('re-stops-count').textContent = RE.stops.length;
  const c = document.getElementById('re-stops');
  if (!RE.stops.length) {
    c.innerHTML = '<div style="padding:30px;text-align:center;color:#666;font-size:12px">Rota vazia — adicione paradas à direita</div>';
    return;
  }
  c.innerHTML = RE.stops.map((s, idx) => {
    const sale = s.sale || {};
    const isCondo = sale.is_condominio;
    const isPickup = sale.requires_material_pickup;
    const isUrgent = sale.service_priority === 'urgent' || sale.service_priority === 'high';
    const color = isCondo ? '#fbbf24' : (isUrgent ? '#ef4444' : (isPickup ? '#22d3ee' : '#475569'));
    const badges = [];
    if (isCondo) badges.push(`<span class="b condo">🏢 condo${sale.condominio_deadline_time?' até '+sale.condominio_deadline_time:''}</span>`);
    if (isUrgent) badges.push(`<span class="b urgent">⚡ ${sale.service_priority}</span>`);
    if (isPickup) badges.push(`<span class="b pickup">📦 pickup</span>`);
    return `
      <div class="re-stop" draggable="true"
        ondragstart="reDragStart(event, ${s.id})"
        ondragover="reDragOver(event, ${s.id})"
        ondragleave="reDragLeave(event)"
        ondrop="reDrop(event, ${s.id})"
        ondragend="reDragEnd(event)"
        data-stop="${s.id}"
        style="--c:${color}">
        <span class="handle" title="Arraste pra reordenar">☰</span>
        <span class="seq">${idx+1}</span>
        <div class="info">
          <div class="name">${sale.customer_name || '(sem cliente linkado)'}</div>
          <div class="meta">
            ${s.scheduled_start ? `⏰ <b style="color:#22d3ee">${new Date(s.scheduled_start).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}</b> → ${new Date(s.scheduled_end).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})} (${s.estimated_duration_min||60}min) · ` : ''}
            ${sale.product_line ? `📦 ${sale.product_line.substring(0,40)}` : ''}
            ${sale.address?.city ? ` · 📍 ${sale.address.city}` : ''}
          </div>
          ${badges.length ? `<div class="badges">${badges.join('')}</div>` : ''}
        </div>
        <button class="rm" onclick="reRemoveStop(${s.id})" title="Remover">×</button>
      </div>
    `;
  }).join('');
}

function reRenderAdd() {
  const q = (document.getElementById('re-add-search')?.value || '').toLowerCase();
  // Exclui sales que já estão na rota
  const inRoute = new Set(RE.stops.map(s => s.sale_id));
  const filtered = RE.eligible.filter(s =>
    !inRoute.has(s.id)
    && (!q || (s.customer_name||'').toLowerCase().includes(q)
              || (s.address?.city||'').toLowerCase().includes(q)
              || (s.product_line||'').toLowerCase().includes(q))
  );
  const c = document.getElementById('re-add-list');
  if (!filtered.length) {
    c.innerHTML = '<div style="padding:14px;color:#666;font-size:11px;text-align:center">Nenhuma sale elegível</div>';
    return;
  }
  c.innerHTML = filtered.map(s => `
    <div class="re-add-item" onclick="reAddStop(${s.id})">
      <div class="n">${s.customer_name||'—'} ${s.is_condominio?'🏢':''} ${s.requires_material_pickup?'📦':''}</div>
      <div class="m">${(s.product_line||'').substring(0,50)} · ${s.address?.city||'—'}</div>
    </div>
  `).join('');
}

function reFilterAdd() { reRenderAdd(); }

async function reAddStop(saleId) {
  setStatus('⏳ adicionando…');
  try {
    await _api(`/operacional/api/routes/${RE.routeId}/stops`, { method:'POST', body:{ sale_ids:[saleId] } });
    setStatus('✅ Parada adicionada', '#22c55e');
    await reLoad();
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

async function reRemoveStop(stopId) {
  if (!confirm('Remover parada da rota? A Sale volta para "aguardando_rota".')) return;
  setStatus('⏳ removendo…');
  try {
    await _api(`/operacional/api/route-stops/${stopId}`, { method:'DELETE' });
    setStatus('✅ Parada removida', '#22c55e');
    await reLoad();
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

// Drag and drop
let _reDragId = null;
function reDragStart(ev, stopId) { _reDragId = stopId; ev.currentTarget.classList.add('dragging'); ev.dataTransfer.effectAllowed = 'move'; }
function reDragOver(ev, stopId) { ev.preventDefault(); ev.currentTarget.classList.add('dragover'); }
function reDragLeave(ev) { ev.currentTarget.classList.remove('dragover'); }
function reDragEnd(ev) { ev.currentTarget.classList.remove('dragging'); document.querySelectorAll('.re-stop').forEach(s => s.classList.remove('dragover')); _reDragId = null; }
async function reDrop(ev, targetId) {
  ev.preventDefault();
  ev.currentTarget.classList.remove('dragover');
  if (!_reDragId || _reDragId === targetId) return;
  const ids = RE.stops.map(s => s.id);
  const from = ids.indexOf(_reDragId);
  const to = ids.indexOf(targetId);
  if (from < 0 || to < 0) return;
  ids.splice(to, 0, ids.splice(from, 1)[0]);
  setStatus('⏳ reordenando…');
  try {
    await _api(`/operacional/api/routes/${RE.routeId}/reorder-stops`, { method:'POST', body:{ stop_ids: ids } });
    setStatus('✅ Reordenado', '#22c55e');
    await reLoad();
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

let _reMetaT = null;
function reSaveMeta() {
  // debounce 600ms — pra não disparar 3 PATCH em sequência
  clearTimeout(_reMetaT);
  _reMetaT = setTimeout(async () => {
    setStatus('⏳ salvando…');
    const body = {
      route_date: document.getElementById('re-f-date').value,
      technician_id: parseInt(document.getElementById('re-f-tech').value) || null,
      status: document.getElementById('re-f-status').value,
    };
    try {
      await _api(`/operacional/api/routes/${RE.routeId}`, { method:'PATCH', body });
      setStatus('✅ Metadata salva', '#22c55e');
      await reLoad();
    } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
  }, 600);
}

async function reOptimize() {
  if (!confirm('Reordenar paradas automaticamente?\n\nOrdem: condomínios c/ deadline → urgentes → nearest-neighbor por distância.')) return;
  setStatus('⏳ otimizando…');
  try {
    const r = await _api(`/operacional/api/routes/${RE.routeId}/optimize`, { method:'POST', body:{} });
    setStatus(`✅ Reordenado (${(r.changes||[]).length} mudanças)`, '#22c55e');
    await reLoad();
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

async function reSchedule() {
  if (!confirm('Calcular horário de cada parada?\n\nRespeita jornada + almoço + duração ServiceType + tempo de deslocamento.')) return;
  setStatus('⏳ calculando…');
  try {
    const r = await _api(`/operacional/api/routes/${RE.routeId}/schedule`, { method:'POST', body:{} });
    if (!r.ok) { setStatus(`⚠ ${r.error || 'falhou'}`, '#fbbf24'); return; }
    let msg = `✅ Jornada ${r.work_window} · almoço ${r.lunch_window} · 1º stop ${new Date(r.first_stop).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}, último ${new Date(r.last_stop_end).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}`;
    if ((r.warnings||[]).length) msg += `\n⚠ ${r.warnings.length} alertas:\n${r.warnings.slice(0,3).join('\n')}`;
    setStatus(msg, (r.warnings||[]).length ? '#fbbf24' : '#22c55e');
    await reLoad();
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

async function reBriefing() {
  setStatus('⏳ gerando briefing…');
  try {
    const b = await _api(`/operacional/api/routes/${RE.routeId}/briefing`);
    const el = document.getElementById('re-briefing');
    el.textContent = `📊 ${b.stops_count} paradas · ~${b.total_km} km · saída sugerida ${b.suggested_start}\n${(b.dicas||[]).join('\n')||'(sem dicas extras)'}\n\n--- Mensagem ---\n${b.message}`;
    el.classList.add('show');
    setStatus('✅ Briefing gerado — role abaixo', '#22c55e');
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

async function reAiBriefing() {
  setStatus('⏳ Claude reescrevendo briefing…');
  try {
    const b = await _api(`/operacional/api/routes/${RE.routeId}/briefing-ai`);
    const el = document.getElementById('re-briefing');
    let header = '';
    if (b.ai_source === 'ai') {
      header = `🪄 *Reescrito por IA* · modelo ${b.ai_model||'?'} · ${b.ai_tokens_in||0}→${b.ai_tokens_out||0} tokens\n\n`;
      setStatus(`✅ Reescrito com IA (${b.ai_tokens_out||0} tokens)`, '#22c55e');
    } else {
      header = `⚠ *Fallback template* (${b.ai_skipped_reason||'?'})\n\n`;
      setStatus(`⚠ Fallback template: ${b.ai_skipped_reason||'?'}`, '#fbbf24');
    }
    el.textContent = header + b.message;
    el.classList.add('show');
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

async function reSendDaily() {
  setStatus('⏳ gerando preview detalhado…');
  let preview;
  try {
    preview = await _api(`/operacional/api/routes/${RE.routeId}/briefing-detailed`);
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); return; }
  const el = document.getElementById('re-briefing');
  el.textContent = preview.message;
  el.classList.add('show');
  if (!confirm(`Enviar roteiro detalhado pro técnico ${preview.technician_name}?\n\n${preview.stops_count} paradas, ~${preview.total_km} km${preview.needs_material_pickup?' (com pickup material)':''}.\n\nPreview rolando abaixo. Confirmar envio Z-API?`)) {
    setStatus('preview gerado, envio cancelado', '#888');
    return;
  }
  setStatus('⏳ enviando Z-API…');
  try {
    const r = await _api(`/operacional/api/routes/${RE.routeId}/send-daily-briefing`, { method:'POST', body:{} });
    setStatus(`✅ Roteiro enviado pra ${r.technician_phone}`, '#22c55e');
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

async function reNotify() {
  if (!confirm('Enviar briefing Z-API pro técnico agora?')) return;
  setStatus('⏳ enviando…');
  try {
    const r = await _api(`/operacional/api/routes/${RE.routeId}/notify-technician`, { method:'POST', body:{} });
    setStatus(`✅ Enviado pra ${r.technician_phone}`, '#22c55e');
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

async function reConfirm() {
  if (!confirm('Confirmar rota?\n\nSales vão pra status="agendado" + tasks serão criadas no Auvo automaticamente.')) return;
  setStatus('⏳ confirmando + criando tasks Auvo…');
  try {
    const r = await _api(`/operacional/api/routes/${RE.routeId}/confirm`, { method:'POST', body:{} });
    let msg = `✅ Confirmada (${r.sales_updated||0} sales atualizadas)`;
    if (r.auvo_sync) {
      const a = r.auvo_sync;
      if (a.ok) {
        msg += ` · Auvo: ${a.created} task(s) criadas, ${a.skipped_already_synced} já existiam`;
        if (a.errors?.length) msg += ` · ⚠ ${a.errors.length} erros`;
      } else {
        msg += ` · ⚠ Auvo sync falhou: ${a.error || ''}`;
      }
    }
    setStatus(msg, '#22c55e');
    await reLoad();
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

async function reSyncAuvo() {
  if (!confirm('Sincronizar com Auvo agora?\n\nCria tasks pra cada parada que ainda não tem auvo_task_id.')) return;
  setStatus('⏳ criando tasks Auvo…');
  try {
    const r = await _api(`/operacional/api/routes/${RE.routeId}/sync-auvo`, { method:'POST', body:{} });
    if (!r.ok) { setStatus(`⚠ ${r.error || 'falhou'}`, '#fbbf24'); return; }
    let msg = `✅ ${r.created} task(s) criadas no Auvo · ${r.skipped_already_synced} já tinham · ${r.stops_total} total`;
    if (r.errors?.length) {
      msg += `\n⚠ ${r.errors.length} erros: ${r.errors.slice(0,3).map(e => `stop ${e.stop_id}: ${e.error?.substring(0,80)||'?'}`).join(' · ')}`;
      setStatus(msg, '#fbbf24');
    } else {
      setStatus(msg, '#22c55e');
    }
    await reLoad();
  } catch (e) { setStatus('❌ ' + e.message, '#f87171'); }
}

reLoad();
</script>

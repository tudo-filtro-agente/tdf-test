<script>
// MODULE TOGGLE
function toggleModule(header) {
  const mod = header.parentElement;
  mod.classList.toggle('open');
}

// QUIZ CHECKING
function checkQuiz(btn) {
  const question = btn.closest('.quiz-question');
  const correct = question.getAttribute('data-correct');
  const selected = question.querySelector('input:checked');
  const answers = question.querySelectorAll('.quiz-answer');
  answers.forEach(a => a.style.display = 'none');
  if (!selected) { alert('Selecione uma opcao antes de verificar.'); return; }
  if (selected.value === correct) {
    question.querySelector('.quiz-answer.correct').style.display = 'block';
  } else {
    question.querySelector('.quiz-answer.incorrect').style.display = 'block';
  }
}

// PROGRESS TRACKING
function saveProgress() {
  const checkboxes = document.querySelectorAll('.checklist input[type="checkbox"]');
  const state = {};
  let checked = 0;
  let total = checkboxes.length;
  checkboxes.forEach(cb => {
    state[cb.id] = cb.checked;
    if (cb.checked) checked++;
  });
  localStorage.setItem('tdf-onboarding-progress-<%= user.username %>', JSON.stringify(state));
  updateProgressBar(checked, total);
}

function loadProgress() {
  const saved = localStorage.getItem('tdf-onboarding-progress-<%= user.username %>');
  if (!saved) return;
  const state = JSON.parse(saved);
  const checkboxes = document.querySelectorAll('.checklist input[type="checkbox"]');
  let checked = 0;
  let total = checkboxes.length;
  checkboxes.forEach(cb => {
    if (state[cb.id]) { cb.checked = true; checked++; }
  });
  updateProgressBar(checked, total);
}

function updateProgressBar(checked, total) {
  const pct = total > 0 ? Math.round((checked / total) * 100) : 0;
  document.getElementById('progress-pct').textContent = pct + '%';
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('cert-progress').textContent = 'Progresso: ' + pct + '%';
  const status = document.getElementById('cert-status');
  if (pct === 100) {
    status.textContent = 'CERTIFICADO VALIDADO -- Parabens!';
    status.style.color = 'var(--success)';
    document.getElementById('cert-date').textContent = 'Data: ' + new Date().toLocaleDateString('pt-BR');
  } else {
    status.textContent = 'Complete todos os checklists para validar o certificado.';
    status.style.color = 'var(--warning)';
  }
}

document.addEventListener('DOMContentLoaded', function() {
  loadProgress();
  const firstMod = document.querySelector('.module');
  if (firstMod) firstMod.classList.add('open');
});
</script>


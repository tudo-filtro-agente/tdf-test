    <p style="margin-top: 24px; font-size: 0.85rem; color: var(--text-muted);">
      <span id="cert-progress">Progresso: 0%</span><br>
      <span id="cert-status" style="color: var(--warning);">Complete todos os checklists para validar o certificado.</span>

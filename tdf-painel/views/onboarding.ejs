        <tr><td>Agua com areia/turva</td><td>Sedimentos</td><td><strong>Pre-filtro</strong></td></tr>
        <tr><td>Cheiro de ovo podre</td><td>Enxofre (H2S)</td><td><strong>Iron Free</strong></td></tr>
      </table></div>

      <h3>Tabela Iron Free</h3>

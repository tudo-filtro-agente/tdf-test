        <li><input type="checkbox" id="c3_1" onchange="saveProgress()"><label for="c3_1">Conheco todos os filtros de entrada (Light, Filtrali, American Inox, American FRP)</label></li>
        <li><input type="checkbox" id="c3_2" onchange="saveProgress()"><label for="c3_2">Sei o preco e garantia do American Filter Inox</label></li>

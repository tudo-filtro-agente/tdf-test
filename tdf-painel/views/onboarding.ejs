        <li><input type="checkbox" id="c1_2" onchange="saveProgress()"><label for="c1_2">Entendi a estrutura do time e o papel de cada funcao</label></li>
        <li><input type="checkbox" id="c1_3" onchange="saveProgress()"><label for="c1_3">Sei quais sao as 3 ferramentas principais (Zoho, WATI, GoTo)</label></li>
        <li><input type="checkbox" id="c1_4" onchange="saveProgress()"><label for="c1_4">Entendi que meu papel inicial e hibrido SDR/Closer</label></li>
      </ul>


        <tr><th>Modelo</th><th>Vazao</th><th>Indicacao</th><th>Preco</th></tr>
        <tr><td>Iron Free 1000</td><td>Ate 1.000 L/h</td><td>Residencial pequeno</td><td>R$5.990</td></tr>
        <tr><td>Iron Free 1500</td><td>Ate 1.500 L/h</td><td>Residencial medio</td><td>R$7.990</td></tr>

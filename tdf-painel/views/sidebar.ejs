/* ===== SOM (migrado do nav antigo) ===== */
const TDF_SONS_TODOS = ['icq','msn','msn_msg','msn_login','nudge','sino','pop'];
function tdfSomEscolher(t){ window.tdfSons?.setTipo(t); window.tdfSons?.setMute(false); TDF_SONS_TODOS.forEach(x => { const el = document.getElementById('tdf-som-'+x); if (el) el.style.display = (x===t?'inline':'none'); }); window.tdfSons?.tocar(t); tdfSomAtualizarBtn(); }
function tdfSomTestar(){ window.tdfSons?.tocar(); }
function tdfSomMute(){ const m = !window.tdfSons?.isMute(); window.tdfSons?.setMute(m); tdfSomAtualizarBtn(); const ml=document.getElementById('tdf-som-mute-lbl'); if(ml) ml.textContent = m ? '🔊 Ativar som' : '🔇 Silenciar'; }
function tdfSomAtualizarBtn(){ const b = document.getElementById('tdf-som-btn'); if (b) b.textContent = window.tdfSons?.isMute() ? '🔇' : '🔔'; }
document.addEventListener('DOMContentLoaded', () => {
  const t = window.tdfSons?.getTipo() || 'icq';
  TDF_SONS_TODOS.forEach(x => { const el = document.getElementById('tdf-som-'+x); if (el) el.style.display = (x===t?'inline':'none'); });
  tdfSomAtualizarBtn();
  const muteLbl = document.getElementById('tdf-som-mute-lbl');
  if (muteLbl) muteLbl.textContent = window.tdfSons?.isMute() ? '🔊 Ativar som' : '🔇 Silenciar';
});

/* ===== DROPDOWN (.nav-drop) — usado pelo Som no rodapé ===== */
document.addEventListener('click', function(e){
  const btn = e.target.closest('.nav-drop-btn');
  if (btn) {
    const drop = btn.closest('.nav-drop');
    if (drop) {
      const jaAberto = drop.classList.contains('open');
      document.querySelectorAll('.nav-drop.open').forEach(d => d.classList.remove('open'));
      if (!jaAberto) drop.classList.add('open');
      e.stopPropagation(); e.preventDefault(); return;
    }
  }
  if (!e.target.closest('.nav-drop-menu')) {
    document.querySelectorAll('.nav-drop.open').forEach(d => d.classList.remove('open'));
  }
});

/* ===== SIDEBAR: recolher, filtrar, grupos, mobile ===== */
function tdfSidebarToggle(){
  const sb = document.getElementById('tdfSidebar');
  sb.classList.toggle('collapsed');
  try { localStorage.setItem('tdfSidebarCollapsed', sb.classList.contains('collapsed') ? '1':'0'); } catch(_){}
}
function tdfSidebarMobile(force){
  const sb = document.getElementById('tdfSidebar');
  const ov = document.getElementById('tsbOverlay');
  const abrir = (force === undefined) ? !sb.classList.contains('mobile-open') : force;
  sb.classList.toggle('mobile-open', abrir);
  ov.classList.toggle('show', abrir);
}
function tdfSidebarFiltrar(q){
  q = (q||'').trim().toLowerCase();
  document.querySelectorAll('#tsbNav .tsb-group').forEach(g => {
    let any = false;
    g.querySelectorAll('.tsb-item').forEach(it => {
      const hit = it.textContent.toLowerCase().includes(q);
      it.style.display = hit ? 'flex' : 'none';
      if (hit) any = true;
    });
    g.style.display = any ? 'block' : 'none';
    if (q) g.classList.remove('collapsed');
  });
}
document.addEventListener('DOMContentLoaded', () => {
  // restaura estado recolhido
  try { if (localStorage.getItem('tdfSidebarCollapsed') === '1') document.getElementById('tdfSidebar').classList.add('collapsed'); } catch(_){}
  // grupos colapsáveis (clique no título)
  document.querySelectorAll('#tsbNav .tsb-group-title').forEach(t => {
    t.addEventListener('click', () => t.closest('.tsb-group').classList.toggle('collapsed'));
  });
  // abre o grupo que contém o item ativo; fecha os demais por padrão? -> mantém todos abertos, só garante ativo visível
  const ativo = document.querySelector('#tsbNav .tsb-item.active');
  if (ativo) ativo.closest('.tsb-group')?.classList.remove('collapsed');
});
// Atalho ⌘K / Ctrl+K -> foca busca
document.addEventListener('keydown', e => {
  if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); document.getElementById('tsbQ')?.focus(); }
});
</script>

      <button onclick="tdfFecharPop()" style="background:transparent;border:1px solid #2a3a4d;color:#8899AA;border-radius:10px;padding:12px 16px;font-weight:600;cursor:pointer;font-family:inherit">Depois</button>
    </div>
  </div>
</div>
<style>@keyframes tdfPopIn{from{opacity:0;transform:translateY(14px) scale(.97)}to{opacity:1;transform:none}}</style>
<script>
(function(){
  var KEY='tdf_popup_playbook_v1';
  try{ if(!localStorage.getItem(KEY)){ var el=document.getElementById('tdfNovidadePop'); if(el){ el.style.display='flex'; } } }catch(e){}
  window.tdfFecharPop=function(){ try{localStorage.setItem(KEY,'1');}catch(e){} var el=document.getElementById('tdfNovidadePop'); if(el) el.style.display='none'; };
  var ov=document.getElementById('tdfNovidadePop');
  if(ov) ov.addEventListener('click',function(e){ if(e.target===ov) tdfFecharPop(); });
})();
</script>


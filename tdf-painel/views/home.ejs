<% if (typeof prazoTreino !== 'undefined' && prazoTreino && !prazoTreino.certificado) { %>
<!-- ===== POPUP PRAZO (168h) — urgência para closers atrasados ===== -->
<div id="prazoPop" data-nome="<%= prazoTreino.nome %>" style="display:none;position:fixed;inset:0;z-index:100000;background:rgba(10,0,0,.85);backdrop-filter:blur(4px);align-items:center;justify-content:center;padding:18px">
  <div style="max-width:440px;width:100%;background:linear-gradient(160deg,#2a0808,var(--bg) 65%);border:1px solid #ef4444aa;border-radius:18px;box-shadow:0 24px 70px rgba(0,0,0,.7);overflow:hidden;animation:tdfPopIn .25s ease">
    <div style="background:linear-gradient(90deg,#b91c1c,#ef4444);padding:9px 16px;text-align:center;color:#fff;font-weight:900;letter-spacing:1px">🚨 PRAZO CORRENDO 🚨</div>
    <div style="padding:20px;text-align:center">
      <div style="font-size:2.2rem">⏰</div>
      <h2 style="margin:8px 0;color:var(--text);font-size:1.3rem">Acelera, <%= prazoTreino.nome %>!</h2>
      <p style="color:#c9d4de;font-size:.92rem;line-height:1.5;margin:0 0 12px">Você tem <b>168 horas</b> para concluir o treinamento de <b><%= prazoTreino.academia.nome %></b> e tirar o certificado. O relógio já está correndo:</p>
      <div id="prazoPopClock" style="font-variant-numeric:tabular-nums;font-weight:900;font-size:2rem;color:#ff6b6b;margin:8px 0 4px">--d --:--:--</div>
      <div style="color:#8899AA;font-size:.8rem;margin-bottom:14px">Progresso atual: <b style="color:#c9d4de"><%= prazoTreino.concluidos %>/<%= prazoTreino.total %> módulos (<%= prazoTreino.pct %>%)</b></div>
      <a href="<%= prazoTreino.academia.url %>" onclick="tdfFecharPrazo()" style="display:block;background:#ef4444;color:#fff;font-weight:800;text-decoration:none;padding:13px 16px;border-radius:11px;margin-bottom:8px">▶ Continuar treinamento agora</a>
      <button onclick="tdfFecharPrazo()" style="background:transparent;border:1px solid #3a2a2a;color:#8899AA;border-radius:10px;padding:9px 16px;font-weight:600;cursor:pointer;font-family:inherit">Depois (o relógio continua correndo)</button>
    </div>
  </div>
</div>
<% } %>

<script>
(function(){
  var el=document.getElementById('prazoBanner'); if(!el) return;
  var dl=new Date(el.dataset.deadline).getTime();
  function fmt(ms){ if(ms<=0) return 'PRAZO ENCERRADO'; var s=Math.floor(ms/1000); var d=Math.floor(s/86400); s%=86400; var h=Math.floor(s/3600); s%=3600; var m=Math.floor(s/60); s%=60; function p(n){return String(n).padStart(2,'0');} return d+'d '+p(h)+':'+p(m)+':'+p(s); }
  var c1=document.getElementById('prazoClock'), c2=document.getElementById('prazoPopClock');
  function tick(){ var r=dl-Date.now(); var t=fmt(r); if(c1)c1.textContent=t; if(c2)c2.textContent=t; if(r<=0){ if(c1){c1.style.color='#ff6b6b';} if(c2){c2.style.color='#ff6b6b';} } }
  tick(); setInterval(tick,1000);
  // popup 1x por dia enquanto atrasado e antes do prazo
  var pop=document.getElementById('prazoPop');
  if(pop && el.dataset.atrasado==='1' && (dl-Date.now())>0){
    var hoje=new Date().toISOString().slice(0,10); var K='tdf_prazo_pop_'+hoje;
    try{ if(!localStorage.getItem(K)){ pop.style.display='flex'; } }catch(e){ pop.style.display='flex'; }
    window.tdfFecharPrazo=function(){ try{localStorage.setItem(K,'1');}catch(e){} pop.style.display='none'; };
    pop.addEventListener('click',function(e){ if(e.target===pop) tdfFecharPrazo(); });
  }
})();
</script>


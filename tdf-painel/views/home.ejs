  <!-- ===== PROPOSTAS POR CATEGORIA ===== -->
  <div style="margin:0 auto 26px;max-width:1100px;padding:0 20px">
    <h2 style="color:var(--text);font-size:14px;text-transform:uppercase;letter-spacing:.5px;margin:0 0 12px;font-weight:800">📊 Propostas do mês <span id="hp-loading" style="font-weight:400;text-transform:none;color:var(--text-muted);font-size:11px">· carregando...</span></h2>
    <div id="hp-cards" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px"></div>
  </div>
  <script>
  (async function(){
    try {
      const r = await fetch('/home/propostas-categoria');
      const d = await r.json();
      if (d.error) throw new Error(d.error);
      const cards = document.getElementById('hp-cards');
      const lbls = {
        filtro_entrada: { l:'Filtro de Entrada', i:'💧', c:'#3b82f6' },
        bebedouro:      { l:'Bebedouro',         i:'🚰', c:'#22c55e' },
        purificador:    { l:'Purificador',       i:'🥤', c:'#f59e0b' },
        outros:         { l:'Outros',            i:'📦', c:'#a371f7' },
      };
      const fmt = v => v >= 1000 ? 'R$ '+(v/1000).toFixed(1).replace('.',',')+'k' : 'R$ '+Math.round(v);
      cards.innerHTML = ['filtro_entrada','bebedouro','purificador','outros'].map(k => {
        const lab = lbls[k];
        const h = d.stats.hoje[k]; const m = d.stats.mes[k];
        return `<div style="background:#0D1117;border:1px solid #30363D;border-left:4px solid ${lab.c};border-radius:10px;padding:14px 16px">
          <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
            <span style="font-size:18px">${lab.i}</span>
            <span style="color:#E6EDF3;font-weight:800;font-size:13px;flex:1">${lab.l}</span>
          </div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
            <div>
              <div style="color:#666;font-size:9px;text-transform:uppercase;letter-spacing:.4px;font-weight:700">Hoje</div>
              <div style="color:${lab.c};font-weight:800;font-size:16px;margin-top:2px">${fmt(h.valor)}</div>
              <div style="color:#888;font-size:10px;margin-top:1px">${h.count} proposta${h.count!==1?'s':''}</div>
            </div>
            <div>
              <div style="color:#666;font-size:9px;text-transform:uppercase;letter-spacing:.4px;font-weight:700">Mês</div>
              <div style="color:${lab.c};font-weight:800;font-size:16px;margin-top:2px">${fmt(m.valor)}</div>
              <div style="color:#888;font-size:10px;margin-top:1px">${m.count} proposta${m.count!==1?'s':''}</div>
            </div>
          </div>
        </div>`;
      }).join('');
      document.getElementById('hp-loading').style.display = 'none';
    } catch(e) {
      document.getElementById('hp-loading').textContent = '· erro: ' + e.message;
    }
  })();
  </script>


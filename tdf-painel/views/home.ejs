<% const activePage = 'home'; const pageTitle = 'Home'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<% if (typeof prazoTreino !== 'undefined' && prazoTreino) { %>
<!-- ===== COUNTDOWN DE TREINAMENTO (168h) — alvos: Catia, Larissa, Gabrielly ===== -->
<div id="prazoBanner" data-deadline="<%= prazoTreino.deadlineISO %>" data-atrasado="<%= prazoTreino.atrasado ? '1':'0' %>" data-cert="<%= prazoTreino.certificado ? '1':'0' %>"
  style="margin:0 0 14px;border-radius:14px;padding:14px 16px;background:linear-gradient(100deg,#2a0a0a,#3a1030);border:1px solid <%= prazoTreino.atrasado ? '#ef4444aa':'#3FB95066' %>;display:flex;align-items:center;gap:14px;flex-wrap:wrap">
  <div style="font-size:1.8rem">⏳</div>
  <div style="flex:1;min-width:220px">
    <div style="color:var(--text);font-weight:800;font-size:1rem"><%= prazoTreino.certificado ? '✅ Treinamento concluído!' : 'Prazo do treinamento de '+prazoTreino.academia.nome %></div>
    <div style="color:#c9d4de;font-size:.83rem;margin-top:2px">
      <% if (prazoTreino.certificado) { %>Parabéns, <%= prazoTreino.nome %> — você já está certificada. 🎉
      <% } else { %>Você tem <b>168 horas</b> para concluir e tirar o certificado. Progresso: <b><%= prazoTreino.concluidos %>/<%= prazoTreino.total %></b> (<%= prazoTreino.pct %>%).<% } %>
    </div>
  </div>
  <% if (!prazoTreino.certificado) { %>
  <div id="prazoClock" style="font-variant-numeric:tabular-nums;font-weight:900;font-size:1.35rem;color:#ffd0d0;background:#0b0410;border:1px solid #ef444455;border-radius:10px;padding:8px 12px;white-space:nowrap">--d --:--:--</div>
  <a href="<%= prazoTreino.academia.url %>" style="background:#ef4444;color:#fff;font-weight:800;text-decoration:none;padding:10px 16px;border-radius:10px;white-space:nowrap">▶ Acelerar agora</a>
  <% } %>
</div>
<% } %>

<div class="page-header">
  <h1>
    <%
      const hour = new Date().getHours();
      let greeting = 'Bom dia';
      if (hour >= 12 && hour < 18) greeting = 'Boa tarde';
      else if (hour >= 18) greeting = 'Boa noite';
    %>
    <%= greeting %>, <%= user.name %>!
  </h1>
  <p class="subtitle">Tudo de Filtro &mdash; Portal TDF</p>
</div>

<div class="container">

  <!-- MURAL DE NOVIDADES (atualizações recentes da plataforma) -->
  <div id="mural-novidades" style="background:linear-gradient(135deg,#1a0f2e 0%,#2a1a4e 100%);border:2px solid #c084fc;border-radius:16px;padding:24px;margin-bottom:20px;box-shadow:0 4px 24px rgba(192,132,252,.15)">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
      <span style="font-size:24px;">🚀</span>
      <h2 style="font-size:1.3rem;color:#c084fc;margin:0;">Novidades do Portal</h2>
      <span style="background:#ef4444;color:#fff;font-size:11px;font-weight:800;padding:3px 10px;border-radius:10px;animation:novPulse 2s infinite">RECÉM-LANÇADO</span>
      <% if (user.role === 'admin') { %>
      <span style="margin-left:auto;display:flex;gap:8px">
        <button onclick="agendarNovidades(this)" style="background:#1e3a5f;color:#7cb9f5;border:1px solid #5ba3f5;border-radius:8px;padding:6px 12px;font-size:11px;font-weight:700;cursor:pointer">📅 Agendar Z-API amanhã 7h</button>
        <button onclick="dispararNovidades(this)" style="background:#2d1215;color:#f87171;border:1px solid #ef4444;border-radius:8px;padding:6px 12px;font-size:11px;font-weight:700;cursor:pointer">🚀 Disparar agora</button>
      </span>
      <% } %>
    </div>
    <p style="color:#a78bfa;font-size:13px;margin:0 0 16px;font-style:italic">Tudo o que entrou no Portal nos últimos dias — leia e use.</p>

    <div id="mural-list" style="display:flex;flex-direction:column;gap:8px"></div>
    <div id="mural-status" style="font-size:11px;color:var(--text-muted);margin-top:12px;font-style:italic"></div>
  </div>
  <style>@keyframes novPulse{0%,100%{opacity:1}50%{opacity:.5}}</style>
  <script>
  (async function loadMural(){
    try{
      const res = await fetch('/cockpit/novidades');
      const d = await res.json();
      const isAdmin = '<%= user.role %>' === 'admin';
      document.getElementById('mural-list').innerHTML = (d.novidades||[])
        .filter(n => !n.admin_only || isAdmin)
        .map(n => `
        <details style="background:#0d0820;border:1px solid #4c1d95;border-radius:10px;padding:10px 14px">
          <summary style="cursor:pointer;list-style:none;display:flex;align-items:center;gap:8px">
            <span style="font-size:16px">${n.icon}</span>
            <strong style="color:#fff;font-size:13px;flex:1">${n.titulo}</strong>
            ${n.link ? `<a href="${n.link}" onclick="event.stopPropagation()" style="background:linear-gradient(135deg,#7c3aed,#a371f7);color:#fff;padding:4px 12px;border-radius:6px;font-size:11px;font-weight:800;text-decoration:none;white-space:nowrap">${n.link_label || 'Abrir →'}</a>` : ''}
            <span style="color:#a78bfa;font-size:12px">▾</span>
          </summary>
          <div style="color:#bbb;font-size:12px;line-height:1.5;margin-top:8px">${n.texto}</div>
        </details>
      `).join('');
      const s = d.state;
      if (s) {
        let txt = '';
        if (s.agendadoPara) {
          const dt = new Date(s.agendadoPara);
          txt = `📅 Agendado pra ${dt.toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'})}` + (s.scheduledBy?` por ${s.scheduledBy}`:'');
        }
        if (s.ultimoEnvio) {
          const dt = new Date(s.ultimoEnvio);
          txt += (txt?' • ':'') + `✅ Último envio: ${dt.toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'})}` + (s.sentTo?.length?` (${s.sentTo.length} closers)`:'');
        }
        document.getElementById('mural-status').textContent = txt;
      }
    }catch(e){ console.error(e); }
  })();

  async function agendarNovidades(btn){
    if (!confirm('Agendar disparo dos avisos via Z-API pra TODOS os closers amanhã às 7h BRT?')) return;
    btn.disabled = true; btn.textContent = 'Agendando...';
    try{
      const res = await fetch('/gestao/novidades/agendar', { method:'POST' });
      const r = await res.json();
      if (r.error) { alert('Erro: '+r.error); }
      else { alert('✅ Agendado! Disparo automático amanhã às 7h BRT.'); location.reload(); }
    }catch(e){ alert('Erro: '+e.message); }
    finally{ btn.disabled = false; btn.textContent = '📅 Agendar Z-API amanhã 7h'; }
  }
  async function dispararNovidades(btn){
    if (!confirm('Disparar AGORA pros closers? (rate limit 12s entre cada)')) return;
    btn.disabled = true; btn.textContent = 'Disparando...';
    try{
      const res = await fetch('/gestao/novidades/disparar', { method:'POST' });
      const r = await res.json();
      if (r.error) alert('Erro: '+r.error);
      else alert('🚀 Disparando em background. Vai levar alguns minutos. Você será notificado no seu Z-API ao final.');
    }catch(e){ alert('Erro: '+e.message); }
    finally{ btn.disabled = false; btn.textContent = '🚀 Disparar agora'; }
  }
  </script>


<style>
/* ============================================================
   TREINAMENTO MODULE STYLES
   ============================================================ */
.treino-module {
  max-width: 800px;
  margin: 0 auto;
  padding: 20px 20px 80px;
}
.treino-back {
  display: inline-block;
  color: var(--text-muted);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  margin-bottom: 24px;
  transition: color 0.2s;
}
.treino-back:hover { color: var(--accent); text-decoration: none; }

.treino-header {
  text-align: center;
  margin-bottom: 40px;
}
.treino-badge {
  display: inline-block;
  background: rgba(0,102,204,0.15);
  color: var(--accent);
  font-size: 12px;
  font-weight: 700;
  padding: 4px 14px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 12px;
}
.treino-header h1 {
  font-size: clamp(1.5rem, 4vw, 2rem);
  font-weight: 800;
  color: var(--text);
  margin-bottom: 8px;
}
.treino-subtitle {
  color: var(--text-muted);
  font-size: 15px;
  max-width: 600px;
  margin: 0 auto;
  line-height: 1.6;
}

/* Sections */
.treino-section {
  margin-bottom: 40px;
  padding-bottom: 32px;
  border-bottom: 1px solid var(--border);
}
.treino-section:last-of-type {
  border-bottom: none;
}
.treino-section h2 {
  font-size: 20px;
  font-weight: 800;
  color: var(--text);
  margin-bottom: 12px;
}
.treino-section h3 {
  font-size: 17px;
  font-weight: 700;
  color: var(--text);
  margin: 20px 0 10px;
}
.treino-section p {
  color: var(--text-muted);
  font-size: 15px;
  line-height: 1.7;
  margin-bottom: 12px;
}
.treino-section ul, .treino-section ol {
  padding-left: 20px;
  color: var(--text-muted);
  font-size: 15px;
  line-height: 1.8;
}

/* Tip box */
.treino-tip {
  background: rgba(0,170,255,0.08);
  border: 1px solid rgba(0,170,255,0.2);
  border-left: 4px solid var(--accent);
  border-radius: 8px;
  padding: 16px 20px;
  margin: 16px 0;
  color: var(--text);
  font-size: 14px;
  line-height: 1.6;
}

/* Example box */
.treino-example {
  background: var(--bg-card);
  border: 1px solid var(--border);
  border-left: 4px solid var(--primary);
  border-radius: 8px;
  padding: 16px 20px;
  margin: 12px 0;
  font-size: 14px;
  line-height: 1.7;
  color: var(--text);
}
.treino-example em {
  color: var(--accent);
  font-style: normal;
}
.treino-good {
  color: var(--green);
  font-weight: 700;
}
.treino-bad {
  color: var(--danger);
  font-weight: 700;
}

/* Do / Don't grid */
.treino-grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  margin: 16px 0;
}
@media (max-width: 600px) {
  .treino-grid-2 { grid-template-columns: 1fr; }
}
.treino-do, .treino-dont {
  border-radius: 10px;
  padding: 18px;
  font-size: 14px;
}
.treino-do {
  background: rgba(46,160,67,0.08);
  border: 1px solid rgba(46,160,67,0.2);
}
.treino-dont {
  background: rgba(248,81,73,0.08);
  border: 1px solid rgba(248,81,73,0.2);
}
.treino-do h4 {
  color: var(--green);
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 10px;
}
.treino-dont h4 {
  color: var(--danger);
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 10px;
}
.treino-do ul, .treino-dont ul {
  padding-left: 16px;
  line-height: 1.7;
}
.treino-do li { color: var(--text-muted); }
.treino-dont li { color: var(--text-muted); }

/* Table */
.treino-table-wrap {
  overflow-x: auto;
  margin: 16px 0;
}
.treino-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
}
.treino-table th {
  background: var(--bg-card);
  color: var(--text-muted);
  font-weight: 700;
  text-align: left;
  padding: 12px 16px;
  border-bottom: 2px solid var(--border);
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.treino-table td {
  padding: 12px 16px;
  border-bottom: 1px solid var(--border);
  color: var(--text-muted);
  vertical-align: top;
}
.treino-table tr:hover td {
  background: var(--bg-card);
}

/* Exercise box */
.treino-exercise {
  background: var(--bg-card);
  border: 2px solid var(--warning);
  border-radius: 12px;
  padding: 24px;
}
.treino-exercise h4 {
  color: var(--warning);
  font-size: 17px;
  font-weight: 700;
  margin-bottom: 12px;
}
.treino-exercise p, .treino-exercise ol, .treino-exercise li {
  color: var(--text-muted);
  font-size: 14px;
  line-height: 1.7;
}
.treino-exercise ol {
  padding-left: 20px;
  margin: 12px 0;
}

/* Simulator button */
.treino-sim-btn-wrap {
  text-align: center;
  margin-top: 20px;
}
.treino-sim-btn {
  display: inline-block;
  background: linear-gradient(135deg, #4F8CFF, #8B5CF6);
  color: #fff;
  padding: 12px 28px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  transition: transform 0.2s, box-shadow 0.2s;
}
.treino-sim-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(79,140,255,0.3);
  text-decoration: none;
  color: #fff;
}

/* Complete / Next buttons */
.treino-complete-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 40px;
  padding-top: 24px;
  border-top: 1px solid var(--border);
  flex-wrap: wrap;
}
.treino-complete-btn {
  background: var(--success);
  color: #fff;
  border: none;
  padding: 12px 24px;
  border-radius: 10px;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  transition: background 0.2s, transform 0.2s;
}
.treino-complete-btn:hover {
  background: #27903a;
  transform: translateY(-1px);
}
.treino-complete-btn.completed {
  background: var(--border);
  color: var(--text-muted);
  cursor: default;
}
.treino-next-btn {
  color: var(--accent);
  font-weight: 700;
  font-size: 14px;
  text-decoration: none;
  transition: color 0.2s;
}
.treino-next-btn:hover {
  color: var(--primary-light);
  text-decoration: none;
}
</style>

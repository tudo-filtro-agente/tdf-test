function rmEmailAdd(email){
  const ta = document.getElementById('rm-email-dest');
  const atual = ta.value.split(',').map(s => s.trim()).filter(Boolean);
  if (!atual.includes(email)) atual.push(email);
  ta.value = atual.join(', ');
}
async function rmEnviarEmail(btn){
  const dest = document.getElementById('rm-email-dest').value;
  const lista = dest.split(',').map(s => s.trim()).filter(s => /\S+@\S+\.\S+/.test(s));
  if (!lista.length) { alert('Digite ao menos 1 email válido'); return; }
  localStorage.setItem('rm_email_dest', dest);
  const status = document.getElementById('rm-email-status');
  btn.disabled = true; btn.textContent = '⏳ Enviando...';
  status.textContent = '';
  try {
    const r = await fetch('/gestao/reuniao-matinal/enviar-email', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        destinatarios: lista,
        resumo: window._RM_RESUMO,
        sinteses: (window._RM_SINTESES||[]).map(x => ({ dados: x.dados, sintese: x.sintese })),
      }),
    });
    const d = await r.json();
    if (d.error) { status.style.color = '#ef4444'; status.textContent = '❌ '+d.error; btn.disabled = false; btn.textContent = '📤 Enviar agora'; return; }
    if (d.queued) {
      status.style.color = '#f59e0b';
      status.textContent = '⚠️ SMTP indisponível ('+(d.motivo||'')+'). Email enfileirado pra envio pelo cron.';
    } else {
      status.style.color = '#10b981';
      status.textContent = '✅ Enviado! Message ID: '+(d.messageId||'').slice(0,40);
    }
    btn.textContent = '✅ Enviado';
    setTimeout(() => btn.closest('div[style*=fixed]').remove(), 2500);
  } catch(e) {
    status.style.color = '#ef4444';
    status.textContent = '❌ '+e.message;
    btn.disabled = false; btn.textContent = '📤 Enviar agora';
  }
}

function rmRenderResumo(sinteses){

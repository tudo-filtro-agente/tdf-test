        ${r.padroes_recorrentes?.length ? `<div class="rm-section"><h4 style="color:#a371f7">🔄 Padrões recorrentes (afetam vários closers)</h4>${r.padroes_recorrentes.map(p => '<div class="rm-list-item" style="--c:#a371f7">'+p+'</div>').join('')}</div>` : ''}
        ${r.topicos_coaching_grupo?.length ? `<div class="rm-section"><h4 style="color:#3b82f6">🎯 Coaching em grupo (na reunião)</h4>${r.topicos_coaching_grupo.map(p => '<div class="rm-list-item" style="--c:#3b82f6">'+p+'</div>').join('')}</div>` : ''}

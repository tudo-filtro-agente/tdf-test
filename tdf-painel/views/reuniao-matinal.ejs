            <span style="margin-left:auto;color:#fff;font-weight:700;font-size:12px">${h.total_closers} closers</span>
          </div>
          <div style="display:flex;gap:10px;font-size:10px;color:#aaa;margin-bottom:6px">
            <span style="color:#ef4444">🔴 ${h.criticos} críticos</span>
            <span style="color:#fbbf24">🟡 ${h.atencao} atenção</span>
            <span style="color:#22c55e">🟢 ${h.saudaveis} saudáveis</span>
          </div>
          ${h.resumo_executivo ? `<div style="color:#aaa;font-size:11px;line-height:1.5">${h.resumo_executivo.slice(0,250)}${h.resumo_executivo.length > 250 ? '...' : ''}</div>` : ''}
        </div>
      `;
    });
    document.getElementById('rm-hist-content').innerHTML = html;
  } catch(e) {
    document.getElementById('rm-hist-content').innerHTML = `<div style="color:#ef4444">${e.message}</div>`;
  }

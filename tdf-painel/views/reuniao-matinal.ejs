async function rmRodarTudo(){
  const closers = Array.from(document.getElementById('rm-closer-sel').options).filter(o => o.value).map(o => o.value);
  const btn = document.getElementById('rm-btn-tudo');
  const status = document.getElementById('rm-status');
  btn.disabled = true;
  _RM_DOSSIES = [];
  rmAba('resumo');
  const erros = [];
  document.getElementById('rm-resumo-time').innerHTML = '<div style="text-align:center;padding:30px;color:#888">⏳ Buscando dados de '+closers.length+' closers... (1-3min)<br><div id="rm-erros-log" style="margin-top:14px;text-align:left;font-size:11px;color:#ef4444;max-width:600px;margin:14px auto 0"></div></div>';
  function logErro(msg){ erros.push(msg); const el = document.getElementById('rm-erros-log'); if (el) el.innerHTML = erros.map(e => '⚠️ '+e).join('<br>'); }
  // Busca dados em paralelo (chunks de 3 pra não sobrecarregar)
  for (let i = 0; i < closers.length; i += 3) {
    const chunk = closers.slice(i, i+3);
    status.textContent = `⏳ ${i+chunk.length}/${closers.length} closers · dados...`;
    const results = await Promise.all(chunk.map(async (cl) => {
      try {
        const r = await fetch('/gestao/reuniao-matinal/dados?closer='+encodeURIComponent(cl));
        const d = await r.json();
        if (d.error) { logErro(`${cl}: ${d.error}`); return null; }
        return d;
      } catch(e) { logErro(`${cl}: ${e.message}`); return null; }
    }));
    _RM_DOSSIES.push(...results.filter(Boolean));
  }
  if (!_RM_DOSSIES.length) {
    document.getElementById('rm-resumo-time').innerHTML = `
      <div style="background:rgba(239,68,68,.1);border:1px solid #ef4444;border-radius:10px;padding:18px;text-align:left">
        <h3 style="color:#ef4444;margin:0 0 8px;font-size:14px">❌ Nenhum dossiê pôde ser gerado</h3>
        <div style="color:#fca5a5;font-size:12px;margin-bottom:8px">Tentei ${closers.length} closers mas todos falharam. Erros:</div>
        <div style="color:#fca5a5;font-size:11px;font-family:monospace;background:#0a0a0a;padding:10px;border-radius:5px">
          ${erros.map(e => '⚠️ '+e).join('<br>') || '(sem erros logados — endpoint pode ter retornado vazio)'}
        </div>
      </div>
    `;
    btn.disabled = false;
    status.textContent = '❌ Falhou pra '+closers.length+' closers';
    return;
  }
  // Agora roda IA pra cada (chunks de 4)
  status.textContent = '🤖 IA analisando dossiês individuais...';
  const sinteses = [];
  for (let i = 0; i < _RM_DOSSIES.length; i += 4) {
    const chunk = _RM_DOSSIES.slice(i, i+4);
    status.textContent = `🤖 ${i+chunk.length}/${_RM_DOSSIES.length} closers · IA...`;
    const results = await Promise.all(chunk.map(async (dados) => {
      try {
        const r = await fetch('/gestao/reuniao-matinal/sintese-ia', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ dados }),
        });
        const s = await r.json();
        if (s.error) { logErro(`IA ${dados.closer}: ${s.error}`); return null; }
        return { dados, sintese: s };
      } catch(e) { logErro(`IA ${dados.closer}: ${e.message}`); return null; }
    }));
    sinteses.push(...results.filter(Boolean));
  }
  if (!sinteses.length) {
    document.getElementById('rm-resumo-time').innerHTML = `
      <div style="background:rgba(239,68,68,.1);border:1px solid #ef4444;border-radius:10px;padding:18px">
        <h3 style="color:#ef4444;margin:0 0 8px;font-size:14px">❌ IA não retornou nenhuma análise</h3>
        <div style="color:#fca5a5;font-size:12px;margin-bottom:8px">${_RM_DOSSIES.length} dossiês carregados, mas todas as ${_RM_DOSSIES.length} chamadas IA falharam:</div>
        <div style="color:#fca5a5;font-size:11px;font-family:monospace;background:#0a0a0a;padding:10px;border-radius:5px;max-height:240px;overflow-y:auto">
          ${erros.map(e => '⚠️ '+e).join('<br>') || '(verifique ANTHROPIC_API_KEY)'}
        </div>
        <div style="color:#fbbf24;font-size:11px;margin-top:8px">💡 Verifique se ANTHROPIC_API_KEY está configurada no Railway.</div>
      </div>
    `;
    btn.disabled = false;
    status.textContent = '❌ IA falhou';
    return;
  }
  // Agora pega resumo do time
  status.textContent = '🤖 Resumo executivo do time...';
  try {
    const r = await fetch('/gestao/reuniao-matinal/resumo-time', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ dossies: sinteses.map(x => ({ closer: x.dados.closer, ...x.sintese })) }),
    });
    _RM_RESUMO = await r.json();
    if (_RM_RESUMO.error) logErro('Resumo time: '+_RM_RESUMO.error);
  } catch(e) { _RM_RESUMO = null; logErro('Resumo time: '+e.message); }
  // Renderiza tudo
  rmRenderResumo(sinteses);
  rmRenderRankings(sinteses);
  window._RM_SINTESES = sinteses;
  document.getElementById('rm-btn-email').style.display = 'inline-block';
  let msg = `✅ ${sinteses.length}/${closers.length} closers analisados`;
  if (erros.length) msg += ` · ${erros.length} erro(s)`;
  status.textContent = msg + ' · ' + new Date().toLocaleTimeString('pt-BR');
  btn.disabled = false;
  // Auto-salvar no histórico
  try {
    const r = await fetch('/gestao/reuniao-matinal/salvar-historico', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({
        resumo: _RM_RESUMO,
        sinteses: sinteses.map(x => ({ dados: x.dados, sintese: x.sintese })),
      }),
    });
    const d = await r.json();
    if (!d.error) status.textContent += ' · 💾 Salvo no histórico';
  } catch(_){}
}


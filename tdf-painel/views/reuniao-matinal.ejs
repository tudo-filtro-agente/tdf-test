        ${d.top3_risco?.length ? `<h4 style="font-size:11px;color:#ef4444;text-transform:uppercase;font-weight:800;margin:14px 0 6px">Top 3 deals em risco</h4>` + d.top3_risco.map(d => '<div class="rm-list-item" style="--c:#ef4444"><strong>'+d.nome+'</strong> · '+(d.tier||'?')+' · '+rmFmtR(d.valor)+' · '+d.horas_parado+'h parado · '+d.stage+'</div>').join('') : ''}
        ${d.perdidos_amostra?.length ? `<h4 style="font-size:11px;color:#9ca3af;text-transform:uppercase;font-weight:800;margin:14px 0 6px">Perdidos recentes (motivos)</h4>` + d.perdidos_amostra.map(p => '<div class="rm-list-item" style="--c:#9ca3af">'+p.nome+' · '+rmFmtR(p.valor)+' · <em>'+(p.motivo||'?')+'</em></div>').join('') : ''}

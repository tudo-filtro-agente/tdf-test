async function rmAbrirDossieHist(id){
  try {
    const r = await fetch('/gestao/reuniao-matinal/historico/'+encodeURIComponent(id));
    const d = await r.json();
    if (d.error) { alert(d.error); return; }
    // Reconstrói _RM_SINTESES no formato esperado pelo render
    const sinteses = (d.sinteses || []).map(s => ({
      dados: {
        closer: s.closer,
        crmOwner: s.crmOwner,
        ontem: { calls: { outbound: s.kpis?.ontem_calls_outbound||0 }, vendas: s.kpis?.ontem_vendas||0, receita: s.kpis?.ontem_receita||0 },
        semana: { calls: { outbound: s.kpis?.semana_calls_outbound||0 }, answer_rate: s.kpis?.semana_answer_rate, vendas: s.kpis?.semana_vendas||0, receita: s.kpis?.semana_receita||0 },
        mes: { vendas: s.kpis?.mes_vendas||0, receita: s.kpis?.mes_receita||0, delta_pct: s.kpis?.mes_delta_pct },
      },
      sintese: {
        classificacao: s.classificacao,
        veredito_curto: s.veredito_curto,
        pontos_criticos: s.pontos_criticos,
        pontos_atencao: s.pontos_atencao,
        gaps_identificados: s.gaps_identificados,
        acoes_recomendadas: s.acoes_recomendadas,
        destaques_positivos: s.destaques_positivos,
        topico_coaching: s.topico_coaching,
        comparacao_time: s.comparacao_time,
      },
    }));
    _RM_RESUMO = d.resumo;
    _RM_SINTESES = sinteses;
    window._RM_SINTESES = sinteses;
    rmAba('resumo');
    rmRenderResumo(sinteses);
    rmRenderRankings(sinteses);
    document.getElementById('rm-btn-email').style.display = 'inline-block';
    document.getElementById('rm-status').textContent = '📚 Visualizando histórico de ' + new Date(d.geradoEm).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo'});
    // Fecha modal
    document.querySelector('div[style*="z-index:2500"]')?.remove();
  } catch(e) { alert(e.message); }
}


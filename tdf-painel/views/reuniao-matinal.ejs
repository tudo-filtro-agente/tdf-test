        ${r.celebracoes?.length ? `<div class="rm-section"><h4 style="color:#10b981">🎉 Celebrar publicamente</h4>${r.celebracoes.map(p => '<div class="rm-list-item" style="--c:#10b981">'+p+'</div>').join('')}</div>` : ''}
      </div>
    `;
  }
  // Cards individuais resumidos
  html += '<h3 style="margin:18px 0 10px;color:#9ca3af;font-size:13px;text-transform:uppercase;font-weight:700;letter-spacing:.4px">Veredito por closer</h3>';
  html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:10px">';
  sinteses.forEach(({dados, sintese}) => {
    const cls = sintese.classificacao || 'atencao';
    html += `
      <div class="rm-card ${cls}" style="cursor:pointer" onclick="document.getElementById('rm-closer-sel').value='${(_MT_USERS||{})[dados.crmOwner]||''}';rmRodarUm()">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
          <span class="rm-closer-pill">👤 ${dados.closer}</span>
          <span class="rm-veredito ${cls}" style="margin:0;padding:3px 8px;font-size:10px">${cls.toUpperCase()}</span>
        </div>
        <div style="color:#e5e7eb;font-size:12px;line-height:1.4;margin-bottom:8px">${sintese.veredito_curto||''}</div>
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:4px;font-size:10px;color:#9ca3af">
          <div>📞 ${dados.semana.calls.outbound||0}/7d</div>
          <div>🏆 ${dados.semana.vendas||0} vendas</div>
          <div>💰 ${rmFmtR(dados.semana.receita)}</div>
        </div>
      </div>
    `;
  });
  html += '</div>';
  document.getElementById('rm-resumo-time').innerHTML = html;
}

function rmRenderRankings(sinteses){
  const ordCalls = [...sinteses].sort((a,b) => (b.dados.semana.calls.outbound||0) - (a.dados.semana.calls.outbound||0));
  const ordVendas = [...sinteses].sort((a,b) => (b.dados.semana.vendas||0) - (a.dados.semana.vendas||0));
  const ordReceita = [...sinteses].sort((a,b) => (b.dados.semana.receita||0) - (a.dados.semana.receita||0));
  function row(s, val, cor){ return `<div class="rm-list-item" style="--c:${cor};display:flex;align-items:center;gap:8px"><strong style="flex:1">${s.dados.closer}</strong><span style="color:${cor};font-weight:800">${val}</span></div>`; }
  document.getElementById('rm-rankings-content').innerHTML = `
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px">
      <div class="rm-card">
        <h3 style="font-size:13px;color:#fbbf24;margin:0 0 10px">📞 Mais ligações outbound (7d)</h3>
        ${ordCalls.slice(0,10).map(s => row(s, s.dados.semana.calls.outbound||0, '#fbbf24')).join('')}
      </div>
      <div class="rm-card">
        <h3 style="font-size:13px;color:#10b981;margin:0 0 10px">🏆 Mais vendas (7d)</h3>
        ${ordVendas.slice(0,10).map(s => row(s, s.dados.semana.vendas||0, '#10b981')).join('')}
      </div>
      <div class="rm-card">
        <h3 style="font-size:13px;color:#22c55e;margin:0 0 10px">💰 Mais faturamento (7d)</h3>
        ${ordReceita.slice(0,10).map(s => row(s, rmFmtR(s.dados.semana.receita), '#22c55e')).join('')}
      </div>
    </div>
  `;
}
</script>

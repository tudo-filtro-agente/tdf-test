<% const activePage = 'operacional'; const pageTitle = 'Operacional · Gantt das Rotas'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
  .gt-shell { max-width: 1400px; margin: 0 auto; padding: 0 14px; }
  .gt-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; flex-wrap: wrap; gap: 10px; }
  .gt-head h1 { margin: 0; font-size: 18px; color: var(--text); }
  .gt-head .sub { color: var(--text-muted); font-size: 12px; margin-top: 2px; }
  .gt-nav { display: flex; gap: 6px; align-items: center; }
  .gt-nav button, .gt-nav input { background: var(--bg-card); border: 1px solid var(--border); color: var(--text); padding: 6px 12px; border-radius: 6px; font-size: 12px; cursor: pointer; }
  .gt-nav input { font-family: inherit; }
  .gt-nav button:hover { background: #1f6feb; }

  .gt-board { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; }

  .gt-grid {
    --hour-w: 60px;
    --lane-h: 56px;
    position: relative;
    overflow-x: auto;
  }
  .gt-header {
    display: grid;
    grid-template-columns: 180px repeat(16, var(--hour-w));
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky; top: 0; z-index: 5;
  }
  .gt-header .gh-tech { padding: 10px 12px; font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; font-weight: 700; border-right: 1px solid var(--border); }
  .gt-header .gh-hour { padding: 8px 0; text-align: center; font-size: 11px; color: var(--text-muted); font-variant-numeric: tabular-nums; border-right: 1px dashed var(--border); }
  .gt-header .gh-hour.now { color: #fbbf24; font-weight: 700; }

  .gt-lane {
    display: grid;
    grid-template-columns: 180px 1fr;
    border-bottom: 1px solid var(--border);
    min-height: var(--lane-h);
  }
  .gt-lane:hover .gt-lane-tech { background: #1f2937; }
  .gt-lane-tech {
    padding: 8px 12px; border-right: 1px solid var(--border);
    display: flex; flex-direction: column; justify-content: center;
    background: var(--bg-card);
    position: sticky; left: 0; z-index: 2;
  }
  .gt-lane-tech .name { color: var(--text); font-weight: 700; font-size: 12px; }
  .gt-lane-tech .meta { color: var(--text-muted); font-size: 10px; margin-top: 2px; }

  .gt-lane-body {
    position: relative;
    background-image:
      repeating-linear-gradient(to right, transparent, transparent calc(var(--hour-w) - 1px), var(--border) calc(var(--hour-w) - 1px), var(--border) var(--hour-w));
    min-height: var(--lane-h);
  }
  .gt-lane-body .gl-band {
    /* fora da jornada — cinza escuro */
    position: absolute; top: 0; bottom: 0;
    background: rgba(15,23,42,.6);
  }
  .gt-lane-body .gl-lunch {
    /* almoço — cinza médio */
    position: absolute; top: 0; bottom: 0;
    background: rgba(100,116,139,.25);
    border-left: 1px dashed #475569;
    border-right: 1px dashed #475569;
  }
  .gt-lane-body .gl-stop {
    position: absolute;
    top: 6px; bottom: 6px;
    background: var(--c, #1f6feb);
    border-radius: 5px;
    padding: 4px 8px;
    color: var(--text);
    font-size: 10px;
    cursor: pointer;
    overflow: hidden;
    box-shadow: 0 2px 4px rgba(0,0,0,.3);
    border-left: 3px solid rgba(255,255,255,.4);
    transition: transform .1s, box-shadow .1s;
  }
  .gt-lane-body .gl-stop:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0,0,0,.5);
    z-index: 10;
  }
  .gt-lane-body .gl-stop .seq { font-weight: 800; margin-right: 5px; }
  .gt-lane-body .gl-stop .name { font-weight: 700; }
  .gt-lane-body .gl-stop .time { opacity: .85; font-size: 9px; margin-top: 2px; }
  .gt-lane-body .gl-stop.urgent { background: #ef4444; }
  .gt-lane-body .gl-stop.high { background: #fb923c; }
  .gt-lane-body .gl-stop.condo { border-left-color: #fbbf24; }
  .gt-lane-body .gl-stop.pickup { box-shadow: 0 0 0 1px #22d3ee, 0 2px 4px rgba(0,0,0,.3); }

  .gt-lane-body .gl-now {
    position: absolute; top: 0; bottom: 0;
    border-left: 2px solid #ef4444;
    z-index: 3;
  }
  .gt-lane-body .gl-now::before {
    content: 'AGORA';
    position: absolute; top: -16px; left: -22px;
    background: #ef4444; color:#fff;
    font-size: 9px; font-weight: 800; padding: 2px 6px;
    border-radius: 3px;
  }

  .gt-empty { padding: 40px; text-align: center; color: var(--text-muted); }
  .gt-legend { display: flex; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border-top: 1px solid var(--border); background: var(--bg); font-size: 10px; color: var(--text-muted); }
  .gt-legend span.l { display: inline-flex; align-items: center; gap: 4px; }
  .gt-legend .sw { width: 10px; height: 10px; border-radius: 2px; }

  .btn { padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 700; cursor: pointer; border: 1px solid; background: transparent; }
  .btn-sec { color: #93c5fd; border-color: #1f6feb; }
</style>

<div class="gt-shell">
  <div class="gt-head">
    <div>
      <h1>📅 Gantt das Rotas</h1>
      <div class="sub">Timeline visual das paradas agendadas por técnico. Click numa parada vai pro editor da rota.</div>
    </div>
    <div class="gt-nav">
      <button onclick="gtPrev()">← dia</button>
      <input type="date" id="gt-date" onchange="gtLoad()">
      <button onclick="gtToday()">Hoje</button>
      <button onclick="gtNext()">dia →</button>
      <button class="btn btn-sec" onclick="gtLoad()" style="background:#1f6feb;color:#fff">🔄 Atualizar</button>
      <a href="/operacional" class="btn btn-sec" style="text-decoration:none">← Painel</a>
    </div>
  </div>

  <div class="gt-board">
    <div id="gt-content"><div class="gt-empty">Carregando…</div></div>
    <div class="gt-legend">
      <span class="l"><span class="sw" style="background:#1f6feb"></span>Normal</span>
      <span class="l"><span class="sw" style="background:#fb923c"></span>High</span>
      <span class="l"><span class="sw" style="background:#ef4444"></span>Urgent</span>
      <span class="l"><span class="sw" style="background:#fbbf24"></span>Condomínio (borda)</span>
      <span class="l"><span class="sw" style="background:#22d3ee"></span>Pickup material (anel)</span>
      <span class="l"><span class="sw" style="background:rgba(100,116,139,.6)"></span>Almoço</span>
      <span class="l"><span class="sw" style="background:rgba(15,23,42,.8)"></span>Fora da jornada</span>
    </div>
  </div>
</div>

<script>
const GT = { date: null, hours: { start: 6, end: 22 } };

async function _api(p) {
  const r = await fetch(p, { credentials: 'same-origin' });
  if (!r.ok) throw new Error(`${r.status}`);
  return r.json();
}

function gtSetDate(d) {
  GT.date = d;
  document.getElementById('gt-date').value = d;
}
function gtToday() { gtSetDate(new Date().toISOString().slice(0,10)); gtLoad(); }
function gtPrev() { const d = new Date(GT.date); d.setDate(d.getDate()-1); gtSetDate(d.toISOString().slice(0,10)); gtLoad(); }
function gtNext() { const d = new Date(GT.date); d.setDate(d.getDate()+1); gtSetDate(d.toISOString().slice(0,10)); gtLoad(); }

function hhmmToFraction(hhmm) {
  if (!hhmm) return null;
  const [h, m] = hhmm.split(':').map(Number);
  return h + m/60;
}
function isoToFraction(iso) {
  if (!iso) return null;
  const d = new Date(iso);
  return d.getHours() + d.getMinutes()/60;
}

async function gtLoad() {
  if (!GT.date) GT.date = new Date().toISOString().slice(0,10);
  const c = document.getElementById('gt-content');
  c.innerHTML = '<div class="gt-empty">⏳ Carregando…</div>';
  try {
    const data = await _api(`/operacional/api/routes/gantt?date=${GT.date}`);
    if (!data.lanes?.length) {
      c.innerHTML = `<div class="gt-empty">📭 Nenhuma rota agendada para ${GT.date}</div>`;
      return;
    }
    // Build header com horas
    const hStart = GT.hours.start, hEnd = GT.hours.end;
    const cols = hEnd - hStart;
    const nowD = new Date();
    const isToday = data.date === new Date().toISOString().slice(0,10);
    const nowFrac = nowD.getHours() + nowD.getMinutes()/60;
    const nowCol = isToday && nowFrac >= hStart && nowFrac <= hEnd
      ? ((nowFrac - hStart) / cols * 100) : null;

    let html = `
      <div class="gt-grid" style="--hour-w:60px;min-width:${180 + cols*60}px">
        <div class="gt-header">
          <div class="gh-tech">Técnico (${data.lanes.length}) — ${data.total_stops} stops</div>
          ${Array.from({length: cols}, (_,i) => {
            const h = hStart + i;
            const isNow = isToday && Math.floor(nowFrac) === h;
            return `<div class="gh-hour ${isNow?'now':''}">${String(h).padStart(2,'0')}h</div>`;
          }).join('')}
        </div>
        ${data.lanes.map(lane => renderLane(lane, hStart, hEnd, cols, nowCol)).join('')}
      </div>
    `;
    c.innerHTML = html;
  } catch (e) {
    c.innerHTML = `<div class="gt-empty" style="color:#f87171">${e.message}</div>`;
  }
}

function renderLane(lane, hStart, hEnd, cols, nowColPct) {
  const wsFrac = hhmmToFraction(lane.work_start) ?? 8;
  const weFrac = hhmmToFraction(lane.work_end) ?? 18;
  const lsFrac = hhmmToFraction(lane.lunch_start) ?? 12;
  const leFrac = lsFrac + (lane.lunch_duration_min || 60) / 60;

  // Faixas:
  // 1. Fora jornada antes do work_start
  // 2. Fora jornada depois do work_end
  // 3. Almoço (lsFrac → leFrac)
  // 4. Stops

  const toPercent = (frac) => Math.max(0, Math.min(100, ((frac - hStart) / cols) * 100));

  const bands = [];
  if (wsFrac > hStart) bands.push(`<div class="gl-band" style="left:0;width:${toPercent(wsFrac)}%"></div>`);
  if (weFrac < hEnd) bands.push(`<div class="gl-band" style="left:${toPercent(weFrac)}%;right:0"></div>`);
  bands.push(`<div class="gl-lunch" style="left:${toPercent(lsFrac)}%;width:${toPercent(leFrac)-toPercent(lsFrac)}%" title="Almoço ${lane.lunch_start}-${minToHHMM(leFrac)}"></div>`);

  const stops = (lane.stops || []).filter(s => s.scheduled_start).map(s => {
    const startFrac = isoToFraction(s.scheduled_start);
    const endFrac = isoToFraction(s.scheduled_end) || (startFrac + (s.duration_min||60)/60);
    const left = toPercent(startFrac);
    const width = Math.max(2, toPercent(endFrac) - left);
    const cls = [
      'gl-stop',
      s.priority === 'urgent' ? 'urgent' : (s.priority === 'high' ? 'high' : ''),
      s.is_condominio ? 'condo' : '',
      s.requires_material_pickup ? 'pickup' : '',
    ].filter(Boolean).join(' ');
    const title = `${s.customer_name}\n${s.city||''}\n⏰ ${new Date(s.scheduled_start).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})}-${new Date(s.scheduled_end||s.scheduled_start).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})} (${s.duration_min}min)\n${s.is_condominio?'🏢 condo':''} ${s.requires_material_pickup?'📦 pickup':''} ${s.priority||''}`;
    return `
      <div class="${cls}" style="left:${left}%;width:${width}%" title="${title.replace(/"/g,'&quot;')}" onclick="window.open('/operacional/routes/${s.route_id}','_blank')">
        <div><span class="seq">${s.sequence}.</span><span class="name">${s.customer_name?.substring(0,28)||'—'}</span></div>
        ${width > 4 ? `<div class="time">${new Date(s.scheduled_start).toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'})} · ${s.duration_min}min</div>` : ''}
      </div>
    `;
  }).join('');

  return `
    <div class="gt-lane">
      <div class="gt-lane-tech">
        <div class="name">${lane.technician_name}</div>
        <div class="meta">${lane.work_start}-${lane.work_end} · ${(lane.stops||[]).length} stops</div>
      </div>
      <div class="gt-lane-body">
        ${bands.join('')}
        ${stops}
        ${nowColPct != null ? `<div class="gl-now" style="left:${nowColPct}%"></div>` : ''}
      </div>
    </div>
  `;
}

function minToHHMM(frac) {
  const h = Math.floor(frac);
  const m = Math.round((frac - h)*60);
  return `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;
}

gtToday();
setInterval(gtLoad, 60000); // refresh 1min
</script>

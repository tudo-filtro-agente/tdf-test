<% const activePage = 'meu-perfil'; const pageTitle = 'Meu Perfil · Tudo de Filtro'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
.mp-wrap{max-width:780px;margin:0 auto;padding:20px}
.mp-h{font-size:24px;color:var(--text);margin:0 0 4px;font-weight:800}
.mp-sub{color:var(--text-muted);font-size:13px;margin:0 0 18px}

.mp-card{background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:22px;margin-bottom:14px}
.mp-card h2{margin:0 0 14px;color:var(--text);font-size:16px;font-weight:700}

.mp-fotos{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:600px){.mp-fotos{grid-template-columns:1fr}}
.mp-foto-zone{background:var(--bg-card);border:1px dashed var(--border);border-radius:10px;padding:14px;text-align:center;position:relative}
.mp-foto-zone.ok{border-color:#22c55e;border-style:solid}
.mp-foto-img{width:200px;height:200px;background:#222;border-radius:10px;overflow:hidden;margin:0 auto 10px;display:flex;align-items:center;justify-content:center;color:#ddd;font-size:11px}
.mp-foto-img img{width:100%;height:100%;object-fit:cover}
.mp-foto-zone h3{color:var(--text);font-size:13px;margin:0 0 4px}
.mp-foto-zone p{color:var(--text-muted);font-size:11px;margin:0 0 10px}
.mp-foto-btn{display:inline-block;background:#1f6feb;color:#fff;padding:7px 12px;border-radius:6px;cursor:pointer;font-weight:700;font-size:11px;border:none;margin:0 3px}
.mp-foto-btn.ghost{background:#222;color:#ddd;border:1px solid var(--border)}
.mp-status{font-size:10px;color:#7cb9f5;margin-top:6px;min-height:14px}

label{display:block;color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin:10px 0 4px;font-weight:700}
input,select{width:100%;background:var(--bg-card);border:1px solid var(--border);color:var(--text);border-radius:7px;padding:10px 12px;font-size:14px;font-family:inherit;outline:none}
input:focus{border-color:#5ba3f5}
.mp-grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.mp-grid3{display:grid;grid-template-columns:90px 1fr 1fr;gap:10px}
@media(max-width:600px){.mp-grid2,.mp-grid3{grid-template-columns:1fr}}

.mp-acts{display:flex;gap:10px;justify-content:flex-end;margin-top:14px}
.mp-acts button{background:#22c55e;color:#000;border:none;padding:10px 22px;border-radius:7px;cursor:pointer;font-weight:800;font-size:14px}
.mp-acts button:disabled{opacity:.5;cursor:not-allowed}
.mp-msg{padding:11px 14px;border-radius:8px;font-size:13px;margin-top:10px;display:none}
.mp-msg.ok{background:rgba(34,197,94,.1);color:#4ade80;border:1px solid #22c55e}
.mp-msg.erro{background:rgba(239,68,68,.1);color:#f87171;border:1px solid #ef4444}
</style>

<div class="mp-wrap">
  <h1 class="mp-h">👤 Meu Perfil</h1>
  <p class="mp-sub">Atualize suas informações e fotos a qualquer momento.</p>

  <!-- Fotos -->
  <div class="mp-card">
    <h2>📸 Fotos</h2>
    <div class="mp-fotos">
      <div class="mp-foto-zone" id="zone-rosto">
        <div class="mp-foto-img"><span id="empty-rosto">sem foto</span><img id="prev-rosto" style="display:none"></div>
        <h3>Foto do rosto</h3>
        <p>Aparece no painel da equipe e ranking.</p>
        <button class="mp-foto-btn" onclick="abrirCam('rosto')">📷 Webcam</button>
        <button class="mp-foto-btn ghost" onclick="document.getElementById('file-rosto').click()">📁 Arquivo</button>
        <input type="file" id="file-rosto" accept="image/*" style="display:none" onchange="uploadFile('rosto', this)">
        <div class="mp-status" id="status-rosto"></div>
      </div>
      <div class="mp-foto-zone" id="zone-momento">
        <div class="mp-foto-img"><span id="empty-momento">sem foto</span><img id="prev-momento" style="display:none"></div>
        <h3>Momento que você gosta</h3>
        <p>Família, viagem, hobby — algo que represente você.</p>
        <button class="mp-foto-btn ghost" onclick="document.getElementById('file-momento').click()">📁 Arquivo</button>
        <input type="file" id="file-momento" accept="image/*" style="display:none" onchange="uploadFile('momento', this)">
        <div class="mp-status" id="status-momento"></div>
      </div>
    </div>

    <div id="cam-rosto" style="display:none;background:var(--bg-card);padding:12px;border-radius:8px;margin-top:14px">
      <video id="vid-rosto" autoplay playsinline style="width:100%;border-radius:6px;background:#000"></video>
      <div style="margin-top:8px;display:flex;gap:6px">
        <button class="mp-foto-btn" onclick="capturar('rosto')">📸 Capturar</button>
        <button class="mp-foto-btn ghost" onclick="fecharCam('rosto')">Cancelar</button>
      </div>
    </div>
  </div>

  <!-- Dados -->
  <div class="mp-card">
    <h2>📋 Dados de contato</h2>
    <div class="mp-grid2">
      <div><label>Email</label><input type="email" id="f-email"></div>
      <div><label>Telefone</label><input type="tel" id="f-telefone"></div>
    </div>
    <label>Aniversário 🎂</label>
    <input type="date" id="f-aniversario">
    <div class="mp-grid3">
      <div><label>CEP</label><input type="text" id="f-cep" maxlength="9" oninput="buscarCep(this.value)"></div>
      <div><label>Cidade</label><input type="text" id="f-cidade"></div>
      <div><label>UF</label><input type="text" id="f-estado" maxlength="2" style="text-transform:uppercase"></div>
    </div>
    <label>Endereço</label>
    <input type="text" id="f-endereco">
    <label>Instagram</label>
    <input type="text" id="f-instagram" placeholder="@seu_instagram">

    <div id="msg" class="mp-msg"></div>

    <div class="mp-acts">
      <button onclick="salvar()" id="btn-salvar">💾 Salvar alterações</button>
    </div>
  </div>
</div>

<script>
let _stream = null;

async function safeJson(url, opts) {
  try {
    const r = await fetch(url, opts);
    const ct = r.headers.get('content-type') || '';
    if (!ct.includes('json')) {
      if (r.status === 401) return { error:'Sessão expirada. Recarregue (F5).', status:401 };
      return { error:`Servidor retornou ${r.status}.`, status:r.status };
    }
    return await r.json();
  } catch(e) { return { error: e.message }; }
}

async function resizeImage(file, maxSize = 800, quality = 0.8) {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => {
      const img = new Image();
      img.onload = () => {
        let w = img.width, h = img.height;
        if (w > h && w > maxSize) { h = h * (maxSize / w); w = maxSize; }
        else if (h > maxSize) { w = w * (maxSize / h); h = maxSize; }
        const canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL('image/jpeg', quality));
      };
      img.onerror = () => reject(new Error('imagem inválida'));
      img.src = reader.result;
    };
    reader.onerror = () => reject(reader.error);
    reader.readAsDataURL(file);
  });
}

window.addEventListener('load', carregar);

async function carregar() {
  const d = await safeJson('/perfil');
  if (d.error) { setMsg('erro', d.error); return; }
  if (d.email) document.getElementById('f-email').value = d.email;
  if (d.telefone) document.getElementById('f-telefone').value = d.telefone;
  if (d.cep) document.getElementById('f-cep').value = d.cep;
  if (d.estado) document.getElementById('f-estado').value = d.estado;
  if (d.cidade) document.getElementById('f-cidade').value = d.cidade;
  if (d.endereco) document.getElementById('f-endereco').value = d.endereco;
  if (d.aniversario) document.getElementById('f-aniversario').value = d.aniversario;
  if (d.instagram) document.getElementById('f-instagram').value = d.instagram;
  if (d.fotoRosto) showPreview('rosto', d.fotoRosto);
  if (d.fotoMomento) showPreview('momento', d.fotoMomento);
}

async function abrirCam(tipo) {
  try {
    _stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode:'user', width:720, height:720 } });
    const vid = document.getElementById('vid-'+tipo);
    vid.srcObject = _stream;
    document.getElementById('cam-'+tipo).style.display = 'block';
  } catch(e) { alert('Webcam não disponível: '+e.message); }
}
function fecharCam(tipo) {
  if (_stream) { _stream.getTracks().forEach(t => t.stop()); _stream = null; }
  document.getElementById('cam-'+tipo).style.display = 'none';
}
function capturar(tipo) {
  const vid = document.getElementById('vid-'+tipo);
  const c = document.createElement('canvas');
  c.width = vid.videoWidth; c.height = vid.videoHeight;
  c.getContext('2d').drawImage(vid, 0, 0);
  const dataUrl = c.toDataURL('image/jpeg', 0.85);
  fecharCam(tipo);
  enviarFoto(tipo, dataUrl);
}

async function uploadFile(tipo, input) {
  const f = input.files?.[0]; if (!f) return;
  if (f.size > 15 * 1024 * 1024) { alert('Foto muito grande (máx 15MB)'); return; }
  setStatus(tipo, 'reduzindo...');
  try {
    const dataUrl = await resizeImage(f, 800, 0.8);
    await enviarFoto(tipo, dataUrl);
  } catch(e) { setStatus(tipo, ''); alert('Erro: '+e.message); }
}

function setStatus(tipo, txt) { const e = document.getElementById('status-'+tipo); if (e) e.textContent = txt || ''; }

async function enviarFoto(tipo, dataUrl) {
  showPreview(tipo, dataUrl);
  setStatus(tipo, 'salvando...');
  const d = await safeJson('/perfil/foto', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ tipo, dataUrl }) });
  if (d.error) {
    setStatus(tipo, '');
    alert('❌ Não consegui salvar: ' + d.error);
    document.getElementById('prev-'+tipo).style.display = 'none';
    document.getElementById('empty-'+tipo).style.display = 'inline';
    document.getElementById('zone-'+tipo).classList.remove('ok');
    return;
  }
  setStatus(tipo, '✅ salvo (' + Math.round((d.bytes||0)/1024) + ' KB)');
  if (d.url) showPreview(tipo, d.url);
}

function showPreview(tipo, urlOrData) {
  const img = document.getElementById('prev-'+tipo);
  img.src = urlOrData;
  img.style.display = 'block';
  document.getElementById('empty-'+tipo).style.display = 'none';
  document.getElementById('zone-'+tipo).classList.add('ok');
}

async function buscarCep(cep) {
  const c = String(cep||'').replace(/\D/g, '');
  if (c.length !== 8) return;
  try {
    const r = await fetch(`https://viacep.com.br/ws/${c}/json/`);
    const d = await r.json();
    if (d.erro) return;
    if (d.uf) document.getElementById('f-estado').value = d.uf;
    if (d.localidade) document.getElementById('f-cidade').value = d.localidade;
    if (d.logradouro && !document.getElementById('f-endereco').value)
      document.getElementById('f-endereco').value = d.logradouro + (d.bairro ? ', ' + d.bairro : '');
  } catch(_){}
}

function setMsg(tipo, txt) { const m = document.getElementById('msg'); m.className='mp-msg '+tipo; m.style.display='block'; m.textContent = txt; }

async function salvar() {
  const dados = {
    email: document.getElementById('f-email').value.trim(),
    telefone: document.getElementById('f-telefone').value.trim(),
    cep: document.getElementById('f-cep').value.trim(),
    estado: document.getElementById('f-estado').value.trim().toUpperCase(),
    cidade: document.getElementById('f-cidade').value.trim(),
    endereco: document.getElementById('f-endereco').value.trim(),
    aniversario: document.getElementById('f-aniversario').value,
    instagram: document.getElementById('f-instagram').value.trim(),
  };
  const btn = document.getElementById('btn-salvar');
  btn.disabled = true; btn.textContent = '⏳ Salvando...';
  const d = await safeJson('/perfil', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(dados) });
  btn.disabled = false; btn.textContent = '💾 Salvar alterações';
  if (d.error) { setMsg('erro', d.error); return; }
  setMsg('ok', '✅ Perfil atualizado!');
  setTimeout(() => document.getElementById('msg').style.display = 'none', 3000);
}
</script>

</div></body></html>

    }).join('') + '</div>';
  } catch(e) { c.innerHTML = `<div class="tr-loading" style="color:#ef4444">Erro: ${e.message}</div>`; }
}

function trCalcScore(c){
  // Score composto simples — agente recomendou pondera 30/25/25/10/10
  const ctrNorm = Math.min(1, (c.ctr||0) / 2) * 30;
  const hookNorm = Math.min(1, (c.hook_rate||0) / 0.3) * 25;
  const cplNorm = c.leads > 0 ? Math.max(0, 1 - (c.spend_brl/c.leads) / 100) * 25 : 0;
  const holdNorm = Math.min(1, (c.hold_rate||0)) * 10;
  const freqNorm = Math.max(0, 1 - (c.frequency||0)/5) * 10;
  return Math.round(ctrNorm + hookNorm + cplNorm + holdNorm + freqNorm);
}


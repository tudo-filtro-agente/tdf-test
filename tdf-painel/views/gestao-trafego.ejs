async function trCarregarCriativos(){
  const c = document.getElementById('tr-content');
  c.innerHTML = '<div class="tr-loading">⏳ Carregando criativos Meta...</div>';
  try {
    const r = await fetch('/trafego/meta/creatives?' + _trBuildQS());
    const d = await r.json();
    if (d.error) throw new Error(d.error);
    const cr = d.creatives || [];
    c.innerHTML = '<div class="tr-gallery">' + cr.map(x => {
      const score = trCalcScore(x);
      const cls = score >= 80 ? 'champ' : (x.frequency >= 3.5 ? 'fadiga' : (score < 30 && x.impressions >= 5000 ? 'fraco' : ''));
      return `
        <div class="tr-creative ${cls}" style="position:relative">
          <div class="badge">${cls==='champ'?'🏆':cls==='fadiga'?'⚠️':cls==='fraco'?'❌':'·'} ${score}</div>
          <div class="thumb">${x.thumbnail_url ? `<img src="${x.thumbnail_url}" alt="${x.name}">` : '🎨 Sem preview'}</div>
          <div class="body">
            <div class="nome">${(x.name||'?').replace(/</g,'&lt;')}</div>
            <div class="kpis">
              <div class="kpi"><strong>${trPct(x.ctr)}</strong>CTR</div>
              <div class="kpi"><strong>${(x.frequency||0).toFixed(1)}</strong>Freq</div>
              <div class="kpi"><strong>${x.leads||0}</strong>Leads</div>
              <div class="kpi"><strong>${trMoney(x.spend_brl)}</strong>Spend</div>
            </div>
          </div>

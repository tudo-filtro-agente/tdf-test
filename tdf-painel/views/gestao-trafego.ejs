async function trPauseGoogle(id, name){
  if (!confirm(`⏸️ Pausar campanha Google "${name}"?\n\nO sistema vai cruzar com o pipeline ativo no Zoho antes (Approval Gate).`)) return;
  try {
    const r = await fetch(`/trafego/google/campaign/${id}/pause`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ campaignName: name }),
    });
    const d = await r.json();
    if (d.error === 'approval_gate_blocked') {
      const motivo = d.gate?.motivo || 'pipeline ativo bloqueando';
      const force = confirm(`🚨 Approval Gate BLOQUEOU:\n\n${motivo}\n\nForçar mesmo assim? (será logado como FORCED no audit)`);
      if (!force) return;
      const r2 = await fetch(`/trafego/google/campaign/${id}/pause`, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ campaignName: name, force: true }),
      });
      const d2 = await r2.json();
      if (d2.error) { alert('❌ '+d2.error); return; }
      alert('✅ Pausada (FORCED)');
    } else if (d.error) { alert('❌ '+d.error); return; }
    else alert('✅ Campanha pausada');
    trCarregar();
  } catch(e) { alert('Erro: '+e.message); }
}

async function trPauseMeta(id, name){
  if (!confirm(`⏸️ Pausar campanha Meta "${name}"?\n\nO sistema vai cruzar com pipeline antes.`)) return;
  try {
    const r = await fetch(`/trafego/meta/campaign/${id}/pause`, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ campaignName: name }),
    });
    const d = await r.json();
    if (d.error === 'approval_gate_blocked') {
      const force = confirm(`🚨 Approval Gate BLOQUEOU:\n\n${d.gate?.motivo}\n\nForçar?`);
      if (!force) return;
      await fetch(`/trafego/meta/campaign/${id}/pause`, {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ campaignName: name, force: true }),
      });
      alert('✅ Pausada (FORCED)');
    } else if (d.error) { alert('❌ '+d.error); return; }
    else alert('✅ Campanha pausada');
    trCarregar();
  } catch(e) { alert('Erro: '+e.message); }
}


async function trReconciliarDry(){
  const r = await fetch('/trafego/reconciliar?dry_run=true', { method:'POST' });
  const d = await r.json();
  if (d.error) { alert('❌ '+d.error); return; }
  alert(`🔍 Dry-run:\n\n${d.processados} deals avaliados\n${d.atualizados} seriam enriquecidos\n${d.pulados} pulados (já têm source / muito recente / manual)\n\nClique em "Executar" pra aplicar de verdade.`);
}
async function trReconciliarReal(){
  if (!confirm('⚡ Executar reconciliação? Vai atualizar Lead_Source no Zoho dos deals que tiverem cache de atribuição.')) return;
  const r = await fetch('/trafego/reconciliar', { method:'POST' });
  const d = await r.json();
  if (d.error) { alert('❌ '+d.error); return; }
  alert(`✅ Reconciliação concluída:\n\n${d.atualizados}/${d.processados} deals atualizados\n${d.pulados} pulados`);
}


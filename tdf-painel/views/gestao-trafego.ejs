<% const activePage = 'trafego'; const pageTitle = 'Dashboard de Tráfego Pago'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
.tr-wrap{padding:14px 22px 100px;max-width:1500px;margin:0 auto}
.tr-h{font-size:20px;color:var(--text);margin:0 0 4px;font-weight:800;display:flex;align-items:center;gap:12px}
.tr-h .live{display:inline-flex;align-items:center;gap:5px;background:rgba(34,197,94,.12);color:#22c55e;font-size:10px;font-weight:700;padding:2px 8px;border-radius:8px;border:1px solid rgba(34,197,94,.3);text-transform:uppercase;letter-spacing:.4px}
.tr-h .live span.dot{width:6px;height:6px;border-radius:50%;background:#22c55e;animation:trPulse 1.4s infinite}
@keyframes trPulse{0%,100%{opacity:1}50%{opacity:.4}}
.tr-sub{color:var(--text-muted);font-size:12px;margin:0 0 14px}

.tr-bar{display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:10px 14px}
.tr-bar label{color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;font-weight:700}
.tr-bar select,.tr-bar input{background:var(--bg-card);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:7px 10px;font-size:12px}

/* Health banner */
.tr-health{display:flex;gap:10px;margin-bottom:14px;padding:10px 14px;background:#0d1f3a;border:1px solid #1f6feb;border-radius:8px;flex-wrap:wrap}
.tr-health.warn{background:#2a1a05;border-color:#f59e0b}
.tr-health.danger{background:#1a0a0a;border-color:#ef4444}
.tr-health span{color:#7cb9f5;font-size:11px;font-weight:600}
.tr-health.warn span{color:#fbbf24}
.tr-health.danger span{color:#fca5a5}

/* Cards topo */
.tr-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-bottom:14px}
.tr-card{background:linear-gradient(135deg,var(--bg-card),var(--bg-card));border:1px solid var(--border);border-radius:10px;padding:12px 14px;position:relative}
.tr-card .lbl{color:var(--text-muted);font-size:9px;text-transform:uppercase;letter-spacing:.4px;font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:5px}
.tr-card .val{font-size:22px;font-weight:800;color:var(--text);font-variant-numeric:tabular-nums}
.tr-card .sub{color:var(--text-muted);font-size:10px;margin-top:3px}
.tr-card.invest .val{color:#7cb9f5}
.tr-card.leads .val{color:#a371f7}
.tr-card.cac .val{color:#f59e0b}
.tr-card.roas .val{color:#22c55e}
.tr-card.receita .val{color:#22c55e}
.tr-card.cpl .val{color:#fbbf24}
.tr-card.vendas .val{color:#22c55e}

/* Gestor IA Live */
.tr-gestor{background:linear-gradient(135deg,#1a0f2e,#2d1525);border:2px solid #a371f7;border-radius:12px;padding:14px;margin-bottom:18px;box-shadow:0 4px 16px rgba(167,113,247,.2)}
.tr-gestor h3{margin:0 0 8px;color:var(--text);font-size:14px;display:flex;align-items:center;gap:10px}
.tr-gestor .acao{background:#0d0820;border:1px solid #4c1d95;border-radius:8px;padding:10px;margin-bottom:8px}
.tr-gestor .acao:last-child{margin-bottom:0}
.tr-gestor .acao .tit{color:var(--text);font-weight:700;font-size:13px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.tr-gestor .acao .why{color:var(--text-muted);font-size:11px;margin-top:5px;line-height:1.4}
.tr-gestor .acao .stats{display:flex;gap:10px;margin-top:8px;font-size:10px}
.tr-gestor .acao .stat{color:var(--text-muted)}
.tr-gestor .acao .stat strong{color:#22c55e}
.tr-gestor .acao .actions{display:flex;gap:6px;margin-top:8px}
.tr-gestor .acao button{padding:5px 12px;font-size:11px;font-weight:700;border-radius:5px;cursor:pointer;border:none}
.tr-gestor .acao button.exec{background:#22c55e;color:#000}
.tr-gestor .acao button.skip{background:#222;color:#ddd;border:1px solid var(--border)}
.tr-gestor .acao button.exec:hover{background:#16a34a}

.tr-conf{display:inline-block;background:#1f2937;color:#9ca3af;padding:1px 6px;border-radius:6px;font-size:9px;font-weight:700}
.tr-conf.high{background:rgba(34,197,94,.15);color:#22c55e}
.tr-conf.medium{background:rgba(245,158,11,.15);color:#f59e0b}
.tr-conf.low{background:rgba(239,68,68,.15);color:#fca5a5}

.tr-tabs{display:flex;gap:4px;border-bottom:1px solid var(--border);margin-bottom:10px;flex-wrap:wrap}
.tr-tab{background:transparent;border:none;color:var(--text-muted);padding:8px 14px;font-size:12px;font-weight:700;cursor:pointer;border-bottom:2px solid transparent}
.tr-tab.active{color:#7cb9f5;border-bottom-color:#1f6feb}
.tr-tab:hover{color:var(--text)}

/* Tabela campanhas */
.tr-tbl{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;overflow-x:auto}
.tr-tbl table{width:100%;border-collapse:collapse;font-size:11px}
.tr-tbl th{padding:8px 10px;background:var(--bg-card);color:var(--text-muted);font-size:9px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;text-align:left;border-bottom:2px solid var(--border);white-space:nowrap}
.tr-tbl td{padding:8px 10px;border-bottom:1px solid #1a1a1a;color:var(--text-muted)}
.tr-tbl tr:hover td{background:var(--bg-card)}
.tr-tbl .num{text-align:right;font-variant-numeric:tabular-nums}
.tr-tbl .nome{color:var(--text);font-weight:700}
.tr-tbl .acts button{background:transparent;border:1px solid var(--border);color:var(--text-muted);border-radius:4px;padding:3px 8px;font-size:10px;cursor:pointer;margin-right:3px}
.tr-tbl .acts button:hover{border-color:#1f6feb;color:var(--text)}
.tr-tbl .acts .danger:hover{border-color:#ef4444;color:#ef4444}

.tr-loading{padding:40px;text-align:center;color:var(--text-muted);font-size:12px}

/* Galeria criativos */
.tr-gallery{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:12px}
.tr-creative{background:var(--bg-card);border:1px solid var(--border);border-radius:10px;overflow:hidden}
.tr-creative.champ{border-color:#22c55e}
.tr-creative.fadiga{border-color:#f59e0b}
.tr-creative.fraco{border-color:#ef4444;opacity:.85}
.tr-creative .thumb{width:100%;height:160px;background:#000;display:flex;align-items:center;justify-content:center;color:#444;font-size:11px}
.tr-creative .thumb img{width:100%;height:100%;object-fit:cover}
.tr-creative .body{padding:10px}
.tr-creative .nome{color:var(--text);font-weight:700;font-size:12px;line-height:1.3;margin-bottom:6px;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.tr-creative .kpis{display:grid;grid-template-columns:1fr 1fr;gap:5px;font-size:10px}
.tr-creative .kpi{color:var(--text-muted)}
.tr-creative .kpi strong{color:var(--text);display:block;font-size:13px}
.tr-creative .badge{position:absolute;top:6px;left:6px;background:rgba(0,0,0,.8);color:var(--text);font-size:9px;font-weight:800;padding:2px 6px;border-radius:4px;text-transform:uppercase}
</style>

<div class="tr-wrap">
  <h1 class="tr-h">📊 Dashboard de Tráfego Pago <span class="live"><span class="dot"></span>AO VIVO</span></h1>
  <p class="tr-sub">Google Ads + Meta Ads cruzados com vendas Zoho. CAC real, ROAS por canal, ações executáveis com Approval Gate.</p>

  <div class="tr-bar" style="flex-wrap:wrap">
    <label>Período</label>
    <button class="tr-preset" data-p="hoje" onclick="trPreset('hoje')">Hoje</button>
    <button class="tr-preset" data-p="ontem" onclick="trPreset('ontem')">Ontem</button>
    <button class="tr-preset active" data-p="7" onclick="trPreset('7')">7 dias</button>
    <button class="tr-preset" data-p="30" onclick="trPreset('30')">30 dias</button>
    <button class="tr-preset" data-p="90" onclick="trPreset('90')">90 dias</button>
    <button class="tr-preset" data-p="custom" onclick="trPreset('custom')">📅 Personalizado</button>
    <span id="tr-custom-range" style="display:none;align-items:center;gap:6px">
      <input id="tr-start" type="date">
      <span style="color:var(--text-muted)">→</span>
      <input id="tr-end" type="date">
      <button onclick="trCarregar()" style="background:#22c55e;color:#000;border:none;padding:6px 12px;border-radius:5px;font-size:11px;font-weight:800;cursor:pointer">Aplicar</button>
    </span>
    <span id="tr-period-label" style="color:#7cb9f5;font-size:11px;font-weight:700;margin-left:auto"></span>
    <button onclick="trCarregar()" style="background:#1f6feb;border:none;color:#fff;padding:7px 12px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer">↻</button>
  </div>
  <div style="display:flex;gap:8px;margin-bottom:14px;flex-wrap:wrap;align-items:center;background:linear-gradient(135deg,#1a0f2e,#2d1525);border:1px solid #a371f7;border-radius:10px;padding:10px 14px">
    <span style="color:#c4a4ff;font-weight:800;font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-right:4px">🤖 Invocar Especialistas</span>
    <button onclick="trChamarPersona('estrategista')" class="tr-persona-btn" style="background:#22c55e;color:#000">🚀 Estrategista (Opus 4)</button>
    <button onclick="trChamarPersona('auditor')" class="tr-persona-btn" style="background:#f59e0b;color:#000">🎯 Auditor (Opus 4)</button>
    <button onclick="trChamarPersona('critico_criativos')" class="tr-persona-btn" style="background:#a371f7;color:#fff">🎨 Crítico Criativos (Sonnet 4)</button>
    <button onclick="trChamarAgenteAutonomo()" class="tr-persona-btn" id="tr-agent-btn" style="background:linear-gradient(135deg,#7c3aed,#a371f7);color:#fff;border:1px solid #c4a4ff">🤖 Agente Autônomo (Tool Use)</button>
    <span id="tr-persona-status" style="color:var(--text-muted);font-size:11px;margin-left:auto"></span>
  </div>
  <style>
  .tr-persona-btn{border:none;padding:7px 14px;border-radius:6px;font-size:11px;font-weight:800;cursor:pointer;font-family:inherit;transition:transform .15s}
  .tr-persona-btn:hover{transform:translateY(-1px)}
  .tr-persona-btn:disabled{opacity:.5;cursor:not-allowed;transform:none}
  </style>
  <style>
  .tr-preset{background:var(--bg-card);color:var(--text-muted);border:1px solid var(--border);border-radius:6px;padding:6px 12px;font-size:11px;font-weight:700;cursor:pointer;transition:all .15s;font-family:inherit}
  .tr-preset:hover{background:var(--bg-hover);color:var(--text);border-color:#1f6feb}
  .tr-preset.active{background:#1f6feb;color:#fff;border-color:#1f6feb}
  </style>

  <div id="tr-health" style="display:none"></div>
  <div id="tr-cron-last" style="display:none"></div>
  <div id="tr-gestor-out"></div>
  <div id="tr-cards"></div>
  <div class="tr-tabs">
    <button class="tr-tab active" onclick="trAba('campanhas')" id="tr-tab-camp">📊 Campanhas</button>
    <button class="tr-tab" onclick="trAba('canal')" id="tr-tab-canal">📡 Por Canal (FB/IG/Google)</button>
    <button class="tr-tab" onclick="trAba('funil')" id="tr-tab-funil">🔻 Funil Completo</button>
    <button class="tr-tab" onclick="trAba('vendas')" id="tr-tab-vd">💰 Vendas × Campanha</button>
    <button class="tr-tab" onclick="trAba('keywords')" id="tr-tab-kw">🔑 Keywords (Google)</button>
    <button class="tr-tab" onclick="trAba('criativos')" id="tr-tab-cr">🎨 Criativos (Meta)</button>
    <button class="tr-tab" onclick="trAba('health')" id="tr-tab-h">🩺 Health Check</button>
    <button class="tr-tab" onclick="trAba('audit')" id="tr-tab-aud">📜 Audit Log</button>
  </div>
  <div id="tr-content"><div class="tr-loading">⏳ Carregando snapshot...</div></div>
</div>

<script>
let _TR_DATA = null;

function trMoney(v, big){
  if (v == null) return '—';
  v = Number(v);
  if (big && v >= 1000000) return 'R$ '+(v/1000000).toFixed(1).replace('.',',')+'M';
  if (big && v >= 1000) return 'R$ '+(v/1000).toFixed(1).replace('.',',')+'k';
  return 'R$ '+Math.round(v).toLocaleString('pt-BR');
}
function trPct(v){ return v != null ? v.toFixed(1).replace('.',',')+'%' : '—'; }

// === SELETOR DE PERÍODO ===
let _TR_PERIODO = { tipo: 'days', value: 7 };

function _hojeBR(){
  const d = new Date(); const tz = d.toLocaleDateString('en-CA', {timeZone:'America/Sao_Paulo'});
  return tz; // YYYY-MM-DD
}
function _ontemBR(){
  const d = new Date(Date.now() - 86400000);
  return d.toLocaleDateString('en-CA', {timeZone:'America/Sao_Paulo'});
}

function trPreset(p){
  document.querySelectorAll('.tr-preset').forEach(b => b.classList.remove('active'));
  document.querySelector('.tr-preset[data-p="'+p+'"]')?.classList.add('active');
  const customSpan = document.getElementById('tr-custom-range');
  if (p === 'custom') {
    customSpan.style.display = 'inline-flex';
    // Default: últimos 14 dias
    const end = _hojeBR();
    const startDate = new Date(Date.now() - 14*86400000);
    const start = startDate.toLocaleDateString('en-CA', {timeZone:'America/Sao_Paulo'});
    document.getElementById('tr-start').value = start;
    document.getElementById('tr-end').value = end;
    return; // espera user clicar Aplicar
  }
  customSpan.style.display = 'none';
  if (p === 'hoje') _TR_PERIODO = { tipo: 'range', start: _hojeBR(), end: _hojeBR() };
  else if (p === 'ontem') _TR_PERIODO = { tipo: 'range', start: _ontemBR(), end: _ontemBR() };
  else _TR_PERIODO = { tipo: 'days', value: parseInt(p, 10) };
  trCarregar();
}

function _trBuildQS(){
  // Custom range tem prioridade se aba "Personalizado" tá visível com inputs preenchidos
  const customVisible = document.getElementById('tr-custom-range').style.display !== 'none';
  if (customVisible) {
    const s = document.getElementById('tr-start').value;
    const e = document.getElementById('tr-end').value;
    if (s && e) return `start=${s}&end=${e}`;
  }
  if (_TR_PERIODO.tipo === 'range') return `start=${_TR_PERIODO.start}&end=${_TR_PERIODO.end}`;
  return `days=${_TR_PERIODO.value || 7}`;
}

function _trLabelPeriodo(){
  const customVisible = document.getElementById('tr-custom-range').style.display !== 'none';
  if (customVisible) {
    const s = document.getElementById('tr-start').value;
    const e = document.getElementById('tr-end').value;
    if (s && e) return s === e ? s.split('-').reverse().join('/') : s.split('-').reverse().join('/') + ' → ' + e.split('-').reverse().join('/');
  }
  if (_TR_PERIODO.tipo === 'range') {
    const s = _TR_PERIODO.start, e = _TR_PERIODO.end;
    return s === e ? s.split('-').reverse().join('/') : s.split('-').reverse().join('/') + ' → ' + e.split('-').reverse().join('/');
  }
  return 'Últimos ' + _TR_PERIODO.value + ' dias';
}

async function trCarregarCronLast(){
  try {
    const r = await fetch('/trafego/gestor-ia/last');
    const d = await r.json();
    const wrap = document.getElementById('tr-cron-last');
    if (!d || !d.generated_at) { wrap.style.display = 'none'; return; }
    const min = Math.round((Date.now() - d.generated_at) / 60000);
    const h = Math.floor(min / 60);
    const ageStr = h > 0 ? h + 'h' + (min % 60) + 'min' : min + 'min';
    let html = '<div style="background:#0d0820;border:1px solid #4c1d95;border-radius:10px;padding:10px 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">';
    html += '<span style="background:#a371f7;color:#000;font-weight:800;font-size:9px;padding:2px 7px;border-radius:6px;text-transform:uppercase">⏰ Cron ' + (d.hour||'?') + 'h</span>';
    html += '<span style="color:#c4a4ff;font-size:11px">Última análise IA: há ' + ageStr + '</span>';
    if (d.parsed?.actions) html += '<span style="color:#fff;font-size:11px;font-weight:700">' + d.parsed.actions.length + ' ações sugeridas</span>';
    html += '<button onclick="trVerCronUltimo()" style="margin-left:auto;background:#7c3aed;color:#fff;border:none;padding:5px 10px;border-radius:5px;font-size:10px;font-weight:700;cursor:pointer">Ver detalhes</button>';
    html += '</div>';
    wrap.innerHTML = html;
    wrap.style.display = 'block';
    window._TR_CRON_LAST = d;
  } catch(_){}
}
function trVerCronUltimo(){
  const d = window._TR_CRON_LAST;
  if (!d?.parsed) return;
  const out = document.getElementById('tr-gestor-out');
  let html = '<div class="tr-gestor"><h3>⏰ Última análise automática (cron ' + (d.hour||'?') + 'h)</h3>';
  if (d.parsed.summary) html += '<div style="color:#c4a4ff;font-size:12px;margin-bottom:10px;font-style:italic">' + d.parsed.summary.replace(/</g,'&lt;') + '</div>';
  if (Array.isArray(d.parsed.actions)) html += d.parsed.actions.map(a => trRenderAcao(a, 0)).join('');
  html += '</div>';
  out.innerHTML = html;
}
trCarregarCronLast();

async function trCarregar(){
  const qs = _trBuildQS();
  document.getElementById('tr-period-label').textContent = '📅 ' + _trLabelPeriodo();
  document.getElementById('tr-cards').innerHTML = '<div class="tr-loading">⏳ Carregando snapshot...</div>';
  try {
    const r = await fetch('/trafego/snapshot?' + qs);
    const d = await r.json();
    if (d.error) throw new Error(d.error);
    _TR_DATA = d;
    trRenderHealth(d.health);
    trRenderCards(d.cards);
    trAba('campanhas');
  } catch(e) {
    document.getElementById('tr-cards').innerHTML = `<div class="tr-loading" style="color:#ef4444">Erro: ${e.message}</div>`;
  }
}

function trRenderHealth(h){
  const el = document.getElementById('tr-health');
  const issues = [];
  if (!h.google_creds) issues.push('⚠️ Google Ads sem credenciais (configure GOOGLE_ADS_* no Railway)');
  if (!h.meta_creds) issues.push('⚠️ Meta Ads sem credenciais (configure META_ACCESS_TOKEN + META_AD_ACCOUNT_ID)');
  if (!issues.length) {
    el.style.display = 'flex';
    el.className = 'tr-health';
    el.innerHTML = '<span>✅ Tracking OK · Google + Meta conectados</span>';
  } else {
    el.style.display = 'flex';
    el.className = 'tr-health danger';
    el.innerHTML = issues.map(i => '<span>'+i+'</span>').join('');
  }
}

function trRenderCards(c){
  const el = document.getElementById('tr-cards');
  el.className = 'tr-cards';
  el.innerHTML = `
    <div class="tr-card invest">
      <div class="lbl">💰 Investimento (Google + Meta)</div>
      <div class="val">${trMoney(c.invest_total, true)}</div>
      <div class="sub">G ${trMoney(c.invest_google,true)} · M ${trMoney(c.invest_meta,true)}</div>
    </div>
    <div class="tr-card leads">
      <div class="lbl">🎯 Leads gerados</div>
      <div class="val">${c.leads || 0}</div>
      <div class="sub">G ${c.leads_google} · M ${c.leads_meta}</div>
    </div>
    <div class="tr-card cpl">
      <div class="lbl">💸 CPL (Custo por Lead)</div>
      <div class="val">${c.cpl != null ? trMoney(c.cpl) : '—'}</div>
      <div class="sub">por lead bruto</div>
    </div>
    <div class="tr-card vendas">
      <div class="lbl">🏆 Vendas no período</div>
      <div class="val">${c.vendas || 0}</div>
      <div class="sub">${trMoney(c.receita,true)} receita</div>
    </div>
    <div class="tr-card cac">
      <div class="lbl">📉 CAC real</div>
      <div class="val">${c.cac != null ? trMoney(c.cac) : '—'}</div>
      <div class="sub">invest / venda Zoho</div>
    </div>
    <div class="tr-card roas">
      <div class="lbl">📈 ROAS</div>
      <div class="val">${c.roas != null ? c.roas.toFixed(1).replace('.',',')+'x' : '—'}</div>
      <div class="sub">receita / invest</div>
    </div>
    <div class="tr-card receita">
      <div class="lbl">🎫 Ticket Médio</div>
      <div class="val">${c.ticket_medio != null ? trMoney(c.ticket_medio) : '—'}</div>
      <div class="sub">receita / venda</div>
    </div>
    <div class="tr-card">
      <div class="lbl">🔁 Taxa Lead → Venda</div>
      <div class="val">${trPct(c.taxa_lead_venda_pct)}</div>
      <div class="sub">conversão funnel total</div>
    </div>
  `;
}

function trAba(aba){
  ['camp','kw','cr','h','aud','canal','funil','vd'].forEach(k => {
    const t = document.getElementById('tr-tab-'+k);
    if (t) t.classList.remove('active');
  });
  const map = { campanhas: 'camp', keywords: 'kw', criativos: 'cr', health: 'h', audit: 'aud', canal: 'canal', funil: 'funil', vendas: 'vd' };
  document.getElementById('tr-tab-' + map[aba]).classList.add('active');
  if (aba === 'campanhas') trRenderCampanhas();
  else if (aba === 'keywords') trCarregarKeywords();
  else if (aba === 'criativos') trCarregarCriativos();
  else if (aba === 'health') trCarregarHealth();
  else if (aba === 'audit') trCarregarAudit();
  else if (aba === 'canal') trCarregarCanal();
  else if (aba === 'funil') trCarregarFunil();
  else if (aba === 'vendas') trCarregarVendas();
}

async function trCarregarVendas(){
  const c = document.getElementById('tr-content');
  c.innerHTML = '<div class="tr-loading">⏳ Cruzando spend × Fechado Ganho do Zoho...</div>';
  try {
    const r = await fetch('/trafego/vendas-por-campanha?' + _trBuildQS());

// === PERSONAS LIVE ===
async function trChamarPersona(personaKey){
  const out = document.getElementById('tr-gestor-out');
  const status = document.getElementById('tr-persona-status');
  const personaLabel = { estrategista: '🚀 Estrategista', auditor: '🎯 Auditor', critico_criativos: '🎨 Crítico Criativos' }[personaKey] || personaKey;
  document.querySelectorAll('.tr-persona-btn').forEach(b => b.disabled = true);
  status.textContent = '⏳ ' + personaLabel + ' analisando snapshot (Opus pode levar 30-60s)...';
  out.innerHTML = '<div class="tr-gestor"><h3>' + personaLabel + ' · analisando...</h3><div class="tr-loading">Cruzando Google + Meta + Zoho. Modelo grande, dá um tempo.</div></div>';
  try {
    const r = await fetch('/trafego/gestor-ia?persona=' + personaKey, { method:'POST' });
    const d = await r.json();
    if (d.error) {
      out.innerHTML = '<div class="tr-gestor" style="border-color:#ef4444"><h3>' + personaLabel + '</h3><div style="color:#ef4444">Erro: ' + d.error + '</div></div>';
      return;
    }
    if (!d.parsed) {
      out.innerHTML = '<div class="tr-gestor"><h3>' + personaLabel + '</h3><pre style="color:#aaa;font-size:11px;white-space:pre-wrap;max-height:400px;overflow:auto">' + (d.raw||'').replace(/</g,'&lt;') + '</pre></div>';
      return;
    }
    const corHeader = d.persona?.cor || '#a371f7';
    let html = '<div class="tr-gestor" style="border-color:' + corHeader + '"><h3 style="color:#fff">' + (d.persona?.icon||'🤖') + ' ' + (d.persona?.nome||personaLabel) + ' <span style="font-size:10px;color:#888;font-weight:400;margin-left:auto">' + (d.persona?.modelo||'') + '</span></h3>';
    if (d.parsed.summary) html += '<div style="color:#c4a4ff;font-size:12px;margin-bottom:10px;font-style:italic">' + d.parsed.summary.replace(/</g,'&lt;') + '</div>';

    if (personaKey === 'estrategista' && Array.isArray(d.parsed.actions)) {
      html += '<div style="color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px">' + d.parsed.actions.length + ' ações priorizadas</div>';
      html += d.parsed.actions.map((a,i) => trRenderAcao(a, i)).join('');
    } else if (personaKey === 'auditor' && Array.isArray(d.parsed.alertas_criticos)) {
      const sev = d.parsed.saude_geral_pct;
      html += '<div style="display:flex;align-items:center;gap:14px;margin-bottom:14px"><div style="font-size:36px;font-weight:800;color:' + (sev>=80?'#22c55e':sev>=50?'#f59e0b':'#ef4444') + '">' + sev + '%</div><div style="color:#888;font-size:11px">Saúde Geral</div></div>';
      html += d.parsed.alertas_criticos.map(a => trRenderAlerta(a)).join('');
    } else if (personaKey === 'critico_criativos') {
      const c = d.parsed;
      html += '<div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:10px">';
      html += '<div style="background:#0d1f0d;border:1px solid #22c55e;border-radius:6px;padding:8px"><div style="color:#22c55e;font-size:10px;font-weight:800;text-transform:uppercase">🏆 Campeões</div><div style="color:#fff;font-size:18px;font-weight:800">' + (c.campeoes||[]).length + '</div></div>';
      html += '<div style="background:#2a1a05;border:1px solid #f59e0b;border-radius:6px;padding:8px"><div style="color:#f59e0b;font-size:10px;font-weight:800;text-transform:uppercase">⚠️ Fadiga</div><div style="color:#fff;font-size:18px;font-weight:800">' + (c.fadiga||[]).length + '</div></div>';
      html += '<div style="background:#1a0a0a;border:1px solid #ef4444;border-radius:6px;padding:8px"><div style="color:#ef4444;font-size:10px;font-weight:800;text-transform:uppercase">❌ Fracos</div><div style="color:#fff;font-size:18px;font-weight:800">' + (c.fracos||[]).length + '</div></div>';
      html += '</div>';
      ['campeoes','fadiga','fracos'].forEach(k => {
        (c[k]||[]).forEach(item => {
          const cor = k==='campeoes'?'#22c55e':k==='fadiga'?'#f59e0b':'#ef4444';
          const ico = k==='campeoes'?'🏆':k==='fadiga'?'⚠️':'❌';
          html += '<div style="background:#0d0820;border-left:3px solid '+cor+';padding:8px 12px;margin-bottom:4px;border-radius:0 6px 6px 0"><div style="color:#fff;font-weight:700;font-size:12px">'+ico+' '+(item.name||item.id).replace(/</g,'&lt;')+'</div><div style="color:#aaa;font-size:11px;margin-top:3px">'+(item.porque||'').replace(/</g,'&lt;')+'</div></div>';
        });
      });
    } else {
      html += '<pre style="color:#aaa;font-size:11px;white-space:pre-wrap;max-height:400px;overflow:auto">' + JSON.stringify(d.parsed, null, 2) + '</pre>';
    }

    html += '</div>';
    out.innerHTML = html;
  } catch(e) {
    out.innerHTML = '<div class="tr-gestor"><h3>' + personaLabel + '</h3><div style="color:#ef4444">Erro: ' + e.message + '</div></div>';
  } finally {
    document.querySelectorAll('.tr-persona-btn').forEach(b => b.disabled = false);
    status.textContent = '';
  }
}

function trRenderAlerta(a){
  const corMap = { CRITICA:'#ef4444', ALTA:'#f97316', MEDIA:'#f59e0b', BAIXA:'#7cb9f5', INFO:'#888' };
  const cor = corMap[a.severidade] || '#888';
  return '<div style="background:#0d0820;border-left:3px solid '+cor+';padding:10px 12px;margin-bottom:6px;border-radius:0 6px 6px 0">' +
    '<div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">' +
      '<span style="background:'+cor+';color:#000;font-size:9px;font-weight:800;padding:2px 6px;border-radius:4px">'+a.severidade+'</span>' +
      '<span style="color:#fff;font-weight:700;font-size:13px">'+(a.titulo||'').replace(/</g,'&lt;')+'</span>' +
    '</div>' +
    '<div style="color:#aaa;font-size:11px">'+(a.explicacao||'').replace(/</g,'&lt;')+'</div>' +
    (a.acao_sugerida ? '<div style="color:#7cb9f5;font-size:11px;margin-top:6px">→ '+a.acao_sugerida.replace(/</g,'&lt;')+'</div>' : '') +
    '</div>';
}

function trRenderAcao(a, idx){
  const confCls = a.confidence >= 0.75 ? 'high' : a.confidence >= 0.5 ? 'medium' : 'low';
  const tipoIco = { pause_campaign: '⏸️', reduce_budget: '📉', increase_budget: '📈', pause_keyword: '🔇', add_negative_keyword: '🚫', pause_ad: '🎨' }[a.tipo] || '⚙️';
  return `
    <div class="acao">
      <div class="tit">
        ${tipoIco} <span>${a.tipo.replace(/_/g,' ')}</span>
        <span style="color:#888;font-size:11px">·</span>
        <span style="color:#fff">${(a.target_name||a.target_id||'?').slice(0,50)}</span>
        <span class="tr-conf ${confCls}">${(a.confidence*100).toFixed(0)}% conf</span>
        ${a.requires_human ? '<span class="tr-conf low">⚠️ requer humano</span>' : ''}
      </div>
      <div class="why">${(a.reasoning||'').replace(/</g,'&lt;')}</div>
      <div class="stats">
        <div class="stat">Plataforma: <strong style="color:#7cb9f5">${a.plataforma}</strong></div>
        ${a.expected_impact_brl_monthly ? `<div class="stat">Impacto: <strong>${trMoney(a.expected_impact_brl_monthly,true)}/mês</strong></div>` : ''}
      </div>
      <div class="actions">
        ${a.execute_endpoint ? `<button class="exec" onclick='trExecutarAcao(${JSON.stringify(a).replace(/'/g,"&#39;")})'>✅ Aplicar</button>` : ''}
        <button class="skip" onclick="this.parentElement.parentElement.style.opacity='.4';this.parentElement.parentElement.querySelector('.exec')?.remove()">⏭️ Pular</button>
      </div>
    </div>
  `;
}

async function trExecutarAcao(a){
  if (!confirm('Aplicar ação:\n\n' + a.tipo + '\n' + a.target_name + '\n\n' + (a.reasoning||''))) return;
  try {
    const [method, ...pathParts] = (a.execute_endpoint || '').split(' ');
    const path = pathParts.join(' ');
    const r = await fetch(path, {
      method: method || 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify(a.execute_body || {}),
    });
    const d = await r.json();
    if (d.error) { alert('❌ '+d.error); return; }
    alert('✅ Aplicado');
    trCarregar();
  } catch(e) { alert('Erro: '+e.message); }
}

trCarregar();
</script>

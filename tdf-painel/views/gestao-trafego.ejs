async function trCarregarFunil(){
  const c = document.getElementById('tr-content');
  c.innerHTML = '<div class="tr-loading">⏳ Calculando funil completo...</div>';
  try {
    const r = await fetch('/trafego/funnel?' + _trBuildQS());
    const d = await r.json();
    if (d.error) throw new Error(d.error);
    let html = '<div style="background:#0d0d0d;border:1px solid #222;border-radius:10px;padding:18px">';
    html += '<h3 style="margin:0 0 6px;color:#fff;font-size:14px">🔻 Funil completo · ' + d.periodo.start + ' → ' + d.periodo.end + '</h3>';
    html += '<div style="color:#22c55e;font-size:13px;font-weight:700;margin-bottom:14px">💰 Receita ganha no período: ' + trMoney(d.receita_ganha, true) + '</div>';
    // Funil visual
    const max = Math.max(...d.etapas.map(e => e.valor || 0), 1);
    html += d.etapas.map((e,i) => {
      const pct = (e.valor / max) * 100;
      const dropStr = e.ratio !== null ? ((e.ratio*100).toFixed(1).replace('.',',') + '%') : '—';
      const corBar = i === 0 ? '#7cb9f5' : i === 1 ? '#22c55e' : i === 2 ? '#a371f7' : i === 3 ? '#f59e0b' : i === 4 ? '#fbbf24' : i === 5 ? '#f97316' : '#ef4444';
      return '<div style="margin-bottom:6px"><div style="display:flex;align-items:center;gap:10px;margin-bottom:3px"><span style="font-size:18px">' + e.icon + '</span><span style="color:#fff;font-weight:700;font-size:13px">' + e.nome + '</span><span style="color:#aaa;margin-left:auto;font-size:13px;font-variant-numeric:tabular-nums">' + (e.valor||0).toLocaleString('pt-BR') + '</span>' + (e.ratio !== null ? '<span style="background:'+corBar+'22;color:'+corBar+';padding:2px 8px;border-radius:6px;font-size:10px;font-weight:700;min-width:60px;text-align:center">' + dropStr + '</span>' : '<span style="min-width:60px"></span>') + '</div><div style="height:24px;background:#161616;border-radius:4px;overflow:hidden;position:relative"><div style="height:100%;background:linear-gradient(90deg,'+corBar+'aa,'+corBar+');width:'+pct+'%"></div></div></div>';
    }).join('');
    html += '</div>';
    // Breakdown por stage
    html += '<div style="margin-top:14px;background:#0d0d0d;border:1px solid #222;border-radius:10px;padding:14px"><h3 style="margin:0 0 10px;color:#fff;font-size:13px">Breakdown por Stage Zoho (' + d.total_deals + ' deals criados)</h3>';
    html += Object.entries(d.por_stage||{}).sort((a,b) => b[1]-a[1]).map(([stage, n]) => '<div style="display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #1a1a1a;font-size:11px"><span style="color:#aaa">' + stage + '</span><span style="color:#fff;font-weight:700">' + n + '</span></div>').join('');
    html += '</div>';
    c.innerHTML = html;
  } catch(e) { c.innerHTML = '<div class="tr-loading" style="color:#ef4444">Erro: '+e.message+'</div>'; }
}

// === AGENTE AUTÔNOMO COM TOOL USE ===
async function trChamarAgenteAutonomo(){
  const out = document.getElementById('tr-gestor-out');
  const btn = document.getElementById('tr-agent-btn');
  document.querySelectorAll('.tr-persona-btn').forEach(b => b.disabled = true);
  out.innerHTML = `
    <div class="tr-gestor" style="border-color:#a371f7">
      <h3 style="color:#fff">🤖 Agente Autônomo · investigando ao vivo</h3>
      <div style="color:#c4a4ff;font-size:11px;margin-bottom:10px;font-style:italic">Tool Use ativo — Claude está chamando tools (Google Ads, Meta, Zoho) sozinho. Isso pode levar 30-90s.</div>
      <div id="tr-agent-trace" style="background:#0a0a0a;border-radius:6px;padding:10px;max-height:400px;overflow-y:auto;font-family:monospace;font-size:11px;color:#aaa">
        <div style="color:#888">⏳ Aguardando primeira resposta do agente...</div>
      </div>
    </div>
  `;
  try {
    const r = await fetch('/trafego/agente-ia', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ mensagem: 'Diagnóstico completo dos últimos 7 dias. Identifique 3-5 ações priorizadas por impacto financeiro. Use as tools pra investigar (não invente números).' }),
    });
    const d = await r.json();
    if (d.error) {
      out.innerHTML = '<div class="tr-gestor"><h3 style="color:#ef4444">🤖 Agente IA</h3><div style="color:#ef4444">Erro: ' + d.error + '</div></div>';
      return;
    }
    let html = '<div class="tr-gestor" style="border-color:#a371f7"><h3 style="color:#fff">🤖 Agente Autônomo · ' + d.iterations + ' iterações</h3>';
    // Trace dos passos
    html += '<details style="background:#0a0a0a;border-radius:6px;padding:10px;margin-bottom:10px"><summary style="cursor:pointer;color:#c4a4ff;font-weight:700;font-size:12px">▸ Passos do Agente (' + d.trace.length + ')</summary><div style="margin-top:10px;font-family:monospace;font-size:11px;line-height:1.6">';
    d.trace.forEach((t, i) => {
      const ico = t.tipo === 'tool_call' ? '🔧' : t.tipo === 'tool_result' ? '✅' : t.tipo === 'tool_error' ? '❌' : '💭';
      const cor = t.tipo === 'tool_call' ? '#fbbf24' : t.tipo === 'tool_result' ? '#22c55e' : t.tipo === 'tool_error' ? '#ef4444' : '#aaa';
      html += '<div style="padding:4px 0;border-bottom:1px solid #161616"><span style="color:' + cor + '">' + ico + ' ' + t.tipo + '</span>';
      if (t.tool) html += ' <strong style="color:#7cb9f5">' + t.tool + '</strong>';
      if (t.input) html += ' <span style="color:#666">' + JSON.stringify(t.input).slice(0,100) + '</span>';
      if (t.resultado) html += ' <span style="color:#22c55e">' + t.resultado + '</span>';
      if (t.conteudo) html += '<div style="color:#aaa;margin-top:3px;padding-left:18px;font-style:italic">' + t.conteudo.slice(0, 250).replace(/</g,'&lt;') + (t.conteudo.length > 250 ? '...' : '') + '</div>';
      html += '</div>';
    });
    html += '</div></details>';
    // Resposta final
    if (d.parsed) {
      if (d.parsed.summary) html += '<div style="color:#c4a4ff;font-size:13px;margin-bottom:10px;font-weight:700;font-style:italic">' + d.parsed.summary.replace(/</g,'&lt;') + '</div>';
      if (Array.isArray(d.parsed.actions_taken) && d.parsed.actions_taken.length > 0) {
        html += '<div style="color:#22c55e;font-weight:800;font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px">✅ Ações executadas (' + d.parsed.actions_taken.length + ')</div>';
        html += d.parsed.actions_taken.map(a => '<div style="background:#0d1f0d;border:1px solid #22c55e;border-radius:6px;padding:8px;margin-bottom:5px;font-size:12px;color:#aaa">' + JSON.stringify(a).replace(/</g,'&lt;') + '</div>').join('');
      }
      if (Array.isArray(d.parsed.actions_recommended)) {
        html += '<div style="color:#f59e0b;font-weight:800;font-size:11px;text-transform:uppercase;letter-spacing:.4px;margin:10px 0 6px">📌 Ações recomendadas (precisam aprovação)</div>';
        html += d.parsed.actions_recommended.map(a => trRenderAcao(a, 0)).join('');
      }
    } else {
      html += '<div style="color:#fff;line-height:1.5;white-space:pre-wrap">' + (d.final_text || '').replace(/</g,'&lt;') + '</div>';
    }
    html += '</div>';
    out.innerHTML = html;
  } catch(e) {
    out.innerHTML = '<div class="tr-gestor"><h3 style="color:#ef4444">🤖 Agente IA</h3><div style="color:#ef4444">Erro: ' + e.message + '</div></div>';
  } finally {
    document.querySelectorAll('.tr-persona-btn').forEach(b => b.disabled = false);
  }
}


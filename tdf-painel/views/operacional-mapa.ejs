<% const activePage = 'operacional'; const pageTitle = 'Operacional · Mapa'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
<style>
  body { margin: 0; }
  .mp-shell { display: grid; grid-template-columns: 280px 1fr; height: calc(100vh - 60px); overflow: hidden; }
  @media (max-width: 900px) { .mp-shell { grid-template-columns: 1fr; height: auto; } }
  .mp-side { background: var(--bg-card); border-right: 1px solid var(--border); padding: 14px; overflow-y: auto; }
  .mp-side h2 { font-size: 14px; color: var(--text); margin: 0 0 6px; }
  .mp-side .sub { font-size: 11px; color: var(--text-muted); margin-bottom: 16px; }
  .mp-actions { display: flex; gap: 6px; margin-bottom: 12px; }
  .btn { padding: 7px 12px; border-radius: 6px; border: 1px solid; font-size: 11px; font-weight: 700; cursor: pointer; background: transparent; }
  .btn-sec { color: #93c5fd; border-color: #1f6feb; }
  .btn-warn { color: #fbbf24; border-color: #eab308; }
  .layer-row { display: flex; align-items: center; padding: 10px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; margin-bottom: 8px; cursor: pointer; user-select: none; }
  .layer-row:hover { border-color: var(--border); }
  .layer-row.on { border-color: var(--c); }
  .layer-row .pin { width: 14px; height: 14px; border-radius: 50%; margin-right: 10px; flex-shrink: 0; }
  .layer-row .lbl { flex: 1; }
  .layer-row .lbl .t { color: var(--text); font-weight: 700; font-size: 12px; }
  .layer-row .lbl .d { color: var(--text-muted); font-size: 10px; }
  .layer-row .ct { background: var(--border); padding: 2px 8px; border-radius: 8px; color: var(--text); font-size: 11px; font-weight: 700; }
  .layer-row.on .ct { background: var(--c); color: #000; }
  .meta { font-size: 11px; color: var(--text-muted); margin-top: 16px; line-height: 1.6; }
  #map-bg { height: 100%; min-height: 600px; background: var(--bg); }
  .pin-popup { font-size: 12px; line-height: 1.5; min-width: 200px; max-width: 280px; }
  .pin-popup b { color: #1f2937; }
  .pin-popup .badge { display: inline-block; font-size: 10px; padding: 2px 6px; border-radius: 4px; background: #f3f4f6; color: #1f2937; margin-right: 4px; }
  .leaflet-popup-content { margin: 10px 12px; }
  .leaflet-popup-content-wrapper { border-radius: 8px; }

  .mp-pin {
    width: 22px; height: 22px; border-radius: 50%;
    border: 2px solid #fff; box-shadow: 0 1px 4px rgba(0,0,0,.4);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; color: var(--text); font-weight: 700;
  }
  .mp-pin.tecnicos {
    width: 32px; height: 32px; font-size: 14px;
    border: 3px solid #fff; box-shadow: 0 0 0 4px rgba(251,113,133,.35), 0 2px 8px rgba(0,0,0,.5);
    animation: tec-ping 2s infinite;
    position: relative;
  }
  .mp-pin.tecnicos.speed-low { border-color: #22c55e; box-shadow: 0 0 0 4px rgba(34,197,94,.35), 0 2px 8px rgba(0,0,0,.5); }
  .mp-pin.tecnicos.speed-med { border-color: #fbbf24; box-shadow: 0 0 0 4px rgba(251,191,36,.45), 0 2px 8px rgba(0,0,0,.5); }
  .mp-pin.tecnicos.speed-high { border-color: #ef4444; box-shadow: 0 0 0 4px rgba(239,68,68,.55), 0 2px 8px rgba(0,0,0,.5); animation: speed-pulse 1s infinite; }
  @keyframes tec-ping {
    0%, 100% { box-shadow: 0 0 0 4px rgba(251,113,133,.35), 0 2px 8px rgba(0,0,0,.5); }
    50%      { box-shadow: 0 0 0 12px rgba(251,113,133,.15), 0 2px 8px rgba(0,0,0,.5); }
  }
  @keyframes speed-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(239,68,68,.55), 0 2px 8px rgba(0,0,0,.5); }
    50%      { box-shadow: 0 0 0 14px rgba(239,68,68,.15), 0 2px 8px rgba(0,0,0,.5); }
  }
  .speed-badge { position: absolute; top: -8px; right: -8px; background: var(--bg); color: var(--text); font-size: 9px; font-weight: 800; padding: 1px 4px; border-radius: 3px; border: 1px solid var(--border); min-width: 20px; text-align: center; }
  .speed-badge.high { background: #ef4444; border-color:#fff; }
  .speed-badge.med { background: #fbbf24; color: #000; border-color:#fff; }

  /* Filtro de veículos */
  .vh-filter { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px; margin-top: 12px }
  .vh-filter h4 { margin: 0 0 8px; font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px }
  .vh-row { display: flex; align-items: center; gap: 6px; padding: 4px 6px; border-radius: 4px; cursor: pointer; font-size: 11px; color: #cbd5e1 }
  .vh-row:hover { background: var(--bg-card) }
  .vh-row input[type=checkbox] { cursor: pointer }
  .vh-row .speed { margin-left: auto; font-weight: 700; font-family: monospace }
  .vh-row .speed.low { color: #22c55e }
  .vh-row .speed.med { color: #fbbf24 }
  .vh-row .speed.high { color: #ef4444 }
  .vh-row .speed.dim { color: #555 }
  .vh-actions { display: flex; gap: 4px; margin-bottom: 6px }
  .vh-actions button { background: transparent; border: 1px solid var(--border); color: #93c5fd; padding: 3px 7px; border-radius: 4px; cursor: pointer; font-size: 10px }
  .vh-actions button:hover { background: #1f6feb; color:#fff; border-color: #1f6feb }

  /* Drawer F-MAPA-DRAWER */
  .dr-overlay { position: fixed; right: -560px; top: 0; bottom: 0; width: 540px; max-width: 95vw; background: var(--bg); border-left: 1px solid var(--border); z-index: 9000; transition: right .25s ease; display: flex; flex-direction: column; box-shadow: -4px 0 30px rgba(0,0,0,.6); }
  .dr-overlay.show { right: 0; }
  .dr-h { padding: 14px 18px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; }
  .dr-h .name { font-size: 16px; font-weight: 800; color: var(--text); }
  .dr-h .meta { font-size: 11px; color: var(--text-muted); margin-top: 4px; }
  .dr-close { background: var(--border); border: 1px solid var(--border); color: var(--text); padding: 6px 10px; border-radius: 6px; cursor: pointer; }
  .dr-actions { display: flex; gap: 6px; padding: 10px 18px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
  .dr-actions .btn { padding: 6px 10px; font-size: 11px; }
  .dr-tier { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 10px; font-weight: 700; margin-right: 4px; }
  .dr-tier.Diamante { background: #67e8f9; color: #000; }
  .dr-tier.Ouro { background: #fbbf24; color: #000; }
  .dr-tier.Prata { background: #cbd5e1; color: #000; }
  .dr-tier.Bronze { background: #fb923c; color: #000; }
  .dr-tier.Pedra { background: #475569; color:#fff; }
  .dr-body { flex: 1; overflow-y: auto; padding: 12px 18px; font-size: 12px; }
  .dr-section { margin-bottom: 16px; }
  .dr-section h4 { font-size: 11px; text-transform: uppercase; letter-spacing: .6px; color: #93c5fd; margin: 0 0 8px; padding-bottom: 4px; border-bottom: 1px solid var(--border); }
  .dr-row { display: grid; grid-template-columns: 130px 1fr; gap: 10px; padding: 5px 0; align-items: center; }
  .dr-row .lbl { color: var(--text-muted); font-size: 11px; }
  .dr-row .val { color: var(--text); font-size: 12px; word-break: break-word; }
  .dr-row .val.empty { color: #555; font-style: italic; }
  .dr-row input, .dr-row select, .dr-row textarea { background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 5px 8px; border-radius: 4px; font-size: 12px; width: 100%; font-family: inherit; }
  .dr-row textarea { min-height: 60px; resize: vertical; }
  .dr-row.editable .val:hover { background: rgba(31,111,235,.08); cursor: pointer; border-radius: 4px; }
  .dr-zapi-modal { position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 9100; display: none; align-items: center; justify-content: center; }
  .dr-zapi-modal.show { display: flex; }
  .dr-zapi-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 18px; width: 480px; max-width: 95vw; }
  .dr-zapi-card h3 { margin: 0 0 12px; font-size: 14px; color: var(--text); }
  .dr-zapi-card textarea { width: 100%; min-height: 140px; background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 10px; border-radius: 6px; font-size: 13px; font-family: inherit; }
  .dr-zapi-card .meta { font-size: 11px; color: var(--text-muted); margin-bottom: 8px; }
  .dr-zapi-card .actions { margin-top: 12px; display: flex; justify-content: flex-end; gap: 8px; }
  .layer-row { cursor: pointer; }
  .layer-row.active-filter { box-shadow: 0 0 0 2px var(--c) inset; }
</style>

<div class="mp-shell">
  <div class="mp-side">
    <h2>🗺 Mapa Operacional</h2>
    <div class="sub">Tudo que está rolando no campo, em tempo real. Filtre o que quer ver.</div>

    <div class="mp-actions">
      <button class="btn btn-warn" onclick="loadMap()">🔄 Atualizar</button>
      <a href="/operacional/mapa/tv" target="_blank" class="btn" style="color:#22c55e;border-color:#22c55e;text-decoration:none;display:inline-block">📺 Modo TV</a>
      <a href="/operacional" class="btn btn-sec" style="text-decoration:none;display:inline-block">← Painel</a>
    </div>

    <label class="layer-row on" data-layer="agendados" style="--c:#22c55e">
      <input type="checkbox" checked onchange="toggleLayer('agendados', this.checked)" style="display:none">
      <span class="pin" style="background:#22c55e"></span>
      <span class="lbl"><div class="t">📅 Agendados</div><div class="d">Visitas + paradas AUVO</div></span>
      <span class="ct" id="ct-agendados">0</span>
    </label>
    <label class="layer-row on" data-layer="a_agendar" style="--c:#fbbf24">
      <input type="checkbox" checked onchange="toggleLayer('a_agendar', this.checked)" style="display:none">
      <span class="pin" style="background:#fbbf24"></span>
      <span class="lbl"><div class="t">⏳ A Agendar</div><div class="d">Vendas pendentes de rota</div></span>
      <span class="ct" id="ct-a_agendar">0</span>
    </label>
    <label class="layer-row on" data-layer="envios" style="--c:#a371f7">
      <input type="checkbox" checked onchange="toggleLayer('envios', this.checked)" style="display:none">
      <span class="pin" style="background:#a371f7"></span>
      <span class="lbl"><div class="t">📦 Envios</div><div class="d">Transportadora ativa</div></span>
      <span class="ct" id="ct-envios">0</span>
    </label>
    <label class="layer-row on" data-layer="tecnicos" style="--c:#fb7185">
      <input type="checkbox" checked onchange="toggleLayer('tecnicos', this.checked)" style="display:none">
      <span class="pin" style="background:#fb7185"></span>
      <span class="lbl"><div class="t">🚗 Técnicos / Carros</div><div class="d">GPS últimas 24h</div></span>
      <span class="ct" id="ct-tecnicos">0</span>
    </label>

    <!-- Filtro por veículo -->
    <div class="vh-filter" id="vh-filter">
      <h4>🚗 Veículos no mapa</h4>
      <div class="vh-actions">
        <button onclick="vhSelectAll(true)">Todos</button>
        <button onclick="vhSelectAll(false)">Nenhum</button>
        <button onclick="vhOnlySpeeding()">⚠ Só em excesso</button>
      </div>
      <div id="vh-list" style="max-height:200px;overflow-y:auto"></div>
    </div>

    <div class="meta">
      <b style="color:var(--text-muted)">Atualização:</b> manual + auto a cada 60s.<br>
      <b style="color:var(--text-muted)">Origem GPS:</b> tracker veicular BrasilSat (carros) + AUVO mobile (técnicos).<br>
      <b style="color:var(--text-muted)">Pins agendados</b> incluem visitas criadas pelo sistema (instalações) e paradas AUVO.<br>
      <span id="meta-generated"></span>
    </div>
  </div>

  <div id="map-bg"></div>
</div>

<!-- Drawer F-MAPA-DRAWER -->
<div class="dr-overlay" id="dr-overlay">
  <div class="dr-h">
    <div>
      <div class="name" id="dr-name">—</div>
      <div class="meta" id="dr-meta">—</div>
    </div>
    <button class="dr-close" onclick="drClose()">✕</button>
  </div>
  <div class="dr-actions" id="dr-actions"></div>
  <div class="dr-body" id="dr-body"><div style="color:var(--text-muted);text-align:center;padding:30px">Carregando…</div></div>
</div>

<!-- Modal Z-API send -->
<div class="dr-zapi-modal" id="dr-zapi-modal" onclick="if(event.target===this)drZapiClose()">
  <div class="dr-zapi-card">
    <h3 id="dr-zapi-title">📱 Enviar mensagem Z-API</h3>
    <div class="meta" id="dr-zapi-meta">—</div>
    <textarea id="dr-zapi-text" placeholder="Mensagem…"></textarea>
    <div class="actions">
      <button class="btn btn-sec" onclick="drZapiClose()">Cancelar</button>
      <button class="btn btn-warn" onclick="drZapiSend()">Enviar</button>
    </div>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>

<script>
const COLORS = {
  agendados: '#22c55e',
  a_agendar: '#fbbf24',
  envios: '#a371f7',
  tecnicos: '#fb7185',
};
const ICONS = { agendados: '📅', a_agendar: '⏳', envios: '📦', tecnicos: '🚗' };

const State = {
  map: null,
  layerGroups: {},  // layer name → L.LayerGroup
  enabled: { agendados: true, a_agendar: true, envios: true, tecnicos: true },
  data: null,
};

// Limites pra cores de velocidade no pin (configurável depois)
const SPEED_LIMIT_URBAN = 60;
const SPEED_LIMIT_HIGHWAY = 110;

function speedClass(spd) {
  if (spd == null || spd <= 5) return ''; // parado
  if (spd >= 85) return spd > SPEED_LIMIT_HIGHWAY + 10 ? 'speed-high' : (spd > SPEED_LIMIT_HIGHWAY - 5 ? 'speed-med' : 'speed-low');
  return spd > SPEED_LIMIT_URBAN + 10 ? 'speed-high' : (spd > SPEED_LIMIT_URBAN - 5 ? 'speed-med' : 'speed-low');
}

function makePin(layer, p) {
  const isTec = layer === 'tecnicos';
  const size = isTec ? 32 : 22;
  let extraClass = '';
  let speedBadge = '';
  if (isTec && p && p.speed_kmh != null) {
    extraClass = ' ' + speedClass(p.speed_kmh);
    const cls = speedClass(p.speed_kmh).replace('speed-','');
    speedBadge = `<span class="speed-badge ${cls}">${Math.round(p.speed_kmh)}</span>`;
  }
  return L.divIcon({
    className: 'mp-pin-wrap',
    html: `<div class="mp-pin ${layer}${extraClass}" style="background:${COLORS[layer]}">${ICONS[layer]}${speedBadge}</div>`,
    iconSize: [size, size],
    iconAnchor: [size/2, size/2],
  });
}

function popupHTML(layer, p) {
  const lines = [];
  if (p.customer_name) lines.push(`<b>${p.customer_name}</b>`);
  if (p.product) lines.push(p.product.substring(0, 60));
  if (p.tech_name) lines.push(`👷 ${p.tech_name}`);
  if (p.vehicle_plate) lines.push(`🚗 ${p.vehicle_plate} (${p.vehicle_model || '—'})`);
  if (p.scheduled_for) lines.push(`📅 ${new Date(p.scheduled_for).toLocaleString('pt-BR')}`);
  if (p.scheduled_start) lines.push(`📅 ${new Date(p.scheduled_start).toLocaleString('pt-BR')}`);
  if (p.date) lines.push(`📅 ${p.date}`);
  if (p.stage) lines.push(`<span class="badge">${p.stage}</span>`);
  if (p.status) lines.push(`<span class="badge">${p.status}</span>`);
  if (p.priority) lines.push(`<span class="badge">${p.priority}</span>`);
  if (p.tracking_code) lines.push(`📮 <code>${p.tracking_code}</code>`);
  if (p.amount) lines.push(`💰 R$ ${parseFloat(p.amount).toLocaleString('pt-BR',{minimumFractionDigits:2})}`);
  if (p.speed_kmh != null) lines.push(`💨 ${p.speed_kmh} km/h`);
  if (p.ts) lines.push(`<span style="color:#666">⏱ ${new Date(p.ts).toLocaleString('pt-BR')}</span>`);
  if (p.address) lines.push(`<span style="color:#666;font-size:11px">📍 ${p.address}</span>`);
  if (p.sale_id) {
    lines.push(`<button onclick="drOpen(${p.sale_id},'${layer}')" style="margin-top:6px;background:#1f6feb;color:#fff;border:0;padding:5px 10px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:700">📋 Detalhes & Z-API</button>`);
  } else if (layer === 'tecnicos' && p.tech_id) {
    lines.push(`<button onclick="drOpenTech(${p.tech_id})" style="margin-top:6px;background:#fb7185;color:#fff;border:0;padding:5px 10px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:700">👷 Falar com técnico</button>`);
  } else if (layer === 'tecnicos' && p.vehicle_plate) {
    lines.push(`<button onclick='drOpenVehicle(${JSON.stringify(p).replace(/"/g,"&quot;")})' style="margin-top:6px;background:#fb7185;color:#fff;border:0;padding:5px 10px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:700">🚗 Detalhes carro</button>`);
  } else if (layer === 'agendados' && p.auvo_task_id) {
    lines.push(`<button onclick='drOpenStop(${JSON.stringify(p).replace(/"/g,"&quot;")})' style="margin-top:6px;background:#22c55e;color:#000;border:0;padding:5px 10px;border-radius:4px;cursor:pointer;font-size:11px;font-weight:700">📋 Detalhes & Z-API</button>`);
  }
  return `<div class="pin-popup">${lines.join('<br>')}</div>`;
}

function initMap() {
  if (State.map) return;
  State.map = L.map('map-bg', { preferCanvas: true }).setView([-23.5505, -46.6333], 7);
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap',
    maxZoom: 19,
  }).addTo(State.map);

  for (const layer of Object.keys(COLORS)) {
    State.layerGroups[layer] = L.layerGroup().addTo(State.map);
  }
}

async function loadMap() {
  if (!State.map) initMap();
  try {
    const data = await fetch('/operacional/api/map-data?days=30').then(r => r.json());
    State.data = data;
    window._lastMapData = data;
    vhRenderList(data.tecnicos || []);
    document.getElementById('meta-generated').textContent =
      'Última atualização: ' + new Date(data.meta?.generated_at + 'Z').toLocaleTimeString('pt-BR');
    for (const layer of Object.keys(COLORS)) {
      State.layerGroups[layer].clearLayers();
      const items = data[layer] || [];
      document.getElementById('ct-' + layer).textContent = items.length;
      if (!State.enabled[layer]) continue;
      for (const p of items) {
        // Pin individual (pra carregar velocidade no badge)
        const icon = makePin(layer, p);
        // F-SPEED-ALERT filtro: se layer=tecnicos e veículo desselecionado, pula
        if (layer === 'tecnicos' && VH.hidden.has(p.vehicle_plate || `t${p.tech_id}`)) continue;
        const m = L.marker([p.lat, p.lng], { icon }).bindPopup(popupHTML(layer, p));
        m.addTo(State.layerGroups[layer]);
      }
    }
    // Auto-fit bounds (1ª carga apenas)
    // Prioridade: técnicos > envios > agendados+a_agendar — pra não pegar outlier
    // de outro estado e zoom-out demais escondendo os carros que estão em SJC.
    if (!State._fitted) {
      let bounds = (data.tecnicos || []).map(p => [p.lat, p.lng]);
      if (bounds.length < 2) {
        // só 1 técnico ou nenhum — junta envios pra ter contexto
        bounds = bounds.concat((data.envios || []).map(p => [p.lat, p.lng]));
      }
      if (bounds.length === 0) {
        // sem técnicos/envios — usa agendados/a_agendar
        for (const l of ['agendados', 'a_agendar']) {
          for (const p of (data[l] || [])) bounds.push([p.lat, p.lng]);
        }
      }
      if (bounds.length) {
        State.map.fitBounds(bounds, { padding: [60, 60], maxZoom: 12 });
        State._fitted = true;
      }
    }
  } catch (e) {
    console.error(e);
  }
}

function toggleLayer(name, on) {
  State.enabled[name] = on;
  const row = document.querySelector(`.layer-row[data-layer="${name}"]`);
  if (row) row.classList.toggle('on', on);
  if (on) {
    State.layerGroups[name].addTo(State.map);
  } else {
    State.layerGroups[name].remove();
  }
}

// Click no row faz toggle (checkbox) E filtra mapa pra esse layer
document.querySelectorAll('.layer-row').forEach(row => {
  row.addEventListener('click', (e) => {
    if (e.target.tagName === 'INPUT') return;
    // Shift+click ou click no checkbox = só toggle do layer
    const cb = row.querySelector('input');
    cb.checked = !cb.checked;
    toggleLayer(row.dataset.layer, cb.checked);
    // Quando habilita, foca nos pins desse layer
    if (cb.checked) focusLayer(row.dataset.layer);
  });
});

// F-SPEED-ALERT — Filtro de veículos
const VH = { hidden: new Set() };

function vhRenderList(tecnicos) {
  const c = document.getElementById('vh-list');
  if (!c) return;
  if (!tecnicos.length) { c.innerHTML = '<div style="color:#666;font-size:11px;padding:6px">Sem GPS recente</div>'; return; }
  // Dedup por placa
  const byKey = {};
  for (const p of tecnicos) {
    const k = p.vehicle_plate || `t${p.tech_id}`;
    if (!byKey[k] || (p.ts && p.ts > (byKey[k].ts||''))) byKey[k] = p;
  }
  c.innerHTML = Object.entries(byKey).map(([k, p]) => {
    const spd = p.speed_kmh != null ? Math.round(p.speed_kmh) : null;
    const cls = spd == null ? 'dim' : speedClass(spd).replace('speed-','') || 'dim';
    const label = p.vehicle_plate ? `${p.vehicle_plate}${p.vehicle_model?' · '+p.vehicle_model:''}` : (p.tech_name || 'sem técnico');
    const checked = !VH.hidden.has(k);
    return `
      <label class="vh-row">
        <input type="checkbox" ${checked?'checked':''} onchange="vhToggle('${k}', this.checked)">
        <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${label}</span>
        <span class="speed ${cls}">${spd != null ? spd+'km/h' : '—'}</span>
      </label>
    `;
  }).join('');
}

function vhToggle(key, checked) {
  if (checked) VH.hidden.delete(key); else VH.hidden.add(key);
  // re-render só do layer tecnicos
  if (State.data) {
    State.layerGroups['tecnicos'].clearLayers();
    for (const p of (State.data.tecnicos || [])) {
      const k = p.vehicle_plate || `t${p.tech_id}`;
      if (VH.hidden.has(k)) continue;
      const icon = makePin('tecnicos', p);
      L.marker([p.lat, p.lng], { icon }).bindPopup(popupHTML('tecnicos', p)).addTo(State.layerGroups['tecnicos']);
    }
  }
}

function vhSelectAll(select) {
  VH.hidden.clear();
  if (!select && State.data) {
    for (const p of (State.data.tecnicos || [])) {
      VH.hidden.add(p.vehicle_plate || `t${p.tech_id}`);
    }
  }
  vhRenderList(State.data?.tecnicos || []);
  vhToggle('__refresh__', true);  // força redraw — checked não importa
  // redraw manual
  if (State.data) {
    State.layerGroups['tecnicos'].clearLayers();
    for (const p of (State.data.tecnicos || [])) {
      const k = p.vehicle_plate || `t${p.tech_id}`;
      if (VH.hidden.has(k)) continue;
      const icon = makePin('tecnicos', p);
      L.marker([p.lat, p.lng], { icon }).bindPopup(popupHTML('tecnicos', p)).addTo(State.layerGroups['tecnicos']);
    }
  }
}

function vhOnlySpeeding() {
  if (!State.data) return;
  VH.hidden.clear();
  for (const p of (State.data.tecnicos || [])) {
    const spd = p.speed_kmh;
    const k = p.vehicle_plate || `t${p.tech_id}`;
    // hide quem NÃO está em excesso
    if (spd == null || speedClass(spd) !== 'speed-high') VH.hidden.add(k);
  }
  vhRenderList(State.data.tecnicos || []);
  State.layerGroups['tecnicos'].clearLayers();
  for (const p of (State.data.tecnicos || [])) {
    const k = p.vehicle_plate || `t${p.tech_id}`;
    if (VH.hidden.has(k)) continue;
    const icon = makePin('tecnicos', p);
    L.marker([p.lat, p.lng], { icon }).bindPopup(popupHTML('tecnicos', p)).addTo(State.layerGroups['tecnicos']);
  }
}

function focusLayer(layer) {
  if (!State.data) return;
  const items = State.data[layer] || [];
  if (!items.length) return;
  const bounds = items.map(p => [p.lat, p.lng]);
  State.map.fitBounds(bounds, { padding: [60, 60], maxZoom: 13 });
}

// ============ F-MAPA-DRAWER ============
let _drCurrent = { saleId: null, layer: null, deal: null, customer_phone: null, tech_phone: null, tech_name: null };

async function drOpen(saleId, layer) {
  _drCurrent = { saleId, layer, deal: null, customer_phone: null, tech_phone: null, tech_name: null };
  document.getElementById('dr-overlay').classList.add('show');
  document.getElementById('dr-name').textContent = 'Carregando…';
  document.getElementById('dr-meta').textContent = `Sale #${saleId}`;
  document.getElementById('dr-actions').innerHTML = '';
  document.getElementById('dr-body').innerHTML = '<div style="color:#666;text-align:center;padding:30px">Buscando dados…</div>';
  try {
    const [card, zoho] = await Promise.all([
      fetch(`/operacional/api/sales/${saleId}/card`).then(r => r.json()),
      fetch(`/operacional/api/sales/${saleId}/zoho-deal`).then(r => r.ok ? r.json() : { deal: {} }).catch(() => ({ deal: {} })),
    ]);
    _drCurrent.deal = zoho.deal || {};
    _drCurrent.customer_phone = card.sale?.customer_phone || null;
    _drCurrent.tech_name = card.visit?.technician_name || null;
    // Resolve tech phone via /technicians (cache)
    if (_drCurrent.tech_name) {
      try {
        const techs = await fetch('/operacional/api/technicians').then(r => r.json());
        const list = Array.isArray(techs) ? techs : (techs.items || []);
        const t = list.find(x => x.name === _drCurrent.tech_name);
        if (t && t.phone) _drCurrent.tech_phone = t.phone;
      } catch {}
    }
    drRender(card, _drCurrent.deal);
  } catch (e) {
    document.getElementById('dr-body').innerHTML = `<div style="color:#f87171;padding:20px">${e.message}</div>`;
  }
}

function drClose() { document.getElementById('dr-overlay').classList.remove('show'); }


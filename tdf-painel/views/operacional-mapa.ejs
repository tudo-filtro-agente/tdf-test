function drRender(card, deal) {
  const sale = card.sale || {};
  const tier = deal.Tier_Lead || '';
  const score = deal.Score_Lead;
  document.getElementById('dr-name').innerHTML =
    (tier ? `<span class="dr-tier ${tier}">${tier}</span>` : '') +
    (sale.customer_name || deal.Deal_Name || `Sale #${sale.id}`);
  document.getElementById('dr-meta').innerHTML =
    `${sale.product_line || ''} · ${sale.queue || ''} · ${sale.status || ''}` +
    (score != null ? ` · Score ${score}` : '') +
    (deal.SLA_Lead ? ` · ${deal.SLA_Lead}` : '');

  // Actions
  const acts = [];
  if (card.links?.crm) acts.push(`<a href="${card.links.crm}" target="_blank" class="btn btn-sec">🔗 Zoho</a>`);
  if (card.links?.whatsapp) acts.push(`<a href="${card.links.whatsapp}" target="_blank" class="btn" style="color:#25D366;border-color:#25D366">📱 WhatsApp web</a>`);
  acts.push(`<a href="/operacional/cliente/${sale.id}" target="_blank" class="btn btn-sec">📋 Card completo</a>`);
  if (_drCurrent.customer_phone) acts.push(`<button class="btn btn-warn" onclick="drZapiOpen('customer')">💬 Z-API → Cliente</button>`);
  if (_drCurrent.tech_phone) acts.push(`<button class="btn btn-warn" onclick="drZapiOpen('tech')">👷 Z-API → ${_drCurrent.tech_name?.split(' ')[0] || 'Técnico'}</button>`);
  document.getElementById('dr-actions').innerHTML = acts.join('');

  // Body sections
  const fmtDate = (s) => s ? new Date(s).toLocaleString('pt-BR') : '';
  const fmtDay = (s) => s ? new Date(s).toLocaleDateString('pt-BR') : '';
  const money = (v) => v != null ? `R$ ${parseFloat(v).toLocaleString('pt-BR',{minimumFractionDigits:2})}` : '';
  const ed = (key, val, opts={}) => {
    const empty = !val ? ' empty' : '';
    return `<div class="dr-row editable" data-field="${key}">
      <div class="lbl">${opts.label || key}</div>
      <div class="val${empty}" onclick="drEditField('${key}', this, ${JSON.stringify(opts).replace(/"/g,'&quot;')})">${val || '—'}</div>
    </div>`;
  };
  const ro = (lbl, val) => `<div class="dr-row"><div class="lbl">${lbl}</div><div class="val${val?'':' empty'}">${val||'—'}</div></div>`;

  const enderecoFull = [deal.Endere_o, deal.N_mero, deal.Bairro, deal.Cidade, deal.Estado, deal.CEP].filter(Boolean).join(', ');

  document.getElementById('dr-body').innerHTML = `
    <div class="dr-section">
      <h4>📦 Produto / Serviço</h4>
      ${ro('Produto', deal.Produto_Vendido || sale.product_line)}
      ${ro('Tipo Serviço', deal.Tipo_de_Servi_o || sale.service_type)}
      ${ed('Tipo_de_Agua', deal.Tipo_de_Agua, {label:'Tipo Água'})}
      ${ed('Skill_Necess_ria', deal.Skill_Necess_ria, {label:'Skill'})}
      ${ed('Dura_o_Prevista', deal.Dura_o_Prevista, {label:'Duração'})}
      ${ed('Janela_do_Cliente', deal.Janela_do_Cliente, {label:'Janela'})}
      ${ro('Quantidade', sale.quantity || 1)}
    </div>

    <div class="dr-section">
      <h4>💰 Pagamento</h4>
      ${ro('Valor', money(deal.Amount || sale.amount))}
      ${ed('Forma_de_Pagamento', deal.Forma_de_Pagamento || deal.Forma_Pagamento, {label:'Forma Pgto'})}
      ${ed('Payment_Status', deal.Payment_Status || deal.Status_do_Pagamento, {label:'Status Pgto'})}
      ${ed('Parcelas', deal.Parcelas, {label:'Parcelas', type:'number'})}
      ${ed('Valor_Pago', deal.Valor_Pago, {label:'Valor Pago', type:'number'})}
      ${ro('Closing Date', fmtDay(deal.Closing_Date || sale.sold_at))}
    </div>

    <div class="dr-section">
      <h4>📅 Agendamento</h4>
      ${ed('Data_Agendada', fmtDay(deal.Data_Agendada), {label:'Data Agendada', type:'date', raw: deal.Data_Agendada})}
      ${ed('Data_da_Instala_o', fmtDay(deal.Data_da_Instala_o), {label:'Data Instalação', type:'date', raw: deal.Data_da_Instala_o})}
      ${ed('T_cnico_Sugerido', deal.T_cnico_Sugerido, {label:'Técnico'})}
      ${ro('Pronto p/ Agendar', deal.Pronto_para_Agendar ? '✅ Sim' : '❌ Não')}
      ${ro('Produto Disponível', deal.Produto_Dispon_vel ? '✅ Sim' : '❌ Não')}
      ${ro('Visita Auvo', card.visit?.auvo_task_id ? `#${card.visit.auvo_task_id}` : '')}
    </div>

    <div class="dr-section">
      <h4>📍 Endereço</h4>
      ${ed('Endere_o', deal.Endere_o, {label:'Logradouro'})}
      ${ed('N_mero', deal.N_mero, {label:'Número'})}
      ${ed('Bairro', deal.Bairro, {label:'Bairro'})}
      ${ed('Cidade', deal.Cidade, {label:'Cidade'})}
      ${ed('CEP', deal.CEP, {label:'CEP'})}
      ${ed('Estado', deal.Estado, {label:'Estado'})}
      ${ed('Nome_Condom_nio', deal.Nome_Condom_nio, {label:'Condomínio'})}
      ${ro('Endereço completo', enderecoFull)}

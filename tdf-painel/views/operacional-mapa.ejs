    <div class="dr-section">
      <h4>👤 Cliente</h4>
      ${ro('Nome', sale.customer_name)}
      ${ro('Telefone', sale.customer_phone || '—')}
      ${ro('Email', sale.customer_email || '—')}
      ${ro('Vendedor', deal.Owner || sale.vendor_name)}
    </div>

    <div class="dr-section">
      <h4>📝 Observações Zoho</h4>
      ${ed('Description', deal.Description, {label:'Descrição', type:'textarea'})}
      ${sale.observations ? `<div class="dr-row"><div class="lbl">Obs Sale</div><div class="val">${sale.observations}</div></div>` : ''}
    </div>
  `;
}

async function drEditField(key, el, opts) {
  const current = el.classList.contains('empty') ? '' : el.textContent.trim();
  const type = opts.type || 'text';
  const input = type === 'textarea'
    ? `<textarea>${current === '—' ? '' : current}</textarea>`
    : `<input type="${type}" value="${(opts.raw || (current === '—' ? '' : current)).replace(/"/g,'&quot;')}" />`;
  el.innerHTML = `${input}<div style="margin-top:4px;display:flex;gap:4px"><button class="btn btn-warn" style="padding:3px 8px;font-size:10px" onclick="drSaveField('${key}', this)">Salvar</button><button class="btn btn-sec" style="padding:3px 8px;font-size:10px" onclick="drOpen(${_drCurrent.saleId},'${_drCurrent.layer}')">Cancelar</button></div>`;
  el.querySelector('input,textarea').focus();
}

async function drSaveField(key, btn) {
  const cell = btn.closest('.val');
  const val = cell.querySelector('input,textarea').value;
  try {
    btn.textContent = '...';
    btn.disabled = true;
    const r = await fetch(`/operacional/api/sales/${_drCurrent.saleId}/zoho-deal`, {
      method: 'PATCH', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ fields: { [key]: val } })
    });
    if (!r.ok) throw new Error((await r.json()).error || `HTTP ${r.status}`);
    alert('Campo atualizado no Zoho ✓');
    drOpen(_drCurrent.saleId, _drCurrent.layer);
  } catch (e) {
    alert('Erro: ' + e.message);
    btn.disabled = false; btn.textContent = 'Salvar';
  }
}

// Z-API modal
function drZapiOpen(target) {
  const sale_name = (_drCurrent.deal?.Deal_Name) || '';
  const date = _drCurrent.deal?.Data_Agendada || _drCurrent.deal?.Data_da_Instala_o;
  const dateFmt = date ? new Date(date).toLocaleDateString('pt-BR') : 'em breve';
  const tech = _drCurrent.tech_name || 'técnico';
  const product = _drCurrent.deal?.Produto_Vendido || '';
  let phone = '', meta = '', msg = '';
  if (target === 'tech_freeform') {
    phone = _drCurrent.tech_phone;
    meta = `Técnico ${tech} · ${phone}`;
    msg = `Olá ${tech?.split(' ')[0] || ''}, `;
  } else if (target === 'customer') {
    phone = _drCurrent.customer_phone;
    meta = `Cliente · ${phone}`;
    msg = `Olá! Aqui é da Tudo de Filtro 💧\n\nLembrete: sua instalação ${product ? 'do(a) ' + product + ' ' : ''}está agendada para ${dateFmt}, com nosso técnico ${tech}.\n\nQualquer dúvida, é só responder por aqui.`;
  } else {
    phone = _drCurrent.tech_phone;
    meta = `Técnico ${tech} · ${phone}`;
    msg = `🔧 Serviço agendado\n\nCliente: ${_drCurrent.deal?.Account_Name || _drCurrent.deal?.Contact_Name || sale_name}\nData: ${dateFmt}\nProduto: ${product}\nEndereço: ${[_drCurrent.deal?.Endere_o, _drCurrent.deal?.N_mero, _drCurrent.deal?.Bairro, _drCurrent.deal?.Cidade].filter(Boolean).join(', ')}\nTel: ${_drCurrent.customer_phone || '—'}`;
  }
  if (!phone) return alert('Telefone não disponível');
  document.getElementById('dr-zapi-title').textContent = target === 'customer' ? '💬 Mensagem ao Cliente' : '👷 Mensagem ao Técnico';
  document.getElementById('dr-zapi-meta').textContent = meta;
  document.getElementById('dr-zapi-text').value = msg;
  document.getElementById('dr-zapi-modal').dataset.target = target;
  document.getElementById('dr-zapi-modal').dataset.phone = phone;
  document.getElementById('dr-zapi-modal').classList.add('show');
}

function drZapiClose() { document.getElementById('dr-zapi-modal').classList.remove('show'); }

async function drZapiSend() {
  const modal = document.getElementById('dr-zapi-modal');
  const phone = modal.dataset.phone;
  const target = modal.dataset.target;
  const message = document.getElementById('dr-zapi-text').value.trim();
  if (!message) return alert('Mensagem vazia');
  try {
    const r = await fetch('/operacional/api/zapi/send', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ phone, message, target })
    });
    const j = await r.json();
    if (!r.ok || j.ok === false) throw new Error(j.error || `HTTP ${r.status}`);
    alert('Mensagem enviada ✓');
    drZapiClose();
  } catch (e) {
    alert('Erro Z-API: ' + e.message);
  }
}


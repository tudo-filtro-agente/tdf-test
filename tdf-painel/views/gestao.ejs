// ============= LOAD =============
async function loadData(){
  try{
    const [d1, d2, d3, d4] = await Promise.all([
      fetch('/gestao/data').then(r=>r.json()),
      fetch('/gestao/guerra').then(r=>r.json()),
      fetch('/gestao/disciplina').then(r=>r.json()).catch(()=>null),
      fetch('/gestao/ia-status').then(r=>r.json()).catch(()=>null)
    ]);
    if(d1.error) throw new Error('data: '+d1.error);
    if(d2.error) throw new Error('guerra: '+d2.error);
    DATA = d1; GUERRA = d2;
    DISCIPLINA = (d3 && !d3.error) ? d3 : null;
    IA_STATUS = (d4 && !d4.error) ? d4 : null;
    renderHeader();
    renderBloco1();
    renderBloco2();
    renderBloco3();
    renderBloco4();
    renderBloco5();
    renderBloco6();
    renderBlocoIA();
    popularDropdownRx();
    renderBloco7();
    renderBloco8();
  }catch(e){
    toast('Falha ao carregar: '+e.message, true);
    console.error(e);
  }
}

function reloadAll(){
  toast('Atualizando...');
  loadData();
}

// ============= MODAL: ENVIAR MENSAGEM AO TIME =============
function abrirDirectorMsg(){
  // Popula select de closers
  const sel = document.getElementById('dm-closer');
  sel.innerHTML = '<option value="all">📣 Todo o time</option>';
  if (DATA?.closers) {
    Object.entries(DATA.closers).forEach(([username, c]) => {
      sel.innerHTML += `<option value="${username}">${c.name} (${c.team||''})</option>`;
    });
  }
  document.getElementById('dm-titulo').value = '';
  document.getElementById('dm-texto').value = '';
  document.getElementById('dm-count').textContent = '0';
  document.querySelector('input[name="dm-int"][value="normal"]').checked = true;
  document.getElementById('dm-expira').value = '60';
  document.getElementById('tc-director-msg').style.display = 'block';
}
function fecharDirectorMsg(){
  document.getElementById('tc-director-msg').style.display = 'none';
}
document.addEventListener('input', e => {
  if (e.target.id === 'dm-texto') {
    document.getElementById('dm-count').textContent = e.target.value.length;
  }
});
async function enviarDirectorMsg(){
  const closer = document.getElementById('dm-closer').value;
  const titulo = document.getElementById('dm-titulo').value.trim();
  const texto = document.getElementById('dm-texto').value.trim();
  const intensidade = document.querySelector('input[name="dm-int"]:checked')?.value || 'normal';
  const expira_em_min = parseInt(document.getElementById('dm-expira').value) || 60;

  if (!texto) { toast('Escreva a mensagem', true); return; }

  const btn = document.getElementById('dm-send');
  btn.disabled = true; btn.textContent = 'Enviando...';
  try{
    const res = await fetch('/gestao/director-message', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ closer, titulo, texto, intensidade, expira_em_min })
    });
    const r = await res.json();
    if (r.error) { toast('Erro: '+r.error, true); return; }
    const dest = closer === 'all' ? 'todo o time' : DATA.closers[closer]?.name || closer;
    toast(`✅ Mensagem ${intensidade} enviada para ${dest}`);
    fecharDirectorMsg();
  }catch(e){ toast('Erro: '+e.message, true); }
  finally{ btn.disabled = false; btn.textContent = '📢 Enviar'; }
}

// ============= MODAL: DETALHE DO CANAL (produtos + vendas convertidas) =============
async function abrirCanalDetalhe(canal){
  document.getElementById('canal-titulo').textContent = `📊 ${canal} — Pipeline & Conversão`;
  document.getElementById('canal-stats').innerHTML = '<div style="grid-column:1/-1;color:var(--muted);font-size:13px;text-align:center;padding:20px">Buscando deals e produtos...</div>';
  document.getElementById('canal-produtos').innerHTML = '<div class="empty">Carregando...</div>';
  document.getElementById('tc-canal').style.display = 'block';

  try {
    const res = await fetch('/gestao/canal-detalhe?canal=' + encodeURIComponent(canal));
    const d = await res.json();
    if (d.error) {
      document.getElementById('canal-stats').innerHTML = `<div style="color:var(--red);grid-column:1/-1;text-align:center;padding:20px">Erro: ${d.error}</div>`;
      return;
    }

    const canalCol = CANAL_COLOR[canal] || '#6b7280';
    const s = d.stats;

    // Stats cards
    document.getElementById('canal-stats').innerHTML = `
      <div class="card" style="border-color:${canalCol}"><div class="lbl">📋 Propostas Ativas</div><div class="big" style="color:${canalCol}">${s.totalPropostas}</div><div class="sub">${fmtR$(s.valorPropostas)}</div></div>
      <div class="card green"><div class="lbl">✅ Vendas Fechadas (mês)</div><div class="big">${s.totalVendas}</div><div class="sub">${fmtR$(s.valorVendas)}</div></div>
      <div class="card red"><div class="lbl">❌ Perdas (mês)</div><div class="big">${s.totalPerdas}</div></div>
      <div class="card ${s.conversao>=20?'green':s.conversao>=10?'yellow':'red'}"><div class="lbl">🎯 Conversão</div><div class="big">${s.conversao}%</div><div class="sub">vendas / decididos</div></div>
      <div class="card blue"><div class="lbl">💰 Ticket Médio</div><div class="big">${fmtR$(s.ticketMedioVendas)}</div><div class="sub">por venda</div></div>
    `;

    // Produtos com expansão de deals (vendas + propostas)
    if (!d.produtos || !d.produtos.length) {
      document.getElementById('canal-produtos').innerHTML = '<div class="empty">Nenhum produto identificado pra esse canal</div>';
      return;
    }
    document.getElementById('canal-produtos').innerHTML = d.produtos.map((p, i) => {
      const conversaoP = (p.vendas + p.propostas) > 0 ? Math.round(p.vendas / (p.vendas + p.propostas) * 100) : 0;
      const idSafe = 'p' + i;
      return `
        <div style="background:#101010;border:1px solid var(--line);border-radius:10px;margin-bottom:8px;overflow:hidden">
          <div onclick="document.getElementById('${idSafe}-body').style.display=document.getElementById('${idSafe}-body').style.display==='none'?'block':'none'" style="display:flex;align-items:center;gap:14px;padding:12px 14px;cursor:pointer;background:#161616">
            <div style="font-weight:700;color:#fff;flex:1;font-size:13px">${p.produto || '— sem produto cadastrado —'}</div>
            <div style="font-size:11px;color:var(--muted)">📋 ${p.propostas} prop · ${fmtR$(p.valorProp)}</div>
            <div style="font-size:11px;color:#4ade80;font-weight:700">✅ ${p.vendas} vendas · ${fmtR$(p.valorVendas)}</div>
            <div style="font-size:11px;color:${conversaoP>=20?'#4ade80':conversaoP>=10?'#fbbf24':'#f87171'};font-weight:800;width:50px;text-align:right">${conversaoP}%</div>
            <span style="color:#666;font-size:14px">▸</span>
          </div>
          <div id="${idSafe}-body" style="display:none;padding:12px 14px;background:#0d0d0d">
            ${p.dealsVendas.length ? `
              <div style="font-size:10px;color:#4ade80;font-weight:800;text-transform:uppercase;margin-bottom:6px;letter-spacing:.4px">✅ ${p.dealsVendas.length} venda(s) fechada(s)</div>
              <table class="tbl" style="margin-bottom:10px"><thead><tr><th>Lead</th><th>Vendedor</th><th>Data</th><th>Valor</th><th>CRM</th></tr></thead><tbody>
                ${p.dealsVendas.map(v => `<tr>
                  <td style="font-weight:600">${v.name}</td>
                  <td>${v.owner}</td>
                  <td style="color:var(--muted);font-size:11px">${v.dataFechamento}</td>
                  <td style="color:#4ade80;font-weight:700">${fmtR$Full(v.amount)}</td>
                  <td><a class="btn-mini crm" href="${v.crmLink}" target="_blank">Abrir</a></td>
                </tr>`).join('')}
              </tbody></table>
            ` : ''}
            ${p.dealsPropostas.length ? `
              <div style="font-size:10px;color:var(--blue);font-weight:800;text-transform:uppercase;margin-bottom:6px;margin-top:${p.dealsVendas.length?'14px':'0'};letter-spacing:.4px">📋 ${p.dealsPropostas.length} proposta(s) ativa(s)</div>
              <table class="tbl"><thead><tr><th>Lead</th><th>Vendedor</th><th>Stage</th><th>Valor</th><th>Ações</th></tr></thead><tbody>
                ${p.dealsPropostas.slice(0, 20).map(pp => `<tr>
                  <td>${pp.name}</td>
                  <td>${pp.owner}</td>
                  <td style="font-size:11px;color:var(--muted)">${pp.stage}</td>
                  <td style="color:#fff;font-weight:700">${fmtR$Full(pp.amount)}</td>
                  <td><div class="row-act">
                    ${pp.phone?`<a class="btn-mini wati" href="${wpp(pp.phone)}" target="_blank">WATI</a>`:''}
                    <a class="btn-mini crm" href="${pp.crmLink}" target="_blank">CRM</a>
                  </div></td>
                </tr>`).join('')}
                ${p.dealsPropostas.length > 20 ? `<tr><td colspan="5" style="color:var(--muted);text-align:center;font-size:11px">+ ${p.dealsPropostas.length-20} propostas adicionais</td></tr>`:''}
              </tbody></table>
            ` : ''}
            ${!p.dealsVendas.length && !p.dealsPropostas.length ? '<div class="empty">Sem deals</div>' : ''}
          </div>
        </div>
      `;
    }).join('');
  } catch(e) {
    document.getElementById('canal-stats').innerHTML = `<div style="color:var(--red);grid-column:1/-1;text-align:center;padding:20px">Erro: ${e.message}</div>`;
  }
}


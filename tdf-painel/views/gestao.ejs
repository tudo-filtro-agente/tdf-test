}

async function enviarRanking(){
  // Reusa relatorio-diario que envia plano + ranking via Z-API
  toast('Enviando ranking parcial...');
  try{
    const res = await fetch('/gestao/relatorio-diario?send=true&type=ranking');
    const r = await res.json();
    if(r.sent) toast('Ranking enviado ✓');
    else toast('Erro: '+(r.error||'falha'), true);
  }catch(e){ toast('Erro: '+e.message, true); }

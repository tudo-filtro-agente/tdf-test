// ============= MODAL PERÍODO CUSTOMIZADO =============
function abrirModalPeriodo(){
  // Default: 7-30 dias atrás
  setPeriodo(7, 30);
  document.getElementById('periodo-preview').style.display = 'none';
  document.getElementById('btn-disparar').disabled = true;
  document.getElementById('tc-periodo').style.display = 'block';
}
function fecharModalPeriodo(){
  document.getElementById('tc-periodo').style.display = 'none';
}
function setPeriodo(diasFimAtras, diasInicioAtras){
  // diasInicioAtras > diasFimAtras (mais antigo → mais recente)
  const fim = new Date(); fim.setDate(fim.getDate() - diasFimAtras);
  const ini = new Date(); ini.setDate(ini.getDate() - diasInicioAtras);
  document.getElementById('periodo-inicio').value = ini.toISOString().slice(0,10);
  document.getElementById('periodo-fim').value = fim.toISOString().slice(0,10);
  document.getElementById('periodo-preview').style.display = 'none';
  document.getElementById('btn-disparar').disabled = true;
}

function getPeriodoParams(){
  const dataInicio = document.getElementById('periodo-inicio').value;
  const dataFim = document.getElementById('periodo-fim').value;
  const tiers = Array.from(document.querySelectorAll('.tier-cb:checked')).map(c => c.value);
  const limite = parseInt(document.getElementById('periodo-limite').value);
  return { dataInicio, dataFim, tiers, limite };
}

async function previewPeriodo(){
  const p = getPeriodoParams();
  if (!p.dataInicio || !p.dataFim) { toast('Preencha as duas datas', true); return; }
  if (p.dataInicio > p.dataFim) { toast('Data inicial maior que a final', true); return; }
  if (!p.tiers.length) { toast('Selecione pelo menos um tier', true); return; }

  const box = document.getElementById('periodo-preview');
  const btn = document.getElementById('btn-preview');
  btn.disabled = true; btn.textContent = 'Buscando...';
  box.style.display = 'block';
  box.innerHTML = '<span style="color:var(--muted)">Buscando candidatos no Zoho...</span>';

  try {
    const url = `/gestao/nubia-preview?tipo=por_periodo&dataInicio=${p.dataInicio}&dataFim=${p.dataFim}&tiers=${encodeURIComponent(p.tiers.join(','))}`;
    const res = await fetch(url);
    const r = await res.json();
    if (r.error) { box.innerHTML = '<span style="color:var(--red)">Erro: '+r.error+'</span>'; return; }

    if (r.total === 0) {
      box.innerHTML = '<strong style="color:var(--yellow)">⚠️ Nenhum lead encontrado nessa janela.</strong> Tenta outro período ou inclua mais tiers.';
      document.getElementById('btn-disparar').disabled = true;
      return;
    }

    const tiersTxt = Object.entries(r.porTier||{}).map(([t,n])=>`${t}: ${n}`).join(' • ');
    const ownersTxt = Object.entries(r.porOwner||{}).slice(0,5).map(([o,n])=>`${o}: ${n}`).join(', ');
    const lim = Math.min(r.total, p.limite);
    box.innerHTML = `
      <div style="font-size:13px;color:#fff;margin-bottom:6px"><strong>${r.total}</strong> leads elegíveis. Vou disparar pros <strong style="color:#22c55e">${lim}</strong> primeiros (priorizando Diamante/Ouro/maior valor).</div>
      <div style="margin-top:6px"><strong>Por tier:</strong> ${tiersTxt}</div>
      <div style="margin-top:4px"><strong>Top vendedores:</strong> ${ownersTxt}</div>
      ${r.sample?.length?`<div style="margin-top:8px;font-size:11px;color:var(--muted)"><strong style="color:#fff">Amostra:</strong><br>${r.sample.map(s=>`• ${s.name} (${s.tier||'-'}, ${s.stage})`).join('<br>')}</div>`:''}
    `;
    document.getElementById('btn-disparar').disabled = false;
  } catch(e) {
    box.innerHTML = '<span style="color:var(--red)">Erro: '+e.message+'</span>';
  } finally {
    btn.disabled = false; btn.textContent = '🔍 Pré-visualizar';
  }
}

async function dispararPeriodo(){
  const p = getPeriodoParams();
  if (!confirm(`Confirma disparar Núbia para até ${p.limite} leads no período ${p.dataInicio} → ${p.dataFim}?\n\nTiers: ${p.tiers.join(', ')}\n(Propostas sempre excluídas)`)) return;

  const btn = document.getElementById('btn-disparar');
  btn.disabled = true; btn.textContent = 'Disparando...';
  try {
    const res = await fetch('/gestao/nubia-reengaja', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ tipo:'por_periodo', ...p })
    });
    const r = await res.json();
    if (r.error) { toast('Erro: '+r.error, true); return; }
    toast(`✅ Núbia disparou para ${r.sent||0} leads (${r.candidates||0} elegíveis)`);
    fecharModalPeriodo();
  } catch(e) {
    toast('Erro: '+e.message, true);
  } finally {
    btn.disabled = false; btn.textContent = '🚀 Disparar Núbia';
  }
}

// Auto-load
loadData();
</script>


<% const activePage = 'gestao'; const pageTitle = 'Torre de Comando'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
/* === TORRE DE COMANDO === */
:root{
  --bg:#0a0a0a; --panel:#151515; --panel-2:#1a1a1a; --line:#222; --line-2:#2a2a2a;
  --txt:#e6edf3; --muted:#8b949e; --dim:#555;
  --green:#22c55e; --red:#ef4444; --yellow:#eab308; --blue:#5ba3f5; --purple:#a371f7; --orange:#f97316;
  --green-bg:#0d2818; --red-bg:#2d1215; --yellow-bg:#2d2513; --blue-bg:#0d1f3a; --purple-bg:#1e1225;
}
html[data-theme="light"]{
  --bg:#F2F4F8; --panel:#FFFFFF; --panel-2:#F0F3F7; --line:#D8DEE6; --line-2:#C9D1DB;
  --txt:#1F2328; --muted:#59636E; --dim:#8A93A0;
  --green:#15803D; --red:#DC2626; --yellow:#A16207; --blue:#2563EB; --purple:#7C3AED; --orange:#C2410C;
  --green-bg:#DCFCE7; --red-bg:#FEE2E2; --yellow-bg:#FEF9C3; --blue-bg:#DBEAFE; --purple-bg:#EDE9FE;
}


/* Header fixo (sticky) */
.tc-header{
  position:sticky; top:0; z-index:50;
  background:linear-gradient(135deg,var(--panel),var(--panel-2));
  border-bottom:1px solid var(--line);
  padding:14px 24px;
  box-shadow:0 4px 12px rgba(0,0,0,.4);
}
.tc-hrow{display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.tc-title{font-size:14px;font-weight:700;color:var(--text);letter-spacing:.5px;display:flex;align-items:center;gap:8px;margin-right:auto}
.tc-title .dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 8px var(--green);animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.tc-kpi{display:flex;flex-direction:column;padding:6px 12px;background:var(--panel-2);border:1px solid var(--line);border-radius:8px;min-width:110px}
.tc-kpi .k-l{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
.tc-kpi .k-v{font-size:16px;font-weight:800;color:var(--text);line-height:1.2}
.tc-kpi.green .k-v{color:var(--green)}
.tc-kpi.red .k-v{color:var(--red)}
.tc-kpi.yellow .k-v{color:var(--yellow)}
.tc-kpi.blue .k-v{color:var(--blue)}
.tc-status{padding:8px 14px;border-radius:8px;font-weight:800;font-size:13px;text-transform:uppercase;letter-spacing:.5px}
.tc-status.green{background:rgba(34,197,94,.15);color:var(--green);border:1px solid var(--green)}
.tc-status.yellow{background:rgba(234,179,8,.15);color:var(--yellow);border:1px solid var(--yellow)}
.tc-status.red{background:rgba(239,68,68,.15);color:var(--red);border:1px solid var(--red);animation:pulseRed 1.2s infinite}
@keyframes pulseRed{0%,100%{box-shadow:0 0 0 0 rgba(239,68,68,.4)}50%{box-shadow:0 0 0 8px rgba(239,68,68,0)}}
.tc-clock{font-family:'SF Mono',Menlo,monospace;font-size:14px;color:var(--muted);font-weight:700;padding:6px 10px;background:rgba(0,0,0,.35);border-radius:6px}
.tc-btn{padding:8px 14px;border-radius:8px;border:1px solid var(--line-2);background:var(--bg-hover);color:var(--text);font-size:12px;font-weight:700;cursor:pointer;transition:all .15s;text-transform:uppercase;letter-spacing:.3px}
.tc-btn:hover{background:#222;border-color:#333}
.tc-btn.danger{background:var(--red-bg);color:#fca5a5;border-color:var(--red)}
.tc-btn.danger:hover{background:#3a1518}
.tc-btn.warn{background:var(--yellow-bg);color:#fbbf24;border-color:var(--yellow)}
.tc-btn.success{background:var(--green-bg);color:#4ade80;border-color:var(--green)}
.tc-btn.info{background:var(--blue-bg);color:#7cb9f5;border-color:var(--blue)}
.tc-btn.purple{background:var(--purple-bg);color:#c084fc;border-color:var(--purple)}
.tc-btn.active{background:var(--red-bg);color:var(--text);border-color:var(--red);box-shadow:0 0 10px rgba(239,68,68,.4)}

/* Botões globais */
.tc-globals{
  position:sticky; top:64px; z-index:40;
  background:#0e0e10; border-bottom:1px solid var(--line);
  padding:10px 24px; display:flex; gap:8px; flex-wrap:wrap;
}

/* Conteúdo */
.tc-wrap{max-width:1500px;margin:0 auto;padding:20px 24px 80px}
.tc-block{background:var(--panel);border:1px solid var(--line);border-radius:12px;margin-bottom:18px;overflow:hidden}
.tc-block.crit{border-color:#3a1f23}
.tc-bhead{display:flex;align-items:center;gap:10px;padding:14px 18px;background:var(--bg-card);border-bottom:1px solid var(--line)}
.tc-bnum{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:6px;background:#222;color:var(--muted);font-size:11px;font-weight:800}
.tc-btitle{font-size:14px;font-weight:800;color:var(--text);letter-spacing:.3px;flex:1;display:flex;align-items:center;gap:8px}
.tc-bicon{font-size:18px}
.tc-bsub{font-size:11px;color:var(--muted);font-weight:600}
.tc-bbody{padding:16px 18px}

.tc-grid{display:grid;gap:12px}
.tc-grid-4{grid-template-columns:repeat(4,1fr)}
.tc-grid-3{grid-template-columns:repeat(3,1fr)}
.tc-grid-2{grid-template-columns:1fr 1fr}
@media(max-width:900px){.tc-grid-4,.tc-grid-3,.tc-grid-2{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.tc-grid-4,.tc-grid-3,.tc-grid-2{grid-template-columns:1fr}.tc-globals{top:auto}}

.card{background:var(--panel-2);border:1px solid var(--line);border-radius:10px;padding:14px}
.card .lbl{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;font-weight:700}
.card .big{font-size:24px;font-weight:800;color:var(--text);margin-top:4px;line-height:1.1}
.card .sub{font-size:11px;color:var(--muted);margin-top:4px}
.card.green{border-color:var(--green);background:linear-gradient(180deg,var(--green-bg),var(--panel-2))}
.card.red{border-color:var(--red);background:linear-gradient(180deg,var(--red-bg),var(--panel-2))}
.card.yellow{border-color:var(--yellow);background:linear-gradient(180deg,var(--yellow-bg),var(--panel-2))}
.card.blue{border-color:var(--blue);background:linear-gradient(180deg,var(--blue-bg),var(--panel-2))}
.card.purple{border-color:var(--purple);background:linear-gradient(180deg,var(--purple-bg),var(--panel-2))}
.card.green .big{color:#4ade80}.card.red .big{color:#f87171}.card.yellow .big{color:#fbbf24}.card.blue .big{color:#7cb9f5}.card.purple .big{color:#c084fc}

.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th{text-align:left;padding:8px 10px;font-size:10px;color:var(--dim);text-transform:uppercase;letter-spacing:.5px;border-bottom:1px solid var(--line);font-weight:700}
.tbl td{padding:9px 10px;border-bottom:1px solid #1a1a1a;color:var(--text)}
.tbl tr:hover td{background:var(--bg-hover)}
.tbl a{color:var(--blue);text-decoration:none;font-weight:600}
.tbl a:hover{text-decoration:underline}

.row-act{display:flex;gap:5px;flex-wrap:wrap}
.btn-mini{display:inline-flex;align-items:center;gap:3px;padding:3px 8px;border-radius:5px;font-size:10px;font-weight:700;text-decoration:none;border:1px solid;cursor:pointer;background:transparent}
.btn-mini.wati{color:#25D366;border-color:#25D366}
.btn-mini.crm{color:var(--blue);border-color:var(--blue)}
.btn-mini.goto{color:var(--purple);border-color:var(--purple)}
.btn-mini.alert{color:var(--red);border-color:var(--red)}
.btn-mini:hover{background:rgba(255,255,255,.06)}

.feed-item{display:flex;gap:12px;padding:12px;border-radius:8px;margin-bottom:8px;border-left:3px solid var(--line);background:var(--bg-card);align-items:flex-start}
.feed-item.crit{border-left-color:var(--red);background:linear-gradient(90deg,rgba(239,68,68,.08),var(--bg-card))}
.feed-item.warn{border-left-color:var(--yellow);background:linear-gradient(90deg,rgba(234,179,8,.08),var(--bg-card))}
.feed-item.info{border-left-color:var(--blue);background:linear-gradient(90deg,rgba(91,163,245,.08),var(--bg-card))}
.feed-item.opp{border-left-color:var(--green);background:linear-gradient(90deg,rgba(34,197,94,.08),var(--bg-card))}
.feed-item .icon{font-size:18px}
.feed-item .body{flex:1;min-width:0}
.feed-item .title{color:var(--text);font-weight:700;font-size:13px;margin-bottom:3px}
.feed-item .meta{color:var(--muted);font-size:11px;margin-bottom:6px}
.feed-item .impact{color:#fbbf24;font-weight:700;font-size:12px;margin-bottom:6px}
.feed-item .acts{display:flex;gap:6px;flex-wrap:wrap}

.disc-bar{display:inline-block;width:60px;height:6px;background:#222;border-radius:3px;overflow:hidden;vertical-align:middle;margin-left:6px}
.disc-bar > span{display:block;height:100%}

.status-pill{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;text-transform:uppercase}
.status-pill.green{background:rgba(34,197,94,.18);color:#4ade80}
.status-pill.yellow{background:rgba(234,179,8,.18);color:#fbbf24}
.status-pill.red{background:rgba(239,68,68,.18);color:#f87171}

.proj-bar{height:14px;background:#222;border-radius:7px;overflow:hidden;margin:8px 0;position:relative}
.proj-bar > .fill{height:100%;border-radius:7px;transition:width .4s}
.proj-bar > .target{position:absolute;top:-2px;height:18px;width:2px;background:#fff;left:100%}

.empty{padding:20px;text-align:center;color:var(--muted);font-size:13px}
.empty.good{color:#4ade80}

.coach-box{background:linear-gradient(180deg,rgba(167,113,247,.06),var(--bg-card));border:1px solid var(--purple);border-radius:10px;padding:18px;font-size:13px;line-height:1.7;color:var(--txt);white-space:pre-wrap;min-height:100px}
.coach-box h3{color:#c084fc;font-size:13px;margin:14px 0 6px;font-weight:800;text-transform:uppercase;letter-spacing:.3px}
.coach-box strong{color:var(--text)}

.toast{position:fixed;bottom:24px;right:24px;background:var(--bg-hover);border:1px solid var(--green);color:#4ade80;padding:14px 20px;border-radius:10px;font-size:13px;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,.5);z-index:200;animation:slideIn .25s}
.toast.err{border-color:var(--red);color:#f87171}
@keyframes slideIn{from{transform:translateY(20px);opacity:0}to{transform:translateY(0);opacity:1}}

/* Núbia a Loucaaa das Vendas — modo alerta extremo */
.nubia-louca{
  background:linear-gradient(135deg,#ef4444,#f97316,#ef4444) !important;
  background-size:200% 200% !important;
  color:#fff !important;
  border:2px solid #fff !important;
  font-weight:900 !important;
  letter-spacing:.4px !important;
  animation:nubiaLouca 1.2s infinite, gradient 2s ease infinite !important;
  text-shadow:0 0 8px rgba(255,255,255,.4) !important;
  box-shadow:0 0 16px rgba(239,68,68,.6) !important;
}
@keyframes nubiaLouca{
  0%,100%{transform:scale(1)}
  50%{transform:scale(1.04)}
}
@keyframes gradient{
  0%,100%{background-position:0% 50%}
  50%{background-position:100% 50%}
}

/* Modo Guerra */
body.guerra .tc-header{background:linear-gradient(135deg,#1a0a0a,#2a0e0e);border-bottom-color:var(--red)}
body.guerra .tc-block.guerra-hide{display:none}
body.guerra .tc-globals{background:#1a0e0e;border-bottom-color:var(--red)}
body.guerra .tc-block{border-color:#3a1f23}

/* Loading */
.skeleton{background:linear-gradient(90deg,var(--bg-hover),#222,var(--bg-hover));background-size:200% 100%;animation:shimmer 1.4s infinite;border-radius:6px;height:14px;margin:6px 0}
@keyframes shimmer{0%{background-position:-200% 0}100%{background-position:200% 0}}

/* Pipeline Drawer */
.card.clickable{cursor:pointer;transition:transform .12s ease, box-shadow .12s ease}
.card.clickable:hover{transform:translateY(-2px);box-shadow:0 4px 18px rgba(124,185,245,.18);filter:brightness(1.08)}
#pipe-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9000;opacity:0;pointer-events:none;transition:opacity .18s ease}
#pipe-overlay.open{opacity:1;pointer-events:auto}
#pipe-drawer{position:fixed;top:0;right:0;height:100vh;width:min(900px,92vw);background:var(--bg-card);border-left:1px solid var(--border);z-index:9001;transform:translateX(100%);transition:transform .22s ease;display:flex;flex-direction:column}
#pipe-drawer.open{transform:translateX(0)}
#pipe-drawer .pd-head{padding:14px 18px;border-bottom:1px solid #1a1a1a;display:flex;align-items:flex-start;gap:14px}
#pipe-drawer .pd-title{flex:1;color:var(--text);font-size:15px;font-weight:800}
#pipe-drawer .pd-stats{color:var(--text-muted);font-size:11px;margin-top:4px}
#pipe-drawer .pd-close{background:#222;color:#ddd;border:1px solid var(--border);border-radius:6px;width:30px;height:30px;cursor:pointer;font-size:14px}
#pipe-drawer .pd-close:hover{background:#333;color:#fff}
#pipe-drawer .pd-body{flex:1;overflow:auto;padding:0 18px 18px}
</style>

<!-- HEADER FIXO -->
<div class="tc-header">
  <div class="tc-hrow">
    <div class="tc-title"><span class="dot"></span>TORRE DE COMANDO</div>
    <div class="tc-kpi green"><div class="k-l">Faturamento Hoje</div><div class="k-v" id="h-fat">--</div></div>
    <div class="tc-kpi blue"><div class="k-l">Meta do Dia</div><div class="k-v" id="h-meta">--</div></div>
    <div class="tc-kpi red"><div class="k-l">Gap</div><div class="k-v" id="h-gap">--</div></div>
    <div class="tc-status" id="h-status">--</div>
    <div class="tc-clock" id="h-clock">--:--</div>
    <button class="tc-btn danger" id="btn-guerra" onclick="toggleGuerra()">⚔️ Modo Guerra</button>
    <button class="tc-btn" onclick="reloadAll()">🔄 Atualizar</button>
    <button class="tc-btn info" onclick="showHelp()" title="Ajuda — o que cada coisa faz">❓ Ajuda</button>
  </div>
</div>

<!-- MODAL PERÍODO CUSTOMIZADO (Núbia) -->
<div id="tc-periodo" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:300;overflow-y:auto;padding:30px 20px" onclick="if(event.target===this)fecharModalPeriodo()">
  <div style="max-width:560px;margin:40px auto;background:var(--bg-card);border:2px solid #f97316;border-radius:14px;padding:26px 28px;color:var(--txt)">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:16px">
      <h2 style="font-size:18px;color:var(--text);margin:0;flex:1">📅 Núbia em Período Customizado</h2>
      <button class="tc-btn" onclick="fecharModalPeriodo()">✕</button>
    </div>
    <p style="font-size:12px;color:var(--muted);margin:0 0 16px">Escolha a janela de <strong>última atividade</strong> dos leads. Sempre exclui leads em Proposta.</p>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:14px">
      <div>
        <label style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;display:block;margin-bottom:4px">De (data inicial)</label>
        <input type="date" id="periodo-inicio" style="width:100%;padding:10px;background:var(--bg-hover);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:14px">
      </div>
      <div>
        <label style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;display:block;margin-bottom:4px">Até (data final)</label>
        <input type="date" id="periodo-fim" style="width:100%;padding:10px;background:var(--bg-hover);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:14px">
      </div>
    </div>

    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px">
      <button class="tc-btn" onclick="setPeriodo(0,7)">Últimos 7 dias</button>
      <button class="tc-btn" onclick="setPeriodo(7,30)">7-30 dias atrás</button>
      <button class="tc-btn" onclick="setPeriodo(30,60)">30-60 dias atrás</button>
      <button class="tc-btn" onclick="setPeriodo(60,90)">60-90 dias atrás</button>
    </div>

    <div style="margin-bottom:14px">
      <label style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;display:block;margin-bottom:6px">Tiers (quais leads)</label>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <label style="display:flex;align-items:center;gap:4px;padding:6px 12px;background:var(--bg-hover);border:1px solid #a371f7;border-radius:6px;cursor:pointer"><input type="checkbox" class="tier-cb" value="Diamante" checked> 💎 Diamante</label>
        <label style="display:flex;align-items:center;gap:4px;padding:6px 12px;background:var(--bg-hover);border:1px solid #f0c040;border-radius:6px;cursor:pointer"><input type="checkbox" class="tier-cb" value="Ouro" checked> 🥇 Ouro</label>
        <label style="display:flex;align-items:center;gap:4px;padding:6px 12px;background:var(--bg-hover);border:1px solid #9ca3af;border-radius:6px;cursor:pointer"><input type="checkbox" class="tier-cb" value="Prata" checked> 🥈 Prata</label>
        <label style="display:flex;align-items:center;gap:4px;padding:6px 12px;background:var(--bg-hover);border:1px solid #b45309;border-radius:6px;cursor:pointer"><input type="checkbox" class="tier-cb" value="Bronze"> 🥉 Bronze</label>
      </div>
    </div>

    <div style="margin-bottom:14px">
      <label style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;display:block;margin-bottom:6px">Limite de disparo</label>
      <select id="periodo-limite" style="width:100%;padding:10px;background:var(--bg-hover);border:1px solid var(--border);border-radius:6px;color:var(--text);font-size:14px">
        <option value="10">10 leads (teste)</option>
        <option value="30" selected>30 leads (recomendado)</option>
        <option value="50">50 leads</option>
        <option value="100">100 leads (máximo)</option>
      </select>
    </div>

    <div id="periodo-preview" style="background:#0d1f3a;border:1px solid #1e3a5f;border-radius:8px;padding:12px;margin-bottom:14px;font-size:12px;color:#7cb9f5;display:none"></div>

    <div style="display:flex;gap:10px;justify-content:flex-end">
      <button class="tc-btn" onclick="fecharModalPeriodo()">Cancelar</button>
      <button class="tc-btn info" id="btn-preview" onclick="previewPeriodo()">🔍 Pré-visualizar</button>
      <button class="tc-btn danger" id="btn-disparar" onclick="dispararPeriodo()" disabled>🚀 Disparar Núbia</button>
    </div>
  </div>
</div>

<!-- MODAL DETALHE DE CANAL (drill-down por produto + vendas convertidas) -->
<div id="tc-canal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:300;overflow-y:auto;padding:30px 20px" onclick="if(event.target===this)fecharCanalDetalhe()">
  <div style="max-width:1000px;margin:30px auto;background:var(--bg-card);border:2px solid #5ba3f5;border-radius:14px;padding:24px 28px;color:var(--txt)">
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:14px">
      <h2 style="font-size:20px;color:var(--text);margin:0;flex:1" id="canal-titulo">📊 Detalhe do Canal</h2>
      <button class="tc-btn" onclick="fecharCanalDetalhe()">✕ Fechar</button>
    </div>

    <div id="canal-stats" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:18px"></div>

    <div class="g-section" style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;letter-spacing:.5px;margin:6px 0 10px">📦 Produtos · Pipeline (proposta) vs Vendas Fechadas</div>
    <div id="canal-produtos" style="margin-bottom:14px">
      <div class="empty">Carregando produtos...</div>
    </div>
  </div>
</div>

<!-- HELP MODAL -->
<div id="tc-help" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:300;overflow-y:auto;padding:30px 20px" onclick="if(event.target===this)hideHelp()">
  <div style="max-width:900px;margin:0 auto;background:var(--bg-card);border:1px solid var(--line);border-radius:14px;padding:30px 32px;color:var(--txt)">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:18px">
      <h2 style="font-size:20px;color:var(--text);margin:0;flex:1">🎯 Como usar a Torre de Comando</h2>
      <button class="tc-btn" onclick="hideHelp()">✕ Fechar</button>
    </div>
    <div style="font-size:13px;line-height:1.7;color:var(--text)">

      <h3 style="color:var(--blue);font-size:14px;margin:18px 0 8px;text-transform:uppercase">⚔️ Modo Guerra</h3>
      <p>Modo de foco total em conversão imediata. Quando ativado:</p>
      <ul style="margin:6px 0 6px 20px">
        <li><strong>Esconde:</strong> Bloco 4 (Time), Bloco 5 (Erros do Dia), Bloco 7 (Pipeline) — métricas de gestão</li>
        <li><strong>Mantém:</strong> Bloco 1 (Dinheiro Hoje), Bloco 2 (Diretor IA), Bloco 3 (Faça Isso Agora), Bloco 6 (Oportunidades), Bloco 8 (Meta) — só o que gera venda</li>
        <li><strong>Header fica vermelho pulsante</strong> — sinal visual pro time</li>
      </ul>
      <p style="color:var(--muted)"><em>Quando usar: última hora do dia, semana fechando abaixo da meta, ou quando está acumulando R$ em propostas paradas.</em></p>

      <h3 style="color:var(--green);font-size:14px;margin:18px 0 8px;text-transform:uppercase">🤖 Núbia Reengaja</h3>
      <p>Dispara a Núbia (SDR IA) pra reengajar leads via WhatsApp <strong>quando o closer não atender</strong>. 7 modos:</p>
      <ul style="margin:6px 0 6px 20px">
        <li><strong>Sem Contato</strong> — leads em Primeiro Contato/Etapa IA criados há 2-168h sem ação</li>
        <li><strong>🌡️ Lead Morno</strong> — ativos NÃO em Proposta, parados 24-72h (janela WATI ainda viva)</li>
        <li><strong>🎯 Fora de Proposta</strong> — todos ativos fora de Proposta, parados 24h-30d</li>
        <li><strong>🔥 Modo Hardcore (Proposta Fria)</strong> — propostas paradas &gt;24h, top 30 por valor</li>
        <li><strong>Lead Atenção</strong> — Diamante/Ouro em estágio inicial parado &gt;2h</li>
        <li><strong>📅 Período Customizado</strong> — você escolhe a janela de datas, tiers e limite (10/30/50/100). Sempre exclui Proposta. Tem preview antes de disparar.</li>
        <li><strong>Manual</strong> — IDs específicos clicando no 🤖 da linha do deal</li>
      </ul>
      <p style="color:var(--muted)"><em>A Núbia recebe os leads via POST e dispara a sequência de outreach configurada no serviço Python (Railway).</em></p>

      <h3 style="color:var(--red);font-size:14px;margin:18px 0 8px;text-transform:uppercase">🔥 Núbia a Loucaaa das Vendas</h3>
      <p>Quando o risco da meta é alto (projeção &lt;80% da meta, ou após 15h sem cobrir o gap), os botões da Núbia entram em modo agressivo:</p>
      <ul style="margin:6px 0 6px 20px">
        <li>Cor vermelho/laranja pulsante</li>
        <li>Label muda pra "🔥🔥 NÚBIA A LOOUCAAAA DAS VENDAS 🔥🔥"</li>
        <li>Sinaliza visualmente que é hora de fazer barulho na base</li>
      </ul>

      <h3 style="color:var(--blue);font-size:14px;margin:18px 0 8px;text-transform:uppercase">📋 Quadro de Tarefas (FAB flutuante)</h3>
      <p>O botão flutuante "📋 Tarefas (X)" no canto inferior direito aparece em todas as páginas pros closers. Mostra:</p>
      <ul style="margin:6px 0 6px 20px">
        <li>Tasks pendentes geradas pelas cobranças do admin</li>
        <li>Botão "✓ Concluir" — quando clicado, notifica o Paulo via Z-API com tempo de execução</li>
        <li>Pulsa vermelho quando tem pendentes</li>
        <li>Refresh automático a cada 60s</li>
      </ul>
      <p style="color:var(--muted)"><em>Quando você cobra um closer, ele recebe a mensagem Z-API <strong>e</strong> uma task aparece no FAB dele.</em></p>

      <h3 style="color:var(--purple);font-size:14px;margin:18px 0 8px;text-transform:uppercase">📊 Score 80/20 (0-100)</h3>
      <p>Score de disciplina por closer baseado em 6 dimensões da spec metricas-8020:</p>
      <ul style="margin:6px 0 6px 20px">
        <li><strong>20pts</strong> SLA primeiro contato (% leads novos contatados)</li>
        <li><strong>20pts</strong> Volume ligações (GoTo outbound real, fallback atividades Zoho)</li>
        <li><strong>20pts</strong> Follow-up propostas (% propostas com atividade &lt;24h)</li>
        <li><strong>15pts</strong> CRM completo (Cidade + Tipo de Água preenchidos)</li>
        <li><strong>15pts</strong> Atividades reais (penaliza deals parados &gt;48h)</li>
        <li><strong>10pts</strong> WATI (placeholder — sem integração ainda)</li>
      </ul>
      <p>Hover na coluna Disc. da tabela do Bloco 4 mostra o detalhe de cada dimensão.</p>

      <h3 style="color:var(--yellow);font-size:14px;margin:18px 0 8px;text-transform:uppercase">🎯 Metas Diárias</h3>
      <ul style="margin:6px 0 6px 20px">
        <li><strong>Lig.</strong> = ligações outbound hoje (meta 25, alerta &lt;15)</li>
        <li><strong>PC</strong> = primeiro contato &lt;5min de criação (meta 100% dos leads novos)</li>
        <li><strong>F-Up</strong> = propostas com follow-up em dia (meta 100%, &lt;24h sem atividade)</li>
      </ul>

      <h3 style="color:var(--red);font-size:14px;margin:18px 0 8px;text-transform:uppercase">🚦 Indicadores de Risco — Bloco 1</h3>
      <ul style="margin:6px 0 6px 20px">
        <li><span class="status-pill green">verde</span> &lt;2h — proposta quente, agir agora</li>
        <li><span class="status-pill yellow">amarelo</span> 2-4h — esfriando, follow-up urgente</li>
        <li><span class="status-pill red">vermelho</span> &gt;4h — perdendo, ligar imediatamente</li>
      </ul>

      <h3 style="color:var(--text);font-size:14px;margin:18px 0 8px;text-transform:uppercase">📋 Botões Globais (header)</h3>
      <ul style="margin:6px 0 6px 20px">
        <li><strong>🚨 Auto-Alertas</strong> — varre operação e dispara Z-API pros closers fora do padrão</li>
        <li><strong>📋 Plano do Dia</strong> — envia o relatório consolidado do dia no seu WhatsApp</li>
        <li><strong>⚡ Correção Completa</strong> — alerta closers + reativa frios via Núbia em uma jogada</li>
        <li><strong>👁️ Leads sem Contato</strong> — scroll/foco no bloco 3 (top ações)</li>
        <li><strong>💰 Propostas &gt;R$5k</strong> — scroll no bloco 1 (dinheiro)</li>
        <li><strong>📊 Enviar Ranking</strong> — manda ranking parcial no seu Z-API</li>
      </ul>

      <h3 style="color:var(--text);font-size:14px;margin:18px 0 8px;text-transform:uppercase">🧱 Os 9 Blocos</h3>
      <ol style="margin:6px 0 6px 20px;padding-left:14px">
        <li><strong>Dinheiro Hoje</strong> — propostas a fechar, com canal, nível, risco e ação sugerida</li>
        <li><strong>Diretor IA</strong> — feed dinâmico de problemas detectados (com botões de ação)</li>
        <li><strong>Faça Isso Agora</strong> — top 10 ações urgentes ranqueadas</li>
        <li><strong>Time em Tempo Real</strong> — closers + metas diárias + score 80/20</li>
        <li><strong>Erros do Dia</strong> — red flags consolidadas (sem contato, sem follow-up, etc.)</li>
        <li><strong>Oportunidades Quentes</strong> — Diamantes novos, indicações, leads recém-qualificados</li>
        <li><strong>Pipeline Inteligente</strong> — alta/média/baixa probabilidade + previsão ponderada</li>
        <li><strong>Projeção de Meta</strong> — pipeline ponderado cobre o gap?</li>
        <li><strong>Coach do Dono</strong> — análise estratégica via Claude (sob demanda)</li>
      </ol>

      <h3 style="color:var(--green);font-size:14px;margin:18px 0 8px;text-transform:uppercase">📞 Taxa de Conversão (Rei do Mês / Cockpit)</h3>
      <p>Calculada como <code>vendas Prata+/Ouro/Diamante / total qualificados recebidos no mês</code>. O denominador inclui ativos qualificados + ganhos qualificados + perdidos qualificados — janelas iguais, sem inflar.</p>


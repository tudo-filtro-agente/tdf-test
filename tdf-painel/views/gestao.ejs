</div>

<script>
// ============= STATE =============
let DATA = null;       // /gestao/data
let GUERRA = null;     // /gestao/guerra
let DISCIPLINA = null; // /gestao/disciplina (map crmOwner -> score)
let IA_STATUS = null;  // /gestao/ia-status
let GUERRA_MODE = false;

// ============= UTILS =============
const fmtR$ = v => 'R$ ' + (Math.round(v||0)/1000).toFixed(1) + 'k';
const fmtR$Full = v => 'R$ ' + Math.round(v||0).toLocaleString('pt-BR');
const hrs = h => h<1?'agora':h<24?Math.round(h)+'h':Math.round(h/24)+'d';
const wpp = phone => phone ? 'https://live-2708.wati.io/2708/teamInbox/'+String(phone).replace(/\D/g,'') : '#';

function tickClock(){
  const d = new Date();
  const hh = String(d.getHours()).padStart(2,'0');
  const mm = String(d.getMinutes()).padStart(2,'0');
  const ss = String(d.getSeconds()).padStart(2,'0');
  document.getElementById('h-clock').textContent = `${hh}:${mm}:${ss}`;
}
setInterval(tickClock,1000); tickClock();

function toast(msg, isErr){
  const t = document.createElement('div');
  t.className = 'toast' + (isErr?' err':'');
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(()=>t.remove(), 4000);
}

// ============= HEADER =============
function renderHeader(){
  if(!DATA || !GUERRA) return;
  const fatHoje = DATA.global.fatHoje || 0;
  const sim = GUERRA.simulacao || {};
  // Meta do dia: necessário/dia da simulação OU meta mensal / dias úteis
  const metaDia = sim.necessarioDia || (sim.metaGlobal && sim.diasUteis ? sim.metaGlobal/sim.diasUteis : 0);
  const gap = Math.max(0, metaDia - fatHoje);
  document.getElementById('h-fat').textContent = fmtR$(fatHoje);
  document.getElementById('h-meta').textContent = fmtR$(metaDia);
  document.getElementById('h-gap').textContent = fmtR$(gap);

  // Status: baseado na projeção mensal vs meta global
  const projPct = sim.metaGlobal ? (sim.projecao / sim.metaGlobal) : 0;
  const st = document.getElementById('h-status');
  if(projPct >= 1){ st.textContent = '✓ NO RITMO'; st.className = 'tc-status green'; }
  else if(projPct >= 0.7){ st.textContent = '! ATENÇÃO'; st.className = 'tc-status yellow'; }
  else { st.textContent = '⚠ RISCO'; st.className = 'tc-status red'; }
}

// ============= BLOCO 1 — DINHEIRO HOJE =============
const CANAL_COLOR = {
  'Google':'#4285F4','Facebook':'#1877F2','Instagram':'#E1306C','WhatsApp':'#25D366',
  'Indicação':'#F0C040','Loja':'#a371f7','Orgânico':'#22c55e','Outros':'#6b7280'
};

function renderBloco1(){
  if(!GUERRA) return;
  const din = GUERRA.dinheiro || {};
  const altas = GUERRA.propostasAltas || [];
  const sim = GUERRA.simulacao || {};
  const metaDia = sim.necessarioDia || (sim.metaGlobal && sim.diasUteis ? sim.metaGlobal/sim.diasUteis : 0);

  // Núbia em modo crítico? (risco alto OU >70% do gap não coberto OU horário >15h e baixa cobertura)
  const hr = new Date().getHours();
  const cobre = (din.previsaoPonderada||0) >= (sim.gap||0);
  const nubiaModo = (sim.risco === 'alto' || (!cobre && hr >= 15)) ? 'looucaa' : 'normal';

  // Aplica visual "Núbia a Loucaaa" nos 3 botões principais quando risco alto
  const hardBtn = document.getElementById('btn-nubia-hardcore');
  const foraBtn = document.getElementById('btn-nubia-fora');
  const baseBtn = document.getElementById('btn-nubia-base');
  if (nubiaModo === 'looucaa') {
    if (hardBtn) { hardBtn.classList.add('nubia-louca'); hardBtn.textContent = '🔥🔥 NÚBIA A LOOUCAAAA — PROPOSTAS FRIAS 🔥🔥'; }
    if (foraBtn) { foraBtn.classList.add('nubia-louca'); foraBtn.textContent = '🔥 NÚBIA LOUCAAA — FORA DE PROPOSTA 🔥'; }
    if (baseBtn) { baseBtn.classList.add('nubia-louca'); baseBtn.textContent = '🔥 NÚBIA LOUCAAA NA BASE INTEIRA 🔥'; }
  } else {
    if (hardBtn) { hardBtn.classList.remove('nubia-louca'); hardBtn.textContent = '🔥 Núbia Hardcore — Propostas Frias'; }
    if (foraBtn) { foraBtn.classList.remove('nubia-louca'); foraBtn.textContent = '🎯 Núbia em Leads Fora de Proposta'; }
    if (baseBtn) { baseBtn.classList.remove('nubia-louca'); baseBtn.textContent = '🤖 Soltar Núbia na Base (24h–30d)'; }
  }

  // Cards de prioridade
  document.getElementById('b1-cards').innerHTML = `
    <div class="card green"><div class="lbl">🔥 Fechamento Previsto Hoje</div><div class="big">${fmtR$(din.previsaoAlta||0)}</div><div class="sub">${din.quente?.count||0} propostas alta prob</div></div>
    <div class="card yellow"><div class="lbl">⏳ Quente / Em Negociação</div><div class="big">${fmtR$(din.quente?.valor||0)}</div><div class="sub">${din.quente?.count||0} propostas atividade &lt;24h</div></div>
    <div class="card red"><div class="lbl">⚠️ Sem Follow-up &gt;24h</div><div class="big">${fmtR$(din.semFollowup||0)}</div><div class="sub">parado, esfriando</div></div>
    <div class="card red"><div class="lbl">❄️ Frio — Perdendo Valor</div><div class="big">${fmtR$(din.frio?.valor||0)}</div><div class="sub">${din.frio?.count||0} propostas sem resposta</div></div>
  `;

  // Faturamento potencial por canal — cards CLICÁVEIS pra drill-down por produto
  const canais = GUERRA.propostasPorCanal || [];
  document.getElementById('b1-canais').innerHTML = canais.length
    ? canais.map(c => {
        const col = CANAL_COLOR[c.canal] || '#6b7280';
        return `<div onclick="abrirCanalDetalhe('${c.canal}')" style="background:#101010;border:1px solid ${col};border-left:4px solid ${col};border-radius:8px;padding:10px 14px;min-width:140px;cursor:pointer;transition:all .15s" onmouseover="this.style.transform='translateY(-2px)';this.style.boxShadow='0 4px 12px rgba(0,0,0,.4)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
          <div style="font-size:11px;color:${col};font-weight:700;text-transform:uppercase;letter-spacing:.5px;display:flex;align-items:center;gap:4px">${c.canal} <span style="margin-left:auto;font-size:10px;opacity:.7">▸</span></div>
          <div style="font-size:18px;font-weight:800;color:#fff">${fmtR$(c.valor)}</div>
          <div style="font-size:11px;color:var(--muted)">${c.count} propostas · clique pra detalhar</div>
        </div>`;
      }).join('')
    : '<div class="empty" style="padding:8px">Sem propostas categorizadas por canal</div>';

  // Tabela detalhada
  const top = [...altas].sort((a,b)=>(b.valor||0)-(a.valor||0)).slice(0,20);
  if(!top.length){
    document.getElementById('b1-body').innerHTML = '<tr><td colspan="10" class="empty good">Nenhuma proposta crítica</td></tr>';
  } else {
    // Cor por estágio (proposta quente=verde, fria=vermelho, neutra=cinza)
    const stageCor = (s) => {
      if (/Quente/i.test(s)) return '#22c55e';
      if (/Fria/i.test(s)) return '#ef4444';
      if (/Em Atendimento/i.test(s)) return '#5ba3f5';
      return '#9ca3af';
    };
    document.getElementById('b1-body').innerHTML = top.map(d=>{
      const pctMeta = metaDia > 0 ? Math.round((d.valor / metaDia) * 100) : 0;
      const acaoIcon = { 'ligar agora':'📞', 'follow-up':'💬', 'fechamento':'🤝', 'enviar proposta':'📤' }[d.acaoSugerida] || '⚡';
      const canalCol = CANAL_COLOR[d.canal] || '#6b7280';
      const sCor = stageCor(d.stage||'');
      return `<tr>
        <td><a href="${d.crmLink||'#'}" target="_blank">${d.name||'?'}</a> <span style="color:var(--dim);font-size:11px">${d.tier||''}</span></td>
        <td><span style="color:${canalCol};font-weight:700">${d.canal}</span></td>
        <td><span style="color:${sCor};font-weight:600;font-size:12px">${d.stage||'-'}</span></td>
        <td style="font-weight:700;color:#fff">
          ${fmtR$Full(d.valor)}
          <div class="b1-prod" data-deal="${d.id||''}" style="font-size:10px;color:var(--muted);font-weight:500;font-style:italic;margin-top:2px;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="">…produtos</div>
        </td>
        <td><span class="status-pill ${d.risco}">${hrs(d.hoursAgo)}</span></td>
        <td><span class="status-pill ${d.nivel==='Alta'?'green':d.nivel==='Média'?'yellow':'red'}">${d.nivel}</span></td>
        <td style="font-weight:700;color:${pctMeta>=50?'#4ade80':pctMeta>=20?'#fbbf24':'#9ca3af'}">${pctMeta}%</td>
        <td>${d.owner||'?'}</td>
        <td title="ação recomendada para esta proposta">${acaoIcon} ${d.acaoSugerida}</td>
        <td><div class="row-act">
          ${d.phone?`<a class="btn-mini wati" href="${wpp(d.phone)}" target="_blank">WATI</a>`:''}
          <a class="btn-mini crm" href="${d.crmLink||'#'}" target="_blank">CRM</a>
          <button class="btn-mini alert" title="Núbia reengaja este lead" onclick="nubiaReengajaDeals(['${d.id||''}'],'manual')">🤖</button>
        </div></td>
      </tr>`;
    }).join('');

    // Lazy-load produtos via Quoted_Items
    const dealIds = top.map(d => d.id).filter(Boolean);
    if (dealIds.length) carregarProdutosBloco1(dealIds);
  }

  // Ranking valor parado
  const rk = GUERRA.rankingValorParado || [];
  document.getElementById('b1-ranking').innerHTML = rk.length === 0
    ? '<div class="empty good">✓ Nenhum vendedor com valor significativo parado</div>'
    : `<div style="display:flex;flex-direction:column;gap:6px">${rk.slice(0,10).map((v,i)=>{
        const col = i===0?'#ef4444':i===1?'#f97316':'#eab308';
        return `<div style="display:flex;align-items:center;gap:10px;padding:8px 12px;background:#101010;border:1px solid var(--line);border-radius:8px">
          <div style="width:24px;height:24px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:${col};color:#000;font-weight:800;font-size:11px">${i+1}</div>
          <div style="flex:1;font-weight:600;color:#fff">${v.owner}</div>
          <div style="color:var(--muted);font-size:12px">${v.count} propostas</div>
          <div style="font-weight:800;color:${col}">${fmtR$(v.valor)}</div>
          <button class="btn-mini alert" onclick="sendAlert('${v.owner}','proposta_parada',{count:${v.count},valor:${Math.round(v.valor)}})" title="Cobrar via Z-API">📢 Cobrar</button>
          <button class="btn-mini alert" onclick="nubiaReengajaDeals(${JSON.stringify(v.dealIds||[]).replace(/"/g,'&quot;')},'manual')" title="Núbia reengaja todas">🤖 Núbia</button>
        </div>`;
      }).join('')}</div>`;
}

// Lazy-load produtos das linhas do Bloco 1 (Quoted_Items)
async function carregarProdutosBloco1(dealIds){
  for (let i = 0; i < dealIds.length; i += 30) {
    const lote = dealIds.slice(i, i+30);
    try {
      const res = await fetch('/gestao/deal-products', {
        method:'POST', headers:{'Content-Type':'application/json'},
        body: JSON.stringify({ dealIds: lote })
      });
      const d = await res.json();
      if (d.error) continue;
      for (const id of Object.keys(d.products||{})) {
        const cell = document.querySelector(`.b1-prod[data-deal="${id}"]`);
        if (!cell) continue;
        const items = d.products[id] || [];
        if (!items.length) { cell.textContent = '— sem produto cadastrado —'; continue; }
        const top = items.sort((a,b)=>(b.valor||0)-(a.valor||0))[0];
        const extra = items.length > 1 ? ` +${items.length-1}` : '';
        cell.textContent = top.nome + extra;
        cell.title = items.map(it => `${it.qtd}x ${it.nome} — R$ ${(it.valor||0).toLocaleString('pt-BR')}`).join('\n');
      }
    } catch(e){ console.warn('produtos b1:', e); }
  }
}

// Ações rápidas do Bloco 1
const NUBIA_LABELS = {
  sem_contato: 'Leads sem primeiro contato',
  proposta_fria: 'Propostas paradas >24h (modo hardcore)',
  lead_atencao: 'Diamante/Ouro inicial parado >2h',
  lead_morno: 'Mornos: ativos fora de Proposta, 24-72h',
  fora_proposta: 'TODOS leads ativos fora de Proposta (24h-30d)',
  reengajar_base: 'Toda a base elegível (24h-30d)',
};

// Preview: conta candidatos antes de disparar e pede confirmação detalhada
async function nubiaReengajaConfirma(tipo, btn){
  const labelOriginal = btn?.textContent;
  if (btn) { btn.disabled = true; btn.textContent = 'Calculando candidatos...'; }
  try {
    const res = await fetch('/gestao/nubia-preview?tipo=' + encodeURIComponent(tipo));
    const p = await res.json();
    if (p.error) { toast('Erro preview: '+p.error, true); return; }

    if (p.total === 0) {
      toast('Nenhum candidato pra esse modo agora — não tem o que disparar');
      return;
    }

    const tiers = Object.entries(p.porTier||{}).map(([t,n])=>`${t}: ${n}`).join('  ');
    const owners = Object.entries(p.porOwner||{}).slice(0,5).map(([o,n])=>`${o}: ${n}`).join('\n  ');
    const sample = (p.sample||[]).map(s=>`• ${s.name} (${s.tier||'-'}, ${s.stage})`).join('\n');

    const msg =
`🤖 NÚBIA REENGAJA — ${NUBIA_LABELS[tipo]||tipo}

Encontrei ${p.total} lead(s) elegível(is).
Vou disparar para os ${p.atingidos} primeiros (priorizando Diamante/Ouro).

Por tier:
  ${tiers || '(sem tiers)'}

Top 5 vendedores afetados:
  ${owners || '(sem dados)'}

Amostra:
${sample}

Confirma?`;
    if (!confirm(msg)) {
      toast('Cancelado — nenhum disparo enviado');
      return;
    }
    await nubiaReengaja(tipo, btn);
  } catch(e) {
    toast('Erro: '+e.message, true);
  } finally {
    if (btn) { btn.disabled = false; if (labelOriginal) btn.textContent = labelOriginal; }
  }
}

async function nubiaReengaja(tipo, btn){
  if(btn) { btn.disabled=true; btn.textContent='Disparando...'; }
  toast('Núbia reengajando ('+tipo+')...');
  try{
    const res = await fetch('/gestao/nubia-reengaja', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ tipo })
    });
    const r = await res.json();
    if(r.error) toast('Erro: '+r.error, true);
    else toast(`✅ Núbia disparou para ${r.sent||0} leads (${r.candidates||0} candidatos)`);
  }catch(e){ toast('Erro: '+e.message, true); }
}

async function nubiaReengajaDeals(dealIds, tipo){
  if(!dealIds || !dealIds.length || !dealIds[0]) { toast('Nenhum deal selecionado', true); return; }
  toast(`Núbia disparando para ${dealIds.length} lead(s)...`);
  try{
    const res = await fetch('/gestao/nubia-reengaja', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ tipo:tipo||'manual', dealIds })
    });
    const r = await res.json();
    if(r.error) toast('Erro: '+r.error, true);
    else toast(`✓ Núbia disparou para ${r.sent||0} leads`);
  }catch(e){ toast('Erro: '+e.message, true); }
}

function cobrarParados(){
  const rk = GUERRA?.rankingValorParado || [];
  if(!rk.length) { toast('Nenhum vendedor com valor parado'); return; }
  if(!confirm(`Cobrar ${rk.length} vendedor(es) via Z-API?`)) return;
  rk.forEach((v,i) => setTimeout(()=>sendAlert(v.owner,'proposta_parada',{count:v.count,valor:Math.round(v.valor)}), i*1500));
}

function gerarListaLigacao(){
  const altas = GUERRA?.propostasAltas || [];
  if(!altas.length) { toast('Nenhuma proposta'); return; }
  const lista = altas
    .filter(a => a.phone)
    .sort((a,b) => (b.valor||0) - (a.valor||0))
    .map((a,i) => `${i+1}. ${a.name} — R$ ${(a.valor||0).toLocaleString('pt-BR')} — ${a.owner} — ${a.phone} — ${a.acaoSugerida}`)
    .join('\n');
  const w = window.open('', '_blank');
  w.document.write(`<pre style="font-family:monospace;padding:20px;white-space:pre-wrap">${lista}</pre>`);
  toast(`Lista de ${altas.filter(a=>a.phone).length} ligações aberta em nova aba`);
}

function copiarTelefones(){
  const altas = GUERRA?.propostasAltas || [];
  const phones = altas.filter(a => a.phone).map(a => String(a.phone).replace(/\D/g,''));
  if(!phones.length) { toast('Nenhum telefone disponível', true); return; }
  navigator.clipboard.writeText(phones.join('\n'))
    .then(()=>toast(`✓ ${phones.length} telefones copiados`))
    .catch(()=>toast('Erro ao copiar', true));
}

// ============= BLOCO 2 — DIRETOR IA =============
function renderBloco2(){
  if(!DATA || !GUERRA) return;
  const items = [];

  // Lead Google sem contato
  if(GUERRA.googleSemContato > 0){
    items.push({lvl:'crit', icon:'🔴', title:`${GUERRA.googleSemContato} leads do Google sem contato`,
      meta:'CAC alto, lead pago esfriando', impact:'R$ em risco: alto', actions:[
        {t:'Alertar Closers', fn:`runCorrecao('alertar_todos')`},
        {t:'🤖 Núbia Reengaja', fn:`nubiaReengaja('sem_contato')`}
      ]});
  }

  // Sem contato geral
  if((GUERRA.semContato||[]).length > 0){
    const n = GUERRA.semContato.length;
    items.push({lvl:'warn', icon:'⏰', title:`${n} leads de hoje ainda sem contato`,
      meta:'SLA quebrado — primeiro contato &gt;5min', impact:`Cada minuto reduz conversão`,
      actions:[
        {t:'Auto-Alertas', fn:`runAutoAlerts()`},
        {t:'🤖 Núbia Chama', fn:`nubiaReengaja('sem_contato')`}
      ]});
  }

  // Propostas sem follow-up
  if(GUERRA.propostasSemFollowup > 0){
    items.push({lvl:'crit', icon:'💸', title:`${GUERRA.propostasSemFollowup} propostas &gt;R$3k sem follow-up 24h`,
      meta:'Cliente esperando — chance esfriando', impact:`R$ ${(GUERRA.valorSemFollowup/1000).toFixed(0)}k em risco`,
      actions:[{t:'Cobrar Closers', fn:`runCorrecao('alertar_todos')`}]});
  }

  // Tier alto parado
  if(GUERRA.tierAltoParado > 0){
    items.push({lvl:'crit', icon:'💎', title:`${GUERRA.tierAltoParado} Diamantes/Ouros parados`,
      meta:'Lead premium esfriando — alta probabilidade convertível', impact:'Maior LTV em risco',
      actions:[
        {t:'Reativar (frios)', fn:`runCorrecao('reativar_frios')`},
        {t:'🤖 Núbia Reengaja Tier Alto', fn:`nubiaReengaja('lead_atencao')`}
      ]});
  }

  // Closers sem atividade
  (GUERRA.closersSemAtividade||[]).forEach(c=>{
    items.push({lvl:'warn', icon:'😴', title:`${c.name} — ${c.hoursAgo}h sem atividade`,
      meta:'Vendedor inativo no horário comercial', impact:'Time perdendo ritmo',
      actions:[{t:'Cobrar Atividade', fn:`sendAlert('${c.name}','baixa_atividade',{})`}]});
  });

  // Closers sem venda + flags
  Object.values(DATA.closers||{}).forEach(c=>{
    if(c.diamantesParados >= 2){
      items.push({lvl:'crit', icon:'⚠️', title:`${c.name}: ${c.diamantesParados} Diamantes parados`,
        meta:'Não está priorizando lead premium', impact:'Maior dinheiro escapando',
        actions:[{t:'Cobrar Diamantes', fn:`sendAlert('${c.crmOwner}','diamante_parado',{count:${c.diamantesParados},horas:4})`}]});
    }
  });

  if(!items.length){
    document.getElementById('b2-body').innerHTML = '<div class="empty good">✓ Operação rodando bem agora — nenhum problema crítico detectado.</div>';
    return;
  }

  document.getElementById('b2-body').innerHTML = items.map(i=>`
    <div class="feed-item ${i.lvl}">
      <div class="icon">${i.icon}</div>
      <div class="body">
        <div class="title">${i.title}</div>
        <div class="meta">${i.meta}</div>
        <div class="impact">⚡ ${i.impact}</div>
        <div class="acts">${i.actions.map(a=>`<button class="tc-btn ${i.lvl==='crit'?'danger':'warn'}" style="font-size:10px;padding:5px 10px" onclick="${a.fn}">${a.t}</button>`).join('')}</div>
      </div>
    </div>
  `).join('');
}

// ============= BLOCO 3 — FAÇA ISSO AGORA =============
function renderBloco3(){
  if(!DATA || !GUERRA) return;
  const acts = [];

  // Top propostas paradas (alta prob, parada >12h)
  (GUERRA.propostasAltas||[]).filter(p=>p.hoursAgo>12 && p.prob>=40)
    .sort((a,b)=>(parseFloat(b.amount)||0)-(parseFloat(a.amount)||0)).slice(0,5)
    .forEach(p=>{
      const v = parseFloat(p.amount)||0;
      acts.push({
        text:`Cobrar ${p.owner} — proposta ${p.name} ${fmtR$Full(v)} parada ${hrs(p.hoursAgo)}`,
        crm:p.crmLink, phone:p.phone,
        owner:p.owner
      });
    });

  // Closers com diamantes parados
  Object.values(DATA.closers||{}).filter(c=>c.diamantesParados>=2)
    .sort((a,b)=>b.diamantesParados-a.diamantesParados).slice(0,3)
    .forEach(c=>{
      acts.push({
        text:`Cobrar ${c.name} — ${c.diamantesParados} 💎 Diamantes parados`,
        action:{t:'Cobrar', fn:`sendAlert('${c.crmOwner}','diamante_parado',{count:${c.diamantesParados},horas:4})`}
      });
    });

  // Leads sem contato (top 3)
  (GUERRA.semContato||[]).slice(0,3).forEach(l=>{
    acts.push({
      text:`Ligar para ${l.name} — sem contato (${l.source}, vendedor: ${l.owner})`,
      crm:l.crmLink, phone:l.phone, owner:l.owner
    });
  });

  // Closers sem venda
  Object.values(DATA.closers||{}).filter(c=>c.vendas===0)
    .slice(0,2).forEach(c=>{
      acts.push({
        text:`${c.name} ainda sem venda no mês — cobrar`,
        action:{t:'Cobrar', fn:`sendAlert('${c.crmOwner}','sem_venda',{dias:${new Date().getDate()}})`}
      });
    });

  // Metas diárias no vermelho (spec metricas-8020-metas-diarias-spec.md)
  if(DISCIPLINA?.closers){
    DISCIPLINA.closers
      .filter(d => d.metas?.ligacoes?.status === 'red' && d.metas.ligacoes.real < 15)
      .slice(0,3).forEach(d => acts.push({
        text:`${d.name} com ${d.metas.ligacoes.real} atividades hoje (meta 25, alerta <15)`,
        action:{t:'Cobrar Ligações', fn:`sendAlert('${d.crmOwner}','baixa_atividade',{ligacoes:${d.metas.ligacoes.real},meta:25})`}
      }));
    DISCIPLINA.closers
      .filter(d => d.metas?.primeiroContato?.status === 'red')
      .slice(0,3).forEach(d => acts.push({
        text:`${d.name}: ${d.metas.primeiroContato.semContato} leads novos sem primeiro contato`,
        action:{t:'Cobrar Contato', fn:`sendAlert('${d.crmOwner}','lead_sem_contato',{count:${d.metas.primeiroContato.semContato}})`}
      }));
  }

  if(!acts.length){
    document.getElementById('b3-body').innerHTML = '<div class="empty good">✓ Nenhuma ação urgente no momento</div>';
    return;
  }

  document.getElementById('b3-body').innerHTML = acts.slice(0,10).map((a,i)=>`
    <div class="feed-item crit">
      <div class="icon" style="font-weight:800;color:var(--red)">#${i+1}</div>
      <div class="body">
        <div class="title">${a.text}</div>
        <div class="acts">
          ${a.phone?`<a class="btn-mini wati" href="${wpp(a.phone)}" target="_blank">WATI</a>`:''}
          ${a.crm?`<a class="btn-mini crm" href="${a.crm}" target="_blank">CRM</a>`:''}
          ${a.action?`<button class="btn-mini alert" onclick="${a.action.fn}">${a.action.t}</button>`:''}
        </div>
      </div>
    </div>
  `).join('');
}

// ============= BLOCO 4 — TIME EM TEMPO REAL + METAS DIÁRIAS =============
function renderBloco4(){
  if(!DATA) return;
  const closers = Object.values(DATA.closers||{}).sort((a,b)=>b.faturamento-a.faturamento);
  if(!closers.length){
    document.getElementById('b4-body').innerHTML = '<tr><td colspan="10" class="empty">Sem dados</td></tr>';
    return;
  }
  const discMap = {};
  if(DISCIPLINA && DISCIPLINA.closers){
    DISCIPLINA.closers.forEach(d => discMap[d.crmOwner] = d);
  }

  // Cards agregados de metas diárias
  const ag = DISCIPLINA?.agregado;
  if(ag){
    const tot = ag.totalClosers || 1;
    const ligColor = ag.ligacoesAlerta>=3?'red':ag.ligacoesOk===tot?'green':'yellow';
    const pcColor = ag.primeiroContatoAlerta>=2?'red':ag.semContatoTime===0?'green':'yellow';
    const fupColor = ag.followupAlerta>=2?'red':ag.followupOk===tot?'green':'yellow';
    const scoreColor = ag.scoreMedio>=70?'green':ag.scoreMedio>=50?'yellow':'red';
    document.getElementById('b4-cards').innerHTML = `
      <div class="card ${ligColor}">
        <div class="lbl">📞 Ligações Time</div>
        <div class="big">${ag.ligacoesOk}/${tot}</div>
        <div class="sub">closers ≥25 atividades hoje${ag.ligacoesAlerta?` • ${ag.ligacoesAlerta} no vermelho`:''}</div>
      </div>
      <div class="card ${pcColor}">
        <div class="lbl">⏱️ Primeiro Contato</div>
        <div class="big">${ag.semContatoTime===0?'✓':ag.semContatoTime}</div>
        <div class="sub">${ag.semContatoTime===0?'todos contatados':'leads sem contato hoje'}</div>
      </div>
      <div class="card ${fupColor}">
        <div class="lbl">📋 Follow-up Propostas</div>
        <div class="big">${ag.propostasParadasTime===0?'✓':ag.propostasParadasTime}</div>
        <div class="sub">${ag.propostasParadasTime===0?'tudo em dia':'propostas paradas >24h'}</div>
      </div>
      <div class="card ${scoreColor}">
        <div class="lbl">🎯 Score 80/20 Médio</div>
        <div class="big">${ag.scoreMedio}</div>
        <div class="sub">média do time (0-100)</div>
      </div>
    `;
  } else {
    document.getElementById('b4-cards').innerHTML = '<div class="empty">Score 80/20 indisponível (verifique /gestao/disciplina)</div>';
  }

  document.getElementById('b4-body').innerHTML = closers.map(c=>{
    const pct = c.pctMeta||0;
    const d = discMap[c.crmOwner];
    const disc = d ? d.score : 50;
    const discCol = disc>=70?'#22c55e':disc>=40?'#eab308':'#ef4444';
    const userKey = (window._usersMap && window._usersMap[c.crmOwner]) || '';

    // Cells de meta
    const m = d?.metas;
    const ligCell = m ? `<span class="status-pill ${m.ligacoes.status}">${m.ligacoes.real}/${m.ligacoes.meta}</span>` : '—';
    const pcCell = m ? (m.primeiroContato.meta===0
      ? '<span style="color:var(--muted)">—</span>'
      : `<span class="status-pill ${m.primeiroContato.status}">${m.primeiroContato.real}/${m.primeiroContato.meta}</span>`) : '—';
    const fupCell = m ? (m.followup.meta===0
      ? '<span style="color:var(--muted)">—</span>'
      : `<span class="status-pill ${m.followup.status}">${m.followup.real}/${m.followup.meta}</span>`) : '—';

    const tipBreak = d ? Object.entries(d.breakdown).map(([k,v]) =>
      `${k.toUpperCase()}: ${v.pts}/${v.max} — ${v.detail||''}`
    ).join('\n') : 'sem dados';

    // Botões de cobrança específicos por meta vermelha
    const cobrarLig = m?.ligacoes?.status==='red' ? `<button class="btn-mini alert" title="${m.ligacoes.real}/${m.ligacoes.meta} ligações" onclick="sendAlert('${c.crmOwner}','baixa_atividade',{ligacoes:${m.ligacoes.real},meta:${m.ligacoes.meta}})">📞</button>` : '';
    const cobrarPc = m?.primeiroContato?.status==='red' ? `<button class="btn-mini alert" title="${m.primeiroContato.semContato} sem contato" onclick="sendAlert('${c.crmOwner}','lead_sem_contato',{count:${m.primeiroContato.semContato}})">⏱️</button>` : '';
    const cobrarFup = m?.followup?.status==='red' ? `<button class="btn-mini alert" title="${m.followup.parados} propostas paradas" onclick="sendAlert('${c.crmOwner}','proposta_parada',{count:${m.followup.parados}})">📋</button>` : '';
    const cobrarDmd = c.diamantesParados>0 ? `<button class="btn-mini alert" onclick="sendAlert('${c.crmOwner}','diamante_parado',{count:${c.diamantesParados},horas:4})">💎</button>` : '';

    return `<tr>
      <td style="font-weight:700"><a href="/cockpit?closer=${userKey}" target="_blank" style="color:#fff;text-decoration:none">${c.name}</a> <span style="color:var(--dim);font-size:11px">${c.team||''}</span></td>
      <td>${c.vendasHoje||0}</td>
      <td style="font-weight:700;color:#fff">${c.vendas} <span style="color:var(--muted);font-size:11px">${fmtR$(c.faturamento)}</span></td>
      <td><span class="status-pill ${pct>=80?'green':pct>=50?'yellow':'red'}">${pct}%</span></td>
      <td>${ligCell}</td>
      <td>${pcCell}</td>
      <td>${fupCell}</td>
      <td title="${tipBreak.replace(/"/g,'&quot;')}" style="cursor:help">
        <span style="color:${discCol};font-weight:700">${disc}</span>
        <span class="disc-bar"><span style="width:${disc}%;background:${discCol}"></span></span>
      </td>
      <td>${c.diamantesParados||0}/${c.ourosParados||0}</td>
      <td><div class="row-act">${cobrarLig}${cobrarPc}${cobrarFup}${cobrarDmd}</div></td>
    </tr>`;
  }).join('');
}

// ============= BLOCO 5 — ERROS DO DIA =============
function renderBloco5(){
  if(!DATA || !GUERRA) return;
  const errors = [];

  // Leads sem contato
  if((GUERRA.semContato||[]).length > 0){
    errors.push({type:'Leads sem contato', count:GUERRA.semContato.length, color:'red',
      details:GUERRA.semContato.slice(0,5).map(l=>`${l.name} (${l.owner})`).join(', ')});
  }
  // Follow-up não feito
  if(GUERRA.propostasSemFollowup > 0){
    errors.push({type:'Follow-up não feito', count:GUERRA.propostasSemFollowup, color:'red',
      details:`Propostas paradas &gt;24h, total R$ ${((GUERRA.valorSemFollowup||0)/1000).toFixed(0)}k`});
  }
  // Closers sem atividade
  if((GUERRA.closersSemAtividade||[]).length > 0){
    errors.push({type:'Vendedores sem atividade &gt;2h', count:GUERRA.closersSemAtividade.length, color:'yellow',
      details:GUERRA.closersSemAtividade.map(c=>`${c.name} (${c.hoursAgo}h)`).join(', ')});
  }
  // Tier alto parado
  if(GUERRA.tierAltoParado > 0){
    errors.push({type:'Diamantes/Ouros abandonados', count:GUERRA.tierAltoParado, color:'red',
      details:'Lead premium parado &gt;2h sem ação'});
  }
  // Red flags por closer
  let totalFlags = 0;
  Object.values(DATA.closers||{}).forEach(c=>{ totalFlags += (c.flags?.length||0); });
  if(totalFlags > 0){
    errors.push({type:'Red flags ativas', count:totalFlags, color:'yellow',
      details:'Distribuídas pelo time — ver Bloco 4'});
  }

  if(!errors.length){
    document.getElementById('b5-body').innerHTML = '<div class="empty good">✓ Nenhum erro detectado hoje</div>';
    return;
  }

  document.getElementById('b5-body').innerHTML = `<div class="tc-grid tc-grid-2">${
    errors.map(e=>`<div class="card ${e.color}">
      <div class="lbl">${e.type}</div>
      <div class="big">${e.count}</div>
      <div class="sub" style="margin-top:6px">${e.details}</div>
    </div>`).join('')
  }</div>`;
}

// ============= BLOCO 6 — OPORTUNIDADES QUENTES =============
function renderBloco6(){
  if(!DATA) return;
  const novos = DATA.novos || [];
  const parados = DATA.parados || [];
  const indicacao = novos.filter(n=>(n.source||'').toLowerCase().includes('indica'));
  const diamantes = novos.filter(n=>n.tier==='Diamante');
  const todayNew = novos.length;

  let html = `<div class="tc-grid tc-grid-3" style="margin-bottom:14px">
    <div class="card green"><div class="lbl">Novos Hoje</div><div class="big">${todayNew}</div><div class="sub">leads na operação</div></div>
    <div class="card purple"><div class="lbl">Diamantes Novos</div><div class="big">${diamantes.length}</div><div class="sub">premium recém-qualificados</div></div>
    <div class="card yellow"><div class="lbl">Indicações</div><div class="big">${indicacao.length}</div><div class="sub">conversão histórica alta</div></div>
  </div>`;

  // Lista priorizada: Diamantes + Indicações + outros
  const priority = [...diamantes, ...indicacao.filter(i=>!diamantes.includes(i)), ...novos.filter(n=>!diamantes.includes(n) && !indicacao.includes(n))].slice(0,12);
  if(priority.length){
    html += `<div style="overflow-x:auto"><table class="tbl">
      <thead><tr><th>Tier</th><th>Lead</th><th>Fonte</th><th>Stage</th><th>Vendedor</th><th>Ações</th></tr></thead>
      <tbody>${priority.map(n=>{
        const tCol = n.tier==='Diamante'?'#A371F7':n.tier==='Ouro'?'#F0C040':'#9ca3af';
        return `<tr>
          <td style="color:${tCol};font-weight:700">${n.tier||'-'}</td>
          <td>${n.name}</td>
          <td style="color:var(--muted)">${n.source}</td>
          <td>${n.stage}</td>
          <td>${n.owner}</td>
          <td><a class="btn-mini crm" href="${n.crmLink}" target="_blank">CRM</a></td>
        </tr>`;
      }).join('')}</tbody></table></div>`;
  } else {
    html += '<div class="empty">Nenhum lead novo ainda hoje</div>';
  }

  // === Diamante/Ouro/Prata parados ANTES de Proposta ===
  // (todos qualificados que ainda não viraram proposta — oportunidade real)
  if (parados.length) {
    const porTier = { Diamante: parados.filter(p=>p.tier==='Diamante'), Ouro: parados.filter(p=>p.tier==='Ouro'), Prata: parados.filter(p=>p.tier==='Prata') };
    html += `<div class="g-section" style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;letter-spacing:.5px;margin:20px 0 8px">💎🥇🥈 Tier Alto Parado ANTES de Proposta — Oportunidade Real</div>`;
    html += `<div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:10px">
      <div class="card purple" style="flex:1;min-width:130px"><div class="lbl">💎 Diamante</div><div class="big">${porTier.Diamante.length}</div><div class="sub">parados pré-proposta</div></div>
      <div class="card yellow" style="flex:1;min-width:130px"><div class="lbl">🥇 Ouro</div><div class="big">${porTier.Ouro.length}</div><div class="sub">parados pré-proposta</div></div>
      <div class="card" style="flex:1;min-width:130px;border-color:#9ca3af"><div class="lbl">🥈 Prata</div><div class="big" style="color:#9ca3af">${porTier.Prata.length}</div><div class="sub">parados pré-proposta</div></div>
    </div>`;
    const tierOrd = { Diamante:0, Ouro:1, Prata:2 };
    const lista = [...parados].sort((a,b) => (tierOrd[a.tier]??9) - (tierOrd[b.tier]??9) || (b.hoursAgo||0) - (a.hoursAgo||0)).slice(0, 25);
    html += `<div style="overflow-x:auto"><table class="tbl">
      <thead><tr><th>Tier</th><th>Lead</th><th>Stage</th><th>Score</th><th>Vendedor</th><th>Parado</th><th>Ações</th></tr></thead>
      <tbody>${lista.map(p => {
        const tCol = p.tier==='Diamante'?'#A371F7':p.tier==='Ouro'?'#F0C040':'#9ca3af';
        const tIcon = p.tier==='Diamante'?'💎':p.tier==='Ouro'?'🥇':'🥈';
        const ageCls = p.hoursAgo>48?'red':p.hoursAgo>12?'yellow':'green';
        const wati = p.phone ? wpp(p.phone) : '';
        return `<tr>
          <td style="color:${tCol};font-weight:700">${tIcon} ${p.tier}</td>
          <td><a href="${p.crmLink}" target="_blank">${p.name}</a></td>
          <td style="color:var(--muted);font-size:12px">${p.stage}</td>
          <td>${p.score||'-'}</td>
          <td>${p.owner||'?'}</td>
          <td><span class="status-pill ${ageCls}">${hrs(p.hoursAgo)}</span></td>
          <td><div class="row-act">
            ${wati?`<a class="btn-mini wati" href="${wati}" target="_blank">WATI</a>`:''}
            <a class="btn-mini crm" href="${p.crmLink}" target="_blank">CRM</a>
            <button class="btn-mini alert" title="Núbia reengaja" onclick="nubiaReengajaDeals(['${p.id||''}'],'manual')">🤖</button>
          </div></td>
        </tr>`;
      }).join('')}</tbody></table></div>`;
    if (parados.length > 25) html += `<div style="text-align:center;color:var(--muted);font-size:11px;margin-top:6px">+ ${parados.length-25} parados não exibidos. Total: ${parados.length}</div>`;
  }

  document.getElementById('b6-body').innerHTML = html;
}

// ============= BLOCO IA — STATUS DA NÚBIA =============
function renderBlocoIA(){
  if (!IA_STATUS) {
    document.getElementById('bia-cards').innerHTML = '<div class="empty">Status IA indisponível</div>';
    return;
  }
  const s = IA_STATUS.stats || {};
  const followupPct = s.totalIA > 0 ? Math.round(s.followupOk / s.totalIA * 100) : 0;

  document.getElementById('bia-cards').innerHTML = `
    <div class="card blue"><div class="lbl">🔄 IA Trabalhando (tag ia sdr)</div><div class="big">${s.totalIA||0}</div><div class="sub">${s.apenasAtendidos||0} apenas atendidos sem qualificar</div></div>
    <div class="card ${followupPct>=70?'green':followupPct>=40?'yellow':'red'}"><div class="lbl">📅 Follow-up Hoje</div><div class="big">${s.followupOk||0}/${s.totalIA||0}</div><div class="sub">${followupPct}% com atividade hoje</div></div>
    <div class="card purple"><div class="lbl">✅ IA Qualificou</div><div class="big">${s.totalQualificou||0}</div><div class="sub">tag "ia qualificado" no funil</div></div>
    <div class="card green"><div class="lbl">🏆 Closer Fechou (via IA)</div><div class="big">${s.totalFechou||0}</div><div class="sub">${fmtR$(s.fatFechou||0)} • ${s.pctFatViaIA||0}% do faturamento mês</div></div>
  `;
  document.getElementById('bia-disclaimer').textContent = 'Atribuição via tags Zoho: "ia qualificado" = Núbia passou pro closer · "ia sdr" = apenas atendeu (sem qualificar)';

  // Pane 1 — Qualificando agora
  const qa = IA_STATUS.qualificandoAgora || [];
  if (!qa.length) {
    document.getElementById('bia-pane-1').innerHTML = '<div class="empty good">✓ Núbia sem leads ativos no momento</div>';
  } else {
    document.getElementById('bia-pane-1').innerHTML = `<div style="overflow-x:auto"><table class="tbl">
      <thead><tr><th>Lead</th><th>Tier</th><th>Stage</th><th>Origem</th><th>Dias no funil</th><th>Última atividade</th><th>Follow-up hoje</th><th>Ações</th></tr></thead>
      <tbody>${qa.map(q => {
        const tCol = q.tier==='Diamante'?'#A371F7':q.tier==='Ouro'?'#F0C040':q.tier==='Prata'?'#9ca3af':'#666';
        const diasCls = q.diasNoFunil>=7?'red':q.diasNoFunil>=3?'yellow':'green';
        return `<tr>
          <td><a href="${q.crmLink}" target="_blank">${q.name}</a>${q.stuck?' <span style="color:#ef4444;font-size:11px">⚠ sem ação real</span>':''}</td>
          <td style="color:${tCol};font-weight:700">${q.tier}</td>
          <td style="font-size:12px;color:#aaa">${q.stage}</td>
          <td style="font-size:11px;color:var(--muted)">${q.source}</td>
          <td><span class="status-pill ${diasCls}">${q.diasNoFunil}d</span></td>
          <td style="font-size:11px;color:var(--muted)">${q.horasUltimaAt < 24 ? q.horasUltimaAt+'h' : Math.round(q.horasUltimaAt/24)+'d'}</td>
          <td>${q.followupHoje ? '<span style="color:#22c55e;font-weight:700">✓</span>' : '<span style="color:#ef4444;font-weight:700">✗</span>'}</td>
          <td><div class="row-act"><a class="btn-mini crm" href="${q.crmLink}" target="_blank">CRM</a><button class="btn-mini alert" onclick="nubiaReengajaDeals(['${q.id||''}'],'manual')" title="Núbia força reengajamento">🤖</button></div></td>
        </tr>`;
      }).join('')}</tbody></table></div>`;
  }

  // Pane 2 — Qualificou (passou pro closer)
  const ql = IA_STATUS.qualificouLista || [];
  if (!ql.length) {
    document.getElementById('bia-pane-2').innerHTML = '<div class="empty">Sem qualificados recentes</div>';
  } else {
    document.getElementById('bia-pane-2').innerHTML = `<div style="overflow-x:auto"><table class="tbl">
      <thead><tr><th>Lead</th><th>Tier</th><th>Stage Atual</th><th>Closer</th><th>Valor Proposta</th><th>Dias no funil</th><th>Status</th><th>Ações</th></tr></thead>
      <tbody>${ql.map(q => {
        const tCol = q.tier==='Diamante'?'#A371F7':q.tier==='Ouro'?'#F0C040':q.tier==='Prata'?'#9ca3af':'#666';
        const atrasada = q.diasNoFunil > 14;
        return `<tr>
          <td><a href="${q.crmLink}" target="_blank">${q.name}</a></td>
          <td style="color:${tCol};font-weight:700">${q.tier}</td>
          <td style="font-size:12px">${q.stage}</td>
          <td>${q.owner}</td>
          <td style="font-weight:700">${q.amount?fmtR$Full(q.amount):'-'}</td>
          <td style="color:${atrasada?'#ef4444':q.diasNoFunil>7?'#fbbf24':'#888'};font-weight:${atrasada?'700':'400'}">${q.diasNoFunil}d</td>
          <td><span class="status-pill ${atrasada?'red':q.diasNoFunil>7?'yellow':'green'}">${atrasada?'⚠️ Atrasada':q.diasNoFunil>7?'Em dia':'Recente'}</span></td>
          <td><div class="row-act">
            <a class="btn-mini crm" href="${q.crmLink}" target="_blank">CRM</a>
            <button class="btn-mini alert" title="Núbia reengaja este lead" onclick="nubiaReengajaDeals(['${q.id||''}'],'manual')">🤖 Núbia</button>
          </div></td>
        </tr>`;
      }).join('')}</tbody></table></div>`;
  }

  // Pane 3 — Closer fechou
  const fl = IA_STATUS.fechouLista || [];
  if (!fl.length) {
    document.getElementById('bia-pane-3').innerHTML = '<div class="empty">Nenhuma venda no mês ainda</div>';
  } else {
    // Sub-resumo: por closer
    const porCloser = {};
    for (const f of fl) {
      if (!porCloser[f.owner]) porCloser[f.owner] = { qtd:0, total:0 };
      porCloser[f.owner].qtd++;
      porCloser[f.owner].total += f.amount;
    }
    const ranking = Object.entries(porCloser).sort((a,b) => b[1].total - a[1].total);
    let html = `<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">${
      ranking.map(([name, v]) =>
        `<div style="background:#161616;border:1px solid #222;border-left:3px solid #22c55e;border-radius:6px;padding:8px 12px;font-size:12px"><strong>${name}</strong> — ${v.qtd} venda(s) <span style="color:#4ade80;font-weight:700">${fmtR$(v.total)}</span></div>`
      ).join('')
    }</div>`;
    html += `<div style="overflow-x:auto"><table class="tbl">
      <thead><tr><th>Data</th><th>Closer</th><th>Lead</th><th>Produto</th><th>Origem</th><th>Valor</th><th>Ciclo</th><th>CRM</th></tr></thead>
      <tbody>${fl.map(f => `
        <tr>
          <td style="font-size:11px;color:var(--muted)">${f.dataFechamento}</td>
          <td style="font-weight:700">${f.owner}</td>
          <td>${f.name}</td>
          <td style="font-size:11px;color:#aaa">${f.produto}</td>
          <td style="font-size:11px;color:var(--muted)">${f.source}</td>
          <td style="font-weight:800;color:#4ade80">${fmtR$Full(f.amount)}</td>
          <td>${f.cicloDias}d</td>
          <td><a class="btn-mini crm" href="${f.crmLink}" target="_blank">Abrir</a></td>
        </tr>
      `).join('')}</tbody></table></div>`;
    document.getElementById('bia-pane-3').innerHTML = html;
  }
}

// ============= RAIO-X DOS CLOSERS NA TORRE =============
function popularDropdownRx(){
  if (!DATA?.closers) return;
  const sel = document.getElementById('rx-closer-sel');
  if (!sel || sel.options.length > 1) return;
  const closers = Object.entries(DATA.closers)
    .map(([username, c]) => ({ username, name: c.name, team: c.team, vendas: c.vendas, fat: c.faturamento }))
    .sort((a,b) => (b.fat||0) - (a.fat||0));
  sel.innerHTML = '<option value="">Selecione um closer...</option>' +
    closers.map(c => `<option value="${c.username}">${c.name} (${c.team||'-'}) · ${c.vendas} vendas · ${fmtR$(c.fat)}</option>`).join('');
}

async function loadRaioxAdmin(){
  const username = document.getElementById('rx-closer-sel').value;
  const body = document.getElementById('rx-bbody');
  if (!username) { body.innerHTML = '<div class="empty">Escolha um closer no dropdown acima.</div>'; return; }

  body.innerHTML = '<div class="empty">Carregando raio-x...</div>';
  try {
    const res = await fetch('/cockpit/raiox-dia?closer=' + encodeURIComponent(username) + '&nocache=1');
    const d = await res.json();
    if (d.error) { body.innerHTML = `<div class="empty" style="color:var(--red)">Erro: ${d.error}</div>`; return; }
    renderRxAdmin(d, username);
  } catch(e) {
    body.innerHTML = `<div class="empty" style="color:var(--red)">Erro: ${e.message}</div>`;
  }
}

function renderRxAdmin(d, username){
  const body = document.getElementById('rx-bbody');
  const closerInfo = DATA.closers[username] || {};
  const sCol = { critico:'#ef4444', urgente:'#f97316', media:'#eab308', info:'#5ba3f5', positivo:'#22c55e' };
  const tierCol = { Diamante:'#A371F7', Ouro:'#F0C040', Prata:'#9ca3af', Bronze:'#87592A' };

  const a = d.atividades, v = d.vendasHoje;

  // KPIs
  const kpis = `
    <div class="tc-grid tc-grid-4" style="margin-bottom:14px">
      <div class="card blue"><div class="lbl">📞 Ligações Hoje</div><div class="big">${a.ligacoes}</div><div class="sub">${a.ligacoesAtendidas} atendidas · ${a.minMedia||0}min/lig</div></div>
      <div class="card purple"><div class="lbl">⚡ Atividades</div><div class="big">${a.atividadesTotais}</div><div class="sub">deals movidos</div></div>
      <div class="card yellow"><div class="lbl">📋 Propostas Movidas</div><div class="big">${a.propsMovidas}</div><div class="sub">${fmtR$(a.valorPropsMovidas)}</div></div>
      <div class="card ${v.count>0?'green':'red'}"><div class="lbl">🏆 Vendas Hoje</div><div class="big">${v.count}</div><div class="sub">${fmtR$(v.fat)}</div></div>
    </div>
  `;

  // Sugestões
  const sugestoesHtml = (d.sugestoes||[]).map(s => `
    <div style="display:flex;gap:10px;padding:10px 12px;background:#101010;border-left:3px solid ${sCol[s.tipo]||'#666'};border-radius:6px;margin-bottom:6px;font-size:12px;line-height:1.5">
      <div style="font-size:18px">${s.icon}</div>
      <div style="flex:1">
        <strong style="color:#fff;font-size:12px">${s.titulo}</strong>
        <div style="color:#bbb;margin-top:2px">${s.texto}</div>
      </div>
    </div>
  `).join('') || '<div style="color:#888;font-size:12px;padding:8px 0">Nenhuma sugestão do Diretor agora.</div>';

  // 4 painéis lado a lado
  const novos = d.leadsNovos.lista || [];
  const grupos = d.leadsNovos.ondePararam || {};
  const parados = d.parados.lista || [];
  const sem = d.semAtividade.lista || [];
  const vendas = v.deals || [];

  const renderRow = (rows, kind) => {
    if (!rows.length) return `<div style="color:#4ade80;padding:14px;text-align:center;font-size:12px">${kind==='novos'?'Sem leads novos hoje':kind==='vendas'?'Sem vendas hoje':'✓ Limpo'}</div>`;
    return `<table class="tbl" style="font-size:11px"><thead><tr>
      <th>Lead</th><th>Tier</th><th>Stage</th><th>${kind==='novos'?'Status':kind==='vendas'?'Valor':'Tempo'}</th><th>Ações</th>
    </tr></thead><tbody>${rows.slice(0, 12).map(r => {
      const status = kind==='novos' ? (r.contatado?'<span style="color:#4ade80;font-weight:700">✓</span>':'<span style="color:#ef4444;font-weight:700">✗</span>')
                  : kind==='vendas' ? `<span style="color:#4ade80;font-weight:700">${fmtR$Full(r.valor)}</span>`
                  : kind==='parados' ? `<span style="color:${r.horas>96?'#ef4444':'#fbbf24'};font-weight:700">${r.horas}h</span>`
                  : `${r.horasNoFunil}h`;
      const wpp = r.phone ? `https://live-2708.wati.io/2708/teamInbox/${String(r.phone).replace(/\D/g,'')}` : '';
      const acts = `<div class="row-act">
        <a class="btn-mini crm" href="${r.crmLink}" target="_blank">CRM</a>
        ${wpp?`<a class="btn-mini wati" href="${wpp}" target="_blank">WATI</a>`:''}
        ${kind!=='vendas'?`<button class="btn-mini alert" onclick="nubiaReengajaDeals(['${r.id}'],'manual')">🤖</button>`:''}
      </div>`;
      return `<tr>
        <td style="font-weight:600">${r.name}</td>
        <td style="color:${tierCol[r.tier]||'#666'};font-weight:700">${r.tier||'-'}</td>
        <td style="font-size:10px;color:#aaa">${r.stage||'-'}</td>
        <td>${status}</td>
        <td>${acts}</td>
      </tr>`;
    }).join('')}${rows.length > 12 ? `<tr><td colspan="5" style="color:#888;text-align:center;font-size:10px">+ ${rows.length-12}</td></tr>`:''}</tbody></table>`;
  };

  const ondePararamPills = Object.entries(grupos).map(([s,arr]) => `<span style="display:inline-block;background:#1a1a1a;color:#7cb9f5;border:1px solid #30363D;border-radius:14px;padding:3px 10px;margin:3px 4px 0 0;font-size:11px">${s}: <strong>${arr.length}</strong></span>`).join('');

  body.innerHTML = `
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;padding:12px;background:#101010;border-radius:8px;border:1px solid #222">
      <span style="font-size:24px">👤</span>
      <div style="flex:1">
        <div style="color:#fff;font-weight:800;font-size:14px">${closerInfo.name||username}</div>
        <div style="color:#888;font-size:11px">${closerInfo.team||''} · ${closerInfo.vendas||0} vendas no mês · ${fmtR$(closerInfo.faturamento||0)} · meta ${closerInfo.pctMeta||0}%</div>
      </div>
      <div style="color:#7cb9f5;font-family:monospace;font-size:12px">⏰ ${d.hora} BRT</div>
    </div>

    ${kpis}

    <div class="g-section" style="font-size:11px;color:var(--muted);text-transform:uppercase;font-weight:700;letter-spacing:.5px;margin:10px 0 6px">🎙️ Diretor IA fala</div>
    ${sugestoesHtml}

    <div class="tc-grid tc-grid-2" style="margin-top:14px;gap:14px">
      <div>
        <h4 style="margin:0 0 8px;font-size:12px;color:#fff;text-transform:uppercase;letter-spacing:.4px">🆕 Leads Novos Hoje (${d.leadsNovos.total}) ${d.leadsNovos.semContato?`<span style="color:#ef4444">· ${d.leadsNovos.semContato} sem contato</span>`:''}</h4>
        ${ondePararamPills?`<div style="background:#101010;border:1px solid #222;border-radius:6px;padding:8px;margin-bottom:8px"><div style="font-size:9px;color:#888;text-transform:uppercase;font-weight:700;margin-bottom:4px">Onde pararam:</div>${ondePararamPills}</div>`:''}
        ${renderRow(novos, 'novos')}
      </div>
      <div>
        <h4 style="margin:0 0 8px;font-size:12px;color:#fff;text-transform:uppercase;letter-spacing:.4px">🏆 Vendas Hoje (${v.count})</h4>
        ${renderRow(vendas, 'vendas')}
      </div>
      <div>
        <h4 style="margin:14px 0 8px;font-size:12px;color:#fff;text-transform:uppercase;letter-spacing:.4px">⏰ Parados +48h (${d.parados.total})</h4>
        ${renderRow(parados, 'parados')}
      </div>
      <div>
        <h4 style="margin:14px 0 8px;font-size:12px;color:#fff;text-transform:uppercase;letter-spacing:.4px">🚧 Sem Nenhuma Atividade (${d.semAtividade.total})</h4>
        ${renderRow(sem, 'sem')}
      </div>
    </div>
  `;
}

function biaTab(n){
  for (let i=1; i<=3; i++) {
    const tab = document.getElementById('bia-tab-'+i);
    const pane = document.getElementById('bia-pane-'+i);
    if (i===n) {
      tab.style.background = '#1e3a5f'; tab.style.color = '#7cb9f5'; tab.style.border = '1px solid #5ba3f5';
      pane.style.display = '';
    } else {
      tab.style.background = ''; tab.style.color = ''; tab.style.border = '';
      pane.style.display = 'none';
    }
  }
}

// ============= BLOCO 7 — PIPELINE INTELIGENTE =============
function renderBloco7(){
  if(!GUERRA) return;
  const din = GUERRA.dinheiro || {};
  const totalCount = (din.quente?.count||0)+(din.morno?.count||0)+(din.frio?.count||0);
  const altaCount = (din.dealsAlta||[]).length;
  const mediaCount = (din.dealsMedia||[]).length;
  const baixaCount = (din.dealsBaixa||[]).length;
  const semFolCount = (din.dealsSemFollowup||[]).length;
  document.getElementById('b7-cards').innerHTML = `
    <div class="card blue clickable" onclick="abrirPipeDrawer('todos')" title="Ver leads"><div class="lbl">Total Pipeline 🔍</div><div class="big">${fmtR$(din.total||0)}</div><div class="sub">${totalCount} propostas</div></div>
    <div class="card green clickable" onclick="abrirPipeDrawer('alta')" title="Ver leads"><div class="lbl">Alta Prob &gt;70% 🔍</div><div class="big">${fmtR$(din.previsaoAlta||0)}</div><div class="sub">${altaCount} propostas</div></div>
    <div class="card yellow clickable" onclick="abrirPipeDrawer('media')" title="Ver leads"><div class="lbl">Média 40-70% 🔍</div><div class="big">${fmtR$(din.previsaoMedia||0)}</div><div class="sub">${mediaCount} propostas</div></div>
    <div class="card red clickable" onclick="abrirPipeDrawer('baixa')" title="Ver leads"><div class="lbl">Baixa &lt;40% 🔍</div><div class="big">${fmtR$(din.previsaoBaixa||0)}</div><div class="sub">${baixaCount} propostas</div></div>
    <div class="card red clickable" onclick="abrirPipeDrawer('semFollowup')" title="Ver leads"><div class="lbl">Sem Follow-up 🔍</div><div class="big">${fmtR$(din.semFollowup||0)}</div><div class="sub">${semFolCount} parado &gt;24h</div></div>
    <div class="card purple clickable" onclick="abrirPipeDrawer('ponderada')" title="Ver leads"><div class="lbl">Previsão Ponderada 🔍</div><div class="big">${fmtR$(din.previsaoPonderada||0)}</div><div class="sub">soma(valor × prob)</div></div>
  `;
}

// === Drawer Pipeline Inteligente ===
const PIPE_CAT_LABELS = {
  todos: 'Total Pipeline (todas as propostas)',
  alta: 'Alta Probabilidade (>70%)',
  media: 'Média Probabilidade (40-70%)',
  baixa: 'Baixa Probabilidade (<40%)',
  semFollowup: 'Sem Follow-up (parado >24h)',
  ponderada: 'Previsão Ponderada (ordenado por valor × prob)',
};
function abrirPipeDrawer(cat){
  const din = (GUERRA && GUERRA.dinheiro) || {};
  const map = { todos: din.dealsTodos, alta: din.dealsAlta, media: din.dealsMedia,
    baixa: din.dealsBaixa, semFollowup: din.dealsSemFollowup, ponderada: din.dealsPonderada };
  const list = map[cat] || [];
  const drawer = document.getElementById('pipe-drawer');
  const overlay = document.getElementById('pipe-overlay');
  const total = list.reduce((s,d)=>s+(d.valor||0),0);
  const ponderada = list.reduce((s,d)=>s+(d.valor||0)*((d.prob||0)/100),0);
  const tempBadge = t => {
    if (t==='quente') return '<span style="background:#22c55e22;color:#22c55e;padding:1px 6px;border-radius:4px;font-size:10px;font-weight:700">🔥 QUENTE</span>';
    if (t==='morno')  return '<span style="background:#eab30822;color:#eab308;padding:1px 6px;border-radius:4px;font-size:10px;font-weight:700">🌡️ MORNO</span>';
    return '<span style="background:#ef444422;color:#ef4444;padding:1px 6px;border-radius:4px;font-size:10px;font-weight:700">❄️ FRIO</span>';
  };
  const probBadge = p => {
    const cor = p>=70 ? '#22c55e' : p>=40 ? '#eab308' : '#ef4444';
    return `<span style="color:${cor};font-weight:800">${p||0}%</span>`;
  };
  const wppLink = phone => phone ? `<a href="${wpp(phone)}" target="_blank" style="color:#25D366;text-decoration:none;font-size:11px">📱 WATI</a>` : '';
  const crmA = link => link ? `<a href="${link}" target="_blank" style="color:#3b82f6;text-decoration:none;font-size:11px">🔗 Zoho</a>` : '';
  const escName = s => String(s||'').replace(/'/g,"\\'").replace(/"/g,'&quot;');
  const chatBtn = (dealId, phone, name) => phone ? `<button onclick="window.abrirChat&&abrirChat('${dealId||''}','${String(phone).replace(/\D/g,'')}','${escName(name)}')" style="background:#0d2818;color:#22c55e;border:1px solid #22c55e;padding:3px 8px;border-radius:4px;font-size:11px;font-weight:700;cursor:pointer">💬 Chat</button>` : '';
  const rows = list.length === 0
    ? `<tr><td colspan="7" style="text-align:center;padding:24px;color:#888">Nenhum deal nessa categoria</td></tr>`
    : list.map(d => `
        <tr>
          <td style="padding:8px 6px;border-bottom:1px solid #1a1a1a;font-size:12px">${(d.name||'?').slice(0,40)}</td>
          <td style="padding:8px 6px;border-bottom:1px solid #1a1a1a;font-size:11px;color:#888">${d.owner||'?'}</td>
          <td style="padding:8px 6px;border-bottom:1px solid #1a1a1a;font-size:11px;color:#aaa">${d.stage||'-'}</td>
          <td style="padding:8px 6px;border-bottom:1px solid #1a1a1a;font-size:12px;font-weight:700;text-align:right">${fmtR$Full(d.valor||0)}</td>
          <td style="padding:8px 6px;border-bottom:1px solid #1a1a1a;font-size:11px;text-align:center">${probBadge(d.prob)}</td>
          <td style="padding:8px 6px;border-bottom:1px solid #1a1a1a;font-size:11px;text-align:center">${tempBadge(d.temp)} <span style="color:#666;font-size:10px">${hrs(d.hoursAgo||0)}</span></td>
          <td style="padding:8px 6px;border-bottom:1px solid #1a1a1a;text-align:right;white-space:nowrap">${chatBtn(d.id, d.phone, d.name)} ${crmA(d.crmLink)} ${wppLink(d.phone)}</td>
        </tr>`).join('');
  drawer.querySelector('.pd-title').textContent = PIPE_CAT_LABELS[cat] || cat;
  drawer.querySelector('.pd-stats').innerHTML = `
    <span style="margin-right:14px"><strong>${list.length}</strong> deals</span>
    <span style="margin-right:14px">Total <strong>${fmtR$Full(total)}</strong></span>
    <span>Ponderada <strong>${fmtR$Full(ponderada)}</strong></span>`;
  drawer.querySelector('.pd-body').innerHTML = `
    <table style="width:100%;border-collapse:collapse">
      <thead><tr style="background:#0f0f0f">
        <th style="padding:8px 6px;text-align:left;color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.5px">Deal</th>
        <th style="padding:8px 6px;text-align:left;color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.5px">Closer</th>
        <th style="padding:8px 6px;text-align:left;color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.5px">Stage</th>
        <th style="padding:8px 6px;text-align:right;color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.5px">Valor</th>
        <th style="padding:8px 6px;text-align:center;color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.5px">Prob</th>
        <th style="padding:8px 6px;text-align:center;color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.5px">Temperatura</th>
        <th style="padding:8px 6px;text-align:right;color:#888;font-size:10px;text-transform:uppercase;letter-spacing:.5px">Ação</th>
      </tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
  drawer.classList.add('open');
  overlay.classList.add('open');
}
function fecharPipeDrawer(){
  document.getElementById('pipe-drawer').classList.remove('open');
  document.getElementById('pipe-overlay').classList.remove('open');
}
document.addEventListener('keydown', e => { if(e.key==='Escape') fecharPipeDrawer(); });

// ============= BLOCO 8 — PROJEÇÃO DE META =============
function renderBloco8(){
  if(!GUERRA) return;
  const sim = GUERRA.simulacao || {};
  const din = GUERRA.dinheiro || {};
  const pctMeta = sim.metaGlobal ? Math.round(sim.fatMes/sim.metaGlobal*100) : 0;
  const projPct = sim.metaGlobal ? Math.round(sim.projecao/sim.metaGlobal*100) : 0;
  const riscoCol = sim.risco==='alto'?'#ef4444':sim.risco==='medio'?'#eab308':'#22c55e';

  document.getElementById('b8-cards').innerHTML = `
    <div class="card blue"><div class="lbl">Meta Mensal</div><div class="big">${fmtR$(sim.metaGlobal||0)}</div></div>
    <div class="card green"><div class="lbl">Vendido</div><div class="big">${fmtR$(sim.fatMes||0)}</div><div class="sub">${sim.vendasMes||0} vendas (${pctMeta}%)</div></div>
    <div class="card red"><div class="lbl">Gap</div><div class="big">${fmtR$(sim.gap||0)}</div><div class="sub">${sim.diasUteis||0} dias úteis</div></div>
    <div class="card yellow"><div class="lbl">Necessário/Dia</div><div class="big">${fmtR$(sim.necessarioDia||0)}</div><div class="sub">ritmo atual ${fmtR$(sim.mediaDiaAtual||0)}</div></div>
  `;

  const cobreGap = (din.previsaoPonderada||0) >= (sim.gap||0);
  document.getElementById('b8-analysis').innerHTML = `
    <div style="padding:14px;background:#101010;border:1px solid var(--line);border-radius:10px">
      <div style="display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:6px">
        <span>Progresso: ${fmtR$(sim.fatMes||0)} / ${fmtR$(sim.metaGlobal||0)}</span>
        <span style="color:${riscoCol};font-weight:800">${pctMeta}% • Projeção: ${projPct}%</span>
      </div>
      <div class="proj-bar">
        <div class="fill" style="width:${Math.min(pctMeta,100)}%;background:${riscoCol}"></div>
      </div>
      <div style="font-size:13px;line-height:1.7;color:#ddd;margin-top:10px">
        <strong style="color:${riscoCol};text-transform:uppercase">${sim.risco==='alto'?'⚠ Risco Alto':sim.risco==='medio'?'! Risco Médio':'✓ No Caminho'}.</strong>
        Projeção ${fmtR$(sim.projecao||0)} ${sim.risco==='alto'?`fica ${Math.round((1-(sim.projecao||0)/(sim.metaGlobal||1))*100)}% abaixo da meta. Necessário ${fmtR$(sim.necessarioDia||0)}/dia nos próximos ${sim.diasUteis||0} dias úteis.`:'mantém ritmo até o fim do mês.'}
        <br><br>
        <strong>Pipeline disponível:</strong> ${fmtR$(din.total||0)} em propostas. <strong>Previsão ponderada:</strong> ${fmtR$(din.previsaoPonderada||0)}.
        ${cobreGap?'<br><span style="color:#22c55e;font-weight:700">✓ Previsão ponderada cobre o gap.</span>':`<br><span style="color:#ef4444;font-weight:700">✗ Falta ${fmtR$((sim.gap||0)-(din.previsaoPonderada||0))} além do pipeline atual — precisa abrir mais oportunidades.</span>`}
      </div>
    </div>
  `;
}

// ============= BLOCO 9 — COACH (lazy) =============
async function loadCoach(){
  const el = document.getElementById('b9-body');
  el.innerHTML = '<span style="color:var(--muted)">Analisando operação... (pode levar até 30s)</span>';
  try{
    const res = await fetch('/gestao/coach');
    const d = await res.json();
    if(d.error) throw new Error(d.error);
    el.innerHTML = (d.coach||'')
      .replace(/## (.*)/g, '<h3>$1</h3>')
      .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
      .replace(/\n- /g, '\n• ')
      .replace(/\n(\d+)\. /g, '\n<strong style="color:#c084fc">$1.</strong> ');
  }catch(e){
    el.innerHTML = '<span style="color:var(--red)">Erro: '+e.message+'</span>';
  }
}

// ============= BOTÕES GLOBAIS =============
function toggleGuerra(){
  GUERRA_MODE = !GUERRA_MODE;
  document.body.classList.toggle('guerra', GUERRA_MODE);
  const btn = document.getElementById('btn-guerra');
  btn.classList.toggle('active', GUERRA_MODE);
  btn.textContent = GUERRA_MODE ? '🛑 Sair Modo Guerra' : '⚔️ Modo Guerra';
}

async function runAutoAlerts(){
  toast('Disparando auto-alertas...');
  try{
    const res = await fetch('/gestao/auto-alerts');
    const r = await res.json();
    toast(`${r.total||0} alertas enviados via Z-API`);
  }catch(e){ toast('Erro: '+e.message, true); }
}

async function sendRelatorio(){
  toast('Enviando plano do dia...');
  try{
    const res = await fetch('/gestao/relatorio-diario?send=true');
    const r = await res.json();
    if(r.sent) toast('Plano enviado no seu WhatsApp ✓');
    else toast('Erro: '+(r.error||'falha'), true);
  }catch(e){ toast('Erro: '+e.message, true); }
}

async function runCorrecao(action){
  toast('Executando '+action+'...');
  try{
    const res = await fetch('/gestao/correcao', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({action})
    });
    const r = await res.json();
    toast(`Concluído. Alertas: ${(r.alerts||[]).length} • Reativados: ${r.reactivated||0}`);
  }catch(e){ toast('Erro: '+e.message, true); }
}

async function sendAlert(closerName, preset, data){
  try{
    const res = await fetch('/gestao/alert-preset', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body:JSON.stringify({closerName, preset, data})
    });
    const r = await res.json();
    if(r.sent) toast(`Alerta enviado para ${closerName} ✓`);
    else toast('Erro: '+(r.error||'falha'), true);
  }catch(e){ toast('Erro: '+e.message, true); }
}

function filterSemContato(){

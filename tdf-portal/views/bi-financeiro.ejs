    // =====================================================================
    // ===== Importação CSV — aba "Contas a Pagar simples" (client-side) =====
    // =====================================================================
    capImportarCsvAbrir() {
      document.getElementById('bifCapImportResultado').innerHTML = '';
      document.getElementById('bifCapImportFile').value = '';

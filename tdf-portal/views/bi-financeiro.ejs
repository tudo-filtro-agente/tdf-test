        html += '<details open style="margin:10px 0"><summary style="cursor:pointer;color:#EF4444;font-weight:700">❌ '+err+' erro(s)</summary><table class="bif-table" style="margin-top:8px;font-size:12px"><thead><tr><th>Linha</th><th>Motivo</th></tr></thead><tbody>' +
          r.erros.map(e => `<tr><td>${e.linha}</td><td style="color:#EF4444">${escapeHtml(e.motivo)}</td></tr>`).join('') + '</tbody></table></details>';
      }
      box.innerHTML = html;
      if (isPreview && (ok+upd) > 0) {
        document.getElementById('bifFrnImportBtnConfirmar').style.display = '';

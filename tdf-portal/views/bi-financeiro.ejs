  // ============ TABS ============
  function bindTabs() {
    // Sub-tabs do Estoque (event delegation pra elementos dinâmicos)
    document.addEventListener('click', (e) => {
      const subTab = e.target.closest('#bifEstSubTabs .bif-tab');
      if (!subTab) return;
      e.preventDefault();
      BIF.estSwitchSubTab(subTab.dataset.stab);
    });
    document.querySelectorAll('.bif-tab').forEach(t => {
      if (t.closest('#bifEstSubTabs')) return; // sub-tabs do Estoque tem listener separado
      t.addEventListener('click', () => {
        document.querySelectorAll('.bif-tab').forEach(x => x.classList.remove('active'));
        t.classList.add('active');
        const id = t.dataset.tab;
        document.querySelectorAll('.bif-pane').forEach(p => p.classList.remove('active'));
        document.getElementById('pane-'+id)?.classList.add('active');
        // re-render charts em abas que usam canvas
        if (id === 'ceo')     { BIF.ceoReload(); }
        if (id === 'visao')   { renderRecDespChart(); renderDespPie(); }
        if (id === 'caixa')   { renderCaixa(); }
        if (id === 'break-even') { renderBreakEven(); }
        if (id === 'simulador')  { simulate(); }
        if (id === 'config')     { renderConfig(); }
        if (id === 'vendas-zoho') { if (!BIF.vzState.lastSync) BIF.vzInit(); else BIF.vzPopulateEmpresaSel(); }
        if (id === 'relatorios-zoho') { BIF.vzRenderRelatorios(); }
        if (id === 'recebimentos'){ BIF.pgPopularEmpresaSelect(); BIF.rcReload(); }
        if (id === 'pagamentos')  { BIF.pgPopularEmpresaSelect(); BIF.pgReload(); }
        if (id === 'aprovacoes')  { BIF.apReload(); }
        if (id === 'bancos')      { BIF.bkReload(); }
        if (id === 'extratos')    { BIF.exReload(); }
        if (id === 'conciliacao') { BIF._concPopularContas(); }
        if (id === 'aprovadores') { BIF.apvReload(); }
        if (id === 'fornecedores'){ BIF.frnReload(); }
        if (id === 'auditoria')   { BIF.audReload(); }
        if (id === 'estoque')     { BIF.estSwitchSubTab(BIF.estState.currStab||'dash'); }
        if (id === 'logistica')   { BIF.logSwitchSubTab(BIF.logState?.currStab||'rotas'); }
        if (id === 'nf-entrada')  { BIF.nfReload(); BIF.nfImapStatus(); }
        if (id === 'compras')     { BIF.cpReload(); }
        if (id === 'os-materiais'){ BIF.osmReload(); }
        if (id === 'tutorial')    { BIF.tutorialReload(); }
      });
    });
  }

  // ============ RENDER MASTER ============
  function softRecalc() {
    // recalcula KPIs e seções derivadas SEM re-renderizar tabelas (mantém foco do input)
    renderKpis();
    renderRanking();
    renderAlertas();
    // contadores das tabelas
    updateInlineCounters();
    // se a aba ativa for não-tabela, atualiza os derivados
    const active = document.querySelector('.bif-tab.active')?.dataset.tab;
    if (active === 'dre')    renderDRE();
    if (active === 'caixa')  renderCaixa();
    if (active === 'break-even') renderBreakEven();
    if (active === 'visao')  { renderRecDespChart(); renderDespPie(); }
    if (active === 'simulador') simulate();
  }
  function updateInlineCounters() {
    const cf = scoped(state.custosFixos).reduce((s,x)=>s+(+x.valor||0),0);
    document.getElementById('bifCfTotal').textContent = `Total no escopo: ${fmtBRL(cf)}`;
    const rec = scoped(state.receitas).reduce((s,r)=>s+((+r.qtd||1)*(+r.valorUnit||0)),0);
    document.getElementById('bifReceitasTotal').textContent = `Total no escopo: ${fmtBRL(rec)}`;
  }
  function renderAll() {
    renderEmpresaSelect();
    renderKpis();
    renderEmpresas();
    renderProdutos();
    renderReceitas();
    renderCustosFixos();
    renderCustosVariaveis();
    renderContasPagar();
    renderContasReceber();
    renderDRE();
    renderRecDespChart();
    renderDespPie();
    renderCaixa();
    renderBreakEven();
    renderRanking();
    renderAlertas();
    renderConfig();
    if (document.querySelector('.bif-tab.active')?.dataset.tab === 'simulador') simulate();
  }

  // ============ INIT ============
  document.addEventListener('DOMContentLoaded', async () => {
    bindTabs();
    // 1) Carrega state (async — primeiro tenta server, fallback localStorage)
    await load();
    document.getElementById('bifPeriodo').value = state.periodo || '';
    renderAll();
    // 2) CEO default
    try {
      if (typeof BIF.ceoInitPicker === 'function') BIF.ceoInitPicker();
      if (typeof BIF.ceoReload === 'function') BIF.ceoReload();
    } catch(e) { console.warn('[ceoReload boot]', e); }
  });

  // Expor função pra forçar re-sync com server (botão refresh + ao trocar de aba)
  window.BIF_resyncFromServer = async function() {
    await load();
    renderAll();
    if (typeof BIF.ceoReload === 'function') BIF.ceoReload();
  };
})();
</script>

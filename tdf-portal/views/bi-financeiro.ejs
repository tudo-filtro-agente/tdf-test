  // ============ SIMULADOR ============
  function simulate() {
    const orig = calcResumoEmpresa(state.activeCompanyId);
    const dV = +document.getElementById('bifSimVendas').value/100;   // % unidade
    const dP = +document.getElementById('bifSimPreco').value/100;    // % preço
    const dC = +document.getElementById('bifSimCusto').value/100;    // % custo produto
    const fnc = +document.getElementById('bifSimFunc').value;        // R$ funcionário
    const mkt = +document.getElementById('bifSimMkt').value;         // R$ marketing
    const dMg = +document.getElementById('bifSimMg').value/100;      // p.p. margem (delta)
    const dImp = +document.getElementById('bifSimImp').value/100;    // p.p. impostos
    const dCom = +document.getElementById('bifSimCom').value/100;    // p.p. comissão

    // labels
    document.getElementById('bifSimVendasV').textContent = (dV>=0?'+':'')+(dV*100).toFixed(0)+'%';
    document.getElementById('bifSimPrecoV').textContent  = (dP>=0?'+':'')+(dP*100).toFixed(0)+'%';
    document.getElementById('bifSimCustoV').textContent  = (dC>=0?'+':'')+(dC*100).toFixed(0)+'%';
    document.getElementById('bifSimFuncV').textContent   = fmtBRL(fnc);
    document.getElementById('bifSimMktV').textContent    = fmtBRL(mkt);
    document.getElementById('bifSimMgV').textContent     = (dMg>=0?'+':'')+(dMg*100).toFixed(0)+' p.p.';
    document.getElementById('bifSimImpV').textContent    = (dImp>=0?'+':'')+(dImp*100).toFixed(0)+' p.p.';
    document.getElementById('bifSimComV').textContent    = (dCom>=0?'+':'')+(dCom*100).toFixed(0)+' p.p.';

    // Recompute via produtos com deltas
    const isCons = state.activeCompanyId === 'consolidado';
    const prods = state.produtos.filter(p => isCons || p.companyId === state.activeCompanyId);
    const cf    = state.custosFixos.filter(p => isCons || p.companyId === state.activeCompanyId);
    const cv    = state.custosVariaveis.filter(p => isCons || p.companyId === state.activeCompanyId);
    const rec   = state.receitas.filter(p => isCons || p.companyId === state.activeCompanyId);

    let receitaProd=0, cmv=0, frete=0, imp=0, com=0, outros=0;
    prods.forEach(p => {
      const qtd = (+p.qtdVendida||0) * (1+dV);
      const preco = (+p.precoVenda||0) * (1+dP);
      const custo = (+p.custoProduto||0) * (1+dC);
      const fr = (+p.frete||0);
      const ip = Math.max(0, ((+p.impostosPct||0)/100) + dImp);
      const cm = Math.max(0, ((+p.comissaoPct||0)/100) + dCom);
      const ou = (+p.outrosCustos||0);
      receitaProd += preco*qtd;
      cmv         += custo*qtd;
      frete       += fr*qtd;
      imp         += preco*qtd*ip;
      com         += preco*qtd*cm;
      outros      += ou*qtd;
    });
    const receitaAvulsa = rec.reduce((s,r) => s + ((+r.qtd||1) * (+r.valorUnit||0)) * (1+dV), 0);
    const receitaTotal  = receitaProd + receitaAvulsa;
    let cvFixos = cv.reduce((s,x) => {
      const direto = +x.valor || 0;
      const pct = (+x.percSobreVenda||0)/100;
      return s + direto + (receitaTotal * pct);
    }, 0);
    // dMg ajusta margem: aumenta margem = reduz custo variável proporcional à receita
    const ajusteMargem = -receitaTotal * dMg;
    const custoVarTotal = cmv + frete + imp + com + outros + cvFixos + ajusteMargem;

    const cfBase  = cf.reduce((s,x) => s + (+x.valor||0), 0);
    const cfProj  = cfBase + fnc + mkt;
    const lucroLiq = receitaTotal - custoVarTotal - cfProj;
    const margemLiq = receitaTotal>0 ? lucroLiq/receitaTotal : 0;
    const margemContribMedia = receitaTotal>0 ? (receitaTotal - custoVarTotal)/receitaTotal : 0;
    const breakEven = margemContribMedia>0 ? cfProj/margemContribMedia : 0;
    const necessario = Math.max(0, breakEven - receitaTotal);
    const saldoCaixa = (orig.saldoIni||0) + lucroLiq + orig.totalCAR - orig.totalCAP;

    const proj = { receitaTotal, custoVarTotal, cfTotal: cfProj, lucroLiquido: lucroLiq, margemLiq, margemContribMedia, breakEven };

    const cards = [
      { lbl:'Receita projetada', val:fmtBRL(receitaTotal), klass:receitaTotal>=orig.receitaTotal?'ok':'warn', sub: deltaTxt(receitaTotal, orig.receitaTotal) },
      { lbl:'Lucro líquido projetado', val:fmtBRL(lucroLiq), klass:lucroLiq>=0?'ok':'bad', sub: deltaTxt(lucroLiq, orig.lucroLiquido) },
      { lbl:'Margem líquida', val:fmtPct(margemLiq), klass:margemLiq>=0.10?'ok':margemLiq>=0?'warn':'bad' },
      { lbl:'Caixa projetado', val:fmtBRL(saldoCaixa), klass:saldoCaixa>=0?'ok':'bad' },
      { lbl:'Ponto de equilíbrio', val:fmtBRL(breakEven), klass:'info' },
      { lbl:'Faturamento necessário (gap)', val:fmtBRL(necessario), klass: necessario>0?'warn':'ok' },
    ];
    document.getElementById('bifSimKpis').innerHTML = cards.map(c =>
      `<div class="bif-kpi ${c.klass}"><div class="lbl">${c.lbl}</div><div class="val" style="font-size:1.2rem">${c.val}</div>${c.sub?`<div class="sub">${c.sub}</div>`:''}</div>`).join('');

    // risco
    let riscoMsg = '';
    if (lucroLiq < 0 && orig.lucroLiquido >= 0) riscoMsg = `<div class="bif-alert bad"><span class="ico">🔥</span><div>Cenário leva a operação ao prejuízo. Reavaliar antes de executar.</div></div>`;
    else if (saldoCaixa < 0) riscoMsg = `<div class="bif-alert bad"><span class="ico">💸</span><div>Caixa projetado negativo (${fmtBRL(saldoCaixa)}). Risco de inadimplência.</div></div>`;
    else if (margemLiq < 0.05) riscoMsg = `<div class="bif-alert warn"><span class="ico">⚠️</span><div>Margem líquida muito apertada (${fmtPct(margemLiq)}). Pouca folga para imprevistos.</div></div>`;
    else if (lucroLiq > orig.lucroLiquido * 1.2) riscoMsg = `<div class="bif-alert ok"><span class="ico">📈</span><div>Cenário gera ganho expressivo. Vale planejar a execução.</div></div>`;
    else riscoMsg = `<div class="bif-alert info"><span class="ico">ℹ️</span><div>Cenário viável. Compare com o atual e tome a decisão.</div></div>`;
    document.getElementById('bifSimRisco').innerHTML = riscoMsg;

    drawChartSim(orig, proj);
  }
  function deltaTxt(novo, base) {
    const d = novo - base;
    const pct = base !== 0 ? (d/Math.abs(base)*100) : 0;
    const sign = d >= 0 ? '+' : '';
    return sign + fmtBRL(d) + ' (' + sign + pct.toFixed(1) + '%)';
  }
  function simReset() {
    ['bifSimVendas','bifSimPreco','bifSimCusto','bifSimFunc','bifSimMkt','bifSimMg','bifSimImp','bifSimCom']
      .forEach(id => { const el = document.getElementById(id); if (el) el.value = 0; });
    simulate();
  }

  // ============ HELPERS ============
  function escapeHtml(s){ return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  function selectFromList(current, opts, onChange, withPill) {
    const html = opts.map(o => `<option value="${o}" ${o===current?'selected':''}>${o||'—'}</option>`).join('');
    return `<select onchange="${onChange}">${html}</select>`;
  }

  // ============ API PÚBLICA ============
  const BIF = {
    isAdmin: BIF_IS_ADMIN,
    // ========================================================
    // ===== BULK SELECT GENÉRICO (multi-módulo, admin only) =====
    // ========================================================
    // Estado de seleção por módulo (Set de IDs)
    _bulkSel: {},
    _bulkInit(kind) { if (!this._bulkSel[kind]) this._bulkSel[kind] = new Set(); return this._bulkSel[kind]; },
    bulkToggle(kind, id, checked) {
      const set = this._bulkInit(kind);
      if (checked) set.add(id); else set.delete(id);
      this._bulkUpdateBar(kind);
    },
    bulkToggleAll(kind, checked) {
      const set = this._bulkInit(kind);
      set.clear();
      if (checked) {
        document.querySelectorAll(`input[data-bulk-${kind}]`).forEach(el => {
          set.add(el.getAttribute('data-bulk-'+kind));
          el.checked = true;
        });
      } else {
        document.querySelectorAll(`input[data-bulk-${kind}]`).forEach(el => { el.checked = false; });
      }
      this._bulkUpdateBar(kind);
    },
    bulkLimpar(kind) {
      this._bulkInit(kind).clear();
      document.querySelectorAll(`input[data-bulk-${kind}]`).forEach(el => { el.checked = false; });
      const all = document.getElementById('bifBulkAll_'+kind); if (all) all.checked = false;
      this._bulkUpdateBar(kind);
    },
    _bulkUpdateBar(kind) {
      const bar = document.getElementById('bifBulkBar_'+kind); if (!bar) return;
      const set = this._bulkInit(kind);
      const n = set.size;
      const countEl = document.getElementById('bifBulkCount_'+kind);
      if (countEl) countEl.textContent = n;
      if (n === 0) { bar.style.display = 'none'; return; }
      bar.style.display = 'flex';
      // Atualiza badge de valor total (se aplicável)
      const totalEl = document.getElementById('bifBulkTotal_'+kind);
      if (totalEl) {
        const stateList = state[kind] || [];
        const tot = stateList.filter(x => set.has(x.id)).reduce((s,x) => s + (+x.valor||0), 0);
        totalEl.textContent = fmtBRL(tot);
      }
    },
    // Map de configs server-side por kind (preenchido em _bulkBarHTML quando opts.serverKind passado)
    _bulkServerCfg: {},
    // Exclui em massa. Se kind tiver config server registrada, vai pro endpoint REST; senão mexe no state localStorage.
    async bulkExcluir(kind, displayName) {
      if (!this.isAdmin) { alert('Apenas administrador pode excluir em massa.'); return; }
      const set = this._bulkInit(kind);
      const n = set.size; if (n === 0) return;
      const dn = displayName || kind;
      const cfg = this._bulkServerCfg[kind];
      if (cfg && cfg.serverKind) {
        const ids = Array.from(set);
        await this._bulkDeleteServer(cfg.serverKind, ids, dn, async () => {
          set.clear();
          this._bulkUpdateBar(kind);
          if (typeof cfg.afterReload === 'function') await cfg.afterReload();
          else if (typeof cfg.afterReload === 'string' && typeof this[cfg.afterReload] === 'function') await this[cfg.afterReload]();
        });
        return;
      }
      if (!confirm(`Excluir ${n} ${dn} selecionada(s)? Isso é irreversível.`)) return;
      state[kind] = (state[kind]||[]).filter(x => !set.has(x.id));
      set.clear(); save(); renderAll();
    },
    bulkDuplicar(kind) {
      if (!this.isAdmin) return;
      const set = this._bulkInit(kind);
      const n = set.size; if (n === 0) return;
      if (!confirm(`Duplicar ${n} item(ns)?`)) return;
      const novos = [];
      (state[kind]||[]).forEach(x => {
        if (set.has(x.id)) {
          const dup = { ...x, id: 'id_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36) };
          if (dup.nome)       dup.nome += ' (cópia)';
          if (dup.descricao)  dup.descricao += ' (cópia)';
          if (dup.fornecedor) dup.fornecedor += ' (cópia)';
          if (dup.cliente)    dup.cliente += ' (cópia)';
          novos.push(dup);
        }
      });
      state[kind].push(...novos);
      save(); renderAll();
    },
    // Renderiza a barra HTML (chama no toolbar de cada módulo)
    // opts.serverKind → encaminha exclusão pra /bi-financeiro/api/bulk-delete (server-side)
    // opts.afterReload → nome do método de reload (string) ou função pra rodar após delete server
    _bulkBarHTML(kind, displayName, opts = {}) {
      if (!this.isAdmin) return ''; // só admin vê
      if (opts.serverKind) {
        this._bulkServerCfg[kind] = { serverKind: opts.serverKind, afterReload: opts.afterReload || null };
        if (opts.showDup === undefined) opts.showDup = false;
        if (opts.showTotal === undefined) opts.showTotal = false;
      }
      const showDup = opts.showDup !== false;
      const showStatus = opts.showStatus || null; // array de status options pra dropdown
      let statusHtml = '';
      if (showStatus) {
        statusHtml = `<select id="bifBulkStatus_${kind}" style="background:#0a0a0a;color:#E6EDF3;border:1px solid #30363D;border-radius:6px;padding:5px 8px;font-size:12px">
          <option value="">Mudar status...</option>
          ${showStatus.map(s => `<option value="${s}">→ ${s}</option>`).join('')}
        </select>
        <button class="bif-btn sm" onclick="BIF.bulkAplicarStatus('${kind}')">Aplicar</button>`;
      }
      return `<div id="bifBulkBar_${kind}" style="display:none;background:linear-gradient(135deg,#1a2a3a,#0F1420);border:1px solid #4F8CFF;border-radius:8px;padding:10px 14px;margin-bottom:10px;display:none;align-items:center;gap:10px;flex-wrap:wrap">
        <span style="font-weight:700"><span id="bifBulkCount_${kind}">0</span> ${escapeHtml(displayName)} selecionada(s)</span>
        ${opts.showTotal !== false ? `<span class="muted" style="font-size:11.5px">·</span><span class="muted" style="font-size:12px">Total: <b id="bifBulkTotal_${kind}">R$ 0,00</b></span>` : ''}
        <div style="flex:1"></div>
        ${statusHtml}
        ${showDup ? `<button class="bif-btn sm ghost" onclick="BIF.bulkDuplicar('${kind}')">📋 Duplicar</button>` : ''}
        <button class="bif-btn sm danger" onclick="BIF.bulkExcluir('${kind}', '${escapeHtml(displayName)}')">🗑️ Excluir</button>
        <button class="bif-btn sm ghost" onclick="BIF.bulkLimpar('${kind}')">✕</button>
      </div>`;
    },
    // === Bulk delete server-side (módulos com endpoints REST) ===
    // serverKind = 'pagamentos' | 'recebimentos' | 'bancos' | 'aprovadores' | 'estoque-empresas' | 'estoque-locais' | 'estoque-produtos'
    // selectedSet = Set local de IDs (mantido na lib do módulo)
    // afterReload = função pra recarregar após delete
    async _bulkDeleteServer(serverKind, ids, displayName, afterReload) {
      if (!this.isAdmin) { alert('Apenas administrador pode excluir em massa.'); return; }
      const n = ids.length; if (n === 0) return;
      if (!confirm(`Excluir ${n} ${displayName} selecionado(s) do servidor? Isso é irreversível.`)) return;
      try {
        const r = await fetch('/bi-financeiro/api/bulk-delete', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ kind: serverKind, ids })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error || 'erro');
        if (r.erros?.length) alert(`✓ Removidos: ${r.removidos}\n⚠️ Erros: ${r.erros.length}\n\nPrimeiro erro: ${r.erros[0].erro}`);
        if (afterReload) await afterReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    // Helpers de UI pra cada render usar (gera HTML da célula checkbox)
    _bulkCellCheckbox(kind, id) {
      if (!this.isAdmin) return '<td style="width:30px"></td>';
      return `<td style="width:30px"><input type="checkbox" data-bulk-${kind}="${id}" onclick="BIF.bulkToggle('${kind}','${id}', this.checked)"></td>`;
    },
    _bulkSetupHead(kind) {
      if (!this.isAdmin) return;
      const head = document.getElementById('bifBulkHead_'+kind);
      if (head && !head.innerHTML) {
        head.innerHTML = `<input type="checkbox" id="bifBulkAll_${kind}" onchange="BIF.bulkToggleAll('${kind}', this.checked)" title="Selecionar todos">`;
      }
      const slot = document.getElementById('bifBulkSlot_'+kind);
      if (slot && !slot.innerHTML) {
        // Slot deve receber a barra. Render usa _bulkBarHTML pra inserir.
      }
    },

    bulkAplicarStatus(kind) {
      if (!this.isAdmin) return;
      const novoStatus = document.getElementById('bifBulkStatus_'+kind)?.value;
      if (!novoStatus) { alert('Escolha um status.'); return; }
      const set = this._bulkInit(kind);
      const n = set.size; if (n === 0) return;
      if (!confirm(`Mudar status de ${n} item(ns) pra "${novoStatus}"?`)) return;
      (state[kind]||[]).forEach(x => {
        if (set.has(x.id)) {
          if ('status' in x) x.status = novoStatus;
          if ('statusReceb' in x) x.statusReceb = novoStatus;
        }
      });
      save(); renderAll();
    },

    setEmpresa(id) { state.activeCompanyId = id; save(); renderAll(); },
    setPeriodo(p)  { state.periodo = p || ''; const el = document.getElementById('bifPeriodo'); if (el) el.value = state.periodo; save(); renderAll(); },
    setSaldoInicial(id, val) { state.config.saldoInicial[id] = +val||0; save(); softRecalc(); },

    // === Empresa CRUD ===
    editEmpresa(id) {
      const c = id ? state.companies.find(x => x.id === id) : { id:'', nome:'', cnpj:'', segmento:'', responsavel:'', mes: todayMonth(), observacoes:'' };
      if (!c) return;
      document.getElementById('bifEmpModalTitle').textContent = id ? 'Editar empresa' : 'Cadastrar empresa';
      document.getElementById('bifEmpId').value = c.id || '';
      document.getElementById('bifEmpNome').value = c.nome || '';
      document.getElementById('bifEmpCnpj').value = c.cnpj || '';
      document.getElementById('bifEmpSeg').value = c.segmento || '';
      document.getElementById('bifEmpResp').value = c.responsavel || '';
      document.getElementById('bifEmpMes').value = c.mes || todayMonth();
      document.getElementById('bifEmpObs').value = c.observacoes || '';
      document.getElementById('bifEmpModal').classList.add('show');
    },
    closeEmpModal() { document.getElementById('bifEmpModal').classList.remove('show'); },
    saveEmpresa() {
      const nome = document.getElementById('bifEmpNome').value.trim();
      if (!nome) { alert('Nome é obrigatório.'); return; }
      const id = document.getElementById('bifEmpId').value;
      const data = {
        nome,
        cnpj: document.getElementById('bifEmpCnpj').value.trim(),
        segmento: document.getElementById('bifEmpSeg').value.trim(),
        responsavel: document.getElementById('bifEmpResp').value.trim(),
        mes: document.getElementById('bifEmpMes').value,
        observacoes: document.getElementById('bifEmpObs').value.trim(),
      };
      if (id) {
        const c = state.companies.find(x => x.id === id);
        Object.assign(c, data);
      } else {
        const novo = Object.assign({ id: uid() }, data);
        state.companies.push(novo);
        if (!state.config.saldoInicial[novo.id]) state.config.saldoInicial[novo.id] = 0;
        if (state.activeCompanyId === 'consolidado' && state.companies.length === 1) {
          state.activeCompanyId = novo.id;
        }
      }
      save();
      this.closeEmpModal();
      renderAll();
    },
    duplicateEmpresa(id) {
      const c = state.companies.find(x => x.id === id); if (!c) return;
      const novo = Object.assign({}, c, { id: uid(), nome: c.nome+' (cópia)' });
      state.companies.push(novo);
      save(); renderAll();
    },
    delEmpresa(id) {
      const c = state.companies.find(x => x.id === id); if (!c) return;
      if (!confirm(`Excluir empresa "${c.nome}"?\nTodos os produtos, custos, receitas e contas vinculados também serão removidos.`)) return;
      state.companies = state.companies.filter(x => x.id !== id);
      ['produtos','custosFixos','custosVariaveis','receitas','contasPagar','contasReceber'].forEach(k => {
        state[k] = state[k].filter(x => x.companyId !== id);
      });
      delete state.config.saldoInicial[id];
      if (state.activeCompanyId === id) state.activeCompanyId = 'consolidado';
      save(); renderAll();
    },

    // === Linhas genéricas (CRUD em tabelas) ===
    addRow(kind) {
      if (state.companies.length === 0) {
        alert('Cadastre uma empresa primeiro (aba Empresas).'); return;
      }
      const def = SCHEMAS[kind].defaults();
      if (!def.companyId) {
        alert('Cadastre uma empresa primeiro.'); return;
      }
      state[kind].push(def);
      save(); renderAll();
    },
    delRow(kind, id) {
      if (!confirm('Excluir este registro?')) return;
      state[kind] = state[kind].filter(x => x.id !== id);
      save(); renderAll();
    },
    duplicateRow(kind, id) {
      const item = state[kind].find(x => x.id === id); if (!item) return;
      const novo = Object.assign({}, item, { id: uid() });
      if (novo.nome) novo.nome += ' (cópia)';
      if (novo.descricao) novo.descricao += ' (cópia)';
      state[kind].push(novo);
      save(); renderAll();
    },
    editField(kind, id, field, value) {
      const item = state[kind].find(x => x.id === id); if (!item) return;
      item[field] = value;
      save();
      // Recalcula sem re-renderizar a célula em foco (evita perder cursor)
      softRecalc();
    },
    recalc() { renderAll(); },

    // === Backup/Restore ===
    exportJSON() {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type:'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const stamp = new Date().toISOString().slice(0,19).replace(/[:T]/g,'-');
      a.href = url; a.download = `tdf-bi-financeiro-${stamp}.json`;
      a.click(); URL.revokeObjectURL(url);
    },
    importJSON(ev) {
      const f = ev.target.files[0]; if (!f) return;
      const r = new FileReader();
      r.onload = e => {
        try {
          const data = JSON.parse(e.target.result);
          if (!data.companies) throw new Error('JSON inválido (faltando companies)');
          if (!confirm('Substituir TODOS os dados atuais pelo conteúdo do arquivo?')) return;
          state = Object.assign(defaultState(), data);
          save(); renderAll();
          alert('Dados importados com sucesso.');
        } catch(err) { alert('Falha ao importar: ' + err.message); }
        ev.target.value = '';
      };
      r.readAsText(f);
    },
    exportCSV() {
      const lines = [];
      // produtos
      lines.push('PRODUTOS');
      lines.push(['empresa','nome','categoria','precoVenda','custoProduto','frete','impostosPct','comissaoPct','outrosCustos','qtdVendida','margemBruta','margemContrib','lucroTotal'].join(';'));
      state.produtos.forEach(p => {
        const c = calcProduto(p);
        lines.push([compName(p.companyId), p.nome, p.categoria, p.precoVenda, p.custoProduto, p.frete, p.impostosPct, p.comissaoPct, p.outrosCustos, p.qtdVendida, (c.margemBruta*100).toFixed(2), (c.margemContrib*100).toFixed(2), c.lucroTotal.toFixed(2)].join(';'));
      });
      lines.push(''); lines.push('RECEITAS');
      lines.push(['empresa','data','produto','qtd','valorUnit','total','canal','vendedor','formaPag','status'].join(';'));
      state.receitas.forEach(r => lines.push([compName(r.companyId),r.data,r.produto,r.qtd,r.valorUnit,(+r.qtd*+r.valorUnit).toFixed(2),r.canal,r.vendedor,r.formaPag,r.statusReceb].join(';')));
      lines.push(''); lines.push('CUSTOS FIXOS');
      lines.push(['empresa','descricao','categoria','valor','vencimento','status'].join(';'));
      state.custosFixos.forEach(x => lines.push([compName(x.companyId),x.descricao,x.categoria,x.valor,x.vencimento,x.status].join(';')));
      lines.push(''); lines.push('CONTAS A PAGAR');
      lines.push(['empresa','fornecedor','descricao','valor','vencimento','status'].join(';'));
      state.contasPagar.forEach(x => lines.push([compName(x.companyId),x.fornecedor,x.descricao,x.valor,x.vencimento,x.status].join(';')));
      lines.push(''); lines.push('CONTAS A RECEBER');
      lines.push(['empresa','cliente','descricao','valor','vencimento','status'].join(';'));
      state.contasReceber.forEach(x => lines.push([compName(x.companyId),x.cliente,x.descricao,x.valor,x.vencimento,x.status].join(';')));

      const blob = new Blob(['﻿'+lines.join('\n')], { type:'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const stamp = new Date().toISOString().slice(0,10);
      a.href = url; a.download = `tdf-bi-financeiro-${stamp}.csv`;
      a.click(); URL.revokeObjectURL(url);
    },
    clearAll() {
      if (!confirm('LIMPAR TODOS OS DADOS? Esta ação é irreversível. Considere exportar JSON antes.')) return;
      if (!confirm('Última confirmação: apagar empresas, produtos, custos, receitas e contas?')) return;
      state = defaultState(); save(); renderAll();
    },
    seedDemo() {
      if (state.companies.length > 0) {
        if (!confirm('Já existem dados. Adicionar dados de exemplo mesmo assim?')) return;
      }
      const demo = makeDemo();
      state.companies.push(...demo.companies);
      state.produtos.push(...demo.produtos);
      state.custosFixos.push(...demo.custosFixos);
      state.receitas.push(...demo.receitas);
      state.contasPagar.push(...demo.contasPagar);
      state.contasReceber.push(...demo.contasReceber);
      Object.assign(state.config.saldoInicial, demo.saldoInicial);
      if (state.activeCompanyId === 'consolidado' && state.companies.length > 0) {
        // mantém consolidado
      }
      save(); renderAll();
    },

    // sim
    simulate, simReset,

    // =====================================================================
    // ===== RELATÓRIOS PDF (jsPDF client-side) =====
    // =====================================================================
    _pdfHeader(doc, titulo, empresaNome, periodo) {
      doc.setFillColor(15, 20, 32);
      doc.rect(0, 0, doc.internal.pageSize.getWidth(), 22, 'F');
      doc.setTextColor(255, 255, 255);
      doc.setFontSize(15); doc.setFont('helvetica','bold');
      doc.text('TUDO DE FILTRO · BI Financeiro', 14, 10);
      doc.setFontSize(9); doc.setFont('helvetica','normal');
      doc.text(empresaNome || 'Grupo / Consolidado', 14, 17);
      doc.setTextColor(20, 20, 20);
      doc.setFontSize(13); doc.setFont('helvetica','bold');
      doc.text(titulo, 14, 32);
      doc.setFontSize(9); doc.setFont('helvetica','normal'); doc.setTextColor(100,100,100);
      doc.text((periodo || '—') + ' · gerado em ' + new Date().toLocaleString('pt-BR'), 14, 38);
      return 44; // y inicial pro conteúdo
    },
    _pdfFooter(doc) {
      const pages = doc.internal.getNumberOfPages();
      for (let i = 1; i <= pages; i++) {
        doc.setPage(i);
        doc.setFontSize(8); doc.setTextColor(150,150,150);
        const pw = doc.internal.pageSize.getWidth();
        const ph = doc.internal.pageSize.getHeight();
        doc.text('TDF · ' + new Date().getFullYear() + ' · uso interno', 14, ph - 8);
        doc.text('Página ' + i + ' de ' + pages, pw - 30, ph - 8);
      }
    },
    _pdfNomeArquivo(prefix, empresaNome) {
      const data = new Date().toISOString().slice(0,10);
      const slug = (empresaNome||'consolidado').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,30);
      return `${prefix}-${slug}-${data}.pdf`;
    },

    pdfDRE() {
      if (!window.jspdf) { alert('jsPDF não carregou.'); return; }
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();
      const r = calcResumoEmpresa(state.activeCompanyId);
      const empNome = state.activeCompanyId === 'consolidado' ? 'Grupo / Consolidado' : (state.companies.find(c=>c.id===state.activeCompanyId)?.nome || 'Empresa');
      const periodo = state.periodo ? 'Período ' + state.periodo : 'Todos os períodos';
      const y = this._pdfHeader(doc, 'DRE — Demonstrativo de Resultados', empNome, periodo);
      const pct = (v) => r.receitaTotal > 0 ? ((v/r.receitaTotal)*100).toFixed(1)+'%' : '-';
      doc.autoTable({
        startY: y,
        head: [['Conta', 'Valor (R$)', '% Receita']],
        body: [
          [{ content:'RECEITA OPERACIONAL', colSpan:3, styles:{ fillColor:[79,140,255], textColor:255, fontStyle:'bold' } }],
          ['  Vendas de produtos',          fmtBRL(r.receitaProd),    pct(r.receitaProd)],
          ['  Receitas avulsas',            fmtBRL(r.receitaAvulsa),  pct(r.receitaAvulsa)],
          [{ content:'  Receita bruta', styles:{ fontStyle:'bold' } }, { content:fmtBRL(r.receitaTotal), styles:{ fontStyle:'bold' } }, { content:'100,0%', styles:{ fontStyle:'bold' } }],
          [{ content:'CUSTOS VARIÁVEIS', colSpan:3, styles:{ fillColor:[239,68,68], textColor:255, fontStyle:'bold' } }],
          ['  CMV (custo dos produtos)',    '− '+fmtBRL(r.cmvTot),         '-'+pct(r.cmvTot)],
          ['  Frete',                       '− '+fmtBRL(r.custosFreteProd), '-'+pct(r.custosFreteProd)],
          ['  Impostos',                    '− '+fmtBRL(r.custosImpostos),  '-'+pct(r.custosImpostos)],
          ['  Comissões',                   '− '+fmtBRL(r.custosComissao),  '-'+pct(r.custosComissao)],
          ['  Outros var. (produto)',       '− '+fmtBRL(r.custosVarProd),   '-'+pct(r.custosVarProd)],
          ['  Outros var. (extra)',         '− '+fmtBRL(r.cvFixos),         '-'+pct(r.cvFixos)],
          [{ content:'  Total custos variáveis', styles:{ fontStyle:'bold' } }, { content:'− '+fmtBRL(r.custoVarTotal), styles:{ fontStyle:'bold' } }, { content:'-'+pct(r.custoVarTotal), styles:{ fontStyle:'bold' } }],
          [{ content:'MARGEM DE CONTRIBUIÇÃO', colSpan:3, styles:{ fillColor:[34,197,94], textColor:255, fontStyle:'bold' } }],
          [{ content:'  Margem de contribuição', styles:{ fontStyle:'bold' } }, { content:fmtBRL(r.receitaTotal - r.custoVarTotal), styles:{ fontStyle:'bold' } }, { content:pct(r.receitaTotal - r.custoVarTotal), styles:{ fontStyle:'bold' } }],
          [{ content:'DESPESAS FIXAS', colSpan:3, styles:{ fillColor:[245,158,11], textColor:255, fontStyle:'bold' } }],
          ['  Total custos fixos',          '− '+fmtBRL(r.cfTotal),         '-'+pct(r.cfTotal)],
          [{ content:'RESULTADO LÍQUIDO', colSpan:3, styles:{ fillColor:[15,20,32], textColor:255, fontStyle:'bold' } }],
          [{ content:'  Lucro líquido', styles:{ fontStyle:'bold', fontSize:11 } }, { content:fmtBRL(r.lucroLiquido), styles:{ fontStyle:'bold', fontSize:11, textColor: r.lucroLiquido>=0?[34,197,94]:[239,68,68] } }, { content:fmtPct(r.margemLiq), styles:{ fontStyle:'bold', fontSize:11 } }],
        ],
        styles: { fontSize:9, cellPadding:3 },
        headStyles: { fillColor:[30, 30, 50], textColor:255, fontSize:9 },
        columnStyles: { 0:{cellWidth:90}, 1:{halign:'right',cellWidth:50}, 2:{halign:'right',cellWidth:30} },
        theme: 'grid',
      });
      const yEnd = doc.lastAutoTable.finalY + 8;
      doc.setFontSize(9); doc.setTextColor(80,80,80);
      doc.text(`Break-even (faturamento mínimo): ${fmtBRL(r.breakEven)}`, 14, yEnd);
      doc.text(`Margem de contribuição média: ${fmtPct(r.margemContribMedia)}`, 14, yEnd + 5);
      this._pdfFooter(doc);
      doc.save(this._pdfNomeArquivo('DRE', empNome));
    },

    pdfFluxoCaixa() {
      if (!window.jspdf) { alert('jsPDF não carregou.'); return; }
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();
      const r = calcResumoEmpresa(state.activeCompanyId);
      const empNome = state.activeCompanyId === 'consolidado' ? 'Grupo / Consolidado' : (state.companies.find(c=>c.id===state.activeCompanyId)?.nome || 'Empresa');
      const y = this._pdfHeader(doc, 'Fluxo de Caixa Projetado', empNome, 'Próximos 6 meses');
      // Replica a projeção (mesma fórmula do renderCaixa)
      const start = new Date(); start.setDate(1);
      const rows = []; let saldo = r.saldoIni;
      for (let i = 0; i < 6; i++) {
        const d = new Date(start.getFullYear(), start.getMonth()+i, 1);
        const lbl = d.toLocaleDateString('pt-BR',{month:'short',year:'2-digit'});
        const ent = r.receitaTotal;
        const sai = r.custoVarTotal + r.cfTotal;
        const res = ent - sai; saldo += res;
        rows.push([lbl, fmtBRL(ent), '− '+fmtBRL(sai), { content: fmtBRL(res), styles: { textColor: res<0?[239,68,68]:[34,197,94] } }, { content: fmtBRL(saldo), styles: { fontStyle:'bold', textColor: saldo<0?[239,68,68]:[20,20,20] } }]);
      }
      doc.autoTable({
        startY: y,
        head: [['Mês', 'Entradas', 'Saídas', 'Resultado', 'Saldo acumulado']],
        body: [
          [{ content:'Saldo inicial', colSpan:4, styles:{ fontStyle:'bold' } }, { content: fmtBRL(r.saldoIni), styles:{ fontStyle:'bold' } }],
          ...rows,
        ],
        styles: { fontSize:9, cellPadding:4 },
        headStyles: { fillColor:[79,140,255], textColor:255 },
        columnStyles: { 0:{cellWidth:30}, 1:{halign:'right'}, 2:{halign:'right'}, 3:{halign:'right'}, 4:{halign:'right',cellWidth:35} },
        theme:'striped',
      });
      const yEnd = doc.lastAutoTable.finalY + 8;
      doc.setFontSize(10); doc.setFont('helvetica','bold');
      doc.text('Resumo', 14, yEnd);
      doc.autoTable({
        startY: yEnd + 4,
        body: [
          ['Saldo inicial', fmtBRL(r.saldoIni)],
          ['Receita do período', fmtBRL(r.receitaTotal)],
          ['Contas a receber em aberto', fmtBRL(r.totalCAR)],
          ['Custos variáveis', '− '+fmtBRL(r.custoVarTotal)],
          ['Custos fixos', '− '+fmtBRL(r.cfTotal)],
          ['Contas a pagar em aberto', '− '+fmtBRL(r.totalCAP)],
          [{ content:'Saldo projetado', styles:{ fontStyle:'bold' } }, { content: fmtBRL(r.saldoCaixaProj), styles:{ fontStyle:'bold', textColor: r.saldoCaixaProj<0?[239,68,68]:[34,197,94] } }],
        ],
        styles: { fontSize:9 }, theme:'plain',
        columnStyles: { 0:{cellWidth:90}, 1:{halign:'right',cellWidth:60} },
      });
      this._pdfFooter(doc);
      doc.save(this._pdfNomeArquivo('Fluxo-Caixa', empNome));
    },

    pdfDemonstrativo() {
      if (!window.jspdf) { alert('jsPDF não carregou.'); return; }
      const { jsPDF } = window.jspdf;
      const doc = new jsPDF();
      const r = calcResumoEmpresa(state.activeCompanyId);
      const empNome = state.activeCompanyId === 'consolidado' ? 'Grupo / Consolidado' : (state.companies.find(c=>c.id===state.activeCompanyId)?.nome || 'Empresa');
      const periodo = state.periodo || 'Todos os períodos';
      let y = this._pdfHeader(doc, 'Demonstrativo Financeiro Executivo', empNome, periodo);
      // Box KPIs principais
      const cards = [
        ['Faturamento', fmtBRL(r.receitaTotal), [79,140,255]],
        ['Lucro Líquido', fmtBRL(r.lucroLiquido), r.lucroLiquido>=0?[34,197,94]:[239,68,68]],
        ['Margem Líquida', fmtPct(r.margemLiq), r.margemLiq>=0.10?[34,197,94]:r.margemLiq>=0?[245,158,11]:[239,68,68]],
        ['Saldo Caixa Proj.', fmtBRL(r.saldoCaixaProj), r.saldoCaixaProj>=0?[34,197,94]:[239,68,68]],
      ];
      const cardW = 44, cardH = 22, gap = 4;
      cards.forEach((c, i) => {
        const x = 14 + (cardW+gap)*i;
        doc.setFillColor(...c[2]); doc.roundedRect(x, y, cardW, cardH, 2, 2, 'F');
        doc.setTextColor(255,255,255);
        doc.setFontSize(7); doc.setFont('helvetica','normal');
        doc.text(c[0], x+3, y+6);
        doc.setFontSize(11); doc.setFont('helvetica','bold');
        doc.text(c[1], x+3, y+15);
      });
      doc.setTextColor(20,20,20);
      y += cardH + 10;
      // DRE compacto
      doc.setFontSize(11); doc.setFont('helvetica','bold');
      doc.text('Resultado do Período', 14, y); y += 4;
      doc.autoTable({
        startY: y,
        body: [
          ['Receita bruta',        fmtBRL(r.receitaTotal)],
          ['(−) Custos variáveis', '− '+fmtBRL(r.custoVarTotal)],
          [{ content:'Margem de contribuição', styles:{ fontStyle:'bold' } }, { content: fmtBRL(r.receitaTotal - r.custoVarTotal), styles:{ fontStyle:'bold' } }],
          ['(−) Custos fixos',     '− '+fmtBRL(r.cfTotal)],
          [{ content:'Lucro líquido', styles:{ fontStyle:'bold' } }, { content: fmtBRL(r.lucroLiquido), styles:{ fontStyle:'bold', textColor: r.lucroLiquido<0?[239,68,68]:[34,197,94] } }],
        ],
        styles:{ fontSize:9 }, theme:'plain',
        columnStyles:{ 0:{cellWidth:120}, 1:{halign:'right',cellWidth:60} },
      });
      y = doc.lastAutoTable.finalY + 8;
      // Indicadores
      doc.setFont('helvetica','bold'); doc.setFontSize(11);
      doc.text('Indicadores', 14, y); y += 4;
      doc.autoTable({
        startY: y,
        body: [
          ['Break-even (faturamento mínimo)', fmtBRL(r.breakEven)],
          ['Margem de contribuição média',    fmtPct(r.margemContribMedia)],
          ['Despesas fixas / Receita',         r.receitaTotal>0?fmtPct(r.cfTotal/r.receitaTotal):'-'],
          ['Contas a pagar em aberto',         fmtBRL(r.totalCAP)],
          ['Contas a receber em aberto',       fmtBRL(r.totalCAR)],
          ['Produtos cadastrados',             String(r.qtdProdutos)],
        ],
        styles:{ fontSize:9 }, theme:'striped',
        columnStyles:{ 0:{cellWidth:120}, 1:{halign:'right',cellWidth:60} },
      });
      // Ranking empresas se for consolidado
      if (state.activeCompanyId === 'consolidado' && state.companies.length > 0) {
        y = doc.lastAutoTable.finalY + 8;
        doc.setFont('helvetica','bold'); doc.setFontSize(11);
        doc.text('Ranking de empresas (lucro líquido)', 14, y); y += 4;
        const ranking = state.companies.map(c => {
          const rr = calcResumoEmpresa(c.id);
          return [c.nome, fmtBRL(rr.receitaTotal), { content: fmtBRL(rr.lucroLiquido), styles:{ textColor: rr.lucroLiquido<0?[239,68,68]:[34,197,94], fontStyle:'bold' } }, fmtPct(rr.margemLiq)];
        }).sort((a,b) => parseFloat(String(b[2].content||b[2]).replace(/[^\d-,]/g,'').replace(',','.')) - parseFloat(String(a[2].content||a[2]).replace(/[^\d-,]/g,'').replace(',','.')));
        doc.autoTable({
          startY: y,
          head: [['Empresa','Faturamento','Lucro líquido','Margem']],
          body: ranking,
          styles:{ fontSize:9 }, headStyles:{ fillColor:[79,140,255], textColor:255 },
          columnStyles:{ 1:{halign:'right'}, 2:{halign:'right'}, 3:{halign:'right'} },
        });
      }
      this._pdfFooter(doc);
      doc.save(this._pdfNomeArquivo('Demonstrativo', empNome));
    },

    async pdfPagamentos() {
      if (!window.jspdf) { alert('jsPDF não carregou.'); return; }
      const { jsPDF } = window.jspdf;
      // Busca dados frescos da API
      const status = document.getElementById('bifPgFiltroStatus')?.value || '';
      const empresa = document.getElementById('bifPgFiltroEmpresa')?.value || '';
      const qs = new URLSearchParams();
      if (status) qs.set('status', status);
      if (empresa) qs.set('empresaBI', empresa);
      let list = [];
      try { const r = await fetch('/bi-financeiro/api/pagamentos?'+qs).then(r=>r.json()); list = r.pagamentos||[]; }
      catch(e) { alert('Erro ao buscar pagamentos: '+e.message); return; }
      const doc = new jsPDF({ orientation: 'landscape' });
      const empNome = empresa ? (state.companies.find(c=>c.id===empresa)?.nome||'Empresa') : 'Todas as empresas';
      const titulo = 'Contas a Pagar' + (status?` · status: ${status}`:'');
      const y = this._pdfHeader(doc, titulo, empNome, '');
      const total = list.reduce((s,p) => s+(+p.valor||0), 0);
      const totalAberto = list.filter(p => !['pago','reprovado','cancelado'].includes(p.status)).reduce((s,p) => s+(+p.valor||0), 0);
      const body = list.map(p => [
        p.status,
        state.companies.find(c=>c.id===p.empresaBI)?.nome || '—',
        p.fornecedor || '—',
        (p.descricao||'').slice(0,40),
        fmtBRL(p.valor),
        p.vencimento || '—',
        p.solicitadoPor || '—',
        p.aprovadoPor || p.reprovadoPor || '—',
      ]);
      doc.autoTable({
        startY: y,
        head: [['Status','Empresa','Fornecedor','Descrição','Valor','Vencimento','Solicitado','Aprovador']],
        body, styles:{ fontSize:8, cellPadding:2 },
        headStyles:{ fillColor:[15,20,32], textColor:255 },
        columnStyles:{ 4:{halign:'right'} },
        theme:'striped',
      });
      const yEnd = doc.lastAutoTable.finalY + 6;
      doc.setFontSize(10); doc.setFont('helvetica','bold');
      doc.text(`Total geral: ${fmtBRL(total)}    ·    Em aberto: ${fmtBRL(totalAberto)}    ·    Registros: ${list.length}`, 14, yEnd);
      this._pdfFooter(doc);
      doc.save(this._pdfNomeArquivo('Pagamentos', empNome));
    },

    async pdfRecebimentos() {

    // ===== VENDAS ZOHO =====
    vzState: { vendas: [], filtered: [], lastSync: null, loading: false },
    _vzDeb: null,

    async vzInit() {
      // datas default = últimos 30 dias
      const to = new Date();
      const from = new Date(); from.setDate(from.getDate() - 30);
      const fmt = d => d.toISOString().slice(0,10);
      const fEl = document.getElementById('bifVzFrom');
      const tEl = document.getElementById('bifVzTo');
      if (!fEl.value) fEl.value = fmt(from);
      if (!tEl.value) tEl.value = fmt(to);
      // popula empresa BI
      this.vzPopulateEmpresaSel();
      // busca owners + vendas
      await this.vzLoadOwners();
      await this.vzReload();
    },

    async vzLoadOwners() {
      try {
        const r = await fetch('/bi-financeiro/api/owners');
        const j = await r.json();
        const sel = document.getElementById('bifVzOwner');
        const cur = sel.value;
        sel.innerHTML = '<option value="">Todos</option>' + (j.owners||[]).map(o => `<option value="${escapeHtml(o)}">${escapeHtml(o)}</option>`).join('');
        sel.value = cur;
      } catch(e){ console.warn('owners', e); }
    },

    vzPopulateEmpresaSel() {
      const opts = '<option value="">Todas</option><option value="__none">(sem empresa associada)</option>' +
        state.companies.map(c => `<option value="${c.id}">${escapeHtml(c.nome)}</option>`).join('');
      const f1 = document.getElementById('bifVzEmpresa'); if (f1) { const cur=f1.value; f1.innerHTML=opts; f1.value=cur; }
      // Modal
      const f2 = document.getElementById('bifVzFichaEmpresa');
      if (f2) {
        const cur = f2.value;
        f2.innerHTML = '<option value="">— sem empresa associada —</option>' +
          state.companies.map(c => `<option value="${c.id}">${escapeHtml(c.nome)}</option>`).join('');
        f2.value = cur;
      }
    },

    async vzReload() {
      const from = document.getElementById('bifVzFrom').value;
      const to = document.getElementById('bifVzTo').value;
      const owner = document.getElementById('bifVzOwner').value;
      const search = document.getElementById('bifVzSearch').value;
      const mods = [];
      if (document.getElementById('bifVzModDeals').checked) mods.push('Deals');
      if (document.getElementById('bifVzModQuotes').checked) mods.push('Quotes');
      if (document.getElementById('bifVzModSO').checked) mods.push('Sales_Orders');
      if (mods.length === 0) {
        document.getElementById('bifVzTbody').innerHTML = '<tr><td colspan="12" class="bif-empty">Selecione ao menos um módulo (Deals/Quotes/Sales Orders).</td></tr>';
        return;
      }
      this.vzState.loading = true;
      document.getElementById('bifVzStatusMsg').textContent = '⏳ Carregando do Zoho...';
      try {
        const url = `/bi-financeiro/api/vendas-zoho?from=${from}&to=${to}&owner=${encodeURIComponent(owner)}&search=${encodeURIComponent(search)}&modules=${mods.join(',')}`;
        const r = await fetch(url);
        const j = await r.json();
        if (!j.ok) throw new Error(j.error || 'erro');
        this.vzState.vendas = j.vendas || [];
        this.vzState.lastSync = new Date();
        document.getElementById('bifVzStatusMsg').textContent = `✓ ${j.total} vendas carregadas`;
        this.vzApplyFilters();
        this.vzRenderRelatorios();
      } catch(e) {
        document.getElementById('bifVzStatusMsg').innerHTML = '<span style="color:#EF4444">❌ ' + escapeHtml(e.message) + '</span>';
        document.getElementById('bifVzTbody').innerHTML = `<tr><td colspan="12" class="bif-empty"><div class="ico">❌</div>Erro ao carregar Zoho: ${escapeHtml(e.message)}.<br>Verifique se ZOHO_REFRESH_TOKEN está configurado em produção.</td></tr>`;
      } finally {
        this.vzState.loading = false;
      }
    },

    vzReloadFilters() { this.vzApplyFilters(); this.vzRenderRelatorios(); },
    vzDebounceFilters() { clearTimeout(this._vzDeb); this._vzDeb = setTimeout(() => this.vzReloadFilters(), 250); },

    vzApplyFilters() {
      const empresaF = document.getElementById('bifVzEmpresa').value;
      const statusF = document.getElementById('bifVzStatus').value;
      const search = (document.getElementById('bifVzSearch').value || '').toLowerCase();
      let list = this.vzState.vendas.slice();
      if (empresaF === '__none') list = list.filter(v => !v.ficha?.empresaBI);
      else if (empresaF) list = list.filter(v => v.ficha?.empresaBI === empresaF);
      if (statusF) list = list.filter(v => (v.calc?.status || 'sem-dados') === statusF);
      if (search) list = list.filter(v => {
        const hay = ((v.titulo||'')+' '+(v.cliente||'')+' '+(v.produtos||[]).join(' ')+' '+(v.vendedor||'')).toLowerCase();
        return hay.includes(search);
      });
      this.vzState.filtered = list;
      this.vzRenderTable();
      this.vzRenderKpis();
    },

    vzRenderKpis() {
      const list = this.vzState.filtered;
      const today = new Date().toISOString().slice(0,10);
      const hoje = list.filter(v => v.data === today);
      const recHoje = hoje.reduce((s,v) => s+(+v.calc?.receitaLiquida||+v.valor||0), 0);
      const lucroHoje = hoje.reduce((s,v) => s+(+v.calc?.lucro||0), 0);
      const recPeriodo = list.reduce((s,v) => s+(+v.calc?.receitaLiquida||+v.valor||0), 0);
      const lucroPeriodo = list.reduce((s,v) => s+(+v.calc?.lucro||0), 0);
      const margemMedia = recPeriodo > 0 ? lucroPeriodo/recPeriodo : 0;
      const comTotal = list.reduce((s,v) => s+(+v.ficha?.custos?.comissao||0), 0);
      const freteTotal = list.reduce((s,v) => s+(+v.ficha?.custos?.frete||0), 0);
      const instalTotal = list.reduce((s,v) => s+(+v.ficha?.custos?.instalacao||0), 0);
      const semFicha = list.filter(v => (v.calc?.status||'sem-dados')==='sem-dados').length;
      const prejuizo = list.filter(v => v.calc?.status==='prejuizo').length;
      const margemBaixa = list.filter(v => v.calc?.status==='atencao').length;
      const cards = [
        { lbl:'Vendas hoje', val:hoje.length+'', klass:'info' },
        { lbl:'Faturamento hoje', val:fmtBRL(recHoje), klass:'info' },
        { lbl:'Lucro real hoje', val:fmtBRL(lucroHoje), klass:lucroHoje>=0?'ok':'bad' },
        { lbl:'Vendas no período', val:list.length+'', klass:'info' },
        { lbl:'Faturamento período', val:fmtBRL(recPeriodo), klass:'info' },
        { lbl:'Lucro real período', val:fmtBRL(lucroPeriodo), klass:lucroPeriodo>=0?'ok':'bad' },
        { lbl:'Margem média', val:fmtPct(margemMedia), klass:margemMedia>=0.10?'ok':margemMedia>=0?'warn':'bad' },
        { lbl:'Comissão total', val:fmtBRL(comTotal), klass:'warn' },
        { lbl:'Frete total', val:fmtBRL(freteTotal), klass:'warn' },
        { lbl:'Instalação total', val:fmtBRL(instalTotal), klass:'warn' },
        { lbl:'⚠️ Margem baixa', val:margemBaixa+'', klass:margemBaixa>0?'warn':'ok' },
        { lbl:'🔴 Com prejuízo', val:prejuizo+'', klass:prejuizo>0?'bad':'ok', sub:semFicha>0?(semFicha+' sem ficha'):'' },
      ];
      document.getElementById('bifVzKpis').innerHTML = cards.map(c =>
        `<div class="bif-kpi ${c.klass}"><div class="lbl">${c.lbl}</div><div class="val">${c.val}</div>${c.sub?`<div class="sub">${c.sub}</div>`:''}</div>`).join('');
    },

    vzRenderTable() {
      const tb = document.getElementById('bifVzTbody');
      const list = this.vzState.filtered;
      if (list.length === 0) {
        tb.innerHTML = '<tr><td colspan="12" class="bif-empty"><div class="ico">🔍</div>Nenhuma venda no período/filtros. Ajuste o intervalo de datas ou clique em "Sincronizar Zoho".</td></tr>';
        return;
      }
      tb.innerHTML = list.map(v => {
        const c = v.calc || {};
        const stClass = c.status==='lucrativa'?'ok':c.status==='atencao'?'warn':c.status==='prejuizo'?'bad':'muted';
        const stIco = c.status==='lucrativa'?'✅':c.status==='atencao'?'⚠️':c.status==='prejuizo'?'🔴':'⚪';
        const empNome = v.ficha?.empresaBI ? (state.companies.find(x=>x.id===v.ficha.empresaBI)?.nome || '—') : '—';
        const modBadge = v.module === 'Deals' ? '🤝 Deal' : v.module === 'Quotes' ? '📋 Quote' : '📦 SO';
        const prods = (v.produtos||[]).slice(0,2).join(', ') + ((v.produtos||[]).length>2 ? ' +'+((v.produtos.length-2))+'' : '') || '—';
        return `<tr style="cursor:pointer" onclick="BIF.vzOpenFicha('${v.module}','${v.zohoId}')">
          <td><span class="bif-pill info">${modBadge}</span></td>
          <td>${v.data || '—'}</td>
          <td><b>${escapeHtml(v.cliente || v.titulo || '—')}</b><div class="muted" style="font-size:10.5px">${escapeHtml(v.titulo||'')}</div></td>
          <td style="font-size:11.5px">${escapeHtml(prods)}</td>
          <td>${escapeHtml(v.vendedor||'—')}</td>
          <td class="col-num"><b>${fmtBRL(c.receitaLiquida||v.valor||0)}</b></td>
          <td class="col-num bad">${fmtBRL(c.custoTotal||0)}</td>
          <td class="col-num ${(c.lucro||0)>=0?'ok':'bad'}"><b>${fmtBRL(c.lucro||0)}</b></td>
          <td class="col-num">${fmtPct(c.margemLiquida||0)}</td>
          <td style="font-size:11.5px">${escapeHtml(empNome)}</td>
          <td><span class="bif-pill ${stClass}">${stIco} ${c.status||'—'}</span></td>
          <td class="col-act"><button class="bif-btn sm primary" onclick="event.stopPropagation();BIF.vzOpenFicha('${v.module}','${v.zohoId}')">📝 Ficha</button></td>
        </tr>`;
      }).join('');
    },

    vzRenderRelatorios() {
      const list = this.vzState.filtered.length > 0 ? this.vzState.filtered : this.vzState.vendas;
      // Por vendedor
      const porVend = {};
      const porProd = {};
      const porEmp = {};
      const porDia = {};
      list.forEach(v => {
        const c = v.calc || {};
        const lucro = +c.lucro||0; const rec = +c.receitaLiquida||+v.valor||0;
        if (v.vendedor) {
          porVend[v.vendedor] = porVend[v.vendedor] || { rec:0, lucro:0, count:0 };
          porVend[v.vendedor].rec += rec; porVend[v.vendedor].lucro += lucro; porVend[v.vendedor].count++;
        }
        (v.produtos||[]).forEach(p => {
          porProd[p] = porProd[p] || { rec:0, lucro:0, count:0 };
          porProd[p].rec += rec / Math.max(1,(v.produtos||[]).length);
          porProd[p].lucro += lucro / Math.max(1,(v.produtos||[]).length);
          porProd[p].count++;
        });
        const empId = v.ficha?.empresaBI || '__none';
        porEmp[empId] = porEmp[empId] || { rec:0, lucro:0, count:0 };
        porEmp[empId].rec += rec; porEmp[empId].lucro += lucro; porEmp[empId].count++;
        if (v.data) {
          porDia[v.data] = porDia[v.data] || { rec:0, lucro:0, count:0 };
          porDia[v.data].rec += rec; porDia[v.data].lucro += lucro; porDia[v.data].count++;
        }
      });
      const renderRanking = (obj, target, nameFn) => {
        const arr = Object.entries(obj).map(([k,v]) => ({ k, ...v })).sort((a,b) => b.lucro - a.lucro);
        const el = document.getElementById(target);
        if (!el) return;
        if (arr.length === 0) { el.innerHTML = '<div class="bif-empty" style="padding:14px">Sem dados.</div>'; return; }
        el.innerHTML = arr.slice(0,15).map((x,i) => `<div class="bif-rank-row">
          <div class="pos">${i+1}º</div>
          <div class="nm">${escapeHtml(nameFn ? nameFn(x.k) : x.k)}<div class="muted" style="font-size:10.5px">${x.count} venda(s) · receita ${fmtBRL(x.rec)}</div></div>
          <div class="vl ${x.lucro<0?'bad':'ok'}">${fmtBRL(x.lucro)}</div>
        </div>`).join('');
      };
      renderRanking(porVend, 'bifRzVendedor');
      renderRanking(porProd, 'bifRzProduto');
      renderRanking(porEmp, 'bifRzEmpresa', k => k==='__none' ? '(sem empresa)' : (state.companies.find(c=>c.id===k)?.nome || k));

      // Lucro por dia (gráfico)
      const dias = Object.keys(porDia).sort();
      const labels = dias;
      const lucros = dias.map(d => porDia[d].lucro);
      const recs   = dias.map(d => porDia[d].rec);
      const ctx = document.getElementById('bifChartLucroDia');
      if (ctx && labels.length > 0) {
        if (window.__chartLucroDia) window.__chartLucroDia.destroy();
        window.__chartLucroDia = new Chart(ctx, { type:'bar', data:{ labels, datasets:[
          { label:'Receita', data:recs, backgroundColor:'#22C55E', stack:'1' },
          { label:'Lucro real', type:'line', data:lucros, borderColor:'#4F8CFF', backgroundColor:'#4F8CFF22', tension:.3 }
        ]}, options:{ responsive:true, maintainAspectRatio:false,
          plugins:{ legend:{labels:{color:'#8899AA',font:{size:11}}}, tooltip:{ callbacks:{ label:(c)=>c.dataset.label+': '+fmtBRL(c.parsed.y) } } },
          scales:{ x:{ticks:{color:'#8899AA'},grid:{color:'#1a1f35'}}, y:{ticks:{color:'#8899AA',callback:v=>'R$ '+(v/1000).toFixed(1)+'k'},grid:{color:'#1a1f35'}} }
        }});
      } else if (ctx) {
        if (window.__chartLucroDia) { window.__chartLucroDia.destroy(); window.__chartLucroDia=null; }
        ctx.parentElement.innerHTML = '<div class="bif-empty" style="padding:30px">Sem dados.</div>';
      }

      // Listas críticas
      const prejs = list.filter(v => v.calc?.status==='prejuizo').sort((a,b) => (a.calc?.lucro||0)-(b.calc?.lucro||0)).slice(0,15);
      const baixas = list.filter(v => v.calc?.status==='atencao').sort((a,b) => (a.calc?.margemLiquida||0)-(b.calc?.margemLiquida||0)).slice(0,15);
      const renderCritica = (arr, target, isPrej) => {
        const el = document.getElementById(target); if (!el) return;
        if (arr.length === 0) { el.innerHTML = '<div class="bif-empty" style="padding:14px">✅ Nenhuma venda nesta categoria.</div>'; return; }
        el.innerHTML = arr.map(v => `<div class="bif-rank-row" style="cursor:pointer" onclick="BIF.vzOpenFicha('${v.module}','${v.zohoId}')">
          <div class="pos" style="color:${isPrej?'#EF4444':'#F59E0B'}">${isPrej?'🔴':'⚠️'}</div>
          <div class="nm">${escapeHtml(v.cliente || v.titulo)}<div class="muted" style="font-size:10.5px">${v.data} · ${escapeHtml(v.vendedor||'')} · ${fmtBRL(v.calc?.receitaLiquida||v.valor||0)}</div></div>
          <div class="vl ${isPrej?'bad':'warn'}">${fmtBRL(v.calc?.lucro||0)}<div class="muted" style="font-size:10.5px;font-weight:400">${fmtPct(v.calc?.margemLiquida||0)}</div></div>
        </div>`).join('');
      };
      renderCritica(prejs, 'bifRzPrejuizos', true);
      renderCritica(baixas, 'bifRzMargemBaixa', false);
    },

    async vzSync() {
      document.getElementById('bifVzStatusMsg').textContent = '⏳ Sincronizando com Zoho...';
      try {
        const r = await fetch('/bi-financeiro/api/sync', { method:'POST' });
        const j = await r.json();
        if (!j.ok) throw new Error(j.error || 'erro sync');
        document.getElementById('bifVzStatusMsg').innerHTML = `✓ Sync OK — Deals: ${j.counts.Deals} · Quotes: ${j.counts.Quotes} · SO: ${j.counts.Sales_Orders}`;
        await this.vzLoadOwners();
        await this.vzReload();
      } catch(e) {
        document.getElementById('bifVzStatusMsg').innerHTML = '<span style="color:#EF4444">❌ ' + escapeHtml(e.message) + '</span>';
      }
    },

    async vzOpenFicha(module, zohoId) {
      // Acha venda na lista atual; se não tiver, busca individualmente
      let v = this.vzState.vendas.find(x => x.module===module && x.zohoId===zohoId);
      if (!v) {
        try {
          const r = await fetch(`/bi-financeiro/api/venda/${module}/${zohoId}`);
          const j = await r.json();
          if (j.ok) v = j.venda;
        } catch(_){}
      }
      if (!v) { alert('Venda não encontrada.'); return; }
      this._vzCurr = v;
      const md = document.getElementById('bifVzFichaModal');
      document.getElementById('bifVzFichaBadge').textContent = module === 'Deals' ? '🤝 Deal' : module === 'Quotes' ? '📋 Quote' : '📦 Sales Order';
      document.getElementById('bifVzFichaTitle').textContent = v.titulo || v.cliente || 'Ficha';
      document.getElementById('bifVzFichaZohoId').textContent = zohoId;
      const zohoModulePath = { Deals: 'Potentials', Quotes: 'Quotes', Sales_Orders: 'SalesOrders' }[module] || module;
      document.getElementById('bifVzFichaLink').href = `https://crm.zoho.com/crm/tab/${zohoModulePath}/${zohoId}`;
      document.getElementById('bifVzFichaCliente').textContent = v.cliente || '—';
      document.getElementById('bifVzFichaVendedor').textContent = v.vendedor || '—';
      document.getElementById('bifVzFichaData').textContent = v.data || '—';
      document.getElementById('bifVzFichaStage').textContent = v.stage || '—';
      document.getElementById('bifVzFichaOrigem').textContent = v.origem || '—';
      const cidadeStr = [v.cidade, v.estado].filter(Boolean).join(' / ') || '—';
      document.getElementById('bifVzFichaCidade').textContent = cidadeStr;
      // Pipeline (Deals) ou Tipo de venda + ID ERP + link cruzado
      const ppParts = [];
      if (v.pipeline) ppParts.push(v.pipeline + (v.layout?(' · '+v.layout):''));
      if (v.tipoVenda) ppParts.push('Tipo: '+v.tipoVenda);
      if (v.idERP)    ppParts.push('ERP #'+v.idERP);
      if (v.empresaZoho) ppParts.push('Empresa Zoho: <b style="color:#22C55E">'+escapeHtml(v.empresaZoho)+'</b>');
      const links = [];
      if (v.dealLink)  links.push(`<a target="_blank" style="color:#4F8CFF" href="https://crm.zoho.com/crm/tab/Potentials/${v.dealLink.id}">↗ Deal: ${escapeHtml(v.dealLink.nome)}</a>`);
      if (v.quoteLink) links.push(`<a target="_blank" style="color:#4F8CFF" href="https://crm.zoho.com/crm/tab/Quotes/${v.quoteLink.id}">↗ Quote: ${escapeHtml(v.quoteLink.nome)}</a>`);
      document.getElementById('bifVzFichaPipeline').innerHTML = ppParts.join(' · ') + (links.length?'<div style="margin-top:4px;font-size:11px">'+links.join(' · ')+'</div>':'') || '—';
      document.getElementById('bifVzFichaValor').textContent = fmtBRL(v.valor || 0);

      // Itens (produtos do Quote/Deal)
      const itensBox = document.getElementById('bifVzFichaItens');
      if ((v.itens||[]).length > 0) {
        itensBox.innerHTML = '<div style="margin-top:10px"><div class="muted" style="font-size:11px;font-weight:700;text-transform:uppercase;margin-bottom:4px">Itens da venda</div>' +
          '<table style="width:100%;font-size:12px;border-collapse:collapse"><thead><tr style="background:#171c2e"><th style="text-align:left;padding:5px 8px">Produto</th><th style="text-align:right;padding:5px 8px">Qtd</th><th style="text-align:right;padding:5px 8px">Valor</th></tr></thead><tbody>' +
          v.itens.map(it => `<tr><td style="padding:5px 8px;border-bottom:1px solid #1a1f35">${escapeHtml(it.nome||'—')}</td><td style="text-align:right;padding:5px 8px;border-bottom:1px solid #1a1f35">${fmtNum(it.qtd)}</td><td style="text-align:right;padding:5px 8px;border-bottom:1px solid #1a1f35">${fmtBRL(it.valor)}</td></tr>`).join('') +
          '</tbody></table></div>';
      } else {
        itensBox.innerHTML = '';
      }

      // Empresa BI dropdown + valores ficha
      this.vzPopulateEmpresaSel();
      const empSel = document.getElementById('bifVzFichaEmpresa');
      let empMatch = v.ficha?.empresaBI || '';
      // Se ficha é nova e tem Empresa_da_venda no Zoho, tenta match automático
      if (v.fichaNova && v.empresaZoho && !empMatch) {
        empMatch = this._vzMatchEmpresa(v.empresaZoho) || '';
      }
      empSel.value = empMatch;
      document.getElementById('bifVzFichaForma').value = v.ficha?.formaPagamento || '';
      document.getElementById('bifVzFichaObs').value = v.ficha?.obs || '';

      // Indicador "sugerido pelo Zoho" se ficha é nova com prefill
      if (v.fichaNova && v.prefill && (v.prefill.frete > 0 || v.prefill.comissao > 0 || v.prefill.formaPagamento)) {
        document.getElementById('bifVzFichaStatus').className = 'bif-pill info';
        document.getElementById('bifVzFichaStatus').textContent = '🆕 Pré-preenchido pelo Zoho — revise e salve';
      }

      // Custos editáveis
      const labels = {
        custoProduto:'Custo do produto (CMV)',
        frete:'Frete',
        taxaCartao:'Taxa do cartão',
        comissao:'Comissão do vendedor',
        instalacao:'Mão de obra instalação',
        material:'Material de instalação',
        materialTrabalho:'Material de trabalho',
        gasolina:'Deslocamento / gasolina',
        pedagio:'Pedágio',
        maoDeObra:'Mão de obra (outros)',
        operacional:'Operacional estimado',
        garantia:'Garantia / retrabalho',
        custoLogistico:'Custo logístico (rota) 🤖',
        custoMateriais:'Materiais usados na OS 🔧',
        outros:'Outros custos',
        desconto:'Desconto concedido'
      };
      const custos = (v.ficha && v.ficha.custos) || {};
      const fields = ['custoProduto','frete','taxaCartao','comissao','instalacao','material','materialTrabalho','gasolina','pedagio','maoDeObra','operacional','garantia','custoLogistico','custoMateriais','outros','desconto'];
      const cl = v.custoLogisticoDetalhe;
      const cm = v.custoMateriaisDetalhe;
      document.getElementById('bifVzCustosBox').innerHTML = fields.map(f => {
        const autoLog = (f === 'custoLogistico');
        const autoMat = (f === 'custoMateriais');
        let hint = '';
        if (autoLog && cl) hint = `<div class="muted" style="font-size:10.5px;margin-top:2px">Auto-calculado: ${cl.rotas?.length||1} rota(s) · veja Logística pra detalhes</div>`;
        if (autoMat && cm) hint = `<div class="muted" style="font-size:10.5px;margin-top:2px">Auto-calculado: ${cm.oss?.length||1} OS(s) · veja OS Materiais</div>`;
        const isAuto = (autoLog && cl) || (autoMat && cm);
        const disabled = isAuto ? 'readonly style="background:#0a1a0a;border-color:#22C55E"' : '';
        return `<div>
          <label>${labels[f]}</label>
          <input type="number" step="0.01" min="0" value="${custos[f] || 0}" data-custo="${f}" oninput="BIF.vzRecalc()" ${disabled}>
          ${hint}
        </div>`;
      }).join('');

      this.vzRecalc();
      md.classList.add('show');
    },
    vzCloseFicha() { document.getElementById('bifVzFichaModal').classList.remove('show'); this._vzCurr = null; },

    _vzMatchEmpresa(empresaZohoStr) {
      // Match Empresa_da_venda (Zoho, texto livre/picklist) → empresaBI cadastrada.
      // Normaliza acentos/case/pontuação. Tenta exato e depois substring.
      if (!empresaZohoStr || !state.companies?.length) return '';
      const norm = (s) => String(s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9]+/g,'');
      const target = norm(empresaZohoStr);
      if (!target) return '';
      let m = state.companies.find(c => norm(c.nome) === target);
      if (m) return m.id;
      m = state.companies.find(c => { const n = norm(c.nome); return n.includes(target) || target.includes(n); });
      return m ? m.id : '';
    },
    vzRecalc() {
      const v = this._vzCurr; if (!v) return;
      const custos = {};
      document.querySelectorAll('#bifVzCustosBox input[data-custo]').forEach(el => {
        custos[el.dataset.custo] = +el.value || 0;
      });
      const ficha = { custos };
      // Calc inline (mesma fórmula do backend)
      const valorBruto = +v.valor || 0;
      const desconto = +custos.desconto || 0;
      const receitaLiquida = Math.max(0, valorBruto - desconto);
      let custoTotal = 0;
      Object.entries(custos).forEach(([k,val]) => { if (k !== 'desconto') custoTotal += +val||0; });
      const lucro = receitaLiquida - custoTotal;
      const margemBruta = valorBruto > 0 ? (valorBruto - (+custos.custoProduto||0)) / valorBruto : 0;
      const margemContrib = receitaLiquida > 0 ? (receitaLiquida - custoTotal) / receitaLiquida : 0;
      const margemLiq = receitaLiquida > 0 ? lucro/receitaLiquida : 0;
      let status = 'sem-dados';
      if (custoTotal > 0 || receitaLiquida > 0) {
        status = lucro < 0 ? 'prejuizo' : margemLiq < 0.10 ? 'atencao' : 'lucrativa';
      }
      const stClass = status==='lucrativa'?'ok':status==='atencao'?'warn':status==='prejuizo'?'bad':'muted';
      const stIco = status==='lucrativa'?'✅':status==='atencao'?'⚠️':status==='prejuizo'?'🔴':'⚪';
      document.getElementById('bifVzFichaStatus').className = 'bif-pill ' + stClass;
      document.getElementById('bifVzFichaStatus').textContent = stIco + ' ' + status;

      const cards = [
        { lbl:'Receita bruta', val:fmtBRL(valorBruto), klass:'info' },
        { lbl:'Receita líquida', val:fmtBRL(receitaLiquida), klass:'info' },
        { lbl:'Custo total', val:fmtBRL(custoTotal), klass:'warn' },
        { lbl:'Lucro real', val:fmtBRL(lucro), klass:lucro>=0?'ok':'bad' },
        { lbl:'% Lucro', val:fmtPct(margemLiq), klass:margemLiq>=0.10?'ok':margemLiq>=0?'warn':'bad' },
        { lbl:'Margem contrib.', val:fmtPct(margemContrib), klass:margemContrib>=0.20?'ok':margemContrib>=0?'warn':'bad' },
      ];
      document.getElementById('bifVzResultadoKpis').innerHTML = cards.map(c =>
        `<div class="bif-kpi ${c.klass}" style="padding:10px 12px"><div class="lbl" style="font-size:10px">${c.lbl}</div><div class="val" style="font-size:1.05rem">${c.val}</div></div>`).join('');
    },
    async vzSaveFicha() {
      const v = this._vzCurr; if (!v) return;
      const custos = {};
      document.querySelectorAll('#bifVzCustosBox input[data-custo]').forEach(el => {
        custos[el.dataset.custo] = +el.value || 0;
      });
      const body = {
        empresaBI: document.getElementById('bifVzFichaEmpresa').value,
        formaPagamento: document.getElementById('bifVzFichaForma').value,
        obs: document.getElementById('bifVzFichaObs').value,
        custos,
      };
      try {
        const r = await fetch(`/bi-financeiro/api/ficha/${v.module}/${v.zohoId}`, {
          method:'PUT',
          headers:{'Content-Type':'application/json'},
          body: JSON.stringify(body)
        });
        const j = await r.json();
        if (!j.ok) throw new Error(j.error || 'erro salvar');
        // Atualiza estado local sem precisar refetch completo
        const idx = this.vzState.vendas.findIndex(x => x.module===v.module && x.zohoId===v.zohoId);
        if (idx >= 0) {
          this.vzState.vendas[idx].ficha = j.ficha;
          // Recalc lucro
          const venda = this.vzState.vendas[idx];
          venda.calc = (() => {
            const valorBruto = +venda.valor||0;
            const desconto = +j.ficha.custos.desconto||0;
            const receitaLiquida = Math.max(0, valorBruto - desconto);
            let custoTotal = 0;
            Object.entries(j.ficha.custos).forEach(([k,val]) => { if (k!=='desconto') custoTotal += +val||0; });
            const lucro = receitaLiquida - custoTotal;
            const margemBruta = valorBruto > 0 ? (valorBruto - (+j.ficha.custos.custoProduto||0))/valorBruto : 0;
            const margemContrib = receitaLiquida > 0 ? (receitaLiquida - custoTotal)/receitaLiquida : 0;
            const margemLiquida = receitaLiquida > 0 ? lucro/receitaLiquida : 0;
            let status = 'sem-dados';
            if (custoTotal > 0 || receitaLiquida > 0) status = lucro<0?'prejuizo':margemLiquida<0.10?'atencao':'lucrativa';
            return { valorBruto, desconto, receitaLiquida, custoTotal, lucro, margemBruta, margemContrib, margemLiquida, status };
          })();
        }
        this.vzCloseFicha();
        this.vzApplyFilters();
        this.vzRenderRelatorios();
      } catch(e) {
        alert('Erro ao salvar: ' + e.message);
      }
    },
    // =====================================================================
    // ===== PAGAMENTOS / APROVAÇÕES / BANCOS / EXTRATOS / APROVADORES =====
    // =====================================================================
    pgState: { lista: [], bancos: [], aprovadores: [], _curr: null },

    async pgInitData() {
      // Carrega bancos+aprovadores em paralelo (evita re-fetch dentro de cada aba)
      try {
        const [b, ap] = await Promise.all([
          fetch('/bi-financeiro/api/bancos').then(r=>r.json()),
          fetch('/bi-financeiro/api/aprovadores').then(r=>r.json()),
        ]);
        this.pgState.bancos = b.bancos || [];
        this.pgState.aprovadores = ap.aprovadores || [];
      } catch(e){ console.warn('pgInitData', e); }
    },

    pgPopularEmpresaSelect() {
      const opts = '<option value="">— escolher —</option>' + state.companies.map(c => `<option value="${c.id}">${escapeHtml(c.nome)}</option>`).join('');
      const optsFiltro = '<option value="">Todas as empresas</option>' + state.companies.map(c => `<option value="${c.id}">${escapeHtml(c.nome)}</option>`).join('');
      ['bifPgEmpresa','bifBkEmpresa','bifRcEmpresa'].forEach(id => {
        const el = document.getElementById(id); if (!el) return;
        const cur = el.value; el.innerHTML = opts; el.value = cur;
      });
      ['bifPgFiltroEmpresa','bifRcFiltroEmpresa'].forEach(id => {
        const el = document.getElementById(id); if (!el) return;
        const cur = el.value; el.innerHTML = optsFiltro; el.value = cur;
      });
    },

    async pgReload() {
      await this.pgInitData();
      const status = document.getElementById('bifPgFiltroStatus').value;
      const empresa = document.getElementById('bifPgFiltroEmpresa').value;
      const qs = new URLSearchParams();
      if (status) qs.set('status', status);
      if (empresa) qs.set('empresaBI', empresa);
      try {
        const [r, dash] = await Promise.all([
          fetch('/bi-financeiro/api/pagamentos?'+qs.toString()).then(r=>r.json()),
          fetch('/bi-financeiro/api/pagamentos-dashboard'+(empresa?'?empresaBI='+empresa:'')).then(r=>r.json()),
        ]);
        this.pgState.lista = r.pagamentos || [];
        this.pgRenderKpis(dash.summary);
        this.pgRenderTable();
      } catch(e){ alert('Erro carregar pagamentos: '+e.message); }
    },

    pgFilterTable() {
      // filtro local (busca)
      this.pgRenderTable();
    },

    pgRenderKpis(summary) {
      if (!summary) { document.getElementById('bifPgKpis').innerHTML = ''; return; }
      const cards = [
        { lbl:'Aguardando aprovação', val:summary.counts.aguardando+'', sub:fmtBRL(summary.valores.aguardando), klass:'warn' },
        { lbl:'Aprovado (a pagar)',   val:summary.counts.aprovado+'',   sub:fmtBRL(summary.valores.aprovado), klass:'info' },
        { lbl:'Pago',                 val:summary.counts.pago+'',       sub:fmtBRL(summary.valores.pago), klass:'ok' },
        { lbl:'Vencendo hoje',        val:summary.listas.vencendoHoje.length+'', sub:fmtBRL(summary.valores.vencendoHoje), klass:summary.listas.vencendoHoje.length>0?'warn':'ok' },
        { lbl:'🔴 Vencidos',          val:summary.listas.vencidos.length+'', sub:fmtBRL(summary.valores.vencidos), klass:summary.listas.vencidos.length>0?'bad':'ok' },
        { lbl:'A pagar próx 7 dias',  val:'',  sub:fmtBRL(summary.valores.proxSemana), klass:'info' },
        { lbl:'A pagar este mês',     val:'',  sub:fmtBRL(summary.valores.noMes), klass:'info' },
        { lbl:'Total registros',      val:summary.counts.total+'',       klass:'info' },
      ];
      document.getElementById('bifPgKpis').innerHTML = cards.map(c =>
        `<div class="bif-kpi ${c.klass}"><div class="lbl">${c.lbl}</div><div class="val">${c.val}</div>${c.sub?`<div class="sub">${c.sub}</div>`:''}</div>`).join('');
    },

    _pgSelected: new Set(),
    pgToggleSelect(id, checked) {
      if (checked) this._pgSelected.add(id); else this._pgSelected.delete(id);
      this._pgRenderBulkBar();
    },
    pgToggleSelectAll(checked) {
      this._pgSelected.clear();
      document.querySelectorAll('input[data-bulk-pg]').forEach(el => {
        if (checked) { this._pgSelected.add(el.getAttribute('data-bulk-pg')); el.checked = true; }
        else el.checked = false;
      });
      this._pgRenderBulkBar();
    },
    _pgRenderBulkBar() {
      const slot = document.getElementById('bifPgBulkBar'); if (!slot) return;
      if (!this.isAdmin) { slot.innerHTML = ''; return; }
      const n = this._pgSelected.size;
      if (n === 0) { slot.innerHTML = ''; return; }
      const tot = (this.pgState.lista||[]).filter(p => this._pgSelected.has(p.id)).reduce((s,p) => s + (+p.valor||0), 0);
      slot.innerHTML = `<div style="background:linear-gradient(135deg,#1a2a3a,#0F1420);border:1px solid #4F8CFF;border-radius:8px;padding:10px 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span style="font-weight:700">${n} pagamento(s) selecionado(s)</span>
        <span class="muted" style="font-size:12px">· Total: <b>${fmtBRL(tot)}</b></span>
        <div style="flex:1"></div>
        <button class="bif-btn sm danger" onclick="BIF.pgBulkExcluir()">🗑️ Excluir do servidor</button>
        <button class="bif-btn sm ghost" onclick="BIF.pgBulkLimpar()">✕</button>
      </div>`;
    },
    pgBulkLimpar() {
      this._pgSelected.clear();
      document.querySelectorAll('input[data-bulk-pg]').forEach(el => { el.checked = false; });
      const all = document.getElementById('bifPgBulkHead_chk'); if (all) all.checked = false;
      this._pgRenderBulkBar();
    },
    async pgBulkExcluir() {
      const ids = Array.from(this._pgSelected);
      await this._bulkDeleteServer('pagamentos', ids, 'pagamento(s)', async () => {
        this._pgSelected.clear();
        await this.pgReload();
      });
    },

    pgRenderTable() {
      const tb = document.getElementById('bifPgTbody');
      const busca = (document.getElementById('bifPgBusca').value || '').toLowerCase();
      let list = this.pgState.lista;
      if (busca) list = list.filter(p => ((p.fornecedor+p.descricao+p.categoria)||'').toLowerCase().includes(busca));
      // bulk head
      const headSlot = document.getElementById('bifPgBulkHead');
      if (headSlot && this.isAdmin && !headSlot.innerHTML) {
        headSlot.innerHTML = `<input type="checkbox" id="bifPgBulkHead_chk" onchange="BIF.pgToggleSelectAll(this.checked)">`;
      }
      if (list.length === 0) {
        tb.innerHTML = '<tr><td colspan="11" class="bif-empty"><div class="ico">📤</div>Nenhum pagamento.</td></tr>';
        this._pgRenderBulkBar();
        return;
      }
      tb.innerHTML = list.map(p => {
        const stCfg = this._pgStatusBadge(p.status);
        const empNome = state.companies.find(c => c.id === p.empresaBI)?.nome || '—';
        const banco = p.contaBancariaAprovada ? (this.pgState.bancos.find(b => b.id === p.contaBancariaAprovada)) : null;
        const recorrBadge = p.recorrente && !p.geradoDeRecorrencia ? ' <span class="bif-pill info" title="Modelo recorrente">🔄 modelo</span>'
                          : p.geradoDeRecorrencia ? ` <span class="bif-pill muted" title="Cópia gerada de ${p.geradoDeRecorrencia} · competência ${p.competenciaMes}">🔄 cópia ${escapeHtml(p.competenciaMes||'')}</span>`
                          : '';
        const checkboxTd = this.isAdmin
          ? `<td style="width:30px"><input type="checkbox" data-bulk-pg="${p.id}" onclick="event.stopPropagation();BIF.pgToggleSelect('${p.id}', this.checked)" ${this._pgSelected.has(p.id)?'checked':''}></td>`
          : '<td style="width:30px"></td>';
        return `<tr style="cursor:pointer" onclick="BIF.pgEditar('${p.id}')">
          ${checkboxTd}
          <td><span class="bif-pill ${stCfg.cls}">${stCfg.txt}</span>${recorrBadge}</td>
          <td style="font-size:11.5px">${escapeHtml(empNome)}</td>
          <td><b>${escapeHtml(p.fornecedor||'—')}</b></td>
          <td style="font-size:11.5px">${escapeHtml((p.descricao||'').slice(0,60))}</td>
          <td class="col-num"><b>${fmtBRL(p.valor)}</b></td>
          <td>${p.vencimento || '—'}</td>
          <td style="font-size:11px">${escapeHtml(p.solicitadoPor||'—')}</td>
          <td style="font-size:11px">${escapeHtml(p.aprovadoPor||p.reprovadoPor||'—')}</td>
          <td style="font-size:11px">${banco ? escapeHtml(banco.apelido||banco.banco) : '—'}</td>
          <td class="col-act"><button class="bif-btn sm ghost" onclick="event.stopPropagation();BIF.pgEditar('${p.id}')">📝</button></td>
        </tr>`;
      }).join('');
    },

    _pgStatusBadge(s) {
      const map = {
        'rascunho':              { cls:'muted', txt:'📝 Rascunho' },
        'aguardando-aprovacao':  { cls:'warn',  txt:'⏳ Aguardando' },
        'aprovado':              { cls:'info',  txt:'✅ Aprovado' },
        'ajuste-solicitado':     { cls:'warn',  txt:'⚠️ Ajuste' },
        'reprovado':             { cls:'bad',   txt:'❌ Reprovado' },
        'pago':                  { cls:'ok',    txt:'💰 Pago' },
        'cancelado':             { cls:'muted', txt:'🚫 Cancelado' },
      };
      return map[s] || { cls:'muted', txt:s };
    },

    pgNovo() { this._pgAbrirModal(null); },
    async pgEditar(id) {
      try {
        const r = await fetch('/bi-financeiro/api/pagamentos/'+id).then(r=>r.json());
        this._pgAbrirModal(r.pagamento, r.historicoAuditoria || []);
      } catch(e){ alert(e.message); }
    },
    _pgAbrirModal(p, hist) {
      this.pgPopularEmpresaSelect();
      this._pgPopularBancoSugSelect();
      const novo = !p;
      document.getElementById('bifPgModalTitle').textContent = novo ? 'Nova conta a pagar' : 'Editar conta a pagar';
      document.getElementById('bifPgId').value = p?.id || '';
      document.getElementById('bifPgEmpresa').value = p?.empresaBI || '';
      document.getElementById('bifPgFornecedor').value = p?.fornecedor || '';
      document.getElementById('bifPgFornecedorId').value = p?.fornecedorId || '';
      this._pgFornHide();
      document.getElementById('bifPgCategoria').value = p?.categoria || '';
      document.getElementById('bifPgDesc').value = p?.descricao || '';
      document.getElementById('bifPgValor').value = p?.valor || '';
      document.getElementById('bifPgVenc').value = p?.vencimento || '';
      document.getElementById('bifPgForma').value = p?.formaPagamento || '';
      document.getElementById('bifPgPix').value = p?.chavePix || '';
      document.getElementById('bifPgCB').value = p?.codigoBarras || '';
      document.getElementById('bifPgCC').value = p?.centroCusto || '';
      document.getElementById('bifPgDadosBanc').value = p?.dadosBancarios || '';
      document.getElementById('bifPgAnexo').value = p?.anexoUrl || '';
      document.getElementById('bifPgBancoSug').value = p?.contaBancariaSugerida || '';
      document.getElementById('bifPgRecor').value = p?.recorrente ? 'true' : 'false';
      document.getElementById('bifPgObs').value = p?.obs || '';

      const stCfg = p ? this._pgStatusBadge(p.status) : { cls:'muted', txt:'novo' };
      const stEl = document.getElementById('bifPgModalStatus');
      stEl.className = 'bif-pill ' + stCfg.cls;
      stEl.textContent = stCfg.txt;

      // Botões: edita só se rascunho/ajuste; submeter só se rascunho/ajuste
      const editavel = !p || ['rascunho','ajuste-solicitado'].includes(p.status);
      document.getElementById('bifPgBtnSalvar').style.display = editavel ? '' : 'none';
      document.getElementById('bifPgBtnSubmeter').style.display = editavel ? '' : 'none';
      document.getElementById('bifPgBtnExcluir').style.display = (p && p.status !== 'pago') ? '' : 'none';
      document.querySelectorAll('#bifPgModal input, #bifPgModal select, #bifPgModal textarea').forEach(el => {
        if (el.id === 'bifPgId') return;
        el.disabled = !editavel;
      });

      // Histórico
      const histBox = document.getElementById('bifPgHistoricoBox');
      if (p && (p.historico||[]).length > 0) {
        histBox.innerHTML = '<h3 style="margin-top:12px;font-size:12px;color:#8899AA;text-transform:uppercase">Histórico</h3>' +
          '<div style="background:#0a0a0a;border:1px solid #1a1f35;border-radius:8px;padding:10px;max-height:200px;overflow-y:auto;font-size:11.5px">' +
          p.historico.slice().reverse().map(h => `<div style="margin-bottom:6px"><b style="color:#4F8CFF">${escapeHtml(h.tipo)}</b> · ${(new Date(h.ts)).toLocaleString('pt-BR')} · por ${escapeHtml(h.usuario||'—')}${h.payload?'<div class="muted" style="font-size:10.5px">'+escapeHtml(JSON.stringify(h.payload).slice(0,200))+'</div>':''}</div>`).join('') +
          '</div>';
      } else {
        histBox.innerHTML = '';
      }

      // Selo recorrência no modal
      if (p && (p.recorrente || p.geradoDeRecorrencia)) {
        const stEl = document.getElementById('bifPgModalStatus');
        const orig = stEl.innerHTML;
        if (p.recorrente && !p.geradoDeRecorrencia) {
          stEl.insertAdjacentHTML('afterend', ` <span class="bif-pill info" style="margin-left:6px">🔄 modelo recorrente</span>`);
        } else if (p.geradoDeRecorrencia) {
          stEl.insertAdjacentHTML('afterend', ` <span class="bif-pill muted" style="margin-left:6px">🔄 cópia · competência ${escapeHtml(p.competenciaMes||'')}</span>`);
        }
      }

      this._pgCurrId = p?.id || null;
      document.getElementById('bifPgModal').classList.add('show');
    },
    pgFecharModal() { document.getElementById('bifPgModal').classList.remove('show'); this._pgCurrId = null; },

    _pgPopularBancoSugSelect() {
      const sel = document.getElementById('bifPgBancoSug');
      const cur = sel.value;
      sel.innerHTML = '<option value="">— sugerir automático —</option>' +
        this.pgState.bancos.filter(b => b.ativo).map(b => `<option value="${b.id}">${escapeHtml(b.apelido||b.banco)} · ${escapeHtml(state.companies.find(c=>c.id===b.empresaBI)?.nome||'—')}</option>`).join('');
      sel.value = cur;
    },

    // === Autocomplete fornecedor (busca cadastro server-side) ===
    _pgFornDeb: null,
    _pgFornHide() { const el = document.getElementById('bifPgFornSuggest'); if (el) el.style.display = 'none'; },
    pgFornAutocomplete() {
      // Limpa fornecedorId quando o usuário edita manualmente
      document.getElementById('bifPgFornecedorId').value = '';
      clearTimeout(this._pgFornDeb);
      this._pgFornDeb = setTimeout(() => this._pgFornSearch(), 250);
    },
    async _pgFornSearch() {
      const q = document.getElementById('bifPgFornecedor').value.trim();
      const box = document.getElementById('bifPgFornSuggest');
      if (q.length < 2) { box.style.display = 'none'; return; }
      box.innerHTML = '<div style="padding:10px 12px;color:#8899AA;font-size:11.5px">⏳ buscando...</div>';
      box.style.display = 'block';
      try {
        const r = await fetch('/bi-financeiro/api/fornecedores/search?q=' + encodeURIComponent(q)).then(r=>r.json());
        const items = r.results || [];
        if (items.length === 0) {
          box.innerHTML = `<div style="padding:10px 12px;color:#8899AA;font-size:12px">Nenhum fornecedor encontrado. <a href="javascript:void(0)" style="color:#4F8CFF" onclick="BIF.pgFornCadastrar('${escapeHtml(q).replace(/'/g,'&apos;')}')">+ Cadastrar como novo</a></div>`;
          return;
        }
        box.innerHTML = items.map(f => {
          const docFmt = !f.doc ? '' : (f.doc_tipo === 'cnpj'
            ? f.doc.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/,'$1.$2.$3/$4-$5')
            : f.doc_tipo === 'cpf' ? f.doc.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/,'$1.$2.$3-$4') : f.doc);
          const data = encodeURIComponent(JSON.stringify(f));
          return `<div style="padding:8px 12px;border-bottom:1px solid #1a1f35;cursor:pointer" onmousedown="BIF.pgFornSelecionar('${data}')" onmouseover="this.style.background='#171c2e'" onmouseout="this.style.background=''">
            <b>${escapeHtml(f.nome)}</b>
            <div style="font-size:10.5px;color:#8899AA">
              ${[docFmt, f.categoria, f.telefone].filter(Boolean).map(escapeHtml).join(' · ') || ''}
              ${f.chave_pix ? ` · <span style="color:#22C55E">PIX: ${escapeHtml(f.chave_pix.slice(0,28))}</span>` : ''}
            </div>
          </div>`;
        }).join('');
      } catch(e) {
        box.innerHTML = `<div style="padding:10px 12px;color:#EF4444;font-size:11.5px">Erro: ${escapeHtml(e.message)}</div>`;
      }
    },
    pgFornSelecionar(dataEncoded) {
      const f = JSON.parse(decodeURIComponent(dataEncoded));
      document.getElementById('bifPgFornecedor').value = f.nome || '';
      document.getElementById('bifPgFornecedorId').value = f.id || '';
      // Pré-preenche categoria/PIX se vazios
      const catEl = document.getElementById('bifPgCategoria');
      if (catEl && !catEl.value && f.categoria) catEl.value = f.categoria;
      const pixEl = document.getElementById('bifPgPix');
      if (pixEl && !pixEl.value && f.chave_pix) pixEl.value = f.chave_pix;
      this._pgFornHide();
    },
    pgFornCadastrar(nome) {
      // Fecha modal de pagamento e abre modal de fornecedor pré-preenchido
      this._pgFornHide();
      const pgModal = document.getElementById('bifPgModal');
      const wasOpen = pgModal.classList.contains('show');
      if (wasOpen) pgModal.classList.remove('show');
      // Abre modal fornecedor
      this.frnNovo();
      setTimeout(() => {
        const inp = document.getElementById('bifFrnNome');
        if (inp) inp.value = nome;
      }, 50);
      // Aviso visual
      setTimeout(() => alert('Cadastre o fornecedor e depois volte pra criar o pagamento.'), 100);
    },

    _pgPayloadFromForm() {
      return {
        empresaBI: document.getElementById('bifPgEmpresa').value,
        fornecedor: document.getElementById('bifPgFornecedor').value,
        fornecedorId: document.getElementById('bifPgFornecedorId').value || '',
        categoria: document.getElementById('bifPgCategoria').value,
        descricao: document.getElementById('bifPgDesc').value,
        valor: +document.getElementById('bifPgValor').value || 0,
        vencimento: document.getElementById('bifPgVenc').value,
        formaPagamento: document.getElementById('bifPgForma').value,
        chavePix: document.getElementById('bifPgPix').value,
        codigoBarras: document.getElementById('bifPgCB').value,
        centroCusto: document.getElementById('bifPgCC').value,
        dadosBancarios: document.getElementById('bifPgDadosBanc').value,
        anexoUrl: document.getElementById('bifPgAnexo').value,
        contaBancariaSugerida: document.getElementById('bifPgBancoSug').value,
        recorrente: document.getElementById('bifPgRecor').value === 'true',
        obs: document.getElementById('bifPgObs').value,
      };
    },

    async pgSalvar() {
      const body = this._pgPayloadFromForm();
      if (!body.empresaBI || !body.fornecedor || !body.valor) { alert('Preencha empresa, fornecedor e valor.'); return; }
      const id = this._pgCurrId;
      try {
        const url = id ? '/bi-financeiro/api/pagamentos/'+id : '/bi-financeiro/api/pagamentos';
        const method = id ? 'PUT' : 'POST';
        const r = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.pgFecharModal();
        await this.pgReload();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async pgSubmeter() {
      // Salva primeiro (cria se for novo) e submete
      await this.pgSalvar.call(this);
      // Após salvar, _pgCurrId pode estar zerado pq fechou modal — busca o último criado
      // Mais robusto: salvar e capturar o id antes de submit
      // Reabordagem: extrai-se o id retornado.
      try {
        const body = this._pgPayloadFromForm();
        if (!body.empresaBI || !body.fornecedor || !body.valor) return;
        // Re-localiza o pagamento mais recente do mesmo fornecedor+valor
        const lastList = await fetch('/bi-financeiro/api/pagamentos').then(r=>r.json());
        const found = (lastList.pagamentos||[]).find(p => p.fornecedor === body.fornecedor && p.valor === body.valor && p.status === 'rascunho');
        if (!found) { await this.pgReload(); return; }
        const empresa = state.companies.find(c => c.id === body.empresaBI);
        const r = await fetch('/bi-financeiro/api/pagamentos/'+found.id+'/submeter', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ empresaNome: empresa?.nome || '' })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        const wpp = r.whatsapp || {};
        let msg = '✓ Submetido pra aprovação';
        if (wpp.ok && wpp.notificados?.length) {
          msg += `. WhatsApp enviado pra ${wpp.notificados.filter(x=>x.ok).length} aprovador(es).`;
        } else if (wpp.error) {
          msg += '. ⚠️ Z-API: '+wpp.error;
        }
        alert(msg);
        await this.pgReload();
      } catch(e){ alert('Erro ao submeter: '+e.message); }
    },
    // =====================================================================
    // ===== FORNECEDORES (Postgres) =====
    // =====================================================================
    frnState: { lista: [], _curr: null, _selected: new Set() },
    _frnDeb: null,

    async frnReload() {
      try {
        const q = document.getElementById('bifFrnBusca')?.value || '';
        const ativo = document.getElementById('bifFrnFiltroAtivo')?.value || '';
        const params = new URLSearchParams();
        if (q) params.set('search', q);
        if (ativo) params.set('ativo', ativo);
        const r = await fetch('/bi-financeiro/api/fornecedores?'+params).then(r=>r.json());
        this.frnState.lista = r.fornecedores || [];
        this._frnRenderTable();
      } catch(e){ alert('Erro: '+e.message); }
    },
    frnBuscaDebounce() { clearTimeout(this._frnDeb); this._frnDeb = setTimeout(() => this.frnReload(), 300); },

    _frnRenderTable() {
      const tb = document.getElementById('bifFrnTbody');
      const list = this.frnState.lista;
      const headSlot = document.getElementById('bifFrnBulkHead');
      if (headSlot && this.isAdmin && !headSlot.innerHTML) {
        headSlot.innerHTML = `<input type="checkbox" id="bifFrnBulkHead_chk" onchange="BIF.frnToggleSelectAll(this.checked)">`;
      }
      document.getElementById('bifFrnResumo').textContent = list.length + ' fornecedor(es)';
      if (list.length === 0) {
        tb.innerHTML = '<tr><td colspan="11" class="bif-empty"><div class="ico">🏪</div>Nenhum fornecedor.</td></tr>';
        this._frnRenderBulkBar();
        return;
      }
      tb.innerHTML = list.map(f => {
        const docFmt = !f.doc ? '—' : (f.doc_tipo === 'cnpj'
          ? f.doc.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})(\d{2})$/,'$1.$2.$3/$4-$5')
          : f.doc_tipo === 'cpf'
            ? f.doc.replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/,'$1.$2.$3-$4')
            : f.doc);
        const cb = this.isAdmin
          ? `<td style="width:30px"><input type="checkbox" data-bulk-frn="${f.id}" onclick="event.stopPropagation();BIF.frnToggleSelect('${f.id}', this.checked)" ${this.frnState._selected.has(f.id)?'checked':''}></td>`
          : '<td style="width:30px"></td>';
        return `<tr style="cursor:pointer" onclick="BIF.frnEditar('${f.id}')">
          ${cb}
          <td><b>${escapeHtml(f.nome)}</b></td>
          <td>${escapeHtml(docFmt)}</td>
          <td>${escapeHtml(f.categoria||'—')}</td>
          <td>${escapeHtml(f.contato_nome||'—')}</td>
          <td>${escapeHtml(f.whatsapp||f.telefone||'—')}</td>
          <td>${escapeHtml(f.email||'—')}</td>
          <td style="font-size:11.5px">${escapeHtml((f.chave_pix||'').slice(0,30))}</td>
          <td>${escapeHtml([f.cidade, f.uf].filter(Boolean).join('/')||'—')}</td>
          <td><span class="bif-pill ${f.ativo?'ok':'muted'}">${f.ativo?'Sim':'Não'}</span></td>
          <td class="col-act"><button class="bif-btn sm ghost" onclick="event.stopPropagation();BIF.frnEditar('${f.id}')">✏️</button></td>
        </tr>`;
      }).join('');
      this._frnRenderBulkBar();
    },

    frnToggleSelect(id, checked) {
      if (checked) this.frnState._selected.add(id); else this.frnState._selected.delete(id);
      this._frnRenderBulkBar();
    },
    frnToggleSelectAll(checked) {
      this.frnState._selected.clear();
      document.querySelectorAll('input[data-bulk-frn]').forEach(el => {
        if (checked) { this.frnState._selected.add(el.getAttribute('data-bulk-frn')); el.checked = true; }
        else el.checked = false;
      });
      this._frnRenderBulkBar();
    },
    _frnRenderBulkBar() {
      const slot = document.getElementById('bifFrnBulkBar'); if (!slot) return;
      if (!this.isAdmin) { slot.innerHTML = ''; return; }
      const n = this.frnState._selected.size;
      if (n === 0) { slot.innerHTML = ''; return; }
      slot.innerHTML = `<div style="background:linear-gradient(135deg,#1a2a3a,#0F1420);border:1px solid #4F8CFF;border-radius:8px;padding:10px 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span style="font-weight:700">${n} fornecedor(es) selecionado(s)</span>
        <div style="flex:1"></div>
        <button class="bif-btn sm danger" onclick="BIF.frnBulkExcluir()">🗑️ Excluir</button>
        <button class="bif-btn sm ghost" onclick="BIF.frnBulkLimpar()">✕</button>
      </div>`;
    },
    frnBulkLimpar() {
      this.frnState._selected.clear();
      document.querySelectorAll('input[data-bulk-frn]').forEach(el => { el.checked = false; });
      const all = document.getElementById('bifFrnBulkHead_chk'); if (all) all.checked = false;
      this._frnRenderBulkBar();
    },
    async frnBulkExcluir() {
      const ids = Array.from(this.frnState._selected);
      await this._bulkDeleteServer('fornecedores', ids, 'fornecedor(es)', async () => {
        this.frnState._selected.clear();
        await this.frnReload();
      });
    },

    // === Consulta CNPJ Receita Federal ===
    _frnDocDeb: null,
    frnDocChange() {
      const v = document.getElementById('bifFrnDoc').value.replace(/\D/g,'');
      const status = document.getElementById('bifFrnReceitaStatus');
      if (v.length === 14) {
        // CNPJ completo — auto-busca (debounce 600ms)
        status.textContent = '⏳ aguardando pra buscar...';
        clearTimeout(this._frnDocDeb);
        this._frnDocDeb = setTimeout(() => this.frnBuscarReceita(), 600);
      } else if (v.length === 11) {
        status.textContent = 'CPF detectado · busca Receita só funciona pra CNPJ';
      } else {
        status.textContent = '';
      }
    },
    async frnBuscarReceita() {
      const v = document.getElementById('bifFrnDoc').value.replace(/\D/g,'');
      const status = document.getElementById('bifFrnReceitaStatus');
      if (v.length !== 14) { status.innerHTML = '<span style="color:#EF4444">⚠️ CNPJ precisa ter 14 dígitos</span>'; return; }
      status.textContent = '⏳ consultando Receita Federal...';
      const btn = document.getElementById('bifFrnBuscarReceita');
      btn.disabled = true;
      try {
        const r = await fetch('/bi-financeiro/api/cnpj/' + v).then(r=>r.json());
        if (!r.ok) throw new Error(r.error || 'erro');
        // Preenche campos vazios (não sobrescreve o que já está preenchido)
        const fill = (id, valor) => {
          const el = document.getElementById(id); if (!el || !valor) return;
          if (!el.value || el.value.trim() === '') el.value = valor;
        };
        fill('bifFrnNome', r.razaoSocial);
        // Categoria via CNAE descricao (curta)
        if (r.cnaePrincipal) fill('bifFrnCategoria', r.cnaePrincipal.slice(0, 60));
        // Endereco
        const enderecoFmt = [r.endereco.logradouro, r.endereco.numero, r.endereco.complemento, r.endereco.bairro].filter(Boolean).join(', ');
        fill('bifFrnEndereco', enderecoFmt);
        fill('bifFrnCep', r.endereco.cep);
        fill('bifFrnCidade', r.endereco.cidade);
        fill('bifFrnUf', r.endereco.uf);
        // Telefone
        if (r.telefone) {
          const tel = r.telefone.replace(/\D/g,'');
          fill('bifFrnTelefone', tel);
        }
        // Email
        if (r.email) fill('bifFrnEmail', r.email);
        // Adiciona info na obs (sem sobrescrever)
        const obsEl = document.getElementById('bifFrnObs');
        if (obsEl) {
          const extra = `[Receita] ${r.razaoSocial}${r.nomeFantasia?' / '+r.nomeFantasia:''}\nSituação: ${r.situacao}\nAbertura: ${r.dataAbertura}\nPorte: ${r.porte}\nCNAE: ${r.cnaePrincipal} (${r.cnaeCodigo})\nCapital social: ${(r.capitalSocial||0).toLocaleString('pt-BR',{minimumFractionDigits:2})}`;
          if (!obsEl.value.includes('[Receita]')) {
            obsEl.value = (obsEl.value ? obsEl.value + '\n\n' : '') + extra;
          }
        }
        status.innerHTML = `<span style="color:#22C55E">✓ ${escapeHtml(r.razaoSocial)} · ${escapeHtml(r.situacao)} · ${escapeHtml(r.endereco.cidade)}/${escapeHtml(r.endereco.uf)}${r.cached?' · (cache)':''}</span>`;
      } catch(e) {
        status.innerHTML = `<span style="color:#EF4444">❌ ${escapeHtml(e.message)}</span>`;
      } finally {
        btn.disabled = false;
      }
    },

    frnNovo() { this._frnAbrir(null); },
    async frnEditar(id) {
      try {
        const r = await fetch('/bi-financeiro/api/fornecedores/'+id).then(r=>r.json());
        this._frnAbrir(r.fornecedor);
      } catch(e){ alert(e.message); }
    },
    _frnAbrir(f) {
      const novo = !f;
      document.getElementById('bifFrnTitle').textContent = novo ? 'Novo fornecedor' : 'Editar: '+(f.nome||'');

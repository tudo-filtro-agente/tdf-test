    async _renderZapiBanner() {
      try {
        const r = await fetch('/bi-financeiro/api/zapi-config').then(r=>r.json());
        const global = r.global;
        const overrides = Object.entries(r.configs || {}).filter(([k]) => k !== '__global__').filter(([_,c]) => c.instanceMasked).length;
        const expectedUrl = 'https://tdf-portal-production.up.railway.app/webhooks/zapi-aprovacao';
        const box = document.getElementById('bifZapiBanner');
        if (!box) return;
        const goCfg = `<a href="javascript:void(0)" onclick="document.querySelector('.bif-tab[data-tab=\\'config\\']').click()" style="color:#4F8CFF">→ Configurar</a>`;

        if (global && global.instanceMasked && global.tokenMasked) {
          const extra = overrides > 0 ? ` · ${overrides} empresa(s) com override próprio` : '';
          box.innerHTML = `<div class="bif-alert ok"><span class="ico">📱</span><div><b>Z-API global configurada</b>${global.apelido?(' ('+escapeHtml(global.apelido)+')'):''}${extra}. Webhook na Z-API: <code>${escapeHtml(expectedUrl)}</code></div></div>`;
        } else if (overrides > 0) {
          box.innerHTML = `<div class="bif-alert warn"><span class="ico">⚠️</span><div><b>Sem Z-API global</b> — apenas ${overrides} empresa(s) tem config própria. Empresas sem override não vão notificar via WhatsApp. ${goCfg}</div></div>`;
        } else {
          box.innerHTML = `<div class="bif-alert bad"><span class="ico">🔴</span><div><b>Z-API NÃO configurada</b> — aprovações via WhatsApp não vão funcionar. Cadastre a Z-API global em Configurações ou setar env <code>ZAPI_APROVACAO_*</code> na Railway. ${goCfg}</div></div>`;
        }
      } catch(_){}
    },

    async apReload() {
      this._renderZapiBanner();
      await this.pgInitData();
      try {
        const r = await fetch('/bi-financeiro/api/pagamentos?status=aguardando-aprovacao').then(r=>r.json());
        const list = r.pagamentos || [];
        const tb = document.getElementById('bifApTbody');
        if (list.length === 0) {
          tb.innerHTML = '<tr><td colspan="7" class="bif-empty"><div class="ico">✅</div>Nenhuma aprovação pendente. Tudo em dia!</td></tr>';
        } else {
          tb.innerHTML = list.map(p => {
            const empNome = state.companies.find(c => c.id === p.empresaBI)?.nome || '—';
            return `<tr>
              <td>${escapeHtml(empNome)}</td>
              <td><b>${escapeHtml(p.fornecedor)}</b></td>
              <td style="font-size:11.5px">${escapeHtml((p.descricao||'').slice(0,80))}</td>
              <td class="col-num"><b>${fmtBRL(p.valor)}</b></td>
              <td>${p.vencimento || '—'}</td>
              <td style="font-size:11px">${escapeHtml(p.solicitadoPor)} · ${(new Date(p.dataSubmissao||p.createdAt)).toLocaleDateString('pt-BR')}</td>
              <td class="col-act"><button class="bif-btn sm primary" onclick="BIF.apAbrir('${p.id}')">🔍 Analisar</button></td>
            </tr>`;
          }).join('');
        }
        // KPIs simples
        const total = list.reduce((s,p)=>s+(+p.valor||0),0);
        document.getElementById('bifApKpis').innerHTML = [
          { lbl:'Pendentes', val:list.length+'', klass:'warn' },
          { lbl:'Total a aprovar', val:fmtBRL(total), klass:'info' },
          { lbl:'Maior valor', val:fmtBRL(Math.max(0,...list.map(p=>+p.valor||0))), klass:list.length>0?'warn':'muted' },
        ].map(c => `<div class="bif-kpi ${c.klass}"><div class="lbl">${c.lbl}</div><div class="val">${c.val}</div></div>`).join('');
      } catch(e){ console.warn(e); }
    },

    async apAbrir(id) {
      try {
        const r = await fetch('/bi-financeiro/api/pagamentos/'+id).then(r=>r.json());
        const p = r.pagamento;
        this._apCurr = p;
        const emp = state.companies.find(c => c.id === p.empresaBI);
        document.getElementById('bifApDetalhes').innerHTML = `
          <div class="bif-form-row">
            <div><label>Empresa</label><div style="font-weight:700">${escapeHtml(emp?.nome||'—')}</div></div>
            <div><label>Fornecedor</label><div style="font-weight:700">${escapeHtml(p.fornecedor)}</div></div>
            <div><label>Valor</label><div style="font-weight:800;color:#22C55E;font-size:1.15rem">${fmtBRL(p.valor)}</div></div>
          </div>
          <div class="bif-form-row">
            <div><label>Vencimento</label><div>${p.vencimento || '—'}</div></div>
            <div><label>Forma</label><div>${escapeHtml(p.formaPagamento||'—')}</div></div>
            <div><label>Categoria</label><div>${escapeHtml(p.categoria||'—')}</div></div>
          </div>
          <div class="bif-form-row">
            <div style="grid-column:1/-1"><label>Descrição</label><div>${escapeHtml(p.descricao||'—')}</div></div>
          </div>
          ${p.anexoUrl ? `<div><a href="${escapeHtml(p.anexoUrl)}" target="_blank" style="color:#4F8CFF">📎 Anexo (boleto/NF)</a></div>`:''}
          ${p.dadosBancarios ? `<div class="muted" style="font-size:11.5px;margin-top:6px">Dados: ${escapeHtml(p.dadosBancarios)}</div>`:''}
          ${p.chavePix ? `<div class="muted" style="font-size:11.5px;margin-top:6px">PIX: <code>${escapeHtml(p.chavePix)}</code></div>`:''}
          ${p.codigoBarras ? `<div class="muted" style="font-size:11.5px;margin-top:6px">Boleto: <code>${escapeHtml(p.codigoBarras.slice(0,80))}</code></div>`:''}
          ${p.obs ? `<div class="muted" style="font-size:11.5px;margin-top:6px"><b>Obs:</b> ${escapeHtml(p.obs).replace(/\n/g,'<br>')}</div>`:''}
        `;
        // Bancos da empresa
        const bancosEmp = this.pgState.bancos.filter(b => b.ativo && (!b.empresaBI || b.empresaBI === p.empresaBI));
        const sel = document.getElementById('bifApBanco');
        sel.innerHTML = '<option value="">— escolha —</option>' + bancosEmp.map(b => `<option value="${b.id}">${escapeHtml(b.apelido||b.banco)} · saldo ${fmtBRL(b.saldoAtual)}</option>`).join('');
        // Pré-seleciona conta sugerida ou auto-suggest pela maior saldo
        if (p.contaBancariaSugerida) sel.value = p.contaBancariaSugerida;
        else { const sug = bancosEmp.filter(b => (+b.saldoAtual+ +b.limite) >= +p.valor).sort((a,b) => +b.saldoAtual - +a.saldoAtual)[0]; if (sug) sel.value = sug.id; }
        this.apAtualizarSaldo();
        document.getElementById('bifApObs').value = '';
        document.getElementById('bifApModal').classList.add('show');
      } catch(e){ alert(e.message); }
    },
    apFechar() { document.getElementById('bifApModal').classList.remove('show'); this._apCurr = null; },
    apAtualizarSaldo() {
      const p = this._apCurr; if (!p) return;
      const bid = document.getElementById('bifApBanco').value;
      const banco = this.pgState.bancos.find(b => b.id === bid);
      const info = document.getElementById('bifApSaldoInfo');
      if (!banco) { info.innerHTML = '<span class="muted">selecione uma conta</span>'; return; }
      const disp = (+banco.saldoAtual||0) + (+banco.limite||0);
      const apos = (+banco.saldoAtual||0) - (+p.valor||0);
      const ok = disp >= +p.valor;
      info.innerHTML = `Saldo atual: <b>${fmtBRL(banco.saldoAtual)}</b> · Limite: ${fmtBRL(banco.limite)} · Após pagamento: <b style="color:${apos<0?'#EF4444':'#22C55E'}">${fmtBRL(apos)}</b> ${ok?'<span class="bif-pill ok">suficiente</span>':'<span class="bif-pill bad">insuficiente</span>'}`;
    },
    async apAprovar() {
      const p = this._apCurr; if (!p) return;
      const bancoId = document.getElementById('bifApBanco').value;
      const obs = document.getElementById('bifApObs').value;
      if (!bancoId) { alert('Escolha a conta bancária.'); return; }
      try {
        const r = await fetch(`/bi-financeiro/api/pagamentos/${p.id}/aprovar`, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ contaBancariaId: bancoId, observacao: obs })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        let msg = '✅ Aprovado!';
        if (!r.saldoSuficiente) msg += '\n⚠️ Saldo insuficiente — verifique antes de marcar como pago.';
        if (confirm(msg + '\n\nMarcar como PAGO agora (debita o banco)?')) {
          const r2 = await fetch(`/bi-financeiro/api/pagamentos/${p.id}/marcar-pago`, {
            method:'POST', headers:{'Content-Type':'application/json'},
            body: JSON.stringify({ contaBancariaId: bancoId })
          }).then(r=>r.json());
          if (!r2.ok) alert('Aprovado mas não pago: '+r2.error);
        }
        this.apFechar(); await this.apReload(); await this.pgReload();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async apReprovar() {
      const p = this._apCurr; if (!p) return;
      const motivo = prompt('Motivo da reprovação:');
      if (motivo === null) return;
      try {
        const r = await fetch(`/bi-financeiro/api/pagamentos/${p.id}/reprovar`, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ motivo })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.apFechar(); await this.apReload(); await this.pgReload();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async apAjuste() {
      const p = this._apCurr; if (!p) return;
      const obs = prompt('O que precisa ajustar?');
      if (!obs) return;
      try {
        const r = await fetch(`/bi-financeiro/api/pagamentos/${p.id}/ajuste`, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ observacao: obs })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.apFechar(); await this.apReload(); await this.pgReload();
      } catch(e){ alert('Erro: '+e.message); }
    },

    // =====================================================================
    // ===== BANCOS =====
    // =====================================================================
    _bkSelected: new Set(),
    bkToggleSelect(id, c) { if (c) this._bkSelected.add(id); else this._bkSelected.delete(id); this._bkRenderBulkBar(); },
    bkToggleSelectAll(c) {
      this._bkSelected.clear();
      document.querySelectorAll('input[data-bulk-bk]').forEach(el => { if (c) { this._bkSelected.add(el.getAttribute('data-bulk-bk')); el.checked=true; } else el.checked=false; });
      this._bkRenderBulkBar();
    },
    _bkRenderBulkBar() {
      const slot = document.getElementById('bifBkBulkBar'); if (!slot) return;
      if (!this.isAdmin) { slot.innerHTML=''; return; }
      const n = this._bkSelected.size;
      if (n === 0) { slot.innerHTML=''; return; }
      slot.innerHTML = `<div style="background:linear-gradient(135deg,#1a2a3a,#0F1420);border:1px solid #4F8CFF;border-radius:8px;padding:10px 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px">
        <span style="font-weight:700">${n} banco(s) selecionado(s)</span>
        <div style="flex:1"></div>
        <button class="bif-btn sm danger" onclick="BIF.bkBulkExcluir()">🗑️ Excluir</button>
        <button class="bif-btn sm ghost" onclick="BIF.bkBulkLimpar()">✕</button>
      </div>`;
    },
    bkBulkLimpar() { this._bkSelected.clear(); document.querySelectorAll('input[data-bulk-bk]').forEach(el => el.checked=false); const a=document.getElementById('bifBkBulkHead_chk'); if(a)a.checked=false; this._bkRenderBulkBar(); },
    async bkBulkExcluir() {
      const ids = Array.from(this._bkSelected);
      await this._bulkDeleteServer('bancos', ids, 'banco(s)', async () => { this._bkSelected.clear(); await this.bkReload(); });
    },

    async bkReload() {
      try {
        const r = await fetch('/bi-financeiro/api/bancos').then(r=>r.json());
        this.pgState.bancos = r.bancos || [];
        const tb = document.getElementById('bifBkTbody');
        const headSlot = document.getElementById('bifBkBulkHead');
        if (headSlot && this.isAdmin && !headSlot.innerHTML) {
          headSlot.innerHTML = `<input type="checkbox" id="bifBkBulkHead_chk" onchange="BIF.bkToggleSelectAll(this.checked)">`;
        }
        if (this.pgState.bancos.length === 0) {
          tb.innerHTML = '<tr><td colspan="11" class="bif-empty"><div class="ico">🏦</div>Cadastre uma conta bancária pra começar.</td></tr>';
          this._bkRenderBulkBar();
        } else {
          tb.innerHTML = this.pgState.bancos.map(b => {
            const emp = state.companies.find(c => c.id === b.empresaBI);
            const cb = this.isAdmin ? `<td style="width:30px"><input type="checkbox" data-bulk-bk="${b.id}" onclick="BIF.bkToggleSelect('${b.id}', this.checked)" ${this._bkSelected.has(b.id)?'checked':''}></td>` : '<td style="width:30px"></td>';
            return `<tr>
              ${cb}
              <td><b>${escapeHtml(b.apelido||'—')}</b></td>
              <td>${escapeHtml(emp?.nome||'—')}</td>
              <td>${escapeHtml(b.banco||'—')}</td>
              <td style="font-size:11.5px">${escapeHtml(b.agencia||'—')} / ${escapeHtml(b.conta||'—')}</td>
              <td>${escapeHtml(b.tipoConta||'—')}</td>
              <td class="col-num">${fmtBRL(b.saldoInicial)}</td>
              <td class="col-num"><b style="color:${(+b.saldoAtual)>=0?'#22C55E':'#EF4444'}">${fmtBRL(b.saldoAtual)}</b></td>
              <td class="col-num">${fmtBRL(b.limite)}</td>
              <td><span class="bif-pill ${b.ativo?'ok':'muted'}">${b.ativo?'Ativa':'Inativa'}</span></td>
              <td class="col-act">
                <button class="bif-btn sm ghost" onclick="BIF.bkEditar('${b.id}')">✏️</button>
                <button class="bif-btn sm danger" onclick="BIF.bkExcluir('${b.id}')">🗑️</button>
              </td>
            </tr>`;
          }).join('');
          this._bkRenderBulkBar();
        }
        const totalSaldo = this.pgState.bancos.reduce((s,b)=>s+(+b.saldoAtual||0),0);
        document.getElementById('bifBkResumo').textContent = this.pgState.bancos.length + ' conta(s) · saldo total: ' + fmtBRL(totalSaldo);
      } catch(e){ console.warn(e); }
    },
    bkNovo() { this._bkAbrir(null); },
    bkEditar(id) { const b = this.pgState.bancos.find(x => x.id === id); this._bkAbrir(b); },
    _bkAbrir(b) {
      this.pgPopularEmpresaSelect();
      const novo = !b;
      document.getElementById('bifBkModalTitle').textContent = novo ? 'Nova conta bancária' : 'Editar conta bancária';
      document.getElementById('bifBkId').value = b?.id || '';
      document.getElementById('bifBkApelido').value = b?.apelido || '';
      document.getElementById('bifBkEmpresa').value = b?.empresaBI || '';
      document.getElementById('bifBkBanco').value = b?.banco || '';
      document.getElementById('bifBkTipo').value = b?.tipoConta || 'corrente';
      document.getElementById('bifBkAg').value = b?.agencia || '';
      document.getElementById('bifBkConta').value = b?.conta || '';
      document.getElementById('bifBkResp').value = b?.responsavel || '';
      document.getElementById('bifBkSaldoIni').value = b?.saldoInicial || 0;
      document.getElementById('bifBkLimite').value = b?.limite || 0;
      document.getElementById('bifBkAtivo').value = (b?.ativo !== false) ? 'true' : 'false';
      document.getElementById('bifBkObs').value = b?.obs || '';
      document.getElementById('bifBkModal').classList.add('show');
    },
    bkFechar() { document.getElementById('bifBkModal').classList.remove('show'); },
    async bkSalvar() {
      const id = document.getElementById('bifBkId').value;
      const body = {
        apelido: document.getElementById('bifBkApelido').value,
        empresaBI: document.getElementById('bifBkEmpresa').value,
        banco: document.getElementById('bifBkBanco').value,
        tipoConta: document.getElementById('bifBkTipo').value,
        agencia: document.getElementById('bifBkAg').value,
        conta: document.getElementById('bifBkConta').value,
        responsavel: document.getElementById('bifBkResp').value,
        saldoInicial: +document.getElementById('bifBkSaldoIni').value || 0,
        limite: +document.getElementById('bifBkLimite').value || 0,
        ativo: document.getElementById('bifBkAtivo').value === 'true',
        obs: document.getElementById('bifBkObs').value,
      };
      try {
        const url = id ? '/bi-financeiro/api/bancos/'+id : '/bi-financeiro/api/bancos';
        const method = id ? 'PUT' : 'POST';
        const r = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error || 'erro salvar');
        this.bkFechar(); await this.bkReload();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async bkExcluir(id) {
      if (!confirm('Excluir esta conta bancária? (extrato vai permanecer)')) return;
      try {
        await fetch('/bi-financeiro/api/bancos/'+id, { method:'DELETE' });
        await this.bkReload();
      } catch(e){ alert(e.message); }
    },

    // =====================================================================
    // ===== EXTRATOS =====
    // =====================================================================
    async exReload() {
      await this.pgInitData();
      const sel = document.getElementById('bifExSelBanco');
      // Popula select de bancos
      sel.innerHTML = '<option value="">— escolha uma conta —</option>' +
        this.pgState.bancos.map(b => `<option value="${b.id}">${escapeHtml(b.apelido||b.banco)} · saldo ${fmtBRL(b.saldoAtual)}</option>`).join('');
      const id = sel.value;
      const tb = document.getElementById('bifExTbody');
      if (!id) { tb.innerHTML = '<tr><td colspan="7" class="bif-empty">Selecione uma conta bancária.</td></tr>'; return; }
      try {
        const r = await fetch('/bi-financeiro/api/bancos/'+id+'/extrato').then(r=>r.json());
        const arr = r.extrato || [];
        if (arr.length === 0) { tb.innerHTML = '<tr><td colspan="7" class="bif-empty">Sem movimentações.</td></tr>'; return; }
        tb.innerHTML = arr.map(e => `<tr>
          <td>${(new Date(e.data)).toLocaleString('pt-BR')}</td>
          <td><span class="bif-pill ${e.tipo==='entrada'?'ok':'bad'}">${e.tipo}</span></td>
          <td>${escapeHtml(e.descricao||'—')}</td>
          <td class="col-num ${e.tipo==='entrada'?'ok':'bad'}"><b>${e.tipo==='entrada'?'+':'-'}${fmtBRL(e.valor)}</b></td>
          <td class="col-num">${fmtBRL(e.saldoAnterior)}</td>
          <td class="col-num"><b>${fmtBRL(e.saldoFinal)}</b></td>
          <td>${escapeHtml(e.usuario||'—')}</td>
        </tr>`).join('');
      } catch(e){ console.warn(e); }
    },

    // =====================================================================
    // ===== APROVADORES =====
    // =====================================================================
    _apvSelected: new Set(),
    apvToggleSelect(id, c) { if (c) this._apvSelected.add(id); else this._apvSelected.delete(id); this._apvRenderBulkBar(); },
    apvToggleSelectAll(c) {
      this._apvSelected.clear();
      document.querySelectorAll('input[data-bulk-apv]').forEach(el => { if (c) { this._apvSelected.add(el.getAttribute('data-bulk-apv')); el.checked=true; } else el.checked=false; });
      this._apvRenderBulkBar();
    },
    _apvRenderBulkBar() {
      const slot = document.getElementById('bifApvBulkBar'); if (!slot) return;
      if (!this.isAdmin) { slot.innerHTML=''; return; }
      const n = this._apvSelected.size;
      if (n === 0) { slot.innerHTML=''; return; }
      slot.innerHTML = `<div style="background:linear-gradient(135deg,#1a2a3a,#0F1420);border:1px solid #4F8CFF;border-radius:8px;padding:10px 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px">
        <span style="font-weight:700">${n} aprovador(es) selecionado(s)</span>
        <div style="flex:1"></div>
        <button class="bif-btn sm danger" onclick="BIF.apvBulkExcluir()">🗑️ Excluir</button>
        <button class="bif-btn sm ghost" onclick="BIF.apvBulkLimpar()">✕</button>
      </div>`;
    },
    apvBulkLimpar() { this._apvSelected.clear(); document.querySelectorAll('input[data-bulk-apv]').forEach(el => el.checked=false); const a=document.getElementById('bifApvBulkHead_chk'); if(a)a.checked=false; this._apvRenderBulkBar(); },
    async apvBulkExcluir() {
      const ids = Array.from(this._apvSelected);
      await this._bulkDeleteServer('aprovadores', ids, 'aprovador(es)', async () => { this._apvSelected.clear(); await this.apvReload(); });
    },

    async apvReload() {
      try {
        const r = await fetch('/bi-financeiro/api/aprovadores').then(r=>r.json());
        this.pgState.aprovadores = r.aprovadores || [];
        const tb = document.getElementById('bifApvTbody');
        const headSlot = document.getElementById('bifApvBulkHead');
        if (headSlot && this.isAdmin && !headSlot.innerHTML) {
          headSlot.innerHTML = `<input type="checkbox" id="bifApvBulkHead_chk" onchange="BIF.apvToggleSelectAll(this.checked)">`;
        }
        if (r.aprovadores?.length === 0) {
          tb.innerHTML = '<tr><td colspan="9" class="bif-empty">Nenhum aprovador cadastrado.</td></tr>'; this._apvRenderBulkBar(); return;
        }
        tb.innerHTML = r.aprovadores.map(a => {
          const empNomes = (a.empresasAutorizadas||[]).length === 0 ? 'Todas' : a.empresasAutorizadas.map(eid => state.companies.find(c=>c.id===eid)?.nome||eid).join(', ');
          const cb = this.isAdmin ? `<td style="width:30px"><input type="checkbox" data-bulk-apv="${a.id}" onclick="BIF.apvToggleSelect('${a.id}', this.checked)" ${this._apvSelected.has(a.id)?'checked':''}></td>` : '<td style="width:30px"></td>';
          return `<tr>
            ${cb}
            <td><b>${escapeHtml(a.nome)}</b></td>
            <td><code>${escapeHtml(a.whatsapp)}</code></td>
            <td><span class="bif-pill ${a.nivel==='titular'?'info':'muted'}">${a.nivel}</span></td>
            <td class="col-num">${a.nivel==='titular'?'sem limite':fmtBRL(a.limiteValor)}</td>
            <td style="font-size:11.5px">${escapeHtml(empNomes)}</td>
            <td>${escapeHtml(a.userLogin||'—')}</td>
            <td><span class="bif-pill ${a.ativo?'ok':'muted'}">${a.ativo?'Sim':'Não'}</span></td>
            <td class="col-act">
              <button class="bif-btn sm ghost" onclick="BIF.apvEditar('${a.id}')">✏️</button>
              <button class="bif-btn sm danger" onclick="BIF.apvExcluir('${a.id}')">🗑️</button>
            </td>
          </tr>`;
        }).join('');
        this._apvRenderBulkBar();
      } catch(e){ console.warn(e); }
    },
    apvNovo() { this._apvAbrir(null); },
    apvEditar(id) { const a = this.pgState.aprovadores.find(x=>x.id===id); this._apvAbrir(a); },
    _apvAbrir(a) {
      const novo = !a;
      document.getElementById('bifApvModalTitle').textContent = novo ? 'Novo aprovador' : 'Editar aprovador';
      document.getElementById('bifApvId').value = a?.id || '';
      document.getElementById('bifApvNome').value = a?.nome || '';
      document.getElementById('bifApvWpp').value = a?.whatsapp || '';
      document.getElementById('bifApvEmail').value = a?.email || '';
      document.getElementById('bifApvLogin').value = a?.userLogin || '';
      document.getElementById('bifApvNivel').value = a?.nivel || 'padrao';
      document.getElementById('bifApvLimite').value = a?.limiteValor ?? 5000;
      document.getElementById('bifApvAtivo').value = (a?.ativo !== false) ? 'true' : 'false';
      // Empresas checkboxes
      const aut = a?.empresasAutorizadas || [];
      document.getElementById('bifApvEmpresasBox').innerHTML = state.companies.length === 0 ? '<span class="muted">Cadastre empresas BI primeiro.</span>' :
        state.companies.map(c => `<label style="display:flex;align-items:center;gap:5px;font-size:12px"><input type="checkbox" data-emp="${c.id}" ${aut.includes(c.id)?'checked':''}> ${escapeHtml(c.nome)}</label>`).join('');
      document.getElementById('bifApvModal').classList.add('show');
    },
    apvFechar() { document.getElementById('bifApvModal').classList.remove('show'); },
    async apvSalvar() {
      const id = document.getElementById('bifApvId').value;
      const empresas = Array.from(document.querySelectorAll('#bifApvEmpresasBox input[data-emp]:checked')).map(el => el.dataset.emp);
      const body = {
        nome: document.getElementById('bifApvNome').value,
        whatsapp: document.getElementById('bifApvWpp').value,
        email: document.getElementById('bifApvEmail').value,
        userLogin: document.getElementById('bifApvLogin').value,
        nivel: document.getElementById('bifApvNivel').value,
        limiteValor: +document.getElementById('bifApvLimite').value || 0,
        empresasAutorizadas: empresas,
        ativo: document.getElementById('bifApvAtivo').value === 'true',
      };
      if (!body.nome || !body.whatsapp) { alert('Nome e WhatsApp são obrigatórios.'); return; }
      try {
        const url = id ? '/bi-financeiro/api/aprovadores/'+id : '/bi-financeiro/api/aprovadores';
        const method = id ? 'PUT' : 'POST';
        const r = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this.apvFechar(); await this.apvReload();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async apvExcluir(id) {
      if (!confirm('Excluir este aprovador?')) return;
      await fetch('/bi-financeiro/api/aprovadores/'+id, { method:'DELETE' });
      await this.apvReload();
    },

    // =====================================================================
    // ===== AUDITORIA =====
    // =====================================================================
    async audReload() {
      try {
        const r = await fetch('/bi-financeiro/api/auditoria').then(r=>r.json());
        const tb = document.getElementById('bifAudTbody');
        if (!r.ok || !r.eventos?.length) {
          tb.innerHTML = '<tr><td colspan="5" class="bif-empty">Sem eventos. (Auditoria é admin only — se você é financeiro/aprovador não verá esta aba.)</td></tr>'; return;
        }
        tb.innerHTML = r.eventos.slice(0,500).map(e => `<tr>
          <td style="font-size:11px">${(new Date(e.timestamp)).toLocaleString('pt-BR')}</td>
          <td><span class="bif-pill info">${escapeHtml(e.tipo)}</span></td>
          <td><code style="font-size:10.5px">${escapeHtml((e.pagamentoId||'').slice(0,16))}</code></td>
          <td>${escapeHtml(e.usuario||'—')}</td>
          <td style="font-size:11px;font-family:monospace;color:#8899AA">${escapeHtml(JSON.stringify({ ...e, id:undefined, timestamp:undefined, tipo:undefined, pagamentoId:undefined, usuario:undefined }).slice(0,200))}</td>
        </tr>`).join('');
      } catch(e){ console.warn(e); }
    },

    async vzGerarRecebimento() {
      const v = this._vzCurr; if (!v) return;
      const empresa = document.getElementById('bifVzFichaEmpresa').value || v.ficha?.empresaBI || '';
      if (!empresa) { alert('Associe a venda a uma empresa BI antes (dropdown "Empresa BI" no modal).'); return; }
      const venc = prompt('Vencimento esperado (YYYY-MM-DD):', v.data || '');
      if (venc === null) return;
      const body = {
        module: v.module, zohoId: v.zohoId,
        cliente: v.cliente || v.titulo,
        valor: v.valor || 0,
        dataVencimento: venc,
        empresaBI: empresa,
        descricao: `${v.module} #${v.zohoId} — ${v.titulo||v.cliente||''}`,
        categoria: v.categoriaProduto || 'venda',
      };
      try {
        const r = await fetch('/bi-financeiro/api/recebimentos/from-zoho', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify(body)
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error || 'erro');
        if (r.jaExistia) alert('ℹ️ Recebimento já existia pra esta venda — abra a aba Recebimentos pra ver.');
        else alert('✅ Recebimento criado em "📥 Recebimentos". Status: a-receber.');
      } catch(e){ alert('Erro: '+e.message); }
    },

    async vzDeleteFicha() {
      const v = this._vzCurr; if (!v) return;
      if (!confirm('Limpar todos os custos desta ficha? (a venda do Zoho não é alterada)')) return;
      // Reset visual
      document.querySelectorAll('#bifVzCustosBox input[data-custo]').forEach(el => el.value = 0);
      document.getElementById('bifVzFichaObs').value = '';
      this.vzRecalc();
      // Salva zerado
      await this.vzSaveFicha();
    }
  };

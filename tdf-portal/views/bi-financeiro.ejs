    ]}, options:{ responsive:true, maintainAspectRatio:false,
      plugins:{ legend:chartCommon().legend, tooltip:{ callbacks:{ label:(c)=>c.dataset.label+': '+fmtBRL(c.parsed.y) } } },
      scales:{ x:{ticks:{color:'#8899AA'},grid:{color:'#1a1f35'}}, y:{ticks:{color:'#8899AA',callback:v=>'R$ '+(v/1000)+'k'},grid:{color:'#1a1f35'}} }

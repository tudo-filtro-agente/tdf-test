        <td>${inputCell(p.categoria, `BIF.editField('produtos','${p.id}','categoria',this.value)`)}</td>
        <td class="col-num">${inputCell(p.precoVenda, `BIF.editField('produtos','${p.id}','precoVenda',+this.value)`,'number','step="0.01" min="0"')}</td>
        <td class="col-num">${inputCell(p.custoProduto, `BIF.editField('produtos','${p.id}','custoProduto',+this.value)`,'number','step="0.01" min="0"')}</td>
        <td class="col-num">${inputCell(p.frete, `BIF.editField('produtos','${p.id}','frete',+this.value)`,'number','step="0.01" min="0"')}</td>
        <td class="col-num">${inputCell(p.impostosPct, `BIF.editField('produtos','${p.id}','impostosPct',+this.value)`,'number','step="0.1" min="0" max="100"')}</td>
        <td class="col-num">${inputCell(p.comissaoPct, `BIF.editField('produtos','${p.id}','comissaoPct',+this.value)`,'number','step="0.1" min="0" max="100"')}</td>
        <td class="col-num">${inputCell(p.outrosCustos, `BIF.editField('produtos','${p.id}','outrosCustos',+this.value)`,'number','step="0.01" min="0"')}</td>
        <td class="col-num">${inputCell(p.qtdVendida, `BIF.editField('produtos','${p.id}','qtdVendida',+this.value)`,'number','step="1" min="0"')}</td>
        <td class="col-num"><span class="${c.margemBruta<0?'bad':c.margemBruta<.2?'warn':'ok'}">${fmtPct(c.margemBruta)}</span></td>
        <td class="col-num"><span class="${margClass}">${fmtPct(c.margemContrib)}</span></td>

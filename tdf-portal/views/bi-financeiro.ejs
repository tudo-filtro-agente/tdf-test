    // =====================================================================
    // ===== Importação CSV — aba Pagamentos Workflow (server-side) =====
    // =====================================================================
    pgImportarCsvAbrir() {
      document.getElementById('bifPgImportResultado').innerHTML = '';
      document.getElementById('bifPgImportFile').value = '';
      document.getElementById('bifPgImportBtnConfirmar').style.display = 'none';
      this._pgCsvText = null;
      document.getElementById('bifPgImportModal').classList.add('show');
    },
    pgImportarCsvFechar() { document.getElementById('bifPgImportModal').classList.remove('show'); },

    async pgImportarCsvPreview() {
      const file = document.getElementById('bifPgImportFile').files[0];
      if (!file) { alert('Selecione o arquivo CSV.'); return; }
      const box = document.getElementById('bifPgImportResultado');
      box.innerHTML = '<div class="bif-empty">⏳ Lendo arquivo...</div>';
      try {
        const csv = await file.text();
        this._pgCsvText = csv;
        // Mapas de resolução: nome empresa → id (do localStorage); apelido banco → id (do server)
        const empresasMap = {};
        (state.companies||[]).forEach(c => { empresasMap[c.nome] = c.id; });
        const bancosMap = {};
        (this.pgState.bancos||[]).forEach(b => { if (b.apelido) bancosMap[b.apelido] = b.id; });
        const r = await fetch('/bi-financeiro/api/pagamentos/import-csv', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ csv, dryRun:true, empresasMap, bancosMap })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this._renderImportResultado(r, true);
      } catch(e) { box.innerHTML = `<div class="bif-alert bad"><span class="ico">❌</span><div>Erro: ${escapeHtml(e.message)}</div></div>`; }
    },

    async pgImportarCsvConfirmar() {
      if (!this._pgCsvText) return;
      const box = document.getElementById('bifPgImportResultado');
      box.innerHTML = '<div class="bif-empty">⏳ Importando...</div>';
      try {
        const empresasMap = {};
        (state.companies||[]).forEach(c => { empresasMap[c.nome] = c.id; });
        const bancosMap = {};
        (this.pgState.bancos||[]).forEach(b => { if (b.apelido) bancosMap[b.apelido] = b.id; });
        const r = await fetch('/bi-financeiro/api/pagamentos/import-csv', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ csv: this._pgCsvText, dryRun:false, empresasMap, bancosMap })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this._renderImportResultado(r, false);
        document.getElementById('bifPgImportBtnConfirmar').style.display = 'none';
        // recarrega lista
        await this.pgReload();
      } catch(e) { box.innerHTML = `<div class="bif-alert bad"><span class="ico">❌</span><div>Erro: ${escapeHtml(e.message)}</div></div>`; }
    },

    _renderImportResultado(r, isPreview) {
      const box = document.getElementById('bifPgImportResultado');
      const ok = r.criados?.length || 0;
      const err = r.erros?.length || 0;
      let html = '';
      if (isPreview) {
        html += `<div class="bif-alert ${err>0?'warn':'info'}"><span class="ico">${err>0?'⚠️':'ℹ️'}</span><div><b>Pré-visualização:</b> ${ok} válida(s) · ${err} com erro · total ${r.total||0} linhas</div></div>`;
      } else {
        html += `<div class="bif-alert ${ok>0?'ok':'bad'}"><span class="ico">${ok>0?'✅':'❌'}</span><div><b>Importação concluída:</b> ${ok} criado(s) · ${err} com erro</div></div>`;
      }
      if (ok > 0) {
        html += '<details style="margin:10px 0"><summary style="cursor:pointer;color:#22C55E;font-weight:700">✓ '+ok+' contas '+(isPreview?'serão criadas':'criadas')+'</summary><table class="bif-table" style="margin-top:8px;font-size:12px"><thead><tr><th>Linha</th><th>Fornecedor</th><th class="col-num">Valor</th><th>Vencimento</th></tr></thead><tbody>' +
          r.criados.map(c => {
            const v = c.payload ? c.payload : c;
            return `<tr><td>${c.linha}</td><td>${escapeHtml(v.fornecedor||'—')}</td><td class="col-num">${fmtBRL(v.valor)}</td><td>${escapeHtml(v.vencimento||'—')}</td></tr>`;
          }).join('') + '</tbody></table></details>';
      }
      if (err > 0) {
        html += '<details open style="margin:10px 0"><summary style="cursor:pointer;color:#EF4444;font-weight:700">❌ '+err+' erro(s)</summary><table class="bif-table" style="margin-top:8px;font-size:12px"><thead><tr><th>Linha</th><th>Motivo</th><th>Dados</th></tr></thead><tbody>' +
          r.erros.map(e => `<tr><td>${e.linha}</td><td style="color:#EF4444">${escapeHtml(e.motivo)}</td><td style="font-size:11px;color:#8899AA">${escapeHtml(JSON.stringify(e.raw).slice(0,120))}</td></tr>`).join('') + '</tbody></table></details>';
      }
      box.innerHTML = html;
      if (isPreview && ok > 0) {
        document.getElementById('bifPgImportBtnConfirmar').style.display = '';
        document.getElementById('bifPgImportBtnConfirmar').textContent = `✅ Confirmar e importar ${ok} contas`;
      }
    },

    pgBaixarTemplateCsv() {
      const empresaSugestao = (state.companies[0]?.nome) || 'Sua Empresa';
      const linhas = [
        'empresa;fornecedor;descricao;categoria;valor;vencimento;forma_pagamento;chave_pix;codigo_barras;centro_custo;banco;recorrente;observacoes',
        `${empresaSugestao};Energia Elétrica CPFL;Conta luz - filial matriz;Utilidades;R$ 2.480,50;15/05/2026;PIX;contato@cpfl.com.br;;Administrativo;;sim;Vencimento todo dia 15`,
        `${empresaSugestao};Imobiliária Centro;Aluguel galpão maio;Aluguel;8500,00;10/05/2026;Boleto;;23793.38128.60004.123456.78900.000004.5.85060000850000;Operacional;Itaú Mococa;sim;Reajuste anual em janeiro`,
        `${empresaSugestao};Fornecedor X;Insumos abril;Insumos;3245,90;20/05/2026;TED;;;Operacional;;não;NF 4521`,
      ];
      const blob = new Blob(['﻿' + linhas.join('\n')], { type:'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = 'template-contas-a-pagar.csv';
      a.click(); URL.revokeObjectURL(url);
    },

    async pgExcluir() {
      const id = this._pgCurrId; if (!id) return;
      if (!confirm('Excluir este pagamento?')) return;
      try {
        const r = await fetch('/bi-financeiro/api/pagamentos/'+id, { method:'DELETE' }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.pgFecharModal(); await this.pgReload();
      } catch(e){ alert('Erro: '+e.message); }
    },

    // =====================================================================
    // ===== RECEBIMENTOS =====
    // =====================================================================
    rcState: { lista: [], _curr: null },

    async rcReload() {
      await this.pgInitData(); // garante bancos+aprovadores carregados
      const status = document.getElementById('bifRcFiltroStatus').value;
      const empresa = document.getElementById('bifRcFiltroEmpresa').value;
      const qs = new URLSearchParams();
      if (status) qs.set('status', status);
      if (empresa) qs.set('empresaBI', empresa);
      try {
        const [r, dash] = await Promise.all([
          fetch('/bi-financeiro/api/recebimentos?'+qs).then(r=>r.json()),
          fetch('/bi-financeiro/api/recebimentos-dashboard'+(empresa?'?empresaBI='+empresa:'')).then(r=>r.json()),
        ]);
        this.rcState.lista = r.recebimentos || [];
        this.rcRenderKpis(dash.summary);
        this.rcRenderTable();
      } catch(e){ alert('Erro: '+e.message); }
    },
    rcFilterTable() { this.rcRenderTable(); },

    rcRenderKpis(summary) {
      if (!summary) { document.getElementById('bifRcKpis').innerHTML = ''; return; }
      const cards = [
        { lbl:'Em aberto', val:summary.counts.aberto+'', sub:fmtBRL(summary.valores.totalAberto), klass: summary.counts.aberto>0?'info':'ok' },
        { lbl:'Recebido (total)', val:summary.counts.recebido+'', sub:fmtBRL(summary.valores.totalRecebido), klass:'ok' },
        { lbl:'Recebido este mês', val:'',  sub:fmtBRL(summary.valores.recebidoNoMes), klass:'ok' },
        { lbl:'Vencendo hoje', val:summary.listas.vencendoHoje.length+'', sub:fmtBRL(summary.valores.vencendoHoje), klass: summary.listas.vencendoHoje.length>0?'warn':'ok' },
        { lbl:'🔴 Atrasados', val:summary.listas.vencidos.length+'', sub:fmtBRL(summary.valores.vencidos), klass: summary.listas.vencidos.length>0?'bad':'ok' },
        { lbl:'Parcial', val:summary.counts.parcial+'', klass: summary.counts.parcial>0?'warn':'muted' },
      ];
      document.getElementById('bifRcKpis').innerHTML = cards.map(c =>
        `<div class="bif-kpi ${c.klass}"><div class="lbl">${c.lbl}</div><div class="val">${c.val}</div>${c.sub?`<div class="sub">${c.sub}</div>`:''}</div>`).join('');
    },

    _rcSelected: new Set(),
    rcToggleSelect(id, checked) {
      if (checked) this._rcSelected.add(id); else this._rcSelected.delete(id);
      this._rcRenderBulkBar();
    },
    rcToggleSelectAll(checked) {
      this._rcSelected.clear();
      document.querySelectorAll('input[data-bulk-rc]').forEach(el => {
        if (checked) { this._rcSelected.add(el.getAttribute('data-bulk-rc')); el.checked = true; }
        else el.checked = false;
      });
      this._rcRenderBulkBar();
    },
    _rcRenderBulkBar() {
      const slot = document.getElementById('bifRcBulkBar'); if (!slot) return;
      if (!this.isAdmin) { slot.innerHTML = ''; return; }
      const n = this._rcSelected.size;
      if (n === 0) { slot.innerHTML = ''; return; }
      const tot = (this.rcState.lista||[]).filter(r => this._rcSelected.has(r.id)).reduce((s,r) => s + (+r.valor||0), 0);
      slot.innerHTML = `<div style="background:linear-gradient(135deg,#1a2a3a,#0F1420);border:1px solid #4F8CFF;border-radius:8px;padding:10px 14px;margin-bottom:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span style="font-weight:700">${n} recebimento(s) selecionado(s)</span>
        <span class="muted" style="font-size:12px">· Total: <b>${fmtBRL(tot)}</b></span>
        <div style="flex:1"></div>
        <button class="bif-btn sm danger" onclick="BIF.rcBulkExcluir()">🗑️ Excluir do servidor</button>
        <button class="bif-btn sm ghost" onclick="BIF.rcBulkLimpar()">✕</button>
      </div>`;
    },
    rcBulkLimpar() {
      this._rcSelected.clear();
      document.querySelectorAll('input[data-bulk-rc]').forEach(el => { el.checked = false; });
      const all = document.getElementById('bifRcBulkHead_chk'); if (all) all.checked = false;
      this._rcRenderBulkBar();
    },
    async rcBulkExcluir() {
      const ids = Array.from(this._rcSelected);
      await this._bulkDeleteServer('recebimentos', ids, 'recebimento(s)', async () => {
        this._rcSelected.clear();
        await this.rcReload();
      });
    },

    rcRenderTable() {
      const tb = document.getElementById('bifRcTbody');
      const busca = (document.getElementById('bifRcBusca').value||'').toLowerCase();
      let list = this.rcState.lista;
      if (busca) list = list.filter(r => ((r.cliente+r.descricao+r.categoria)||'').toLowerCase().includes(busca));
      const headSlot = document.getElementById('bifRcBulkHead');
      if (headSlot && this.isAdmin && !headSlot.innerHTML) {
        headSlot.innerHTML = `<input type="checkbox" id="bifRcBulkHead_chk" onchange="BIF.rcToggleSelectAll(this.checked)">`;
      }
      if (list.length === 0) { tb.innerHTML = '<tr><td colspan="11" class="bif-empty"><div class="ico">📥</div>Nenhum recebimento.</td></tr>'; this._rcRenderBulkBar(); return; }
      const today = new Date().toISOString().slice(0,10);
      tb.innerHTML = list.map(r => {
        const empNome = state.companies.find(c => c.id === r.empresaBI)?.nome || '—';
        const banco = r.contaBancariaCredito ? this.pgState.bancos.find(b => b.id === r.contaBancariaCredito) : null;
        const restante = +(Number(r.valor||0) - Number(r.valorRecebido||0)).toFixed(2);
        const isOverdue = ['a-receber','parcial'].includes(r.status) && r.vencimento && r.vencimento < today;
        const stCfg = this._rcStatusBadge(r.status, isOverdue);
        const checkboxTd = this.isAdmin
          ? `<td style="width:30px"><input type="checkbox" data-bulk-rc="${r.id}" onclick="event.stopPropagation();BIF.rcToggleSelect('${r.id}', this.checked)" ${this._rcSelected.has(r.id)?'checked':''}></td>`
          : '<td style="width:30px"></td>';
        return `<tr style="cursor:pointer${isOverdue?';background:#3a1a1a22':''}" onclick="BIF.rcEditar('${r.id}')">
          ${checkboxTd}
          <td><span class="bif-pill ${stCfg.cls}">${stCfg.txt}</span></td>
          <td style="font-size:11.5px">${escapeHtml(empNome)}</td>
          <td><b>${escapeHtml(r.cliente||'—')}</b></td>
          <td style="font-size:11.5px">${escapeHtml((r.descricao||'').slice(0,60))}</td>
          <td class="col-num"><b>${fmtBRL(r.valor)}</b></td>
          <td class="col-num ok">${fmtBRL(r.valorRecebido)}</td>
          <td class="col-num ${restante>0?'warn':'ok'}">${fmtBRL(restante)}</td>
          <td>${r.vencimento || '—'}</td>
          <td style="font-size:11px">${banco ? escapeHtml(banco.apelido||banco.banco) : '—'}</td>
          <td class="col-act"><button class="bif-btn sm ghost" onclick="event.stopPropagation();BIF.rcEditar('${r.id}')">📝</button></td>
        </tr>`;
      }).join('');
    },
    _rcStatusBadge(s, overdue) {
      if (overdue) return { cls:'bad', txt:'🔴 Atrasado' };
      const map = {
        'a-receber': { cls:'warn', txt:'⏳ A receber' },
        'parcial':   { cls:'warn', txt:'🟡 Parcial' },
        'recebido':  { cls:'ok',   txt:'✅ Recebido' },
        'cancelado': { cls:'muted', txt:'🚫 Cancelado' },
      };
      return map[s] || { cls:'muted', txt:s };
    },

    rcNovo() { this._rcAbrirModal(null); },
    async rcEditar(id) {
      try {
        const r = await fetch('/bi-financeiro/api/recebimentos/'+id).then(r=>r.json());
        this._rcAbrirModal(r.recebimento);
      } catch(e){ alert(e.message); }
    },
    _rcAbrirModal(r) {
      this.pgPopularEmpresaSelect();
      const novo = !r;
      document.getElementById('bifRcModalTitle').textContent = novo ? 'Novo recebimento' : 'Editar recebimento';
      document.getElementById('bifRcId').value = r?.id || '';
      document.getElementById('bifRcEmpresa').value = r?.empresaBI || '';
      document.getElementById('bifRcCliente').value = r?.cliente || '';
      document.getElementById('bifRcCategoria').value = r?.categoria || '';
      document.getElementById('bifRcDesc').value = r?.descricao || '';
      document.getElementById('bifRcValor').value = r?.valor || '';
      document.getElementById('bifRcVenc').value = r?.vencimento || '';
      document.getElementById('bifRcForma').value = r?.formaPagamento || '';
      document.getElementById('bifRcPix').value = r?.chavePix || '';
      document.getElementById('bifRcAnexo').value = r?.anexoUrl || '';
      document.getElementById('bifRcDealId').value = r?.dealZohoId || '';
      document.getElementById('bifRcDealModule').value = r?.dealZohoModule || '';
      document.getElementById('bifRcObs').value = r?.obs || '';
      // Bancos sugeridos: filtra por empresa do recebimento
      const sel = document.getElementById('bifRcBancoSug');
      const bancosEmp = (this.pgState.bancos||[]).filter(b => b.ativo && (!r?.empresaBI || b.empresaBI === r.empresaBI));
      sel.innerHTML = '<option value="">—</option>' + bancosEmp.map(b => `<option value="${b.id}">${escapeHtml(b.apelido||b.banco)} (saldo ${fmtBRL(b.saldoAtual)})</option>`).join('');
      sel.value = r?.contaBancariaCredito || '';

      const stCfg = r ? this._rcStatusBadge(r.status, false) : { cls:'muted', txt:'novo' };
      const stEl = document.getElementById('bifRcModalStatus');
      stEl.className = 'bif-pill ' + stCfg.cls;
      stEl.textContent = stCfg.txt;

      const editavel = !r || ['a-receber','parcial'].includes(r.status);
      const recebivel = r && ['a-receber','parcial'].includes(r.status);
      document.getElementById('bifRcBtnSalvar').style.display = editavel ? '' : 'none';
      document.getElementById('bifRcBtnParcial').style.display = recebivel ? '' : 'none';
      document.getElementById('bifRcBtnReceber').style.display = recebivel ? '' : 'none';
      document.getElementById('bifRcBtnExcluir').style.display = (r && ['a-receber','cancelado'].includes(r.status)) ? '' : 'none';
      // Lock fields se não-editável
      document.querySelectorAll('#bifRcModal input, #bifRcModal select, #bifRcModal textarea').forEach(el => {
        if (el.id === 'bifRcId') return;
        el.disabled = !editavel;
      });

      // Histórico
      const histBox = document.getElementById('bifRcHistoricoBox');
      if (r && (r.historico||[]).length > 0) {
        histBox.innerHTML = '<h3 style="margin-top:12px;font-size:12px;color:#8899AA;text-transform:uppercase">Histórico</h3>' +
          '<div style="background:#0a0a0a;border:1px solid #1a1f35;border-radius:8px;padding:10px;max-height:200px;overflow-y:auto;font-size:11.5px">' +
          r.historico.slice().reverse().map(h => `<div style="margin-bottom:6px"><b style="color:#22C55E">${escapeHtml(h.tipo)}</b> · ${(new Date(h.ts)).toLocaleString('pt-BR')} · por ${escapeHtml(h.usuario||'—')}${h.payload?'<div class="muted" style="font-size:10.5px">'+escapeHtml(JSON.stringify(h.payload).slice(0,200))+'</div>':''}</div>`).join('') +
          '</div>';
      } else { histBox.innerHTML = ''; }

      this._rcCurrId = r?.id || null;
      this.rcState._curr = r || null;
      document.getElementById('bifRcModal').classList.add('show');
    },
    rcFecharModal() { document.getElementById('bifRcModal').classList.remove('show'); this._rcCurrId = null; this.rcState._curr = null; },

    _rcPayload() {
      return {
        empresaBI: document.getElementById('bifRcEmpresa').value,
        cliente: document.getElementById('bifRcCliente').value,
        categoria: document.getElementById('bifRcCategoria').value,
        descricao: document.getElementById('bifRcDesc').value,
        valor: +document.getElementById('bifRcValor').value || 0,
        vencimento: document.getElementById('bifRcVenc').value,
        formaPagamento: document.getElementById('bifRcForma').value,
        chavePix: document.getElementById('bifRcPix').value,
        anexoUrl: document.getElementById('bifRcAnexo').value,
        contaBancariaCredito: document.getElementById('bifRcBancoSug').value,
        dealZohoId: document.getElementById('bifRcDealId').value,
        dealZohoModule: document.getElementById('bifRcDealModule').value,
        obs: document.getElementById('bifRcObs').value,
      };
    },
    async rcSalvar() {
      const body = this._rcPayload();
      if (!body.empresaBI || !body.cliente || !body.valor) { alert('Preencha empresa, cliente e valor.'); return; }
      const id = this._rcCurrId;
      try {
        const url = id ? '/bi-financeiro/api/recebimentos/'+id : '/bi-financeiro/api/recebimentos';
        const method = id ? 'PUT' : 'POST';
        const r = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.rcFecharModal();
        await this.rcReload();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async rcExcluir() {
      const id = this._rcCurrId; if (!id) return;
      if (!confirm('Excluir este recebimento?')) return;
      try {
        const r = await fetch('/bi-financeiro/api/recebimentos/'+id, { method:'DELETE' }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.rcFecharModal(); await this.rcReload();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async rcReceberTotal() {
      const r = this.rcState._curr; if (!r) return;
      const banco = document.getElementById('bifRcBancoSug').value;
      if (!banco) { alert('Selecione a conta bancária de crédito antes.'); return; }
      const restante = +(Number(r.valor||0) - Number(r.valorRecebido||0)).toFixed(2);
      if (!confirm(`Marcar como recebido?\nVai creditar ${fmtBRL(restante)} na conta ${this.pgState.bancos.find(b=>b.id===banco)?.apelido||'?'}.`)) return;
      try {
        const resp = await fetch(`/bi-financeiro/api/recebimentos/${r.id}/marcar-recebido`, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ contaBancariaId: banco })
        }).then(r=>r.json());
        if (!resp.ok) throw new Error(resp.error);
        alert('✅ Recebido. Saldo da conta: '+fmtBRL(resp.novoSaldo));
        this.rcFecharModal(); await this.rcReload();
      } catch(e){ alert('Erro: '+e.message); }
    },
    rcAbrirParcial() {
      const r = this.rcState._curr; if (!r) return;
      const restante = +(Number(r.valor||0) - Number(r.valorRecebido||0)).toFixed(2);
      document.getElementById('bifRcParcialInfo').innerHTML = `Cliente: <b>${escapeHtml(r.cliente)}</b> · Valor original: ${fmtBRL(r.valor)} · Já recebido: ${fmtBRL(r.valorRecebido)} · <b style="color:#F59E0B">Restante: ${fmtBRL(restante)}</b>`;
      document.getElementById('bifRcParcialValor').value = '';
      document.getElementById('bifRcParcialValor').max = restante;
      const sel = document.getElementById('bifRcParcialBanco');
      const bancosEmp = (this.pgState.bancos||[]).filter(b => b.ativo && (!r.empresaBI || b.empresaBI === r.empresaBI));
      sel.innerHTML = '<option value="">— escolha —</option>' + bancosEmp.map(b => `<option value="${b.id}" ${r.contaBancariaCredito===b.id?'selected':''}>${escapeHtml(b.apelido||b.banco)} (saldo ${fmtBRL(b.saldoAtual)})</option>`).join('');
      document.getElementById('bifRcParcialObs').value = '';
      document.getElementById('bifRcParcialModal').classList.add('show');
    },
    rcFecharParcial() { document.getElementById('bifRcParcialModal').classList.remove('show'); },
    async rcConfirmarParcial() {
      const r = this.rcState._curr; if (!r) return;
      const valor = +document.getElementById('bifRcParcialValor').value || 0;
      const banco = document.getElementById('bifRcParcialBanco').value;
      const obs = document.getElementById('bifRcParcialObs').value;
      if (!valor || valor <= 0) { alert('Valor inválido.'); return; }
      if (!banco) { alert('Selecione conta bancária.'); return; }
      try {
        const resp = await fetch(`/bi-financeiro/api/recebimentos/${r.id}/parcial`, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ valor, contaBancariaId: banco, obs })
        }).then(r=>r.json());
        if (!resp.ok) throw new Error(resp.error);
        alert(`✓ Parcial registrada. Restante: ${fmtBRL(resp.restante)}. Saldo banco: ${fmtBRL(resp.novoSaldo)}.`);
        this.rcFecharParcial();
        this.rcFecharModal();
        await this.rcReload();
      } catch(e){ alert('Erro: '+e.message); }
    },

    // =====================================================================
    // ===== APROVAÇÕES (queue) =====
    // =====================================================================
    // =====================================================================
    // ===== ESTOQUE (F1: Postgres) =====
    // =====================================================================
    estState: { empresas: [], estoques: [], produtos: [], _curr: null, currStab: 'dash' },

    estSwitchSubTab(stab) {
      this.estState.currStab = stab;
      document.querySelectorAll('#bifEstSubTabs .bif-tab').forEach(t => t.classList.toggle('active', t.dataset.stab === stab));
      document.querySelectorAll('.bif-stab').forEach(p => { p.style.display = p.dataset.stabPane === stab ? 'block' : 'none'; });
      if (stab === 'dash')     this.estDashReload();
      if (stab === 'empresas') this.estEmpReload();
      if (stab === 'locais')   this.estLocalReload();
      if (stab === 'produtos') this.estProdReload();
      if (stab === 'saldo')    this.estSaldoReload();
      if (stab === 'movs')     this.estMovReload();
    },

    async _estLoadAll() {
      // Helper: pré-carrega empresas+estoques+produtos pra dropdowns dos modais
      try {
        const [e, l, p] = await Promise.all([
          fetch('/bi-financeiro/api/estoque/empresas').then(r=>r.json()),
          fetch('/bi-financeiro/api/estoque/locais').then(r=>r.json()),
          fetch('/bi-financeiro/api/estoque/produtos').then(r=>r.json()),
        ]);
        this.estState.empresas = e.empresas || [];
        this.estState.estoques = l.estoques || [];
        this.estState.produtos = p.produtos || [];
      } catch(err) { console.warn('estLoadAll', err); }
    },

    // ===== Dashboard =====
    async estDashReload() {
      try {
        const r = await fetch('/bi-financeiro/api/estoque/dashboard').then(r=>r.json());
        const s = r.summary || {};
        document.getElementById('bifEstKpis').innerHTML = [
          { lbl:'Valor total em estoque', val:fmtBRL(s.valorTotal||0), klass:'info' },
          { lbl:'Produtos distintos',     val:String(s.produtosDistintos||0), klass:'info' },
          { lbl:'Abaixo do mínimo',       val:String(s.abaixoMinimoCount||0), klass: s.abaixoMinimoCount>0?'warn':'ok' },
        ].map(c => `<div class="bif-kpi ${c.klass}"><div class="lbl">${c.lbl}</div><div class="val">${c.val}</div></div>`).join('');
        const box = document.getElementById('bifEstAbaixoMin');
        if (!s.abaixoMinimo || s.abaixoMinimo.length === 0) {
          box.innerHTML = '<div class="bif-empty">✅ Tudo acima do mínimo.</div>';
        } else {
          box.innerHTML = '<table class="bif-table"><thead><tr><th>Produto</th><th>SKU</th><th class="col-num">Mínimo</th><th class="col-num">Saldo total</th><th class="col-num">Falta</th></tr></thead><tbody>' +
            s.abaixoMinimo.map(p => `<tr>
              <td><b>${escapeHtml(p.nome)}</b></td>
              <td>${escapeHtml(p.sku||'—')}</td>
              <td class="col-num">${Number(p.estoque_minimo).toFixed(2)}</td>
              <td class="col-num">${Number(p.saldo_total).toFixed(2)}</td>
              <td class="col-num bad">${(Number(p.estoque_minimo)-Number(p.saldo_total)).toFixed(2)}</td>
            </tr>`).join('') + '</tbody></table>';
        }
      } catch(e) { document.getElementById('bifEstKpis').innerHTML = `<div class="bif-alert bad"><span class="ico">❌</span><div>Erro: ${escapeHtml(e.message)}. Postgres pode não estar configurado.</div></div>`; }
    },

    // ===== Empresas (Postgres) =====
    async estEmpReload() {
      const r = await fetch('/bi-financeiro/api/estoque/empresas').then(r=>r.json());
      this.estState.empresas = r.empresas || [];
      BIF._bulkSetupHead('estoque-empresas');
      const slot = document.getElementById('bifBulkSlot_estoque-empresas');
      if (slot && !slot.innerHTML) slot.innerHTML = BIF._bulkBarHTML('estoque-empresas', 'empresa(s)', { serverKind:'estoque-empresas', afterReload:'estEmpReload' });
      const tb = document.getElementById('bifEstEmpTbody');
      const cols = this.isAdmin ? 7 : 6;
      if (this.estState.empresas.length === 0) { tb.innerHTML = `<tr><td colspan="${cols}" class="bif-empty">Nenhuma empresa cadastrada no Postgres.</td></tr>`; return; }
      tb.innerHTML = this.estState.empresas.map(e => `<tr>
        ${BIF._bulkCellCheckbox('estoque-empresas', e.id)}
        <td><b>${escapeHtml(e.nome)}</b></td>
        <td>${escapeHtml(e.cnpj||'—')}</td>
        <td>${escapeHtml(e.tipo||'—')}</td>
        <td>${escapeHtml(e.responsavel||'—')}</td>
        <td><span class="bif-pill ${e.ativo?'ok':'muted'}">${e.ativo?'Ativa':'Inativa'}</span></td>
        <td class="col-act"><button class="bif-btn sm ghost" onclick="BIF.estEmpEditar('${e.id}')">✏️</button> <button class="bif-btn sm danger" onclick="BIF.estEmpExcluir('${e.id}')">🗑️</button></td>
      </tr>`).join('');
    },
    estEmpNovo() { this._estEmpAbrir(null); },
    estEmpEditar(id) { this._estEmpAbrir(this.estState.empresas.find(e => e.id === id)); },
    _estEmpAbrir(e) {
      document.getElementById('bifEstEmpTitle').textContent = e ? 'Editar empresa' : 'Nova empresa';
      document.getElementById('bifEstEmpId').value = e?.id || '';
      document.getElementById('bifEstEmpNome').value = e?.nome || '';
      document.getElementById('bifEstEmpCnpj').value = e?.cnpj || '';
      document.getElementById('bifEstEmpTipo').value = e?.tipo || 'comercial';
      document.getElementById('bifEstEmpSeg').value = e?.segmento || '';
      document.getElementById('bifEstEmpResp').value = e?.responsavel || '';
      document.getElementById('bifEstEmpAtivo').value = e?.ativo === false ? 'false' : 'true';
      document.getElementById('bifEstEmpObs').value = e?.observacoes || '';
      document.getElementById('bifEstEmpModal').classList.add('show');
    },
    estEmpFechar() { document.getElementById('bifEstEmpModal').classList.remove('show'); },
    async estEmpSalvar() {
      const id = document.getElementById('bifEstEmpId').value;
      const body = {
        nome: document.getElementById('bifEstEmpNome').value,
        cnpj: document.getElementById('bifEstEmpCnpj').value,
        tipo: document.getElementById('bifEstEmpTipo').value,
        segmento: document.getElementById('bifEstEmpSeg').value,
        responsavel: document.getElementById('bifEstEmpResp').value,
        ativo: document.getElementById('bifEstEmpAtivo').value === 'true',
        observacoes: document.getElementById('bifEstEmpObs').value,
      };
      if (!body.nome) { alert('Nome obrigatório.'); return; }
      try {
        const url = id ? `/bi-financeiro/api/estoque/empresas/${id}` : '/bi-financeiro/api/estoque/empresas';
        const method = id ? 'PUT' : 'POST';
        const r = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this.estEmpFechar(); this.estEmpReload();
      } catch(e) { alert('Erro: '+e.message); }
    },
    async estEmpExcluir(id) {
      if (!confirm('Excluir empresa? (estoques/produtos vinculados podem perder referência)')) return;
      await fetch(`/bi-financeiro/api/estoque/empresas/${id}`, { method:'DELETE' });
      this.estEmpReload();
    },

    // ===== Estoques =====
    async estLocalReload() {
      await this._estLoadAll();
      BIF._bulkSetupHead('estoque-locais');
      const slot = document.getElementById('bifBulkSlot_estoque-locais');
      if (slot && !slot.innerHTML) slot.innerHTML = BIF._bulkBarHTML('estoque-locais', 'estoque(s)', { serverKind:'estoque-locais', afterReload:'estLocalReload' });
      const tb = document.getElementById('bifEstLocalTbody');
      const cols = this.isAdmin ? 8 : 7;
      if (this.estState.estoques.length === 0) { tb.innerHTML = `<tr><td colspan="${cols}" class="bif-empty">Cadastre um estoque pra começar.</td></tr>`; return; }
      tb.innerHTML = this.estState.estoques.map(e => {
        const emp = this.estState.empresas.find(x => x.id === e.empresa_id);
        return `<tr>
          ${BIF._bulkCellCheckbox('estoque-locais', e.id)}
          <td><b>${escapeHtml(e.nome)}</b></td>
          <td>${escapeHtml(emp?.nome||'—')}</td>
          <td><span class="bif-pill info">${escapeHtml(e.tipo)}</span></td>
          <td>${escapeHtml(e.responsavel||'—')} ${e.responsavel_username?`<span class="muted" style="font-size:10.5px">@${escapeHtml(e.responsavel_username)}</span>`:''}</td>
          <td>${escapeHtml(e.localizacao||'—')}</td>
          <td><span class="bif-pill ${e.ativo?'ok':'muted'}">${e.ativo?'Ativo':'Inativo'}</span></td>
          <td class="col-act"><button class="bif-btn sm ghost" onclick="BIF.estLocalEditar('${e.id}')">✏️</button> <button class="bif-btn sm danger" onclick="BIF.estLocalExcluir('${e.id}')">🗑️</button></td>
        </tr>`;
      }).join('');
    },
    estLocalNovo() { this._estLocalAbrir(null); },
    estLocalEditar(id) { this._estLocalAbrir(this.estState.estoques.find(e => e.id === id)); },
    _estLocalAbrir(e) {
      const emp = document.getElementById('bifEstLocalEmp');
      emp.innerHTML = '<option value="">—</option>' + this.estState.empresas.map(x => `<option value="${x.id}">${escapeHtml(x.nome)}</option>`).join('');
      document.getElementById('bifEstLocalTitle').textContent = e ? 'Editar estoque' : 'Novo estoque';
      document.getElementById('bifEstLocalId').value = e?.id || '';
      document.getElementById('bifEstLocalNome').value = e?.nome || '';
      emp.value = e?.empresa_id || '';
      document.getElementById('bifEstLocalTipo').value = e?.tipo || 'central';
      document.getElementById('bifEstLocalResp').value = e?.responsavel || '';
      document.getElementById('bifEstLocalRespU').value = e?.responsavel_username || '';
      document.getElementById('bifEstLocalLoc').value = e?.localizacao || '';
      document.getElementById('bifEstLocalObs').value = e?.observacoes || '';
      document.getElementById('bifEstLocalModal').classList.add('show');
    },
    estLocalFechar() { document.getElementById('bifEstLocalModal').classList.remove('show'); },
    async estLocalSalvar() {
      const id = document.getElementById('bifEstLocalId').value;
      const body = {
        nome: document.getElementById('bifEstLocalNome').value,
        empresaId: document.getElementById('bifEstLocalEmp').value || null,
        tipo: document.getElementById('bifEstLocalTipo').value,
        responsavel: document.getElementById('bifEstLocalResp').value,
        responsavelUsername: document.getElementById('bifEstLocalRespU').value,
        localizacao: document.getElementById('bifEstLocalLoc').value,
        observacoes: document.getElementById('bifEstLocalObs').value,
      };
      if (!body.nome) return alert('Nome obrigatório.');
      try {
        const url = id ? `/bi-financeiro/api/estoque/locais/${id}` : '/bi-financeiro/api/estoque/locais';
        const method = id ? 'PUT' : 'POST';
        const r = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this.estLocalFechar(); this.estLocalReload();
      } catch(e) { alert('Erro: '+e.message); }
    },
    async estLocalExcluir(id) {
      if (!confirm('Excluir estoque? Saldos e mov vinculados também são removidos.')) return;
      await fetch(`/bi-financeiro/api/estoque/locais/${id}`, { method:'DELETE' });
      this.estLocalReload();
    },

    // ===== Produtos =====
    async estProdReload() {
      await this._estLoadAll();
      const busca = document.getElementById('bifEstProdBusca')?.value || '';
      const url = '/bi-financeiro/api/estoque/produtos' + (busca ? '?search='+encodeURIComponent(busca) : '');
      const r = await fetch(url).then(r=>r.json());
      this.estState.produtos = r.produtos || [];
      BIF._bulkSetupHead('estoque-produtos');
      const slot = document.getElementById('bifBulkSlot_estoque-produtos');
      if (slot && !slot.innerHTML) slot.innerHTML = BIF._bulkBarHTML('estoque-produtos', 'produto(s)', { serverKind:'estoque-produtos', afterReload:'estProdReload' });
      const tb = document.getElementById('bifEstProdTbody');
      const cols = this.isAdmin ? 9 : 8;
      if (this.estState.produtos.length === 0) { tb.innerHTML = `<tr><td colspan="${cols}" class="bif-empty">Nenhum produto.</td></tr>`; return; }
      tb.innerHTML = this.estState.produtos.map(p => `<tr>
        ${BIF._bulkCellCheckbox('estoque-produtos', p.id)}
        <td>${escapeHtml(p.sku||'—')}</td>
        <td><b>${escapeHtml(p.nome)}</b></td>
        <td>${escapeHtml(p.categoria||'—')}</td>
        <td class="col-num">${fmtBRL(p.custo_medio)}</td>
        <td class="col-num">${fmtBRL(p.preco_venda)}</td>
        <td class="col-num">${Number(p.estoque_minimo).toFixed(2)}</td>
        <td class="col-num"><a href="javascript:void(0)" onclick="BIF.estProdSaldoTotal('${p.id}')" style="color:#4F8CFF">ver</a></td>
        <td class="col-act"><button class="bif-btn sm ghost" onclick="BIF.estProdEditar('${p.id}')">✏️</button> <button class="bif-btn sm danger" onclick="BIF.estProdExcluir('${p.id}')">🗑️</button></td>
      </tr>`).join('');
    },
    estProdNovo() { this._estProdAbrir(null); },
    estProdEditar(id) { this._estProdAbrir(this.estState.produtos.find(p => p.id === id)); },
    _estProdAbrir(p) {
      const emp = document.getElementById('bifEstProdEmp');
      emp.innerHTML = '<option value="">—</option>' + this.estState.empresas.map(x => `<option value="${x.id}">${escapeHtml(x.nome)}</option>`).join('');
      document.getElementById('bifEstProdTitle').textContent = p ? 'Editar produto' : 'Novo produto';
      document.getElementById('bifEstProdId').value = p?.id || '';
      document.getElementById('bifEstProdSku').value = p?.sku || '';
      document.getElementById('bifEstProdNome').value = p?.nome || '';
      document.getElementById('bifEstProdCat').value = p?.categoria || '';
      document.getElementById('bifEstProdUn').value = p?.unidade || 'UN';
      emp.value = p?.empresa_dona_id || '';
      document.getElementById('bifEstProdCM').value = p?.custo_medio || 0;
      document.getElementById('bifEstProdPV').value = p?.preco_venda || 0;
      document.getElementById('bifEstProdForn').value = p?.fornecedor_principal || '';
      document.getElementById('bifEstProdMin').value = p?.estoque_minimo || 0;
      document.getElementById('bifEstProdMax').value = p?.estoque_maximo || 0;
      document.getElementById('bifEstProdAtv').value = p?.ativo === false ? 'false' : 'true';
      document.getElementById('bifEstProdModal').classList.add('show');
    },
    estProdFechar() { document.getElementById('bifEstProdModal').classList.remove('show'); },
    async estProdSalvar() {
      const id = document.getElementById('bifEstProdId').value;
      const body = {
        sku: document.getElementById('bifEstProdSku').value,
        nome: document.getElementById('bifEstProdNome').value,
        categoria: document.getElementById('bifEstProdCat').value,
        unidade: document.getElementById('bifEstProdUn').value,
        empresaDonaId: document.getElementById('bifEstProdEmp').value || null,
        custoMedio: +document.getElementById('bifEstProdCM').value || 0,
        precoVenda: +document.getElementById('bifEstProdPV').value || 0,
        fornecedorPrincipal: document.getElementById('bifEstProdForn').value,
        estoqueMinimo: +document.getElementById('bifEstProdMin').value || 0,
        estoqueMaximo: +document.getElementById('bifEstProdMax').value || 0,
        ativo: document.getElementById('bifEstProdAtv').value === 'true',
      };
      if (!body.nome) return alert('Nome obrigatório.');
      try {
        const url = id ? `/bi-financeiro/api/estoque/produtos/${id}` : '/bi-financeiro/api/estoque/produtos';
        const method = id ? 'PUT' : 'POST';
        const r = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this.estProdFechar(); this.estProdReload();
      } catch(e) { alert('Erro: '+e.message); }
    },
    async estProdExcluir(id) {
      if (!confirm('Excluir produto? Todas as movimentações vinculadas viram órfãs.')) return;
      await fetch(`/bi-financeiro/api/estoque/produtos/${id}`, { method:'DELETE' });
      this.estProdReload();
    },
    async estProdSaldoTotal(prodId) {
      try {
        const r = await fetch('/bi-financeiro/api/estoque/saldo?produtoId='+prodId).then(r=>r.json());
        const linhas = (r.saldos||[]).map(s => `${s.estoque_nome} (${s.estoque_tipo}): ${Number(s.qtd).toFixed(2)} ${s.responsavel_username?'@'+s.responsavel_username:''}`).join('\n');
        alert('Saldo do produto:\n\n' + (linhas || 'sem saldo em nenhum estoque'));
      } catch(e){ alert(e.message); }
    },

    // ===== Saldo =====
    async estSaldoReload() {
      await this._estLoadAll();
      const sel = document.getElementById('bifEstSaldoEstoque');
      sel.innerHTML = '<option value="">— escolha um estoque —</option>' + this.estState.estoques.map(e => `<option value="${e.id}">${escapeHtml(e.nome)} (${escapeHtml(e.tipo)})</option>`).join('');
      const eid = sel.value;
      const tb = document.getElementById('bifEstSaldoTbody');
      const resumo = document.getElementById('bifEstSaldoResumo');
      if (!eid) { tb.innerHTML = '<tr><td colspan="7" class="bif-empty">Escolha um estoque.</td></tr>'; resumo.textContent = ''; return; }
      const r = await fetch('/bi-financeiro/api/estoque/saldo?estoqueId='+eid).then(r=>r.json());
      const lista = r.saldos || [];
      if (lista.length === 0) { tb.innerHTML = '<tr><td colspan="7" class="bif-empty">Estoque vazio.</td></tr>'; resumo.textContent = ''; return; }
      let valorTot = 0;
      tb.innerHTML = lista.map(s => {
        const valor = Number(s.qtd) * Number(s.custo_medio); valorTot += valor;
        const abaixo = Number(s.qtd) < Number(s.estoque_minimo);
        return `<tr ${abaixo?'style="background:#3a1a1a22"':''}>
          <td><b>${escapeHtml(s.produto_nome)}</b></td>
          <td>${escapeHtml(s.sku||'—')}</td>
          <td class="col-num"><b>${Number(s.qtd).toFixed(2)} ${escapeHtml(s.unidade||'')}</b></td>
          <td class="col-num">${Number(s.qtd_reservada).toFixed(2)}</td>
          <td class="col-num">${fmtBRL(s.custo_medio)}</td>
          <td class="col-num">${Number(s.estoque_minimo).toFixed(2)}</td>
          <td>${abaixo?'<span class="bif-pill bad">🔴 abaixo do mín</span>':'<span class="bif-pill ok">OK</span>'}</td>
        </tr>`;
      }).join('');
      resumo.textContent = `${lista.length} produto(s) · valor estoque ${fmtBRL(valorTot)}`;
    },

    // ===== Movimentações =====
    async estMovReload() {
      await this._estLoadAll();
      const tipo = document.getElementById('bifEstMovTipo')?.value || '';
      const url = '/bi-financeiro/api/estoque/movimentacoes' + (tipo ? '?tipo='+tipo : '');
      const r = await fetch(url).then(r=>r.json());
      const tb = document.getElementById('bifEstMovTbody');
      if ((r.movimentacoes||[]).length === 0) { tb.innerHTML = '<tr><td colspan="9" class="bif-empty">Nenhuma movimentação.</td></tr>'; return; }
      const prodMap = Object.fromEntries(this.estState.produtos.map(p => [p.id, p.nome]));
      const estMap  = Object.fromEntries(this.estState.estoques.map(e => [e.id, e.nome]));
      tb.innerHTML = r.movimentacoes.map(m => `<tr>
        <td>${(new Date(m.ts)).toLocaleString('pt-BR')}</td>
        <td><span class="bif-pill info">${escapeHtml(m.tipo)}</span></td>
        <td>${escapeHtml(prodMap[m.produto_id]||m.produto_id?.slice(0,12)||'—')}</td>
        <td>${escapeHtml(estMap[m.estoque_origem_id]||'—')}</td>
        <td>${escapeHtml(estMap[m.estoque_destino_id]||'—')}</td>
        <td class="col-num"><b>${Number(m.qtd).toFixed(2)}</b></td>
        <td class="col-num">${m.custo_unit?fmtBRL(m.custo_unit):'—'}</td>
        <td>${escapeHtml(m.usuario||'—')}</td>
        <td style="font-size:11.5px">${escapeHtml((m.obs||'').slice(0,60))}</td>
      </tr>`).join('');
    },
    async estMovNova() {
      await this._estLoadAll();
      // Popula selects
      const prodSel = document.getElementById('bifEstMovProd');
      prodSel.innerHTML = '<option value="">—</option>' + this.estState.produtos.map(p => `<option value="${p.id}">${escapeHtml(p.nome)}${p.sku?' ('+escapeHtml(p.sku)+')':''}</option>`).join('');
      ['bifEstMovOrig','bifEstMovDest'].forEach(id => {
        const s = document.getElementById(id);
        s.innerHTML = '<option value="">—</option>' + this.estState.estoques.map(e => `<option value="${e.id}">${escapeHtml(e.nome)} (${escapeHtml(e.tipo)})</option>`).join('');
      });
      document.getElementById('bifEstMovTipoSel').value = 'entrada-manual';
      document.getElementById('bifEstMovQtd').value = '';
      document.getElementById('bifEstMovCusto').value = '';
      document.getElementById('bifEstMovObs').value = '';
      this.estMovOnTipoChange();
      document.getElementById('bifEstMovModal').classList.add('show');
    },
    estMovFechar() { document.getElementById('bifEstMovModal').classList.remove('show'); },
    estMovOnTipoChange() {
      // Habilita origem/destino conforme tipo
      const tipo = document.getElementById('bifEstMovTipoSel').value;
      const orig = document.getElementById('bifEstMovOrig').parentElement;
      const dest = document.getElementById('bifEstMovDest').parentElement;
      const needOrig = ['transferencia','saida-instalacao','perda','ajuste'].includes(tipo);
      const needDest = ['entrada-manual','compra-recebida','transferencia','devolucao','ajuste'].includes(tipo);
      orig.style.opacity = needOrig ? '1' : '0.3';
      dest.style.opacity = needDest ? '1' : '0.3';
    },
    async estMovSalvar() {
      const body = {
        tipo: document.getElementById('bifEstMovTipoSel').value,
        produtoId: document.getElementById('bifEstMovProd').value,
        estoqueOrigemId: document.getElementById('bifEstMovOrig').value || null,
        estoqueDestinoId: document.getElementById('bifEstMovDest').value || null,
        qtd: +document.getElementById('bifEstMovQtd').value || 0,
        custoUnit: document.getElementById('bifEstMovCusto').value ? +document.getElementById('bifEstMovCusto').value : null,
        obs: document.getElementById('bifEstMovObs').value,
      };
      if (!body.produtoId) return alert('Selecione produto.');
      if (!body.qtd) return alert('Quantidade obrigatória.');
      try {
        const r = await fetch('/bi-financeiro/api/estoque/movimentar', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this.estMovFechar(); this.estMovReload(); this.estDashReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    // =====================================================================
    // ===== LOGÍSTICA (veículos + rotas com rateio de custo) =====
    // =====================================================================
    logState: { currStab: 'rotas', veiculos: [], rotas: [], historico: [] },

    logSwitchSubTab(stab) {
      this.logState.currStab = stab;
      document.querySelectorAll('#bifLogSubTabs .bif-tab').forEach(t => t.classList.toggle('active', t.dataset.lstab === stab));
      document.querySelectorAll('.bif-lstab').forEach(p => { p.style.display = p.dataset.lstabPane === stab ? 'block' : 'none'; });
      if (stab === 'rotas')     this.logRotasReload();
      if (stab === 'historico') this.logHistReload();
      if (stab === 'veiculos')  this.veicReload();
    },

    // ===== Veículos =====
    async veicReload() {
      const ativo = document.getElementById('bifVeicFiltroAtivo')?.value;
      const qs = ativo ? '?ativo='+ativo : '';
      try {
        const r = await fetch('/bi-financeiro/api/veiculos' + qs).then(r=>r.json());
        this.logState.veiculos = r.veiculos || [];
        const tb = document.getElementById('bifVeicTbody');
        const resumo = document.getElementById('bifVeicResumo');
        if (resumo) resumo.textContent = `${this.logState.veiculos.length} veículo(s)`;
        if (this.logState.veiculos.length === 0) {
          tb.innerHTML = '<tr><td colspan="7" class="bif-empty">Cadastre o primeiro veículo da frota.</td></tr>';
          return;
        }
        tb.innerHTML = this.logState.veiculos.map(v => `<tr>
          <td><b>${escapeHtml(v.placa||'—')}</b></td>
          <td>${escapeHtml((v.marca||'')+' '+(v.modelo||''))} ${v.ano?`<span class="muted">${v.ano}</span>`:''}</td>
          <td><span class="bif-pill info">${escapeHtml(v.tipo||'—')}</span></td>
          <td>${escapeHtml(v.motorista_padrao||'—')} ${v.motorista_padrao_username?`<span class="muted" style="font-size:10.5px">@${escapeHtml(v.motorista_padrao_username)}</span>`:''}</td>
          <td class="col-num"><b>${fmtBRL(v.custo_km)}</b></td>
          <td><span class="bif-pill ${v.ativo?'ok':'muted'}">${v.ativo?'Ativo':'Inativo'}</span></td>
          <td class="col-act">
            <button class="bif-btn sm ghost" onclick="BIF.veicEditar('${v.id}')">✏️</button>
            <button class="bif-btn sm danger" onclick="BIF.veicExcluir('${v.id}')">🗑️</button>
          </td>
        </tr>`).join('');
      } catch(e) {
        document.getElementById('bifVeicTbody').innerHTML = `<tr><td colspan="7" class="bif-empty">Erro: ${escapeHtml(e.message)}</td></tr>`;
      }
    },
    veicNovo() { this._veicAbrir(null); },
    veicEditar(id) { this._veicAbrir(this.logState.veiculos.find(v => v.id === id)); },
    _veicAbrir(v) {
      // Empresas pro dropdown
      const emp = document.getElementById('bifVeicEmpresa');
      emp.innerHTML = '<option value="">—</option>' + (this.estState?.empresas||[]).map(e => `<option value="${e.id}">${escapeHtml(e.nome)}</option>`).join('');
      document.getElementById('bifVeicTitle').textContent = v ? 'Editar veículo' : 'Novo veículo';
      document.getElementById('bifVeicId').value = v?.id || '';
      document.getElementById('bifVeicPlaca').value = v?.placa || '';
      document.getElementById('bifVeicTipo').value = v?.tipo || 'van';
      document.getElementById('bifVeicMarca').value = v?.marca || '';
      document.getElementById('bifVeicModelo').value = v?.modelo || '';
      document.getElementById('bifVeicAno').value = v?.ano || '';
      document.getElementById('bifVeicCustoKm').value = v?.custo_km || '';
      emp.value = v?.empresa_id || '';
      document.getElementById('bifVeicMotorista').value = v?.motorista_padrao || '';
      document.getElementById('bifVeicMotoristaU').value = v?.motorista_padrao_username || '';
      document.getElementById('bifVeicAtivo').value = v?.ativo === false ? 'false' : 'true';
      document.getElementById('bifVeicObs').value = v?.observacoes || '';
      document.getElementById('bifVeicModal').classList.add('show');
    },
    veicFechar() { document.getElementById('bifVeicModal').classList.remove('show'); },
    async veicSalvar() {
      const id = document.getElementById('bifVeicId').value;
      const body = {
        placa: document.getElementById('bifVeicPlaca').value,
        tipo: document.getElementById('bifVeicTipo').value,
        marca: document.getElementById('bifVeicMarca').value,
        modelo: document.getElementById('bifVeicModelo').value,
        ano: document.getElementById('bifVeicAno').value || null,
        custoKm: document.getElementById('bifVeicCustoKm').value || 0,
        empresaId: document.getElementById('bifVeicEmpresa').value || null,
        motoristaPadrao: document.getElementById('bifVeicMotorista').value,
        motoristaPadraoUsername: document.getElementById('bifVeicMotoristaU').value,
        ativo: document.getElementById('bifVeicAtivo').value === 'true',
        observacoes: document.getElementById('bifVeicObs').value,
      };
      if (!body.placa && !body.modelo) return alert('Placa ou modelo obrigatório.');
      if (Number(body.custoKm) <= 0) return alert('Custo/km precisa ser > 0 pra entrar nos rateios.');
      try {
        const url = id ? `/bi-financeiro/api/veiculos/${id}` : '/bi-financeiro/api/veiculos';
        const method = id ? 'PUT' : 'POST';
        const r = await fetch(url, { method, headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this.veicFechar(); this.veicReload();
      } catch(e) { alert('Erro: '+e.message); }
    },
    async veicExcluir(id) {
      if (!confirm('Excluir veículo? Rotas finalizadas com ele continuam (snapshot do custo/km foi salvo).')) return;
      try {
        const r = await fetch(`/bi-financeiro/api/veiculos/${id}`, { method:'DELETE' }).then(r=>r.json());
        if (r.ok === false) throw new Error(r.error||'erro');
        this.veicReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    // ===== Rotas pendentes =====
    async logRotasReload() {
      const dtIni = document.getElementById('bifLogDtIni')?.value;
      const dtFim = document.getElementById('bifLogDtFim')?.value;
      const filtro = document.getElementById('bifLogFiltroStatus')?.value;
      // defaults: últimos 30d se vazio
      const params = new URLSearchParams();
      if (dtIni) params.set('dateFrom', dtIni);
      if (dtFim) params.set('dateTo', dtFim);
      const tb = document.getElementById('bifLogRotasTbody');
      tb.innerHTML = '<tr><td colspan="6" class="bif-empty">⏳ Carregando rotas do tdf-ops...</td></tr>';
      try {
        const r = await fetch('/bi-financeiro/api/rotas/listar?'+params.toString()).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        let rotas = r.rotas || [];
        if (filtro === 'pendente')   rotas = rotas.filter(x => !x.finalizada);
        if (filtro === 'finalizada') rotas = rotas.filter(x =>  x.finalizada);
        this.logState.rotas = rotas;
        const resumo = document.getElementById('bifLogResumo');
        if (resumo) {
          const pend = rotas.filter(x => !x.finalizada).length;
          resumo.textContent = `${rotas.length} rota(s) · ${pend} pendente(s)`;
        }
        if (rotas.length === 0) { tb.innerHTML = '<tr><td colspan="6" class="bif-empty">Nenhuma rota no filtro.</td></tr>'; return; }
        tb.innerHTML = rotas.map(rt => `<tr>
          <td>${escapeHtml(rt.route_date||'—')}</td>
          <td><b>${escapeHtml(rt.technician_name||'—')}</b></td>
          <td class="col-num">${rt.total_stops||0}</td>
          <td><span class="bif-pill info">${escapeHtml(rt.status||'—')}</span></td>
          <td>${rt.finalizada ? '<span class="bif-pill ok">✓ Finalizada</span>' : '<span class="bif-pill warn">⏳ Pendente</span>'}</td>
          <td class="col-act">
            ${rt.finalizada
              ? `<button class="bif-btn sm danger" onclick="BIF.logRotaDesfazer('${rt.id}')">↩️ Desfazer</button>`
              : `<button class="bif-btn sm primary" onclick="BIF.logRotaAbrir('${rt.id}')">📍 Finalizar</button>`}
          </td>
        </tr>`).join('');
      } catch(e) {
        tb.innerHTML = `<tr><td colspan="6" class="bif-empty">❌ ${escapeHtml(e.message)}</td></tr>`;
      }
    },

    async logRotaAbrir(routeIdExterno) {
      // Carrega veículos ativos pro dropdown
      if (!this.logState.veiculos.length) {
        try { const r = await fetch('/bi-financeiro/api/veiculos?ativo=true').then(r=>r.json()); this.logState.veiculos = r.veiculos || []; }
        catch(_) {}
      }
      const rota = this.logState.rotas.find(x => String(x.id) === String(routeIdExterno));
      if (!rota) { alert('Rota não encontrada na lista — atualize.'); return; }
      // Conta stops com sale_id pra mostrar quantas paradas vão receber rateio
      const stopsComVenda = (rota.stops || []).filter(s => s.sale_id).length;
      const stopsInfo = stopsComVenda > 0
        ? `<b>${stopsComVenda}</b> parada(s) com venda vinculada vão receber rateio.`
        : `⚠️ Esta rota não tem nenhuma parada com sale_id (só manutenção). Custo será calculado mas não vai pra ficha de venda.`;
      document.getElementById('bifLogRotaInfo').innerHTML = `
        <div><b>📅</b> ${escapeHtml(rota.route_date||'—')} · <b>👷</b> ${escapeHtml(rota.technician_name||'—')}</div>
        <div style="margin-top:4px"><b>${rota.total_stops||0}</b> parada(s) total. ${stopsInfo}</div>
      `;
      document.getElementById('bifLogRotaId').value = routeIdExterno;
      const sel = document.getElementById('bifLogRotaVeic');
      sel.innerHTML = '<option value="">— escolha —</option>' + this.logState.veiculos.filter(v=>v.ativo).map(v =>
        `<option value="${v.id}" data-custo-km="${v.custo_km}">${escapeHtml(v.placa||v.modelo||'(s/placa)')} — ${fmtBRL(v.custo_km)}/km</option>`).join('');
      document.getElementById('bifLogRotaKm').value = '';
      document.getElementById('bifLogRotaObs').value = '';
      document.getElementById('bifLogRotaPreview').style.display = 'none';
      // Bind preview ao mudar km/veículo
      const upd = () => this._logRotaPreviewUpd();
      sel.onchange = upd;
      document.getElementById('bifLogRotaKm').oninput = upd;
      document.getElementById('bifLogRotaModal').classList.add('show');
    },
    _logRotaPreviewUpd() {
      const sel = document.getElementById('bifLogRotaVeic');
      const km = +document.getElementById('bifLogRotaKm').value || 0;
      const custoKm = +sel.selectedOptions[0]?.dataset.custoKm || 0;
      const box = document.getElementById('bifLogRotaPreview');
      if (!sel.value || km <= 0) { box.style.display='none'; return; }
      const rotaId = document.getElementById('bifLogRotaId').value;
      const rota = this.logState.rotas.find(x => String(x.id) === String(rotaId));
      const stopsComVenda = (rota?.stops || []).filter(s => s.sale_id).length || 0;
      const total = km * custoKm;
      const porParada = stopsComVenda > 0 ? total / stopsComVenda : 0;
      box.innerHTML = `<b>Custo total:</b> ${fmtBRL(total)} (${km}km × ${fmtBRL(custoKm)}/km)<br>
        <b>Por entrega:</b> ${fmtBRL(porParada)} ${stopsComVenda > 0 ? `(rateio entre ${stopsComVenda} venda(s))` : '(nenhuma venda — não vai pra ficha)'}`;
      box.style.display = 'block';
    },
    logRotaFechar() { document.getElementById('bifLogRotaModal').classList.remove('show'); },
    async logRotaConfirmar() {
      const body = {
        routeIdExterno: document.getElementById('bifLogRotaId').value,
        veiculoId: document.getElementById('bifLogRotaVeic').value,
        kmRodado: +document.getElementById('bifLogRotaKm').value || 0,
        observacoes: document.getElementById('bifLogRotaObs').value,
      };
      if (!body.veiculoId) return alert('Escolha o veículo.');
      if (body.kmRodado <= 0) return alert('Km rodado precisa ser > 0.');
      try {
        const r = await fetch('/bi-financeiro/api/rotas/finalizar', {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        alert(`✅ Rota finalizada!\n\nCusto total: ${fmtBRL(r.rota.custoTotal)}\nPor entrega: ${fmtBRL(r.rota.custoPorEntrega)}\nRateado em ${r.rota.stopsComVenda} venda(s).`);
        this.logRotaFechar();
        this.logRotasReload();
      } catch(e) { alert('Erro: '+e.message); }
    },
    async logRotaDesfazer(routeIdExterno) {
      if (!confirm('Desfazer finalização? Rateio nas vendas será removido.')) return;
      try {
        const r = await fetch(`/bi-financeiro/api/rotas/finalizar/${routeIdExterno}`, { method:'DELETE' }).then(r=>r.json());
        if (r.ok === false) throw new Error(r.error||'erro');
        this.logRotasReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    // ===== Histórico =====
    async logHistReload() {
      const tb = document.getElementById('bifLogHistTbody');
      tb.innerHTML = '<tr><td colspan="9" class="bif-empty">⏳ Carregando...</td></tr>';
      try {
        const r = await fetch('/bi-financeiro/api/rotas/historico').then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this.logState.historico = r.historico || [];
        const resumo = document.getElementById('bifLogHistResumo');
        const totalCusto = this.logState.historico.reduce((s,x) => s + Number(x.custo_total||0), 0);
        if (resumo) resumo.textContent = `${this.logState.historico.length} rota(s) · Total ${fmtBRL(totalCusto)}`;
        if (this.logState.historico.length === 0) { tb.innerHTML = '<tr><td colspan="9" class="bif-empty">Sem rotas finalizadas ainda.</td></tr>'; return; }
        tb.innerHTML = this.logState.historico.map(h => `<tr>
          <td>${escapeHtml(h.route_date||'—')}</td>
          <td>${escapeHtml(h.technician_name||'—')}</td>
          <td>${escapeHtml(h.placa||h.modelo||'—')}</td>
          <td class="col-num">${Number(h.km_rodado).toFixed(1)}</td>
          <td class="col-num">${fmtBRL(h.custo_km)}</td>
          <td class="col-num"><b>${fmtBRL(h.custo_total)}</b></td>
          <td class="col-num">${h.stops_com_venda}/${h.stops_total}</td>
          <td class="col-num">${fmtBRL(h.custo_por_entrega)}</td>
          <td class="col-act">
            <button class="bif-btn sm danger" onclick="BIF.logRotaDesfazer('${h.route_id_externo}')">↩️ Desfazer</button>
          </td>
        </tr>`).join('');
      } catch(e) {
        tb.innerHTML = `<tr><td colspan="9" class="bif-empty">❌ ${escapeHtml(e.message)}</td></tr>`;
      }
    },

    // =====================================================================
    // ===== NF-e ENTRADA (XML → estoque + contas a pagar) =====
    // =====================================================================
    nfState: { lista: [], curr: null, fornecedores: [], estoques: [], produtosCache: [] },

    async nfImapStatus() {
      try {
        const r = await fetch('/bi-financeiro/api/nf/imap/status').then(r=>r.json());
        const s = r.status || {};
        const box = document.getElementById('bifNfImapStatus');
        if (!box) return;
        if (!s.enabled) {
          box.innerHTML = '<span class="muted">📭 Monitor IMAP desligado — configure NF_IMAP_ENABLED=true + credenciais na Railway pra ligar.</span>';
        } else {
          const ult = s.ultimaExec;
          const prox = s.proximaExecISO ? new Date(s.proximaExecISO).toLocaleTimeString('pt-BR') : '—';
          const ultStr = ult ? `${new Date(ult.ts).toLocaleString('pt-BR')} — ${ult.xmlsIngeridos} XML(s), ${ult.duplicados} duplicado(s), ${ult.erros} erro(s)` : 'nunca rodou';
          const errStr = s.ultimoErro ? `<span style="color:#EF4444"> · ⚠️ ${escapeHtml(s.ultimoErro.msg)}</span>` : '';
          box.innerHTML = `<span class="bif-pill ok">📬 Monitor IMAP ativo</span> · Última: ${ultStr} · Próxima: ~${prox}${errStr}`;
        }
      } catch(_) {}
    },

    async nfImapTrigger() {
      const btn = event.target;
      const orig = btn.textContent;
      btn.disabled = true; btn.textContent = '⏳ Checando...';
      try {
        const r = await fetch('/bi-financeiro/api/nf/imap/trigger', { method:'POST' }).then(r=>r.json());
        if (r.ok === false || r.error) throw new Error(r.error||'erro');
        if (r.skipped) alert('Já tem uma checagem rodando — aguarde.');
        else alert(`✓ Checagem concluída.\nEmails lidos: ${r.emailsLidos}\nXMLs ingeridos: ${r.xmlsIngeridos}\nDuplicados: ${r.duplicados}\nErros: ${r.erros}`);
        this.nfReload(); this.nfImapStatus();
      } catch(e) { alert('Erro: '+e.message); }
      finally { btn.disabled = false; btn.textContent = orig; }
    },

    async nfUpload(ev) {
      const file = ev.target.files?.[0];
      if (!file) return;
      try {
        const xml = await file.text();
        const r = await fetch('/bi-financeiro/api/nf/upload', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ xml, filename: file.name })
        }).then(r=>r.json());
        if (r.error) throw new Error(r.error);
        if (r.duplicada) alert(`⚠️ NF já estava cadastrada (status: ${r.status}). Abrindo pra revisão.`);
        else alert(`✓ NF importada · ${r.itens} item(ns) · ${r.fornecedorAuto?'fornecedor auto-criado':'fornecedor existente'}`);
        await this.nfReload();
        if (r.id) await this.nfAbrir(r.id);
      } catch(e) { alert('Erro: '+e.message); }
      finally { ev.target.value = ''; }
    },

    async nfReload() {
      const filtro = document.getElementById('bifNfFiltroStatus')?.value;
      const params = new URLSearchParams();
      if (filtro) params.set('status', filtro);
      try {
        const r = await fetch('/bi-financeiro/api/nf/listar?'+params.toString()).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this.nfState.lista = r.nfs || [];
        const tb = document.getElementById('bifNfTbody');
        const resumo = document.getElementById('bifNfResumo');
        if (resumo) resumo.textContent = `${this.nfState.lista.length} NF(s)`;
        if (this.nfState.lista.length === 0) { tb.innerHTML = '<tr><td colspan="8" class="bif-empty">Sem NFs nesse filtro.</td></tr>'; return; }
        tb.innerHTML = this.nfState.lista.map(n => {
          const statusPill = n.status === 'processada' ? '<span class="bif-pill ok">✓ Processada</span>'
            : n.status === 'descartada' ? '<span class="bif-pill muted">🗑️ Descartada</span>'
            : '<span class="bif-pill warn">⏳ Pendente</span>';
          const empresaTxt = n.empresa_nome ? escapeHtml(n.empresa_nome) : `<span class="muted">${escapeHtml(n.destinatario_razao||'—')} (s/ match)</span>`;
          return `<tr>
            <td>${n.created_at ? new Date(n.created_at).toLocaleDateString('pt-BR') : '—'}</td>
            <td><b>${escapeHtml(n.nfe_numero||'')}/${escapeHtml(n.nfe_serie||'')}</b></td>
            <td>${escapeHtml(n.emitente_razao||n.emitente_cnpj||'—')}</td>
            <td>${empresaTxt}</td>
            <td class="col-num">${fmtBRL(n.nfe_valor_total)}</td>
            <td class="col-num">${n.itens_match}/${n.itens_total}</td>
            <td>${statusPill}</td>
            <td class="col-act">
              <button class="bif-btn sm primary" onclick="BIF.nfAbrir('${n.id}')">${n.status === 'processada' ? '👁️ Ver' : '📝 Revisar'}</button>
            </td>
          </tr>`;
        }).join('');
      } catch(e) {
        document.getElementById('bifNfTbody').innerHTML = `<tr><td colspan="8" class="bif-empty">❌ ${escapeHtml(e.message)}</td></tr>`;
      }
    },

    async _nfLoadAux() {
      // Carrega listas auxiliares pros dropdowns do modal
      if (!this.estState?.empresas?.length) await this._estLoadAll?.();
      if (!this.nfState.fornecedores.length) {
        try { const r = await fetch('/bi-financeiro/api/fornecedores?ativo=true').then(r=>r.json()); this.nfState.fornecedores = r.fornecedores || []; }
        catch(_) {}
      }
      if (!this.nfState.produtosCache.length) {
        try { const r = await fetch('/bi-financeiro/api/estoque/produtos').then(r=>r.json()); this.nfState.produtosCache = r.produtos || []; }
        catch(_) {}
      }
    },

    async nfAbrir(id) {
      await this._nfLoadAux();
      let nf;
      try {
        const r = await fetch('/bi-financeiro/api/nf/'+id).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        nf = r.nf;
      } catch(e) { alert('Erro: '+e.message); return; }
      this.nfState.curr = nf;
      document.getElementById('bifNfId').value = nf.id;
      document.getElementById('bifNfModalTitle').textContent = `NF ${nf.nfe_numero}/${nf.nfe_serie} — ${nf.emitente_razao}`;
      document.getElementById('bifNfCab').innerHTML = `
        <div><b>🏢 Emitente:</b> ${escapeHtml(nf.emitente_razao||'—')} · CNPJ ${escapeHtml(nf.emitente_cnpj||'—')} · ${escapeHtml(nf.emitente_uf||'—')}</div>
        <div style="margin-top:4px"><b>🏪 Destinatário:</b> ${escapeHtml(nf.destinatario_razao||'—')} · CNPJ ${escapeHtml(nf.destinatario_cnpj||'—')}</div>
        <div style="margin-top:4px"><b>📅 Emissão:</b> ${nf.nfe_data_emissao||'—'} · <b>💰 Valor:</b> ${fmtBRL(nf.nfe_valor_total)} · <b>🔑 Chave:</b> <code style="font-size:11px">${escapeHtml(nf.nfe_chave)}</code></div>
        ${nf.status === 'processada' ? `<div style="margin-top:6px;color:#22C55E"><b>✓ Processada</b> em ${new Date(nf.processada_em).toLocaleString('pt-BR')} por ${escapeHtml(nf.processada_por||'—')}</div>` : ''}
      `;

      // Empresa
      const empSel = document.getElementById('bifNfEmpresa');
      empSel.innerHTML = '<option value="">— escolha —</option>' + (this.estState.empresas||[]).map(e =>
        `<option value="${e.id}" ${nf.empresa_id===e.id?'selected':''}>${escapeHtml(e.nome)} ${e.cnpj?'· '+escapeHtml(e.cnpj):''}</option>`).join('');

      // Fornecedor
      const fornSel = document.getElementById('bifNfFornecedor');
      fornSel.innerHTML = '<option value="">— escolha —</option>' + (this.nfState.fornecedores||[]).map(f =>
        `<option value="${f.id}" ${nf.fornecedor_id===f.id?'selected':''}>${escapeHtml(f.nome)} ${f.doc?'· '+escapeHtml(f.doc):''}</option>`).join('');

      // Estoque destino
      const estSel = document.getElementById('bifNfEstoque');
      estSel.innerHTML = '<option value="">— escolha —</option>' + (this.estState.estoques||[]).map(e => {
        const emp = (this.estState.empresas||[]).find(x => x.id === e.empresa_id);
        return `<option value="${e.id}">${escapeHtml(e.nome)} ${emp?'· '+escapeHtml(emp.nome):''}</option>`;
      }).join('');

      // Empresa BI (localStorage) pra conta a pagar
      const ebSel = document.getElementById('bifNfEmpresaBI');
      ebSel.innerHTML = '<option value="">—</option>' + (state.companies||[]).map(c => `<option value="${c.id}">${escapeHtml(c.nome)}</option>`).join('');

      // Itens
      this._nfRenderItens(nf);

      // Parcelas info
      let parcelas = [];
      try { parcelas = nf.parcelas_json ? (typeof nf.parcelas_json === 'string' ? JSON.parse(nf.parcelas_json) : nf.parcelas_json) : []; } catch(_) {}
      const pInfo = document.getElementById('bifNfParcelasInfo');
      if (parcelas.length === 0) pInfo.textContent = 'XML não traz parcelamento → vai gerar 1 pagamento com vencimento na data da NF.';
      else if (parcelas.length === 1) pInfo.textContent = `1 parcela · vencimento ${parcelas[0].vencimento}.`;
      else pInfo.textContent = `${parcelas.length} parcelas → vai criar ${parcelas.length} pagamentos rascunho.`;

      document.getElementById('bifNfObs').value = nf.observacoes || '';

      // Sugere match com pedido de compra (F2)
      try {
        const r = await fetch(`/bi-financeiro/api/compras/match-nf/${nf.id}`).then(r=>r.json());
        if (r.ok && r.sugestoes && r.sugestoes.length) {
          const lista = r.sugestoes.map(s => `#${s.numero_seq} · ${escapeHtml(s.fornecedor_nome_db||'—')} · ${fmtBRL(s.valor_estimado_total)}`).join(' · ');
          const cab = document.getElementById('bifNfCab');
          cab.innerHTML += `<div style="margin-top:6px;background:#1a2a3a;border:1px solid #4F8CFF;border-radius:6px;padding:6px 10px;font-size:11.5px">
            🔗 <b>Possível match com pedido de compra:</b> ${lista}
            ${r.sugestoes.map(s => `<button class="bif-btn sm ghost" style="margin-left:6px" onclick="BIF._nfVincularCompra('${s.id}','${nf.id}')">Vincular #${s.numero_seq}</button>`).join('')}
          </div>`;
        }
      } catch(_) {}

      document.getElementById('bifNfModal').classList.add('show');
    },
    async _nfVincularCompra(compraId, nfId) {
      try {
        const r = await fetch(`/bi-financeiro/api/compras/${compraId}/vincular-nf`, {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ nfId })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        alert('✓ Pedido de compra vinculado à NF. Quando processar a NF, o estoque entra e a compra fica marcada como recebida.');
      } catch(e) { alert('Erro: '+e.message); }
    },

    _nfRenderItens(nf) {
      const tb = document.getElementById('bifNfItensTbody');
      const prods = this.nfState.produtosCache || [];
      const isReadonly = nf.status === 'processada';
      tb.innerHTML = (nf.itens||[]).map(it => {
        const opts = '<option value="">— sem vínculo —</option>' + prods.map(p =>
          `<option value="${p.id}" ${it.produto_id===p.id?'selected':''}>${escapeHtml(p.sku||'(s/sku)')} · ${escapeHtml(p.nome)}</option>`).join('');
        const matchPill = it.match_tipo === 'sku' ? '<span class="bif-pill ok" style="font-size:10px">SKU</span>'
          : it.match_tipo === 'nome' ? '<span class="bif-pill info" style="font-size:10px">nome</span>'
          : it.match_tipo === 'manual' ? '<span class="bif-pill" style="font-size:10px">manual</span>'
          : '';
        const ignorada = it.ignorar ? 'style="opacity:.4;text-decoration:line-through"' : '';
        return `<tr ${ignorada}>
          <td>${it.ordem}</td>
          <td><code style="font-size:11px">${escapeHtml(it.cprod||'')}</code></td>
          <td><b>${escapeHtml(it.xprod||'')}</b><div class="muted" style="font-size:10.5px">NCM ${escapeHtml(it.ncm||'—')} · CFOP ${escapeHtml(it.cfop||'—')}</div></td>
          <td class="col-num">${Number(it.qcom).toFixed(2)} ${escapeHtml(it.ucom||'')}</td>
          <td class="col-num">${fmtBRL(it.vunit)}</td>
          <td class="col-num"><b>${fmtBRL(it.vprod)}</b></td>
          <td>
            <select onchange="BIF.nfItemMatch('${it.id}', this.value)" ${isReadonly?'disabled':''} style="background:#0a0a0a;color:#E6EDF3;border:1px solid #30363D;border-radius:6px;padding:4px 6px;font-size:11.5px;max-width:280px">${opts}</select>
            ${matchPill}
          </td>
          <td>
            <button class="bif-btn sm ghost" onclick="BIF.nfItemIgnorar('${it.id}', ${!it.ignorar})" ${isReadonly?'disabled':''} title="${it.ignorar?'Voltar a incluir':'Ignorar (não dá entrada)'}">${it.ignorar?'↩️':'⊘'}</button>
          </td>
        </tr>`;
      }).join('');
    },

    async nfItemMatch(itemId, produtoId) {
      try {
        const r = await fetch('/bi-financeiro/api/nf/item/'+itemId, {
          method:'PUT', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ produtoId: produtoId || null, matchTipo: produtoId ? 'manual' : null })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        // Atualiza estado local
        const it = this.nfState.curr.itens.find(x => x.id === itemId);
        if (it) { it.produto_id = produtoId; it.match_tipo = produtoId ? 'manual' : null; }
      } catch(e) { alert('Erro: '+e.message); }
    },

    async nfItemIgnorar(itemId, ignorar) {
      try {
        const r = await fetch('/bi-financeiro/api/nf/item/'+itemId, {
          method:'PUT', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ ignorar })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        const it = this.nfState.curr.itens.find(x => x.id === itemId);
        if (it) it.ignorar = ignorar;
        this._nfRenderItens(this.nfState.curr);
      } catch(e) { alert('Erro: '+e.message); }
    },

    nfFechar() {
      document.getElementById('bifNfModal').classList.remove('show');
      this.nfState.curr = null;
    },

    async nfProcessar() {
      const nf = this.nfState.curr; if (!nf) return;
      if (nf.status === 'processada') { alert('NF já processada.'); return; }
      const empresaId = document.getElementById('bifNfEmpresa').value;
      const fornecedorId = document.getElementById('bifNfFornecedor').value;
      const estoqueDestinoId = document.getElementById('bifNfEstoque').value;
      const empresaBI = document.getElementById('bifNfEmpresaBI').value;
      const gerarPag = document.getElementById('bifNfGerarPag').checked;
      const obs = document.getElementById('bifNfObs').value;
      if (!estoqueDestinoId) return alert('Escolha o estoque destino.');
      if (!fornecedorId) return alert('Vincule o fornecedor (use o dropdown).');
      // Salva cabeçalho ajustado
      try {
        await fetch('/bi-financeiro/api/nf/'+nf.id, {
          method:'PUT', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ empresaId: empresaId || null, fornecedorId, observacoes: obs })
        }).then(r=>r.json());
        // Processa
        const r = await fetch(`/bi-financeiro/api/nf/${nf.id}/processar`, {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ estoqueDestinoId, gerarContaPagar: gerarPag, empresaBI, observacoes: obs, categoria: 'mercadorias' })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        const errosTxt = r.erros?.length ? `\n⚠️ Itens com erro: ${r.erros.length}\nPrimeiro: ${r.erros[0].motivo}` : '';
        alert(`✅ Entrada processada!\nItens entrando no estoque: ${r.movs}${errosTxt}\n${r.pagamentoId?'Pagamento(s) criado(s): '+r.pagamentoId:''}`);
        this.nfFechar();
        this.nfReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    async nfDescartar() {
      const nf = this.nfState.curr; if (!nf) return;
      const motivo = prompt('Motivo do descarte:');
      if (!motivo) return;
      try {
        const r = await fetch(`/bi-financeiro/api/nf/${nf.id}/descartar`, {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ motivo })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.nfFechar();
        this.nfReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    // =====================================================================
    // ===== COMPRAS F2 (solicitação + aprovação Z-API) =====
    // =====================================================================
    cpState: { lista: [], curr: null, itens: [], fornecedores: [], produtos: [] },

    async cpReload() {
      const status = document.getElementById('bifCpFiltroStatus')?.value || '';
      const minhas = document.getElementById('bifCpMinhas')?.checked ? '&minhas=true' : '';
      const url = '/bi-financeiro/api/compras/listar?status=' + encodeURIComponent(status) + minhas;
      try {
        const r = await fetch(url).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.cpState.lista = r.compras || [];
        const tb = document.getElementById('bifCpTbody');
        const resumo = document.getElementById('bifCpResumo');
        if (resumo) {
          const tot = this.cpState.lista.reduce((s,c) => s + Number(c.valor_estimado_total||0), 0);
          resumo.textContent = `${this.cpState.lista.length} solicitação(ões) · Total ${fmtBRL(tot)}`;
        }
        if (this.cpState.lista.length === 0) {
          tb.innerHTML = '<tr><td colspan="9" class="bif-empty">Nenhuma solicitação no filtro.</td></tr>';
          return;
        }
        tb.innerHTML = this.cpState.lista.map(c => {
          const urgPill = c.urgencia === 'urgente' ? '<span class="bif-pill bad">🚨 Urgente</span>'
            : c.urgencia === 'alta' ? '<span class="bif-pill warn">⚡ Alta</span>'
            : c.urgencia === 'baixa' ? '<span class="bif-pill muted">🐢 Baixa</span>'
            : '<span class="bif-pill info">Normal</span>';
          const statusPill = (() => {
            const s = c.status;
            if (s === 'aprovada')         return '<span class="bif-pill ok">✓ Aprovada</span>';
            if (s === 'aguardando_aprovacao') return '<span class="bif-pill warn">⏳ Aguardando</span>';
            if (s === 'rascunho')         return '<span class="bif-pill muted">📝 Rascunho</span>';
            if (s === 'ajuste')           return '<span class="bif-pill warn">⚠️ Ajuste</span>';
            if (s === 'reprovada')        return '<span class="bif-pill bad">❌ Reprovada</span>';
            if (s === 'pedido_enviado')   return '<span class="bif-pill info">📤 Enviado</span>';
            if (s === 'recebida')         return '<span class="bif-pill ok">📦 Recebida</span>';
            if (s === 'cancelada')        return '<span class="bif-pill muted">🚫 Cancelada</span>';
            return `<span class="bif-pill">${escapeHtml(s)}</span>`;
          })();
          return `<tr>
            <td><b>#${c.numero_seq}</b></td>
            <td>${c.created_at ? new Date(c.created_at).toLocaleDateString('pt-BR') : '—'}</td>
            <td>${escapeHtml(c.solicitante_username||'—')}</td>
            <td>${escapeHtml(c.fornecedor_nome_db || c.fornecedor_nome || '—')}</td>
            <td class="col-num">${c.itens_count||0}</td>
            <td class="col-num">${fmtBRL(c.valor_estimado_total)}</td>
            <td>${urgPill}</td>
            <td>${statusPill}</td>
            <td class="col-act">
              <button class="bif-btn sm primary" onclick="BIF.cpAbrir('${c.id}')">📝 Abrir</button>
              ${c.status === 'aprovada' || c.status === 'pedido_enviado' || c.status === 'recebida'
                ? `<a class="bif-btn sm" href="/bi-financeiro/api/compras/${c.id}/pdf" target="_blank">📄 PDF</a>` : ''}
            </td>
          </tr>`;
        }).join('');
      } catch(e) {
        document.getElementById('bifCpTbody').innerHTML = `<tr><td colspan="9" class="bif-empty">❌ ${escapeHtml(e.message)}</td></tr>`;
      }
    },

    async _cpLoadAux() {
      if (!this.estState?.empresas?.length) await this._estLoadAll?.();
      if (!this.cpState.fornecedores.length) {
        try { const r = await fetch('/bi-financeiro/api/fornecedores?ativo=true').then(r=>r.json()); this.cpState.fornecedores = r.fornecedores || []; }
        catch(_) {}
      }
      if (!this.cpState.produtos.length) {
        try { const r = await fetch('/bi-financeiro/api/estoque/produtos').then(r=>r.json()); this.cpState.produtos = r.produtos || []; }
        catch(_) {}
      }
    },

    async cpNova() {
      await this._cpLoadAux();
      this.cpState.curr = null;
      this.cpState.itens = [{ produtoId:'', produtoNome:'', sku:'', qtd:1, custoUnit:0, observacoes:'' }];
      this._cpFillDropdowns(null);
      document.getElementById('bifCpModalTitle').textContent = 'Nova solicitação de compra';
      document.getElementById('bifCpId').value = '';
      document.getElementById('bifCpReadOnlyInfo').style.display = 'none';
      document.getElementById('bifCpEmpresa').value = '';
      document.getElementById('bifCpEmpresaBI').value = '';
      document.getElementById('bifCpFornecedor').value = '';
      document.getElementById('bifCpUrgencia').value = 'normal';
      document.getElementById('bifCpJustificativa').value = '';
      document.getElementById('bifCpObs').value = '';
      document.getElementById('bifCpBtnCancelar').style.display = 'none';
      document.getElementById('bifCpBtnSalvar').style.display = 'inline-flex';
      document.getElementById('bifCpBtnSubmeter').style.display = 'inline-flex';
      document.getElementById('bifCpBtnSubmeter').textContent = '📤 Enviar pra Morgana aprovar';
      this._cpRenderItens();
      document.getElementById('bifCpModal').classList.add('show');
    },

    async cpAbrir(id) {
      await this._cpLoadAux();
      try {
        const r = await fetch('/bi-financeiro/api/compras/'+id).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        const c = r.compra;
        this.cpState.curr = c;
        this.cpState.itens = (c.itens||[]).map(it => ({
          produtoId: it.produto_id||'', produtoNome: it.produto_nome_db || it.produto_nome || '',
          sku: it.produto_sku_db || it.sku || '',
          qtd: Number(it.qtd), custoUnit: Number(it.custo_unit_estimado), observacoes: it.observacoes||''
        }));
        this._cpFillDropdowns(c);
        document.getElementById('bifCpModalTitle').textContent = `Solicitação #${c.numero_seq} — ${c.status}`;
        document.getElementById('bifCpId').value = c.id;
        document.getElementById('bifCpEmpresa').value = c.empresa_id || '';
        document.getElementById('bifCpEmpresaBI').value = c.empresa_bi || '';
        document.getElementById('bifCpFornecedor').value = c.fornecedor_id || '';
        document.getElementById('bifCpUrgencia').value = c.urgencia || 'normal';
        document.getElementById('bifCpJustificativa').value = c.justificativa || '';
        document.getElementById('bifCpObs').value = c.observacoes || '';

        // Info read-only com status + histórico curto
        const infoBox = document.getElementById('bifCpReadOnlyInfo');
        const hist = Array.isArray(c.historico) ? c.historico : [];
        const lastEv = hist[hist.length-1];
        const histTxt = lastEv ? `${lastEv.tipo} por ${lastEv.who||'—'} em ${new Date(lastEv.ts).toLocaleString('pt-BR')}` : '—';
        infoBox.innerHTML = `<b>Status:</b> ${escapeHtml(c.status)} · <b>Solicitante:</b> ${escapeHtml(c.solicitante_username||'—')}
          ${c.token_aprovacao ? '· <b>Token:</b> <code>'+escapeHtml(c.token_aprovacao)+'</code>' : ''}
          ${c.aprovador_username ? '· <b>Decidiu:</b> '+escapeHtml(c.aprovador_username) : ''}
          ${c.motivo ? '<div style="margin-top:4px"><b>Motivo/Obs:</b> '+escapeHtml(c.motivo)+'</div>' : ''}
          <div class="muted" style="font-size:11px;margin-top:4px">Última ação: ${escapeHtml(histTxt)}</div>`;
        infoBox.style.display = 'block';

        // Lock fields se não pode editar
        const editavel = ['rascunho','ajuste'].includes(c.status);
        const subMisable = ['rascunho','ajuste'].includes(c.status);
        ['bifCpEmpresa','bifCpEmpresaBI','bifCpFornecedor','bifCpUrgencia','bifCpJustificativa','bifCpObs'].forEach(id => {
          document.getElementById(id).disabled = !editavel;
        });
        document.getElementById('bifCpBtnSalvar').style.display = editavel ? 'inline-flex' : 'none';
        document.getElementById('bifCpBtnSubmeter').style.display = subMisable ? 'inline-flex' : 'none';
        document.getElementById('bifCpBtnCancelar').style.display = ['rascunho','aguardando_aprovacao','ajuste','aprovada'].includes(c.status) ? 'inline-flex' : 'none';

        // Botões admin de aprovação direto (paralelo ao Z-API)
        const isAdmin = !!BIF.isAdmin;
        if (c.status === 'aguardando_aprovacao' && isAdmin) {
          document.getElementById('bifCpBtnSubmeter').textContent = '✅ Aprovar agora';
          document.getElementById('bifCpBtnSubmeter').style.display = 'inline-flex';
          document.getElementById('bifCpBtnSubmeter').onclick = () => BIF.cpAprovarDireto();
          // mostra também botões secundários
        } else if (c.status === 'aprovada' && isAdmin) {
          document.getElementById('bifCpBtnSubmeter').textContent = '📤 Marcar pedido enviado';
          document.getElementById('bifCpBtnSubmeter').style.display = 'inline-flex';
          document.getElementById('bifCpBtnSubmeter').onclick = () => BIF.cpMarcarEnviado();
        } else if (subMisable) {
          document.getElementById('bifCpBtnSubmeter').textContent = '📤 Enviar pra Morgana aprovar';
          document.getElementById('bifCpBtnSubmeter').onclick = () => BIF.cpSubmeter();
        }

        this._cpRenderItens(!editavel);
        document.getElementById('bifCpModal').classList.add('show');
      } catch(e) { alert('Erro: '+e.message); }
    },

    _cpFillDropdowns(curr) {
      const empSel = document.getElementById('bifCpEmpresa');
      empSel.innerHTML = '<option value="">— escolha —</option>' + (this.estState?.empresas||[]).map(e =>
        `<option value="${e.id}" ${curr?.empresa_id===e.id?'selected':''}>${escapeHtml(e.nome)}</option>`).join('');
      const ebSel = document.getElementById('bifCpEmpresaBI');
      ebSel.innerHTML = '<option value="">—</option>' + (state.companies||[]).map(c =>
        `<option value="${c.id}" ${curr?.empresa_bi===c.id?'selected':''}>${escapeHtml(c.nome)}</option>`).join('');
      const fSel = document.getElementById('bifCpFornecedor');
      fSel.innerHTML = '<option value="">— escolha —</option>' + (this.cpState.fornecedores||[]).map(f =>
        `<option value="${f.id}" ${curr?.fornecedor_id===f.id?'selected':''}>${escapeHtml(f.nome)} ${f.doc?'· '+escapeHtml(f.doc):''}</option>`).join('');
    },

    _cpRenderItens(readonly = false) {
      const tb = document.getElementById('bifCpItensTbody');
      const prods = this.cpState.produtos || [];
      tb.innerHTML = this.cpState.itens.map((it, idx) => {
        const opts = '<option value="">— escolha produto —</option>' + prods.map(p =>
          `<option value="${p.id}" data-nome="${escapeHtml(p.nome)}" data-sku="${escapeHtml(p.sku||'')}" data-custo="${p.custo_medio||0}" ${it.produtoId===p.id?'selected':''}>${escapeHtml(p.sku||'(s/sku)')} · ${escapeHtml(p.nome)}</option>`).join('');
        const total = (Number(it.qtd)||0) * (Number(it.custoUnit)||0);
        const dis = readonly ? 'disabled' : '';
        return `<tr>
          <td><select ${dis} onchange="BIF.cpItemProdChange(${idx}, this)" style="background:#0a0a0a;color:#E6EDF3;border:1px solid #30363D;border-radius:6px;padding:4px 6px;font-size:11.5px;min-width:260px">${opts}</select></td>
          <td class="col-num"><input ${dis} type="number" min="0" step="0.01" value="${it.qtd}" oninput="BIF.cpItemUpd(${idx}, 'qtd', this.value)" style="width:80px;text-align:right"></td>
          <td class="col-num"><input ${dis} type="number" min="0" step="0.01" value="${it.custoUnit}" oninput="BIF.cpItemUpd(${idx}, 'custoUnit', this.value)" style="width:100px;text-align:right"></td>
          <td class="col-num"><b>${fmtBRL(total)}</b></td>
          <td><input ${dis} type="text" value="${escapeHtml(it.observacoes||'')}" oninput="BIF.cpItemUpd(${idx}, 'observacoes', this.value)" placeholder="—" style="width:160px"></td>
          <td>${readonly?'':`<button class="bif-btn sm danger" onclick="BIF.cpItemRm(${idx})">✕</button>`}</td>
        </tr>`;
      }).join('');
      const totGeral = this.cpState.itens.reduce((s,it) => s + (Number(it.qtd)||0)*(Number(it.custoUnit)||0), 0);
      document.getElementById('bifCpTotal').textContent = fmtBRL(totGeral);
    },

    cpItemAdd() { this.cpState.itens.push({ produtoId:'', produtoNome:'', sku:'', qtd:1, custoUnit:0, observacoes:'' }); this._cpRenderItens(); },
    cpItemRm(idx)  { this.cpState.itens.splice(idx,1); this._cpRenderItens(); },
    cpItemUpd(idx, k, v) {
      this.cpState.itens[idx][k] = k==='observacoes' ? v : Number(v) || 0;
      const totGeral = this.cpState.itens.reduce((s,it) => s + (Number(it.qtd)||0)*(Number(it.custoUnit)||0), 0);
      document.getElementById('bifCpTotal').textContent = fmtBRL(totGeral);
    },
    cpItemProdChange(idx, sel) {
      const opt = sel.selectedOptions[0];
      this.cpState.itens[idx].produtoId = sel.value;
      this.cpState.itens[idx].produtoNome = opt?.dataset.nome || '';
      this.cpState.itens[idx].sku = opt?.dataset.sku || '';
      // Sugere custo se ainda 0
      if (!this.cpState.itens[idx].custoUnit && opt?.dataset.custo) {
        this.cpState.itens[idx].custoUnit = Number(opt.dataset.custo) || 0;
      }
      this._cpRenderItens();
    },

    cpFechar() { document.getElementById('bifCpModal').classList.remove('show'); this.cpState.curr = null; },

    _cpBuildPatch() {
      return {
        empresaId: document.getElementById('bifCpEmpresa').value || null,
        empresaBI: document.getElementById('bifCpEmpresaBI').value || null,
        fornecedorId: document.getElementById('bifCpFornecedor').value || null,
        fornecedorNome: (this.cpState.fornecedores.find(f => f.id === document.getElementById('bifCpFornecedor').value) || {}).nome || null,
        urgencia: document.getElementById('bifCpUrgencia').value,
        justificativa: document.getElementById('bifCpJustificativa').value,
        observacoes: document.getElementById('bifCpObs').value,
        itens: this.cpState.itens.filter(it => it.produtoId && it.qtd > 0),
      };
    },

    async cpSalvar() {
      const id = document.getElementById('bifCpId').value;
      const body = this._cpBuildPatch();
      if (!body.itens.length) return alert('Adicione ao menos 1 item com produto + qtd.');
      try {
        const r = await fetch(id ? '/bi-financeiro/api/compras/'+id : '/bi-financeiro/api/compras', {
          method: id ? 'PUT' : 'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        alert(id ? '✓ Salvo' : `✓ Solicitação #${r.compra.numero_seq} criada como rascunho.`);
        this.cpFechar(); this.cpReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    async cpSubmeter() {
      const body = this._cpBuildPatch();
      if (!body.itens.length) return alert('Adicione ao menos 1 item.');
      if (!body.fornecedorId) return alert('Escolha o fornecedor.');
      // Salva primeiro
      let id = document.getElementById('bifCpId').value;
      try {
        if (!id) {
          const r = await fetch('/bi-financeiro/api/compras', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) }).then(r=>r.json());
          if (!r.ok) throw new Error(r.error);
          id = r.compra.id;
        } else {
          await fetch('/bi-financeiro/api/compras/'+id, { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body) });
        }
        const r2 = await fetch(`/bi-financeiro/api/compras/${id}/submeter`, { method:'POST' }).then(r=>r.json());
        if (!r2.ok) throw new Error(r2.error);
        alert(`✓ Solicitação #${r2.compra.numero_seq} enviada pra aprovação.\nToken: ${r2.compra.token_aprovacao}\n\nMorgana foi notificada via WhatsApp (Z-API em background).`);
        this.cpFechar(); this.cpReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    async cpAprovarDireto() {
      if (!this.cpState.curr) return;
      if (!confirm('Aprovar manualmente (sem WhatsApp da Morgana)?')) return;
      try {
        const r = await fetch(`/bi-financeiro/api/compras/${this.cpState.curr.id}/aprovar`, { method:'POST' }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        alert(`✅ Aprovada! Baixe o PDF do pedido pra enviar ao fornecedor.`);
        this.cpFechar(); this.cpReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    async cpMarcarEnviado() {
      if (!this.cpState.curr) return;
      if (!confirm('Marcar pedido como enviado ao fornecedor?')) return;
      try {
        const r = await fetch(`/bi-financeiro/api/compras/${this.cpState.curr.id}/pedido-enviado`, {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({})
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        alert('✓ Marcado como enviado. Quando a NF-e chegar, sistema vai sugerir match com este pedido.');
        this.cpFechar(); this.cpReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    async cpCancelar() {
      if (!this.cpState.curr) return;
      const motivo = prompt('Motivo do cancelamento:');
      if (!motivo) return;
      try {
        const r = await fetch(`/bi-financeiro/api/compras/${this.cpState.curr.id}/cancelar`, {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ motivo })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.cpFechar(); this.cpReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    // =====================================================================
    // ===== OS MATERIAIS — aba admin =====
    // =====================================================================
    osmState: { lista: [], curr: null },
    osmReloadDebounce() { clearTimeout(this._osmDeb); this._osmDeb = setTimeout(() => this.osmReload(), 350); },

    async osmReload() {
      const status = document.getElementById('bifOsmStatus')?.value;
      const tec = document.getElementById('bifOsmTec')?.value.trim();
      const df = document.getElementById('bifOsmDataFrom')?.value;
      const dt = document.getElementById('bifOsmDataTo')?.value;
      const p = new URLSearchParams();
      if (status) p.set('status', status);
      if (tec) p.set('tecnico', tec);
      if (df) p.set('dataFrom', df);
      if (dt) p.set('dataTo', dt);
      try {
        const r = await fetch('/bi-financeiro/api/os-materiais/listar?'+p.toString()).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.osmState.lista = r.oss || [];
        const tb = document.getElementById('bifOsmTbody');
        const resumo = document.getElementById('bifOsmResumo');
        const totalValor = this.osmState.lista.reduce((s,o) => s + Number(o.total_valor||0), 0);
        if (resumo) resumo.textContent = `${this.osmState.lista.length} OS(s) · Total ${fmtBRL(totalValor)}`;
        if (!this.osmState.lista.length) { tb.innerHTML = '<tr><td colspan="9" class="bif-empty">Sem OSs nesse filtro.</td></tr>'; return; }
        tb.innerHTML = this.osmState.lista.map(o => {
          const statusPill = o.status === 'baixado' ? '<span class="bif-pill ok">✓ Baixada</span>'
            : o.status === 'pendente' ? '<span class="bif-pill warn">📝 Pendente</span>'
            : '<span class="bif-pill muted">🚫 Cancelada</span>';
          const zoho = o.zoho_deal_id ? '<span class="bif-pill ok" style="font-size:10px">✓ Zoho</span>' : '<span class="muted" style="font-size:10.5px">sem vínculo</span>';
          return `<tr>
            <td>${o.data_atendimento || '—'}</td>
            <td>${escapeHtml(o.tecnico_nome || o.tecnico_username || '—')}</td>
            <td>${escapeHtml(o.cliente_nome || '—')}</td>
            <td>${escapeHtml(o.estoque_nome || '—')}</td>
            <td class="col-num">${o.itens_count || 0}</td>
            <td class="col-num"><b>${fmtBRL(o.total_valor)}</b></td>
            <td>${statusPill}</td>
            <td>${zoho}</td>
            <td class="col-act"><button class="bif-btn sm primary" onclick="BIF.osmAbrir('${o.id}')">👁️ Abrir</button></td>
          </tr>`;
        }).join('');
      } catch(e) {
        document.getElementById('bifOsmTbody').innerHTML = `<tr><td colspan="9" class="bif-empty">❌ ${escapeHtml(e.message)}</td></tr>`;
      }
    },

    async osmAbrir(id) {
      try {
        const r = await fetch('/bi-financeiro/api/os-materiais/'+id).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        const o = r.os;
        this.osmState.curr = o;
        document.getElementById('bifOsmModalTitle').textContent = `OS Materiais — ${o.cliente_nome || 'sem cliente'}`;
        document.getElementById('bifOsmCab').innerHTML = `
          <div><b>👤 Cliente:</b> ${escapeHtml(o.cliente_nome||'—')}</div>
          <div style="margin-top:3px"><b>👷 Técnico:</b> ${escapeHtml(o.tecnico_nome || o.tecnico_username||'—')}</div>
          <div style="margin-top:3px"><b>📦 Estoque origem:</b> ${escapeHtml(o.estoque_nome||'—')} · <b>📅 Data:</b> ${o.data_atendimento||'—'}</div>
          <div style="margin-top:3px"><b>🔗 Zoho Deal:</b> ${o.zoho_deal_id ? '<code>'+escapeHtml(o.zoho_deal_id)+'</code>' : '<span class="muted">sem vínculo</span>'}</div>
          <div style="margin-top:3px"><b>Status:</b> ${escapeHtml(o.status)}
            ${o.baixada_em ? '· baixada em '+new Date(o.baixada_em).toLocaleString('pt-BR')+' por '+escapeHtml(o.baixada_por||'—') : ''}
            ${o.cancelada_em ? '· cancelada · motivo: '+escapeHtml(o.motivo_cancelamento||'—') : ''}
          </div>
        `;
        const tb = document.getElementById('bifOsmItensTbody');
        let total = 0;
        if (!o.itens || !o.itens.length) {
          tb.innerHTML = '<tr><td colspan="6" class="bif-empty">Sem itens.</td></tr>';
        } else {
          tb.innerHTML = o.itens.map(it => {
            const valor = o.status === 'baixado' ? Number(it.valor) : Number(it.qtd)*Number(it.custo_unit_snapshot||0);
            total += valor;
            return `<tr>
              <td>${escapeHtml(it.produto_nome||'')}</td>
              <td><code style="font-size:11px">${escapeHtml(it.produto_sku||'—')}</code></td>
              <td class="col-num">${Number(it.qtd).toFixed(2)} ${escapeHtml(it.produto_unidade||'')}</td>
              <td class="col-num">${fmtBRL(it.custo_unit_snapshot)}</td>
              <td class="col-num"><b>${fmtBRL(valor)}</b></td>
              <td>${escapeHtml(it.observacoes||'—')}</td>
            </tr>`;
          }).join('');
        }
        document.getElementById('bifOsmTotal').textContent = fmtBRL(total);
        document.getElementById('bifOsmBtnBaixar').style.display = (o.status === 'pendente' && this.isAdmin) ? 'inline-flex' : 'none';
        document.getElementById('bifOsmBtnCancelar').style.display = (o.status === 'pendente' && this.isAdmin) ? 'inline-flex' : 'none';
        document.getElementById('bifOsmModal').classList.add('show');
      } catch(e) { alert('Erro: '+e.message); }
    },
    osmFechar() { document.getElementById('bifOsmModal').classList.remove('show'); this.osmState.curr = null; },
    async osmBaixar() {
      if (!this.osmState.curr) return;
      if (!confirm('Confirmar baixa? Itens vão sair do estoque e o custo vai pra ficha da venda Zoho (se vinculada).')) return;
      try {
        const r = await fetch(`/bi-financeiro/api/os-materiais/${this.osmState.curr.id}/baixar`, { method:'POST' }).then(r=>r.json());
        if (r.error) throw new Error(r.error);
        const erros = r.erros && r.erros.length ? `\n⚠️ ${r.erros.length} erro(s). Primeiro: ${r.erros[0].motivo}` : '';
        alert(`✅ OS baixada · Total ${fmtBRL(r.total)}${erros}`);
        this.osmFechar(); this.osmReload();
      } catch(e) { alert('Erro: '+e.message); }
    },
    async osmCancelar() {
      if (!this.osmState.curr) return;
      const motivo = prompt('Motivo do cancelamento:');
      if (!motivo) return;
      try {
        const r = await fetch(`/bi-financeiro/api/os-materiais/${this.osmState.curr.id}/cancelar`, {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ motivo })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        this.osmFechar(); this.osmReload();
      } catch(e) { alert('Erro: '+e.message); }
    },

    // ===== Dashboard CEO =====
    ceoState: { from: '', to: '', listaCompleta: [], _picker: null, listaAberta: false },

    _ceoToISO(d) { const x = new Date(d); return x.toISOString().slice(0,10); },

    ceoInitPicker() {
      // Seta default = últimos 30d
      if (!this.ceoState.from) {
        const today = new Date();
        const end = today;
        const start = new Date(); start.setDate(start.getDate() - 29);
        this.ceoState.from = this._ceoToISO(start);
        this.ceoState.to   = this._ceoToISO(end);
      }
      // Inicializa flatpickr
      if (typeof flatpickr === 'function' && !this.ceoState._picker) {
        const self = this;
        this.ceoState._picker = flatpickr('#bifCeoRangePicker', {
          mode: 'range', dateFormat: 'd/m/Y', locale: 'pt',
          maxDate: 'today', defaultDate: [this.ceoState.from, this.ceoState.to],
          onClose: function(selectedDates) {
            if (selectedDates.length === 2) {
              self.ceoState.from = self._ceoToISO(selectedDates[0]);
              self.ceoState.to   = self._ceoToISO(selectedDates[1]);
              self.ceoReload();
            }
          },
        });
      }
    },

    ceoPreset(preset) {
      const today = new Date(); today.setHours(0,0,0,0);
      let start, end = new Date(today);
      switch (preset) {
        case 'hoje':       start = new Date(today); break;
        case '7d':         start = new Date(today); start.setDate(start.getDate() - 6); break;
        case '30d':        start = new Date(today); start.setDate(start.getDate() - 29); break;
        case 'mesAtual':   start = new Date(today.getFullYear(), today.getMonth(), 1); break;
        case 'mesPassado': start = new Date(today.getFullYear(), today.getMonth() - 1, 1); end = new Date(today.getFullYear(), today.getMonth(), 0); break;
        case 'anoAtual':   start = new Date(today.getFullYear(), 0, 1); break;
        default: return;
      }
      this.ceoState.from = this._ceoToISO(start);
      this.ceoState.to   = this._ceoToISO(end);
      // Atualiza picker
      if (this.ceoState._picker) this.ceoState._picker.setDate([this.ceoState.from, this.ceoState.to], false);
      this.ceoReload();
    },

    async ceoReload() {
      try {
        // Garante init
        if (!this.ceoState.from) this.ceoInitPicker();
        const empresa = state.activeCompanyId === 'consolidado' ? '' : state.activeCompanyId;
        const compare = document.getElementById('bifCeoCompareCheck')?.checked ?? true;
        const params = new URLSearchParams();
        params.set('dateFrom', this.ceoState.from);
        params.set('dateTo', this.ceoState.to);
        params.set('comparePrev', String(compare));
        if (empresa) params.set('empresaBI', empresa);
        const r = await fetch('/bi-financeiro/api/ceo-dashboard?' + params).then(r=>r.json());
        if (!r.ok) throw new Error(r.error);
        document.getElementById('bifCeoTimestamp').textContent = '· atualizado em ' + (new Date(r.ts)).toLocaleTimeString('pt-BR');
        document.getElementById('bifCeoPeriodoTxt').innerHTML = `<b>${this._ceoFmtData(r.periodo.from)} → ${this._ceoFmtData(r.periodo.to)}</b>` + (r.periodo.compararPeriodoAnterior ? ` · vs ${this._ceoFmtData(r.periodo.prevFrom)} → ${this._ceoFmtData(r.periodo.prevTo)}` : '');

        // Alertas
        document.getElementById('bifCeoAlertas').innerHTML = (r.alertas||[]).length === 0
          ? `<div class="bif-alert ok"><span class="ico">✅</span><div>Tudo sob controle. Nenhum alerta crítico.</div></div>`
          : (r.alertas||[]).map(a => `<div class="bif-alert ${a.kind}"><span class="ico">${a.kind==='bad'?'🔴':a.kind==='warn'?'⚠️':'ℹ️'}</span><div>${escapeHtml(a.txt)}</div></div>`).join('');

        // Helper delta % (compara atual com anterior)
        const z = r.zoho || {};
        const _delta = (atual, ant) => {
          if (!ant && ant !== 0) return '';
          if (ant === 0) return atual > 0 ? `<span class="ok" style="font-weight:600">novo</span>` : '';
          const pct = ((atual - ant) / Math.abs(ant)) * 100;
          const sign = pct >= 0 ? '+' : '';
          const cls = pct >= 0 ? 'ok' : 'bad';
          return `<span class="${cls}" style="font-weight:600">${sign}${pct.toFixed(1)}%</span>`;
        };

        // KPIs
        const ant = z.anterior || null;
        const cards = [
          { lbl:'💰 Saldo bancos', val:fmtBRL(r.bancos.saldoTotal), klass: r.bancos.saldoTotal>=0?'ok':'bad', sub: r.bancos.total + ' conta(s) · limite ' + fmtBRL(r.bancos.limiteTotal) },
          { lbl:'⚖️ Caixa projetado', val:fmtBRL(r.caixaProjetado), klass: r.caixaProjetado>=0?'ok':'bad', sub:'saldo − a pagar + a receber' },
          { lbl:'📤 A pagar (em aberto)', val:fmtBRL(r.pagamentos.valorAguardando + r.pagamentos.valorAprovado), klass:'warn', sub:r.pagamentos.aguardando+' aguard. · '+r.pagamentos.aprovado+' aprov.' },
          { lbl:'📥 A receber (em aberto)', val:fmtBRL(r.recebimentos.valorAberto), klass:'info', sub:r.recebimentos.aberto+' contas' },
          { lbl:'💵 Receita Zoho (período)', val:fmtBRL(z.atual?.receita||0), klass:'info', sub: (z.atual?.count||0)+' venda(s) ' + (ant ? _delta(z.atual.receita, ant.receita) : '') },
          { lbl:'📈 Lucro real (período)', val:fmtBRL(z.atual?.lucro||0), klass: (z.atual?.lucro||0)>=0?'ok':'bad', sub: ant ? _delta(z.atual.lucro, ant.lucro) : ((z.atual?.semFicha||0)+' sem ficha') },
          { lbl:'🔴 Vencidos a pagar', val:fmtBRL(r.pagamentos.vencidos), klass: r.pagamentos.vencidos>0?'bad':'ok' },
          { lbl:'📅 A pagar este mês', val:fmtBRL(r.pagamentos.noMes), klass:'warn' },
        ];
        document.getElementById('bifCeoKpis').innerHTML = cards.map(c =>
          `<div class="bif-kpi ${c.klass}"><div class="lbl">${c.lbl}</div><div class="val">${c.val}</div>${c.sub?`<div class="sub">${c.sub}</div>`:''}</div>`).join('');

        // Bancos detalhe
        document.getElementById('bifCeoBancos').innerHTML = (r.bancos.lista||[]).length === 0
          ? '<div class="bif-empty">Nenhuma conta cadastrada.</div>'
          : r.bancos.lista.map(b => `<div class="bif-rank-row"><div class="pos">🏦</div><div class="nm">${escapeHtml(b.apelido)}</div><div class="vl ${b.saldo>=0?'ok':'bad'}">${fmtBRL(b.saldo)}</div></div>`).join('');

        // Cronograma pagamentos
        document.getElementById('bifCeoCronoPg').innerHTML = `
          <tr><td class="lbl">Vencendo hoje</td><td class="val warn">${fmtBRL(r.pagamentos.vencendoHoje)}</td></tr>
          <tr><td class="lbl">Vencidos</td><td class="val ${r.pagamentos.vencidos>0?'bad':'ok'}">${fmtBRL(r.pagamentos.vencidos)}</td></tr>
          <tr><td class="lbl">Próximos 7 dias</td><td class="val info">${fmtBRL(r.pagamentos.proxSemana)}</td></tr>
          <tr><td class="lbl">Total no mês</td><td class="val info">${fmtBRL(r.pagamentos.noMes)}</td></tr>
          <tr class="total"><td>A pagar (aprovados)</td><td class="val">${fmtBRL(r.pagamentos.valorAprovado)}</td></tr>
          <tr class="total"><td>Aguardando aprovação</td><td class="val warn">${fmtBRL(r.pagamentos.valorAguardando)}</td></tr>
        `;

        // Top vendas (CLICÁVEIS — abre ficha)
        const top = z.top5Lucro || [];
        document.getElementById('bifCeoTopVendas').innerHTML = top.length === 0
          ? '<div class="bif-empty">Sem vendas Zoho no período (ou sem ficha financeira).</div>'
          : top.map((v,i) => `<div class="bif-rank-row" style="cursor:pointer" onclick="BIF.ceoAbrirVenda('${v.module}','${v.zohoId}')" title="Click pra abrir a ficha financeira">
              <div class="pos">${i+1}º</div>
              <div class="nm">${escapeHtml(v.cliente||v.titulo||'—')}<div class="muted" style="font-size:10.5px">${v.data} · receita ${fmtBRL(v.valor)} · ${(v.produtos||[]).slice(0,2).join(', ')||'sem produtos'}</div></div>
              <div class="vl ${v.lucro<0?'bad':'ok'}">${fmtBRL(v.lucro)}</div>
            </div>`).join('');

        // Piores vendas (clicáveis)
        const piores = (z.piores || []).filter(v => v.lucro < 0);
        document.getElementById('bifCeoPioresVendas').innerHTML = piores.length === 0
          ? '<div class="bif-alert ok"><span class="ico">✅</span><div>Nenhuma venda no prejuízo no período.</div></div>'
          : piores.map(v => `<div class="bif-rank-row" style="cursor:pointer" onclick="BIF.ceoAbrirVenda('${v.module}','${v.zohoId}')" title="Click pra abrir a ficha financeira">
              <div class="pos" style="color:#EF4444">🔴</div>
              <div class="nm">${escapeHtml(v.cliente||v.titulo||'—')}<div class="muted" style="font-size:10.5px">${v.data} · receita ${fmtBRL(v.valor)}</div></div>
              <div class="vl bad">${fmtBRL(v.lucro)}</div>
            </div>`).join('');

        // Lista completa (cacheada pra renderização sob demanda)
        this.ceoState.listaCompleta = z.listaCompleta || [];
        document.getElementById('bifCeoListaResumo').textContent = `${this.ceoState.listaCompleta.length} venda(s) · receita total ${fmtBRL((z.atual?.receita)||0)} · lucro ${fmtBRL((z.atual?.lucro)||0)}`;
        if (this.ceoState.listaAberta) this._ceoRenderListaCompleta();
      } catch(e){
        document.getElementById('bifCeoAlertas').innerHTML = `<div class="bif-alert bad"><span class="ico">❌</span><div>Erro ao carregar: ${escapeHtml(e.message)}</div></div>`;
      }
    },

    _ceoFmtData(iso) {
      if (!iso) return '—';
      const [y,m,d] = iso.split('-');
      return `${d}/${m}/${y}`;
    },

    ceoToggleListaCompleta() {
      this.ceoState.listaAberta = !this.ceoState.listaAberta;
      document.getElementById('bifCeoListaCompleta').style.display = this.ceoState.listaAberta ? 'block' : 'none';
      document.getElementById('bifCeoListaToggleBtn').textContent = this.ceoState.listaAberta ? '▴ Esconder lista' : '▾ Mostrar lista completa';
      if (this.ceoState.listaAberta) this._ceoRenderListaCompleta();
    },

    _ceoRenderListaCompleta() {
      const list = this.ceoState.listaCompleta || [];
      const box = document.getElementById('bifCeoListaCompleta');
      if (list.length === 0) { box.innerHTML = '<div class="bif-empty">Sem vendas no período.</div>'; return; }
      box.innerHTML = '<table class="bif-table" style="font-size:12px"><thead><tr><th>Data</th><th>Cliente</th><th>Vendedor</th><th>Produtos</th><th class="col-num">Receita</th><th class="col-num">Custos</th><th class="col-num">Lucro</th><th class="col-num">Margem</th><th>Status</th></tr></thead><tbody>' +
        list.map(v => {
          const stIco = v.status==='lucrativa'?'✅':v.status==='atencao'?'⚠️':v.status==='prejuizo'?'🔴':'⚪';
          const stCls = v.status==='lucrativa'?'ok':v.status==='atencao'?'warn':v.status==='prejuizo'?'bad':'muted';
          return `<tr style="cursor:pointer" onclick="BIF.ceoAbrirVenda('${v.module}','${v.zohoId}')" title="Click pra abrir a ficha">
            <td>${v.data}</td>
            <td><b>${escapeHtml(v.cliente||v.titulo||'—')}</b></td>
            <td>${escapeHtml(v.vendedor||'—')}</td>
            <td style="font-size:11px">${escapeHtml((v.produtos||[]).slice(0,2).join(', '))}${(v.produtos||[]).length>2?' +'+((v.produtos.length-2)):''}</td>
            <td class="col-num"><b>${fmtBRL(v.valor)}</b></td>
            <td class="col-num bad">${fmtBRL(v.custoTotal)}</td>
            <td class="col-num ${v.lucro<0?'bad':'ok'}"><b>${fmtBRL(v.lucro)}</b></td>
            <td class="col-num">${fmtPct(v.margemLiquida)}</td>
            <td><span class="bif-pill ${stCls}">${stIco} ${v.status}</span></td>
          </tr>`;
        }).join('') + '</tbody></table>';
    },

    // Abre a ficha financeira da venda Zoho (reusa BIF.vzOpenFicha)
    async ceoAbrirVenda(module, zohoId) {
      // Garante que Vendas Zoho foi inicializado pra ter contexto de empresas
      if (!this.vzState.lastSync) {
        // Inicializa só o que precisa (popula empresa select + loads vzState minimamente)
        try { this.vzPopulateEmpresaSel(); } catch(_){}
      }
      // Chama vzOpenFicha que faz fetch de detalhe se necessário
      if (typeof this.vzOpenFicha === 'function') {
        this.vzOpenFicha(module, zohoId);
      } else {
        alert('Carregando módulo Vendas Zoho... tente de novo em 1 segundo.');
      }
    },

    // ===== Conciliação =====
    concState: { last: null },

    async _concPopularContas() {
      try {
        const r = await fetch('/bi-financeiro/api/bancos').then(r=>r.json());
        const sel = document.getElementById('bifConcConta');
        sel.innerHTML = '<option value="">— escolha —</option>' + (r.bancos||[]).filter(b => b.ativo).map(b => `<option value="${b.id}">${escapeHtml(b.apelido||b.banco)} (saldo ${fmtBRL(b.saldoAtual)})</option>`).join('');
      } catch(_){}
    },

    async concProcessar() {
      const contaId = document.getElementById('bifConcConta').value;
      const file = document.getElementById('bifConcArquivo').files[0];
      if (!contaId) { alert('Escolha a conta bancária.'); return; }
      if (!file)    { alert('Selecione o arquivo OFX/CSV.'); return; }
      document.getElementById('bifConcStatus').textContent = '⏳ Lendo arquivo...';
      try {
        const conteudo = await file.text();
        const r = await fetch('/bi-financeiro/api/conciliacao/preview', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ contaId, conteudo, formato:'auto' })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        this.concState.last = r;
        document.getElementById('bifConcStatus').textContent = `✓ ${r.formato.toUpperCase()} · ${r.totalBanco} txs do banco · ${r.totalSistema} no sistema`;
        this._concRender();
      } catch(e){ document.getElementById('bifConcStatus').innerHTML = '<span style="color:#EF4444">❌ '+escapeHtml(e.message)+'</span>'; }
    },

    _concRender() {
      const r = this.concState.last; if (!r) return;
      const box = document.getElementById('bifConcResultado');
      const diff = (r.saldoBanco||0) - (r.saldoSistema||0);
      // Cards de resumo
      const cards = `<div class="bif-kpi-grid" style="margin-bottom:12px">
        <div class="bif-kpi info"><div class="lbl">Conciliados</div><div class="val">${r.conciliados.length}</div><div class="sub">${fmtBRL(r.conciliados.reduce((s,c)=>s+c.ofxTx.valor,0))}</div></div>
        <div class="bif-kpi warn"><div class="lbl">Só no banco</div><div class="val">${r.pendentesBanco.length}</div><div class="sub">${fmtBRL(r.pendentesBanco.reduce((s,t)=>s+t.valor,0))}</div></div>
        <div class="bif-kpi warn"><div class="lbl">Só no sistema</div><div class="val">${r.pendentesSistema.length}</div><div class="sub">${fmtBRL(r.pendentesSistema.reduce((s,e)=>s+Number(e.valor),0))}</div></div>
        <div class="bif-kpi ${Math.abs(diff)<0.01?'ok':'bad'}"><div class="lbl">Diferença saldos</div><div class="val">${fmtBRL(diff)}</div><div class="sub">Banco ${fmtBRL(r.saldoBanco)} · Sistema ${fmtBRL(r.saldoSistema)}</div></div>
      </div>`;

      // Conciliados
      const conciliadosHTML = r.conciliados.length === 0 ? '<div class="bif-empty" style="padding:14px">Nada conciliado.</div>' :
        '<div class="bif-card" style="padding:0;overflow-x:auto;margin-bottom:12px"><table class="bif-table"><thead><tr><th>Banco (data)</th><th>Sistema</th><th class="col-num">Valor</th><th>Diff dias</th><th>Status</th><th class="col-act">Ação</th></tr></thead><tbody>' +
        r.conciliados.map(c => `<tr>
          <td><span class="bif-pill ${c.ofxTx.tipo==='entrada'?'ok':'bad'}">${c.ofxTx.tipo}</span> ${c.ofxTx.data}<div class="muted" style="font-size:10.5px">${escapeHtml(c.ofxTx.descricao||'')}</div></td>
          <td>${escapeHtml(c.sistemaEntry.descricao||'—')}<div class="muted" style="font-size:10.5px">${(c.sistemaEntry.data||'').slice(0,10)} · refTipo: ${escapeHtml(c.sistemaEntry.refTipo||'-')}</div></td>
          <td class="col-num"><b>${fmtBRL(c.ofxTx.valor)}</b></td>
          <td>${c.diffDias.toFixed(0)}d</td>
          <td><span class="bif-pill ${c.jaConfirmado?'ok':'info'}">${c.jaConfirmado?'✓ confirmado':'⏳ sugerido'}</span></td>
          <td class="col-act">
            ${c.jaConfirmado
              ? `<button class="bif-btn sm danger" onclick="BIF.concQuebrar('${c.sistemaEntry.id}')">↶ quebrar</button>`
              : `<button class="bif-btn sm primary" onclick="BIF.concConfirmar('${c.sistemaEntry.id}','${escapeHtml(c.ofxTx.ofxTxId)}')">✓ confirmar</button>`
            }
          </td>
        </tr>`).join('') + '</tbody></table></div>';

      // Pendentes banco
      const pendBancoHTML = r.pendentesBanco.length === 0 ? '' :
        `<h3 style="margin:14px 0 8px;color:#F59E0B">📥 Só no banco (${r.pendentesBanco.length}) — importar?</h3>
        <div class="bif-card" style="padding:0;overflow-x:auto;margin-bottom:12px"><table class="bif-table"><thead><tr><th>Data</th><th>Tipo</th><th>Descrição</th><th class="col-num">Valor</th><th class="col-act">Ação</th></tr></thead><tbody>` +
        r.pendentesBanco.map((t,i) => `<tr>
          <td>${t.data}</td>
          <td><span class="bif-pill ${t.tipo==='entrada'?'ok':'bad'}">${t.tipo}</span></td>
          <td style="font-size:11.5px">${escapeHtml(t.descricao||'—')}</td>
          <td class="col-num"><b>${fmtBRL(t.valor)}</b></td>
          <td class="col-act"><button class="bif-btn sm primary" onclick="BIF.concImportar(${i})">📥 Importar</button></td>
        </tr>`).join('') + '</tbody></table></div>';

      // Pendentes sistema
      const pendSistHTML = r.pendentesSistema.length === 0 ? '' :
        `<h3 style="margin:14px 0 8px;color:#F59E0B">⏳ Só no sistema (${r.pendentesSistema.length}) — aguardando compensar?</h3>
        <div class="bif-card" style="padding:0;overflow-x:auto"><table class="bif-table"><thead><tr><th>Data</th><th>Tipo</th><th>Descrição</th><th class="col-num">Valor</th><th>Ref</th></tr></thead><tbody>` +
        r.pendentesSistema.map(e => `<tr>
          <td>${(e.data||'').slice(0,10)}</td>
          <td><span class="bif-pill ${e.tipo==='entrada'?'ok':'bad'}">${e.tipo}</span></td>
          <td style="font-size:11.5px">${escapeHtml(e.descricao||'—')}</td>
          <td class="col-num"><b>${fmtBRL(e.valor)}</b></td>
          <td style="font-size:10.5px">${escapeHtml(e.refTipo||'-')}: ${escapeHtml((e.refId||'').slice(0,16))}</td>
        </tr>`).join('') + '</tbody></table>';

      box.innerHTML = cards + '<h3 style="margin:14px 0 8px;color:#22C55E">✓ Conciliados (' + r.conciliados.length + ')</h3>' + conciliadosHTML + pendBancoHTML + pendSistHTML;
    },

    async concConfirmar(extratoEntryId, ofxTxId) {
      try {
        const r = await fetch('/bi-financeiro/api/conciliacao/confirmar', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ extratoEntryId, ofxTxId })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        // Atualiza estado local sem refetch
        const c = this.concState.last.conciliados.find(c => c.sistemaEntry.id === extratoEntryId);
        if (c) c.jaConfirmado = true;
        this._concRender();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async concQuebrar(extratoEntryId) {
      if (!confirm('Quebrar conciliação? O movimento volta a aparecer como sugestão.')) return;
      try {
        const r = await fetch('/bi-financeiro/api/conciliacao/quebrar', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ extratoEntryId })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        const c = this.concState.last.conciliados.find(c => c.sistemaEntry.id === extratoEntryId);
        if (c) c.jaConfirmado = false;
        this._concRender();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async concImportar(idx) {
      const tx = this.concState.last?.pendentesBanco?.[idx]; if (!tx) return;
      const contaId = document.getElementById('bifConcConta').value;
      if (!confirm(`Importar como ${tx.tipo} de ${fmtBRL(tx.valor)}?\n\n"${tx.descricao}"\n\nIsso ${tx.tipo==='saida'?'DEBITA':'CREDITA'} a conta bancária e cria um movimento avulso.`)) return;
      try {
        const r = await fetch('/bi-financeiro/api/conciliacao/importar', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ contaId, tx })
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        alert('✓ Importado. Novo saldo: '+fmtBRL(r.novoSaldo));
        // Reprocessa pra atualizar
        this.concProcessar();
      } catch(e){ alert('Erro: '+e.message); }
    },

    // ===== Focus NFe =====
    async _renderFocusNFe() {
      const box = document.getElementById('bifFocusNFeBox');
      if (!box) return;
      if (state.companies.length === 0) { box.innerHTML = '<div class="bif-empty">Cadastre empresas primeiro.</div>'; return; }
      let configs = {};
      try { const r = await fetch('/bi-financeiro/api/focusnfe/config').then(r=>r.json()); configs = r.configs || {}; } catch(_){}
      box.innerHTML = state.companies.map(c => {
        const cfg = configs[c.id] || {};
        const ok = cfg.tokenMasked;
        return `<div style="border:1px solid #30363D;border-radius:10px;padding:12px;margin-bottom:10px;background:${ok?'#0a1a14':'#1a1a14'}">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px">
            <b>${escapeHtml(c.nome)}</b>
            <span class="bif-pill ${ok?'ok':'muted'}">${ok ? '✓ '+escapeHtml(cfg.ambiente||'') : 'sem Focus NFe'}</span>
            ${cfg.cnpj ? `<span class="muted" style="font-size:11px">CNPJ ${escapeHtml(cfg.cnpj)}</span>`:''}
            ${cfg.apelido ? `<span class="muted" style="font-size:11px">${escapeHtml(cfg.apelido)}</span>`:''}
          </div>
          <div class="bif-form-row" style="margin-bottom:6px">
            <div><label>Apelido</label><input type="text" id="bifFx_Apelido_${c.id}" value="${escapeHtml(cfg.apelido||'')}" placeholder="Ex.: Mococa Refrigeração"></div>
            <div><label>CNPJ emitente</label><input type="text" id="bifFx_Cnpj_${c.id}" value="${escapeHtml(cfg.cnpj||'')}" placeholder="00000000000000"></div>
            <div><label>Ambiente</label><select id="bifFx_Amb_${c.id}"><option value="homologacao" ${cfg.ambiente==='homologacao'?'selected':''}>Homologação (testes)</option><option value="producao" ${cfg.ambiente==='producao'?'selected':''}>Produção</option></select></div>
          </div>
          <div class="bif-form-row" style="margin-bottom:6px">
            <div style="grid-column:span 2"><label>Token Focus NFe ${cfg.tokenMasked ? `(atual: <code>${escapeHtml(cfg.tokenMasked)}</code>)` : ''}</label><input type="password" id="bifFx_Tok_${c.id}" placeholder="cole pra trocar" autocomplete="off"></div>
            <div style="display:flex;align-items:flex-end;gap:8px">
              <button class="bif-btn primary sm" onclick="BIF.focusnfeCfgSalvar('${c.id}')">💾 Salvar</button>
              ${ok ? `<button class="bif-btn sm danger" onclick="BIF.focusnfeCfgRemover('${c.id}')">🗑️</button>` : ''}
            </div>
          </div>
        </div>`;
      }).join('');
    },
    async focusnfeCfgSalvar(empresaId) {
      const body = {
        apelido: document.getElementById('bifFx_Apelido_'+empresaId).value,
        cnpj: document.getElementById('bifFx_Cnpj_'+empresaId).value,
        ambiente: document.getElementById('bifFx_Amb_'+empresaId).value,
        ativo: true,
      };
      const tok = document.getElementById('bifFx_Tok_'+empresaId).value;
      if (tok) body.token = tok;
      try {
        const r = await fetch('/bi-financeiro/api/focusnfe/config/'+empresaId, {
          method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(body)
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        document.getElementById('bifFx_Tok_'+empresaId).value = '';
        this._renderFocusNFe();
      } catch(e){ alert('Erro: '+e.message); }
    },
    async focusnfeCfgRemover(empresaId) {
      if (!confirm('Remover Focus NFe desta empresa?')) return;
      await fetch('/bi-financeiro/api/focusnfe/config/'+empresaId, { method:'DELETE' });
      this._renderFocusNFe();
    },

    // Emite NF-e/NFC-e a partir da venda Zoho ABERTA no modal vz
    async vzEmitirNFe(tipoDocumento) {
      const v = this._vzCurr; if (!v) return;
      const empresaId = document.getElementById('bifVzFichaEmpresa').value || v.ficha?.empresaBI;
      if (!empresaId) { alert('Associe a venda a uma empresa BI antes (dropdown "Empresa BI").'); return; }
      // Preview de campos obrigatórios
      const cpf = prompt('CPF/CNPJ do destinatário (apenas números, vazio = consumidor final):', '');
      if (cpf === null) return;
      const venda = {
        cliente: v.cliente || v.titulo,
        cpfDestinatario: cpf && cpf.length === 11 ? cpf : null,
        cnpjDestinatario: cpf && cpf.length === 14 ? cpf : null,
        emailDestinatario: '',
        endereco: { cidade: v.cidade, uf: v.estado, bairro: v.bairro },
        itens: (v.itens||[]).map(it => ({ codigo: it.codigo || '', nome: it.nome, qtd: it.qtd, valor: it.valor, unidade: 'UN' })),
      };
      if (!venda.itens.length) { alert('Esta venda não tem itens (Quoted_Items). Edita no Zoho antes de emitir.'); return; }
      try {
        const r = await fetch('/bi-financeiro/api/focusnfe/emitir', {
          method:'POST', headers:{'Content-Type':'application/json'},
          body: JSON.stringify({ empresaId, tipoDocumento, venda, refId: v.zohoId, refTipo: v.module })
        }).then(r=>r.json());
        if (!r.ok) throw new Error((r.error && (r.error.mensagem || JSON.stringify(r.error))) || 'erro emissão');
        alert(`✅ ${tipoDocumento} solicitada · ref: ${r.ref}\n\nO Focus vai retornar via webhook quando autorizar (alguns segundos). Veja o status na aba Configurações > NF-e.`);
      } catch(e){ alert('Erro: '+e.message); }
    },

    // ===== Tutorial / Primeiros Passos =====
    async tutorialReload() {
      // Verifica estado atual do sistema pra montar checklist dinâmico
      const checks = [];

      // 1. Empresas BI (localStorage)
      const empCount = state.companies?.length || 0;
      checks.push({
        ok: empCount > 0,
        ico: empCount > 0 ? '✅' : '🏢',
        titulo: 'Cadastrar empresas',
        desc: empCount > 0
          ? `${empCount} empresa(s) cadastrada(s) — você pode continuar adicionando.`
          : 'Vá na aba <b>🏢 Empresas</b> e cadastre suas empresas (Tudo de Filtro, American Filter, Mococa, etc).',
        tab: 'empresas',
      });

      // 2. Bancos (Postgres ou JSON)
      let bancosCount = 0;
      try {
        const r = await fetch('/bi-financeiro/api/bancos').then(r=>r.json());
        bancosCount = (r.bancos||[]).length;
      } catch(_){}
      checks.push({
        ok: bancosCount > 0,
        ico: bancosCount > 0 ? '✅' : '🏦',
        titulo: 'Cadastrar contas bancárias',
        desc: bancosCount > 0
          ? `${bancosCount} conta(s) bancária(s) cadastrada(s) com saldo.`
          : 'Vá na aba <b>🏦 Bancos</b> e cadastre suas contas com o saldo inicial real (Itaú, Bradesco, etc).',
        tab: 'bancos',
      });

      // 3. Aprovadores
      let aprovCount = 0;
      try {
        const r = await fetch('/bi-financeiro/api/aprovadores').then(r=>r.json());
        aprovCount = (r.aprovadores||[]).filter(a => a.ativo).length;
      } catch(_){}
      checks.push({
        ok: aprovCount > 0,
        ico: aprovCount > 0 ? '✅' : '👥',
        titulo: 'Cadastrar aprovadores',
        desc: aprovCount > 0
          ? `${aprovCount} aprovador(es) ativo(s).`
          : 'Vá na aba <b>👥 Aprovadores</b> e cadastre quem pode aprovar pagamentos (Paulo, pai, sócios) com nº WhatsApp.',
        tab: 'aprovadores',
      });

      // 4. Z-API configurada (envio WhatsApp)
      let zapiOk = false;
      try {
        const r = await fetch('/bi-financeiro/api/zapi-config').then(r=>r.json());
        zapiOk = !!(r.global?.instanceMasked) || Object.values(r.configs||{}).some(c => c.instanceMasked);
      } catch(_){}
      checks.push({
        ok: zapiOk,
        ico: zapiOk ? '✅' : '📱',
        titulo: 'Configurar Z-API (WhatsApp aprovação)',
        desc: zapiOk
          ? 'Z-API configurada — aprovações via WhatsApp funcionando.'
          : 'Em <b>⚙️ Configurações → Z-API</b>: cadastre instance/token/client_token da sua Z-API pra notificar aprovadores via WhatsApp.',
        tab: 'config',
      });

      // 5. Empresas Postgres (Estoque F1)
      let empPgCount = 0;
      try {
        const r = await fetch('/bi-financeiro/api/estoque/empresas').then(r=>r.json());
        empPgCount = (r.empresas||[]).length;
      } catch(_){}
      checks.push({
        ok: empPgCount > 0,
        ico: empPgCount > 0 ? '✅' : '🏭',
        titulo: '(Estoque) Replicar empresas no Postgres',
        desc: empPgCount > 0
          ? `${empPgCount} empresa(s) no banco de dados (Estoque/Compras).`
          : 'Vá na aba <b>🏭 Estoque → 🏢 Empresas</b> e replique as empresas (necessário pro módulo de Estoque/Compras).',
        tab: 'estoque',
      });

      // 6. Focus NFe configurado (emissão NF-e)
      let focusOk = false;
      try {
        const r = await fetch('/bi-financeiro/api/focusnfe/config').then(r=>r.json());
        focusOk = Object.values(r.configs||{}).some(c => c.tokenMasked);
      } catch(_){}
      checks.push({
        ok: focusOk,
        ico: focusOk ? '✅' : '🧾',
        titulo: 'Configurar Focus NFe (NF-e/NFC-e)',
        desc: focusOk
          ? 'Focus NFe configurada — você pode emitir notas fiscais.'
          : 'Em <b>⚙️ Configurações → NF-e/NFC-e</b>: cadastre token Focus NFe por empresa pra emitir notas. (Opcional se ainda não migrou do OMIE.)',
        tab: 'config',
      });

      // 7. Saldo inicial das contas
      checks.push({
        ok: empCount > 0 && Object.keys(state.config?.saldoInicial||{}).length > 0,
        ico: '💰',
        titulo: 'Ajustar saldo inicial das empresas',
        desc: 'Em <b>⚙️ Configurações → 💼 Saldo inicial de caixa</b>: defina quanto cada empresa tem em caixa hoje pra projeção de fluxo funcionar corretamente.',
        tab: 'config',
      });

      // Render
      const html = checks.map(c => `<div class="bif-tut-check ${c.ok?'ok':''}" onclick="document.querySelector('.bif-tab[data-tab=\\'${c.tab}\\']').click()">
        <span class="ico">${c.ico}</span>
        <div class="body">
          <b>${c.ok?'✓ ':''}${escapeHtml(c.titulo)}</b>
          <div class="mini">${c.desc}</div>
        </div>
      </div>`).join('');
      document.getElementById('bifTutChecklist').innerHTML = html;
    },

    // ===== Recorrência =====
    async recorrPreview() {
      try {
        const [r, last] = await Promise.all([
          fetch('/bi-financeiro/api/recorrencia/preview').then(r=>r.json()),
          fetch('/bi-financeiro/api/recorrencia/last-run').then(r=>r.json()),
        ]);
        const p = r.preview || {};
        const lastRun = last.lastRun;
        document.getElementById('bifRecorrenciaStatus').innerHTML = lastRun
          ? `<div class="bif-alert info"><span class="ico">🕒</span><div>Última execução: <b>${(new Date(lastRun.executedAt)).toLocaleString('pt-BR')}</b> · competência ${escapeHtml(lastRun.competencia)} · ${lastRun.criados} criado(s) · ${lastRun.pulados} pulado(s) · por ${escapeHtml(lastRun.usuario||'?')}</div></div>`
          : '<div class="bif-alert muted"><span class="ico">⏳</span><div>Ainda não rodou. Click em "Rodar agora" pra testar ou aguarde o cron diário.</div></div>';
        const box = document.getElementById('bifRecorrenciaPreview');
        if (p.totalModelos === 0) {
          box.innerHTML = '<p class="muted" style="font-size:12.5px">Nenhum pagamento marcado como recorrente. Edite um pagamento e marque "Recorrente: Sim" pra ele virar modelo.</p>';
          return;
        }
        const rows = (p.itens||[]).map(it => `<tr>
          <td>${escapeHtml(it.modeloFornecedor||'—')}</td>
          <td class="col-num">${fmtBRL(it.modeloValor)}</td>
          <td>${escapeHtml(state.companies.find(c=>c.id===it.modeloEmpresaBI)?.nome||'—')}</td>
          <td>${escapeHtml(it.vencimentoCopia||'—')}</td>
          <td>${it.jaGerado?'<span class="bif-pill ok">✓ já existe</span>':'<span class="bif-pill warn">📝 vai criar</span>'}</td>
          <td style="font-size:11px">${it.copiaExistenteId?(escapeHtml(it.copiaExistenteId)+' · '+escapeHtml(it.copiaExistenteStatus||'')):''}</td>
        </tr>`).join('');
        box.innerHTML = `<p class="muted" style="font-size:11.5px;margin-bottom:6px">Competência: <b>${escapeHtml(p.competencia)}</b> · ${p.totalModelos} modelo(s) cadastrado(s).</p>
          <table class="bif-table">
            <thead><tr><th>Fornecedor</th><th class="col-num">Valor</th><th>Empresa</th><th>Vencimento da cópia</th><th>Status</th><th>ID cópia (se existir)</th></tr></thead>
            <tbody>${rows}</tbody>
          </table>`;
      } catch(e){ alert('Erro: '+e.message); }
    },
    async recorrRodarAgora() {
      if (!confirm('Rodar geração de recorrência agora? Vai criar pagamentos em rascunho pra cada modelo que ainda não tem cópia do mês.')) return;
      try {
        const r = await fetch('/bi-financeiro/api/recorrencia/rodar-agora', {
          method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({})
        }).then(r=>r.json());
        if (!r.ok) throw new Error(r.error||'erro');
        const res = r.result;
        alert(`✓ Recorrência rodada.\n\nCompetência: ${res.competencia}\nCriados: ${res.criados}\nPulados (já existiam): ${res.pulados}\n\nAbra a aba Pagamentos pra ver os rascunhos novos.`);
        this.recorrPreview();
      } catch(e){ alert('Erro: '+e.message); }
    },


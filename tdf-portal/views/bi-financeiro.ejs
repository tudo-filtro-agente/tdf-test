      <tr><td class="lbl">− Custos fixos</td><td class="val bad">${fmtBRL(r.cfTotal)}</td></tr>
      <tr><td class="lbl">− Contas a pagar em aberto</td><td class="val bad">${fmtBRL(r.totalCAP)}</td></tr>
      <tr class="total"><td>Saldo projetado</td><td class="val ${r.saldoCaixaProj<0?'bad':'ok'}" style="font-size:15px">${fmtBRL(r.saldoCaixaProj)}</td></tr>
    `;

    // Projeção 6 meses (replicando lucro mensal a partir do mês atual)
    const meses = [];
    const start = new Date();
    start.setDate(1);
    const lucroMes = (r.receitaTotal - r.custoVarTotal - r.cfTotal); // estimado
    let saldo = r.saldoIni;
    const labels=[], entradas=[], saidas=[], saldos=[];
    const tbody = document.getElementById('bifCaixaTbody');
    let html = '';
    for (let i=0; i<6; i++) {
      const d = new Date(start.getFullYear(), start.getMonth()+i, 1);
      const lbl = d.toLocaleDateString('pt-BR',{month:'short',year:'2-digit'});
      const ent = r.receitaTotal;
      const sai = r.custoVarTotal + r.cfTotal;
      const res = ent - sai;
      saldo += res;
      labels.push(lbl); entradas.push(ent); saidas.push(sai); saldos.push(saldo);
      html += `<tr>
        <td><b>${lbl}</b></td>
        <td class="col-num ok">${fmtBRL(ent)}</td>
        <td class="col-num bad">${fmtBRL(sai)}</td>
        <td class="col-num ${res<0?'bad':'ok'}"><b>${fmtBRL(res)}</b></td>
        <td class="col-num ${saldo<0?'bad':''}"><b>${fmtBRL(saldo)}</b></td>
      </tr>`;
    }
    tbody.innerHTML = html;
    drawChartCaixa(labels, entradas, saidas, saldos);
  }


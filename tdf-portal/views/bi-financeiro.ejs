    },
    capImportarCsvFechar() { document.getElementById('bifCapImportModal').classList.remove('show'); },

    // Parser CSV inteiro no browser (sem servidor)
    _capParseCsv(text) {
      const lines = String(text||'').split(/\r?\n/).filter(l => l.trim());
      if (lines.length < 2) return { criados:[], erros:[{linha:0, motivo:'CSV vazio ou só header'}], total:0 };
      const sep = lines[0].includes(';') ? ';' : (lines[0].includes('\t') ? '\t' : ',');
      const _norm = s => String(s||'').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g,'').replace(/[^a-z0-9_]+/g,'_').replace(/^_|_$/g,'');
      const ALIAS = {
        empresa: 'empresaNome', empresa_id: 'empresaId', empresa_bi: 'empresaId',
        fornecedor: 'fornecedor', supplier: 'fornecedor',
        descricao: 'descricao', description: 'descricao', desc: 'descricao',
        categoria: 'categoria',
        valor: 'valor', amount: 'valor', total: 'valor',
        vencimento: 'vencimento', vencto: 'vencimento', data_vencimento: 'vencimento', due_date: 'vencimento',
        status: 'status',
        observacoes: 'obs', obs: 'obs',
      };
      const rawHeaders = lines[0].split(sep).map(h => h.trim().replace(/^"|"$/g,''));
      const headers = rawHeaders.map(_norm).map(h => ALIAS[h] || h);

      const empresaIndexByName = {};
      (state.companies||[]).forEach(c => { empresaIndexByName[_norm(c.nome)] = c.id; });

      const parseValor = s => {
        if (typeof s === 'number') return s;
        let v = String(s||'').trim().replace(/[R$\s]/g,'');
        if (!v) return 0;
        if (v.includes(',') && v.includes('.')) {
          if (v.lastIndexOf(',') > v.lastIndexOf('.')) v = v.replace(/\./g,'').replace(',','.');
          else v = v.replace(/,/g,'');
        } else if (v.includes(',')) v = v.replace(',','.');
        const n = parseFloat(v);
        return isNaN(n) ? 0 : n;
      };
      const parseData = s => {
        if (!s) return '';
        const t = String(s).trim();
        let m = t.match(/^(\d{4})-(\d{2})-(\d{2})/);
        if (m) return `${m[1]}-${m[2]}-${m[3]}`;
        m = t.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
        if (m) { let y = m[3]; if (y.length===2) y='20'+y; return `${y}-${m[2].padStart(2,'0')}-${m[1].padStart(2,'0')}`; }
        return '';
      };

      const criados = []; const erros = [];
      for (let i = 1; i < lines.length; i++) {
        const linha = i + 1;
        const cols = lines[i].split(sep).map(c => c.trim().replace(/^"|"$/g,''));
        const row = {};
        headers.forEach((h, idx) => { row[h] = cols[idx] || ''; });

        let empresaId = row.empresaId || '';
        if (!empresaId && row.empresaNome) empresaId = empresaIndexByName[_norm(row.empresaNome)] || '';

        const valor = parseValor(row.valor);
        const vencimento = parseData(row.vencimento);

        if (!row.fornecedor) { erros.push({ linha, motivo:'fornecedor obrigatório', raw: row }); continue; }
        if (valor <= 0)      { erros.push({ linha, motivo:'valor inválido ou zero', raw: row }); continue; }
        if (!empresaId)      { erros.push({ linha, motivo:'empresa não identificada (passe empresa_id ou empresa com nome cadastrado)', raw: row }); continue; }

        const statusRaw = (row.status||'').toLowerCase().trim();
        const statusFinal = ['pendente','pago','atrasado','cancelado'].includes(statusRaw) ? statusRaw : 'pendente';

        criados.push({
          linha,
          payload: {
            id: 'id_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36),
            companyId: empresaId,
            fornecedor: row.fornecedor,
            descricao: row.descricao || '',
            categoria: row.categoria || '',
            valor: valor,
            vencimento: vencimento || todayMonth()+'-15',
            status: statusFinal,
            obs: row.obs || '',
            anexoUrl: row.anexo_url || row.anexo || '',
          }
        });
      }
      return { criados, erros, total: lines.length - 1 };
    },

    async capImportarCsvPreview() {
      const file = document.getElementById('bifCapImportFile').files[0];
      if (!file) { alert('Selecione o arquivo CSV.'); return; }
      const box = document.getElementById('bifCapImportResultado');
      box.innerHTML = '<div class="bif-empty">⏳ Lendo arquivo...</div>';
      try {
        const csv = await file.text();
        const parsed = this._capParseCsv(csv);
        this._capCsvParsed = parsed;
        this._renderCapImportResultado(parsed, true);
      } catch(e) { box.innerHTML = `<div class="bif-alert bad"><span class="ico">❌</span><div>Erro: ${escapeHtml(e.message)}</div></div>`; }
    },

    capImportarCsvConfirmar() {
      const p = this._capCsvParsed; if (!p || !p.criados.length) return;
      // Insere direto em state.contasPagar (localStorage)
      p.criados.forEach(c => { state.contasPagar.push(c.payload); });
      save();
      this._renderCapImportResultado(p, false);
      document.getElementById('bifCapImportBtnConfirmar').style.display = 'none';
      // Atualiza UI
      renderContasPagar();
      renderKpis();
      renderAlertas();
    },

    _renderCapImportResultado(r, isPreview) {
      const box = document.getElementById('bifCapImportResultado');
      const ok = r.criados?.length || 0;
      const err = r.erros?.length || 0;
      let html = '';
      if (isPreview) {
        html += `<div class="bif-alert ${err>0?'warn':'info'}"><span class="ico">${err>0?'⚠️':'ℹ️'}</span><div><b>Pré-visualização:</b> ${ok} válida(s) · ${err} com erro · total ${r.total||0} linhas</div></div>`;
      } else {
        html += `<div class="bif-alert ${ok>0?'ok':'bad'}"><span class="ico">${ok>0?'✅':'❌'}</span><div><b>Importação concluída:</b> ${ok} conta(s) adicionada(s) à aba Contas a Pagar simples · ${err} com erro</div></div>`;
      }
      if (ok > 0) {
        html += '<details style="margin:10px 0"><summary style="cursor:pointer;color:#22C55E;font-weight:700">✓ '+ok+' contas '+(isPreview?'serão importadas':'importadas')+'</summary><table class="bif-table" style="margin-top:8px;font-size:12px"><thead><tr><th>Linha</th><th>Empresa</th><th>Fornecedor</th><th class="col-num">Valor</th><th>Vencimento</th><th>Status</th></tr></thead><tbody>' +
          r.criados.map(c => {
            const v = c.payload;
            const empNome = state.companies.find(e => e.id === v.companyId)?.nome || '—';
            return `<tr><td>${c.linha}</td><td>${escapeHtml(empNome)}</td><td>${escapeHtml(v.fornecedor||'—')}</td><td class="col-num">${fmtBRL(v.valor)}</td><td>${escapeHtml(v.vencimento||'—')}</td><td>${escapeHtml(v.status)}</td></tr>`;
          }).join('') + '</tbody></table></details>';
      }
      if (err > 0) {
        html += '<details open style="margin:10px 0"><summary style="cursor:pointer;color:#EF4444;font-weight:700">❌ '+err+' erro(s)</summary><table class="bif-table" style="margin-top:8px;font-size:12px"><thead><tr><th>Linha</th><th>Motivo</th><th>Dados</th></tr></thead><tbody>' +
          r.erros.map(e => `<tr><td>${e.linha}</td><td style="color:#EF4444">${escapeHtml(e.motivo)}</td><td style="font-size:11px;color:#8899AA">${escapeHtml(JSON.stringify(e.raw).slice(0,120))}</td></tr>`).join('') + '</tbody></table></details>';
      }
      box.innerHTML = html;
      if (isPreview && ok > 0) {
        document.getElementById('bifCapImportBtnConfirmar').style.display = '';
        document.getElementById('bifCapImportBtnConfirmar').textContent = `✅ Confirmar e importar ${ok} contas`;
      }
    },

    capBaixarTemplateCsv() {

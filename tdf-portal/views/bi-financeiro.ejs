    const cards = [
      { lbl:'Faturamento', val:fmtBRL(r.receitaTotal), klass:'info', sub: r.qtdProdutos + ' produtos · ' + r.qtdVendas + ' receitas avulsas' },
      { lbl:'Lucro bruto', val:fmtBRL(r.lucroBruto), klass: r.lucroBruto>=0?'ok':'bad' },
      { lbl:'Lucro líquido', val:fmtBRL(r.lucroLiquido), klass: r.lucroLiquido>=0?'ok':'bad' },
      { lbl:'Margem líquida', val:fmtPct(r.margemLiq), klass: r.margemLiq>=0.10?'ok':r.margemLiq>=0?'warn':'bad' },
      { lbl:'Break-even', val:fmtBRL(r.breakEven), klass: r.receitaTotal>=r.breakEven?'ok':'warn', sub: r.receitaTotal>=r.breakEven?'✓ Acima do equilíbrio':'⚠ Faltam '+fmtBRL(r.breakEven - r.receitaTotal) },
      { lbl:'Saldo de caixa proj.', val:fmtBRL(r.saldoCaixaProj), klass: r.saldoCaixaProj>=0?'ok':'bad', sub:'Inicial: '+fmtBRL(r.saldoIni) },
      { lbl:'Contas a pagar (em aberto)', val:fmtBRL(r.totalCAP), klass: r.totalCAP>0?'warn':'ok' },
      { lbl:'Contas a receber (em aberto)', val:fmtBRL(r.totalCAR), klass:'info' },

      const err = r.erros?.length || 0;
      let html = `<div class="bif-alert ${err>0?'warn':'info'}"><span class="ico">ℹ️</span><div><b>${isPreview?'Pré-visualização':'Importado'}:</b> ${ok} novo(s) · ${upd} atualizado(s) · ${err} erro(s) · total ${r.total||0}</div></div>`;

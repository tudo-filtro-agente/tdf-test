        `${empresaSugestao};Imobiliária Centro;Aluguel galpão maio;Aluguel;8500,00;10/05/2026;pendente;`,
        `${empresaSugestao};Fornecedor X;Insumos abril;Insumos;3245,90;20/04/2026;pago;Pago via OMIE em 20/04`,

  function renderAlertas() {
    const alerts = [];
    // 1. Produtos com margem negativa
    const negProds = state.produtos.map(p => ({p, c:calcProduto(p)})).filter(x => x.c.margemContrib < 0 && x.p.precoVenda > 0);
    negProds.forEach(x => alerts.push({
      kind:'bad', ico:'📉',
      txt:`<b>${escapeHtml(x.p.nome)}</b> (${escapeHtml(compName(x.p.companyId))}) está com margem de contribuição NEGATIVA (${fmtPct(x.c.margemContrib)}). Cada venda dá prejuízo de ${fmtBRL(-x.c.lucroUnit)}.`
    }));
    // 2. Produtos com margem baixa
    const lowProds = state.produtos.map(p => ({p, c:calcProduto(p)})).filter(x => x.c.margemContrib >= 0 && x.c.margemContrib < 0.10 && x.p.precoVenda > 0);
    lowProds.forEach(x => alerts.push({
      kind:'warn', ico:'⚠️',
      txt:`<b>${escapeHtml(x.p.nome)}</b> está com margem baixa (${fmtPct(x.c.margemContrib)}). Recomendado mínimo 15-20%.`
    }));
    // 3. Empresa abaixo do break-even
    state.companies.forEach(c => {
      const r = calcResumoEmpresa(c.id);
      if (r.cfTotal > 0 && r.receitaTotal < r.breakEven) {
        const falta = r.breakEven - r.receitaTotal;
        alerts.push({ kind:'bad', ico:'⚖️',
          txt:`Empresa <b>${escapeHtml(c.nome)}</b> está abaixo do ponto de equilíbrio. Faltam ${fmtBRL(falta)} de faturamento para começar a dar lucro.` });
      }
    });
    // 4. Caixa projetado negativo
    state.companies.forEach(c => {
      const r = calcResumoEmpresa(c.id);
      if (r.saldoCaixaProj < 0) {
        alerts.push({ kind:'bad', ico:'🔥',
          txt:`Caixa projetado de <b>${escapeHtml(c.nome)}</b> está NEGATIVO em ${fmtBRL(-r.saldoCaixaProj)}. Risco de inadimplência.` });
      }
    });
    // 5. Despesa fixa alta vs receita
    state.companies.forEach(c => {
      const r = calcResumoEmpresa(c.id);
      if (r.receitaTotal > 0 && (r.cfTotal / r.receitaTotal) > 0.40) {
        alerts.push({ kind:'warn', ico:'📌',
          txt:`Custos fixos da <b>${escapeHtml(c.nome)}</b> consomem ${fmtPct(r.cfTotal/r.receitaTotal)} da receita. Acima de 40% acende alerta de estrutura pesada.` });
      }
    });
    // 6. Contas vencidas
    const today = new Date().toISOString().slice(0,10);
    const capVenc = state.contasPagar.filter(x => x.status !== 'pago' && x.vencimento && x.vencimento < today);
    if (capVenc.length > 0) {
      const tot = capVenc.reduce((s,x)=>s+(+x.valor||0),0);
      alerts.push({ kind:'bad', ico:'⏰',
        txt:`Você tem <b>${capVenc.length} conta(s) a pagar VENCIDA(s)</b>, totalizando ${fmtBRL(tot)}.` });
    }
    const carVenc = state.contasReceber.filter(x => x.status !== 'pago' && x.vencimento && x.vencimento < today);
    if (carVenc.length > 0) {
      const tot = carVenc.reduce((s,x)=>s+(+x.valor||0),0);
      alerts.push({ kind:'warn', ico:'📥',
        txt:`Você tem <b>${carVenc.length} conta(s) a receber atrasada(s)</b>, totalizando ${fmtBRL(tot)}. Hora de cobrar.` });
    }
    // 7. Vende muito mas dá pouco lucro
    state.produtos.forEach(p => {
      const c = calcProduto(p);
      if (c.qtd > 30 && c.margemContrib >= 0 && c.margemContrib < 0.15) {
        alerts.push({ kind:'warn', ico:'🐎',
          txt:`<b>${escapeHtml(p.nome)}</b> é um cavalo de batalha (${c.qtd} unidades) mas a margem é baixa (${fmtPct(c.margemContrib)}). Revisar preço/custo pode destravar muito lucro.` });
      }
    });
    // 8. Concentração em poucos produtos
    state.companies.forEach(c => {
      const ps = state.produtos.filter(p => p.companyId === c.id).map(p => ({p, c:calcProduto(p)}));
      const recT = ps.reduce((s,x)=>s+x.c.receitaTotal,0);
      if (recT > 0 && ps.length >= 1) {
        const top = ps.sort((a,b)=>b.c.receitaTotal-a.c.receitaTotal)[0];
        const conc = top.c.receitaTotal / recT;
        if (conc >= 0.7 && ps.length > 1) {
          alerts.push({ kind:'warn', ico:'🎯',
            txt:`A <b>${escapeHtml(c.nome)}</b> depende muito de <b>${escapeHtml(top.p.nome)}</b> (${fmtPct(conc)} do faturamento). Risco de concentração — diversificar reduz exposição.` });
        }
      }
    });

    const box = document.getElementById('bifAlertasBox');
    if (alerts.length === 0) {
      box.innerHTML = `<div class="bif-alert ok"><span class="ico">✅</span><div>Nenhum alerta no momento. Operação saudável!</div></div>`;
    } else {
      box.innerHTML = alerts.map(a => `<div class="bif-alert ${a.kind}"><span class="ico">${a.ico}</span><div>${a.txt}</div></div>`).join('');
    }
  }


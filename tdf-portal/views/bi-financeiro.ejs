<script>
/* ====================================================================
   BI FINANCEIRO MULTIEMPRESA — TDF Portal
   Persistência: localStorage (chave: tdf_bi_financeiro_v1)
   Todos os números vêm do cadastro do usuário. Nada é hardcoded.
   ==================================================================== */
(function(){
  const STORAGE_KEY = 'tdf_bi_financeiro_v1';
  const BIF_USER_ROLE = '<%= user.role %>';
  const BIF_IS_ADMIN  = (BIF_USER_ROLE === 'admin');
  const fmtBRL = (v) => 'R$ ' + (Number(v||0)).toLocaleString('pt-BR', { minimumFractionDigits:2, maximumFractionDigits:2 });
  const fmtPct = (v) => (Number(v||0)*100).toLocaleString('pt-BR', { minimumFractionDigits:1, maximumFractionDigits:1 }) + '%';
  const fmtNum = (v) => Number(v||0).toLocaleString('pt-BR', { minimumFractionDigits:0, maximumFractionDigits:2 });
  const uid = () => 'id_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36);
  const todayMonth = () => { const d = new Date(); return d.toISOString().slice(0,7); };

  // ============ STATE ============
  const defaultState = () => ({
    activeCompanyId: 'consolidado',
    periodo: '', // '' = todos | 'YYYY-MM'
    config: { saldoInicial: {} }, // por empresa
    companies: [],
    produtos: [],
    custosFixos: [],
    custosVariaveis: [],
    receitas: [],
    contasPagar: [],
    contasReceber: [],
  });

  let state = defaultState();
  // === Sync state com servidor (Postgres via kv_store) ===
  // load(): tenta server primeiro, fallback pro localStorage (offline)
  // save(): salva localStorage IMEDIATO + dispara PUT pro server (debounced 1500ms)
  // _syncStatus: 'syncing' | 'ok' | 'erro' | 'offline'
  let _syncDebounce = null;
  let _syncStatus = 'idle';
  let _serverVersion = 0;

  function _updateSyncBadge() {
    const el = document.getElementById('bifSyncBadge'); if (!el) return;
    const map = {
      idle:    { txt:'',                 cls:'muted', show:false },
      syncing: { txt:'⏳ sincronizando',   cls:'info' },
      ok:      { txt:'✓ sincronizado',    cls:'ok' },
      erro:    { txt:'⚠️ erro de sync',   cls:'bad' },
      offline: { txt:'📴 offline (só local)', cls:'muted' },
    };
    const cfg = map[_syncStatus] || map.idle;
    el.style.display = cfg.show === false ? 'none' : '';
    el.className = 'bif-pill ' + cfg.cls;
    el.textContent = cfg.txt;
  }

  async function load() {
    // 1) Tenta carregar do servidor (compartilhado)
    let fromServer = null;
    try {
      _syncStatus = 'syncing'; _updateSyncBadge();
      const r = await fetch('/bi-financeiro/api/state', { credentials:'same-origin' });
      if (r.ok) {
        const j = await r.json();
        if (j.ok && j.state && typeof j.state === 'object') {
          fromServer = j.state;
          _serverVersion = j.state._meta?.version || 0;
        }
      }
    } catch(e) { console.warn('[BIF] load server falhou — fallback localStorage', e.message); }

    if (fromServer) {
      // Server tem estado — usa ele
      state = Object.assign(defaultState(), fromServer);
      delete state._meta; // não polui state
      _syncStatus = 'ok';
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); } catch(_){}
    } else {
      // Fallback: localStorage
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          state = Object.assign(defaultState(), JSON.parse(raw));
          _syncStatus = 'offline';
          // Tenta empurrar pro server (one-shot, sem await)
          _pushStateToServer().catch(()=>{});
        } else {
          _syncStatus = 'ok'; // nada salvo ainda
        }
      } catch(e){ console.warn('[BIF] load error', e); _syncStatus = 'erro'; }
    }
    _updateSyncBadge();

    if (!state.companies || state.companies.length === 0) {
      state.activeCompanyId = 'consolidado';
    }
  }

  async function _pushStateToServer() {
    try {
      const payload = { ...state, _meta: { version: _serverVersion } };
      const r = await fetch('/bi-financeiro/api/state', {
        method:'PUT', credentials:'same-origin',
        headers:{'Content-Type':'application/json'},
        body: JSON.stringify(payload)
      });
      if (!r.ok) throw new Error('http '+r.status);
      const j = await r.json();
      if (j.ok) { _serverVersion = j.version || _serverVersion + 1; _syncStatus = 'ok'; }
      else throw new Error(j.error || 'falhou');
    } catch(e) {
      console.warn('[BIF] sync server falhou', e.message);
      _syncStatus = 'erro';
    }
    _updateSyncBadge();
  }

  function save() {
    // 1) Salva localStorage IMEDIATO (rápido, sem rede)
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
    catch(e){ alert('Erro ao salvar local: '+e.message); }
    // 2) Sync com server (debounced 1500ms — não flooda)
    _syncStatus = 'syncing'; _updateSyncBadge();
    if (_syncDebounce) clearTimeout(_syncDebounce);
    _syncDebounce = setTimeout(() => _pushStateToServer(), 1500);
  }

  // ============ FILTROS ============
  function isInScope(item) {
    if (state.activeCompanyId !== 'consolidado' && item.companyId !== state.activeCompanyId) return false;
    if (state.periodo) {
      const d = item.data || item.vencimento || item.mesRef || '';
      if (d && !String(d).startsWith(state.periodo)) return false;
    }
    return true;
  }

  function scoped(arr) { return (arr||[]).filter(isInScope); }

  function compName(id) {
    const c = state.companies.find(c => c.id === id);
    return c ? c.nome : '—';
  }

  // ============ CÁLCULOS ============
  function calcProduto(p) {
    const preco   = +p.precoVenda || 0;
    const cmv     = +p.custoProduto || 0;
    const frete   = +p.frete || 0;
    const impPct  = (+p.impostosPct || 0) / 100;
    const comPct  = (+p.comissaoPct || 0) / 100;
    const outros  = +p.outrosCustos || 0;
    const qtd     = +p.qtdVendida || 0;
    const margemBruta   = preco > 0 ? (preco - cmv) / preco : 0;
    const custoVarUnit  = cmv + frete + outros + (preco * impPct) + (preco * comPct);
    const margemContrib = preco > 0 ? (preco - custoVarUnit) / preco : 0;
    const lucroUnit     = preco - custoVarUnit;
    const lucroTotal    = lucroUnit * qtd;
    const receitaTotal  = preco * qtd;
    return { preco, cmv, qtd, margemBruta, margemContrib, lucroUnit, lucroTotal, receitaTotal, custoVarUnit };
  }

  function calcResumoEmpresa(companyId) {
    const isConsolidado = (companyId === 'consolidado');
    const filt = (item) => {
      if (!isConsolidado && item.companyId !== companyId) return false;
      if (state.periodo) {
        const d = item.data || item.vencimento || '';
        if (d && !String(d).startsWith(state.periodo)) return false;
      }
      return true;
    };
    const prods = state.produtos.filter(filt);
    const cf    = state.custosFixos.filter(filt);
    const cv    = state.custosVariaveis.filter(filt);
    const rec   = state.receitas.filter(filt);
    const cap   = state.contasPagar.filter(filt);
    const car   = state.contasReceber.filter(filt);

    let receitaProd = 0, lucroBruto = 0, custosVarProd = 0, custosImpostos = 0, custosComissao = 0, custosFreteProd = 0, cmvTot = 0;
    prods.forEach(p => {
      const c = calcProduto(p);
      receitaProd += c.receitaTotal;
      cmvTot      += c.cmv * c.qtd;
      custosFreteProd += (+p.frete||0) * c.qtd;
      custosImpostos  += c.preco * c.qtd * ((+p.impostosPct||0)/100);
      custosComissao  += c.preco * c.qtd * ((+p.comissaoPct||0)/100);
      custosVarProd   += (+p.outrosCustos||0) * c.qtd;
      lucroBruto      += c.lucroTotal;
    });

    const receitaAvulsa = rec.reduce((s,r) => s + ((+r.qtd||1) * (+r.valorUnit||0)), 0);
    const receitaTotal  = receitaProd + receitaAvulsa;

    const cfTotal = cf.reduce((s,x) => s + (+x.valor||0), 0);
    const cvFixos = cv.reduce((s,x) => {
      const direto = +x.valor || 0;
      const pct = (+x.percSobreVenda||0)/100;
      return s + direto + (receitaTotal * pct);
    }, 0);

    const custoVarTotal = cmvTot + custosFreteProd + custosImpostos + custosComissao + custosVarProd + cvFixos;
    const lucroLiquido  = receitaTotal - custoVarTotal - cfTotal;
    const margemLiq     = receitaTotal > 0 ? lucroLiquido / receitaTotal : 0;

    // margem de contrib média ponderada
    const margemContribMedia = receitaTotal > 0
      ? (receitaTotal - custoVarTotal) / receitaTotal
      : 0;
    const breakEven = margemContribMedia > 0 ? cfTotal / margemContribMedia : 0;

    // Caixa
    const saldoIni = +(state.config.saldoInicial[companyId] || 0);
    const totalCAR = car.filter(x => x.status !== 'pago').reduce((s,x)=>s+(+x.valor||0),0);
    const totalCAP = cap.filter(x => x.status !== 'pago').reduce((s,x)=>s+(+x.valor||0),0);
    const saldoCaixaProj = saldoIni + receitaTotal + totalCAR - custoVarTotal - cfTotal - totalCAP;

    return {
      receitaTotal, receitaProd, receitaAvulsa, lucroBruto, lucroLiquido, margemLiq,
      cfTotal, cvFixos, custoVarTotal, cmvTot, custosFreteProd, custosImpostos, custosComissao, custosVarProd,
      margemContribMedia, breakEven, totalCAP, totalCAR, saldoIni, saldoCaixaProj,
      qtdProdutos: prods.length, qtdVendas: rec.length
    };
  }


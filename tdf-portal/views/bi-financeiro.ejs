    // =====================================================================
    // ===== Aba CAP simples: seleção múltipla + modal detalhes =====
    // =====================================================================
    _capSelected: new Set(),

    capToggleSelect(id, checked) {
      if (!this._capSelected) this._capSelected = new Set();
      if (checked) this._capSelected.add(id);
      else this._capSelected.delete(id);
      this._capUpdateBulkBar();
    },

    capToggleSelectAll(checked) {
      if (!this._capSelected) this._capSelected = new Set();
      const list = scoped(state.contasPagar);
      if (checked) list.forEach(x => this._capSelected.add(x.id));
      else this._capSelected.clear();
      // Atualiza checkboxes visíveis
      document.querySelectorAll('input[data-cap-check]').forEach(el => {
        el.checked = this._capSelected.has(el.getAttribute('data-cap-check'));
      });
      this._capUpdateBulkBar();
    },

    _capUpdateBulkBar() {
      const bar = document.getElementById('bifCapBulkBar');
      if (!bar) return;
      const n = this._capSelected?.size || 0;
      if (n === 0) {
        bar.style.display = 'none';
        const all = document.getElementById('bifCapSelectAll');
        if (all) all.checked = false;
      } else {
        bar.style.display = 'flex';
        document.getElementById('bifCapBulkCount').textContent = n;
        const total = (state.contasPagar||[])
          .filter(x => this._capSelected.has(x.id))
          .reduce((s,x) => s + (+x.valor||0), 0);
        document.getElementById('bifCapBulkTotal').textContent = fmtBRL(total);
      }
    },

    capBulkLimpar() {
      this._capSelected = new Set();
      document.querySelectorAll('input[data-cap-check]').forEach(el => { el.checked = false; });
      const all = document.getElementById('bifCapSelectAll'); if (all) all.checked = false;
      this._capUpdateBulkBar();
    },

    capBulkExcluir() {
      const n = this._capSelected.size; if (n === 0) return;
      if (!confirm(`Excluir ${n} conta(s) selecionada(s)? Isso é irreversível.`)) return;
      state.contasPagar = state.contasPagar.filter(x => !this._capSelected.has(x.id));
      this._capSelected.clear();
      save(); renderContasPagar(); renderKpis(); renderAlertas();
    },

    capBulkAplicarStatus() {
      const novoStatus = document.getElementById('bifCapBulkStatus').value;
      if (!novoStatus) { alert('Escolha um status no dropdown.'); return; }
      const n = this._capSelected.size; if (n === 0) return;
      if (!confirm(`Mudar status de ${n} conta(s) pra "${novoStatus}"?`)) return;
      let mudadas = 0;
      state.contasPagar.forEach(x => {
        if (this._capSelected.has(x.id)) { x.status = novoStatus; mudadas++; }
      });
      save(); renderContasPagar(); renderKpis(); renderAlertas();
      alert(`✓ ${mudadas} conta(s) atualizada(s) pra status "${novoStatus}".`);
    },

    capBulkDuplicar() {
      const n = this._capSelected.size; if (n === 0) return;
      if (!confirm(`Duplicar ${n} conta(s)?`)) return;
      const novos = [];
      state.contasPagar.forEach(x => {
        if (this._capSelected.has(x.id)) {
          const dup = { ...x, id: 'id_' + Math.random().toString(36).slice(2,10) + Date.now().toString(36) };
          if (dup.fornecedor) dup.fornecedor += ' (cópia)';
          novos.push(dup);
        }
      });
      state.contasPagar.push(...novos);
      save(); renderContasPagar();
    },

    capBulkExportar() {
      const n = this._capSelected.size; if (n === 0) return;
      const linhas = ['empresa;fornecedor;descricao;categoria;valor;vencimento;status;observacoes'];
      state.contasPagar.forEach(x => {
        if (!this._capSelected.has(x.id)) return;
        const empNome = state.companies.find(c => c.id === x.companyId)?.nome || '';
        const safe = s => String(s||'').replace(/;/g,',').replace(/\n/g,' ');
        linhas.push([
          safe(empNome), safe(x.fornecedor), safe(x.descricao), safe(x.categoria),
          (+x.valor||0).toFixed(2).replace('.',','),
          x.vencimento || '', x.status || 'pendente', safe(x.obs)
        ].join(';'));
      });
      const blob = new Blob(['﻿' + linhas.join('\n')], { type:'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const stamp = new Date().toISOString().slice(0,10);
      a.href = url; a.download = `contas-a-pagar-${stamp}.csv`;
      a.click(); URL.revokeObjectURL(url);
    },


          <button class="bif-btn sm ghost" onclick="BIF.duplicateRow('produtos','${p.id}')" title="Duplicar">📋</button>
          <button class="bif-btn sm danger" onclick="BIF.delRow('produtos','${p.id}')">🗑️</button>
        </td>

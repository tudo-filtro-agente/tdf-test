<% const activePage = 'bi-financeiro'; const pageTitle = 'BI Financeiro'; %>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.5.31/dist/jspdf.plugin.autotable.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/pt.js"></script>
<style>
  /* Tema dark do flatpickr — fica coerente com o BI */
  .flatpickr-calendar { background:#0F1420 !important; color:#fff !important; border:1px solid var(--border) !important; box-shadow:0 8px 24px rgba(0,0,0,.5) !important; }
  .flatpickr-calendar .flatpickr-day { color:var(--text) !important; }
  .flatpickr-calendar .flatpickr-day:hover { background:#1a1f35 !important; }
  .flatpickr-calendar .flatpickr-day.selected,
  .flatpickr-calendar .flatpickr-day.startRange,
  .flatpickr-calendar .flatpickr-day.endRange { background:#4F8CFF !important; border-color:#4F8CFF !important; color:#fff !important; }
  .flatpickr-calendar .flatpickr-day.inRange { background:#1a2a4a !important; border-color:transparent !important; box-shadow:none !important; }
  .flatpickr-calendar .flatpickr-day.today { border-color:#22C55E !important; }
  .flatpickr-calendar .flatpickr-day.disabled, .flatpickr-day.flatpickr-disabled { color:#3a3a3a !important; }
  .flatpickr-calendar .flatpickr-current-month { color:var(--text) !important; }
  .flatpickr-calendar .flatpickr-monthDropdown-months { background:#0F1420 !important; color:#fff !important; }
  .flatpickr-calendar .flatpickr-weekday { color:#8899AA !important; }
  .flatpickr-calendar .flatpickr-prev-month, .flatpickr-calendar .flatpickr-next-month { color:var(--text) !important; fill:var(--text) !important; }
  .flatpickr-calendar .numInputWrapper:hover { background:#171c2e !important; }
</style>

<style>
  /* ===== BI Financeiro — escopo isolado ===== */
  .bif-root { padding: 18px 22px 60px; color:var(--text); font-family: 'Inter', system-ui, -apple-system, sans-serif; }
  .bif-root h1, .bif-root h2, .bif-root h3 { color:var(--text); margin:0; }
  .bif-root .muted { color:#8899AA; }
  .bif-root .ok { color:#22C55E; }
  .bif-root .warn { color:#F59E0B; }
  .bif-root .bad { color:#EF4444; }

  /* HEADER topo */
  .bif-topbar { display:flex; flex-wrap:wrap; align-items:center; gap:12px; padding:14px 16px; background:linear-gradient(135deg,#0F1420,#1a1f35); border:1px solid var(--border); border-radius:14px; margin-bottom:18px; }
  .bif-topbar h1 { font-size:1.4rem; font-weight:800; }
  .bif-topbar .sep { flex:1; }
  .bif-empresa-sel { display:flex; align-items:center; gap:8px; }
  .bif-empresa-sel select { background:var(--bg-card); color:var(--text); border:1px solid var(--border); border-radius:8px; padding:8px 12px; font-size:13px; font-weight:700; min-width:220px; }
  .bif-periodo { display:flex; align-items:center; gap:6px; font-size:12px; color:#8899AA; }
  .bif-periodo input { background:var(--bg-card); color:var(--text); border:1px solid var(--border); border-radius:6px; padding:5px 8px; font-size:12px; }

  /* TABS */
  .bif-tabs { display:flex; flex-wrap:wrap; gap:4px; border-bottom:1px solid var(--border); margin-bottom:18px; }
  .bif-tab { padding:10px 14px; background:transparent; color:#8899AA; border:none; cursor:pointer; font-size:13px; font-weight:600; border-bottom:2px solid transparent; transition:all .15s; }
  .bif-tab:hover { color:var(--text); }
  .bif-tab.active { color:#4F8CFF; border-bottom-color:#4F8CFF; }
  .bif-pane { display:none; animation: fade .2s; }
  .bif-pane.active { display:block; }
  @keyframes fade { from{opacity:0;transform:translateY(4px)} to{opacity:1;transform:none} }

  /* KPI CARDS */
  .bif-kpi-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap:14px; margin-bottom:22px; }
  .bif-kpi { background:linear-gradient(135deg,#0F1420,#171c2e); border:1px solid var(--border); border-radius:12px; padding:14px 16px; }
  .bif-kpi .lbl { font-size:11px; color:#8899AA; text-transform:uppercase; letter-spacing:.5px; margin-bottom:6px; font-weight:700; }
  .bif-kpi .val { font-size:1.5rem; font-weight:800; }
  .bif-kpi .sub { font-size:11px; color:#8899AA; margin-top:4px; }
  .bif-kpi.ok { border-color:#22C55E40; }
  .bif-kpi.ok .val { color:#22C55E; }
  .bif-kpi.warn { border-color:#F59E0B40; }
  .bif-kpi.warn .val { color:#F59E0B; }
  .bif-kpi.bad { border-color:#EF444440; }
  .bif-kpi.bad .val { color:#EF4444; }
  .bif-kpi.info { border-color:#4F8CFF40; }
  .bif-kpi.info .val { color:#4F8CFF; }

  /* CARDS / SECTIONS */
  .bif-card { background:#0F1420; border:1px solid var(--border); border-radius:12px; padding:16px; margin-bottom:16px; }
  .bif-card h3 { font-size:1rem; margin-bottom:12px; display:flex; align-items:center; gap:8px; }

  /* TABELAS */
  .bif-table { width:100%; border-collapse:collapse; font-size:12.5px; }
  .bif-table th { background:#171c2e; color:#8899AA; text-align:left; padding:9px 10px; font-weight:700; text-transform:uppercase; font-size:10.5px; letter-spacing:.4px; border-bottom:1px solid var(--border); }
  .bif-table td { padding:8px 10px; border-bottom:1px solid #1a1f35; vertical-align:middle; }
  .bif-table tr:hover td { background:#11172a; }
  .bif-table input, .bif-table select { background:var(--bg-card); color:var(--text); border:1px solid var(--border); border-radius:6px; padding:5px 7px; font-size:12px; width:100%; min-width:60px; }
  .bif-table input[type=number] { text-align:right; }
  .bif-table input:focus, .bif-table select:focus { outline:none; border-color:#4F8CFF; box-shadow:0 0 0 2px #4F8CFF22; }
  .bif-table .col-act { width:90px; text-align:right; white-space:nowrap; }
  .bif-table .col-num { text-align:right; }

  /* BOTÕES */
  .bif-btn { background:#1a1f35; color:#fff; border:1px solid var(--border); border-radius:8px; padding:7px 14px; font-size:12px; font-weight:700; cursor:pointer; transition:all .15s; display:inline-flex; align-items:center; gap:6px; }
  .bif-btn:hover { background:#22293f; border-color:#4F8CFF; }
  .bif-btn.primary { background:linear-gradient(135deg,#4F8CFF,#3B6FE0); border-color:#4F8CFF; color:#fff; }
  .bif-btn.primary:hover { background:linear-gradient(135deg,#3B6FE0,#2D5FCE); }
  .bif-btn.success { background:linear-gradient(135deg,#22C55E,#16A34A); border-color:#22C55E; color:#fff; }
  .bif-btn.danger { background:#3a1a1a; border-color:#EF4444; color:#EF4444; }
  .bif-btn.danger:hover { background:#EF4444; color:#fff; }
  .bif-btn.ghost { background:transparent; }
  .bif-btn.sm { padding:4px 8px; font-size:11px; }
  .bif-toolbar { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:12px; align-items:center; }
  .bif-toolbar .grow { flex:1; }

  /* STATUS PILLS */
  .bif-pill { display:inline-block; padding:2px 8px; border-radius:10px; font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.3px; }
  .bif-pill.ok { background:#22C55E22; color:#22C55E; }
  .bif-pill.warn { background:#F59E0B22; color:#F59E0B; }
  .bif-pill.bad { background:#EF444422; color:#EF4444; }
  .bif-pill.info { background:#4F8CFF22; color:#4F8CFF; }
  .bif-pill.muted { background:#30363D44; color:#8899AA; }

  /* GRIDS */
  .bif-grid-2 { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .bif-grid-3 { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  @media (max-width: 900px){ .bif-grid-2,.bif-grid-3 { grid-template-columns:1fr; } }

  /* FORM */
  .bif-form-row { display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:10px; margin-bottom:12px; }
  .bif-form-row label { font-size:11px; color:#8899AA; text-transform:uppercase; font-weight:700; display:block; margin-bottom:4px; }
  .bif-form-row input, .bif-form-row select, .bif-form-row textarea { background:var(--bg-card); color:var(--text); border:1px solid var(--border); border-radius:6px; padding:8px 10px; font-size:13px; width:100%; box-sizing:border-box; }
  .bif-form-row textarea { min-height:60px; resize:vertical; }

  /* ALERT BOX */
  .bif-alert { padding:10px 14px; border-radius:10px; margin-bottom:8px; display:flex; align-items:flex-start; gap:10px; font-size:12.5px; }
  .bif-alert.bad { background:#3a1a1a; border:1px solid #EF4444; color:#fca5a5; }
  .bif-alert.warn { background:#3a2a14; border:1px solid #F59E0B; color:#fcd34d; }
  .bif-alert.info { background:#1a2a3a; border:1px solid #4F8CFF; color:#93c5fd; }
  .bif-alert.ok { background:#1a3a24; border:1px solid #22C55E; color:#86efac; }
  .bif-alert .ico { font-size:18px; }

  /* DRE table */
  .bif-dre { width:100%; border-collapse:collapse; font-size:13px; }
  .bif-dre td { padding:8px 12px; border-bottom:1px solid #1a1f35; }
  .bif-dre .lbl { color:#8899AA; }
  .bif-dre .val { text-align:right; font-weight:700; color:var(--text); font-variant-numeric:tabular-nums; }
  .bif-dre .grupo td { background:#171c2e; font-weight:800; color:#4F8CFF; text-transform:uppercase; font-size:11px; letter-spacing:.5px; }
  .bif-dre .total td { background:#1a2a3a; font-weight:800; }
  .bif-dre .pct { color:#8899AA; font-size:11px; margin-left:6px; }

  /* simulador */
  .bif-sim-grid { display:grid; grid-template-columns:1.1fr .9fr; gap:16px; }
  @media(max-width:1000px){ .bif-sim-grid{grid-template-columns:1fr;} }
  .bif-slider-row { display:grid; grid-template-columns: 1fr 80px; gap:8px; align-items:center; margin-bottom:10px; }
  .bif-slider-row label { font-size:12px; color:#8899AA; }
  .bif-slider-row .val { color:#4F8CFF; font-weight:800; text-align:right; font-variant-numeric:tabular-nums; }
  .bif-slider-row input[type=range] { width:100%; }

  /* charts container */
  .bif-chart-box { position:relative; height:280px; }

  /* ranking */
  .bif-rank-row { display:grid; grid-template-columns: 30px 1fr auto; gap:8px; padding:8px 10px; border-bottom:1px solid #1a1f35; font-size:13px; align-items:center; }
  .bif-rank-row .pos { font-weight:800; color:#4F8CFF; }
  .bif-rank-row .nm { font-weight:700; }
  .bif-rank-row .vl { font-variant-numeric:tabular-nums; font-weight:700; }

  /* badge */
  .bif-badge-empresa { display:inline-block; background:#4F8CFF22; color:#4F8CFF; padding:2px 8px; border-radius:8px; font-size:10.5px; font-weight:700; margin-left:6px; }

  /* empty state */
  .bif-empty { padding:30px 20px; text-align:center; color:#8899AA; font-size:13px; }
  .bif-empty .ico { font-size:32px; margin-bottom:10px; }

  /* modal */
  .bif-modal-bg { position:fixed; inset:0; background:rgba(0,0,0,.6); z-index:9998; display:none; align-items:center; justify-content:center; padding:20px; }
  .bif-modal-bg.show { display:flex; }
  .bif-modal { background:#0F1420; border:1px solid var(--border); border-radius:14px; max-width:560px; width:100%; max-height:90vh; overflow-y:auto; padding:22px; }
  .bif-modal h2 { margin-bottom:14px; font-size:1.1rem; }
  .bif-modal .actions { display:flex; gap:8px; justify-content:flex-end; margin-top:18px; }
</style>

<main class="bif-root">

  <!-- ============ TOPBAR ============ -->
  <div class="bif-topbar">
    <h1>💰 BI Financeiro Multiempresa</h1>
    <div class="bif-empresa-sel">
      <span class="muted" style="font-size:11px;font-weight:700">EMPRESA:</span>
      <select id="bifEmpresaSel" onchange="BIF.setEmpresa(this.value)"></select>
    </div>
    <div class="bif-periodo">
      <span>Período:</span>
      <input type="month" id="bifPeriodo" onchange="BIF.setPeriodo(this.value)">
      <button class="bif-btn sm ghost" onclick="BIF.setPeriodo('')" title="Mostrar todos os períodos">×</button>
    </div>
    <div class="sep"></div>
    <span id="bifSyncBadge" class="bif-pill muted" style="font-size:10.5px;display:none" title="Status de sincronização com servidor"></span>
    <button class="bif-btn ghost sm" onclick="window.BIF_resyncFromServer()" title="Recarregar do servidor (descarta alterações locais não sincronizadas)">🔄 Recarregar</button>
    <button class="bif-btn ghost sm" onclick="BIF.exportJSON()" title="Backup completo dos dados">⬇️ JSON</button>
    <button class="bif-btn ghost sm" onclick="document.getElementById('bifImportFile').click()" title="Importar backup">⬆️ JSON</button>
    <input type="file" id="bifImportFile" accept=".json" style="display:none" onchange="BIF.importJSON(event)">
    <button class="bif-btn ghost sm" onclick="BIF.exportCSV()" title="Exportar receitas e produtos em CSV">📊 CSV</button>
  </div>

  <!-- ============ TABS ============ -->
  <div class="bif-tabs" id="bifTabs">
    <button class="bif-tab active" data-tab="ceo" style="color:#F0C040;font-weight:800">👔 CEO</button>
    <button class="bif-tab" data-tab="visao">📊 Visão Geral</button>
    <button class="bif-tab" data-tab="empresas">🏢 Empresas</button>
    <button class="bif-tab" data-tab="produtos">📦 Produtos</button>
    <button class="bif-tab" data-tab="vendas-zoho" style="color:#22C55E;font-weight:800">🛒 Vendas Zoho</button>
    <button class="bif-tab" data-tab="relatorios-zoho" style="color:#4F8CFF;font-weight:800">📊 Relatórios Zoho</button>
    <button class="bif-tab" data-tab="receitas">💵 Receitas</button>
    <button class="bif-tab" data-tab="custos-fixos">📌 Custos Fixos</button>
    <button class="bif-tab" data-tab="custos-var">📉 Custos Variáveis</button>
    <button class="bif-tab" data-tab="dre">📑 DRE</button>
    <button class="bif-tab" data-tab="caixa">💸 Fluxo de Caixa</button>
    <button class="bif-tab" data-tab="break-even">⚖️ Break-even</button>
    <button class="bif-tab" data-tab="simulador">🎲 Simulador</button>
    <button class="bif-tab" data-tab="cap">📤 Contas a Pagar (simples)</button>
    <button class="bif-tab" data-tab="recebimentos" style="color:#22C55E;font-weight:800">📥 Recebimentos</button>
    <button class="bif-tab" data-tab="pagamentos" style="color:#22C55E;font-weight:800">💸 Pagamentos (Workflow)</button>
    <button class="bif-tab" data-tab="aprovacoes" style="color:#F59E0B;font-weight:800">✅ Aprovações</button>
    <button class="bif-tab" data-tab="bancos" style="color:#4F8CFF;font-weight:800">🏦 Bancos</button>
    <button class="bif-tab" data-tab="extratos">📒 Extratos</button>
    <button class="bif-tab" data-tab="conciliacao" style="color:#a371f7;font-weight:800">🔁 Conciliação</button>
    <button class="bif-tab" data-tab="aprovadores">👥 Aprovadores</button>
    <button class="bif-tab" data-tab="fornecedores" style="color:#22C55E;font-weight:800">🏪 Fornecedores</button>
    <button class="bif-tab" data-tab="estoque" style="color:#a371f7;font-weight:800">🏭 Estoque</button>
    <button class="bif-tab" data-tab="logistica" style="color:#22C55E;font-weight:800">🚛 Logística</button>
    <button class="bif-tab" data-tab="nf-entrada" style="color:#F59E0B;font-weight:800">📨 NF-e Entrada</button>
    <button class="bif-tab" data-tab="compras" style="color:#EC4899;font-weight:800">🛒 Compras</button>
    <button class="bif-tab" data-tab="os-materiais" style="color:#10B981;font-weight:800">🔧 OS Materiais</button>
    <button class="bif-tab" data-tab="auditoria">📜 Auditoria</button>
    <button class="bif-tab" data-tab="car">📥 Contas a Receber</button>
    <button class="bif-tab" data-tab="alertas">🚨 Alertas</button>
    <button class="bif-tab" data-tab="config">⚙️ Configurações</button>
    <button class="bif-tab" data-tab="tutorial" style="color:#a371f7;font-weight:800">📖 Tutorial</button>
  </div>

  <!-- ============ DASHBOARD CEO ============ -->
  <section class="bif-pane active" id="pane-ceo">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">
      <h2 style="font-size:1.4rem">👔 Dashboard CEO</h2>
      <span class="muted" style="font-size:11px;font-weight:700;text-transform:uppercase" id="bifCeoTimestamp"></span>
      <div style="flex:1"></div>
    </div>

    <!-- Barra de filtros: presets + range picker + comparar -->
    <div class="bif-card" style="margin-bottom:14px;padding:12px">
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap">
        <span class="muted" style="font-size:11px;font-weight:700;text-transform:uppercase">Período:</span>
        <button class="bif-btn ghost sm" onclick="BIF.ceoPreset('hoje')" id="bifCeoPresetHoje">Hoje</button>
        <button class="bif-btn ghost sm" onclick="BIF.ceoPreset('7d')" id="bifCeoPreset7d">Últimos 7 dias</button>
        <button class="bif-btn ghost sm" onclick="BIF.ceoPreset('30d')" id="bifCeoPreset30d">Últimos 30 dias</button>
        <button class="bif-btn ghost sm" onclick="BIF.ceoPreset('mesAtual')" id="bifCeoPresetMesAtual">Mês atual</button>
        <button class="bif-btn ghost sm" onclick="BIF.ceoPreset('mesPassado')" id="bifCeoPresetMesPassado">Mês passado</button>
        <button class="bif-btn ghost sm" onclick="BIF.ceoPreset('anoAtual')" id="bifCeoPresetAnoAtual">Ano atual</button>
        <span style="display:flex;align-items:center;gap:6px;margin-left:8px">
          <span class="muted" style="font-size:11px">📅</span>
          <input type="text" id="bifCeoRangePicker" placeholder="customizado" style="background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:6px 10px;font-size:12px;min-width:220px;cursor:pointer" readonly>
        </span>
        <span class="muted" style="font-size:11px;margin-left:8px;display:flex;align-items:center;gap:4px">
          <input type="checkbox" id="bifCeoCompareCheck" checked onchange="BIF.ceoReload()"> comparar com período anterior
        </span>
        <div style="flex:1"></div>
        <span class="muted" style="font-size:11px" id="bifCeoPeriodoTxt"></span>
        <button class="bif-btn ghost sm" onclick="BIF.ceoReload()">🔄</button>
      </div>
    </div>

    <div id="bifCeoAlertas"></div>
    <div class="bif-kpi-grid" id="bifCeoKpis" style="grid-template-columns:repeat(auto-fill,minmax(220px,1fr))"></div>

    <div class="bif-grid-2" style="margin-top:14px">
      <div class="bif-card">
        <h3>🏦 Saldo nas contas bancárias</h3>
        <div id="bifCeoBancos"></div>
      </div>
      <div class="bif-card">
        <h3>💸 Cronograma de pagamentos</h3>
        <table class="bif-dre" id="bifCeoCronoPg"></table>
      </div>
    </div>

    <div class="bif-grid-2" style="margin-top:14px">
      <div class="bif-card">
        <h3>🏆 Top vendas (lucro real) <span class="muted" style="font-size:11px;font-weight:400">— click pra abrir ficha</span></h3>
        <div id="bifCeoTopVendas"></div>
      </div>
      <div class="bif-card">
        <h3>🔴 Piores vendas (prejuízo)</h3>
        <div id="bifCeoPioresVendas"></div>
      </div>
    </div>

    <div class="bif-card" style="margin-top:14px">
      <div style="display:flex;align-items:center;gap:10px">
        <h3 style="margin:0">📋 Todas as vendas do período</h3>
        <span class="muted" style="font-size:11px" id="bifCeoListaResumo"></span>
        <div style="flex:1"></div>
        <button class="bif-btn ghost sm" onclick="BIF.ceoToggleListaCompleta()" id="bifCeoListaToggleBtn">▾ Mostrar lista completa</button>
      </div>
      <div id="bifCeoListaCompleta" style="display:none;margin-top:12px;max-height:500px;overflow-y:auto"></div>
    </div>
  </section>

  <!-- ============ VISÃO GERAL ============ -->
  <section class="bif-pane" id="pane-visao">
    <div style="display:flex;justify-content:flex-end;margin-bottom:8px">
      <button class="bif-btn ghost sm" onclick="BIF.pdfDemonstrativo()">📄 Exportar Demonstrativo PDF</button>
    </div>
    <div class="bif-kpi-grid" id="bifKpis"></div>

    <div class="bif-grid-2">
      <div class="bif-card">
        <h3>📈 Receita × Despesa (últimos 6 meses)</h3>
        <div class="bif-chart-box"><canvas id="bifChartRecDesp"></canvas></div>
      </div>
      <div class="bif-card">
        <h3>🥧 Composição de despesas</h3>

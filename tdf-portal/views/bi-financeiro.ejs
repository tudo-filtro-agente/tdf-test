    if (list.length === 0) {
      tb.innerHTML = `<tr><td colspan="15" class="bif-empty"><div class="ico">📦</div>Nenhum produto neste escopo.</td></tr>`;
      document.getElementById('bifProdutosTfoot').innerHTML = '';
      BIF._bulkUpdateBar('produtos');
      return;
    }
    tb.innerHTML = list.map(p => {
      const c = calcProduto(p);
      const margClass = c.margemContrib < 0 ? 'bad' : c.margemContrib < 0.15 ? 'warn' : 'ok';
      return `<tr data-id="${p.id}">
        ${BIF._bulkCellCheckbox('produtos', p.id)}
        <td>${selectCompanyCell(p.companyId, `BIF.editField('produtos','${p.id}','companyId',this.value)`)}</td>

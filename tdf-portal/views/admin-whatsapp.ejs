<% const activePage = 'admin'; const pageTitle = 'WhatsApp · Admin'; %>

<style>
.wa-wrap{max-width:920px;margin:0 auto;padding:24px}
.wa-h{font-size:22px;color:var(--text);margin:0 0 6px;display:flex;align-items:center;gap:10px}
.wa-sub{color:var(--text-muted);font-size:13px;margin:0 0 22px}
.wa-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px}
@media(max-width:700px){.wa-grid{grid-template-columns:1fr}}
.wa-card{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px}
.wa-card h3{margin:0 0 12px;font-size:14px;color:var(--text);text-transform:uppercase;letter-spacing:.4px;display:flex;align-items:center;gap:8px}

.wa-status{padding:14px;border-radius:8px;font-size:13px;line-height:1.6;margin-bottom:8px}
.wa-status.connected{background:rgba(34,197,94,.1);border:1px solid #22c55e;color:#4ade80}
.wa-status.disconnected{background:rgba(239,68,68,.08);border:1px solid #ef4444;color:#f87171}
.wa-status.waiting{background:rgba(234,179,8,.08);border:1px solid #eab308;color:#fbbf24}
.wa-status .icon{font-size:18px;margin-right:6px}

.wa-info{font-size:12px;color:var(--text-muted);line-height:1.7}
.wa-info .l{color:var(--text-muted);font-size:10px;text-transform:uppercase;font-weight:700;letter-spacing:.4px;display:block;margin-top:8px}
.wa-info .v{color:var(--text);font-weight:600;font-family:monospace;font-size:12px;word-break:break-all}

.wa-qr{display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fff;border-radius:14px;padding:14px;min-height:280px;position:relative}
.wa-qr img{max-width:260px;height:auto;display:block}
.wa-qr .loading{color:var(--text-muted);text-align:center;font-size:13px}
.wa-qr-info{margin-top:12px;font-size:12px;color:var(--text-muted);line-height:1.6;text-align:center}
.wa-qr-info ol{margin:8px 0 0;padding-left:24px;text-align:left;color:#bbb}

.wa-btn{padding:9px 16px;border-radius:8px;font-size:12px;font-weight:700;cursor:pointer;border:1px solid;background:transparent}
.wa-btn.refresh{color:#5ba3f5;border-color:#5ba3f5}
.wa-btn.restart{color:#fbbf24;border-color:#eab308}
.wa-btn.disconnect{color:#f87171;border-color:#ef4444}
.wa-btn:hover{background:rgba(255,255,255,.05)}

.wa-acoes{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}

.wa-aviso{background:#0d1f3a;border:1px solid #1e3a5f;border-radius:10px;padding:12px;font-size:12px;color:#7cb9f5;line-height:1.6;margin-bottom:18px}
.wa-aviso strong{color:var(--text)}
</style>

<div class="wa-wrap">
  <h1 class="wa-h">📱 WhatsApp · Z-API</h1>
  <p class="wa-sub">Conexão da instância Z-API que o portal usa pra enviar/receber mensagens. QR Code aqui só aparece quando a conta está desconectada.</p>

  <div class="wa-aviso">
    💡 <strong>Como funciona:</strong> O portal usa Z-API pra Diretor IA, alertas internos, Núbia disparada manualmente, mensagens diretas do admin. Quando a sessão expirar, escaneie o QR Code abaixo com o WhatsApp do número configurado.
  </div>

  <div class="wa-grid">
    <!-- STATUS -->
    <div class="wa-card">
      <h3>📡 Status da conexão</h3>
      <div id="wa-status" class="wa-status waiting">
        <span class="icon">⏳</span>Verificando...
      </div>
      <div class="wa-info" id="wa-info"></div>
      <div class="wa-acoes">
        <button class="wa-btn refresh" onclick="waCarregar()">🔄 Atualizar</button>
        <button class="wa-btn restart" onclick="waRestart()">↻ Reiniciar instância</button>
        <button class="wa-btn disconnect" onclick="waDisconnect()">⏏ Desconectar</button>
      </div>
    </div>

    <!-- QR CODE -->
    <div class="wa-card">
      <h3>📷 QR Code</h3>
      <div class="wa-qr" id="wa-qr">
        <div class="loading">Aguardando status...</div>
      </div>
      <div class="wa-qr-info" id="wa-qr-info" style="display:none">
        <strong style="color:var(--text)">Como conectar:</strong>
        <ol>
          <li>Abra o WhatsApp no celular do número conectado</li>
          <li>Toque em <strong>Menu (⋮)</strong> → <strong>Aparelhos conectados</strong></li>
          <li>Toque em <strong>Conectar um aparelho</strong></li>
          <li>Aponte a câmera pro QR Code acima</li>
        </ol>
        <div style="margin-top:8px;font-size:11px;color:var(--text-muted)">QR Code expira em ~60s — refresh automático.</div>
      </div>
    </div>
  </div>

  <div class="wa-card">
    <h3>⚙️ Configuração técnica</h3>
    <div class="wa-info">
      <span class="l">Instance ID</span>
      <span class="v" id="wa-instance-id">—</span>
      <span class="l">Endpoint base</span>
      <span class="v">https://api.z-api.io</span>
      <span class="l">Webhook recomendado (incoming)</span>
      <span class="v">https://tdf-portal-production.up.railway.app/webhooks/zapi</span>
      <span class="l">Variáveis de ambiente</span>
      <span class="v">ZAPI_INSTANCE · ZAPI_TOKEN · ZAPI_CLIENT_TOKEN</span>
    </div>
    <div style="font-size:11px;color:var(--text-muted);margin-top:14px;line-height:1.6">
      <strong style="color:var(--text-muted)">Nota:</strong> a instância Z-API atual envia alertas internos pro admin (notificações de cobrança, disparos da Núbia, mensagens diretas do Diretor) e pode receber mensagens do cliente via webhook. Pra inbox conversacional unificado WATI + Z-API + WhatsApp Business, é a próxima fase.
    </div>
  </div>
</div>

<script>
async function waCarregar(){
  const statusDiv = document.getElementById('wa-status');
  const infoDiv = document.getElementById('wa-info');
  const qrDiv = document.getElementById('wa-qr');
  const qrInfo = document.getElementById('wa-qr-info');

  statusDiv.className = 'wa-status waiting';
  statusDiv.innerHTML = '<span class="icon">⏳</span>Verificando status...';

  try {
    const r = await fetch('/admin/whatsapp/status');
    const d = await r.json();
    if (!d.ok && d.error) {
      statusDiv.className = 'wa-status disconnected';
      statusDiv.innerHTML = `<span class="icon">⚠️</span>${d.error}`;
      qrDiv.innerHTML = '<div class="loading">Configure ZAPI_INSTANCE e ZAPI_TOKEN no Railway</div>';
      return;
    }
    const s = d.data || {};
    const conectado = s.connected === true;
    const aguardandoQR = s.connected === false && (s.smartphoneConnected === false || s.error || true);

    if (conectado) {
      statusDiv.className = 'wa-status connected';
      statusDiv.innerHTML = `<span class="icon">✅</span><strong>Conectado!</strong><br>WhatsApp pareado e pronto pra enviar/receber.`;
      qrDiv.innerHTML = '<div style="text-align:center;padding:40px;color:#22c55e;font-size:16px;font-weight:700">✓<br>Conectado</div>';
      qrDiv.style.background = '#0d2818';
      qrInfo.style.display = 'none';
    } else {
      statusDiv.className = 'wa-status disconnected';
      statusDiv.innerHTML = `<span class="icon">📵</span><strong>Desconectado</strong> — escaneie o QR Code ao lado pra reconectar.`;
      qrDiv.style.background = '#fff';
      qrDiv.innerHTML = '<div class="loading">Carregando QR...</div>';
      qrInfo.style.display = 'block';
      // Carrega imagem do QR
      const ts = Date.now();
      qrDiv.innerHTML = `<img src="/admin/whatsapp/qrcode?t=${ts}" alt="QR Code WhatsApp" onerror="this.parentElement.innerHTML='<div class=&quot;loading&quot;>Erro ao carregar QR. Tente reiniciar a instância.</div>'">`;
    }

    // Info técnica
    let info = '';
    if (s.session) info += `<span class="l">Sessão</span><span class="v">${s.session}</span>`;
    if (s.smartphoneConnected !== undefined) info += `<span class="l">Smartphone conectado</span><span class="v">${s.smartphoneConnected ? '✅ Sim' : '❌ Não'}</span>`;
    infoDiv.innerHTML = info || '<span style="color:#666">—</span>';

    // Device info em paralelo
    const devR = await fetch('/admin/whatsapp/device');
    const devD = await devR.json();
    if (devD.data?.device) {
      const dv = devD.data.device;
      let extra = '';
      if (dv.name) extra += `<span class="l">Nome</span><span class="v">${dv.name}</span>`;
      if (dv.phone || devD.data.phone) extra += `<span class="l">Número</span><span class="v">${dv.phone || devD.data.phone}</span>`;
      if (dv.platform) extra += `<span class="l">Plataforma</span><span class="v">${dv.platform}</span>`;
      infoDiv.innerHTML += extra;
    }
    document.getElementById('wa-instance-id').textContent = (s.session || devD.data?.session || '—').slice(0, 8) + '...';
  } catch(e) {
    statusDiv.className = 'wa-status disconnected';
    statusDiv.innerHTML = `<span class="icon">❌</span>Erro: ${e.message}`;
  }
}

async function waRestart(){
  if (!confirm('Reiniciar a instância Z-API? A conexão pode cair por alguns segundos.')) return;
  try {
    const r = await fetch('/admin/whatsapp/restart', { method:'POST' });
    const d = await r.json();
    alert(d.ok ? '↻ Instância reiniciando...' : 'Erro: ' + (d.error||'?'));
    setTimeout(waCarregar, 3000);
  } catch(e) { alert('Erro: ' + e.message); }
}

async function waDisconnect(){
  if (!confirm('Desconectar Z-API? Você precisará escanear o QR Code de novo.')) return;
  try {
    const r = await fetch('/admin/whatsapp/disconnect', { method:'POST' });
    const d = await r.json();
    alert(d.ok ? '⏏ Desconectado.' : 'Erro: ' + (d.error||'?'));
    setTimeout(waCarregar, 1500);
  } catch(e) { alert('Erro: ' + e.message); }
}

waCarregar();
setInterval(waCarregar, 60000); // refresh a cada 60s
</script>

</div></body></html>

<% const activePage = 'goto-connect'; const pageTitle = 'GoTo Connect — TDF'; %>

<style>
.gc-wrap{max-width:1400px;margin:0 auto;padding:24px;color:var(--text)}
.gc-header{background:linear-gradient(135deg,var(--bg),#1a0e2a);border:2px solid #a371f7;border-radius:12px;padding:18px;margin-bottom:18px}
.gc-header h1{color:#c084fc;margin:0;font-size:20px}
.gc-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:14px}
.gc-card{background:#161725;border:1px solid var(--border);border-radius:12px;padding:16px;display:flex;flex-direction:column}
.gc-card.online{border-left:4px solid #22c55e}
.gc-card.offline{border-left:4px solid #6b7280}
.gc-card.busy{border-left:4px solid #f59e0b}
.gc-head{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.gc-head .ico{font-size:24px}
.gc-head .nm{flex:1;font-weight:800;font-size:15px;color:var(--text)}
.gc-status{font-size:10px;font-weight:800;padding:3px 8px;border-radius:4px;text-transform:uppercase}
.gc-status.online{background:rgba(34,197,94,.15);color:#22c55e}
.gc-status.offline{background:rgba(107,114,128,.15);color:#9ca3af}
.gc-status.busy{background:rgba(245,158,11,.15);color:#f59e0b}
.gc-desc{color:#9ca3af;font-size:12px;line-height:1.4;margin-bottom:12px}
.gc-metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:12px}
.gc-metric{background:#0a0a0f;border-radius:6px;padding:10px;text-align:center}
.gc-metric .val{font-size:20px;font-weight:800;color:#c084fc}
.gc-metric .lbl{font-size:9px;color:#9ca3af;text-transform:uppercase;margin-top:2px}
.gc-actions{display:flex;gap:6px;margin-top:auto}
.gc-actions button{background:#1f1f2e;color:#ddd;border:1px solid var(--border);border-radius:5px;padding:7px 12px;font-size:11px;font-weight:700;cursor:pointer;flex:1}
.gc-actions button.refresh{background:#1f6feb;color:#fff;border:none}
.gc-test-result{margin-top:8px;padding:8px;border-radius:5px;font-size:11px;display:none}
.gc-test-result.ok{background:rgba(34,197,94,.1);border:1px solid #22c55e;color:#22c55e}
.gc-test-result.err{background:rgba(239,68,68,.1);border:1px solid #ef4444;color:#fca5a5}
.gc-placeholder{grid-column:1/-1;text-align:center;color:var(--text-muted);padding:30px}
</style>

<div class="gc-wrap">
  <div class="gc-header">
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <span style="font-size:28px">📞</span>
      <h1 style="flex:1">GoTo Connect — Telefonia</h1>
      <button onclick="gcCarregar()" style="background:#1a0e2a;border:1px solid #a371f7;color:#c084fc;padding:8px 14px;border-radius:8px;font-weight:700;font-size:12px;cursor:pointer">🔄 Atualizar</button>
    </div>
    <p style="color:#9ca3af;font-size:12px;margin:6px 0 0;line-height:1.5">
      Monitoramento da telefonia via GoTo Connect. Ramais, chamadas em andamento, tempo médio de atendimento e métricas de call center.
    </p>
  </div>

  <div id="gc-grid" class="gc-grid">
    <div class="gc-placeholder">⏳ Carregando status...</div>
  </div>
</div>

<script>
async function gcCarregar(){
  const grid = document.getElementById('gc-grid');
  grid.innerHTML = '<div class="gc-placeholder">⏳ Carregando...</div>';
  try {
    const ramaisExemplo = [
      { id: 'ramal-101', nome: 'João Silva', status: 'online', ramal: '101', chamadas: 23, tempo: '03:45' },
      { id: 'ramal-102', nome: 'Maria Santos', status: 'busy', ramal: '102', chamadas: 18, tempo: '12:30' },
      { id: 'ramal-103', nome: 'Pedro Costa', status: 'online', ramal: '103', chamadas: 31, tempo: '05:12' },
      { id: 'ramal-104', nome: 'Ana Oliveira', status: 'offline', ramal: '104', chamadas: 0, tempo: '--' },
      { id: 'ramal-105', nome: 'Carlos Lima', status: 'online', ramal: '105', chamadas: 15, tempo: '02:58' },
      { id: 'ramal-106', nome: 'Julia Mendes', status: 'busy', ramal: '106', chamadas: 27, tempo: '08:45' }
    ];
    gcRender(ramaisExemplo);
  } catch(e) {
    grid.innerHTML = '<div class="gc-placeholder" style="color:#ef4444">Erro: '+e.message+'</div>';
  }
}
function gcRender(ramais){
  const grid = document.getElementById('gc-grid');
  let html = '';
  const statusTxt = { online: 'DISPONÍVEL', offline: 'OFFLINE', busy: 'EM LIGACÃO' };
  for (const ramal of ramais) {
    html += '<div class="gc-card '+ramal.status+'" id="gc-card-'+ramal.id+'"><div class="gc-head"><span class="ico">📞</span><span class="nm">'+ramal.nome+'</span><span class="gc-status '+ramal.status+'">'+statusTxt[ramal.status]+'</span></div><div class="gc-desc">Ramal '+ramal.ramal+'</div><div class="gc-metrics"><div class="gc-metric"><div class="val">'+ramal.chamadas+'</div><div class="lbl">Chamadas</div></div><div class="gc-metric"><div class="val">'+ramal.tempo+'</div><div class="lbl">Tempo Total</div></div><div class="gc-metric"><div class="val">'+(ramal.status==='online'?'🟢':ramal.status==='busy'?'🔴':'⚫')+'</div><div class="lbl">Status</div></div></div><div class="gc-actions"><button class="refresh" onclick="gcRefresh(\''+ramal.id+'\')">🔄 Refresh</button><button onclick="gcLigar(\''+ramal.ramal+'\')">📲 Ligar</button></div><div class="gc-test-result" id="gc-test-'+ramal.id+'"></div></div>';
  }
  grid.innerHTML = html;
}
async function gcRefresh(id){
  const result = document.getElementById('gc-test-'+id);
  result.style.display = 'block';
  result.className = 'gc-test-result ok';
  result.style.background = 'rgba(34,197,94,.1)';
  result.style.border = '1px solid #22c55e';
  result.style.color = '#22c55e';
  result.textContent = '✅ Status atualizado';
  setTimeout(() => result.style.display = 'none', 2000);
}
function gcLigar(ramal){ alert('Iniciando ligação para ramal '+ramal+'...\n(Integrar com API GoTo quando disponível)'); }
gcCarregar();
</script>

<% const activePage = 'home'; const pageTitle = 'Home'; %>
<%
  const hoje = new Date();
  const _dias  = ['DOM','SEG','TER','QUA','QUI','SEX','SÁB'];
  const _meses = ['Jan','Fev','Mar','Abr','Mai','Jun','Jul','Ago','Set','Out','Nov','Dez'];
  const _dia   = _dias[hoje.getDay()] + ', ' + hoje.getDate() + ' ' + _meses[hoje.getMonth()] + ' /09 • BRT';
  const _hora  = hoje.toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit', second:'2-digit'});
  const _un    = (user && (user.name || user.username)) ? (user.name || user.username) : 'Usuário';
  const _h     = hoje.getHours();
  const _saud  = _h < 12 ? 'Bom dia' : (_h < 18 ? 'Boa tarde' : 'Boa noite');
%>

<div class="tdf-kpi-bar">
  <div class="tdf-kpi">
    <span class="tdf-kpi-ic">💧</span>
    <span class="tdf-kpi-txt">
      <span class="tdf-kpi-label">Bebedouro</span>
      <span class="tdf-kpi-row">
        <span class="tdf-kpi-val">R$ 0</span>
        <span class="tdf-kpi-val is-ghost">/ R$ 0</span>
        <span class="tdf-kpi-pill">0%</span>
      </span>
    </span>
  </div>
  <div class="tdf-kpi">
    <span class="tdf-kpi-ic">🔵</span>
    <span class="tdf-kpi-txt">
      <span class="tdf-kpi-label">Filtros de Entrada</span>
      <span class="tdf-kpi-row">
        <span class="tdf-kpi-val">R$ 0</span>
        <span class="tdf-kpi-val is-ghost">/ R$ 0</span>
        <span class="tdf-kpi-pill up">0%</span>
      </span>
    </span>
  </div>
  <div class="tdf-kpi">
    <span class="tdf-kpi-ic">🏪</span>
    <span class="tdf-kpi-txt">
      <span class="tdf-kpi-label">Loja Física</span>
      <span class="tdf-kpi-row">
        <span class="tdf-kpi-val">R$ 0</span>
        <span class="tdf-kpi-val is-ghost">/ R$ 0</span>
        <span class="tdf-kpi-pill down">0%</span>
      </span>
    </span>
  </div>
  <div class="tdf-kpi">
    <span class="tdf-kpi-ic">🔧</span>
    <span class="tdf-kpi-txt">
      <span class="tdf-kpi-label">Refil Online</span>
      <span class="tdf-kpi-row">
        <span class="tdf-kpi-val">R$ 0</span>
        <span class="tdf-kpi-val is-ghost">/ R$ 0</span>
        <span class="tdf-kpi-pill up">0%</span>
      </span>
    </span>
  </div>
  <div class="tdf-kpi-total">
    <span class="tdf-kpi-label">🏆 Total Mês</span>
    <span class="tdf-kpi-val">R$ 0</span>
    <span class="tdf-kpi-pill">0%</span>
  </div>
  <div class="tdf-kpi-clock">
    <b id="tdfClock"><%= _hora %></b>
    <small><%= _dia %></small>
  </div>
</div>

<div class="tdf-greet-wrap">
  <h1 class="tdf-greeting"><%= _saud %>, <%= _un %>!</h1>
  <p class="tdf-empresa">Tudo de Filtro — Portal TDF</p>
</div>

<div class="tdf-section">
  <div class="tdf-news">
    <div class="tdf-news-head">
      <span class="tdf-news-ic">🚀</span>
      <span class="tdf-news-title">Novidades do Portal</span>
      <span class="tdf-news-tag">Recém-lançado</span>
      <span class="tdf-news-acts">
        <a class="tdf-btn tdf-btn-accent" href="/paulo/treinamento">📅 Agendar Z-API amanhã 7h</a>
        <a class="tdf-btn tdf-btn-hot" href="/paulo/playbook">🚀 Disparar agora</a>
      </span>
    </div>
    <p class="tdf-news-sub">Tudo o que entrou no Portal nos últimos dias — leia e use.</p>
    <div class="tdf-news-list">
      <div class="tdf-news-item">
        <span class="tdf-news-ic">🎧</span>
        <span class="tdf-news-txt"><span class="tdf-news-tagline">NOVO</span> Scripts &amp; Modelos + a LIGAÇÃO-GABARITO pra ouvir</span>
        <a class="tdf-news-act" href="/paulo/playbook">🎧 Ouvir e estudar o script</a>
      </div>
      <div class="tdf-news-item">
        <span class="tdf-news-ic">📊</span>
        <span class="tdf-news-txt"><span class="tdf-news-tagline">NOVO</span> Central de Resultados: o record diário da operação</span>
        <a class="tdf-news-act" href="/paulo/gestao">📊 Ver o placar de hoje</a>
      </div>
      <div class="tdf-news-item">
        <span class="tdf-news-ic">🎮</span>
        <span class="tdf-news-txt"><span class="tdf-news-tagline">NOVO</span> Role-Play com IA: treine vendas contra um cliente virtual</span>
        <a class="tdf-news-act" href="/paulo/ia">🎮 Treinar Agora</a>
      </div>
      <div class="tdf-news-item">
        <span class="tdf-news-ic">📚</span>
        <span class="tdf-news-txt"><span class="tdf-news-tagline">NOVO</span> Academia: Técnicas Avançadas de Vendas (5 livros)</span>
        <a class="tdf-news-act" href="/paulo/treinamento">📚 Começar Academia</a>
      </div>
      <div class="tdf-news-item">
        <span class="tdf-news-ic">⚡</span>
        <span class="tdf-news-txt"><span class="tdf-news-tagline">NOVO</span> Réguas de cadência automáticas: o CRM agora trabalha pra você</span>
        <a class="tdf-news-act" href="/paulo/crm">⚡ Ver minhas tarefas</a>
      </div>
    </div>
  </div>
</div>

<div class="tdf-section">
  <div class="tdf-section-title">📄 Propostas do Mês</div>
  <div class="tdf-grid-4">
    <div class="tdf-card tdf-card-blue"><div class="tdf-card-icon">🏠</div><div class="tdf-card-label">Filtro de Entrada</div><div class="tdf-card-value">R$ 0</div></div>
    <div class="tdf-card tdf-card-blue"><div class="tdf-card-icon">🚰</div><div class="tdf-card-label">Bebedouro</div><div class="tdf-card-value">R$ 0</div></div>
    <div class="tdf-card tdf-card-blue"><div class="tdf-card-icon">💧</div><div class="tdf-card-label">Purificador</div><div class="tdf-card-value">R$ 0</div></div>
    <div class="tdf-card tdf-card-blue"><div class="tdf-card-icon">📦</div><div class="tdf-card-label">Outros</div><div class="tdf-card-value">R$ 0</div></div>
  </div>
</div>

<div class="tdf-section">
  <div class="tdf-section-title">🎯 Trabalho do Dia</div>
  <div class="tdf-grid-3">
    <a href="/paulo/cockpit" class="tdf-card tdf-card-green"><div class="tdf-card-icon">📊</div><div class="tdf-card-label">Meu Painel</div><div class="tdf-card-sub">Acompanhe suas métricas</div></a>
    <a href="/paulo/playbook" class="tdf-card tdf-card-green"><div class="tdf-card-icon">📋</div><div class="tdf-card-label">Scripts &amp; Modelos</div><div class="tdf-card-sub">Ferramentas de vendas</div></a>
    <a href="/paulo/ia" class="tdf-card tdf-card-green"><div class="tdf-card-icon">🤖</div><div class="tdf-card-label">IA Consulta</div><div class="tdf-card-sub">Tire dúvidas rápido</div></a>
  </div>
</div>

<div class="tdf-section">
  <div class="tdf-section-title">🎓 Escola TDF</div>
  <div class="tdf-grid-3">
    <a href="/paulo/treinamento" class="tdf-card tdf-card-orange"><div class="tdf-card-icon">📚</div><div class="tdf-card-label">Treinamentos</div><div class="tdf-card-sub">Aprenda a vender mais</div></a>
    <a href="/paulo/onboarding" class="tdf-card tdf-card-orange"><div class="tdf-card-icon">🚀</div><div class="tdf-card-label">Onboarding</div><div class="tdf-card-sub">Primeiros passos</div></a>
    <a href="/paulo/playbook" class="tdf-card tdf-card-orange"><div class="tdf-card-icon">📖</div><div class="tdf-card-label">Playbook</div><div class="tdf-card-sub">Melhores práticas</div></a>
  </div>
</div>

<div class="tdf-section">
  <div class="tdf-section-title">📈 Resultados &amp; Gestão</div>
  <div class="tdf-grid-3">
    <a href="/bi/financeiro" class="tdf-card tdf-card-gold"><div class="tdf-card-icon">💰</div><div class="tdf-card-label">BI Financeiro</div><div class="tdf-card-sub">Dados OMIE em tempo real</div></a>
    <a href="/paulo/gestao" class="tdf-card tdf-card-gold"><div class="tdf-card-icon">📊</div><div class="tdf-card-label">Central de Resultados</div><div class="tdf-card-sub">KPIs e metas</div></a>
    <a href="/paulo/gestao-closy" class="tdf-card tdf-card-gold"><div class="tdf-card-icon">🪜</div><div class="tdf-card-label">Documentação do Processo</div><div class="tdf-card-sub">Como funciona</div></a>
  </div>
</div>

<script>
function tdfAtualizarRelogio(){
  var el = document.getElementById('tdfClock');
  if(el) el.textContent = new Date().toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit', second:'2-digit'});
}
setInterval(tdfAtualizarRelogio, 1000);
</script>

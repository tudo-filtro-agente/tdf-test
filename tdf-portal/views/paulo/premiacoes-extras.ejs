<% const activePage = 'premiacoes-extras'; const pageTitle = 'Premiações Extras — TDF'; %>

<style>
.metas-wrap{max-width:1200px;margin:0 auto;padding:24px;color:var(--text)}
.metas-header{background:linear-gradient(135deg,var(--bg),#1a0e2a);border:2px solid #a371f7;border-radius:12px;padding:18px;margin-bottom:18px}
.metas-header h1{color:#c084fc;margin:0;font-size:20px}
.metas-header p{color:#9ca3af;font-size:12px;margin:6px 0 0;line-height:1.5}
.metas-card{background:#161725;border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:14px}
.metas-placeholder{text-align:center;color:var(--text-muted);padding:60px 20px}
.metas-placeholder .ico{font-size:48px;margin-bottom:12px;opacity:.5}
.metas-placeholder p{font-size:14px}
</style>

<div class="metas-wrap">
  <div class="metas-header">
    <div style="display:flex;align-items:center;gap:10px">
      <span style="font-size:28px">🏆</span>
      <h1>Premiações Extras</h1>
    </div>
    <p>Premiações especiais e bonificações fora do programa padrão.</p>
  </div>

  <div class="metas-card">
    <div class="metas-placeholder">
      <div class="ico">🏆</div>
      <p>Em breve — listagem de premiações extras</p>
    </div>
  </div>
</div>

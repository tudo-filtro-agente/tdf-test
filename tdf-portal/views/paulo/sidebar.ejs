  </nav>

  <!-- RODAPÉ: perfil + ações -->
  <div class="tsb-foot">
    <a class="tsb-foot-link <%= isA('meu-perfil') %>" href="/paulo/meu-perfil" title="Meu perfil">
      <span class="tsb-avatar"><%= _inicial %></span>
      <span class="tsb-foot-name"><b><%= user.name || user.username %></b><small>Ver perfil</small></span>
    </a>
    <div class="tsb-foot-actions">
      <button onclick="window.tdfTemaToggle&&tdfTemaToggle()" id="tdf-tema-btn" class="tsb-iconbtn" type="button" title="Tema dia/noite">🌙</button>
      <a href="/logout" class="tsb-iconbtn tsb-logout" title="Sair">⏻</a>
    </div>
  </div>
</aside>

<!-- Mobile: botão hambúrguer + overlay -->
<button class="tsb-hamb" type="button" onclick="tdfSidebarMobile()" aria-label="Abrir menu">☰</button>
<div class="tsb-overlay" id="tsbOverlay" onclick="tdfSidebarMobile(false)"></div>

<script>
function tdfSidebarToggle(){
  const sb = document.getElementById('tdfSidebar');
  sb.classList.toggle('collapsed');
  try { localStorage.setItem('tdfSidebarCollapsed', sb.classList.contains('collapsed') ? '1':'0'); } catch(_){}
}
function tdfSidebarMobile(force){
  const sb = document.getElementById('tdfSidebar');
  const ov = document.getElementById('tsbOverlay');
  const abrir = (force === undefined) ? !sb.classList.contains('mobile-open') : force;
  sb.classList.toggle('mobile-open', abrir);
  ov.classList.toggle('show', abrir);
}
function tdfSidebarFiltrar(q){
  q = (q||'').trim().toLowerCase();
  document.querySelectorAll('#tsbNav .tsb-group').forEach(g => {
    let any = false;
    g.querySelectorAll('.tsb-item').forEach(it => {
      const hit = it.textContent.toLowerCase().includes(q);
      it.style.display = hit ? 'flex' : 'none';
      if (hit) any = true;
    });
    g.style.display = any ? 'block' : 'none';
    if (q) g.classList.remove('collapsed');
  });
}
document.addEventListener('DOMContentLoaded', () => {
  try { if (localStorage.getItem('tdfSidebarCollapsed') === '1') document.getElementById('tdfSidebar').classList.add('collapsed'); } catch(_){}
  document.querySelectorAll('#tsbNav .tsb-group-title').forEach(t => {
    t.addEventListener('click', () => t.closest('.tsb-group').classList.toggle('collapsed'));
  });
  const ativo = document.querySelector('#tsbNav .tsb-item.active');
  if (ativo) ativo.closest('.tsb-group')?.classList.remove('collapsed');
});
document.addEventListener('keydown', e => {
  if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) { e.preventDefault(); document.getElementById('tsbQ')?.focus(); }
});
</script>

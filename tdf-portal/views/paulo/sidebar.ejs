        <a class="tsb-item <%= isA('dashboard-trafego') %>" href="/paulo/dashboard-trafego" title="Dashboard Tráfego"><span class="tsb-ico">⚡</span><span class="tsb-lbl">Dashboard Tráfego</span><span class="tsb-badge">NEW</span></a>
        <a class="tsb-item <%= isA('intake-monitor') %>" href="/paulo/intake-monitor" title="Monitor Intake"><span class="tsb-ico">📡</span><span class="tsb-lbl">Monitor Intake</span></a>
        <a class="tsb-item" href="/paulo/raiox-vendedor" title="Raio-X de Vendedor"><span class="tsb-ico">🔍</span><span class="tsb-lbl">Raio-X de Vendedor</span></a>

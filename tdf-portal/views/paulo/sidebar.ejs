      <div class="tsb-group-body">
        <a class="tsb-item <%= isA('onboarding') %>" href="/paulo/onboarding" title="Onboarding"><span class="tsb-ico">📚</span><span class="tsb-lbl">Onboarding</span></a>
        <a class="tsb-item <%= isA('playbook') %>" href="/paulo/playbook" title="Playbook"><span class="tsb-ico">📖</span><span class="tsb-lbl">Playbook</span></a>
        <a class="tsb-item <%= isA('produtos') %>" href="/paulo/produtos" title="Produtos"><span class="tsb-ico">📦</span><span class="tsb-lbl">Produtos</span></a>
        <a class="tsb-item <%= isA('treinamento') %>" href="/paulo/treinamento" title="Treinamento"><span class="tsb-ico">🎯</span><span class="tsb-lbl">Treinamento</span></a>
        <a class="tsb-item <%= isA('ferramentas') %>" href="/paulo/ferramentas" title="Ferramentas"><span class="tsb-ico">🛠️</span><span class="tsb-lbl">Ferramentas</span></a>
        <a class="tsb-item <%= isA('ia') %>" href="/paulo/ia" title="IA Consulta"><span class="tsb-ico">🤖</span><span class="tsb-lbl">IA Consulta</span></a>

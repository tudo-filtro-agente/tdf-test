      <button class="tsb-group-title" type="button"><span class="tsb-gi">🛡️</span><span class="tsb-lbl">Administração</span><span class="tsb-chev">▾</span></button>
      <div class="tsb-group-body">
        <a class="tsb-item tsb-money" href="/bi/financeiro" title="BI Financeiro Multiempresa"><span class="tsb-ico">💰</span><span class="tsb-lbl">BI Financeiro Multiempresa</span></a>
        <a class="tsb-item <%= isA('pdv') %>" href="/paulo/pdv" title="PDV (Loja Física)"><span class="tsb-ico">🛒</span><span class="tsb-lbl">PDV (Loja Física)</span></a>
        <a class="tsb-item" href="/paulo/squads" title="Squads & Metas"><span class="tsb-ico">🎯</span><span class="tsb-lbl">Squads &amp; Metas</span></a>
        <a class="tsb-item" href="/paulo/admin" title="Admin Sistema"><span class="tsb-ico">⚙️</span><span class="tsb-lbl">Admin Sistema</span></a>
        <a class="tsb-item" href="/paulo/admin-acessos" title="Acessos & Logs"><span class="tsb-ico">📊</span><span class="tsb-lbl">Acessos &amp; Logs</span></a>

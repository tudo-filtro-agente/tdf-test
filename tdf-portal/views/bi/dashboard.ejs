<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>BI Financeiro — TDF Portal</title>
  <style>
    :root {
      --fg: #0f172a;
      --muted: #64748b;
      --bg: #f1f5f9;
      --card: #ffffff;
      --border: #e2e8f0;
      --blue: #2563eb;
      --green: #16a34a;
      --red: #dc2626;
      --amber: #f59e0b;
      --purple: #7c3aed;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
      background: var(--bg); color: var(--fg);
    }
    header {
      background: var(--card); border-bottom: 1px solid var(--border);
      padding: 14px 24px; display: flex; align-items: center; gap: 16px;
    }
    header h1 { margin: 0; font-size: 18px; }
    header .filters { display: flex; gap: 8px; align-items: center; margin-left: auto; flex-wrap: wrap; }
    header select, header button {
      padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border); background: white; font-size: 13px;
    }
    header button.primary { background: var(--blue); color: white; border: 0; cursor: pointer; }
    .container { padding: 24px; max-width: 1400px; margin: 0 auto; }
    .kpi-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px; margin-bottom: 24px;
    }
    .kpi {
      background: var(--card); border-radius: 10px; padding: 18px; border: 1px solid var(--border);
      border-left: 4px solid var(--blue);
    }
    .kpi.warn { border-left-color: var(--amber); }
    .kpi.danger { border-left-color: var(--red); }
    .kpi.success { border-left-color: var(--green); }
    .kpi.purple { border-left-color: var(--purple); }
    .kpi .label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }
    .kpi .value { font-size: 26px; font-weight: 700; margin-top: 4px; }
    .kpi .sub { font-size: 12px; color: var(--muted); margin-top: 6px; }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
    @media (max-width: 900px) { .row { grid-template-columns: 1fr; } }
    .panel {
      background: var(--card); border-radius: 10px; padding: 18px; border: 1px solid var(--border);
    }
    .panel h2 { margin: 0 0 12px; font-size: 15px; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--border); }
    th { color: var(--muted); font-weight: 500; font-size: 11px; text-transform: uppercase; }
    .bar {
      background: var(--border); height: 8px; border-radius: 4px; overflow: hidden; margin-top: 4px;
    }
    .bar > div { height: 100%; background: var(--blue); }
    .bar.green > div { background: var(--green); }
    .bar.red > div { background: var(--red); }
    .empty { color: var(--muted); padding: 16px; text-align: center; font-size: 13px; }
    .user-chip {
      display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
      background: var(--border); border-radius: 99px; font-size: 12px;
    }
    .loading { padding: 32px; text-align: center; color: var(--muted); }
    .badge {
      display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 11px; font-weight: 500;
    }
    .badge.open { background: #fef3c7; color: #92400e; }
    .badge.late { background: #fee2e2; color: #991b1b; }
    .badge.paid { background: #d1fae5; color: #065f46; }
    .badge.cred { background: #dbeafe; color: #1e40af; }
    .badge.deb { background: #fed7aa; color: #9a3412; }
    a { color: var(--blue); text-decoration: none; }
    a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <header>
    <h1>📊 BI Financeiro — TDF Portal</h1>
    <span class="user-chip"><%= user.role %> · <%= user.username %></span>
    <div class="filters">
      <label style="font-size: 12px; color: var(--muted);">Empresa:</label>
      <select id="empresa-filter">
        <option value="">Todas</option>
        <% empresas.forEach(e => { %>
          <option value="<%= e.id %>"><%= e.nome %></option>
        <% }); %>
      </select>
      <button id="btn-refresh" class="primary">Atualizar</button>
      <a href="/admin" style="margin-left: 8px; font-size: 12px;">← admin</a>
      <a href="/api/auth/logout" style="font-size: 12px;">Sair</a>
    </div>
  </header>

  <div class="container">
    <div id="loading" class="loading">carregando dados do BI…</div>

    <div id="content" style="display:none;">
      <div class="kpi-grid">
        <div class="kpi danger">
          <div class="label">A pagar em aberto</div>
          <div class="value" id="kpi-pagar-aberto">R$ 0</div>
          <div class="sub" id="kpi-pagar-aberto-sub"></div>
        </div>
        <div class="kpi warn">
          <div class="label">A pagar atrasado</div>
          <div class="value" id="kpi-pagar-atrasado">R$ 0</div>
          <div class="sub" id="kpi-pagar-atrasado-sub"></div>
        </div>
        <div class="kpi success">
          <div class="label">A receber em aberto</div>
          <div class="value" id="kpi-receber-aberto">R$ 0</div>
          <div class="sub" id="kpi-receber-aberto-sub"></div>
        </div>
        <div class="kpi">
          <div class="label">Saldo bancário</div>
          <div class="value" id="kpi-saldo">R$ 0</div>
          <div class="sub" id="kpi-saldo-sub"></div>
        </div>
        <div class="kpi purple">
          <div class="label">Resultado do mês</div>
          <div class="value" id="kpi-mes">R$ 0</div>
          <div class="sub" id="kpi-mes-sub"></div>
        </div>
      </div>

      <div class="row">
        <div class="panel">
          <h2>📉 Top 5 categorias de despesa</h2>
          <div id="top-despesas"><div class="empty">carregando…</div></div>
        </div>
        <div class="panel">
          <h2>📈 Top 5 categorias de receita</h2>
          <div id="top-receitas"><div class="empty">carregando…</div></div>
        </div>
      </div>

      <div class="row">
        <div class="panel">
          <h2>💰 Contas a pagar por empresa</h2>
          <div id="por-empresa-pagar"><div class="empty">carregando…</div></div>
        </div>
        <div class="panel">
          <h2>💵 Contas a receber por empresa</h2>
          <div id="por-empresa-receber"><div class="empty">carregando…</div></div>
        </div>
      </div>

      <div class="panel" style="margin-bottom: 24px;">
        <h2>🔗 Próximas abas (Etapa 3 — em construção)</h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 8px; margin-top: 8px;">
          <a href="/api/bi/contas-pagar" target="_blank">📋 Contas a Pagar (API)</a>
          <a href="/api/bi/contas-receber" target="_blank">📋 Contas a Receber (API)</a>
          <a href="/api/bi/movimentos" target="_blank">📋 Movimentos (API)</a>
          <a href="/api/bi/contas-bancarias" target="_blank">📋 Contas Bancárias (API)</a>
          <a href="/api/bi/nf-entrada" target="_blank">📋 NF Entrada (API)</a>
          <a href="/api/bi/fornecedores" target="_blank">📋 Fornecedores (API)</a>
          <a href="/api/bi/categorias" target="_blank">📋 Categorias (API)</a>
          <a href="/api/bi/status" target="_blank">📋 Status das tabelas (API)</a>
        </div>
        <p style="color: var(--muted); font-size: 12px; margin-top: 12px;">
          As 7 abas com tabelas interativas virão na <b>Parte 2 da Etapa 3</b>.
        </p>
      </div>
    </div>
  </div>

  <script>
    const fmtBRL = v => 'R$ ' + (Number(v) || 0).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const fmtInt = v => (Number(v) || 0).toLocaleString('pt-BR');

    function empresaQs() {
      const v = document.getElementById('empresa-filter').value;
      return v ? '?empresa=' + v : '';
    }

    async function loadAll() {
      document.getElementById('loading').style.display = 'block';
      document.getElementById('content').style.display = 'none';
      try {
        const r = await fetch('/api/bi/dashboard/kpis' + empresaQs(), { credentials: 'same-origin' });
        const data = await r.json();
        if (!data.ok) throw new Error(data.erro || 'erro');
        renderKpis(data.kpis);
        renderTopCategorias('top-despesas', data.top_despesas);
        renderTopCategorias('top-receitas', data.top_receitas);
        renderPorEmpresa('por-empresa-pagar', data.por_empresa.pagar, 'red');
        renderPorEmpresa('por-empresa-receber', data.por_empresa.receber, 'green');
      } catch (e) {
        alert('Erro: ' + e.message);
      } finally {
        document.getElementById('loading').style.display = 'none';
        document.getElementById('content').style.display = 'block';
      }
    }

    function renderKpis(k) {
      const cp = k.contas_pagar;
      const cr = k.contas_receber;
      const cb = k.contas_bancarias;
      const m = k.movimentos_mes;

      document.getElementById('kpi-pagar-aberto').textContent = fmtBRL(cp.em_aberto);
      document.getElementById('kpi-pagar-aberto-sub').textContent = `${fmtInt(cp.qtd_total)} títulos • pago mês: ${fmtBRL(cp.pago_mes)}`;

      document.getElementById('kpi-pagar-atrasado').textContent = fmtBRL(cp.atrasado);
      document.getElementById('kpi-pagar-atrasado-sub').textContent = `${fmtInt(cp.qtd_total)} títulos • total`;

      document.getElementById('kpi-receber-aberto').textContent = fmtBRL(cr.em_aberto);
      document.getElementById('kpi-receber-aberto-sub').textContent = `${fmtInt(cr.qtd_total)} títulos • recebido mês: ${fmtBRL(cr.recebido_mes)}`;

      document.getElementById('kpi-saldo').textContent = fmtBRL(cb.saldo_total);
      document.getElementById('kpi-saldo-sub').textContent = `${fmtInt(cb.qtd_contas)} contas ativas`;

      const saldoMes = m.saldo_mes;
      document.getElementById('kpi-mes').textContent = fmtBRL(saldoMes);
      document.getElementById('kpi-mes').style.color = saldoMes >= 0 ? 'var(--green)' : 'var(--red)';
      document.getElementById('kpi-mes-sub').textContent = `créditos: ${fmtBRL(m.creditos)} • débitos: ${fmtBRL(m.debitos)}`;
    }

    function renderTopCategorias(elId, items) {
      const el = document.getElementById(elId);
      if (!items || !items.length) { el.innerHTML = '<div class="empty">sem dados</div>'; return; }
      const max = Math.max(...items.map(i => i.total));
      el.innerHTML = '<table><thead><tr><th>Categoria</th><th style="text-align:right;">Qtd</th><th style="text-align:right;">Total</th></tr></thead><tbody>' +
        items.map(i => `<tr>
          <td>${i.categoria || '(sem categoria)'}</td>
          <td style="text-align:right;">${fmtInt(i.qtd)}</td>
          <td style="text-align:right;">${fmtBRL(i.total)}</td>
        </tr>
        <tr><td colspan="3" style="padding: 4px 8px 8px;"><div class="bar"><div style="width: ${(i.total / max * 100).toFixed(1)}%"></div></div></td></tr>`).join('') +
        '</tbody></table>';
    }

    function renderPorEmpresa(elId, items, color) {
      const el = document.getElementById(elId);
      if (!items || !items.length) { el.innerHTML = '<div class="empty">sem dados</div>'; return; }
      const max = Math.max(...items.map(i => i.total_pagar || i.total_receber || 0), 1);
      el.innerHTML = '<table><thead><tr><th>Empresa</th><th style="text-align:right;">Total</th></tr></thead><tbody>' +
        items.map(i => {
          const total = i.total_pagar || i.total_receber || 0;
          return `<tr>
            <td>${i.nome}</td>
            <td style="text-align:right;">${fmtBRL(total)}</td>
          </tr>
          <tr><td colspan="2" style="padding: 4px 8px 8px;"><div class="bar ${color}"><div style="width: ${(total / max * 100).toFixed(1)}%"></div></div></td></tr>`;
        }).join('') +
        '</tbody></table>';
    }

    document.getElementById('btn-refresh').addEventListener('click', loadAll);
    document.getElementById('empresa-filter').addEventListener('change', loadAll);
    loadAll();
  </script>
</body>
</html>

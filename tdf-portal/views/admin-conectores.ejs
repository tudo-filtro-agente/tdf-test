<% const activePage = 'admin'; const pageTitle = 'Conectores — Central de Integrações'; %>

<style>
.cn-wrap{max-width:1400px;margin:0 auto;padding:24px;color:var(--text)}
.cn-header{background:linear-gradient(135deg,var(--bg),#1a0e2a);border:2px solid #a371f7;border-radius:12px;padding:18px;margin-bottom:18px}
.cn-header h1{color:#c084fc;margin:0;font-size:20px}
.cn-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:14px}
.cn-card{background:#161725;border:1px solid var(--border);border-radius:12px;padding:16px;display:flex;flex-direction:column}
.cn-card.ok{border-left:4px solid #22c55e}
.cn-card.off{border-left:4px solid #6b7280}
.cn-head{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.cn-head .ico{font-size:24px}
.cn-head .nm{flex:1;font-weight:800;font-size:15px;color:var(--text)}
.cn-status{font-size:10px;font-weight:800;padding:3px 8px;border-radius:4px;text-transform:uppercase}
.cn-status.ok{background:rgba(34,197,94,.15);color:#22c55e}
.cn-status.off{background:rgba(107,114,128,.15);color:#9ca3af}
.cn-desc{color:#9ca3af;font-size:12px;line-height:1.4;margin-bottom:12px}
.cn-fields{display:flex;flex-direction:column;gap:6px;margin-bottom:10px}
.cn-field{display:flex;flex-direction:column;gap:2px}
.cn-field label{color:#9ca3af;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.4px}
.cn-field input{background:#0a0a0f;border:1px solid var(--border);color:#fff;border-radius:5px;padding:6px 9px;font-size:11px;font-family:monospace}
.cn-field input:focus{border-color:#a371f7;outline:none}
.cn-actions{display:flex;gap:6px;margin-top:auto}
.cn-actions button{background:#1f1f2e;color:#ddd;border:1px solid var(--border);border-radius:5px;padding:7px 12px;font-size:11px;font-weight:700;cursor:pointer;flex:1}
.cn-actions button.save{background:#22c55e;color:#000;border:none}
.cn-actions button.test{background:#1f6feb;color:#fff;border:none}
.cn-actions a{background:#1a0e2a;color:#c084fc;border:1px solid #a371f7;border-radius:5px;padding:7px 12px;font-size:11px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:4px}
.cn-test-result{margin-top:8px;padding:8px;border-radius:5px;font-size:11px;display:none}
.cn-test-result.ok{background:rgba(34,197,94,.1);border:1px solid #22c55e;color:#22c55e}
.cn-test-result.err{background:rgba(239,68,68,.1);border:1px solid #ef4444;color:#fca5a5}
</style>

<div class="cn-wrap">
  <div class="cn-header">
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
      <span style="font-size:28px">🔌</span>
      <h1 style="flex:1">Central de Conectores</h1>
      <a href="/admin/webhooks-status" target="_blank" style="background:#1a0e2a;border:1px solid #a371f7;color:#c084fc;padding:8px 14px;border-radius:8px;font-weight:700;font-size:12px;text-decoration:none">🪝 Status webhooks (canais → n8n)</a>
    </div>
    <p style="color:#9ca3af;font-size:12px;margin:6px 0 0;line-height:1.5">
      Todas as integrações do portal num só lugar — WhatsApp (WATI/Z-API), CRM (Zoho), telefonia (GoTo),
      mídia paga (Google/Meta), IAs (Claude/ChatGPT/Gemini/Grok), e-mail SMTP, etc.
      Configurações ficam salvas no banco e sobrepõem env vars do Railway.
    </p>
  </div>

  <div id="cn-grid" class="cn-grid">
    <div style="grid-column:1/-1;text-align:center;color:var(--text-muted);padding:30px">⏳ Carregando conectores...</div>
  </div>
</div>

<script>
async function cnCarregar(){
  try {
    const r = await fetch('/admin/conectores/config');
    const d = await r.json();
    if (d.error) { document.getElementById('cn-grid').innerHTML = `<div style="color:#ef4444">${d.error}</div>`; return; }
    cnRender(d.conectores || {});
  } catch(e) {
    document.getElementById('cn-grid').innerHTML = `<div style="color:#ef4444">${e.message}</div>`;
  }
}
function cnRender(conectores){
  const grid = document.getElementById('cn-grid');
  let html = '';
  for (const [id, c] of Object.entries(conectores)) {
    const statusCls = c.status ? 'ok' : 'off';
    html += `
      <div class="cn-card ${statusCls}" id="cn-card-${id}">
        <div class="cn-head">
          <span class="ico">${c.icone}</span>
          <span class="nm" style="color:${c.cor}">${c.nome}</span>
          <span class="cn-status ${statusCls}">${c.status?'CONECTADO':'PENDENTE'}</span>
        </div>
        <div class="cn-desc">${c.descricao}</div>
        <div class="cn-fields">
          ${c.campos.map(f => {
            const valInfo = c.cfg[f.key] || {};
            const placeholder = valInfo.tem ? valInfo.valor : (f.placeholder||'(vazio)');
            const tipo = f.type || 'text';
            return `
              <div class="cn-field">
                <label>${f.label}${valInfo.fonte==='env'?' (no Railway env)':''}</label>
                <input type="${tipo}" id="cn-${id}-${f.key}" placeholder="${placeholder}" value="">
              </div>
            `;
          }).join('')}
        </div>
        <div class="cn-actions">
          <button class="save" onclick="cnSalvar('${id}')">💾 Salvar</button>
          <button class="test" onclick="cnTestar('${id}', this)">🧪 Testar</button>
          ${c.extra_link ? `<a href="${c.extra_link.url}" target="_blank">${c.extra_link.label}</a>` : ''}
        </div>
        ${(c.actions && c.actions.length) ? `
        <div class="cn-actions" style="margin-top:6px;flex-direction:column;gap:6px">
          ${c.actions.map(a => `
            <button class="cn-action-btn" data-conector="${id}" data-action-id="${a.id}" data-endpoint="${a.endpoint}" data-method="${a.method||'POST'}" data-confirm="${(a.confirm||'').replace(/"/g,'&quot;')}" onclick="cnAction(this)" style="background:linear-gradient(135deg,#1a0e2a,#2d1525);color:#c084fc;border:1px solid #a371f7;border-radius:5px;padding:8px 12px;font-size:11px;font-weight:700;cursor:pointer;flex:1;width:100%">${a.label}</button>
          `).join('')}
        </div>
        ` : ''}
        <div class="cn-test-result" id="cn-test-${id}"></div>
      </div>
    `;
  }
  grid.innerHTML = html;
}

async function cnAction(btn){
  const id = btn.dataset.conector;
  const endpoint = btn.dataset.endpoint;
  const method = btn.dataset.method || 'POST';
  const confirmMsg = btn.dataset.confirm;
  if (confirmMsg && !confirm(confirmMsg)) return;
  const result = document.getElementById('cn-test-'+id);
  const original = btn.textContent;
  btn.disabled = true; btn.textContent = '⏳ Executando...';
  result.style.display = 'block';
  result.className = 'cn-test-result';
  result.style.background = 'rgba(59,130,246,.1)';
  result.style.border = '1px solid #1f6feb';
  result.style.color = '#7cb9f5';
  result.textContent = '⏳ Executando...';
  try {
    const r = await fetch(endpoint, { method, headers: {'Content-Type':'application/json'}, body: method==='GET' ? undefined : '{}' });
    const d = await r.json();
    if (!r.ok || d.error) {
      result.className = 'cn-test-result err';
      result.textContent = '❌ ' + (d.error || `HTTP ${r.status}`);
    } else {
      result.className = 'cn-test-result ok';
      result.innerHTML = '✅ Executado com sucesso<br><pre style="font-size:10px;color:#9ca3af;max-height:200px;overflow:auto;margin-top:6px">'+JSON.stringify(d, null, 2).slice(0, 1000)+'</pre>';
      setTimeout(() => cnCarregar(), 1200);
    }
  } catch(e) {
    result.className = 'cn-test-result err';
    result.textContent = '❌ ' + e.message;
  } finally {
    btn.disabled = false; btn.textContent = original;
  }
}
async function cnSalvar(id){
  const card = document.getElementById('cn-card-'+id);
  const inputs = card.querySelectorAll('input[id^="cn-'+id+'-"]');
  const campos = {};
  inputs.forEach(inp => {
    const k = inp.id.replace('cn-'+id+'-', '');
    if (inp.value.trim()) campos[k] = inp.value.trim();
  });
  if (!Object.keys(campos).length) { alert('Nenhum campo preenchido pra salvar'); return; }
  try {
    const r = await fetch('/admin/conectores/config', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ conector: id, campos }),
    });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    inputs.forEach(inp => inp.value = '');
    cnTestar(id, card.querySelector('.test')); // testa após salvar
  } catch(e) { alert(e.message); }
}
async function cnTestar(id, btn){
  const result = document.getElementById('cn-test-'+id);
  result.style.display = 'block';
  result.className = 'cn-test-result';
  result.style.background = 'rgba(59,130,246,.1)';
  result.style.border = '1px solid #1f6feb';
  result.style.color = '#7cb9f5';
  result.textContent = '⏳ Testando...';
  if (btn) { btn.disabled = true; btn.textContent = '⏳'; }
  try {
    const r = await fetch('/admin/conectores/test/'+id, { method: 'POST' });
    const d = await r.json();
    result.className = 'cn-test-result ' + (d.ok ? 'ok' : 'err');
    result.textContent = (d.ok ? '✅ ' : '❌ ') + (d.msg || (d.ok ? 'OK' : 'Falhou'));
    // Reload pra atualizar status badge
    setTimeout(() => cnCarregar(), 800);
  } catch(e) {
    result.className = 'cn-test-result err';
    result.textContent = '❌ ' + e.message;
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = '🧪 Testar'; }
  }
}
cnCarregar();
</script>

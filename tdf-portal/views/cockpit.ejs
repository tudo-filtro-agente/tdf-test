        <div style="text-align:center;">
          <div style="font-size:2.5rem;font-weight:800;color:${g.posicao<=3?rankColors[g.posicao-1]:'#E6EDF3'};">#${g.posicao}</div>
          <div style="font-size:11px;color:#8B949E;">de ${g.totalClosers} closers</div>
        </div>
        <div style="flex:1;">
          <div style="font-size:13px;color:#8B949E;">
            ${g.posicao > 1 ? `Falta R$ ${(g.diffParaAcima/1000).toFixed(1)}k pro #${g.posicao-1} | R$ ${(g.diffParaPrimeiro/1000).toFixed(1)}k pro #1` : 'Voce e o lider!'}
          </div>
          <div style="font-size:13px;margin-top:4px;">
            <span style="color:#2EA043;">${g.meusDados.vendas} vendas</span> &middot;
            <span style="color:#58A6FF;">R$ ${(g.meusDados.faturamento/1000).toFixed(1)}k</span> &middot;
            <span>Ticket R$ ${(g.meusDados.ticketMedio||0).toLocaleString()}</span> &middot;
            <span>${g.meusDados.diasComVenda||0} dias com venda</span> &middot;
            <span style="color:${g.diasSemVenda>2?'#ef4444':g.diasSemVenda>0?'#eab308':'#22c55e'};">${g.diasSemVenda}d sem venda</span>
            ${g.meusDados.melhorDia ? ` &middot; <span style="color:#F0C040;">Melhor dia: ${g.meusDados.melhorDia} (R$ ${(g.meusDados.melhorDiaValor/1000).toFixed(1)}k)</span>` : ''}
          </div>
          ${medals ? `<div style="margin-top:6px;">${medals}</div>` : ''}
        </div>
      </div>
      <div style="max-height:250px;overflow-y:auto;">
        ${(g.ranking||[]).map((r,i) => {
          const isMe = r.pos === g.posicao;
          const bg = isMe ? 'background:#1e3a5f;' : '';
          const rc = i<3 ? rankColors[i] : '#8B949E';
          const maxFat = g.ranking[0]?.faturamento || 1;
          const pct = Math.round(r.faturamento / maxFat * 100);
          return `<div style="display:flex;align-items:center;gap:10px;padding:6px 8px;border-bottom:1px solid #21262D;border-radius:6px;${bg}">
            <span style="width:28px;height:28px;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:12px;font-weight:700;background:#21262D;color:${rc};">${r.pos}</span>

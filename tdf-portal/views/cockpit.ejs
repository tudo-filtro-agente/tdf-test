// === SUGESTÃO DE PRÓXIMOS PASSOS (IA) ===
async function sugerirAcao(dealId, dealName, btn){
  const orig = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '⏳ Pensando...';
  // Cria modal se não existe
  if (!document.getElementById('sg-modal')) {
    const m = document.createElement('div');
    m.id = 'sg-modal';
    m.style.cssText = 'display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:9999;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(4px)';
    m.innerHTML = `
      <div style="background:linear-gradient(135deg,#0d1117,#1a0e2a);border:2px solid #fbbf24;border-radius:14px;padding:0;max-width:680px;width:100%;max-height:88vh;display:flex;flex-direction:column;box-shadow:0 20px 60px rgba(251,191,36,.3)">

    }

    if (d.rei) {
      html += `<div style="flex:1;min-width:280px;background:linear-gradient(135deg,#1e1225,#1a1a2e);border:2px solid #A371F7;border-radius:16px;padding:20px;text-align:center;">
        <div style="font-size:36px;">🏅</div>
        <div style="font-size:18px;font-weight:800;color:#A371F7;">Rei do Mes</div>
        <div style="font-size:22px;font-weight:800;color:#E6EDF3;margin:6px 0;">${d.rei.name}</div>
        <div style="font-size:13px;color:#8B949E;">Score ${d.rei.scoreRei} | Fat ${Math.round(d.rei.fat/1000)}k | Conv ${d.rei.conversao}% | Proc ${d.rei.processo}%</div>
        <div style="font-size:11px;color:#6b7280;margin-top:4px;">40% fat + 20% conv + 15% proc + 15% vel + 10% disc</div>
      </div>`;
    }

    html += '</div>';

    // Coach messages
    if (d.coachMsgs && d.coachMsgs.length > 0) {
      const tipoCores = {positive:'#22c55e',competitive:'#F0C040',warning:'#eab308'};
      html += '<div style="margin-top:12px;">' + d.coachMsgs.slice(0,4).map(m =>
        '<div style="padding:4px 0;font-size:12px;color:'+(tipoCores[m.tipo]||'#8B949E')+';">'+m.msg+'</div>'
      ).join('') + '</div>';
    }

    el.innerHTML = html;
  } catch(e) { console.error('Destaques error:', e); }

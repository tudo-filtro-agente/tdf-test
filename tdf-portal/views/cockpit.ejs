    const ativColor = (dl.atividadesCount||0) === 0 ? '#F85149' : dl.atividadesCount < 3 ? '#D29922' : '#22c55e';
    const tipoAguaTag = dl.tipoAgua ? `<span style="display:inline-block;padding:1px 8px;background:#1e3a5f;color:#7cb9f5;border-radius:4px;font-size:10px;font-weight:700;margin-right:4px;">💧 ${dl.tipoAgua}</span>` : '';
    const stageColor = /Proposta/.test(dl.stage) ? '#F0C040' : /Qualificad/.test(dl.stage) ? '#A371F7' : /Primeiro Contato|Etapa IA|IA sem/i.test(dl.stage) ? '#ef4444' : '#8B949E';
    const fone = dl.phone ? fmtPhoneBR(dl.phone) : '';
    const ownerTag = dl.owner ? `<span style="display:inline-block;padding:1px 8px;background:rgba(167,113,247,.12);color:#c084fc;border-radius:4px;font-size:10px;font-weight:700;margin-right:4px" title="Dono do lead no Zoho">👤 ${dl.owner}</span>` : '';
    const nomeEsc = dl.name.replace(/'/g,"\\'").replace(/"/g,'&quot;');
    return `
      <div class="deal-card ${cls}">
        <div class="deal-tier">${emoji}</div>
        <div class="deal-info">
          <div class="deal-name">${dl.name}</div>
          <div class="deal-meta">
            ${ownerTag}${dl.tier} · sc:${dl.score}
            · <span style="color:${stageColor};font-weight:700">${dl.stage}</span>
            · <span style="color:${ativColor};font-weight:700;" title="atividades registradas">📋 ${dl.atividadesCount||0} ativ.</span>
            · <span style="color:${hrsColor};">${hrsLabel} sem ação</span>
          </div>
          <div class="deal-meta" style="margin-top:4px;">
            ${fone ? `<span style="display:inline-flex;align-items:center;gap:4px;margin-right:6px"><span onclick="event.stopPropagation();window.copyTel&&copyTel('${dl.phone.replace(/'/g,"\\'")}',this)" title="Click pra copiar" style="color:#22c55e;font-weight:700;font-family:monospace;font-size:12px;background:rgba(34,197,94,.1);padding:2px 8px;border-radius:4px;cursor:pointer;user-select:all">📞 ${fone}</span><button onclick="event.stopPropagation();window.copyTel&&copyTel('${dl.phone.replace(/'/g,"\\'")}',this)" style="background:transparent;border:1px solid #30363D;color:#9ca3af;border-radius:4px;padding:1px 5px;font-size:10px;cursor:pointer" title="Copiar">📋</button></span>` : '<span style="color:#666;font-size:11px;font-style:italic;margin-right:6px">sem telefone</span>'}
            ${tipoAguaTag}
            ${dl.cidade ? '<span style="color:#8B949E;font-size:11px;">📍 ' + dl.cidade + '</span>' : ''}
            ${dl.produto ? '<span style="color:#8B949E;font-size:11px;margin-left:6px;">🛠️ ' + dl.produto + '</span>' : ''}
          </div>
        </div>
        <div class="deal-actions">
          <button onclick="sugerirAcao('${dl.id}','${nomeEsc}',this)" class="deal-btn" style="background:linear-gradient(135deg,#f59e0b,#fbbf24);color:#000;border:none;cursor:pointer;font-weight:800" title="IA sugere próximos passos + template">💡 Sugerir</button>
          ${dl.phone ? `<a href="tel:${dl.phone}" class="deal-btn btn-call">📞 Ligar</a>` : ''}
          ${dl.phone ? `<button onclick="window.abrirChat&&abrirChat('${dl.id}','${String(dl.phone).replace(/\D/g,'')}','${nomeEsc}')" class="deal-btn btn-wpp" style="cursor:pointer;border:none">💬 Chat</button>` : ''}
          <a href="${dl.crmLink}" target="_blank" class="deal-btn btn-crm">📋 CRM</a>
          <button onclick="acionarNubia('${dl.id}','${nomeEsc}',this)" class="deal-btn" style="background:linear-gradient(135deg,#ef4444,#f97316);color:#fff;border:none;cursor:pointer;font-weight:700;">🤖 Núbia</button>

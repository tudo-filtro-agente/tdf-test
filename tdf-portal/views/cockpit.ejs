<% const activePage = 'cockpit'; const pageTitle = 'Meu Painel'; %>

<div class="page-header">
  <% if (isAdmin) { %>
  <div style="display:flex;align-items:center;gap:16px;flex-wrap:wrap;">
    <h1 id="greeting" style="margin:0;"></h1>
    <select id="closer-select" onchange="loadCockpit(this.value)" style="background:var(--bg-card);color:#F0C040;border:2px solid #F0C040;border-radius:10px;padding:10px 16px;font-size:1rem;font-weight:700;cursor:pointer;">
      <option value="">Todos os Closers</option>
      <% closers.forEach(c => { %>
        <option value="<%= c.username %>"><%= c.name %> (<%= c.team %>)</option>
      <% }); %>
    </select>
  </div>
  <% } else { %>
  <h1 id="greeting"></h1>
  <% } %>
  <div style="display:flex;align-items:center;gap:12px;">
    <p class="subtitle" id="subtitle">Carregando seu painel...</p>
    <button onclick="refreshAll()" id="refresh-btn" style="background:linear-gradient(135deg,#0066CC,#00AAFF);color:#fff;border:none;padding:8px 18px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:6px;transition:transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'">&#128260; Atualizar</button>
    <span id="refresh-time" style="font-size:11px;color:#6b7280;"></span>
  </div>
</div>

<div class="container" id="cockpit-content" style="opacity:0;transition:opacity 0.5s;">

  <!-- ATALHOS RÁPIDOS (Sales Coach #3 — link pro histórico) -->
  <div style="display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap;align-items:center">
    <a href="#faca-agora" onclick="document.getElementById('faca-agora')?.scrollIntoView({behavior:'smooth'});return false" style="background:#F0C040;color:#000;padding:8px 14px;border-radius:8px;font-size:12px;font-weight:800;text-decoration:none">⚡ Faça Agora</a>
    <a href="/cockpit/historico-page" style="background:#1f6feb;color:#fff;padding:8px 14px;border-radius:8px;font-size:12px;font-weight:700;text-decoration:none">📊 Meu Histórico de Vendas</a>
    <a href="/resgate-hoje" style="background:#ef4444;color:#fff;padding:8px 14px;border-radius:8px;font-size:12px;font-weight:700;text-decoration:none">🆘 Deals em Risco</a>
    <a href="/commit-semana" style="background:#22c55e;color:#000;padding:8px 14px;border-radius:8px;font-size:12px;font-weight:700;text-decoration:none">📋 Commit Semanal</a>
  </div>

  <!-- KPIs -->
  <div id="kpis" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;margin-bottom:24px;"></div>

  <!-- Meta Progress -->
  <div id="meta-section" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:20px;margin-bottom:24px;"></div>

  <!-- BONZAO + REI DESTAQUE -->
  <div id="destaque-top" style="display:none;margin-bottom:24px;"></div>

  <!-- GAMIFICAÇÃO COLAPSADA (Sales Coach #2: Premiação + Patente + Anual ficam ocultos por default) -->
  <details style="margin-bottom:18px;background:var(--bg-card);border:1px solid var(--border);border-radius:12px;padding:6px 14px">
    <summary style="cursor:pointer;color:var(--text-muted);font-weight:700;font-size:13px;padding:8px 0">🎮 Gamificação · Premiação · Patente · Competição Anual</summary>
    <div style="padding-top:8px">
      <!-- PREMIACAO -->
      <div id="premiacao-card" style="background:linear-gradient(135deg,#0d2818,var(--bg-card));border:1px solid #2EA043;border-radius:16px;padding:20px;margin-bottom:14px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
          <span style="font-size:20px;">&#128176;</span>
          <h2 style="font-size:1.1rem;color:#2EA043;margin:0;">Premiacao</h2>
        </div>
        <div id="premiacao-content" style="font-size:14px;color:var(--text);"></div>
      </div>

      <!-- PATENTE -->
      <div id="patente-card" style="background:linear-gradient(135deg,#1a1a2e,var(--bg-card));border:1px solid #A371F7;border-radius:16px;padding:20px;margin-bottom:14px;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
          <span style="font-size:20px;">&#9876;&#65039;</span>
          <h2 style="font-size:1.1rem;color:#A371F7;margin:0;">Patente</h2>
        </div>
        <div id="patente-content" style="font-size:14px;color:var(--text);">Carregando...</div>
      </div>

      <!-- COMPETICAO ANUAL -->
      <div id="anual-card" style="background:linear-gradient(135deg,#1a1a2e,var(--bg-card));border:1px solid #F0C040;border-radius:16px;padding:20px;margin-bottom:0;">
        <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
          <span style="font-size:20px;">&#127941;</span>
          <h2 style="font-size:1.1rem;color:#F0C040;margin:0;">Competicao Anual</h2>
        </div>
        <div id="anual-content" style="font-size:14px;color:var(--text);">Carregando...</div>
      </div>
    </div>
  </details>

  <!-- FORECAST -->
  <div style="background:var(--bg-card);border:1px solid #06b6d4;border-radius:16px;padding:20px;margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
      <span style="font-size:20px;">&#128202;</span>
      <h2 style="font-size:1.1rem;color:#06b6d4;margin:0;">Forecast</h2>
    </div>
    <div id="forecast-content" style="font-size:14px;color:var(--text);">Carregando...</div>
  </div>

  <!-- SCORE + CHECKLIST + METAS DIARIAS -->
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;margin-bottom:24px;" id="score-section">
    <!-- Score Card -->
    <div id="score-card" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:20px;text-align:center;">
      <h3 style="color:var(--text-muted);font-size:0.85rem;margin:0;">SCORE DO DIA</h3>
      <div id="score-value" style="font-size:3rem;font-weight:800;color:var(--text-muted);margin:8px 0;">--</div>
      <div id="score-class" style="font-size:0.85rem;font-weight:700;">Carregando...</div>
      <div id="score-breakdown" style="margin-top:14px;text-align:left;"></div>
    </div>

    <!-- Checklist -->
    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:20px;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
        <h3 style="color:var(--text);font-size:0.95rem;margin:0;">Checklist do Dia</h3>
        <span id="check-count" style="font-size:12px;font-weight:700;"></span>
      </div>
      <div id="checklist-items" style="display:flex;flex-direction:column;gap:8px;"></div>
    </div>

    <!-- Metas Diarias -->
    <div style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:20px;">
      <h3 style="color:#F0C040;font-size:0.95rem;margin:0 0 12px;">Meta Operacional Hoje</h3>
      <div id="metas-diarias" style="display:flex;flex-direction:column;gap:8px;"></div>
    </div>
  </div>

  <!-- SCORE SEMANAL RIGOROSO (rubrica nova) -->
  <div id="score-semana-card" style="background:linear-gradient(135deg,var(--bg) 0%,#1a0e2a 100%);border:2px solid #a371f7;border-radius:16px;padding:18px;margin-bottom:24px">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;flex-wrap:wrap">
      <span style="font-size:22px">📊</span>
      <h3 style="color:#c084fc;font-size:1rem;margin:0">Score da Semana — Rubrica Rigorosa v1</h3>
      <span style="background:#2d1525;color:#fbbf24;padding:2px 8px;border-radius:6px;font-size:10px;font-weight:800;margin-left:8px">100pts máximo</span>
      <span id="ssem-tendencia" style="margin-left:auto;font-size:12px;font-weight:700"></span>
    </div>
    <div id="ssem-stats" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:8px;margin-bottom:14px"></div>
    <div id="ssem-dias" style="display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px;margin-bottom:10px"></div>
    <div style="font-size:10px;color:var(--text-muted);margin-top:6px;line-height:1.5">
      <strong style="color:var(--text-muted)">Rubrica:</strong> Ligações outbound (35) + Atendidas % (15) + Tempo médio conversa (10) + Diamante/Ouro tocados (15) + Velocidade leads novos &lt;30min (10) + Resultados venda/proposta (15) = <strong>100pts</strong>.
      <span style="color:#fbbf24">Anti-defaults:</span> sem volume mínimo de calls/leads, NÃO ganha ponto por divisão zero.
    </div>
    <div id="ssem-detalhe-dia" style="display:none;margin-top:14px;background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:14px"></div>
  </div>

  <!-- GOTO CALLS -->
  <div style="background:var(--bg-card);border:1px solid #F0C040;border-radius:16px;padding:20px;margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
      <span style="font-size:20px;">&#128222;</span>
      <h2 style="font-size:1.1rem;color:#F0C040;margin:0;">Ligacoes Hoje (GoTo)</h2>
    </div>
    <div id="calls-content" style="font-size:14px;color:var(--text);">Carregando...</div>
  </div>

  <!-- SCORE DETALHADO + ANTI-MALANDRAGEM -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">
    <div style="background:var(--bg-card);border:1px solid #A371F7;border-radius:16px;padding:20px;">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
        <span style="font-size:18px;">&#128200;</span>
        <h3 style="color:#A371F7;font-size:1rem;margin:0;">Score Detalhado</h3>
        <span id="score-det-total" style="font-size:1.2rem;font-weight:800;margin-left:auto;"></span>
      </div>
      <div id="score-det-entries" style="max-height:300px;overflow-y:auto;font-size:12px;"></div>
    </div>
    <div>
      <div style="background:var(--bg-card);border:1px solid #ef4444;border-radius:16px;padding:20px;margin-bottom:16px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <span style="font-size:18px;">&#128680;</span>
          <h3 style="color:#ef4444;font-size:1rem;margin:0;">Anti-Malandragem</h3>
          <span id="alert-count" style="background:#2d1215;color:#f87171;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700;margin-left:auto;"></span>
        </div>
        <div id="anti-malandragem" style="font-size:13px;"></div>
      </div>
      <div style="background:var(--bg-card);border:1px solid #F0C040;border-radius:16px;padding:20px;">
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px;">
          <span style="font-size:18px;">&#128172;</span>
          <h3 style="color:#F0C040;font-size:1rem;margin:0;">Coach IA Diz</h3>
        </div>
        <div id="coach-msgs" style="font-size:13px;"></div>
      </div>
    </div>
  </div>

  <!-- CLOSY SCORES -->
  <div style="background:var(--bg-card);border:1px solid #A371F7;border-radius:16px;padding:20px;margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
      <span style="font-size:20px;">&#127908;</span>
      <h2 style="font-size:1.1rem;color:#A371F7;margin:0;">Closy — Score de Ligacoes</h2>
      <a href="https://closy-app-production.up.railway.app" target="_blank" style="color:#58A6FF;font-size:11px;text-decoration:none;margin-left:auto;">Abrir Closy</a>
    </div>
    <div id="closy-content" style="font-size:14px;color:var(--text);">Carregando...</div>
  </div>

  <!-- COACH IA -->
  <div id="coach-section" style="background:linear-gradient(135deg,#1e1225,#1a1a2e);border:1px solid #6b21a8;border-radius:16px;padding:20px;margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
      <span style="font-size:22px;">&#129504;</span>
      <h2 style="font-size:1.2rem;color:#c084fc;margin:0;">Diretor IA</h2>
      <button onclick="loadCoach()" style="background:#6b21a8;color:#fff;border:none;padding:6px 14px;border-radius:8px;font-size:12px;cursor:pointer;font-weight:600;">Atualizar</button>
      <span id="coach-loading" style="display:none;color:var(--text-muted);font-size:12px;">Analisando...</span>
    </div>
    <div id="coach-content" style="font-size:14px;line-height:1.7;color:var(--text);white-space:pre-wrap;"></div>
  </div>

  <!-- RAIO-X DO DIA -->
  <div id="raiox-section" style="background:linear-gradient(135deg,var(--bg) 0%,#1a0e2a 100%);border:2px solid #c084fc;border-radius:16px;padding:20px;margin-bottom:24px">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap" id="raiox-header">
      <span style="font-size:22px">📊</span>
      <h2 style="font-size:1.2rem;color:#c084fc;margin:0">Meu Dia em Tempo Real</h2>
      <span id="raiox-hora" style="margin-left:auto;color:var(--text-muted);font-size:12px;font-family:monospace"></span>
      <button onclick="toggleRaiox()" id="raiox-toggle" title="Minimizar/expandir o Diretor IA" style="background:#2d1525;color:#c084fc;border:1px solid #a371f7;border-radius:6px;padding:5px 12px;font-size:11px;font-weight:700;cursor:pointer">▼ Minimizar</button>
      <button onclick="loadRaiox()" style="background:#1e3a5f;color:#7cb9f5;border:1px solid #5ba3f5;border-radius:6px;padding:5px 12px;font-size:11px;font-weight:700;cursor:pointer">🔄 Atualizar</button>
    </div>
    <div id="raiox-body">
    <!-- PRÓXIMA AÇÃO (Sales Coach Win 3) — destaque no topo -->
    <a id="proxima-acao" href="#" style="display:none;background:linear-gradient(135deg,#1f0d2e,#2d1525);border:2px solid #fbbf24;border-radius:12px;padding:14px 18px;margin-bottom:14px;text-decoration:none;transition:transform .15s" onmouseover="this.style.transform='translateY(-1px)'" onmouseout="this.style.transform='translateY(0)'">
      <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span id="px-icon" style="font-size:22px">⚡</span>
        <div style="flex:1;min-width:200px">
          <div id="px-prio" style="font-size:9px;color:#fbbf24;font-weight:800;text-transform:uppercase;letter-spacing:.4px;margin-bottom:2px">PRÓXIMA AÇÃO</div>
          <div id="px-titulo" style="color:var(--text);font-weight:800;font-size:14px;line-height:1.3">—</div>
          <div id="px-descricao" style="color:var(--text-muted);font-size:11px;margin-top:3px;line-height:1.4">—</div>
        </div>
        <span id="px-action" style="background:#fbbf24;color:#000;padding:8px 14px;border-radius:6px;font-size:12px;font-weight:800;white-space:nowrap">→</span>
      </div>
    </a>
    <!-- KPIs do dia -->
    <div id="raiox-kpis" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px;margin-bottom:14px"></div>
    <!-- FUNIL PESSOAL com alerta de drop (Sales Coach Win L) -->
    <div id="funil-pessoal" style="display:none;background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:14px;margin-bottom:14px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap">
        <span style="font-size:16px">🔻</span>
        <strong style="color:var(--text);font-size:13px">Seu funil — leads criados nos últimos </strong>
        <select id="fp-dias" onchange="carregarFunilPessoal()" style="background:var(--bg-card);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:4px 8px;font-size:11px;font-weight:700">
          <option value="7">7 dias</option>
          <option value="30" selected>30 dias</option>
          <option value="60">60 dias</option>
          <option value="90">90 dias</option>
        </select>
        <span id="fp-comparado" style="color:var(--text-muted);font-size:10px;margin-left:auto">vs período anterior</span>
      </div>
      <div id="fp-alertas" style="margin-bottom:10px"></div>
      <div id="fp-bars"></div>
    </div>
    <!-- Sugestões do Diretor -->
    <div id="raiox-sugestoes" style="margin-bottom:14px"></div>
    <!-- Tabs -->
    <div style="display:flex;gap:4px;border-bottom:1px solid var(--border);margin-bottom:12px;flex-wrap:wrap">
      <button class="rx-tab active" data-tab="novos" onclick="rxTab('novos')" style="padding:8px 14px;background:#1e3a5f;color:#7cb9f5;border:1px solid #5ba3f5;border-radius:6px 6px 0 0;font-size:12px;font-weight:700;cursor:pointer">🆕 Novos hoje (<span id="rx-c-novos">0</span>)</button>
      <button class="rx-tab" data-tab="parados" onclick="rxTab('parados')" style="padding:8px 14px;background:none;color:var(--text-muted);border:1px solid transparent;border-radius:6px 6px 0 0;font-size:12px;font-weight:700;cursor:pointer">⏰ Parados +48h (<span id="rx-c-parados">0</span>)</button>
      <button class="rx-tab" data-tab="sem" onclick="rxTab('sem')" style="padding:8px 14px;background:none;color:var(--text-muted);border:1px solid transparent;border-radius:6px 6px 0 0;font-size:12px;font-weight:700;cursor:pointer">🚧 Sem Atividade (<span id="rx-c-sem">0</span>)</button>
      <button class="rx-tab" data-tab="vendas" onclick="rxTab('vendas')" style="padding:8px 14px;background:none;color:var(--text-muted);border:1px solid transparent;border-radius:6px 6px 0 0;font-size:12px;font-weight:700;cursor:pointer">✅ Vendas Hoje (<span id="rx-c-vendas">0</span>)</button>
    </div>
    <div id="rx-pane-novos" class="rx-pane"></div>
    <div id="rx-pane-parados" class="rx-pane" style="display:none"></div>
    <div id="rx-pane-sem" class="rx-pane" style="display:none"></div>
    <div id="rx-pane-vendas" class="rx-pane" style="display:none"></div>
    </div><!-- /raiox-body -->
  </div>

  <!-- FACA AGORA -->
  <div id="faca-agora" style="background:linear-gradient(135deg,#1C1208 0%,var(--bg-card-hover) 100%);border:1px solid #D29922;border-radius:16px;padding:20px;margin-bottom:24px;scroll-margin-top:80px">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap">
      <span style="font-size:22px;">&#9889;</span>
      <h2 style="font-size:1.2rem;color:#F0C040;margin:0;">Faca Agora</h2>
      <span id="urgente-count" style="background:#F85149;color:#fff;font-size:11px;font-weight:700;padding:2px 10px;border-radius:10px;"></span>
      <select id="fa-stage" onchange="renderDealsList()" style="margin-left:auto;background:var(--bg-hover);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:6px 12px;font-size:12px;font-weight:700;min-width:200px">
        <option value="">📋 Todas as etapas</option>
      </select>
      <select id="fa-tier" onchange="renderDealsList()" style="background:var(--bg-hover);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:6px 12px;font-size:12px;font-weight:700">
        <option value="">💎 Todos tiers</option>
        <option value="Diamante">💎 Diamante</option>
        <option value="Ouro">🥇 Ouro</option>
        <option value="Prata">🥈 Prata</option>
        <option value="Bronze">🥉 Bronze</option>
      </select>
    </div>
    <div id="deals-list" style="display:flex;flex-direction:column;gap:10px;"></div>
    <div id="deals-empty" style="display:none;color:var(--text-muted);text-align:center;padding:20px;font-size:13px">Nenhum lead nesta etapa/tier</div>
  </div>
  <script>
  // ============= RAIO-X DO DIA =============
  function toggleRaiox(){
    const body = document.getElementById('raiox-body');
    const btn = document.getElementById('raiox-toggle');
    const min = body.style.display === 'none';
    if (min) {
      body.style.display = '';
      btn.textContent = '▼ Minimizar';
      localStorage.setItem('raiox-min', '0');
    } else {
      body.style.display = 'none';
      btn.textContent = '▲ Expandir';
      localStorage.setItem('raiox-min', '1');
    }
  }
  // Restaura estado
  if (localStorage.getItem('raiox-min') === '1') {
    setTimeout(() => {
      const b = document.getElementById('raiox-body');
      const bt = document.getElementById('raiox-toggle');
      if (b) b.style.display = 'none';
      if (bt) bt.textContent = '▲ Expandir';
    }, 50);
  }

  function rxFmtR$(v){ return 'R$ '+(Math.round(v||0)/1000).toFixed(1)+'k'; }
  function rxFmtFull(v){ return 'R$ '+(v||0).toLocaleString('pt-BR'); }
  function rxWpp(p){ return p?'https://live-2708.wati.io/2708/teamInbox/'+String(p).replace(/\D/g,''):'#'; }

  function rxTab(name){
    document.querySelectorAll('.rx-tab').forEach(t => {
      const active = t.dataset.tab === name;
      t.classList.toggle('active', active);
      t.style.background = active ? '#1e3a5f' : 'none';
      t.style.color = active ? '#7cb9f5' : '#888';
      t.style.border = active ? '1px solid #5ba3f5' : '1px solid transparent';
    });
    document.querySelectorAll('.rx-pane').forEach(p => p.style.display = 'none');
    document.getElementById('rx-pane-'+name).style.display = '';
  }

  async function loadRaiox(){
    try{
      const closerParam = new URLSearchParams(location.search).get('closer');
      const url = '/cockpit/raiox-dia' + (closerParam ? '?closer='+encodeURIComponent(closerParam) : '');
      const res = await fetch(url);
      const d = await res.json();
      if (d.error) { document.getElementById('raiox-section').innerHTML = '<div style="color:#ef4444;padding:14px;text-align:center">Erro: '+d.error+'</div>'; return; }
      renderRaiox(d);
      // Carrega Próxima Ação + Funil Pessoal em paralelo
      loadProximaAcao();
      carregarFunilPessoal();
    }catch(e){ console.error('raiox:', e); }
  }

  async function carregarFunilPessoal(){
    try {
      const closerParam = new URLSearchParams(location.search).get('closer');
      const dias = (document.getElementById('fp-dias')||{}).value || '30';
      const qs = new URLSearchParams({ days: dias });
      if (closerParam) qs.set('closer', closerParam);
      const r = await fetch('/cockpit/conversao-stages?'+qs.toString());
      const d = await r.json();
      if (d.error || !d.atual) return;
      // Só mostra se tem volume mínimo (5+ leads no período atual)
      if (d.atual.total < 5) {
        document.getElementById('funil-pessoal').style.display = 'none';
        return;
      }
      document.getElementById('funil-pessoal').style.display = 'block';
      // Alertas de drop
      const al = document.getElementById('fp-alertas');
      if (d.alertas?.length) {
        al.innerHTML = d.alertas.map(a => `
          <div style="background:#3a0a0a;border:1px solid #ef4444;border-left:4px solid #ef4444;border-radius:6px;padding:8px 12px;margin-bottom:6px;display:flex;align-items:center;gap:8px">
            <span style="font-size:18px">⚠️</span>
            <div style="flex:1">
              <div style="color:#fca5a5;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.4px">DROP DETECTADO</div>
              <div style="color:#fff;font-size:12px;font-weight:700">${a.mensagem}</div>
              <div style="color:#aaa;font-size:10px;margin-top:2px">Onde você está perdendo: revise abordagem em ${a.de} → ${a.para}</div>
            </div>
          </div>
        `).join('');
      } else {
        al.innerHTML = '';
      }
      // Barras visuais
      const max = Math.max(...d.atual.etapas.map(e => e.count), 1);
      const corBar = ['#7cb9f5','#fbbf24','#a371f7','#f97316','#22c55e'];
      const html = d.atual.etapas.map((e, i) => {
        const w = (e.count / max) * 100;
        let deltaTag = '';
        if (i > 0 && e.delta_pp != null) {
          const dlt = e.delta_pp;
          const cor = dlt >= 5 ? '#22c55e' : dlt <= -15 ? '#ef4444' : dlt <= -5 ? '#fbbf24' : '#666';
          const sym = dlt > 0 ? '+' : '';
          deltaTag = `<span style="background:${cor}22;color:${cor};padding:2px 6px;border-radius:4px;font-size:10px;font-weight:700;margin-left:6px" title="vs período anterior: ${e.prev_conv?.toFixed(0)||0}%">${sym}${dlt.toFixed(0)}pp</span>`;
        }
        const convStr = i === 0 ? '' : ` · ${e.conv_from_prev?.toFixed(0)||0}% conv${deltaTag}`;
        return `
          <div style="margin-bottom:8px">
            <div style="display:flex;align-items:center;gap:8px;font-size:11px;color:#ccc;margin-bottom:3px">
              <span style="font-size:14px">${e.icon}</span>
              <strong style="color:#fff">${e.label}</strong>
              <span style="margin-left:auto;color:#aaa;font-variant-numeric:tabular-nums">${e.count} (${e.pct.toFixed(0)}%)</span>
              ${i > 0 ? `<span style="color:#888;font-size:10px">${convStr}</span>` : ''}
            </div>
            <div style="height:10px;background:#161b22;border-radius:3px;overflow:hidden">
              <div style="height:100%;background:${corBar[i]||'#888'};width:${w}%;transition:width .4s"></div>
            </div>
          </div>
        `;
      }).join('');
      document.getElementById('fp-bars').innerHTML = html;
    } catch(e) { console.error('funil-pessoal:', e); }
  }

  let _PX_LAST = null;
  async function loadProximaAcao(){
    try {
      const closerParam = new URLSearchParams(location.search).get('closer');
      const url = '/cockpit/proxima-acao' + (closerParam ? '?closer='+encodeURIComponent(closerParam) : '');
      const r = await fetch(url);
      const d = await r.json();
      if (d.error) return;
      const card = document.getElementById('proxima-acao');
      if (!card) return;
      const corMap = { CRITICA: '#ef4444', ALTA: '#f97316', MEDIA: '#fbbf24', OK: '#22c55e' };
      const cor = corMap[d.prioridade] || '#fbbf24';
      const ico = d.prioridade === 'CRITICA' ? '🚨' : d.prioridade === 'ALTA' ? '🔥' : d.prioridade === 'OK' ? '✅' : '⚡';
      document.getElementById('px-icon').textContent = ico;
      document.getElementById('px-prio').textContent = 'PRÓXIMA AÇÃO · ' + d.prioridade;
      document.getElementById('px-prio').style.color = cor;
      document.getElementById('px-titulo').textContent = d.titulo || '—';
      document.getElementById('px-descricao').textContent = d.descricao || '';
      document.getElementById('px-action').textContent = d.action_label || '→';
      document.getElementById('px-action').style.background = cor;
      card.style.borderColor = cor;
      card.href = d.link || '#';
      card.style.display = 'block';

      // Push notification: dispara quando MUDA de prioridade (especialmente upgrade)
      const sigChange = !_PX_LAST || _PX_LAST.tipo !== d.tipo || _PX_LAST.dealId !== d.dealId || _PX_LAST.prioridade !== d.prioridade;
      const upgrade = !_PX_LAST || (_PX_LAST.prioridade !== 'CRITICA' && d.prioridade === 'CRITICA');
      if (sigChange && d.prioridade !== 'OK') {
        _pxPushNotif(d, upgrade);
      }
      _PX_LAST = { tipo: d.tipo, dealId: d.dealId, prioridade: d.prioridade };
    } catch(e) { console.warn('proxima-acao:', e); }
  }

  function _pxPushNotif(d, upgrade){
    // Popup visual flutuante (canto inferior direito, 15s)
    const corMap = { CRITICA: '#ef4444', ALTA: '#f97316', MEDIA: '#fbbf24' };
    const cor = corMap[d.prioridade] || '#fbbf24';
    const ico = d.prioridade === 'CRITICA' ? '🚨' : d.prioridade === 'ALTA' ? '🔥' : '⚡';
    let stack = document.getElementById('__pxNotifStack');
    if (!stack) {
      stack = document.createElement('div');
      stack.id = '__pxNotifStack';
      stack.style.cssText = 'position:fixed;bottom:200px;right:14px;z-index:9998;display:flex;flex-direction:column-reverse;gap:8px;max-width:340px';
      document.body.appendChild(stack);
    }
    const el = document.createElement('a');
    el.href = d.link || '#';
    el.style.cssText = 'display:block;background:#0d0d0d;border:2px solid '+cor+';border-radius:10px;padding:12px 14px;color:#fff;text-decoration:none;box-shadow:0 8px 24px rgba(0,0,0,.6);animation:pxSlideIn .3s ease-out;cursor:pointer';
    el.innerHTML = '<div style="display:flex;align-items:center;gap:8px;margin-bottom:5px"><span style="font-size:22px">'+ico+'</span><span style="color:'+cor+';font-weight:800;font-size:10px;text-transform:uppercase;letter-spacing:.4px">Próxima Ação · '+d.prioridade+(upgrade?' · NOVA!':'')+'</span></div><div style="color:#fff;font-weight:700;font-size:13px;line-height:1.3">'+(d.titulo||'').replace(/</g,'&lt;')+'</div><div style="color:#aaa;font-size:11px;margin-top:3px">'+(d.descricao||'').replace(/</g,'&lt;')+'</div>';
    stack.appendChild(el);
    setTimeout(() => el.remove(), upgrade ? 25000 : 15000);
    // Som via tdfSons (ICQ por default)
    try { if (upgrade) window.tdfSons?.tocar(); } catch(_){}
    // Browser Notification API (se permitido)
    try {
      if (upgrade && 'Notification' in window && Notification.permission === 'granted') {
        const notif = new Notification('🚨 Próxima Ação CRÍTICA · Portal TDF', { body: (d.titulo||'') + '\n' + (d.descricao||''), icon: '/icon-192.png', tag: 'px-' + (d.dealId||'') });
        notif.onclick = () => { window.focus(); if (d.link) window.location.href = d.link; };
      }
    } catch(_){}
  }
  // Pede permissão de notif na 1ª interação
  document.addEventListener('click', () => {
    if ('Notification' in window && Notification.permission === 'default') Notification.requestPermission().catch(()=>{});
  }, { once: true });
  // CSS animation
  if (!document.getElementById('__pxNotifCss')) {
    const s = document.createElement('style'); s.id = '__pxNotifCss';
    s.textContent = '@keyframes pxSlideIn{from{transform:translateX(100%);opacity:0}to{transform:translateX(0);opacity:1}}';
    document.head.appendChild(s);
  }
  // Atualiza a cada 60s (era 90s — mais agressivo pra detectar mudança)
  setInterval(loadProximaAcao, 60000);


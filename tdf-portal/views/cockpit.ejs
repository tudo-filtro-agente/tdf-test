      return `<div style="background:#0D1117;border:1px solid #21262D;border-left:4px solid ${tc};border-radius:10px;padding:12px 14px;margin-bottom:8px;">
        <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">

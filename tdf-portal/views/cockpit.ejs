          <div style="text-align:center;"><div style="font-size:1.5rem;font-weight:700;color:#ef4444;">${s.worstScore}</div><div style="font-size:11px;color:#8B949E;">Pior</div></div>
        </div>
        <div style="font-size:12px;color:#8B949E;">Ultimas ligacoes:</div>
        ${(s.scores||[]).map(sc => {
          const c2 = sc.score>=80?'#22c55e':sc.score>=60?'#eab308':'#ef4444';
          return '<div style="display:flex;gap:8px;padding:4px 0;border-bottom:1px solid #21262D;font-size:12px;"><span style="color:'+c2+';font-weight:700;width:40px;">'+sc.score+'/100</span><span style="color:#E6EDF3;flex:1;">'+((sc.leadName||'')+'').slice(0,25)+'</span><span style="color:#8B949E;">'+((sc.summary||'')+'').slice(0,60)+'...</span></div>';
        }).join('')}
      `;
    } else if (d.allSellers?.length > 0) {
      document.getElementById('closy-content').innerHTML = d.allSellers.map(s => {
        const c2 = s.avgScore>=80?'#22c55e':s.avgScore>=60?'#eab308':'#ef4444';

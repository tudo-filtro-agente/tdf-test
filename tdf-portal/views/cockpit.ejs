      <h2 style="font-size:1.1rem;color:#F85149;margin:0;">Leads Parados</h2>
      <span id="parados-cnt" style="background:#2d1215;color:#f87171;padding:2px 10px;border-radius:10px;font-size:11px;font-weight:700;"></span>
      <span id="parados-valor" style="color:#F85149;font-size:12px;font-weight:700;margin-left:auto;"></span>
    </div>
    <div id="parados-filters" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;">
      <button class="par-filter active" onclick="filterParados('all',this)" style="background:#F85149;color:#fff;border:none;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;">Todos</button>
      <button class="par-filter" onclick="filterParados('Diamante',this)" style="background:var(--border);color:#A371F7;border:1px solid #A371F7;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;">Diamante</button>
      <button class="par-filter" onclick="filterParados('Ouro',this)" style="background:var(--border);color:#F0C040;border:1px solid #F0C040;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;">Ouro</button>
      <button class="par-filter" onclick="filterParados('Prata',this)" style="background:var(--border);color:var(--text-muted);border:1px solid var(--text-muted);padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;">Prata</button>
      <button class="par-filter" onclick="filterParados('poco',this)" style="background:var(--border);color:#58A6FF;border:1px solid #58A6FF;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;">Agua Poco</button>
      <button class="par-filter" onclick="filterParados('estacao',this)" style="background:var(--border);color:#2EA043;border:1px solid #2EA043;padding:5px 12px;border-radius:6px;font-size:11px;font-weight:600;cursor:pointer;">Agua Estacao</button>
    </div>
    <div id="parados-list" style="max-height:600px;overflow-y:auto;"></div>
  </div>

  <!-- LEADS POR FONTE -->
  <div style="background:var(--bg-card);border:1px solid #1F6FEB;border-radius:16px;padding:20px;margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
      <span style="font-size:18px;">&#128202;</span>
      <h2 style="font-size:1.1rem;color:#58A6FF;margin:0;">Leads por Fonte</h2>
    </div>
    <div id="source-tabs" style="display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px;"></div>
    <div id="source-deals" style="max-height:500px;overflow-y:auto;"></div>
  </div>

  <!-- Pipeline Breakdown -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;">
    <div id="stages-box" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:20px;"></div>
    <div id="tiers-box" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:20px;"></div>
  </div>

  <!-- RANKING + GAMIFICACAO -->
  <div style="background:var(--bg-card);border:1px solid #F0C040;border-radius:16px;padding:20px;margin-bottom:24px;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
      <span style="font-size:20px;">&#127942;</span>
      <h2 style="font-size:1.1rem;color:#F0C040;margin:0;">Ranking & Conquistas</h2>
    </div>
    <div id="gamificacao-content" style="font-size:14px;color:var(--text);">Carregando...</div>
  </div>

  <!-- Vendas do Mes -->
  <div id="won-section" style="background:var(--bg-card);border:1px solid var(--border);border-radius:16px;padding:20px;margin-bottom:24px;"></div>

</div>

<div id="loading" style="text-align:center;padding:60px 0;color:var(--text-muted);">
  <div style="font-size:40px;margin-bottom:16px;">&#128640;</div>
  <div>Carregando seu pipeline...</div>
</div>

<div id="error" style="display:none;text-align:center;padding:60px 0;color:#F85149;">
  <div style="font-size:40px;margin-bottom:16px;">&#9888;&#65039;</div>
  <div>Erro ao carregar dados. Tente recarregar a pagina.</div>
</div>

<style>
.kpi-card {
  background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 18px;
  text-align: center;
}
.kpi-value { font-size: 1.8rem; font-weight: 800; color: var(--text); }
.kpi-label { font-size: 0.8rem; color: var(--text-muted); margin-top: 4px; }
.kpi-sub { font-size: 0.75rem; margin-top: 6px; }

.deal-card {
  display: flex; align-items: center; gap: 12px;
  background: var(--bg); border: 1px solid var(--border); border-radius: 12px;
  padding: 14px 16px; transition: border-color 0.2s;
}
.deal-card:hover { border-color: #58A6FF; }
.deal-card.diamante { border-left: 4px solid #A371F7; }
.deal-card.ouro { border-left: 4px solid #F0C040; }
.deal-card.prata { border-left: 4px solid var(--text-muted); }
.deal-card.bronze { border-left: 4px solid #87592A; }

.deal-tier { font-size: 20px; min-width: 28px; text-align: center; }
.deal-info { flex: 1; }
.deal-name { font-weight: 700; font-size: 0.95rem; color: var(--text); }
.deal-meta { font-size: 0.8rem; color: var(--text-muted); margin-top: 3px; }
.deal-actions { display: flex; gap: 8px; }
.deal-btn {
  padding: 6px 12px; border-radius: 8px; font-size: 0.78rem; font-weight: 600;
  text-decoration: none; color: var(--text); transition: opacity 0.2s;
}
.deal-btn:hover { opacity: 0.8; }
.btn-call { background: #2EA043; }
.btn-wpp { background: #25D366; }
.btn-crm { background: #1F6FEB; }

.progress-bar {
  height: 10px; border-radius: 6px; background: var(--border); overflow: hidden; margin-top: 8px;
}
.progress-fill {
  height: 100%; border-radius: 6px; transition: width 1s ease;
}

.won-row {
  display: flex; justify-content: space-between; padding: 8px 0;
  border-bottom: 1px solid var(--border); font-size: 0.85rem; color: var(--text);
}
.won-row:last-child { border: none; }

@media (max-width: 600px) {
  .deal-actions { flex-direction: column; gap: 4px; }
  .deal-card { flex-wrap: wrap; }
  #kpis { grid-template-columns: 1fr 1fr; }
}
</style>

<script>
const userName = '<%= user.name %>';
const isAdmin = <%= isAdmin ? 'true' : 'false' %>;

function loadCockpit(closerUsername) {
  const url = closerUsername ? `/cockpit/data?closer=${closerUsername}` : '/cockpit/data';
  renderCockpit(url, closerUsername);
  loadScore();
loadAnual();
loadPatente();
loadForecast();
loadDestaques();
loadCalls();
loadScoreDetalhado();
loadChecklistFunil();
loadClosy();
loadScoreSemana();
}

async function loadScoreSemana(){
  try {
    const closer = new URLSearchParams(location.search).get('closer');
    const url = '/cockpit/score-semana?dias=7' + (closer ? '&closer='+encodeURIComponent(closer) : '');
    const r = await fetch(url);
    const d = await r.json();
    if (d.error) {
      document.getElementById('ssem-stats').innerHTML = '<div style="color:#ef4444;font-size:12px;padding:8px">Erro: '+d.error+'</div>';
      return;
    }
    // Tendência
    const tend = d.resumo.tendencia;
    const tendCor = tend === 'subindo' ? '#22c55e' : tend === 'caindo' ? '#ef4444' : '#888';
    const tendIcon = tend === 'subindo' ? '↗️' : tend === 'caindo' ? '↘️' : '➡️';
    const tendTxt = tend === 'subindo' ? `Subindo (+${d.resumo.delta_recente}pp)` : tend === 'caindo' ? `Caindo (${d.resumo.delta_recente}pp)` : 'Estável';
    document.getElementById('ssem-tendencia').innerHTML = `<span style="color:${tendCor}">${tendIcon} ${tendTxt}</span>`;
    // Stats
    const stats = d.resumo;
    document.getElementById('ssem-stats').innerHTML = `
      <div style="background:#161b22;border:1px solid #30363D;border-radius:8px;padding:10px;text-align:center">
        <div style="color:#888;font-size:10px;font-weight:700;text-transform:uppercase">Média 7d</div>
        <div style="color:#fff;font-size:24px;font-weight:800">${stats.media}<span style="font-size:12px;color:#666">/100</span></div>
      </div>
      <div style="background:#161b22;border:1px solid #22c55e44;border-radius:8px;padding:10px;text-align:center">
        <div style="color:#22c55e;font-size:10px;font-weight:700;text-transform:uppercase">Melhor</div>
        <div style="color:#22c55e;font-size:24px;font-weight:800">${stats.melhor.total}</div>
        <div style="color:#666;font-size:10px">${stats.melhor.dow} ${stats.melhor.data.slice(8,10)}/${stats.melhor.data.slice(5,7)}</div>
      </div>
      <div style="background:#161b22;border:1px solid #ef444444;border-radius:8px;padding:10px;text-align:center">
        <div style="color:#ef4444;font-size:10px;font-weight:700;text-transform:uppercase">Pior</div>
        <div style="color:#ef4444;font-size:24px;font-weight:800">${stats.pior.total}</div>
        <div style="color:#666;font-size:10px">${stats.pior.dow} ${stats.pior.data.slice(8,10)}/${stats.pior.data.slice(5,7)}</div>
      </div>
    `;
    // Dias
    window._SSEM_DATA = d;
    document.getElementById('ssem-dias').innerHTML = d.semana.map((dia, idx) => {
      const isToday = dia.is_today;
      const cor = dia.cor;
      const opacity = isToday ? '1' : '0.92';
      return `
        <button onclick="ssemAbrirDia(${idx})" style="background:${cor}22;border:2px solid ${cor};border-radius:8px;padding:8px 4px;cursor:pointer;text-align:center;opacity:${opacity};transition:transform .15s" onmouseover="this.style.transform='translateY(-2px)'" onmouseout="this.style.transform='translateY(0)'">
          <div style="color:#aaa;font-size:9px;font-weight:700;text-transform:uppercase">${dia.dow}</div>
          <div style="color:#888;font-size:9px">${dia.data.slice(8,10)}/${dia.data.slice(5,7)}</div>
          <div style="color:${cor};font-size:18px;font-weight:800;margin:3px 0">${dia.total}</div>
          <div style="color:${cor};font-size:8px;font-weight:700;text-transform:uppercase">${dia.classificacao}</div>
          ${isToday ? '<div style="color:#fbbf24;font-size:8px;font-weight:800;margin-top:2px">HOJE</div>' : ''}
        </button>
      `;
    }).join('');
  } catch(e) { console.error('score-semana:', e); }
}

function ssemAbrirDia(idx){
  const d = window._SSEM_DATA?.semana?.[idx];
  if (!d) return;
  const el = document.getElementById('ssem-detalhe-dia');
  const cor = d.cor;
  let html = `<div style="display:flex;align-items:center;gap:10px;margin-bottom:10px;flex-wrap:wrap">
    <span style="background:${cor}22;color:${cor};padding:4px 10px;border-radius:6px;font-size:11px;font-weight:800">${d.dow} ${d.data.slice(8,10)}/${d.data.slice(5,7)}</span>
    <strong style="color:#fff;font-size:18px">${d.total}<span style="font-size:11px;color:#888">/100</span></strong>
    <span style="color:${cor};font-weight:800;font-size:12px">${d.classificacao}</span>
  </div>`;
  // Breakdown
  html += '<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:8px;margin-bottom:10px">';
  for (const [key, b] of Object.entries(d.breakdown)) {
    const pct = (b.pts / b.max) * 100;
    const corBar = pct >= 80 ? '#22c55e' : pct >= 50 ? '#fbbf24' : pct >= 25 ? '#f97316' : '#ef4444';
    html += `
      <div style="background:#161b22;border:1px solid #30363D;border-radius:6px;padding:8px">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px">
          <span style="color:#fff;font-size:11px;font-weight:700">${b.label}</span>
          <span style="color:${corBar};font-size:13px;font-weight:800">${b.pts}/${b.max}</span>
        </div>
        <div style="height:5px;background:#0d0d0d;border-radius:2px;overflow:hidden;margin-bottom:4px">
          <div style="height:100%;background:${corBar};width:${pct}%;transition:width .4s"></div>
        </div>
        <div style="color:#888;font-size:10px">${b.detalhe}</div>
      </div>
    `;
  }
  html += '</div>';
  // Alertas
  if (d.alertas?.length) {
    html += '<div style="margin-top:8px">' + d.alertas.map(a => `
      <div style="background:#3a0a0a;border:1px solid #ef4444;border-left:3px solid #ef4444;border-radius:4px;padding:6px 10px;margin-bottom:4px;color:#fca5a5;font-size:11px">⚠️ ${a}</div>
    `).join('') + '</div>';
  }
  el.innerHTML = html;
  el.style.display = 'block';
  el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

async function renderCockpit(url, closerUsername) {
  document.getElementById('loading').style.display = 'block';
  document.getElementById('cockpit-content').style.opacity = '0';
  document.getElementById('error').style.display = 'none';

  const hour = new Date().getHours();
  let greet = 'Bom dia';
  if (hour >= 12 && hour < 18) greet = 'Boa tarde';
  else if (hour >= 18) greet = 'Boa noite';
  document.getElementById('greeting').textContent = `${greet}, ${userName}!`;

  try {
    const res = await fetch(url || '/cockpit/data');
    if (!res.ok) throw new Error('HTTP ' + res.status);
    const d = await res.json();
    if (d.error) throw new Error(d.error);

    document.getElementById('loading').style.display = 'none';
    document.getElementById('cockpit-content').style.opacity = '1';
    document.getElementById('error').style.display = 'none';
    const viewLabel = d.viewingAs ? `Visualizando: ${d.viewingAs}` : `Pipeline: ${d.pipeline.total} deals ativos`;
    document.getElementById('subtitle').textContent = `${viewLabel} | Time: ${d.team}`;

    // KPIs (with Bebedouro vs Filtro split)
    const k = d.kpis;
    document.getElementById('kpis').innerHTML = `
      <div class="kpi-card">
        <div class="kpi-value" style="color:#2EA043;">${k.vendas}</div>
        <div class="kpi-label">Vendas no Mes</div>
        <div class="kpi-sub" style="color:${k.pctVendas>=100?'#2EA043':'#D29922'};">${k.pctVendas}% da meta (${d.meta.vendas})</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-value" style="color:#58A6FF;">R$ ${(k.faturamento/1000).toFixed(1)}k</div>
        <div class="kpi-label">Faturamento Total</div>
        <div class="kpi-sub" style="color:${k.pctFaturamento>=100?'#2EA043':'#D29922'};">${k.pctFaturamento}% da meta</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-value" style="color:#F0C040;">R$ ${(k.fatBebedouro/1000).toFixed(1)}k</div>
        <div class="kpi-label">Bebedouro</div>
        <div class="kpi-sub">${k.vendasBebedouro} vendas</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-value" style="color:#A371F7;">R$ ${(k.fatFiltro/1000).toFixed(1)}k</div>
        <div class="kpi-label">Filtro Entrada</div>
        <div class="kpi-sub">${k.vendasFiltro} vendas</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-value" style="color:#f97316;">R$ ${((k.fatLoja||0)/1000).toFixed(1)}k</div>
        <div class="kpi-label">Loja/PDV</div>
        <div class="kpi-sub">${k.vendasLoja||0} vendas</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-value">R$ ${k.ticketMedio.toLocaleString('pt-BR')}</div>
        <div class="kpi-label">Ticket Medio</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-value" style="color:${k.faltaVendas<=3?'#2EA043':'#F85149'};">${k.faltaVendas}</div>
        <div class="kpi-label">Vendas p/ Meta</div>
        <div class="kpi-sub">R$ ${(k.faltaFaturamento/1000).toFixed(1)}k faltando</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-value">${d.pipeline.total}</div>
        <div class="kpi-label">Pipeline Ativo</div>
      </div>
      <div class="kpi-card">
        <div class="kpi-value" style="color:#F85149;">${k.perdidos}</div>
        <div class="kpi-label">Perdidos</div>
      </div>
    `;

    // Comparativo
    if (d.comparativo) {
      const comp = d.comparativo;
      const diffColor = comp.diffFatMesPassado >= 0 ? '#22c55e' : '#ef4444';
      const diffSign = comp.diffFatMesPassado >= 0 ? '+' : '';
      document.getElementById('kpis').innerHTML += `
        <div class="kpi-card" style="border:1px solid ${diffColor};">
          <div class="kpi-value" style="color:${diffColor};">${comp.pctVsMesPassado >= 0 ? '+' : ''}${comp.pctVsMesPassado}%</div>
          <div class="kpi-label">vs Mes Passado</div>
          <div class="kpi-sub">Mes anterior: R$ ${(comp.mesPassado.fat/1000).toFixed(0)}k (${comp.mesPassado.vendas}v) ate dia ${comp.mesPassado.mesmoDia?.slice(8)}</div>
        </div>
      `;
    }

    // Meta progress
    document.getElementById('meta-section').innerHTML = `
      <h3 style="color:#E6EDF3;margin:0 0 14px 0;font-size:1rem;">Meta do Mes</h3>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
        <div>
          <div style="display:flex;justify-content:space-between;font-size:0.85rem;color:#8B949E;">
            <span>Vendas: ${k.vendas}/${d.meta.vendas}</span>
            <span style="color:${k.pctVendas>=100?'#2EA043':'#F0C040'};">${k.pctVendas}%</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width:${Math.min(k.pctVendas,100)}%;background:${k.pctVendas>=100?'#2EA043':k.pctVendas>=70?'#F0C040':'#F85149'};"></div>
          </div>
        </div>
        <div>
          <div style="display:flex;justify-content:space-between;font-size:0.85rem;color:#8B949E;">
            <span>Faturamento: R$ ${(k.faturamento/1000).toFixed(1)}k / R$ ${(d.meta.faturamento/1000).toFixed(0)}k</span>
            <span style="color:${k.pctFaturamento>=100?'#2EA043':'#F0C040'};">${k.pctFaturamento}%</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width:${Math.min(k.pctFaturamento,100)}%;background:${k.pctFaturamento>=100?'#2EA043':k.pctFaturamento>=70?'#F0C040':'#F85149'};"></div>
          </div>
        </div>
      </div>
    `;

    // Deals list
    const tierEmoji = { 'Diamante': '&#128142;', 'Ouro': '&#129351;', 'Prata': '&#129352;', 'Bronze': '&#129353;' };
    const tierClass = { 'Diamante': 'diamante', 'Ouro': 'ouro', 'Prata': 'prata', 'Bronze': 'bronze' };
    const urgentes = d.deals.filter(dl => dl.tierPriority <= 1 || dl.hoursAgo > 24);
    document.getElementById('urgente-count').textContent = urgentes.length + ' urgentes';

    // Guarda deals + popula select de etapas (uma vez)
    window._FA_DEALS = d.deals || [];
    const stageSel = document.getElementById('fa-stage');
    if (stageSel && stageSel.options.length <= 1) {
      const stages = [...new Set(window._FA_DEALS.map(x => x.stage).filter(Boolean))];
      const counts = {};
      stages.forEach(s => counts[s] = window._FA_DEALS.filter(x => x.stage === s).length);
      stages.sort((a,b) => counts[b] - counts[a]);
      stageSel.innerHTML = '<option value="">📋 Todas as etapas (' + window._FA_DEALS.length + ')</option>' +
        stages.map(s => '<option value="' + s + '">' + s + ' (' + counts[s] + ')</option>').join('');
    }
    renderDealsList();

    // Stages
    document.getElementById('stages-box').innerHTML = `
      <h3 style="color:#E6EDF3;margin:0 0 12px 0;font-size:1rem;">Por Etapa</h3>
      ${Object.entries(d.pipeline.stages).sort((a,b)=>b[1]-a[1]).map(([s,c]) =>
        `<div style="display:flex;justify-content:space-between;padding:6px 0;font-size:0.85rem;color:#E6EDF3;border-bottom:1px solid #21262D;">
          <span>${s}</span><span style="font-weight:700;">${c}</span>
        </div>`
      ).join('')}
    `;

    // Premiacao
    if (d.premiacao) {
      const pm = d.premiacao;
      const faixaAtualHtml = pm.faixaAtual
        ? `<div style="background:#0d2818;border:1px solid #2EA043;border-radius:10px;padding:12px;margin-bottom:8px;">
            <span style="color:#2EA043;font-weight:700;">Faixa atual: R$ ${(pm.faixaAtual.faturamento/1000).toFixed(0)}k</span>
            <span style="color:#F0C040;font-weight:700;margin-left:12px;">Premio: R$ ${pm.premioAtual.toLocaleString()}</span>
            ${pm.bonusAtual > 0 ? '<span style="color:#A371F7;margin-left:12px;">+'+pm.bonusAtual+'% bonus alta margem</span>' : ''}
          </div>`
        : '<div style="color:#eab308;margin-bottom:8px;">Abaixo da primeira faixa (R$ 75k)</div>';
      const proxHtml = pm.faixaProxima
        ? `<div style="background:#21262D;border-radius:10px;padding:12px;">
            <span style="color:#8B949E;">Proxima faixa: R$ ${(pm.faixaProxima.faturamento/1000).toFixed(0)}k</span>
            <span style="color:#F0C040;margin-left:8px;">Premio: R$ ${pm.faixaProxima.premio.toLocaleString()}</span>
            <span style="color:#ef4444;margin-left:8px;font-weight:700;">Falta R$ ${(pm.faixaProxima.falta/1000).toFixed(1)}k</span>
            <div class="progress-bar" style="margin-top:6px;">
              <div class="progress-fill" style="width:${Math.round((1-pm.faixaProxima.falta/pm.faixaProxima.faturamento)*100)}%;background:#2EA043;"></div>
            </div>
          </div>`
        : '<div style="color:#F0C040;">Faixa maxima atingida!</div>';
      document.getElementById('premiacao-content').innerHTML = faixaAtualHtml + proxHtml;
    }

    // Leads Parados (with action plan)
    renderParados(d.deals);

    // Leads by Source (tabs + expandable)

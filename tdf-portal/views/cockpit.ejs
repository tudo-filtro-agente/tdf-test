        <div style="background:#101010;border:1px solid #30363D;border-radius:8px;padding:10px;margin-bottom:10px;font-size:11px;color:#aaa">
          <strong style="color:#fff;text-transform:uppercase;letter-spacing:.4px;font-size:10px">Onde pararam:</strong>
          ${Object.entries(grupos).map(([s,arr]) => `<span style="display:inline-block;background:#1a1a1a;color:#7cb9f5;border:1px solid #30363D;border-radius:14px;padding:3px 10px;margin:3px 4px 0 0;font-size:11px">${s}: <strong>${arr.length}</strong></span>`).join('')}
        </div>

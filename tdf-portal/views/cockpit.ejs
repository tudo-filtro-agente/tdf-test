          <span style="font-size:24px">💡</span>
          <div style="flex:1">
            <div style="color:#fbbf24;font-size:14px;font-weight:800">Sugestão de Próximos Passos · IA</div>
            <div id="sg-modal-deal" style="color:#aaa;font-size:11px;margin-top:2px"></div>
          </div>
          <button onclick="document.getElementById('sg-modal').style.display='none'" style="background:transparent;border:none;color:#888;font-size:22px;cursor:pointer;padding:0 8px">×</button>
        </div>
        <div id="sg-modal-body" style="flex:1;overflow-y:auto;padding:16px 18px;color:#e5e7eb"></div>
        <div id="sg-modal-actions" style="padding:12px 18px;border-top:1px solid #30363D;background:rgba(0,0,0,.3);display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end"></div>
      </div>
    `;
    document.body.appendChild(m);
  }
  const modal = document.getElementById('sg-modal');
  modal.style.display = 'flex';
  document.getElementById('sg-modal-deal').textContent = dealName;
  document.getElementById('sg-modal-body').innerHTML = '<div style="text-align:center;padding:30px;color:#888">⏳ IA analisando contexto do lead<br><span style="font-size:11px">timeline + CRM + WATI + templates</span></div>';
  document.getElementById('sg-modal-actions').innerHTML = '';
  try {
    const r = await fetch('/cockpit/sugerir-acao', {

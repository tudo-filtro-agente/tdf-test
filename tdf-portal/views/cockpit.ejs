async function sgEnviarTemplate(templateName, phone){
  const v = prompt(`Algum parâmetro pra preencher no template "${templateName}"? (separa por | se mais de um, ou vazio se não tem)`, '');
  const params = v ? v.split('|').map(s => s.trim()) : [];
  try {
    const r = await fetch('/inbox/template', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ phone, templateName, params })});
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    alert('✅ Template enviado!');
    document.getElementById('sg-modal').style.display='none';
  } catch(e) { alert('Erro: '+e.message); }
}

function sgUsarMensagem(dealId, phone, msg){
  document.getElementById('sg-modal').style.display='none';
  if (window.abrirChat) {
    window.abrirChat(dealId, phone, '');
    setTimeout(() => {
      const wins = document.querySelectorAll('.tdf-chat-win');
      const w = Array.from(wins).find(x => x.dataset.dealId === dealId);
      if (w) {
        const ta = w.querySelector('textarea');
        if (ta) { ta.value = msg; ta.focus(); }
      }
    }, 200);
  }
}

async function acionarNubia(dealId, dealName, btn) {
  if (!dealId) { alert('Lead sem ID'); return; }
  if (!confirm(`Pedir pra Núbia entrar em contato com "${dealName}" via WhatsApp?\n\nA Núbia vai enviar uma mensagem automática de reengajamento.`)) return;
  const orig = btn.innerHTML;
  btn.disabled = true; btn.innerHTML = '⏳ Disparando...';
  try {
    const res = await fetch('/cockpit/nubia-meu-lead', {
      method: 'POST', headers: {'Content-Type':'application/json'},
      body: JSON.stringify({ dealId })
    });
    const r = await res.json();
    if (r.error) { alert('Erro: ' + r.error); btn.innerHTML = orig; btn.disabled = false; return; }
    btn.innerHTML = '✓ Enviado';
    btn.style.background = '#22c55e';
    setTimeout(() => { btn.innerHTML = orig; btn.disabled = false; btn.style.background = ''; }, 3000);
  } catch(e) {
    alert('Erro: ' + e.message);
    btn.innerHTML = orig; btn.disabled = false;
  }
}

function filterParados(filter, btn) {
  if (btn) {
    document.querySelectorAll('.par-filter').forEach(b => { b.style.background='#21262D'; b.classList.remove('active'); });
    btn.style.background = filter==='all' ? '#F85149' : '#2d2d3d';
    btn.classList.add('active');
  }

  let deals = window._paradosAll || [];
  if (filter === 'Diamante' || filter === 'Ouro' || filter === 'Prata') {
    deals = deals.filter(d => d.tier === filter);
  } else if (filter === 'poco') {
    deals = deals.filter(d => /po[cç]o|mina|nascente|artesian/i.test(d.tipoAgua || d.pipeline));
  } else if (filter === 'estacao') {
    deals = deals.filter(d => /esta[cç][aã]o|concession|tratada|sabesp/i.test(d.tipoAgua || d.pipeline) || (!d.tipoAgua && !/po[cç]o/i.test(d.pipeline)));
  }

  const tierEmoji = {Diamante:'&#128142;',Ouro:'&#129351;',Prata:'&#129352;',Bronze:'&#129353;'};
  const tierColors = {Diamante:'#A371F7',Ouro:'#F0C040',Prata:'#8B949E',Bronze:'#87592A'};

  document.getElementById('parados-list').innerHTML = deals.length === 0
    ? '<div style="color:#4ade80;padding:12px;">Nenhum lead parado neste filtro</div>'
    : deals.slice(0,40).map(dl => {
      const emoji = tierEmoji[dl.tier] || '&#9898;';
      const tc = tierColors[dl.tier] || '#6b7280';
      const hrsLabel = dl.hoursAgo < 24 ? Math.round(dl.hoursAgo)+'h' : Math.round(dl.hoursAgo/24)+'d';
      const hrsColor = dl.hoursAgo > 72 ? '#ef4444' : dl.hoursAgo > 24 ? '#eab308' : '#8B949E';
      const phoneClean = dl.phone ? String(dl.phone).replace(/\D/g,'') : '';
      const goto = phoneClean ? 'https://app.goto.com/calls?phoneNumber='+encodeURIComponent('+'+phoneClean) : '';
      const nomeEsc = (dl.name||'').replace(/'/g,"\\'");

      // Smart action plan based on context
      let plano = '';
      if (dl.hoursAgo > 72 && (dl.tier === 'Diamante' || dl.tier === 'Ouro')) {
        plano = '<span style="color:#ef4444;font-weight:700;">URGENTE: Ligar AGORA. Lead quente esfriando ha '+hrsLabel+'</span>';
      } else if (/Proposta/i.test(dl.stage)) {
        plano = '<span style="color:#F0C040;">Follow-up de proposta. Perguntar se viu os valores e tirar duvidas.</span>';
      } else if (/Qualifica/i.test(dl.stage)) {
        plano = '<span style="color:#58A6FF;">Retomar qualificacao. Confirmar interesse e agendar proximo passo.</span>';
      } else if (/Analise|vazao/i.test(dl.stage)) {
        plano = '<span style="color:#c084fc;">Cobrar analise de agua. Se nao fez, oferecer lab proximo ou visita.</span>';
      } else if (/Primeiro Contato/i.test(dl.stage)) {
        plano = '<span style="color:#2EA043;">Fazer primeiro contato real: ligar + WhatsApp + criar tarefa retorno.</span>';
      } else {
        plano = '<span style="color:#8B949E;">Verificar situacao e definir proximo passo no CRM.</span>';
      }

      // Agua type badge
      const aguaBadge = dl.tipoAgua
        ? (/po[cç]o|mina|nascente/i.test(dl.tipoAgua)
            ? '<span style="background:#1e3a5f;color:#58A6FF;padding:1px 6px;border-radius:4px;font-size:10px;">Poco</span>'
            : '<span style="background:#0d2818;color:#4ade80;padding:1px 6px;border-radius:4px;font-size:10px;">Estacao</span>')
        : (/po[cç]o/i.test(dl.pipeline)

// Coach IA
async function loadCoach() {
  const sel = document.getElementById('closer-select');
  const closer = sel ? sel.value : '';
  const url = closer ? `/cockpit/coach?closer=${closer}` : '/cockpit/coach';
  document.getElementById('coach-loading').style.display = 'inline';
  document.getElementById('coach-content').innerHTML = '<span style="color:#8B949E">Analisando seu pipeline com IA...</span>';
  try {
    const res = await fetch(url);
    const data = await res.json();
    if (data.error) throw new Error(data.error);
    // Parse markdown-like ## headers
    let html = data.coach
      .replace(/## (.*)/g, '<h3 style="color:#c084fc;font-size:15px;margin:16px 0 8px;">$1</h3>')
      .replace(/\*\*(.*?)\*\*/g, '<strong style="color:#fff">$1</strong>')
      .replace(/\n- /g, '\n• ')
      .replace(/\n(\d+)\. /g, '\n<strong style="color:#c084fc">$1.</strong> ');
    document.getElementById('coach-content').innerHTML = html;
  } catch(e) {
    document.getElementById('coach-content').innerHTML = '<span style="color:#F85149">Erro ao carregar coach: '+e.message+'</span>';
  }
  document.getElementById('coach-loading').style.display = 'none';
}

// Load gamificacao
async function loadGamificacao() {
  const sel = document.getElementById('closer-select');

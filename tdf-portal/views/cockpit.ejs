// Load GoTo Calls
async function loadCalls() {
  const sel = document.getElementById('closer-select');
  const closer = sel ? sel.value : '';
  const url = closer ? `/cockpit/calls?closer=${closer}` : '/cockpit/calls';
  try {
    const res = await fetch(url);
    const c = await res.json();
    if (c.error || !c.stats) { document.getElementById('calls-content').innerHTML = '<span style="color:#8B949E;">GoTo nao disponivel</span>'; return; }
    
    const stats = c.stats;
    if (stats.length === 1) {
      const s = stats[0];
      const meta25 = s.total >= 25;
      document.getElementById('calls-content').innerHTML = `
        <div style="display:flex;gap:16px;flex-wrap:wrap;">
          <div style="text-align:center;"><div style="font-size:1.8rem;font-weight:800;color:${meta25?'#22c55e':'#eab308'};">${s.total}</div><div style="font-size:11px;color:#8B949E;">Total</div></div>
          <div style="text-align:center;"><div style="font-size:1.8rem;font-weight:800;color:#58A6FF;">${s.outbound}</div><div style="font-size:11px;color:#8B949E;">Saidas</div></div>
          <div style="text-align:center;"><div style="font-size:1.8rem;font-weight:800;">${s.inbound}</div><div style="font-size:11px;color:#8B949E;">Entradas</div></div>
          <div style="text-align:center;"><div style="font-size:1.8rem;font-weight:800;color:#2EA043;">${s.answered}</div><div style="font-size:11px;color:#8B949E;">Atendidas</div></div>
          <div style="text-align:center;"><div style="font-size:1.8rem;font-weight:800;color:#ef4444;">${s.missed}</div><div style="font-size:11px;color:#8B949E;">Perdidas</div></div>
          <div style="text-align:center;"><div style="font-size:1.8rem;font-weight:800;">${s.avgDurMin}m</div><div style="font-size:11px;color:#8B949E;">Duracao Media</div></div>
        </div>
        ${!meta25 ? '<div style="color:#eab308;font-size:12px;margin-top:8px;">Meta: 25 ligacoes/dia. Faltam '+(25-s.total)+'.</div>' : '<div style="color:#22c55e;font-size:12px;margin-top:8px;">Meta de 25 ligacoes atingida!</div>'}
      `;
    } else {
      document.getElementById('calls-content').innerHTML = stats.map(s =>
        `<div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #21262D;font-size:13px;">
          <span style="font-weight:600;">${s.nome||s.owner}</span>
          <span style="color:${s.total>=25?'#22c55e':'#eab308'};font-weight:700;">${s.total} ligacoes</span>
          <span style="color:#2EA043;">${s.answered} atend</span>
          <span style="color:#ef4444;">${s.missed} perd</span>
          <span style="color:#8B949E;">${s.avgDurMin}m avg</span>
        </div>`
      ).join('');
    }
  } catch(e) { document.getElementById('calls-content').innerHTML = '<span style="color:#8B949E;">GoTo indisponivel</span>'; }
}

// Load Patente
async function loadPatente() {
  const sel = document.getElementById('closer-select');
  const closer = sel ? sel.value : '';
  const url = closer ? '/cockpit/patente?closer='+closer : '/cockpit/patente';
  try {
    const res = await fetch(url);
    const p = await res.json();
    if (p.error) { document.getElementById('patente-content').innerHTML = '<span style="color:#8B949E;">Sem dados</span>'; return; }
    // patente data loaded above
    const lt = p.lifetime;
    const an = p.anual;
    const a = lt.atual;
    const prox2 = lt.proxima;
    const anAtual = an.atual;
    const anProx = an.proxima;

    // Legado badges
    const legadoHtml = (p.legado||[]).map(b => {
      const style = b.desbloqueado ? 'opacity:1;' : 'opacity:0.3;filter:grayscale(1);';
      return '<span title="'+(b.desbloqueado?b.nome:'Falta R$ '+(b.falta/1000).toFixed(0)+'k')+'" style="font-size:20px;'+style+'">'+b.icon+'</span>';
    }).join(' ');

    document.getElementById('patente-content').innerHTML = `
      <div style="display:flex;gap:16px;flex-wrap:wrap;">
        <div style="flex:1;min-width:200px;">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
            <span style="font-size:2rem;">${a.icon}</span>
            <div>
              <div style="font-size:14px;font-weight:800;color:${a.cor};">${a.nome}</div>
              <div style="font-size:11px;color:#8B949E;">Lifetime: R$ ${(lt.fatTotal/1000).toFixed(0)}k (${lt.vendasTotal} vendas)</div>
            </div>
          </div>
          ${prox2 ? '<div style="font-size:11px;color:#8B949E;">Proxima: '+prox2.icon+' '+prox2.nome+' | Falta R$ '+(lt.faltaProxima/1000).toFixed(0)+'k</div><div class="progress-bar" style="margin-top:4px;"><div class="progress-fill" style="width:'+lt.pctProxima+'%;background:'+prox2.cor+';"></div></div>' : ''}
          <div style="margin-top:8px;">${legadoHtml}</div>
        </div>
        <div style="flex:1;min-width:200px;">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
            <span style="font-size:2rem;">${anAtual.icon}</span>
            <div>
              <div style="font-size:14px;font-weight:800;color:${anAtual.cor};">${anAtual.nome}</div>
              <div style="font-size:11px;color:#8B949E;">2026: R$ ${(an.fatAnual/1000).toFixed(0)}k (${an.vendasAnual} vendas)</div>
            </div>
          </div>
          ${anProx ? '<div style="font-size:11px;color:#8B949E;">Proxima: '+anProx.icon+' '+anProx.nome+' | Falta R$ '+(an.falta/1000).toFixed(0)+'k</div><div class="progress-bar" style="margin-top:4px;"><div class="progress-fill" style="width:'+an.pct+'%;background:'+anProx.cor+';"></div></div>' : '<div style="color:#F0C040;font-size:12px;font-weight:700;">Patente maxima!</div>'}
          ${an.meses && an.meses.length > 0 ? '<div style="display:flex;gap:4px;margin-top:6px;overflow-x:auto;">'+an.meses.map(m => '<div style="text-align:center;min-width:40px;"><div style="font-size:9px;color:#6b7280;">'+m.mes.slice(5)+'</div><div style="font-size:11px;color:#2EA043;font-weight:700;">'+Math.round(m.fat/1000)+'k</div></div>').join('')+'</div>' : ''}
        </div>
      </div>
    `;
  } catch(e) { console.error('Patente error:', e); }
}

// Load Score Detalhado + Anti-Malandragem + Coach
async function loadScoreDetalhado() {
  const sel = document.getElementById('closer-select');
  const closer = sel ? sel.value : '';
  const url = closer ? '/cockpit/score-detalhado?closer='+closer : '/cockpit/score-detalhado';
  try {
    const res = await fetch(url);
    const d = await res.json();
    if (d.error) return;
    
    // Score total
    document.getElementById('score-det-total').innerHTML = '<span style="color:'+d.score.nivelCor+';">'+d.score.total+' pts ('+d.score.nivel+')</span>';
    
    // Entries
    document.getElementById('score-det-entries').innerHTML = d.score.entries.map(e => {
      const color = e.pts >= 0 ? '#22c55e' : '#ef4444';
      const sign = e.pts >= 0 ? '+' : '';
      return '<div style="display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #21262D;"><span style="color:#E6EDF3;">'+e.desc+(e.deal?' <span style="color:#8B949E;">'+e.deal+'</span>':'')+'</span><span style="color:'+color+';font-weight:700;">'+sign+e.pts+'</span></div>';
    }).join('');

    // Anti-malandragem
    const alertas = d.antiMalandragem || [];
    document.getElementById('alert-count').textContent = alertas.length;
    document.getElementById('anti-malandragem').innerHTML = alertas.length === 0
      ? '<div style="color:#22c55e;">Nenhum alerta. Jogo limpo!</div>'
      : alertas.map(a => {
        const gc = a.gravidade==='alto'?'#ef4444':'#eab308';
        return '<div style="margin-bottom:8px;padding:8px;background:#0D1117;border-left:3px solid '+gc+';border-radius:4px;"><div style="color:'+gc+';font-weight:700;font-size:12px;">'+a.tipo.toUpperCase()+' ('+a.gravidade+')</div><div style="color:#E6EDF3;">'+a.desc+'</div><div style="color:#8B949E;font-size:11px;">Acao: '+a.acao+'</div><div style="color:#6b7280;font-size:10px;">Evidencia: '+a.evidencia+'</div></div>';
      }).join('');

    // Coach messages
    const msgs = d.coachMessages || [];
    const tipoIcons = {positive:'&#128170;',warning:'&#9888;&#65039;',urgent:'&#128680;',hard:'&#128165;',competitive:'&#127942;'};
    const tipoCores = {positive:'#22c55e',warning:'#eab308',urgent:'#ef4444',hard:'#ef4444',competitive:'#F0C040'};
    document.getElementById('coach-msgs').innerHTML = msgs.length === 0
      ? '<div style="color:#8B949E;">Nenhuma mensagem agora</div>'
      : msgs.map(m => '<div style="padding:6px 0;border-bottom:1px solid #21262D;color:'+(tipoCores[m.tipo]||'#E6EDF3')+';">'+(tipoIcons[m.tipo]||'')+ ' '+m.msg+'</div>').join('');
  } catch(e) { console.error('ScoreDet error:', e); }
}


// Refresh all data (clears cache)
async function refreshAll() {
  const btn = document.getElementById('refresh-btn');
  btn.textContent = '⏳ Atualizando...';
  btn.disabled = true;
  
  // Clear server cache
  try { await fetch('/cache-clear'); } catch(e) {}
  
  // Reload all sections
  const sel = document.getElementById('closer-select');
  const closer = sel ? sel.value : '';
  const url = closer ? '/cockpit/data?closer='+closer : '/cockpit/data';
  
  await renderCockpit(url, closer);
  
  // Reload all parallel sections
  await Promise.all([
    loadScore(),
    loadAnual(),
    loadPatente(),
    loadDestaques(),
    loadCalls(),
    loadScoreDetalhado(),
    loadChecklistFunil(),
    loadGamificacao(),
  ]);
  
  btn.innerHTML = '&#128260; Atualizar';
  btn.disabled = false;
  document.getElementById('refresh-time').textContent = 'Atualizado ' + new Date().toLocaleTimeString('pt-BR');
}

// Load Checklist Funil
async function loadChecklistFunil() {
  const sel = document.getElementById('closer-select');
  const closer = sel ? sel.value : '';
  const url = closer ? '/cockpit/checklist-funil?closer='+closer : '/cockpit/checklist-funil';
  try {
    const res = await fetch(url);
    const d = await res.json();
    if (d.error) return;

    const s = d.stats;
    const pctColor = s.pctCompleto >= 80 ? '#22c55e' : s.pctCompleto >= 50 ? '#eab308' : '#ef4444';
    document.getElementById('funil-pct').innerHTML = '<span style="color:'+pctColor+';">'+s.pctCompleto+'% completo ('+s.completos+'/'+s.totalDeals+') | +'+s.pontosGanhos+' / -'+s.pontosPerdidos+' pts</span>';

    // Stage summary cards
    const stageColors = {'Primeiro Contato':'#3b82f6','Em Qualificação':'#8b5cf6','Proposta':'#f97316','Qualificado':'#22c55e'};
    document.getElementById('funil-summary').innerHTML = Object.entries(d.stageSummary).map(([stage, data]) => {
      const cor = stageColors[stage] || '#8B949E';
      const pct = data.total > 0 ? Math.round(data.completos/data.total*100) : 0;
      return '<div style="background:#0D1117;border:1px solid '+cor+';border-radius:10px;padding:10px 14px;flex:1;min-width:130px;text-align:center;">' +
        '<div style="color:'+cor+';font-weight:700;font-size:13px;">'+stage+'</div>' +
        '<div style="font-size:11px;color:#8B949E;">'+data.completos+'/'+data.total+' completos ('+pct+'%)</div>' +
        '<div class="progress-bar" style="margin-top:4px;"><div class="progress-fill" style="width:'+pct+'%;background:'+cor+';"></div></div>' +
        '</div>';
    }).join('');

    // Urgentes (incompletos)
    document.getElementById('funil-urgentes').innerHTML = d.urgentes.length === 0
      ? '<div style="color:#22c55e;font-size:13px;padding:8px;">Todos os checklists completos!</div>'
      : d.urgentes.map(deal => {
        const tierColors = {Diamante:'#A371F7',Ouro:'#F0C040',Prata:'#8B949E',Bronze:'#CD7F32'};
        const tc = tierColors[deal.tier] || '#6b7280';
        return '<div style="background:#0D1117;border-left:3px solid '+(deal.pct<30?'#ef4444':'#eab308')+';border-radius:8px;padding:10px 12px;margin-bottom:6px;">' +
          '<div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">' +
            '<a href="'+deal.crmLink+'" target="_blank" style="color:#58A6FF;text-decoration:none;font-weight:700;font-size:13px;flex:1;">'+deal.name+'</a>' +
            '<span style="color:'+tc+';font-size:11px;font-weight:700;">'+deal.tier+'</span>' +
            '<span style="color:#8B949E;font-size:11px;">'+deal.stage+'</span>' +
            '<span style="color:'+(deal.pct<30?'#ef4444':'#eab308')+';font-size:11px;font-weight:700;">'+deal.done+'/'+deal.total+' ('+deal.pct+'%)</span>' +
          '</div>' +
          '<div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:6px;">' +
            deal.items.map(item => {
              const icon = item.done ? '<span style="color:#22c55e;">&#9989;</span>' : '<span style="color:#ef4444;">&#10060;</span>';
              return '<span style="font-size:11px;color:'+(item.done?'#8B949E':'#E6EDF3')+';">'+icon+' '+item.label+'</span>';
            }).join(' ') +
          '</div>' +
        '</div>';
      }).join('');
  } catch(e) { console.error('Funil error:', e); }
}

// Load Closy scores
async function loadClosy() {
  const sel = document.getElementById('closer-select');
  const closer = sel ? sel.value : '';
  const url = closer ? '/cockpit/closy?closer='+closer : '/cockpit/closy';
  try {
    const res = await fetch(url);

    document.getElementById('forecast-content').innerHTML = `
      <div style="display:flex;gap:14px;flex-wrap:wrap;margin-bottom:12px;">
        <div style="text-align:center;min-width:80px;"><div style="font-size:1.5rem;font-weight:800;color:#06b6d4;">R$ ${(f.projecao/1000).toFixed(0)}k</div><div style="font-size:10px;color:#8B949E;">Projecao</div></div>
        <div style="text-align:center;min-width:80px;"><div style="font-size:1.5rem;font-weight:800;color:${riscoColor};">${f.risco.toUpperCase()}</div><div style="font-size:10px;color:#8B949E;">Risco</div></div>
        <div style="text-align:center;min-width:80px;"><div style="font-size:1.5rem;font-weight:800;">R$ ${(f.mediaDia/1000).toFixed(1)}k</div><div style="font-size:10px;color:#8B949E;">Media/dia</div></div>
        <div style="text-align:center;min-width:80px;"><div style="font-size:1.5rem;font-weight:800;color:#F0C040;">R$ ${(f.necessarioDia/1000).toFixed(1)}k</div><div style="font-size:10px;color:#8B949E;">Necessario/dia</div></div>
        <div style="text-align:center;min-width:80px;"><div style="font-size:1.5rem;font-weight:800;color:#A371F7;">R$ ${(f.propostas.valor/1000).toFixed(0)}k</div><div style="font-size:10px;color:#8B949E;">Em propostas (${f.propostas.total})</div></div>
        <div style="text-align:center;min-width:80px;"><div style="font-size:1.5rem;font-weight:800;color:${trendColor};">${trendSign}${f.trend.diffVsMedia}%</div><div style="font-size:10px;color:#8B949E;">vs media 2 meses</div></div>
      </div>
      <div style="display:flex;gap:8px;overflow-x:auto;">
        ${f.meses.map(m => '<div style="text-align:center;min-width:70px;background:#0D1117;border-radius:8px;padding:8px;"><div style="font-size:10px;color:#6b7280;">'+m.label+'</div><div style="font-size:14px;font-weight:700;color:#2EA043;">R$ '+(m.fat/1000).toFixed(0)+'k</div><div style="font-size:10px;color:#8B949E;">'+m.vendas+'v</div></div>').join('')}
      </div>
    `;
  } catch(e) { console.error('Forecast error:', e); }
}

// Load on page init
renderCockpit('/cockpit/data');
// Score + Gamificacao in parallel
loadScore();
loadGamificacao();
// Coach loads on button click only (faster page load)
</script>


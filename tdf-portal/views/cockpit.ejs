          ${phoneClean?`<a href="tel:+${phoneClean}" style="color:#5ba3f5;font-size:10px;text-decoration:none;background:#0d1520;padding:2px 6px;border-radius:4px;">📞 Ligar</a>`:''}
          ${goto?`<a href="${goto}" target="_blank" style="color:#F0C040;font-size:10px;text-decoration:none;background:#2d2513;padding:2px 6px;border-radius:4px;">GoTo</a>`:''}

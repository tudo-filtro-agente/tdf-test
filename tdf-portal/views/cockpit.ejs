          <div style="text-align:center;"><div style="font-size:2rem;font-weight:800;color:${scoreColor};">${s.avgScore}/100</div><div style="font-size:11px;color:#8B949E;">Score Medio</div></div>
          <div style="text-align:center;"><div style="font-size:1.5rem;font-weight:700;">${s.calls}</div><div style="font-size:11px;color:#8B949E;">Ligacoes</div></div>

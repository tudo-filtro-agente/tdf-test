          <span style="color:${tc};font-size:11px;font-weight:700;">${dl.tier}</span>
          <span style="color:#8B949E;font-size:11px;">sc:${dl.score}</span>
          ${dl.amount ? '<span style="color:#2EA043;font-size:11px;font-weight:600;">R$ '+(parseFloat(dl.amount)||0).toLocaleString('pt-BR')+'</span>' : ''}
          <span style="color:${hrsColor};font-size:11px;font-weight:700;">${hrsLabel} parado</span>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:4px;font-size:11px;color:#8B949E;">
          <span>${dl.stage}</span>
          <span style="color:#58A6FF;">${dl.pipeline}</span>
          ${aguaBadge}
          ${dl.cidade ? '<span>&#128205; '+dl.cidade+'</span>' : ''}
          ${dl.prazo ? '<span>&#9200; '+dl.prazo+'</span>' : ''}
          ${dl.produto ? '<span>&#127919; '+dl.produto+'</span>' : ''}
        </div>
        <div style="margin-top:6px;font-size:12px;">&#127919; ${plano}</div>
        <div style="display:flex;gap:4px;margin-top:6px;flex-wrap:wrap">
          ${phoneClean?`<button onclick="window.sugerirAcao&&sugerirAcao('${dl.id}','${nomeEsc}',this)" style="color:#000;font-size:10px;background:linear-gradient(135deg,#f59e0b,#fbbf24);border:none;padding:3px 8px;border-radius:4px;cursor:pointer;font-weight:800">💡 Sugerir</button>`:''}
          ${phoneClean?`<button onclick="window.abrirChat&&abrirChat('${dl.id}','${phoneClean}','${nomeEsc}')" style="color:#22c55e;font-size:10px;background:#0d2818;border:1px solid #22c55e;padding:3px 8px;border-radius:4px;cursor:pointer;font-weight:700">💬 Chat</button>`:''}
          ${phoneClean?`<a href="tel:+${phoneClean}" style="color:#5ba3f5;font-size:10px;text-decoration:none;background:#0d1520;padding:3px 8px;border-radius:4px;font-weight:600;">📞 Ligar</a>`:''}
          ${goto?`<a href="${goto}" target="_blank" style="color:#F0C040;font-size:10px;text-decoration:none;background:#2d2513;padding:3px 8px;border-radius:4px;font-weight:600;">GoTo</a>`:''}
          <a href="${dl.crmLink}" target="_blank" style="color:#58A6FF;font-size:10px;text-decoration:none;background:#0d1520;padding:3px 8px;border-radius:4px;font-weight:600;">CRM</a>
        </div>
      </div>`;
    }).join('');

    document.getElementById('prop-atraso-valor').textContent = pd.valorAtrasado ? 'R$ '+(pd.valorAtrasado/1000).toFixed(1)+'k parado' : '';
    document.getElementById('prop-atraso-list').innerHTML = (pd.atrasadas||[]).length === 0
      ? '<div style="color:#4ade80;">Nenhuma proposta atrasada</div>'
      : (pd.atrasadas||[]).map(p => renderProposta(p, true)).join('');

    // Won deals (with product + CRM link)
    document.getElementById('won-section').innerHTML = `
      <h3 style="color:#2EA043;margin:0 0 12px 0;font-size:1rem;">&#127942; Vendas do Mes (${k.vendas}) — R$ ${(k.faturamento/1000).toFixed(1)}k</h3>
      ${d.wonDeals.length === 0 ? '<div style="color:#8B949E;font-size:0.85rem;">Nenhuma venda ainda este mes.</div>' :
        d.wonDeals.map(w => {
          const link = w.id ? 'https://crmplus.zoho.com/tudodefiltro3711/index.do/cxapp/crm/org856385701/tab/Potentials/'+w.id : '#';
          const prod = w.Produto_Vendido || '';
          return `<div class="won-row" style="display:flex;align-items:center;gap:8px;">
            <a href="${link}" target="_blank" style="color:#58A6FF;text-decoration:none;flex:1;font-weight:500;">${w.Deal_Name || '?'}</a>
            ${prod ? '<span style="color:#8B949E;font-size:11px;background:#21262D;padding:2px 6px;border-radius:4px;">'+prod+'</span>' : ''}
            <span style="color:#2EA043;font-weight:700;white-space:nowrap;">R$ ${(parseFloat(w.Amount)||0).toLocaleString('pt-BR')}</span>
          </div>`;
        }).join('')}
    `;

  } catch (err) {
    document.getElementById('loading').style.display = 'none';
    document.getElementById('error').style.display = 'block';
    document.getElementById('error').innerHTML = '<div style="font-size:40px;margin-bottom:16px;">&#9888;</div><div>Erro: ' + err.message + '</div><pre style="text-align:left;max-width:600px;margin:12px auto;font-size:11px;color:#8B949E;overflow:auto;">' + (err.stack||'') + '</pre>';
    console.error('Cockpit error:', err);
  }
}

// Load Score + Checklist + Metas
async function loadScore() {
  const sel = document.getElementById('closer-select');
  const closer = sel ? sel.value : '';
  const url = closer ? `/cockpit/score?closer=${closer}` : '/cockpit/score';
  try {
    const res = await fetch(url);
    const s = await res.json();
    if (s.error) return;

    // Score card
    const sc = s.score;
    document.getElementById('score-value').textContent = sc.total;
    document.getElementById('score-value').style.color = sc.classificacaoCor;
    document.getElementById('score-class').innerHTML = `<span style="color:${sc.classificacaoCor};font-weight:700;">${sc.classificacao}</span>`;

    // Breakdown bars
    const bd = sc.breakdown;
    document.getElementById('score-breakdown').innerHTML = Object.values(bd).map(b => {
      const pct = Math.round(b.pts / b.max * 100);
      const color = pct >= 80 ? '#22c55e' : pct >= 50 ? '#eab308' : '#ef4444';
      return `<div style="margin-bottom:6px;">
        <div style="display:flex;justify-content:space-between;font-size:11px;color:#8B949E;">
          <span>${b.label}</span><span style="color:${color};font-weight:700;">${b.pts}/${b.max}</span>
        </div>
        <div style="height:4px;background:#21262D;border-radius:2px;overflow:hidden;">
          <div style="height:100%;width:${pct}%;background:${color};border-radius:2px;"></div>
        </div>
      </div>`;
    }).join('');

    // Checklist
    document.getElementById('check-count').innerHTML =
      `<span style="color:${s.checklistDone===s.checklistTotal?'#22c55e':'#eab308'};">${s.checklistDone}/${s.checklistTotal}</span>`;
    document.getElementById('checklist-items').innerHTML = s.checklist.map(c => {

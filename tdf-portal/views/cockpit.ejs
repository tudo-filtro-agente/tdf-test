      </div>
      <div style="display:flex;justify-content:space-between;font-size:13px;color:#E6EDF3;padding:6px 0;border-bottom:1px solid #21262D;">
        <span>Vendas necessarias/dia</span>
        <span style="font-weight:700;color:#F0C040;">${m.vendasDiarias}</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:13px;color:#E6EDF3;padding:6px 0;border-bottom:1px solid #21262D;">
        <span>Vendas hoje</span>
        <span style="font-weight:700;color:${m.vendasHoje>0?'#22c55e':'#ef4444'};">${m.vendasHoje} (R$ ${(m.fatHoje/1000).toFixed(1)}k)</span>
      </div>
      <div style="display:flex;justify-content:space-between;font-size:13px;color:#E6EDF3;padding:6px 0;border-bottom:1px solid #21262D;">
        <span>Dias sem venda</span>
        <span style="font-weight:700;color:${m.diasSemVenda>2?'#ef4444':m.diasSemVenda>0?'#eab308':'#22c55e'};">${m.diasSemVenda}d</span>

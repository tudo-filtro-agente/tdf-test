// Leads Parados with action plan
function renderParados(deals) {
  // Filter deals parados >4h
  const parados = deals.filter(dl => dl.hoursAgo >= 4).sort((a,b) => {
    const tp = {Diamante:0,Ouro:1,Prata:2,Bronze:3};
    if ((tp[a.tier]??4) !== (tp[b.tier]??4)) return (tp[a.tier]??4) - (tp[b.tier]??4);
    return b.hoursAgo - a.hoursAgo;
  });
  window._paradosAll = parados;

  const valorParado = parados.reduce((s,d) => s + (parseFloat(d.amount)||0), 0);
  document.getElementById('parados-cnt').textContent = parados.length + ' leads';
  document.getElementById('parados-valor').textContent = valorParado > 0 ? 'R$ '+(valorParado/1000).toFixed(1)+'k parado' : '';

  filterParados('all');
}

function fmtPhoneBR(p){
  if (!p) return '';
  const c = String(p).replace(/\D/g,'');
  // 5511999999999 → +55 11 99999-9999  |  11999999999 → (11) 99999-9999
  if (c.length === 13 && c.startsWith('55')) return `+55 ${c.slice(2,4)} ${c.slice(4,9)}-${c.slice(9)}`;
  if (c.length === 11) return `(${c.slice(0,2)}) ${c.slice(2,7)}-${c.slice(7)}`;
  if (c.length === 10) return `(${c.slice(0,2)}) ${c.slice(2,6)}-${c.slice(6)}`;
  return p;
}

function renderDealsList(){
  const all = window._FA_DEALS || [];
  const stage = document.getElementById('fa-stage')?.value || '';
  const tier = document.getElementById('fa-tier')?.value || '';
  const filtered = all.filter(d => {
    if (stage && d.stage !== stage) return false;
    if (tier && d.tier !== tier) return false;
    return true;
  }).slice(0, 30);

  const tierEmoji = { 'Diamante': '💎', 'Ouro': '🥇', 'Prata': '🥈', 'Bronze': '🥉' };
  const tierClass = { 'Diamante': 'diamante', 'Ouro': 'ouro', 'Prata': 'prata', 'Bronze': 'bronze' };
  const list = document.getElementById('deals-list');
  const empty = document.getElementById('deals-empty');

  if (!filtered.length) {
    list.innerHTML = '';
    empty.style.display = '';
    return;
  }
  empty.style.display = 'none';

  list.innerHTML = filtered.map(dl => {
    const emoji = tierEmoji[dl.tier] || '⚪';
    const cls = tierClass[dl.tier] || '';
    const hrsLabel = dl.hoursAgo < 1 ? 'agora' : dl.hoursAgo < 24 ? Math.round(dl.hoursAgo) + 'h' : Math.round(dl.hoursAgo/24) + 'd';
    const hrsColor = dl.hoursAgo > 48 ? '#F85149' : dl.hoursAgo > 12 ? '#D29922' : '#8B949E';

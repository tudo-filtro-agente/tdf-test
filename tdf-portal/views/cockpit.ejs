            <span style="font-size:12px;color:#8B949E;width:40px;text-align:right;">${r.vendas}</span>
            <div style="width:100px;"><div class="progress-bar"><div class="progress-fill" style="width:${pct}%;background:${rc};"></div></div></div>
            <span style="font-size:13px;font-weight:700;color:#E6EDF3;width:70px;text-align:right;">R$ ${(r.faturamento/1000).toFixed(0)}k</span>
          </div>`;
        }).join('')}
      </div>
    `;
  } catch(e) { console.error('Gamificacao error:', e); }
}


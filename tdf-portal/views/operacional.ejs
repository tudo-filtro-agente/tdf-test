async function msSubmit() {
  const name = document.getElementById('ms-name').value.trim();
  const addr = document.getElementById('ms-addr').value.trim();
  const product = document.getElementById('ms-product').value.trim();
  if (!name || !addr || !product) {
    document.getElementById('ms-status').textContent = '❌ Preencha cliente, endereço e produto';
    document.getElementById('ms-status').style.color = '#f87171';
    return;
  }
  document.getElementById('ms-status').textContent = '⏳ criando…';
  document.getElementById('ms-status').style.color = '#888';
  const body = {
    customer_name: name,
    customer_phone: document.getElementById('ms-phone').value.trim() || null,
    customer_email: document.getElementById('ms-email').value.trim() || null,
    raw_address: addr,
    city: document.getElementById('ms-city').value.trim() || null,
    state: document.getElementById('ms-state').value.trim().toUpperCase() || null,
    cep: document.getElementById('ms-cep').value.trim() || null,
    is_condominio: document.getElementById('ms-condo').checked,
    condominio_deadline_time: document.getElementById('ms-condo').checked ? document.getElementById('ms-condo-time').value || null : null,
    condominio_notes: document.getElementById('ms-condo').checked ? document.getElementById('ms-condo-notes-input').value.trim() || null : null,
    product_line: product,
    product_sku: document.getElementById('ms-sku').value.trim() || null,
    service_type: document.getElementById('ms-stype').value,
    queue: document.getElementById('ms-queue').value,
    service_priority: document.getElementById('ms-prio').value,
    required_skill_key: document.getElementById('ms-skill').value || null,
    requires_material_pickup: document.getElementById('ms-pickup').checked,
    observations: document.getElementById('ms-obs').value.trim() || null,
    amount: parseFloat(document.getElementById('ms-amount').value) || null,
    payment_method: document.getElementById('ms-paym').value || null,
    payment_status: document.getElementById('ms-pstatus').value || 'pendente',
    payment_installments: parseInt(document.getElementById('ms-installments').value) || null,
    requested_date: document.getElementById('ms-rdate').value || null,
    date_flexible: document.getElementById('ms-flex').checked,
  };
  try {
    const r = await api('/operacional/api/sales/manual', { method:'POST', body });
    msShowPostCreate(r);
  } catch (e) {
    document.getElementById('ms-status').textContent = '❌ ' + e.message;
    document.getElementById('ms-status').style.color = '#f87171';
  }
}


let _dlvData = {}; let _dlvStages = []; let _dlvColors = {}; let _dlvLabels = {};

async function loadDeliveries() {
  try {
    // Stages config + data em paralelo
    const [stages, data] = await Promise.all([
      api('/operacional/api/kanban/stages?kanban=delivery&active=true'),
      api('/operacional/api/deliveries/kanban'),
    ]);
    _dlvStages = stages;
    _dlvLabels = {}; _dlvColors = {};
    for (const s of stages) { _dlvLabels[s.code] = s.label; _dlvColors[s.code] = s.color; }
    _dlvData = data;
    renderDeliveries();
    // Atualiza badge da aba com total
    const total = Object.values(data).reduce((a, b) => a + (Array.isArray(b)?b.length:0), 0);
    const badge = document.getElementById('t-bebedouros');
    if (badge) badge.textContent = total;
  } catch (e) {
    document.getElementById('dlv-grid').innerHTML = `<div class="kb-empty" style="color:${e.silent?'#888':'#f87171'}">${e.silent?'⏸ aguardando login…':e.message}</div>`;
  }
}

function renderDeliveries() {
  const grid = document.getElementById('dlv-grid');
  const seen = new Set();
  const order = [];
  for (const s of _dlvStages) { order.push(s.code); seen.add(s.code); }
  for (const code of Object.keys(_dlvData)) if (!seen.has(code)) { order.push(code); seen.add(code); }

  grid.innerHTML = order.map(stage => {
    const items = _dlvData[stage] || [];
    const label = _dlvLabels[stage] || stage;
    const color = _dlvColors[stage] || '#475569';
    return `
      <div class="kb-col" data-stage="${stage}" ondragover="dlvDragOver(event)" ondragleave="dlvDragLeave(event)" ondrop="dlvDrop(event)" style="border-top:3px solid ${color}">
        <div class="kb-col-h">
          <span>${label}</span>
          <span class="count">${items.length}</span>
        </div>
        <div class="kb-col-body">
          ${items.length === 0 ? '<div class="kb-empty">—</div>' : items.map(it => `
            <div class="kb-card" draggable="true" ondragstart="dlvDragStart(event,${it.id},'${stage}')" ondragend="dlvDragEnd(event)" onclick="dlvOpenDetail(${it.id})" style="border-left:3px solid ${color}">
              <div class="kc-name">${it.customer_name || '—'}</div>
              <div class="kc-meta">
                ${it.product ? `<b>${(it.product||'').substring(0,40)}</b><br>` : ''}
                ${it.city ? `📍 ${it.city}<br>` : ''}
                ${it.technician_name ? `👷 ${it.technician_name}<br>` : ''}
                ${it.ideal_delivery_date ? `📅 ${new Date(it.ideal_delivery_date).toLocaleDateString('pt-BR')}` : ''}
                ${it.delivery_window ? ` · ${it.delivery_window}` : ''}
                ${it.route_id ? `<br>🛣 Rota #${it.route_id}` : ''}
                ${it.proof_url ? `<br><a href="${it.proof_url}" target="_blank" style="color:#22c55e" onclick="event.stopPropagation()">📷 Comprovante</a>` : ''}
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }).join('');
}


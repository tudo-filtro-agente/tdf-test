      </div>

      <div style="font-size:11px;color:#93c5fd;margin-bottom:8px;font-weight:700">🤖 Sugestões IA — rotas compatíveis</div>
      ${fits && fits.fits?.length ? fits.fits.map(f => `
        <div style="background:#161B22;border:1px solid #21262D;border-left:3px solid #22c55e;border-radius:6px;padding:10px 12px;margin-bottom:6px;display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center">
          <div>
            <div style="color:#fff;font-weight:700;font-size:12px">Rota #${f.route_id} · ${f.technician_name||'sem técnico'}</div>
            <div style="color:#888;font-size:10px;margin-top:2px">${f.rationale}</div>

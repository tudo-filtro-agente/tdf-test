        <button class="btn btn-warn" onclick="pdActSelectAll()">Marcar todas</button>
        <button class="btn btn-warn" onclick="pdActCreateRoute()">🛣 Criar rota</button>
        <button class="btn btn-pri" style="background:#22c55e;color:#000;border-color:#22c55e" onclick="pdActAutoDist()">🤖 Auto-distribuir tudo</button>
      </div>
      <div style="flex:1;overflow-y:auto" id="pd-list"><div style="padding:30px;text-align:center;color:#666">Carregando…</div></div>
    </div>
  `;
  PEND.selected = new Set();
  await pdLoad();
}

async function pdLoad() {
  try {
    const r = await api('/operacional/api/sales?status=aguardando_rota&page_size=300');
    PEND.items = r.items || [];
    pdRender();
  } catch (e) {
    document.getElementById('pd-list').innerHTML = `<div style="padding:30px;text-align:center;color:${e.silent?'#888':'#f87171'}">${e.silent?'⏸ aguardando login…':e.message}</div>`;
  }
}

function pdFilter() { pdRender(); }

function pdRender() {
  const q = (document.getElementById('pd-search')?.value || '').toLowerCase();
  const filtered = q
    ? PEND.items.filter(s => (s.customer_name||'').toLowerCase().includes(q) || (s.address?.city||'').toLowerCase().includes(q) || (s.product_line||'').toLowerCase().includes(q))
    : PEND.items;
  const c = document.getElementById('pd-list');
  if (!PEND.items.length) {
    c.innerHTML = '<div style="padding:30px;text-align:center;color:#666;font-size:12px">🎉 Nenhuma sale aguardando rota</div>';
    return;
  }
  if (!filtered.length) { c.innerHTML = '<div style="padding:30px;text-align:center;color:#666;font-size:12px">Nenhum resultado pra essa busca</div>'; return; }
  c.innerHTML = filtered.map(s => {
    const prio = s.service_priority || 'normal';
    const prioColor = { urgent:'#ef4444', high:'#fb923c', normal:'#888', low:'#666' }[prio] || '#888';
    return `
      <label style="display:grid;grid-template-columns:24px 1fr auto;gap:10px;padding:10px 14px;border-bottom:1px solid #21262D;cursor:pointer;align-items:center">
        <input type="checkbox" data-sale="${s.id}" ${PEND.selected.has(s.id)?'checked':''} onchange="pdToggle(${s.id}, this.checked)">
        <div>
          <div style="color:#fff;font-size:13px;font-weight:700">${s.customer_name||'—'} ${s.is_condominio?'🏢':''} ${s.requires_material_pickup?'📦':''} ${s.required_skill_key?'🎯':''}</div>
          <div style="color:#888;font-size:11px;margin-top:2px">${(s.product_line||'').substring(0,60)} · <span style="color:${prioColor}">${prio}</span> · 📍 ${s.address?.city||'sem cidade'}${s.amount?' · 💰 R$ '+parseFloat(s.amount).toLocaleString('pt-BR',{minimumFractionDigits:2}):''}</div>
          ${s.requested_date ? `<div style="color:#22d3ee;font-size:10px;margin-top:2px">📅 Data solicitada: ${new Date(s.requested_date).toLocaleDateString('pt-BR')} ${s.date_flexible?'(flexível)':'(fixa)'}</div>` : ''}
        </div>
        <a href="/operacional/cliente/${s.id}" target="_blank" style="color:#93c5fd;text-decoration:none;font-size:11px;padding:4px 8px" onclick="event.stopPropagation()">→ Card</a>
      </label>
    `;
  }).join('');
  document.getElementById('pd-sel').textContent = PEND.selected.size;
}

function pdToggle(saleId, checked) {
  if (checked) PEND.selected.add(saleId); else PEND.selected.delete(saleId);
  document.getElementById('pd-sel').textContent = PEND.selected.size;
}

function pdActSelectAll() {
  const q = (document.getElementById('pd-search')?.value || '').toLowerCase();
  const visible = q
    ? PEND.items.filter(s => (s.customer_name||'').toLowerCase().includes(q) || (s.address?.city||'').toLowerCase().includes(q) || (s.product_line||'').toLowerCase().includes(q))
    : PEND.items;
  visible.forEach(s => PEND.selected.add(s.id));
  pdRender();
}


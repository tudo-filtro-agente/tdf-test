function newRouteClose() {
  const m = document.getElementById('nr-modal');
  if (m) m.style.display = 'none';
}

async function newRouteLoadTechs() {
  try {
    const techs = await api('/operacional/api/technicians');
    const list = Array.isArray(techs) ? techs : (techs.items || []);
    _newRoute.technicians = list.filter(t => t.active);
    const sel = document.getElementById('nr-tech');
    sel.innerHTML = '<option value="">— selecione —</option>' + _newRoute.technicians.map(t =>
      `<option value="${t.id}" data-capacity="${t.daily_capacity||8}">${t.name} (capacidade ${t.daily_capacity||8})</option>`
    ).join('');
    sel.onchange = newRouteCheckCapacity;
  } catch (e) { console.error(e); }
}

async function newRouteLoadSales() {
  try {
    const r = await api('/operacional/api/sales?status=aguardando_rota&page_size=200');
    _newRoute.eligibleSales = r.items || [];
    document.getElementById('nr-total').textContent = _newRoute.eligibleSales.length;
    newRouteRender();
  } catch (e) { console.error(e); }
}

function newRouteFilter() {
  newRouteRender();
}

function newRouteRender() {
  const q = (document.getElementById('nr-search')?.value || '').toLowerCase();
  const filtered = q
    ? _newRoute.eligibleSales.filter(s =>
        (s.customer_name||'').toLowerCase().includes(q)
        || (s.address?.city||'').toLowerCase().includes(q)
        || (s.product_line||'').toLowerCase().includes(q)
      )
    : _newRoute.eligibleSales;
  document.getElementById('nr-sales').innerHTML = filtered.length
    ? filtered.map(s => `
      <label style="display:grid;grid-template-columns:24px 1fr auto;gap:8px;padding:8px 10px;border-bottom:1px solid #21262D;cursor:pointer;align-items:center">
        <input type="checkbox" data-sale="${s.id}" ${_newRoute.saleIds.has(s.id)?'checked':''} onchange="newRouteToggle(${s.id}, this.checked)">
        <div>
          <div style="color:#fff;font-size:12px;font-weight:700">${s.customer_name||'—'}</div>
          <div style="color:#888;font-size:10px">${(s.product_line||'').substring(0,60)} · ${s.address?.city||'—'}</div>
        </div>
        <span style="font-size:10px;color:#888">${s.service_type||''} · ${s.service_priority||'normal'}</span>
      </label>
    `).join('')
    : '<div style="padding:20px;text-align:center;color:#666;font-size:12px">Nenhum sale elegível encontrado</div>';
  newRouteCheckCapacity();
}

function newRouteToggle(saleId, checked) {
  if (checked) _newRoute.saleIds.add(saleId); else _newRoute.saleIds.delete(saleId);
  document.getElementById('nr-selected-count').textContent = _newRoute.saleIds.size;
  newRouteCheckCapacity();
}

function newRouteCheckCapacity() {
  const opt = document.querySelector('#nr-tech option:checked');
  const cap = parseInt(opt?.dataset?.capacity || '0') || 0;
  const sel = _newRoute.saleIds.size;
  document.getElementById('nr-tech-cap').textContent = cap ? `Capacidade técnico: ${sel}/${cap}` : 'Capacidade: —';
  const warn = document.getElementById('nr-capacity-warn');
  if (cap && sel > cap) {
    warn.style.display = 'block';
    warn.textContent = `⚠ Excede capacidade do técnico (${sel} paradas > ${cap}). Considere dividir em rotas separadas.`;
  } else { warn.style.display = 'none'; }
}

let _nrSubmitting = false;
let _lastCreatedRouteId = null;

async function newRouteSave(confirm) {
  if (_nrSubmitting) return;
  const date = document.getElementById('nr-date').value;
  const tech = document.getElementById('nr-tech').value;
  const wind = document.getElementById('nr-window').value;
  if (!date) return toast('Data obrigatória', 'error');
  if (!tech) return toast('Técnico obrigatório', 'error');
  if (_newRoute.saleIds.size === 0) return toast('Selecione ao menos 1 sale', 'error');
  _nrSubmitting = true;
  try {
    const r = await api('/operacional/api/routes', {
      method: 'POST',
      body: {
        route_date: date,
        technician_id: parseInt(tech),
        sale_ids: Array.from(_newRoute.saleIds),
        window: wind || null,
        status: 'pendente',
      }
    });
    _lastCreatedRouteId = r.route_id;
    let confirmedMsg = '';
    if (confirm && r.route_id) {
      const c = await api(`/operacional/api/routes/${r.route_id}/confirm`, { method:'POST', body:{} });
      confirmedMsg = ` + ${c.sales_updated || 0} confirmadas`;
    }
    toast(`Rota #${r.route_id} criada: ${r.sales_moved} sale(s) ${confirmedMsg} ✓`);
    // Em vez de fechar, mostra painel de ações pós-criação
    showRouteCreatedActions(r.route_id, r.technician_name);
    loadKpis(); loadSales();
  } catch (e) {
    toast(e.message, 'error');
  } finally {
    _nrSubmitting = false;
  }
}


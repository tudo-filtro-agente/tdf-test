async function loadRouteFits() {
  const body = document.getElementById('rf-body');
  body.classList.add('show');
  document.getElementById('rf-arrow').textContent = '▲';
  body.innerHTML = '<div style="color:#888;text-align:center;padding:14px">Calculando…</div>';
  const max_km = document.getElementById('rf-max-km').value || 10;
  const days_ahead = document.getElementById('rf-days').value || 7;
  try {
    const r = await api(`/operacional/api/deliveries/route-fits?max_km=${max_km}&days_ahead=${days_ahead}&min_score=30`);
    _rfData = r.items || [];
    document.getElementById('rf-count').textContent = _rfData.length;
    if (!_rfData.length) {
      body.innerHTML = '<div style="color:#888;text-align:center;padding:14px">Nenhum encaixe encontrado dentro dos parâmetros. Aumente o raio ou os dias.</div>';
      return;
    }
    // Agrupa por delivery
    const byDelivery = {};
    for (const s of _rfData) {
      if (!byDelivery[s.delivery_id]) byDelivery[s.delivery_id] = [];
      byDelivery[s.delivery_id].push(s);
    }
    body.innerHTML = Object.values(byDelivery).map(group => {
      const top = group[0];
      return group.map((s, idx) => {
        const cls = s.score >= 70 ? '' : (s.score >= 50 ? 'med' : 'low');
        return `
          <div class="rf-card">
            <div class="info">
              <div class="name">${idx === 0 ? `📦 ${s.delivery_customer}` : '↳ alternativa'} ${idx === 0 ? `<span style="color:#888;font-size:11px;font-weight:400">— ${s.delivery_product || ''}</span>` : ''}</div>
              <div class="meta">📍 ${s.delivery_city || '—'} ${s.delivery_ideal_date ? `· ideal ${new Date(s.delivery_ideal_date).toLocaleDateString('pt-BR')}` : ''}</div>
              <div class="ratio">→ Rota #${s.route_id} (${new Date(s.route_date).toLocaleDateString('pt-BR')}) · ${s.rationale}</div>
              <div style="color:#94a3b8;font-size:10px;margin-top:2px">⏱ +${s.added_time_min} min · ${s.distance_km} km</div>
            </div>
            <div class="score">
              <div class="pts ${cls}">${s.score}</div>
              <div class="actions">
                <button class="btn btn-warn" style="padding:5px 10px;font-size:11px" onclick="rfAccept(${s.delivery_id}, ${s.route_id}, ${s.technician_id || 'null'})">Aceitar</button>
                <button class="btn btn-sec" style="padding:5px 10px;font-size:11px" onclick="dlvOpenDetail(${s.delivery_id})">Detalhes</button>
              </div>
            </div>
          </div>
        `;
      }).join('');
    }).join('');
  } catch (e) {
    body.innerHTML = `<div style="color:${e.silent?'#888':'#f87171'};padding:14px">${e.silent?'⏸ aguardando login…':e.message}</div>`;
  }
}
async function rfAccept(deliveryId, routeId, techId) {
  if (!confirm(`Vincular delivery #${deliveryId} à rota #${routeId}?`)) return;
  try {
    await api(`/operacional/api/deliveries/${deliveryId}/assign-route`, {
      method:'POST', body:{ route_id: routeId, technician_id: techId || null }
    });
    toast('Encaixe aceito ✓');
    await Promise.all([loadDeliveries(), loadRouteFits()]);
  } catch (e) { toast(e.message, 'error'); }
}

async function dlvBackfill() {
  if (!confirm('Rodar backfill — cria Delivery a partir de Sales com delivery_type=entrega_propria|instalacao_propria que ainda não tenham Delivery. Continuar?')) return;
  try {
    const r = await api('/operacional/api/deliveries/backfill', { method: 'POST', body: {} });
    toast(`Backfill: ${r.created} criadas, ${r.skipped} já existiam`);
    await loadDeliveries();
  } catch (e) { toast(e.message, 'error'); }
}


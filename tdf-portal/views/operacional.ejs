function pvRender(elId, items) {
  const el = document.getElementById(elId);
  if (!items.length) {
    el.innerHTML = '<div class="pv-empty">Sem itens</div>';
    return;
  }
  el.innerHTML = items.map(r => {
    const stars = r.satisfaction_score ? '⭐'.repeat(r.satisfaction_score) + '☆'.repeat(5 - r.satisfaction_score) : '';
    const statusBadge = r.status === 'escalado' ? '<span style="background:#ef4444;color:#fff;font-size:9px;padding:1px 6px;border-radius:3px;font-weight:700">ESCALADO</span>' : '';
    return `
      <div class="pv-card" onclick="pvdOpen(${r.id})">
        <div class="name">${r.customer_name || '—'} ${statusBadge}</div>
        <div class="meta">
          ${stars ? `<div class="stars">${stars} ${r.satisfaction_score}/5</div>` : ''}
          ${r.current_stage ? `🏷 ${r.current_stage}<br>` : ''}
          ${r.next_action ? `🎯 ${r.next_action.substring(0,60)}<br>` : ''}
          ${r.upsell_opportunity ? `💰 ${r.upsell_opportunity}${r.upsell_value_estimated ? ' (R$ ' + parseFloat(r.upsell_value_estimated).toLocaleString('pt-BR',{minimumFractionDigits:0}) + ')' : ''}<br>` : ''}
          ${r.pendencies ? `⚠ ${r.pendencies.substring(0,60)}<br>` : ''}
          ${r.internal_owner ? `👤 ${r.internal_owner}<br>` : ''}
          ${r.last_contact_at
            ? `📅 ${new Date(r.last_contact_at).toLocaleDateString('pt-BR')}`
            : '<span style="color:#fb923c">📅 sem contato</span>'
          }
        </div>
        <div class="actions">
          <button onclick="event.stopPropagation();pvContact(${r.id})" title="Marcar contato feito agora">📞 Contato</button>
          ${r.status !== 'escalado' ? `<button onclick="event.stopPropagation();pvEscalate(${r.id})" style="border-color:#ef4444;color:#ef4444">🚨 Escalar</button>` : ''}
        </div>
      </div>
    `;
  }).join('');
}

// ===== Drawer Pós-Venda — F-POSVENDA-REAL =====
let _pvdCurrent = null;
async function pvdOpen(id) {
  document.getElementById('pvd-overlay').classList.add('show');
  document.getElementById('pvd-name').textContent = 'Carregando…';
  document.getElementById('pvd-body').innerHTML = '<div style="color:#666;padding:20px;text-align:center">Carregando…</div>';
  try {
    const r = await api(`/operacional/api/post-sale/${id}`);
    _pvdCurrent = r;
    pvdRender();
  } catch (e) {
    document.getElementById('pvd-body').innerHTML = `<div style="color:${e.silent?'#888':'#f87171'};padding:20px">${e.silent?'⏸ aguardando login…':e.message}</div>`;
  }
}
function pvdClose() { document.getElementById('pvd-overlay').classList.remove('show'); _pvdCurrent = null; }

function pvdRender() {
  const r = _pvdCurrent;
  if (!r) return;
  const stars = r.satisfaction_score ? '⭐'.repeat(r.satisfaction_score) + '☆'.repeat(5 - r.satisfaction_score) : '—';
  document.getElementById('pvd-name').textContent = r.customer_name || `Pós-venda #${r.id}`;
  document.getElementById('pvd-meta').innerHTML = `Sale #${r.sale_id} · ${r.status || 'sem status'} · ${stars}`;

  const ed = (key, label, type='text', val=null) => {
    const v = val !== null ? val : (r[key] ?? '');
    return `
      <div class="pvd-row">
        <div class="lbl">${label}</div>
        <div class="val">
          ${type === 'textarea' ? `<textarea data-field="${key}">${v||''}</textarea>` :
            type === 'select-status' ? `
              <select data-field="${key}">
                <option value="">—</option>
                <option value="aguardando_contato" ${v==='aguardando_contato'?'selected':''}>Aguardando contato</option>
                <option value="em_andamento" ${v==='em_andamento'?'selected':''}>Em andamento</option>
                <option value="concluido" ${v==='concluido'?'selected':''}>Concluído</option>
                <option value="escalado" ${v==='escalado'?'selected':''}>Escalado</option>
              </select>` :
            type === 'select-score' ? `
              <select data-field="${key}">
                <option value="">—</option>
                ${[1,2,3,4,5].map(n => `<option value="${n}" ${parseInt(v)===n?'selected':''}>${'⭐'.repeat(n)} (${n})</option>`).join('')}
              </select>` :
            type === 'checkbox' ? `<input type="checkbox" data-field="${key}" ${v ? 'checked' : ''}>` :
            type === 'datetime' ? `<input type="datetime-local" data-field="${key}" value="${v ? new Date(v).toISOString().slice(0,16) : ''}">` :
            `<input type="${type}" data-field="${key}" value="${(v||'').toString().replace(/"/g,'&quot;')}">`
          }
        </div>
      </div>`;
  };

  document.getElementById('pvd-body').innerHTML = `
    <div class="pvd-section">
      <h4>📋 Status</h4>
      ${ed('status', 'Status', 'select-status')}
      ${ed('current_stage', 'Etapa atual')}
      ${ed('internal_owner', 'Responsável')}
      <div class="pvd-row"><div class="lbl">Último contato</div><div class="val">${r.last_contact_at ? new Date(r.last_contact_at).toLocaleString('pt-BR') : '—'}</div></div>
    </div>

    <div class="pvd-section">
      <h4>⭐ Satisfação</h4>
      ${ed('satisfaction_score', 'Nota (1-5)', 'select-score')}
    </div>

    <div class="pvd-section">
      <h4>🎯 Próxima ação</h4>
      ${ed('next_action', 'Ação', 'textarea')}
      ${ed('next_action_at', 'Data/hora', 'datetime')}
    </div>

    <div class="pvd-section">
      <h4>💰 Upsell</h4>
      ${ed('upsell_opportunity', 'Oportunidade')}
      ${ed('upsell_value_estimated', 'Valor estimado (R$)', 'number')}
    </div>

    <div class="pvd-section">
      <h4>🛠 Suporte técnico</h4>
      ${ed('needs_tech_support', 'Precisa suporte?', 'checkbox')}
      ${ed('pendencies', 'Pendências', 'textarea')}
      ${ed('observations', 'Observações', 'textarea')}
    </div>

    <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap">
      <button class="btn btn-pri" onclick="pvdSave()" style="background:#1f6feb;color:#fff;border-color:#1f6feb">💾 Salvar alterações</button>
      <button class="btn btn-sec" onclick="pvContact(${r.id});pvdClose()">📞 Marcar contato agora</button>
      ${r.status !== 'escalado' ? `<button class="btn btn-danger" style="border-color:#ef4444;color:#ef4444" onclick="pvEscalate(${r.id});pvdClose()">🚨 Escalar</button>` : ''}
      <a href="/operacional/cliente/${r.sale_id}" target="_blank" class="btn btn-sec" style="text-decoration:none">📋 Card cliente</a>
    </div>
  `;
}

async function pvdSave() {
  if (!_pvdCurrent) return;
  const fields = {};
  document.querySelectorAll('#pvd-body [data-field]').forEach(el => {
    const k = el.dataset.field;
    let v = el.type === 'checkbox' ? el.checked : el.value;
    if (v === '') v = null;
    if (k === 'satisfaction_score' || k === 'upsell_value_estimated') v = v ? parseFloat(v) : null;
    if (k === 'next_action_at' && v) v = new Date(v).toISOString();
    fields[k] = v;
  });
  try {
    await api(`/operacional/api/post-sale/${_pvdCurrent.id}`, { method: 'PATCH', body: fields });
    toast('Alterações salvas ✓');
    await loadPosvenda();
    pvdClose();
  } catch (e) { toast(e.message, 'error'); }
}


          <label>Responsável</label><input id="dlv-c-resp" type="text" placeholder="Email/nome" style="background:var(--bg);border:1px solid var(--border);color:var(--text);padding:7px;border-radius:4px">
          <label>Observação</label><textarea id="dlv-c-notes" rows="2" style="background:var(--bg);border:1px solid var(--border);color:var(--text);padding:7px;border-radius:4px"></textarea>

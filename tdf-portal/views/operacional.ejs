    </div>
  `;
  const foot = modal.querySelector('div[style*="border-top"]');
  foot.innerHTML = `<button class="btn btn-prim" onclick="document.getElementById('ms-modal').remove();loadKpis();loadSales()" style="margin-left:auto;background:#1f6feb;color:#fff;border-color:#1f6feb">✓ Fechar</button>`;

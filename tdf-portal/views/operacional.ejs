// ===== SEARCH GLOBAL =====
const SEARCH = { timer: null, lastQ: '' };
const KIND_META = {
  sale:        { icon: '🛒', label: 'Venda',       color: '#25D366' },
  shipment:    { icon: '📦', label: 'Envio',       color: '#a371f7' },
  visit:       { icon: '🛠', label: 'Visita',      color: '#22c55e' },
  post_sale:   { icon: '📞', label: 'Pós-venda',   color: '#fb923c' },
  address:     { icon: '📍', label: 'Endereço',    color: '#93c5fd' },
  vehicle:     { icon: '🚗', label: 'Veículo',     color: '#fb7185' },
  technician:  { icon: '👷', label: 'Técnico',     color: '#fbbf24' },
};
const searchInput = document.getElementById('op-search');
const searchResults = document.getElementById('op-search-results');

searchInput.addEventListener('input', () => {
  const q = searchInput.value.trim();
  clearTimeout(SEARCH.timer);
  if (q.length < 2) {
    searchResults.style.display = 'none';
    return;
  }
  SEARCH.timer = setTimeout(() => doSearch(q), 300);
});
searchInput.addEventListener('focus', () => {
  if (searchInput.value.trim().length >= 2) searchResults.style.display = 'block';
});
document.addEventListener('click', (e) => {
  if (!e.target.closest('#op-search') && !e.target.closest('#op-search-results')) {
    searchResults.style.display = 'none';
  }
});

async function doSearch(q) {
  if (q === SEARCH.lastQ) return;
  SEARCH.lastQ = q;
  searchResults.innerHTML = '<div style="padding:14px;color:#888;font-size:12px">Buscando…</div>';
  searchResults.style.display = 'block';
  try {
    const res = await api(`/operacional/api/search?q=${encodeURIComponent(q)}&limit=20`);
    if (!res.results || !res.results.length) {
      searchResults.innerHTML = '<div style="padding:14px;color:#666;font-size:12px;text-align:center">Nada encontrado</div>';
      return;
    }
    // Agrupar por kind
    const grouped = {};
    res.results.forEach(r => {
      const k = r.kind;
      if (!grouped[k]) grouped[k] = [];
      grouped[k].push(r);
    });
    const order = ['sale', 'shipment', 'visit', 'post_sale', 'address', 'vehicle', 'technician'];
    const html = order
      .filter(k => grouped[k] && grouped[k].length)
      .map(k => {
        const meta = KIND_META[k];
        const items = grouped[k].slice(0, 5).map(r => searchItemHTML(k, r)).join('');
        return `
          <div style="padding:8px 12px 4px;background:#0D1117;border-bottom:1px solid #21262D">
            <span style="font-size:10px;color:${meta.color};text-transform:uppercase;letter-spacing:.5px;font-weight:700">${meta.icon} ${meta.label} <span style="color:#666">·${grouped[k].length}</span></span>
          </div>
          ${items}
        `;
      }).join('');
    searchResults.innerHTML = html;
  } catch (e) {
    searchResults.innerHTML = `<div style="padding:14px;color:#f87171;font-size:12px">${e.message}</div>`;
  }
}

function searchItemHTML(kind, r) {
  const cust = r.customer_name || r.name || r.plate || '—';
  let detail = '';
  if (kind === 'sale') {
    detail = [r.product_line, r.queue, r.status, r.pedido_sige ? `SIGE ${r.pedido_sige}` : null, r.city]
      .filter(Boolean).join(' · ');
  } else if (kind === 'shipment') {
    detail = `${r.tracking_code || '—'} · ${r.stage}`;
  } else if (kind === 'visit') {
    detail = `${r.visit_type} · ${r.status}${r.auvo_task_id ? ' · AUVO ' + r.auvo_task_id : ''}`;
  } else if (kind === 'post_sale') {
    detail = `stage ${r.stage || '?'}${r.zoho_postsale_id ? ' · ' + r.zoho_postsale_id : ''}`;
  } else if (kind === 'address') {
    detail = r.address || r.city || '';
  } else if (kind === 'vehicle') {
    detail = `${r.model || ''}${r.tech_name ? ' · ' + r.tech_name : ''}`;
  } else if (kind === 'technician') {
    detail = [r.phone, r.base_city, r.active ? 'ativo' : 'inativo'].filter(Boolean).join(' · ');
  }
  const action = onClickFor(kind, r);
  return `
    <div onclick="${action}" style="padding:10px 14px;cursor:pointer;border-bottom:1px solid #21262D" onmouseenter="this.style.background='rgba(37,211,102,.05)'" onmouseleave="this.style.background=''">
      <div style="color:#fff;font-weight:600;font-size:12px">${cust}</div>
      <div style="color:#888;font-size:11px;margin-top:2px">${detail}</div>
    </div>
  `;
}

function onClickFor(kind, r) {
  if (r.sale_id) {
    return `selectSale(${r.sale_id});document.querySelector('[data-tab=instalacoes]').click();document.getElementById('op-search-results').style.display='none';document.getElementById('op-search').value='';`;
  }
  if (kind === 'vehicle') {
    return `window.location.href='/operacional/cadastros'`;
  }
  if (kind === 'technician') {
    return `window.location.href='/operacional/cadastros'`;
  }
  return '';
}

// INIT
(async () => {
  initMap();
  await loadSales();
  await loadKpis();
  // Auto-refresh a cada 60s
  setInterval(loadSales, 60000);
  setInterval(loadKpis, 120000);
  // Tutorial automático na primeira visita
  if (!localStorage.getItem('op_tut_seen_v1')) {
    setTimeout(() => startTutorial(true), 1500);
  }
})();


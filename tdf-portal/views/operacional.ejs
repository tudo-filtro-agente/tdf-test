// F8 — Alert Engine: drawer lateral
const ALERT_TYPE_LABEL = {
  intake_awaiting: '🤖 Intake aguardando',
  sale_unrouted_48h: '📦 Venda sem rota',
  shipment_stuck: '🚚 Envio parado',
  visit_pending_creation: '🔧 Visit pendente AUVO',
  refill_overdue: '💧 Refil vencido',
  postsale_low_sat: '😞 Satisfação baixa',
  route_overrun: '⚠️ Rota fora do plano',
  geofence_violation: '📍 Geofence violada',
  speed_excess: '🏎 Excesso de velocidade',
};
const SEV_COLOR = { critical: '#ef4444', warning: '#fb923c', info: '#fbbf24' };
const SEV_RANK = { critical: 0, warning: 1, info: 2 };

async function openAlertsDrawer() {
  const dr = document.getElementById('alerts-drawer');
  if (!dr) return;
  dr.style.display = 'flex';
  setTimeout(() => dr.classList.add('open'), 10);
  await loadAlertsList();
}
function closeAlertsDrawer() {
  const dr = document.getElementById('alerts-drawer');
  if (!dr) return;
  dr.classList.remove('open');
  setTimeout(() => { dr.style.display = 'none'; }, 250);
}
async function loadAlertsList() {
  const body = document.getElementById('alerts-drawer-body');
  if (!body) return;
  body.innerHTML = '<div style="padding:20px;color:#888;text-align:center">Carregando…</div>';
  try {
    const filter = document.getElementById('alerts-drawer-filter')?.value || 'open';
    const r = await api(`/operacional/api/alerts?status=${filter}&limit=200`);
    const alerts = r.alerts || [];
    if (alerts.length === 0) {
      body.innerHTML = '<div style="padding:30px;color:#22c55e;text-align:center;font-size:13px">✅ Nenhum alerta nesse filtro.</div>';
      return;
    }
    alerts.sort((a, b) => (SEV_RANK[a.severity] ?? 9) - (SEV_RANK[b.severity] ?? 9));
    let html = '';
    let lastSev = null;
    for (const a of alerts) {
      if (a.severity !== lastSev) {
        html += `<div style="padding:10px 14px 4px;font-size:10px;font-weight:800;letter-spacing:1px;color:${SEV_COLOR[a.severity]||'#888'};text-transform:uppercase">${a.severity}</div>`;
        lastSev = a.severity;
      }
      const label = ALERT_TYPE_LABEL[a.alert_type] || a.alert_type;
      const ts = a.last_seen_at ? new Date(a.last_seen_at).toLocaleString('pt-BR') : '';
      const link = a.link ? `<a href="${a.link}" style="color:#58a6ff;font-size:11px;text-decoration:none">abrir ↗</a>` : '';
      const acked = a.status === 'acked';
      const resolved = a.status === 'resolved';
      const ackBtn = !acked && !resolved
        ? `<button onclick="ackAlert(${a.id})" style="background:transparent;border:1px solid #444;color:#aaa;padding:3px 8px;border-radius:4px;font-size:10px;cursor:pointer">marcar visto</button>`
        : (acked ? `<span style="font-size:10px;color:#888">✓ visto por ${a.acked_by||'?'}</span>` : '');
      const resBtn = !resolved
        ? `<button onclick="resolveAlert(${a.id})" style="background:transparent;border:1px solid #22c55e;color:#22c55e;padding:3px 8px;border-radius:4px;font-size:10px;cursor:pointer">resolver</button>`
        : `<span style="font-size:10px;color:#22c55e">✓ resolvido</span>`;
      html += `<div style="padding:10px 14px;border-bottom:1px solid #21262D;display:flex;flex-direction:column;gap:6px${resolved?';opacity:0.55':''}">
        <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
          <span style="font-size:11px;font-weight:700;color:${SEV_COLOR[a.severity]||'#fff'}">${label}</span>
          ${link}
        </div>
        <div style="font-size:12px;color:#e6edf3;line-height:1.35">${escapeHTML(a.message)}</div>
        <div style="display:flex;justify-content:space-between;align-items:center;gap:6px;flex-wrap:wrap">
          <span style="font-size:10px;color:#666">${ts}</span>
          <div style="display:flex;gap:6px">${ackBtn} ${resBtn}</div>
        </div>
      </div>`;
    }
    body.innerHTML = html;
  } catch (e) {
    body.innerHTML = `<div style="padding:20px;color:#ef4444">Erro: ${escapeHTML(e.message||String(e))}</div>`;
  }
}
async function ackAlert(id) {
  try {
    await api(`/operacional/api/alerts/${id}/ack`, { method: 'POST' });
    await loadAlertsList();
    await loadBellCount();
  } catch (e) { toast(e.message, 'error'); }
}
async function resolveAlert(id) {
  try {
    await api(`/operacional/api/alerts/${id}/resolve`, { method: 'POST' });
    await loadAlertsList();
    await loadBellCount();
  } catch (e) { toast(e.message, 'error'); }
}
function escapeHTML(s) {
  return String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}


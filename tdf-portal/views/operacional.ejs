async function msActionAddToRoute(saleId, routeId) {
  try {
    await api(`/operacional/api/routes/${routeId}/stops`, { method:'POST', body:{ sale_ids:[saleId] } });
    toast(`Sale #${saleId} encaixada na rota #${routeId} ✓`);
    document.getElementById('ms-modal').remove();
    loadKpis(); loadSales();
  } catch (e) { toast(e.message, 'error'); }
}

async function msActionRouteSolo(saleId) {
  const date = prompt('Data da rota (YYYY-MM-DD):', new Date(Date.now()+86400000).toISOString().slice(0,10));
  if (!date) return;
  const techId = prompt('Technician ID (deixe vazio pra escolher depois):');
  if (!techId) return toast('Técnico obrigatório', 'error');
  try {
    const r = await api('/operacional/api/routes', { method:'POST', body:{ route_date: date, technician_id: parseInt(techId), sale_ids:[saleId], status:'pendente' } });
    toast(`Rota #${r.route_id} criada ✓`);
    document.getElementById('ms-modal').remove();
    loadKpis(); loadSales();
  } catch (e) { toast(e.message, 'error'); }
}

function msActionLeaveWaiting(saleId) {
  toast(`Sale #${saleId} fica em aguardando_rota; o auto-distribute vai pegar depois.`);
  document.getElementById('ms-modal').remove();
  loadKpis(); loadSales();
}


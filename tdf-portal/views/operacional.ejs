// Fallback estático caso /kanban/stages falhe; substituído após primeiro load.
let STAGE_LABELS = {
  aguardando_separacao: '📋 Aguardando Separação',
  em_separacao: '📦 Em Separação',
  aguardando_coleta: '🕐 Aguard. Coleta',
  transportadora_acionada: '📞 Transp. Acionada',
  coletado: '✅ Coletado',
  em_transito: '🚚 Em Trânsito',
  saiu_para_entrega: '🛵 Saiu p/ Entrega',
  entregue: '✓ Entregue',
  problema_entrega: '⚠ Problema',
  finalizado: '🏁 Finalizado',
};
let STAGE_COLORS = {};
let _kanbanData = {};
let _stagesConfig = []; // array vindo de /kanban/stages

async function loadStagesConfig() {
  try {
    _stagesConfig = await api('/operacional/api/kanban/stages?kanban=shipment&active=true');
    const newLabels = {}; const newColors = {};
    for (const s of _stagesConfig) { newLabels[s.code] = s.label; newColors[s.code] = s.color; }
    if (Object.keys(newLabels).length) { STAGE_LABELS = newLabels; STAGE_COLORS = newColors; }
  } catch (e) { console.warn('stages config falhou, usando fallback', e); }
}

async function loadKanban() {
  try {
    await loadStagesConfig();
    _kanbanData = await api('/operacional/api/shipments/kanban');
    renderKanban();
  } catch (e) {
    document.getElementById('kb-grid').innerHTML = `<div class="kb-empty" style="color:${e.silent?'#888':'#f87171'}">${e.silent?'⏸ aguardando login…':e.message}</div>`;
  }
}

function renderKanban() {
  const grid = document.getElementById('kb-grid');
  // união entre stages config + stages presentes em _kanbanData (não perde card de stage removido)
  const seen = new Set();
  const stageOrder = [];
  for (const code of Object.keys(STAGE_LABELS)) { stageOrder.push(code); seen.add(code); }
  for (const code of Object.keys(_kanbanData)) { if (!seen.has(code)) { stageOrder.push(code); seen.add(code); } }

  grid.innerHTML = stageOrder.map(stage => {
    const items = _kanbanData[stage] || [];
    const label = STAGE_LABELS[stage] || stage;
    const color = STAGE_COLORS[stage] || '#475569';
    return `
      <div class="kb-col" data-stage="${stage}" ondragover="kbDragOver(event)" ondragleave="kbDragLeave(event)" ondrop="kbDrop(event)" style="border-top:3px solid ${color}">
        <div class="kb-col-h">
          <span>${label}</span>
          <span class="count">${items.length}</span>
        </div>
        <div class="kb-col-body">
          ${items.length === 0 ? '<div class="kb-empty">—</div>' : items.map(it => `
            <div class="kb-card" draggable="true" ondragstart="kbDragStart(event,${it.id},'${stage}')" ondragend="kbDragEnd(event)" data-id="${it.id}" onclick="kbDetails(${it.id})" style="border-left:3px solid ${color}">
              <div class="kc-name">${it.customer_name || '—'}</div>
              <div class="kc-meta">
                ${it.product ? `<b>${it.product.substring(0,40)}</b><br>` : ''}
                ${it.tracking_code ? `📮 <code>${it.tracking_code}</code><br>` : ''}
                ${it.carrier_name ? `🚚 ${it.carrier_name}<br>` : ''}
                ${it.expected_delivery ? `📅 ${it.expected_delivery}<br>` : ''}
                ${it.amount ? `💰 R$ ${parseFloat(it.amount).toLocaleString('pt-BR',{minimumFractionDigits:2})}` : ''}
              </div>
            </div>
          `).join('')}
        </div>
      </div>
    `;
  }).join('');
}

// ===== F-KANBAN-EDIT — Modal Gerenciar Etapas (multi-kanban) =====
let _kbmActiveKanban = 'shipment';
async function kbmOpen(kanban = 'shipment') {
  _kbmActiveKanban = kanban;
  document.getElementById('kbm-overlay').classList.add('show');
  // header dinâmico
  const h = document.querySelector('#kbm-overlay .kbm-h h3');
  if (h) h.textContent = `⚙️ Gerenciar etapas — kanban "${kanban}"`;
  await kbmReload();
}
function kbmClose() { document.getElementById('kbm-overlay').classList.remove('show'); }

function reloadActiveKanban() {
  if (_kbmActiveKanban === 'delivery') return loadDeliveries();
  return loadKanban();
}

async function kbmReload() {
  const body = document.getElementById('kbm-body');
  body.innerHTML = '<div class="kb-empty">Carregando…</div>';
  try {
    const stages = await api(`/operacional/api/kanban/stages?kanban=${_kbmActiveKanban}`);
    _stagesConfig = stages;
    body.innerHTML = stages.map(s => kbmRowHtml(s)).join('') +
      `<button class="kbm-add" onclick="kbmAddNew()">+ Nova etapa</button>`;
  } catch (e) {
    body.innerHTML = `<div class="kb-empty" style="color:${e.silent?'#888':'#f87171'}">${e.silent?'⏸ aguardando login…':e.message}</div>`;
  }
}

function kbmRowHtml(s) {
  const flag = s.is_initial ? '<span class="badge-flag">INICIAL</span>' : (s.is_terminal ? '<span class="badge-flag">FINAL</span>' : '');
  return `
    <div class="kbm-row" draggable="true" data-id="${s.id}"
         ondragstart="kbmDragStart(event,${s.id})"
         ondragend="kbmDragEnd(event)"
         ondragover="kbmDragOver(event)"
         ondragleave="kbmDragLeave(event)"
         ondrop="kbmDrop(event,${s.id})">
      <span class="handle" title="Arrastar para reordenar">☰</span>
      <div>
        <input type="text" id="kbm-label-${s.id}" value="${(s.label||'').replace(/"/g,'&quot;')}" placeholder="Label da etapa" />
        <div style="font-size:10px;color:#666;margin-top:2px">code: <code>${s.code}</code> ${flag}</div>
      </div>
      <input type="color" id="kbm-color-${s.id}" value="${s.color || '#475569'}" />
      <button class="btn-save" onclick="kbmSaveRow(${s.id})" title="Salvar">💾</button>
      <button class="btn-del" onclick="kbmDelete(${s.id})" title="Excluir" ${s.is_initial||s.is_terminal?'disabled':''}>🗑</button>
    </div>
  `;
}

async function kbmSaveRow(id) {
  const s = _stagesConfig.find(x => x.id === id); if (!s) return;
  const label = document.getElementById(`kbm-label-${id}`).value.trim();
  const color = document.getElementById(`kbm-color-${id}`).value;
  if (!label) return toast('Label não pode ser vazio', 'error');
  try {
    await api(`/operacional/api/kanban/stages/${id}`, { method: 'PUT', body: { ...s, label, color } });
    toast('Etapa atualizada ✓');
    await kbmReload();
    await reloadActiveKanban();
  } catch (e) { toast(e.message, 'error'); }
}

async function kbmDelete(id) {
  const s = _stagesConfig.find(x => x.id === id); if (!s) return;
  if (s.is_initial || s.is_terminal) return toast('Etapas inicial/final não podem ser excluídas', 'error');
  if (!confirm(`Excluir etapa "${s.label}"?\nObs: cards já nessa etapa permanecem visíveis até serem movidos.`)) return;
  try {
    await api(`/operacional/api/kanban/stages/${id}`, { method: 'DELETE' });
    toast('Etapa excluída ✓');
    await kbmReload();
    await reloadActiveKanban();
  } catch (e) { toast(e.message, 'error'); }
}

async function kbmAddNew() {
  const label = prompt('Nome da nova etapa:'); if (!label) return;
  const code = (prompt('Código interno (snake_case, sem espaços):', label.toLowerCase().replace(/[^a-z0-9]+/g,'_').replace(/^_+|_+$/g,'')) || '').trim();
  if (!code) return;
  const maxSeq = Math.max(0, ..._stagesConfig.map(s => s.sequence || 0));
  try {
    await api('/operacional/api/kanban/stages', { method: 'POST', body: {
      kanban: _kbmActiveKanban, code, label, sequence: maxSeq + 10,
      color: '#475569', is_initial: false, is_terminal: false, active: true
    }});
    toast('Etapa criada ✓');
    await kbmReload();
    await reloadActiveKanban();
  } catch (e) { toast(e.message, 'error'); }
}

// reorder via drag
let _kbmDragId = null;
function kbmDragStart(ev, id) { _kbmDragId = id; ev.currentTarget.classList.add('dragging'); }
function kbmDragEnd(ev) { ev.currentTarget.classList.remove('dragging'); _kbmDragId = null; }
function kbmDragOver(ev) { ev.preventDefault(); ev.currentTarget.classList.add('dragover'); }
function kbmDragLeave(ev) { ev.currentTarget.classList.remove('dragover'); }
async function kbmDrop(ev, targetId) {
  ev.preventDefault();
  ev.currentTarget.classList.remove('dragover');
  if (!_kbmDragId || _kbmDragId === targetId) return;
  const ids = _stagesConfig.map(s => s.id);
  const fromIdx = ids.indexOf(_kbmDragId);
  const toIdx = ids.indexOf(targetId);
  if (fromIdx < 0 || toIdx < 0) return;
  ids.splice(toIdx, 0, ids.splice(fromIdx, 1)[0]);
  try {
    await api('/operacional/api/kanban/stages/reorder', { method: 'POST', body: { kanban: _kbmActiveKanban, stage_ids: ids } });
    toast('Reordenado ✓');
    await kbmReload();
    await reloadActiveKanban();
  } catch (e) { toast(e.message, 'error'); }
}

function kbDragStart(ev, id, fromStage) {
  ev.dataTransfer.setData('text/plain', JSON.stringify({ id, fromStage }));
  ev.dataTransfer.effectAllowed = 'move';
  ev.target.classList.add('dragging');
}
function kbDragEnd(ev) { ev.target.classList.remove('dragging'); }
function kbDragOver(ev) { ev.preventDefault(); ev.currentTarget.classList.add('dragover'); }
function kbDragLeave(ev) { ev.currentTarget.classList.remove('dragover'); }

async function kbDrop(ev) {
  ev.preventDefault();
  ev.currentTarget.classList.remove('dragover');
  const toStage = ev.currentTarget.dataset.stage;
  let payload;
  try { payload = JSON.parse(ev.dataTransfer.getData('text/plain')); } catch { return; }
  if (payload.fromStage === toStage) return;
  try {
    await api(`/operacional/api/shipments/${payload.id}/transition`, {
      method: 'POST',
      body: { to_stage: toStage }
    });
    toast(`Movido pra ${STAGE_LABELS[toStage]} ✓`);
    await loadKanban();
  } catch (e) {
    toast(e.message, 'error');
  }
}


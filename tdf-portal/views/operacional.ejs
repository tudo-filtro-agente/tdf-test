<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin="anonymous"></script>

<script>
const State = {
  sales: [],
  routes: [],
  selectedSaleId: null,
  selectedSale: null,
  suggestion: null,
  map: null,
  saleMarker: null,
  routeMarkers: [],
};

function toast(msg, kind='success') {
  const el = document.createElement('div');
  el.className = 'toast ' + kind;
  el.textContent = msg;
  document.body.appendChild(el);
  setTimeout(() => el.remove(), 3500);
}

function fmtDate(s) {
  if (!s) return '—';
  const d = new Date(s);
  return d.toLocaleDateString('pt-BR') + ' ' + d.toLocaleTimeString('pt-BR', {hour:'2-digit', minute:'2-digit'});
}

function priorityBadge(p) {
  const map = { urgent: 'urgent', high: 'high', normal: 'normal', low: 'normal' };
  const cls = 'b-' + (map[p] || 'normal');
  return `<span class="badge ${cls}">${p || 'normal'}</span>`;
}
function queueBadge(q) {
  const map = { tecnica: 'b-tecnica', bebedouro: 'b-bebed', manutencao: 'b-manut', envio: 'b-envio', retirada: 'b-normal' };
  return `<span class="badge ${map[q] || 'b-normal'}">${q || '?'}</span>`;
}

async function api(path, opts={}) {
  const r = await fetch(path, {
    method: opts.method || 'GET',
    headers: { 'Content-Type': 'application/json' },
    body: opts.body ? JSON.stringify(opts.body) : undefined,
    credentials: 'same-origin',
  });
  if (r.status === 401) {
    showSessionExpired();
    // Devolve objeto vazio pra não quebrar listas/kanbans visualmente
    throw new SessionExpiredError();
  }
  if (!r.ok) {
    const t = await r.text();
    throw new Error(`${r.status} ${r.statusText} — ${t.substring(0,200)}`);
  }
  return r.json();
}

class SessionExpiredError extends Error {
  constructor() { super('Sessão expirada'); this.name = 'SessionExpiredError'; this.silent = true; }
}

// Modal de re-login não-bloqueante (não quebra layout)
let _sessExpShown = false;
function showSessionExpired() {
  if (_sessExpShown) return;
  _sessExpShown = true;
  // Preserva aba ativa pra restaurar após login
  try {
    const activeTab = document.querySelector('.op-tab.active')?.dataset?.tab;
    if (activeTab) localStorage.setItem('op-last-tab', activeTab);
  } catch {}
  const div = document.createElement('div');
  div.id = 'sess-exp-modal';
  div.style.cssText = 'position:fixed;top:16px;right:16px;background:#1f2937;border:1px solid #f59e0b;border-left:4px solid #f59e0b;border-radius:8px;padding:14px 18px;z-index:99999;box-shadow:0 8px 30px rgba(0,0,0,.5);max-width:380px;font-size:13px;color:#fff';
  div.innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:start;gap:12px">
      <div>
        <div style="font-weight:700;color:#fbbf24;margin-bottom:4px">⚠ Sessão expirada</div>
        <div style="color:#cbd5e1;font-size:12px;margin-bottom:10px">Sua sessão acabou. Refaça o login pra continuar — sua aba atual ficará salva.</div>
        <button onclick="window.location.href='/login?next='+encodeURIComponent(window.location.pathname)" style="background:#1f6feb;color:#fff;border:0;padding:7px 14px;border-radius:5px;font-size:12px;font-weight:700;cursor:pointer">Fazer login</button>
        <button onclick="document.getElementById('sess-exp-modal').remove();_sessExpShown=false" style="background:transparent;color:#888;border:0;padding:7px 10px;font-size:11px;cursor:pointer">Depois</button>
      </div>
      <button onclick="document.getElementById('sess-exp-modal').remove();_sessExpShown=false" style="background:transparent;border:0;color:#888;cursor:pointer;font-size:16px;line-height:1">×</button>
    </div>
  `;
  document.body.appendChild(div);
}

// Restaurar última aba após login
window.addEventListener('DOMContentLoaded', () => {
  let restored = false;
  try {
    const last = localStorage.getItem('op-last-tab');
    if (last && document.querySelector(`.op-tab[data-tab="${last}"]`)) {
      document.querySelector(`.op-tab[data-tab="${last}"]`)?.click();
      localStorage.removeItem('op-last-tab');
      restored = true;
    }
  } catch {}
  // F8 — primeira carga sem aba restaurada: dispara insight da aba ativa
  if (!restored) {
    const activeTab = document.querySelector('.op-tab.active')?.dataset?.tab;
    if (activeTab && typeof loadAbaInsight === 'function') loadAbaInsight(activeTab);
  }
});

async function loadSales() {
  try {
    const data = await api('/operacional/api/sales?status=aguardando_rota&page_size=100');
    State.sales = data.items || [];
    renderQueue();
  } catch (e) {
    document.getElementById('sale-list').innerHTML = `<div class="panel-empty" style="color:${e.silent?'#888':'#f87171'}">${e.silent?'⏸ aguardando login…':e.message}</div>`;
  }
  // Try fetching sugestao_aberta too
  try {
    const data2 = await api('/operacional/api/sales?status=sugestao_aberta&page_size=100');
    State.sales = State.sales.concat(data2.items || []);
    renderQueue();
  } catch {}
}

function renderQueue() {
  const list = document.getElementById('sale-list');
  const tecnica = State.sales.filter(s => s.queue === 'tecnica' || s.queue === 'bebedouro' || s.queue === 'manutencao');
  document.getElementById('queue-count').textContent = tecnica.length;
  document.getElementById('t-instalacoes').textContent = State.sales.filter(s=>s.queue==='tecnica').length;
  document.getElementById('t-envios').textContent = State.sales.filter(s=>s.queue==='envio').length;
  document.getElementById('t-bebedouros').textContent = State.sales.filter(s=>s.queue==='bebedouro').length;
  document.getElementById('t-manutencao').textContent = State.sales.filter(s=>s.queue==='manutencao').length;
  document.getElementById('k-pending').textContent = State.sales.filter(s=>s.status==='aguardando_rota').length;

  if (!tecnica.length) {
    list.innerHTML = '<div class="panel-empty">Nenhuma venda aguardando rota</div>';
    return;
  }
  list.innerHTML = tecnica.map(s => {
    const cls = s.id === State.selectedSaleId ? 'selected' : '';
    const stale = s.status !== 'aguardando_rota' && s.status !== 'sugestao_aberta' ? 'stale' : '';
    return `
      <div class="op-card ${cls} ${stale}" data-sale-id="${s.id}">
        <div class="name">${s.customer_name || '—'}</div>
        <div class="meta">
          ${queueBadge(s.queue)} ${priorityBadge(s.service_priority)}
          <br>${(s.product_line || '').substring(0, 40)}${(s.product_line||'').length>40?'…':''}
          <br>📍 ${s.address?.city || '—'}/${s.address?.state || ''}
          <br>💰 R$ ${(parseFloat(s.amount)||0).toLocaleString('pt-BR', {minimumFractionDigits:2})}
        </div>
      </div>
    `;
  }).join('');
  list.querySelectorAll('[data-sale-id]').forEach(card => {
    card.addEventListener('click', () => selectSale(parseInt(card.dataset.saleId, 10)));
  });
}

async function selectSale(id) {
  State.selectedSaleId = id;
  State.selectedSale = State.sales.find(s => s.id === id);
  document.querySelectorAll('.op-card').forEach(c => c.classList.toggle('selected', parseInt(c.dataset.saleId,10) === id));

  const panel = document.getElementById('suggestion-panel');
  panel.innerHTML = '<div class="panel-empty">Carregando sugestão…</div>';
  try {
    const sugs = await api(`/operacional/api/sales/${id}/suggestions`);
    State.suggestion = sugs[0] || null;
    renderSuggestion();
    drawMap();
  } catch (e) {
    panel.innerHTML = `<div class="panel-empty" style="color:${e.silent?'#888':'#f87171'}">${e.silent?'⏸ aguardando login…':e.message}</div>`;
  }
}

function renderSuggestion() {
  const panel = document.getElementById('suggestion-panel');
  const sale = State.selectedSale;
  const sug = State.suggestion;
  if (!sug) {
    panel.innerHTML = `
      <div class="panel-empty">Sem sugestão IA ainda</div>
      <button class="btn btn-sec" style="width:100%" onclick="reanalyze(${sale.id})">⚡ Gerar sugestão agora</button>
    `;
    return;
  }
  const score = parseFloat(sug.match_score || 0);
  const top = (sug.signals || {}).top || {};
  const dist = parseFloat(sug.distance_km || 0);
  const tipoMap = { encaixe: '🎯 Encaixe limpo', analise_manual: '⚠ Análise manual', nova_rota: '🆕 Nova rota' };
  panel.innerHTML = `
    <div style="margin-bottom:8px;color:#888;font-size:11px">${tipoMap[sug.suggestion_type] || sug.suggestion_type}</div>
    <div class="sug-score">
      <div class="ring" style="--p: ${score*3.6}deg"><span class="v">${score.toFixed(0)}</span></div>
      <div class="info">
        <div class="t">${top.technician_name || '—'}</div>
        <div class="d">${top.route_date || '—'} • ${dist.toFixed(2)} km${top.distance_source==='google_routes' ? ' (estrada)' : ''}</div>
        <div class="d">+${sug.added_time_min || '?'} min na rota</div>
      </div>
    </div>
    <div class="sug-rationale">${(sug.rationale || '').replace(/</g,'&lt;')}</div>
    <div class="sug-signals">
      <div class="sug-sig">📏 Distância <b>${dist.toFixed(2)} km</b></div>
      <div class="sug-sig">🎯 Score <b>${score.toFixed(0)}/100</b></div>
      <div class="sug-sig">🪟 Janela <b>${top.has_window ? 'livre ✓' : 'lotada ✗'}</b></div>
      <div class="sug-sig">📦 Vagas <b>${top.free_capacity ?? '—'}</b></div>
    </div>
    <div class="sug-actions">
      <button class="btn btn-pri" onclick="decide(${sug.id}, 'adicionar')">✓ Adicionar à rota</button>
      <button class="btn btn-sec" onclick="decide(${sug.id}, 'analise_manual')">👁 Análise</button>
      <button class="btn btn-warn" onclick="decide(${sug.id}, 'nova_rota')">+ Nova rota</button>
      <button class="btn btn-ghost" onclick="decide(${sug.id}, 'ignorar')">✗ Ignorar</button>
    </div>
    <div style="margin-top:14px;border-top:1px solid #21262D;padding-top:12px">
      <div style="font-size:11px;color:#888;margin-bottom:6px">📱 Falar com cliente</div>
      <button class="btn-wa" onclick="openWhatsapp(${sale.id})">📱 Abrir WhatsApp</button>
    </div>
  `;
}

async function reanalyze(saleId) {
  toast('Gerando sugestão IA…');
  try {
    await api(`/operacional/api/sales/${saleId}/reanalyze?regeocode=true`, { method: 'POST' });
    await selectSale(saleId);
    toast('Sugestão gerada ✓', 'success');
  } catch (e) { toast(e.message, 'error'); }
}

async function decide(sugId, decision) {
  if (decision === 'ignorar' && !confirm('Ignorar esta sugestão?')) return;
  try {
    await api(`/operacional/api/suggestions/${sugId}/decide`, {
      method: 'POST',
      body: { decision }
    });
    toast(`Decisão registrada: ${decision} ✓`, 'success');
    await loadSales();
    if (State.selectedSaleId) selectSale(State.selectedSaleId);
  } catch (e) { toast(e.message, 'error'); }
}

async function openWhatsapp(saleId) {
  const sale = State.sales.find(s => s.id === saleId);
  if (!sale) return;
  const msg = prompt('Mensagem pré-preenchida (opcional):', `Olá ${sale.customer_name?.split(' ')[0] || ''}, aqui é da Tudo de Filtro sobre seu pedido ${sale.product_line || ''}.`);
  if (msg === null) return;
  try {
    const r = await api('/operacional/api/whatsapp/manual-link', {
      method: 'POST',
      body: { sale_id: saleId, body: msg, mode: 'manual' }
    });
    window.open(r.link, '_blank');
    toast('WhatsApp aberto + log registrado', 'success');
  } catch (e) { toast(e.message, 'error'); }
}

// MAP
function initMap() {
  if (State.map) return;
  State.map = L.map('map').setView([-23.5505, -46.6333], 7);  // SP region
  L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap',
    maxZoom: 19
  }).addTo(State.map);
}

async function drawMap() {
  if (!State.map) initMap();
  // Clear previous
  if (State.saleMarker) State.map.removeLayer(State.saleMarker);
  State.routeMarkers.forEach(m => State.map.removeLayer(m));
  State.routeMarkers = [];

  const sale = State.selectedSale;
  if (!sale || !sale.address || !sale.address.lat) return;
  const lat = parseFloat(sale.address.lat);
  const lng = parseFloat(sale.address.lng);
  State.saleMarker = L.marker([lat, lng], {
    icon: L.divIcon({ html: '🏠', className: 'sale-pin', iconSize: [30,30] })
  }).addTo(State.map).bindPopup(`<b>${sale.customer_name}</b><br>${sale.address.raw_address || ''}`);

  // Recommended route stops
  const sug = State.suggestion;
  if (sug && sug.recommended_route_id) {
    try {
      const route = await api(`/operacional/api/routes/${sug.recommended_route_id}`);
      const bounds = [[lat, lng]];
      (route.stops || []).forEach((s, i) => {
        // need address — but stops out doesn't include lat/lng directly
        // Skip; only show sale marker. Future: include in API.
      });
      State.map.setView([lat, lng], 13);
    } catch {}
  } else {
    State.map.setView([lat, lng], 13);
  }
}

// TABS
document.getElementById('tabs').addEventListener('click', (e) => {
  if (!e.target.dataset.tab) return;
  const tab = e.target.dataset.tab;
  document.querySelectorAll('.op-tab').forEach(t => t.classList.toggle('active', t.dataset.tab === tab));
  document.querySelectorAll('.aba').forEach(a => a.hidden = a.id !== `aba-${tab}`);
  if (tab === 'instalacoes') initMap();
  if (tab === 'envios') loadKanban();
  if (tab === 'bebedouros') loadDeliveries();
  if (tab === 'manutencao') loadManutencao();
  if (tab === 'posvenda') loadPosvenda();
  // F8 IA por aba — injeta card de insight no topo da aba ativa
  loadAbaInsight(tab);
});

// F8 — IA por aba (Claude insight + ações)
async function loadAbaInsight(tab, force=false) {
  const aba = document.getElementById(`aba-${tab}`);
  if (!aba) return;
  let card = aba.querySelector('.ia-insight-card');
  if (!card) {
    card = document.createElement('div');
    card.className = 'ia-insight-card';
    card.style.cssText = 'margin:0 0 12px;padding:12px 14px;border:1px solid #30363D;border-left:3px solid #a371f7;border-radius:6px;background:linear-gradient(135deg,#161B22,#1f1626);font-size:12px;color:#e6edf3';
    card.innerHTML = '<div style="color:#a371f7;font-size:10px;letter-spacing:1px;font-weight:800;margin-bottom:4px">🤖 INSIGHT IA</div><div class="ia-insight-body">Carregando…</div>';
    aba.insertBefore(card, aba.firstChild);
  }
  const body = card.querySelector('.ia-insight-body');
  if (force) body.innerHTML = 'Atualizando…';
  try {
    const r = await api(`/operacional/api/aba/${tab}/insight${force?'?refresh=true':''}`);
    const acoes = (r.acoes || []).map(a => `<li>${escapeHTML(a)}</li>`).join('');
    const cached = r.from_cache ? '<span style="color:#666;font-size:10px;margin-left:8px">(cache)</span>' : '';
    body.innerHTML = `
      <div style="line-height:1.45">${escapeHTML(r.insight || '—')} ${cached}</div>
      ${acoes ? `<ul style="margin:6px 0 0 18px;padding:0;color:#aaa">${acoes}</ul>` : ''}
      <div style="margin-top:6px"><a href="javascript:loadAbaInsight('${tab}', true)" style="color:#a371f7;font-size:10px;text-decoration:none">↻ atualizar agora</a></div>
    `;
  } catch (e) {
    body.innerHTML = `<span style="color:#888">IA indisponível: ${escapeHTML(e.message || '?')}</span>`;
  }
}


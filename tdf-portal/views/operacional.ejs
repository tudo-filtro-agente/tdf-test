<% const activePage = 'operacional'; const pageTitle = 'Operacional · GIR + POS'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="anonymous" />
<link rel="stylesheet" href="https://unpkg.com/intro.js@7.2.0/minified/introjs.min.css">
<style>
  .introjs-tooltip { background: var(--bg-card) !important; color: var(--text) !important; border: 1px solid var(--border) !important; border-radius: 10px !important; min-width: 320px; }
  .introjs-tooltiptext { line-height: 1.55; font-size: 13px; }
  .introjs-tooltip-title { color: var(--text) !important; font-size: 14px; }
  .introjs-button { background: var(--border) !important; border: 1px solid var(--border) !important; color: var(--text) !important; text-shadow: none !important; border-radius: 6px !important; }
  .introjs-button.introjs-nextbutton { background: #25D366 !important; color: #000 !important; border-color: #25D366 !important; font-weight: 700; }
  .introjs-helperLayer { background: rgba(37, 211, 102, 0.06) !important; border: 2px solid #25D366 !important; box-shadow: rgba(0,0,0,.5) 0 0 0 9999px !important; border-radius: 10px !important; }
  .introjs-bullets ul li a { background: var(--border) !important; }
  .introjs-bullets ul li a.active { background: #25D366 !important; }
</style>

<style>
  .op-shell { padding: 16px 20px 40px; max-width: 1640px; margin: 0 auto; }
  .op-h { display: flex; align-items: baseline; gap: 16px; margin-bottom: 12px; }
  .op-h h1 { margin: 0; font-size: 20px; color: var(--text); }
  .op-h .sub { color: var(--text-muted); font-size: 12px; }
  .op-kpis { display: grid; grid-template-columns: repeat(7, 1fr); gap: 10px; margin-bottom: 14px; }
  @media (max-width: 1200px) { .op-kpis { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 700px) { .op-kpis { grid-template-columns: repeat(2, 1fr); } }
  .op-kpi { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; padding: 10px 12px; cursor: pointer; transition: all .15s; border-top: 3px solid var(--c, var(--border)) }
  .op-kpi:hover { transform: translateY(-1px); border-color: var(--c, #1f6feb) }
  .op-kpi.active-filter { box-shadow: 0 0 0 2px var(--c, #1f6feb) inset }
  .op-kpi.active-filter::after { content: ' (filtrando)'; font-size: 9px; color: var(--c); }
  .op-kpi .v { font-size: 20px; font-weight: 800; color: var(--text); }
  .op-kpi .l { font-size: 10px; text-transform: uppercase; letter-spacing: .4px; color: var(--text-muted); margin-top: 2px; }
  .op-tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--border); margin-bottom: 14px; }
  .op-tab { padding: 8px 14px; cursor: pointer; color: var(--text-muted); border-bottom: 2px solid transparent; font-size: 13px; }
  .op-tab.active { color: var(--text); border-bottom-color: #25D366; }
  .op-tab .badge { background: #1f6feb; color:#fff; font-size: 10px; padding: 1px 6px; border-radius: 8px; margin-left: 6px; }
  .op-grid { display: grid; grid-template-columns: 320px 1fr 380px; gap: 12px; height: calc(100vh - 220px); min-height: 560px; }
  @media (max-width: 1280px) { .op-grid { grid-template-columns: 280px 1fr 340px; } }
  @media (max-width: 1024px) { .op-grid { grid-template-columns: 1fr; height: auto; } }
  .op-col { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; }
  .op-col h3 { font-size: 11px; text-transform: uppercase; letter-spacing: .5px; color: var(--text-muted); margin: 0; padding: 12px 14px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
  .op-col h3 .count { background: var(--border); color: var(--text); padding: 2px 8px; border-radius: 8px; font-size: 11px; }
  .op-list { flex: 1; overflow-y: auto; padding: 4px; }
  .op-card { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; margin: 4px; cursor: pointer; transition: all .15s; }
  .op-card:hover { border-color: #1f6feb; transform: translateY(-1px); }
  .op-card.selected { border-color: #25D366; background: rgba(37, 211, 102, .05); }
  .op-card .name { color: var(--text); font-weight: 700; font-size: 13px; margin-bottom: 4px; }
  .op-card .meta { color: var(--text-muted); font-size: 11px; line-height: 1.5; }
  .op-card .badge { display: inline-block; font-size: 10px; padding: 1px 6px; border-radius: 6px; margin-right: 4px; font-weight: 700; }
  .b-urgent { background: rgba(239,68,68,.18); color: #f87171; border: 1px solid #ef4444; }
  .b-high   { background: rgba(234,179,8,.15); color: #fbbf24; border: 1px solid #eab308; }
  .b-normal { background: rgba(148,163,184,.15); color: #cbd5e1; border: 1px solid #475569; }
  .b-bebed  { background: rgba(99,102,241,.15); color: #a5b4fc; }
  .b-tecnica{ background: rgba(16,185,129,.15); color: #34d399; }
  .b-manut  { background: rgba(245,158,11,.15); color: #fbbf24; }
  .b-envio  { background: rgba(96,165,250,.15); color: #93c5fd; }
  #map { height: 100%; min-height: 400px; background: var(--bg); }
  .panel-body { padding: 14px; overflow-y: auto; flex: 1; }
  .panel-empty { color: var(--text-muted); text-align: center; padding: 40px 20px; font-size: 13px; }
  .sug-score { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
  .sug-score .ring { width: 64px; height: 64px; border-radius: 50%; background: conic-gradient(#25D366 var(--p), var(--border) 0); display: flex; align-items: center; justify-content: center; position: relative; }
  .sug-score .ring::before { content: ''; position: absolute; inset: 6px; background: var(--bg-card); border-radius: 50%; }
  .sug-score .ring .v { position: relative; color: var(--text); font-weight: 800; font-size: 16px; }
  .sug-score .info { flex: 1; }
  .sug-score .info .t { color: var(--text); font-weight: 700; font-size: 13px; }
  .sug-score .info .d { color: var(--text-muted); font-size: 11px; }
  .sug-rationale { background: var(--bg); border: 1px solid var(--border); border-radius: 8px; padding: 12px; margin: 12px 0; color: var(--text); font-size: 12.5px; line-height: 1.55; white-space: pre-wrap; }
  .sug-signals { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin: 12px 0; }
  .sug-sig { background: var(--bg); padding: 6px 8px; border-radius: 6px; font-size: 11px; color: var(--text-muted); }
  .sug-sig b { color: var(--text); }
  .sug-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; margin-top: 14px; }
  .btn { padding: 9px 12px; border-radius: 8px; border: 1px solid; font-size: 12px; font-weight: 700; cursor: pointer; background: transparent; }
  .btn-pri { background: #25D366; color: #000; border-color: #25D366; }
  .btn-sec { color: #93c5fd; border-color: #1f6feb; }
  .btn-warn { color: #fbbf24; border-color: #eab308; }
  .btn-ghost { color: var(--text-muted); border-color: var(--border); }
  .btn:hover { filter: brightness(1.1); }
  .btn:disabled { opacity: .5; cursor: not-allowed; }
  .btn-wa { background: #25D366; color: #000; border-color: #25D366; padding: 8px 14px; border-radius: 6px; font-size: 12px; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
  .toast { position: fixed; bottom: 20px; right: 20px; background: var(--bg-card); border: 1px solid var(--border); padding: 12px 16px; border-radius: 8px; color: var(--text); font-size: 13px; z-index: 9999; box-shadow: 0 8px 24px rgba(0,0,0,.5); }
  .toast.success { border-color: #25D366; }
  .toast.error { border-color: #ef4444; }
  .stale { opacity: .55; }
  .pendente-aba { padding: 60px 20px; text-align: center; color: var(--text-muted); font-size: 14px; }
</style>

<!-- F8 — Alert Engine drawer -->
<style>
  #alerts-drawer { display:none; position:fixed; top:0; right:0; bottom:0; width:420px; max-width:92vw; background:var(--bg); border-left:1px solid var(--border); z-index:9500; flex-direction:column; box-shadow:-8px 0 24px rgba(0,0,0,.55); transform:translateX(100%); transition:transform .25s ease; }
  #alerts-drawer.open { transform:translateX(0); }
  #alerts-drawer header { padding:14px 16px; border-bottom:1px solid var(--border); display:flex; justify-content:space-between; align-items:center; gap:10px; }
  #alerts-drawer header h3 { margin:0; font-size:14px; color:var(--text); font-weight:700; }
  #alerts-drawer-filter { background:var(--bg-card); border:1px solid var(--border); color:var(--text); padding:5px 8px; border-radius:5px; font-size:11px; }
  #alerts-drawer-body { flex:1; overflow-y:auto; }
  #alerts-drawer .close-btn { background:transparent; border:none; color:var(--text-muted); font-size:18px; cursor:pointer; padding:0 4px; }
  #alerts-drawer-backdrop { display:none; position:fixed; inset:0; background:rgba(0,0,0,.35); z-index:9490; }
  #alerts-drawer.open + #alerts-drawer-backdrop { display:block; }
</style>
<div id="alerts-drawer" role="dialog" aria-label="Central de alertas">
  <header>
    <h3>🔔 Central de Alertas</h3>
    <div style="display:flex;gap:8px;align-items:center">
      <select id="alerts-drawer-filter" onchange="loadAlertsList()">
        <option value="open">Abertos</option>
        <option value="acked">Vistos</option>
        <option value="resolved">Resolvidos</option>
        <option value="all">Todos</option>
      </select>
      <button class="close-btn" onclick="closeAlertsDrawer()" aria-label="Fechar">✕</button>
    </div>
  </header>
  <div id="alerts-drawer-body"></div>
  <div style="padding:10px 14px;border-top:1px solid var(--border);display:flex;justify-content:space-between;font-size:11px;color:var(--text-muted)">
    <span>Scan a cada 5min</span>
    <a href="/operacional/feed" style="color:#58a6ff;text-decoration:none">ver feed completo ↗</a>
  </div>
</div>
<div id="alerts-drawer-backdrop" onclick="closeAlertsDrawer()"></div>

<div class="op-shell">
  <div class="op-h" style="justify-content:space-between">
    <div>
      <h1>🛠 Operacional</h1>
      <span class="sub">GIR (rotas) + POS (pós-venda) — backend tdf-ops • <a href="<%= tdfOpsUrl %>/docs" target="_blank" style="color:var(--text-muted)">/docs ↗</a></span>
    </div>
    <div style="display:flex;gap:8px" id="header-actions">
      <div style="position:relative">
        <input id="op-search" type="text" placeholder="🔍 Buscar cliente, SIGE, placa, técnico…" autocomplete="off" style="background:var(--bg);border:1px solid var(--border);color:var(--text);padding:7px 12px;border-radius:6px;font-size:12px;width:280px;outline:none">
        <div id="op-search-results" style="display:none;position:absolute;top:36px;right:0;width:420px;max-height:60vh;overflow-y:auto;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.5);z-index:9000"></div>
      </div>
      <button id="btn-tutorial" onclick="startTutorial()" style="color:#25D366;border:1px solid #25D366;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;background:transparent;cursor:pointer">❓ Tutorial</button>
      <a href="/operacional/mapa" id="link-mapa" style="color:#22c55e;border:1px solid #22c55e;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">🗺 Mapa</a>
      <a href="/operacional/gantt" id="link-gantt" style="color:#22d3ee;border:1px solid #22d3ee;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">📅 Gantt</a>
      <a href="/operacional/dashboard" id="link-dashboard" style="color:#1f6feb;border:1px solid #1f6feb;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">📊 Dashboard</a>
      <a href="/operacional/expedicao" id="link-expedicao" style="color:#fb923c;border:1px solid #fb923c;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">📦 Expedição</a>
      <a href="/operacional/triagem" id="link-triagem" style="color:#ef4444;border:1px solid #ef4444;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">🩺 Triagem</a>
      <button type="button" id="link-feed" onclick="openAlertsDrawer()" title="Abrir alertas (ou clique direito pra ir ao feed)" oncontextmenu="event.preventDefault();window.location='/operacional/feed';return false;" style="position:relative;color:#fbbf24;border:1px solid #fbbf24;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;background:transparent;cursor:pointer">
        🔔 <span id="bell-count" style="display:none;position:absolute;top:-6px;right:-6px;background:#ef4444;color:#fff;border-radius:10px;padding:1px 6px;font-size:10px;font-weight:800;min-width:18px;text-align:center"></span>
      </button>
      <a href="/operacional/onboarding" id="link-onboarding" style="color:#25D366;border:1px solid #25D366;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">👋 Onboarding</a>
      <a href="/operacional/intakes" id="link-intakes" style="color:#fbbf24;border:1px solid #fbbf24;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">🤖 Agendamento Núbia</a>
      <a href="/operacional/config" id="link-config" style="color:#a371f7;border:1px solid #a371f7;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">⚙️ Configurações</a>
      <a href="/operacional/auditoria" id="link-auditoria" style="color:#fbbf24;border:1px solid #eab308;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">📊 Auditoria</a>
      <a href="/operacional/cadastros" id="link-cadastros" style="color:#a371f7;border:1px solid #a371f7;padding:7px 14px;border-radius:6px;font-size:12px;font-weight:700;text-decoration:none">⚙ Cadastros</a>
    </div>
  </div>

  <div class="op-kpis" id="kpis">
    <div class="op-kpi" style="--c:#fbbf24" onclick="kpiClickPending()" title="Filtra a fila por Aguardando rota"><div class="v" id="k-pending">—</div><div class="l">Aguardando rota</div></div>
    <div class="op-kpi" style="--c:#22c55e" onclick="kpiClickEncaixe()" title="Abre Sugestões IA de encaixe"><div class="v" id="k-encaixe">—</div><div class="l">Sugestões "encaixe"</div></div>
    <div class="op-kpi" style="--c:#a371f7" onclick="kpiClickNovaRota()" title="Criar rota manual"><div class="v" id="k-novarota">—</div><div class="l">Sugere nova rota</div></div>
    <div class="op-kpi" style="--c:#22c55e" onclick="kpiClickAgendados()" title="Ver agendados"><div class="v" id="k-agendados">—</div><div class="l">📅 Agendados</div></div>
    <div class="op-kpi" style="--c:#25D366;cursor:pointer" onclick="manualServiceOpen()" title="Cadastrar serviço avulso"><div class="v" style="font-size:18px">➕</div><div class="l">Novo serviço manual</div></div>
    <div class="op-kpi" style="--c:#1f6feb" onclick="kpiClickTechs()" title="Ver disponibilidade técnicos"><div class="v" id="k-techs">—</div><div class="l">Técnicos com janela</div></div>
    <div class="op-kpi" style="--c:#22d3ee" onclick="kpiClickRoutes()" title="Rotas próximos 14 dias"><div class="v" id="k-routes">—</div><div class="l">Rotas próximos 14d</div></div>
  </div>

  <div class="op-tabs" id="tabs">
    <div class="op-tab active" data-tab="instalacoes">🔧 Instalações <span class="badge" id="t-instalacoes">0</span></div>
    <div class="op-tab" data-tab="bebedouros">🚚 Entregas TDF <span class="badge" id="t-bebedouros">0</span></div>
    <div class="op-tab" data-tab="envios">📦 Transportadora <span class="badge" id="t-envios">0</span></div>
    <div class="op-tab" data-tab="manutencao">🔄 Manutenção <span class="badge" id="t-manutencao">0</span></div>
    <div class="op-tab" data-tab="posvenda">📞 Pós-venda <span class="badge" id="t-posvenda">0</span></div>
  </div>

  <!-- Aba 1: Instalações -->
  <div id="aba-instalacoes" class="aba">
    <div class="op-grid">
      <div class="op-col">
        <h3>FILA <span class="count" id="queue-count">0</span></h3>
        <div class="op-list" id="sale-list"><div class="panel-empty">Carregando…</div></div>
      </div>
      <div class="op-col">
        <h3>MAPA</h3>
        <div id="map"></div>
      </div>
      <div class="op-col">
        <h3>SUGESTÃO IA</h3>
        <div class="panel-body" id="suggestion-panel">
          <div class="panel-empty">Selecione uma venda à esquerda</div>
        </div>
      </div>
    </div>
  </div>

  <div id="aba-envios" class="aba" hidden>
    <style>
      .kb-shell { background: var(--bg); border: 1px solid var(--border); border-radius: 10px; padding: 12px; }
      .kb-toolbar { display: flex; gap: 10px; margin-bottom: 12px; align-items: center; flex-wrap: wrap; }
      .kb-toolbar .kb-info { font-size: 11px; color: var(--text-muted); }
      .kb-grid { display: flex; gap: 8px; overflow-x: auto; overflow-y: auto; padding-bottom: 8px; min-height: 70vh; max-height: calc(100vh - 220px); scroll-behavior: smooth; }
      .kb-grid::-webkit-scrollbar { height: 10px; width: 10px; }
      .kb-grid::-webkit-scrollbar-track { background: var(--bg); border-radius: 4px; }
      .kb-grid::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
      .kb-grid::-webkit-scrollbar-thumb:hover { background: #1f6feb; }
      .kb-col { flex: 0 0 240px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; display: flex; flex-direction: column; max-height: calc(100vh - 240px); }
      .kb-col.dragover { border-color: #25D366; background: rgba(37,211,102,.05); }
      .kb-col-h { padding: 8px 10px; border-bottom: 1px solid var(--border); font-size: 11px; text-transform: uppercase; letter-spacing: .4px; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center; }
      .kb-col-h .count { background: var(--border); padding: 1px 7px; border-radius: 8px; color: var(--text); font-size: 11px; }
      .kb-col-body { flex: 1; overflow-y: auto; padding: 6px; }
      .kb-card { background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 8px 10px; margin: 4px 0; cursor: grab; font-size: 12px; transition: all .15s; }
      .kb-card:hover { border-color: #1f6feb; }
      .kb-card:active { cursor: grabbing; }
      .kb-card.dragging { opacity: .4; }
      .kb-card .kc-name { color: var(--text); font-weight: 700; margin-bottom: 3px; }
      .kb-card .kc-meta { color: var(--text-muted); font-size: 10px; line-height: 1.5; }
      .kb-card .kc-meta b { color: var(--text); }
      .kb-stage-aguardando_separacao { border-left: 3px solid #475569; }
      .kb-stage-em_separacao { border-left: 3px solid #fbbf24; }
      .kb-stage-aguardando_coleta, .kb-stage-transportadora_acionada { border-left: 3px solid #93c5fd; }
      .kb-stage-coletado, .kb-stage-em_transito { border-left: 3px solid #a371f7; }
      .kb-stage-saiu_para_entrega { border-left: 3px solid #fb923c; }
      .kb-stage-entregue { border-left: 3px solid #22c55e; }
      .kb-stage-problema_entrega { border-left: 3px solid #ef4444; }
      .kb-stage-finalizado { border-left: 3px solid #94a3b8; opacity: .65; }
      .kb-empty { color: var(--text-muted); text-align: center; padding: 14px; font-size: 11px; }
      /* Modal Gerenciar Etapas */
      .kbm-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,.7); z-index: 9999; align-items: center; justify-content: center; }
      .kbm-overlay.show { display: flex; }
      .kbm-modal { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; width: 720px; max-width: 95vw; max-height: 90vh; display: flex; flex-direction: column; }
      .kbm-h { padding: 14px 18px; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; }
      .kbm-h h3 { margin: 0; font-size: 14px; }
      .kbm-body { flex: 1; overflow-y: auto; padding: 14px 18px; }
      .kbm-foot { padding: 12px 18px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center; gap: 10px; }
      .kbm-row { display: grid; grid-template-columns: 28px 1fr 90px 38px 38px; gap: 8px; align-items: center; padding: 8px; background: var(--bg); border: 1px solid var(--border); border-radius: 6px; margin-bottom: 6px; cursor: grab; }
      .kbm-row.dragging { opacity: .4; }
      .kbm-row.dragover { border-color: #25D366; }
      .kbm-row .handle { color: var(--text-muted); cursor: grab; user-select: none; text-align: center; font-size: 14px; }
      .kbm-row input[type=text] { background: var(--bg); border: 1px solid var(--border); color: var(--text); padding: 6px 8px; border-radius: 4px; font-size: 12px; width: 100%; }
      .kbm-row input[type=color] { width: 100%; height: 30px; padding: 2px; border: 1px solid var(--border); border-radius: 4px; background: var(--bg); cursor: pointer; }
      .kbm-row .badge-flag { font-size: 9px; padding: 2px 5px; border-radius: 3px; background: var(--border); color: var(--text-muted); }
      .kbm-row .btn-del { background: var(--border); border: 1px solid var(--border); color: #ef4444; padding: 6px; border-radius: 4px; cursor: pointer; font-size: 14px; }
      .kbm-row .btn-del:hover { background: #ef4444; color:#fff; }

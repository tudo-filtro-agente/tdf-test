      <div style="padding:14px 18px;border-bottom:1px solid #30363D;display:flex;justify-content:space-between;align-items:center">
        <h3 style="margin:0;font-size:14px;color:#fff">📅 Agendados</h3>
        <button onclick="document.getElementById('ag-modal').remove()" style="background:#21262D;border:1px solid #30363D;color:#fff;padding:6px 10px;border-radius:6px;cursor:pointer">✕</button>
      </div>
      <div style="padding:10px 18px;border-bottom:1px solid #21262D;display:flex;gap:10px;align-items:center;flex-wrap:wrap">
        <input id="ag-search" placeholder="Buscar por cliente, cidade…" oninput="agFilter()" style="flex:1;background:#0D1117;border:1px solid #30363D;color:#fff;padding:6px 10px;border-radius:4px;font-size:12px;min-width:200px">
        <span id="ag-selected-count" style="font-size:11px;color:#888"><b id="ag-sel">0</b> selecionado(s)</span>
        <button class="btn btn-warn" onclick="agCreateRoute()">🛣 Criar rota com selecionados</button>
      </div>
      <div style="flex:1;overflow-y:auto" id="ag-list"><div style="padding:30px;text-align:center;color:#666">Carregando…</div></div>
    </div>
  `;
  AG.selected = new Set();
  await agLoad();
}

const AG = { items: [], selected: new Set() };

async function agLoad() {
  try {
    const r = await api('/operacional/api/sales?status=agendado&page_size=200');
    AG.items = r.items || [];
    agRender();
  } catch (e) {
    document.getElementById('ag-list').innerHTML = `<div style="padding:14px;color:${e.silent?'#888':'#f87171'}">${e.silent?'⏸':e.message}</div>`;
  }
}

function agFilter() { agRender(); }

function agRender() {
  const q = (document.getElementById('ag-search')?.value || '').toLowerCase();
  const filtered = q
    ? AG.items.filter(s => (s.customer_name||'').toLowerCase().includes(q) || (s.address?.city||'').toLowerCase().includes(q) || (s.product_line||'').toLowerCase().includes(q))
    : AG.items;
  const c = document.getElementById('ag-list');
  if (!filtered.length) { c.innerHTML = '<div style="padding:30px;text-align:center;color:#666;font-size:12px">Nenhum agendado</div>'; return; }
  c.innerHTML = filtered.map(s => `
    <label style="display:grid;grid-template-columns:24px 1fr auto;gap:8px;padding:8px 14px;border-bottom:1px solid #21262D;cursor:pointer;align-items:center">
      <input type="checkbox" data-sale="${s.id}" ${AG.selected.has(s.id)?'checked':''} onchange="agToggle(${s.id}, this.checked)">
      <div>
        <div style="color:#fff;font-size:12px;font-weight:700">${s.customer_name||'—'} ${s.is_condominio?'🏢':''} ${s.requires_material_pickup?'📦':''}</div>
        <div style="color:#888;font-size:10px">${(s.product_line||'').substring(0,60)} · 📍 ${s.address?.city||'—'} · ${s.service_priority||'normal'}</div>
      </div>
      <a href="/operacional/cliente/${s.id}" target="_blank" style="color:#93c5fd;text-decoration:none;font-size:11px">→ Card</a>
    </label>
  `).join('');
  document.getElementById('ag-sel').textContent = AG.selected.size;
}

function agToggle(saleId, checked) {
  if (checked) AG.selected.add(saleId); else AG.selected.delete(saleId);
  document.getElementById('ag-sel').textContent = AG.selected.size;
}

async function agCreateRoute() {
  if (!AG.selected.size) return toast('Selecione ao menos 1 agendado', 'error');
  // Abre modal Criar Rota com pré-seleção
  document.getElementById('ag-modal')?.remove();
  await newRouteOpen();
  // Sobrescreve seleção
  _newRoute.saleIds = new Set(AG.selected);
  // Marca os checkboxes no modal Criar Rota (lá ele filtra status=aguardando_rota, mas como nossos
  // selecionados são status=agendado, precisamos forçar carga via fetch direto)
  toast(`${AG.selected.size} agendados pré-selecionados. Ajuste data/técnico e salve.`);
  // Re-renderiza o nr-sales pra que apareça com os selecionados
  setTimeout(() => newRouteRender(), 100);
}


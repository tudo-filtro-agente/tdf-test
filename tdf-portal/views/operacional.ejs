              <div style="color:#aaa;font-size:11px;margin-top:2px">${rt.technician_base_city ? '📍 base: '+rt.technician_base_city : ''} · 🛠 ${(rt.technician_skills||[]).join(', ') || 'sem skills'}</div>
            </div>
            <span style="background:#22c55e;color:#000;padding:3px 8px;border-radius:4px;font-weight:800;font-size:12px">${rt.suggested_count} sale(s)</span>
          </div>
          <div style="color:#888;font-size:10px;margin-bottom:6px">🏙 ${rt.cities.join(', ')}</div>
          <div style="font-size:11px;color:#cbd5e1;padding-left:8px;border-left:2px solid #1f6feb">
            ${rt.sales.slice(0,5).map(s => `• ${s.customer_name} (${s.city})${s.required_skill?' · 🛠 '+s.required_skill:''}`).join('<br>')}
            ${rt.sales.length>5?`<br><span style="color:#666">+${rt.sales.length-5} outras</span>`:''}
          </div>
        </div>
      `).join('')}
      ${r.unassigned?.length ? `
        <div style="background:rgba(239,68,68,.1);border:1px solid #ef4444;border-radius:6px;padding:10px 14px;margin-top:8px">
          <div style="color:#fca5a5;font-weight:700;font-size:12px;margin-bottom:6px">⚠ ${r.unassigned.length} sale(s) sem técnico compatível:</div>
          ${r.unassigned.slice(0,8).map(u => `<div style="color:#cbd5e1;font-size:11px;padding:2px 0">• ${u.customer_name} (${u.city})${u.required_skill?' precisa skill: '+u.required_skill:''} — ${u.reason}</div>`).join('')}
        </div>
      ` : ''}
    `;
    document.getElementById('ad-btn-apply').disabled = false;
  } catch (e) {
    document.getElementById('ad-preview').innerHTML = `<div style="color:#f87171;padding:14px">${e.message}</div>`;
  }
}

async function adApply() {
  if (!AD.preview || !AD.preview.suggested_routes?.length) return;
  if (!confirm(`Criar ${AD.preview.suggested_routes.length} rota(s) com ${AD.preview.total_assigned} sale(s)?`)) return;
  const distributions = AD.preview.suggested_routes.map(rt => ({
    technician_id: rt.technician_id,
    sale_ids: rt.sales.map(s => s.sale_id),
  }));
  try {
    const r = await api('/operacional/api/routes/auto-distribute/apply', {
      method:'POST', body: { target_date: AD.date, distributions }
    });
    toast(`✅ ${r.routes_created} rotas criadas`);
    document.getElementById('ad-modal').remove();
    loadKpis(); loadSales();
  } catch (e) { toast(e.message, 'error'); }
}


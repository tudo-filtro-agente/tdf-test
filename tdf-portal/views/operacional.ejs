async function loadBellCount() {
  try {
    const r = await api('/operacional/api/alerts/summary');
    const el = document.getElementById('bell-count');
    if (!el) return;
    const total = r.total_open || 0;
    if (total > 0) {
      el.style.display = 'inline-block';
      el.textContent = total > 99 ? '99+' : total;
      const crit = r.by_severity?.critical || 0;
      const warn = r.by_severity?.warning || 0;
      if (crit > 0) { el.style.background = '#ef4444'; el.style.color = '#fff'; }
      else if (warn > 0) { el.style.background = '#fb923c'; el.style.color = '#fff'; }
      else { el.style.background = '#fbbf24'; el.style.color = '#000'; }
    } else {
      el.style.display = 'none';
    }
  } catch {}
}

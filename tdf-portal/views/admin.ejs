<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin — TDF Portal</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      margin: 0;
      background: #f5f7fa;
      color: #1a2332;
    }
    header {
      background: #0b3d91;
      color: white;
      padding: 1rem 2rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    header h1 { margin: 0; font-size: 1.25rem; }
    .user {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    .badge {
      background: rgba(255,255,255,0.2);
      padding: 0.25rem 0.6rem;
      border-radius: 12px;
      font-size: 0.8rem;
    }
    .badge.admin { background: #f59e0b; }
    .badge.financeiro { background: #10b981; }
    form.logout { margin: 0; }
    form.logout button {
      background: transparent;
      color: white;
      border: 1px solid rgba(255,255,255,0.3);
      padding: 0.4rem 0.8rem;
      border-radius: 6px;
      cursor: pointer;
      font-size: 0.9rem;
    }
    form.logout button:hover { background: rgba(255,255,255,0.1); }

    main {
      max-width: 1200px;
      margin: 2rem auto;
      padding: 0 2rem;
    }
    .welcome {
      background: white;
      padding: 1.5rem;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      margin-bottom: 1.5rem;
    }
    .welcome h2 { margin: 0 0 0.5rem; color: #0b3d91; }
    .welcome p { color: #5a6b85; margin: 0.25rem 0; }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1rem;
    }
    .tile {
      background: white;
      padding: 1.5rem;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.05);
      border-left: 4px solid #0b3d91;
    }
    .tile.disabled { border-left-color: #94a3b8; opacity: 0.6; }
    .tile h3 { margin: 0 0 0.5rem; font-size: 1rem; }
    .tile p { color: #5a6b85; font-size: 0.88rem; margin: 0 0 0.75rem; }
    .tile .stage {
      display: inline-block;
      background: #eef4ff;
      color: #0b3d91;
      padding: 0.2rem 0.5rem;
      border-radius: 4px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .tile.disabled .stage { background: #f1f5f9; color: #64748b; }
  </style>
</head>
<body>
  <header>
    <h1>TDF Portal — Admin</h1>
    <div class="user">
      <span class="badge <%= user.role %>"><%= user.role %></span>
      <span><%= user.username %></span>
      <form class="logout" method="POST" action="/api/auth/logout">
        <button type="submit">Sair</button>
      </form>
    </div>
  </header>

  <main>
    <div class="welcome">
      <h2>Bem-vindo, <%= user.username %>!</h2>
      <p>Logado como <strong><%= user.role %></strong> · <%= new Date().toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' }) %></p>
      <% if (user.must_reset) { %>
        <p style="color:#c33;">⚠️ Você precisa redefinir sua senha.</p>
      <% } %>
    </div>

    <div class="grid">
      <div class="tile">
        <h3>🔐 Login & Auth</h3>
        <p>Login, sessão, logout, reset de senha.</p>
        <span class="stage">Etapa 1 ✅</span>
      </div>

      <div class="tile">
        <h3>📊 BI Financeiro Multiempresa</h3>
        <p>Dashboard + 32 abas com dados das 3 empresas (Mococa, TDF, American).</p>
        <span class="stage">Etapa 3</span>
        <div style="margin-top: 12px;">
          <a href="/bi" style="display: inline-block; padding: 6px 12px; border-radius: 6px; background: #16a34a; color: white; font-weight: 500; text-decoration: none;">Abrir BI →</a>
        </div>
      </div>

      <div class="tile" id="tile-sync">
        <h3>🔄 Sincronização OMIE → Postgres</h3>
        <p>Cron que copia dados da OMIE para o banco local a cada 30min.</p>
        <span class="stage">Etapa 2</span>
        <div style="margin-top: 12px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
          <button id="btn-sync" type="button" style="padding: 6px 12px; border-radius: 6px; border: 0; background: #2563eb; color: white; cursor: pointer; font-weight: 500;">Sincronizar agora</button>
          <button id="btn-sync-mock" type="button" style="padding: 6px 12px; border-radius: 6px; border: 0; background: #f59e0b; color: white; cursor: pointer; font-weight: 500;">Sync teste (mock)</button>
          <button id="btn-sync-log" type="button" style="padding: 6px 12px; border-radius: 6px; border: 1px solid #cbd5e1; background: white; cursor: pointer;">Ver log</button>
          <button id="btn-cron" type="button" style="padding: 6px 12px; border-radius: 6px; border: 0; background: #7c3aed; color: white; cursor: pointer; font-weight: 500;">⏰ Cron</button>
          <span id="sync-status" style="font-size: 12px; color: #64748b;"></span>
        </div>
        <div id="sync-log" style="display: none; margin-top: 12px; padding: 10px; background: #f8fafc; border-radius: 6px; font-size: 12px; max-height: 240px; overflow-y: auto;"></div>
        <div id="cron-panel" style="display: none; margin-top: 12px; padding: 10px; background: #faf5ff; border-radius: 6px; font-size: 12px;"></div>
      </div>

      <% if (user.role === 'admin') { %>
        <div class="tile disabled">
          <h3>⚙️ Configurações</h3>
          <p>Empresas, OMIE, Zoho, Auvo, backups.</p>
          <span class="stage">Etapa 4</span>
        </div>

        <div class="tile disabled">
          <h3>👥 Usuários</h3>
          <p>Criar/editar usuários, papéis, permissões.</p>
          <span class="stage">Etapa 4</span>
        </div>
      <% } %>

      <div class="tile">
        <h3>📡 Diagnóstico</h3>
        <p>Healthcheck, logs, status das APIs externas.</p>
        <span class="stage">Disponível</span>
        <p style="margin-top:0.5rem; font-size:0.8rem;">
          <a href="/api/auth/me" target="_blank">/api/auth/me</a> ·
          <a href="/health" target="_blank">/health</a>
        </p>
      </div>
    </div>
  </main>

  <script>
    (function() {
      const btnSync = document.getElementById('btn-sync');
      const btnLog = document.getElementById('btn-sync-log');
      const status = document.getElementById('sync-status');
      const logDiv = document.getElementById('sync-log');
      if (!btnSync) return;

      btnSync.addEventListener('click', () => doSync(false));
      const btnMock = document.getElementById('btn-sync-mock');
      if (btnMock) btnMock.addEventListener('click', () => doSync(true));

      async function doSync(forceDry) {
        const btn = forceDry ? btnMock : btnSync;
        const originalText = btn.textContent;
        btn.disabled = true;
        btn.textContent = 'Sincronizando...';
        status.textContent = forceDry ? 'buscando dados MOCK...' : 'buscando dados OMIE real...';
        try {
          const url = '/api/bi/admin/sync' + (forceDry ? '?dry=1' : '');
          const r = await fetch(url, { method: 'POST', credentials: 'same-origin' });
          const data = await r.json();
          if (!data.ok) throw new Error(data.erro || 'erro desconhecido');
          const total = data.results.reduce((a, b) => a + b.total, 0);
          status.textContent = `✅ ${data.results.length} empresas, ${total} registros`;
          loadLog();
        } catch (e) {
          status.textContent = '❌ ' + e.message;
        } finally {
          btn.disabled = false;
          btn.textContent = originalText;
        }
      }

      async function loadLog() {
        try {
          const r = await fetch('/api/bi/admin/sync/log?limit=10', { credentials: 'same-origin' });
          const data = await r.json();
          if (!data.ok) return;
          logDiv.innerHTML = data.syncs.map(s => {
            const dur = s.duration_ms ? ` (${s.duration_ms}ms)` : '';
            const err = s.error_message ? ` — ⚠ ${s.error_message.slice(0, 80)}` : '';
            const when = s.finished_at ? new Date(s.finished_at).toLocaleString('pt-BR') : 'em andamento';
            return `<div><b>${s.empresa}</b>: ${s.status} · ${s.registros_processados || 0} regs${dur} · <span style="color:#64748b">${when}</span>${err}</div>`;
          }).join('') || '<div style="color:#64748b">Nenhum sync registrado ainda.</div>';
        } catch (e) {
          logDiv.innerHTML = 'Erro ao carregar log: ' + e.message;
        }
      }

      btnLog.addEventListener('click', () => {
        const vis = logDiv.style.display !== 'none';
        logDiv.style.display = vis ? 'none' : 'block';
        if (!vis) loadLog();
      });

      // Painel do cron
      const btnCron = document.getElementById('btn-cron');
      const cronPanel = document.getElementById('cron-panel');
      if (btnCron) {
        btnCron.addEventListener('click', () => {
          const vis = cronPanel.style.display !== 'none';
          cronPanel.style.display = vis ? 'none' : 'block';
          if (!vis) loadCronPanel();
        });
      }

      async function loadCronPanel() {
        cronPanel.innerHTML = '<div style="color:#64748b">carregando...</div>';
        try {
          const r = await fetch('/api/bi/admin/cron/status', { credentials: 'same-origin' });
          const data = await r.json();
          if (!data.ok) throw new Error(data.erro || 'erro');
          const c = data.cron;
          const lastRun = c.last_run ? new Date(c.last_run).toLocaleString('pt-BR') : 'nunca';
          const nextRun = c.next_run_estimate ? new Date(c.next_run_estimate).toLocaleString('pt-BR') : '—';
          const lastResult = c.last_result
            ? `<br>• <b>Último resultado:</b> ${c.last_result.status} (${c.last_result.total || 0} regs) em ${new Date(c.last_result.finished_at).toLocaleString('pt-BR')}`
            : '';
          const cronSyncs = data.ultimos_cron_syncs || [];
          const cronSyncsHtml = cronSyncs.length
            ? cronSyncs.map(s => `<div>• <b>${s.empresa}</b>: ${s.status} · ${s.total_db} regs · ${new Date(s.started_at).toLocaleString('pt-BR')}</div>`).join('')
            : '<div style="color:#64748b">Nenhum sync automático ainda.</div>';
          cronPanel.innerHTML = `
            <div><b>Status:</b> ${c.enabled ? '✅ ATIVO' : '⏸ PARADO'} ${c.running ? '(sincronizando agora)' : ''}</div>
            <div><b>Intervalo:</b> a cada ${c.interval_min} minutos (${c.cron_expression || '—'})</div>
            <div><b>Última execução:</b> ${lastRun}${lastResult}</div>
            <div><b>Próxima (estimada):</b> ${nextRun}</div>
            <div style="margin-top:8px; display:flex; gap:6px; flex-wrap:wrap;">
              <button id="cron-trigger" style="padding:4px 10px; border-radius:5px; border:0; background:#7c3aed; color:white; cursor:pointer;">Disparar agora</button>
              <button id="cron-stop" style="padding:4px 10px; border-radius:5px; border:1px solid #cbd5e1; background:white; cursor:pointer;">Parar</button>
              <button id="cron-start" style="padding:4px 10px; border-radius:5px; border:0; background:#16a34a; color:white; cursor:pointer;">Iniciar</button>
              <button id="cron-refresh" style="padding:4px 10px; border-radius:5px; border:1px solid #cbd5e1; background:white; cursor:pointer;">Atualizar</button>
            </div>
            <div style="margin-top:10px;"><b>Últimos syncs automáticos:</b>${cronSyncsHtml}</div>
          `;
          document.getElementById('cron-trigger').onclick = async () => {
            await fetch('/api/bi/admin/cron/trigger', { method: 'POST', credentials: 'same-origin' });
            setTimeout(loadCronPanel, 2000);
          };
          document.getElementById('cron-stop').onclick = async () => {
            await fetch('/api/bi/admin/cron/toggle?acao=stop', { method: 'POST', credentials: 'same-origin' });
            setTimeout(loadCronPanel, 500);
          };
          document.getElementById('cron-start').onclick = async () => {
            await fetch('/api/bi/admin/cron/toggle?acao=start', { method: 'POST', credentials: 'same-origin' });
            setTimeout(loadCronPanel, 500);
          };
          document.getElementById('cron-refresh').onclick = loadCronPanel;
        } catch (e) {
          cronPanel.innerHTML = '<div style="color:#dc2626">Erro: ' + e.message + '</div>';
        }
      }

      loadLog();
    })();
  </script>
</body>
</html>

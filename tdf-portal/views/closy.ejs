<% const activePage = 'closy'; const pageTitle = 'CRM Closy · Funis Zoho'; %>
<%- include('layout', { user, activePage, pageTitle }) %>

<style>
.cz-wrap{padding:14px 18px 80px;max-width:100%}
.cz-h{font-size:18px;color:var(--text);margin:0 0 4px;font-weight:800;display:flex;align-items:center;gap:10px}
.cz-h .badge-pre{display:inline-block;background:#374151;color:#9ca3af;font-size:10px;font-weight:800;padding:2px 8px;border-radius:8px;border:1px dashed #6b7280}
.cz-sub{color:var(--text-muted);font-size:12px;margin:0 0 12px}
.cz-bar{display:flex;gap:10px;align-items:center;margin-bottom:14px;flex-wrap:wrap;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;padding:10px 14px}
.cz-bar label{color:var(--text-muted);font-size:11px;text-transform:uppercase;letter-spacing:.4px;font-weight:700}
.cz-bar select,.cz-bar input{background:var(--bg-card);border:1px solid var(--border);color:var(--text);border-radius:6px;padding:7px 10px;font-size:12px;min-width:160px}
.cz-bar select:focus,.cz-bar input:focus{outline:none;border-color:#1f6feb}
.cz-bar .total{margin-left:auto;color:#1f6feb;font-weight:800;font-size:14px}

.cz-board{display:flex;gap:10px;overflow-x:auto;align-items:stretch;height:calc(100vh - 200px);padding-bottom:10px}
.cz-col{min-width:280px;max-width:320px;flex:0 0 auto;background:var(--bg-card);border:1px solid var(--border);border-radius:8px;display:flex;flex-direction:column}
.cz-col-head{padding:10px 12px;border-bottom:2px solid #1f6feb;background:var(--bg-card);border-radius:8px 8px 0 0;display:flex;align-items:center;gap:8px;cursor:help}
.cz-col-head .icon{font-size:14px}
.cz-col-head .nome{flex:1;color:var(--text);font-weight:800;font-size:11px;text-transform:uppercase;letter-spacing:.4px}
.cz-col-head .count{background:#222;color:#fff;padding:2px 8px;border-radius:8px;font-size:10px;font-weight:700}
.cz-col-head .valor{color:#22c55e;font-size:10px;font-weight:700;margin-left:6px}
.cz-col-body{flex:1;overflow-y:auto;padding:6px}
.cz-col-body::-webkit-scrollbar{width:5px}
.cz-col-body::-webkit-scrollbar-thumb{background:#333;border-radius:3px}
.cz-empty{color:#444;text-align:center;padding:18px;font-size:11px}

.cz-card{background:var(--bg-card);border:1px solid var(--border);border-radius:6px;padding:8px 10px;margin-bottom:6px;cursor:pointer;transition:all .15s;position:relative}
.cz-card:hover{background:var(--bg-hover);border-color:#1f6feb}
.cz-card .nome{color:var(--text);font-weight:700;font-size:12px;line-height:1.3;margin-bottom:4px;display:flex;align-items:center;gap:5px}
.cz-card .meta{color:var(--text-muted);font-size:10px;line-height:1.4}
.cz-card .meta .row{display:flex;gap:5px;align-items:center;margin-top:2px}
.cz-card .vlr{color:#22c55e;font-weight:700;font-size:11px}
.cz-card .tier{font-size:10px}
.cz-card .pre{display:inline-block;background:#374151;color:#9ca3af;font-size:8px;font-weight:800;padding:1px 5px;border-radius:6px;border:1px dashed #6b7280;margin-left:4px}
.cz-card .stuck-badge{display:inline-block;background:rgba(239,68,68,.18);color:#fca5a5;font-size:8px;font-weight:800;padding:1px 5px;border-radius:6px;border:1px solid rgba(239,68,68,.45);margin-left:4px}
.cz-card.stuck{border-color:rgba(239,68,68,.4);box-shadow:inset 4px 0 0 #ef4444}
.cz-card .src{display:inline-block;background:#1f2937;color:#60a5fa;font-size:8px;font-weight:700;padding:1px 5px;border-radius:6px;margin-top:3px}
.cz-card .tag{display:inline-block;background:#1f2937;color:#fbbf24;font-size:8px;font-weight:700;padding:1px 5px;border-radius:6px;margin-right:3px;margin-top:3px}

.cz-loading{padding:40px;text-align:center;color:var(--text-muted);font-size:12px}
.cz-error{padding:30px;text-align:center;color:#ef4444;font-size:12px;background:#1a0a0a;border:1px solid #4a1a1a;border-radius:8px}

/* Drawer de edição (Fase 3) — botões de ação no canto */
.cz-card .card-actions{position:absolute;top:4px;right:4px;display:flex;gap:3px;opacity:0;transition:opacity .15s;z-index:2}
.cz-card:hover .card-actions{opacity:1}
.cz-card .card-actions button{border:none;border-radius:4px;padding:2px 7px;font-size:11px;font-weight:700;cursor:pointer}
.cz-card .card-actions .edit-btn{background:rgba(31,111,235,.15);border:1px solid rgba(31,111,235,.4);color:#7cb9f5}
.cz-card .card-actions .edit-btn:hover{background:#1f6feb;color:#fff}
.cz-card .card-actions .chat-btn{background:rgba(34,197,94,.15);border:1px solid rgba(34,197,94,.4);color:#22c55e}
.cz-card .card-actions .chat-btn:hover{background:#25D366;color:#fff}

</style>

<div class="cz-wrap">
  <h1 class="cz-h">🪜 CRM Closy · Funis Zoho <span id="cz-pre-count" class="badge-pre" style="display:none">0 PRÉ-LEAD</span></h1>
  <p class="cz-sub">Espelha os funis reais do Zoho · pré-leads (Stage anterior a Qualificado) marcados em cinza</p>

  <div class="cz-bar" style="margin-bottom:8px">
    <label>📌 View</label>
    <select id="cz-view" onchange="czAplicarView()" style="min-width:240px">
      <option value="">— Sem filtro salvo —</option>
    </select>
    <button onclick="czSalvarView()" title="Salvar combinação atual de filtros como uma view nomeada" style="background:#22c55e;color:#000;border:none;padding:7px 12px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer">💾 Salvar view</button>
    <button onclick="czGerenciarViews()" title="Renomear ou apagar views salvas" style="background:#374151;color:#ddd;border:1px solid #4a5260;padding:7px 12px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer">⚙️</button>
  </div>

  <div class="cz-bar">
    <label>Funil</label>
    <select id="cz-funil" onchange="czOnFunilChange()"><option>Carregando...</option></select>
    <label>Owner</label>
    <select id="cz-owner" onchange="czCarregarDeals()">
      <option value="">Todos</option>
    </select>
    <label>Tier</label>
    <select id="cz-tier" onchange="czCarregarDeals()">
      <option value="">Todos</option>
      <option value="Diamante">💎 Diamante</option>
      <option value="Ouro">🥇 Ouro</option>
      <option value="Prata">🥈 Prata</option>
      <option value="Bronze">🥉 Bronze</option>
    </select>
    <input id="cz-busca" type="text" placeholder="buscar nome/telefone/cidade" oninput="czRender()" style="flex:1;min-width:200px">
    <button onclick="czCarregarDeals()" style="background:#1f6feb;border:none;color:#fff;padding:7px 14px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer">↻ Atualizar</button>
    <button onclick="czAbrirConfigCard()" title="Escolher quais campos aparecem nos cards" style="background:#a371f7;border:none;color:#fff;padding:7px 14px;border-radius:6px;font-size:11px;font-weight:700;cursor:pointer">⚙️ Card</button>
    <span class="total" id="cz-total">0 deals</span>
  </div>

<!-- MODAL CONFIG CARD (Fase 4) -->
<div id="cz-cardcfg" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:300;align-items:center;justify-content:center;padding:20px">
  <div style="background:var(--bg-card);border:1px solid #a371f7;border-radius:12px;padding:18px;max-width:580px;width:100%;max-height:90vh;overflow-y:auto;color:var(--text)">
    <h2 style="margin:0 0 14px;font-size:15px;display:flex;align-items:center;gap:10px">⚙️ Customizar Card do Kanban
      <button onclick="czFecharConfigCard()" style="margin-left:auto;background:#222;border:1px solid var(--border);color:#ddd;border-radius:5px;padding:4px 10px;cursor:pointer;font-size:11px">✕</button>
    </h2>
    <p style="color:var(--text-muted);font-size:11px;margin:0 0 12px">Marque os campos que devem aparecer nos cards e arraste a ordem (use os botões ▲▼).</p>
    <div id="cz-cardcfg-list" style="display:flex;flex-direction:column;gap:6px"></div>
    <div style="margin-top:14px;display:flex;justify-content:space-between;gap:8px">
      <button onclick="czRestaurarDefaultCard()" style="background:#374151;color:#ddd;border:1px solid #4a5260;border-radius:5px;padding:8px 14px;font-size:11px;font-weight:700;cursor:pointer">↺ Restaurar default</button>
      <div>
        <button onclick="czFecharConfigCard()" style="background:#222;border:1px solid var(--border);color:#ddd;border-radius:6px;padding:9px 16px;font-size:12px;font-weight:700;cursor:pointer">Cancelar</button>
        <button onclick="czSalvarConfigCard()" style="background:#22c55e;color:#000;border:none;border-radius:6px;padding:9px 16px;font-size:12px;font-weight:700;cursor:pointer">💾 Salvar</button>
      </div>
    </div>
  </div>
</div>

  <div class="cz-board" id="cz-board">
    <div class="cz-loading">⏳ Carregando funis do Zoho...</div>
  </div>
</div>

<!-- Drawer de edição agora vem do shared cliente-drawer.js (UX #4) -->
<!-- Usa window.abrirClienteDrawer(dealId, {phone, nome}) -->


<script>
const CZ_OWNERS = <%- JSON.stringify(closers || []) %>;
let _CZ_FUNIS = [];
let _CZ_FUNIL_ATIVO = null;
let _CZ_DEALS = [];

const PRE_LEAD_STAGES = /^(IA sem Contato|Leads Novos|Etapa IA|Primeiro Contato|Em Qualifica)/i;
const QUALIF_STAGES = /^(Qualificado|Proposta|Em Atendimento|Fechado)/i;

const STAGE_ICON = {
  'Leads Novos':'📋', 'IA sem Contato':'🤖', 'Etapa IA':'🤖',
  'Primeiro Contato':'☎️', 'Em Qualificação':'🔍', 'Analise ou vazão':'💧',
  'Qualificado':'✅', 'Em Atendimento':'🤝',
  'Proposta':'📨', 'Proposta Quente':'🔥', 'Proposta Fria':'❄️',
  'Fechado Ganho':'🏆', 'Fechado Perdido':'❌',
};

function czFmtMoney(v){ return v ? 'R$ '+Number(v).toLocaleString('pt-BR',{minimumFractionDigits:0,maximumFractionDigits:0}) : ''; }
function czFmtData(d){ if(!d) return ''; const x=new Date(d); return x.toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit'}); }
function czTierIcon(t){ return t==='Diamante'?'💎':t==='Ouro'?'🥇':t==='Prata'?'🥈':t==='Bronze'?'🥉':''; }
function czIsPreLead(stage, tags){
  if (Array.isArray(tags) && (tags.includes('pré-lead')||tags.includes('pre-lead'))) return true;
  return PRE_LEAD_STAGES.test(stage) && !QUALIF_STAGES.test(stage);
}

async function czInit(){
  // Popula owners
  const ownerSel = document.getElementById('cz-owner');
  for (const o of CZ_OWNERS) {
    const opt = document.createElement('option');
    opt.value = o.crmOwner || o.username; opt.textContent = o.name || o.username;
    ownerSel.appendChild(opt);
  }
  // Carrega config do card (Fase 4)
  await czCarregarCardConfig();
  // Carrega views salvas (Fase 2)
  await czCarregarViews();
  // Carrega funis
  try {
    const r = await fetch('/closy/funis');
    const d = await r.json();
    if (d.error) throw new Error(d.error);
    _CZ_FUNIS = d.funis || [];
    const sel = document.getElementById('cz-funil');
    sel.innerHTML = _CZ_FUNIS.map(f =>
      `<option value="${f.layoutId}::${f.pipelineName}">${f.isAggregate?'🌐 ':''}${f.pipelineName}${f.layoutName!=='Todos'?' · '+f.layoutName:''}</option>`
    ).join('');
    if (_CZ_FUNIS.length) {
      _CZ_FUNIL_ATIVO = _CZ_FUNIS[0];
      czCarregarDeals();
    }
  } catch(e) {
    document.getElementById('cz-board').innerHTML = `<div class="cz-error">Erro ao carregar funis: ${e.message}</div>`;
  }
}

function czOnFunilChange(){
  const v = document.getElementById('cz-funil').value;
  const [layoutId, pipelineName] = v.split('::');
  _CZ_FUNIL_ATIVO = _CZ_FUNIS.find(f => f.layoutId === layoutId && f.pipelineName === pipelineName);
  czCarregarDeals();
}

async function czCarregarDeals(){
  if (!_CZ_FUNIL_ATIVO) return;
  const board = document.getElementById('cz-board');
  board.innerHTML = '<div class="cz-loading">⏳ Carregando deals...</div>';
  try {
    const params = new URLSearchParams();
    if (_CZ_FUNIL_ATIVO.layoutId !== '_all') params.set('layout', _CZ_FUNIL_ATIVO.layoutId);
    if (_CZ_FUNIL_ATIVO.pipelineId !== '_all') params.set('pipeline', _CZ_FUNIL_ATIVO.pipelineName);
    const stages = _CZ_FUNIL_ATIVO.stages.filter(s => s.category !== 'closed' && !/Fechado/i.test(s.name)).map(s => s.name);
    if (stages.length) params.set('stages', stages.join(','));
    const owner = document.getElementById('cz-owner').value;
    if (owner) params.set('owner', owner);
    const tier = document.getElementById('cz-tier').value;
    if (tier) params.set('tier', tier);
    const r = await fetch('/closy/deals?' + params.toString());
    const d = await r.json();
    if (d.error) throw new Error(d.error);
    _CZ_DEALS = d.deals || [];
    document.getElementById('cz-total').textContent = `${_CZ_DEALS.length} deals`;
    czRender();
  } catch(e) {
    board.innerHTML = `<div class="cz-error">Erro: ${e.message}</div>`;
  }
}

function czRender(){
  if (!_CZ_FUNIL_ATIVO) return;
  const busca = (document.getElementById('cz-busca').value || '').toLowerCase();
  const filtrados = busca ? _CZ_DEALS.filter(d =>
    (d.nome||'').toLowerCase().includes(busca) ||
    (d.phone||'').includes(busca) ||
    (d.cidade||'').toLowerCase().includes(busca)
  ) : _CZ_DEALS;

  const stages = _CZ_FUNIL_ATIVO.stages.filter(s => !/Fechado/i.test(s.name));
  const porStage = {};
  for (const s of stages) porStage[s.name] = [];
  for (const d of filtrados) {
    if (porStage[d.stage]) porStage[d.stage].push(d);
  }

  let totalPre = 0;
  for (const d of filtrados) if (czIsPreLead(d.stage, d.tags)) totalPre++;
  const preCount = document.getElementById('cz-pre-count');
  if (totalPre > 0) { preCount.style.display='inline-block'; preCount.textContent = totalPre + ' PRÉ-LEAD'; }
  else preCount.style.display = 'none';

  const board = document.getElementById('cz-board');
  board.innerHTML = stages.map(s => {
    const cards = porStage[s.name] || [];
    const totalVlr = cards.reduce((acc, c) => acc + (c.amount||0), 0);
    return `
      <div class="cz-col" title="${s.category||'open'}">
        <div class="cz-col-head" title="Stage: ${s.name} · Categoria: ${s.category||'open'}">
          <span class="icon">${STAGE_ICON[s.name]||'📁'}</span>
          <span class="nome">${s.name}</span>
          <span class="count">${cards.length}</span>
          ${totalVlr>0?`<span class="valor">${czFmtMoney(totalVlr)}</span>`:''}
        </div>
        <div class="cz-col-body">
          ${cards.length === 0 ? '<div class="cz-empty">vazio</div>' : cards.slice(0, 50).map(c => czRenderCard(c)).join('')}
        </div>
      </div>
    `;
  }).join('');
}

// Render dinâmico do card baseado em _CZ_CARD_CONFIG (Fase 4)
let _CZ_CARD_CONFIG = { campos: ['cidade','amount','owner','produto','leadSource','closingDate','tags'] };
let _CZ_CARD_LABELS = {};
function czCarregarCardConfig(){
  return fetch('/closy/card-config').then(r => r.json()).then(d => {
    if (d.config?.campos?.length) _CZ_CARD_CONFIG = d.config;
    _CZ_CARD_LABELS = d.todosCampos || {};
  }).catch(() => {});
}
function czRenderField(c, key){
  if (!c[key] && c[key] !== 0) {
    if (key === 'tags' && (c.tags||[]).length > 0) {} else return '';
  }
  switch(key){
    case 'cidade': return c.cidade ? `<div class="row">📍 ${c.cidade}</div>` : '';
    case 'amount': return c.amount > 0 ? `<div class="row"><span class="vlr">${czFmtMoney(c.amount)}</span></div>` : '';
    case 'owner': return c.owner ? `<div class="row">👤 ${c.owner.split(' ')[0]}</div>` : '';
    case 'produto': return c.produto ? `<div class="row">📦 ${c.produto.slice(0,30)}</div>` : '';
    case 'leadSource': return c.leadSource ? `<div class="row"><span class="src">${c.leadSource.slice(0,28)}</span></div>` : '';
    case 'closingDate': return c.closingDate ? `<div class="row" style="color:#666;font-size:9px">📅 ${czFmtData(c.closingDate)}</div>` : '';
    case 'lastActivity': return c.lastActivity ? `<div class="row" style="color:#666;font-size:9px">⏱️ ${czFmtData(c.lastActivity)}</div>` : '';
    case 'phone': return c.phone ? `<div class="row" style="font-size:10px;color:#888">📞 <span onclick="window.copyTel&&copyTel('${c.phone.replace(/'/g,"\\'")}',this)" title="Click pra copiar" style="cursor:pointer;user-select:all;padding:1px 6px;border-radius:4px;background:rgba(34,197,94,.08);border:1px solid #22c55e44;color:#86efac;font-family:monospace">${c.phone}</span> <button onclick="window.copyTel&&copyTel('${c.phone.replace(/'/g,"\\'")}',this)" style="background:transparent;border:1px solid #30363D;color:#9ca3af;border-radius:4px;padding:1px 5px;font-size:9px;cursor:pointer" title="Copiar">📋</button></div>` : '';
    case 'pipeline': return c.pipeline ? `<div class="row" style="font-size:10px;color:#888">🪜 ${c.pipeline}</div>` : '';
    case 'layout': return c.layout ? `<div class="row" style="font-size:10px;color:#888">🗂️ ${c.layout}</div>` : '';
    case 'createdAt': return c.createdAt ? `<div class="row" style="font-size:9px;color:#666">🕐 criado ${czFmtData(c.createdAt)}</div>` : '';
    case 'daysInStage':
      if (c.daysInStage == null) return '';
      const cor = c.stuck ? '#ef4444' : (c.daysInStage >= 5 ? '#f59e0b' : '#888');
      const lbl = c.stuck ? `⚠️ ${c.daysInStage}d travado` : `⏳ ${c.daysInStage}d`;
      return `<div class="row" style="font-size:10px;color:${cor};font-weight:${c.stuck?'700':'400'}">${lbl}</div>`;
    case 'produtoVinculado':
      if (!c.produtoVinculadoNome) return '';
      return `<div class="row" style="font-size:10px;color:#7cb9f5">🔗 ${c.produtoVinculadoNome.slice(0,32)} <span style="color:#666">(${c.produtoVinculadoVidaUtil}m)</span></div>`;
    case 'tier': return c.tier ? `<div class="row">${czTierIcon(c.tier)} ${c.tier}</div>` : '';
    case 'tags':
      const tags = (c.tags||[]).filter(t => t!=='pré-lead' && t!=='pre-lead').slice(0,2);
      return tags.length ? tags.map(t => `<span class="tag">${t}</span>`).join('') : '';
    default: return '';
  }
}
function czRenderCard(c){
  const isPre = czIsPreLead(c.stage, c.tags);
  const tooltip = [
    c.nome, c.phone, c.cidade,
    c.tier ? 'Tier: '+c.tier : '',
    c.owner ? 'Owner: '+c.owner : '',
    c.leadSource ? 'Origem: '+c.leadSource : '',
    c.produto ? 'Produto: '+c.produto : '',
    c.lastActivity ? 'Última atividade: '+czFmtData(c.lastActivity) : '',
    'Click pra abrir',
  ].filter(Boolean).join('\n');
  const camposHtml = (_CZ_CARD_CONFIG.campos || []).map(k => czRenderField(c, k)).join('');
  const stuckBadge = c.stuck ? `<span class="stuck-badge" title="Travado há ${c.daysInStage} dias (limite: ${c.stageThreshold}d)">${c.daysInStage}d</span>` : '';
  return `
    <div class="cz-card${c.stuck?' stuck':''}" title="${tooltip.replace(/"/g,'&quot;')}" onclick="czAbrirDeal('${c.id}','${c.phone}','${(c.nome||'').replace(/'/g,"\\'")}')" ondblclick="event.stopPropagation();czAbrirConversa('${c.id}','${c.phone}','${(c.nome||'').replace(/'/g,"\\'")}')">
      <div class="card-actions">
        ${c.phone?`<button class="chat-btn" onclick="event.stopPropagation();czAbrirConversa('${c.id}','${c.phone}','${(c.nome||'').replace(/'/g,"\\'")}')" title="Abrir conversa WATI lado-a-lado">💬</button>`:''}
        <button class="edit-btn" onclick="event.stopPropagation();window.abrirClienteDrawer('${c.id}', { phone: '${c.phone||''}', nome: '${(c.nome||'').replace(/'/g,"\\'")}' })" title="Editar campos">✏️</button>
      </div>
      <div class="nome">
        ${c.tier?`<span class="tier" title="${c.tier}">${czTierIcon(c.tier)}</span>`:''}
        <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${c.nome||'?'}</span>
        ${isPre?'<span class="pre" title="Pré-lead — vira lead após Qualificado">PRÉ</span>':''}
        ${stuckBadge}
      </div>
      <div class="meta">${camposHtml}</div>
    </div>
  `;
}

// Modal config card
function czAbrirConfigCard(){
  const sel = new Set(_CZ_CARD_CONFIG.campos || []);
  const todos = Object.entries(_CZ_CARD_LABELS);
  const html = todos.map(([key, info]) => {
    const inIdx = (_CZ_CARD_CONFIG.campos || []).indexOf(key);
    const checked = sel.has(key);
    return `<div data-key="${key}" style="display:flex;align-items:center;gap:8px;background:#161616;border:1px solid #2a2a2a;border-radius:6px;padding:8px 10px;cursor:pointer">
      <input type="checkbox" ${checked?'checked':''} onchange="czToggleCardField('${key}', this.checked)" style="width:auto">
      <span style="font-size:14px">${info.icon}</span>
      <span style="flex:1;color:#fff;font-size:12px;font-weight:600">${info.label}</span>
      ${checked ? `
        <button onclick="czMoverCardField('${key}',-1)" style="background:#222;border:1px solid #444;color:#aaa;border-radius:4px;padding:2px 8px;font-size:10px;cursor:pointer">▲</button>
        <button onclick="czMoverCardField('${key}',1)" style="background:#222;border:1px solid #444;color:#aaa;border-radius:4px;padding:2px 8px;font-size:10px;cursor:pointer">▼</button>
        <span style="color:#7cb9f5;font-weight:800;font-size:11px;min-width:18px;text-align:center">${inIdx+1}</span>
      ` : ''}
    </div>`;
  }).join('');
  document.getElementById('cz-cardcfg-list').innerHTML = html;
  document.getElementById('cz-cardcfg').style.display = 'flex';
}
function czFecharConfigCard(){ document.getElementById('cz-cardcfg').style.display = 'none'; }
function czToggleCardField(key, checked){
  let campos = [...(_CZ_CARD_CONFIG.campos || [])];
  if (checked && !campos.includes(key)) campos.push(key);
  if (!checked) campos = campos.filter(k => k !== key);
  _CZ_CARD_CONFIG.campos = campos;
  czAbrirConfigCard(); // re-render
}
function czMoverCardField(key, delta){
  const campos = [...(_CZ_CARD_CONFIG.campos || [])];
  const idx = campos.indexOf(key);
  if (idx < 0) return;
  const newIdx = Math.max(0, Math.min(campos.length - 1, idx + delta));
  if (newIdx === idx) return;
  campos.splice(idx, 1);
  campos.splice(newIdx, 0, key);
  _CZ_CARD_CONFIG.campos = campos;
  czAbrirConfigCard();
}
function czRestaurarDefaultCard(){
  _CZ_CARD_CONFIG.campos = ['cidade','amount','owner','produto','leadSource','closingDate','tags'];
  czAbrirConfigCard();
}
// === FASE 2: CUSTOM VIEWS ===
let _CZ_VIEWS = { minhas: [], compartilhadas: [] };
async function czCarregarViews(){
  try {
    const r = await fetch('/closy/views');
    const d = await r.json();
    _CZ_VIEWS = d;
    czRenderViewSelect();
  } catch(_){}
}
function czRenderViewSelect(){
  const sel = document.getElementById('cz-view');
  if (!sel) return;
  let opts = '<option value="">— Sem filtro salvo —</option>';
  if (_CZ_VIEWS.minhas?.length) {
    opts += '<optgroup label="Minhas">';
    opts += _CZ_VIEWS.minhas.map(v => `<option value="${v.id}">${v.nome}</option>`).join('');
    opts += '</optgroup>';
  }
  if (_CZ_VIEWS.compartilhadas?.length) {
    opts += '<optgroup label="Compartilhadas">';
    opts += _CZ_VIEWS.compartilhadas.map(v => `<option value="${v.id}" data-shared="1">${v.nome} · ${v.criadoPor}</option>`).join('');
    opts += '</optgroup>';
  }
  sel.innerHTML = opts;
}
function czCapturarFiltrosAtuais(){
  const v = document.getElementById('cz-funil').value;
  const [layoutId, pipelineName] = (v || '').split('::');
  return {
    layoutId: layoutId || '',
    pipelineName: pipelineName || '',
    owner: document.getElementById('cz-owner').value || '',
    tier: document.getElementById('cz-tier').value || '',
    busca: document.getElementById('cz-busca').value || '',
  };
}
async function czAplicarView(){
  const id = document.getElementById('cz-view').value;
  if (!id) return;
  const v = [..._CZ_VIEWS.minhas, ..._CZ_VIEWS.compartilhadas].find(x => x.id === id);
  if (!v) return;
  // Aplica os filtros
  if (v.filtro.layoutId && v.filtro.pipelineName) {
    document.getElementById('cz-funil').value = v.filtro.layoutId + '::' + v.filtro.pipelineName;
    czOnFunilChange();
  }
  if (v.filtro.owner !== undefined) document.getElementById('cz-owner').value = v.filtro.owner;
  if (v.filtro.tier !== undefined) document.getElementById('cz-tier').value = v.filtro.tier;
  if (v.filtro.busca !== undefined) document.getElementById('cz-busca').value = v.filtro.busca;
  czCarregarDeals();
}
async function czSalvarView(){
  const nome = prompt('Nome da view:', '');
  if (!nome) return;
  const publica = confirm('Compartilhar com o time? (OK = todos veem · Cancelar = só você)');
  const filtro = czCapturarFiltrosAtuais();
  try {
    const r = await fetch('/closy/views', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ nome, filtro, publica }) });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    await czCarregarViews();
    document.getElementById('cz-view').value = d.view.id;
    alert('✅ View "'+nome+'" salva!');
  } catch(e) { alert('Erro: '+e.message); }
}
async function czGerenciarViews(){
  if (!_CZ_VIEWS.minhas?.length && !_CZ_VIEWS.compartilhadas?.length) {
    alert('Nenhuma view salva ainda. Configure os filtros e clique em "💾 Salvar view".');
    return;
  }
  const lista = [
    ..._CZ_VIEWS.minhas.map(v => ({...v, mine:true})),
    ..._CZ_VIEWS.compartilhadas.map(v => ({...v, mine:false})),
  ];
  const linhas = lista.map((v, i) => `${i+1}. ${v.mine?'(minha)':'(de '+v.criadoPor+')'} ${v.nome}${v.publica?' [pública]':''}`).join('\n');
  const acao = prompt(`Views salvas:\n\n${linhas}\n\nDigite o número pra DELETAR (ou cancele):`);
  if (!acao) return;
  const idx = parseInt(acao, 10) - 1;
  const v = lista[idx];
  if (!v) { alert('Número inválido'); return; }
  if (!v.mine) { alert('Não dá pra deletar view de outro usuário'); return; }
  if (!confirm('Deletar view "'+v.nome+'"?')) return;
  try {
    const r = await fetch('/closy/views/'+v.id, { method:'DELETE' });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    await czCarregarViews();
    alert('✅ View deletada');
  } catch(e) { alert('Erro: '+e.message); }
}

async function czSalvarConfigCard(){
  try {
    const r = await fetch('/closy/card-config', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ campos: _CZ_CARD_CONFIG.campos }) });
    const d = await r.json();
    if (d.error) { alert('Erro: '+d.error); return; }
    czFecharConfigCard();
    czRender();
  } catch(e) { alert('Erro: '+e.message); }
}



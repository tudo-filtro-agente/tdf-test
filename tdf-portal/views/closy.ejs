}

// Troca aba dentro do drawer (chat ↔ tarefas)
function czConvAba(aba){
  const tabChat = document.getElementById('cz-tab-chat');
  const tabTk = document.getElementById('cz-tab-tarefas');
  const msgs = document.getElementById('cz-conv-msgs');
  const tasks = document.getElementById('cz-conv-tasks');
  if (aba === 'chat') {
    tabChat.style.color = '#7cb9f5'; tabChat.style.borderBottom = '2px solid #1f6feb';
    tabTk.style.color = '#888'; tabTk.style.borderBottom = 'none';
    msgs.style.display = 'flex'; tasks.style.display = 'none';
  } else {
    tabTk.style.color = '#a371f7'; tabTk.style.borderBottom = '2px solid #a371f7';
    tabChat.style.color = '#888'; tabChat.style.borderBottom = 'none';
    msgs.style.display = 'none'; tasks.style.display = 'block';
    czCarregarTarefas();
  }
}

async function czCarregarTarefas(){
  if (!_CZ_CONV_DEAL) return;
  const wrap = document.getElementById('cz-conv-tasks');
  wrap.innerHTML = '<div style="color:#888;text-align:center;padding:20px;font-size:11px">⏳ Carregando...</div>';
  try {
    const r = await fetch('/tarefas/deal/' + _CZ_CONV_DEAL.dealId);
    const d = await r.json();
    czRenderTarefas(d);
  } catch(e) {
    wrap.innerHTML = `<div style="color:#ef4444;padding:20px">Erro: ${e.message}</div>`;
  }
}

function czRenderTarefas(d){
  const wrap = document.getElementById('cz-conv-tasks');
  const abertas = (d.tarefas || []).filter(t => t.status === 'aberta');
  const concluidas = (d.tarefas || []).filter(t => t.status === 'concluida');
  // Atualiza badge na tab
  const badge = document.getElementById('cz-tab-tarefas-count');
  if (abertas.length > 0) {
    badge.style.display = 'inline-block';
    badge.textContent = abertas.length;
  } else { badge.style.display = 'none'; }

  function renderTk(t){
    const venc = new Date(t.dataHora);
    const dataLocal = venc.toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
    const atrasada = venc.getTime() < Date.now() && t.status === 'aberta';
    return `<div style="background:#161616;border:1px solid #2a2a2a;border-radius:6px;padding:8px 10px;margin-bottom:6px;${atrasada?'border-left:3px solid #ef4444':(t.status==='concluida'?'opacity:.5;border-left:3px solid #22c55e':'border-left:3px solid #1f6feb')}">
      <div style="display:flex;align-items:flex-start;gap:6px">
        <div style="flex:1;color:#fff;font-size:12px;font-weight:600">${(t.titulo||'').replace(/</g,'&lt;')}</div>
        ${t.status==='aberta'?`<button onclick="czConcluirTarefa('${t.id}')" title="Marcar concluída" style="background:transparent;border:1px solid #22c55e;color:#22c55e;border-radius:4px;padding:2px 8px;font-size:10px;cursor:pointer">✓</button>`:'<span style="color:#22c55e;font-size:10px">✓ feita</span>'}
      </div>
      <div style="color:${atrasada?'#fca5a5':'#888'};font-size:10px;margin-top:3px">📅 ${dataLocal}${atrasada?' · ⚠️ atrasada':''}</div>
      ${t.observacao?`<div style="color:#aaa;font-size:10px;margin-top:3px;font-style:italic">${t.observacao.replace(/</g,'&lt;').slice(0,120)}</div>`:''}
      <div style="color:#666;font-size:9px;margin-top:3px">por ${t.criadoPorNome||'?'}</div>
    </div>`;
  }

  function renderNubia(ev){
    const dt = new Date(ev.at).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
    return `<div style="background:#1a0f2e;border:1px solid #4c1d95;border-radius:6px;padding:8px 10px;margin-bottom:6px">
      <div style="color:#c4a4ff;font-size:11px;font-weight:700">🤖 ${(ev.label||'').replace(/</g,'&lt;').slice(0,140)}</div>
      <div style="color:#888;font-size:10px;margin-top:3px">${dt} · ${ev.by||'Sistema'}</div>
    </div>`;
  }

  wrap.innerHTML = `
    <!-- Nova tarefa rápida -->
    <div style="background:#0d1f3a;border:1px solid #1f6feb;border-radius:8px;padding:10px;margin-bottom:14px">
      <div style="color:#7cb9f5;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px">+ Nova tarefa rápida</div>
      <input id="cz-tk-titulo" placeholder="Ex: Ligar de novo amanhã 10h" style="width:100%;background:#161616;border:1px solid #30363D;color:#fff;border-radius:5px;padding:7px 9px;font-size:12px;margin-bottom:6px">
      <div style="display:flex;gap:6px;align-items:center">
        <input id="cz-tk-data" type="datetime-local" style="flex:1;background:#161616;border:1px solid #30363D;color:#fff;border-radius:5px;padding:6px 8px;font-size:11px">
        <button onclick="czCriarTarefaRapida()" style="background:#22c55e;color:#000;border:none;border-radius:5px;padding:7px 14px;font-size:11px;font-weight:800;cursor:pointer">Criar</button>
      </div>
    </div>

    <!-- Lista tarefas -->
    <div style="margin-bottom:14px">
      <div style="color:#888;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;margin-bottom:6px">📋 Tarefas (${abertas.length} abertas)</div>
      ${abertas.length===0?'<div style="color:#444;text-align:center;padding:14px;font-size:11px;font-style:italic">sem tarefas abertas</div>':abertas.map(renderTk).join('')}
      ${concluidas.length>0?'<details style="margin-top:8px"><summary style="color:#666;font-size:10px;cursor:pointer">▸ '+concluidas.length+' concluídas</summary>'+concluidas.slice(0,5).map(renderTk).join('')+'</details>':''}
    </div>

    <!-- Núbia -->
    <div style="background:#0a0a0a;border:1px solid #4c1d95;border-radius:8px;padding:10px;margin-bottom:14px">
      <div style="display:flex;align-items:center;gap:6px;margin-bottom:8px">
        <span style="color:#a371f7;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.4px;flex:1">🤖 Núbia · histórico</span>
        <button onclick="czDispararNubiaAgora()" style="background:#7c3aed;color:#fff;border:none;border-radius:5px;padding:5px 12px;font-size:10px;font-weight:800;cursor:pointer">+ Disparar agora</button>
      </div>
      ${(d.nubia||[]).length===0?'<div style="color:#444;text-align:center;padding:14px;font-size:11px;font-style:italic">Núbia ainda não foi acionada nesse deal</div>':(d.nubia||[]).map(renderNubia).join('')}
    </div>
  `;
  // Default datetime: amanhã 10h
  const amanha = new Date(); amanha.setDate(amanha.getDate()+1); amanha.setHours(10,0,0,0);
  const iso = amanha.toISOString().slice(0,16);
  const dataInput = document.getElementById('cz-tk-data');
  if (dataInput) dataInput.value = iso;
}

async function czCriarTarefaRapida(){
  if (!_CZ_CONV_DEAL) return;
  const titulo = document.getElementById('cz-tk-titulo').value.trim();
  const dataHora = document.getElementById('cz-tk-data').value;
  if (!titulo || !dataHora) { alert('Preencha título e data'); return; }
  try {
    const r = await fetch('/tarefas', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        dealId: _CZ_CONV_DEAL.dealId,
        dealNome: _CZ_CONV_DEAL.nome,
        titulo,
        dataHora: new Date(dataHora).toISOString(),
        lembreteMin: 5,
      }),
    });
    const d = await r.json();
    if (d.error) { alert('❌ '+d.error); return; }
    document.getElementById('cz-tk-titulo').value = '';
    czCarregarTarefas();
  } catch(e) { alert('Erro: '+e.message); }
}

async function czConcluirTarefa(id){
  try {
    const r = await fetch('/tarefas/' + id + '/concluir', { method:'POST' });
    const d = await r.json();
    if (d.error) { alert('❌ '+d.error); return; }
    czCarregarTarefas();
  } catch(e) { alert('Erro: '+e.message); }
}

async function czDispararNubiaAgora(){
  if (!_CZ_CONV_DEAL) return;
  if (!confirm('🤖 Disparar Núbia (reengajamento) pra ' + (_CZ_CONV_DEAL.nome||_CZ_CONV_DEAL.phone) + '?')) return;
  try {
    const r = await fetch('/manutencao/forecast-leads/acao-massa', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        dealIds: [_CZ_CONV_DEAL.dealId],
        action: 'nubia',
        payload: { contexto: 'Disparo manual via drawer de conversa' },
      }),
    });
    const d = await r.json();
    if (d.error) { alert('❌ '+d.error); return; }
    alert('✅ Núbia disparada — verifica timeline');
    czCarregarTarefas();
  } catch(e) { alert('Erro: '+e.message); }
}

async function czCarregarMensagens(phone, silent){
  const msgsEl = document.getElementById('cz-conv-msgs');
  if (!msgsEl) return;
  if (!silent) msgsEl.innerHTML = '<div style="color:#888;text-align:center;padding:20px;font-size:12px">⏳ Carregando histórico...</div>';
  try {
    const r = await fetch('/inbox/mensagens?phone=' + encodeURIComponent(phone));
    const d = await r.json();
    if (d.error) { if (!silent) msgsEl.innerHTML = `<div style="color:#ef4444;padding:20px;text-align:center">${d.error}</div>`; return; }
    const msgs = d.mensagens || [];
    if (!msgs.length) { msgsEl.innerHTML = '<div style="color:#666;text-align:center;padding:30px;font-size:11px">Sem mensagens ainda</div>'; return; }
    const wasAtBottom = msgsEl.scrollTop + msgsEl.clientHeight >= msgsEl.scrollHeight - 30;
    const oldCount = msgsEl.querySelectorAll('.cz-conv-msg').length;
    if (silent && msgs.length === oldCount) return; // sem mudança
    msgsEl.innerHTML = msgs.map(m => {
      const isSys = m.isSystem;
      const isNos = m.owner;
      const cor = isSys ? '#374151' : (isNos ? '#005c4b' : '#1f2937');
      const align = isSys ? 'center' : (isNos ? 'flex-end' : 'flex-start');
      const maxW = isSys ? '85%' : '78%';
      const ts = m.timestamp ? new Date((m.timestamp*1000) || m.timestamp).toLocaleString('pt-BR',{timeZone:'America/Sao_Paulo',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'}) : '';
      const op = isNos && (m.operatorName || m.templateName) ? `<div style="color:#a7d2c7;font-size:9px;margin-bottom:2px">${m.operatorName||('📨 '+m.templateName)}</div>` : '';
      const checks = isNos ? (m.status === 'READ' ? ' <span style="color:#7cb9f5">✓✓</span>' : (m.status === 'DELIVERED' ? ' <span style="color:#aaa">✓✓</span>' : ' <span style="color:#aaa">✓</span>')) : '';
      return `<div class="cz-conv-msg" style="align-self:${align};max-width:${maxW};background:${cor};color:#fff;padding:7px 10px;border-radius:8px;font-size:12px;word-wrap:break-word;${isSys?'opacity:.65;font-style:italic;font-size:10px;text-align:center':''}">${op}${(m.texto||'').replace(/</g,'&lt;').replace(/\n/g,'<br>')}<div style="color:#a7d2c7;font-size:9px;margin-top:3px;text-align:right">${ts}${checks}</div></div>`;
    }).join('');
    if (wasAtBottom || !silent) msgsEl.scrollTop = msgsEl.scrollHeight;
  } catch(e) {
    if (!silent) msgsEl.innerHTML = `<div style="color:#ef4444;padding:20px">Erro: ${e.message}</div>`;
  }
}

let _CZ_CONV_MODO = 'wati'; // 'wati' | 'zapi'
function czTogglarZapi(){
  _CZ_CONV_MODO = (_CZ_CONV_MODO === 'wati') ? 'zapi' : 'wati';
  const modoEl = document.getElementById('cz-conv-modo');
  const btn = document.getElementById('cz-conv-zapi-btn');
  const aviso = document.getElementById('cz-conv-aviso');
  if (_CZ_CONV_MODO === 'zapi') {
    modoEl.style.background = 'rgba(167,113,247,.15)';
    modoEl.style.color = '#a371f7';
    modoEl.style.borderColor = 'rgba(167,113,247,.4)';
    modoEl.textContent = '📞 Modo: Z-API · sem restrição de janela 24h';
    btn.style.background = '#a371f7'; btn.style.color = '#fff';
    btn.textContent = '📞 Z-API ✓';
    aviso.textContent = '✅ Z-API: envia mesmo cliente sem responder. Mensagem chega como msg comum (não template).';
  } else {
    modoEl.style.background = 'rgba(34,197,94,.1)';
    modoEl.style.color = '#22c55e';
    modoEl.style.borderColor = 'rgba(34,197,94,.3)';
    modoEl.textContent = '📡 Modo: WATI · janela 24h';
    btn.style.background = '#22c55e'; btn.style.color = '#000';
    btn.textContent = '📞 Z-API';
    aviso.textContent = '⏰ Janela 24h: só funciona se cliente respondeu nas últimas 24h. Use Z-API ou Template fora dela.';
  }
}

async function czEnviarMsg(){
  if (!_CZ_CONV_DEAL) return;
  const inp = document.getElementById('cz-conv-input');
  const text = (inp.value || '').trim();
  if (!text) return;
  const btn = document.getElementById('cz-conv-send');
  btn.disabled = true; btn.textContent = '...';
  const url = _CZ_CONV_MODO === 'zapi' ? '/inbox/zapi-enviar' : '/inbox/responder';
  try {
    const r = await fetch(url, {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ phone: _CZ_CONV_DEAL.phone, text }),
    });
    const d = await r.json();
    if (d.error) {
      alert('❌ ' + d.error + (_CZ_CONV_MODO === 'wati' ? '\n\n💡 Tente o modo Z-API (botão 📞 Z-API) ou Templates.' : ''));
      return;
    }
    inp.value = '';
    setTimeout(() => czCarregarMensagens(_CZ_CONV_DEAL.phone, true), 500);
  } catch(e) { alert('Erro: '+e.message); }
  finally { btn.disabled = false; btn.textContent = 'Enviar'; }
}

let _CZ_TEMPLATES = null;
async function czAbrirTemplates(){
  if (!_CZ_CONV_DEAL) return;
  if (!_CZ_TEMPLATES) {
    try { const r = await fetch('/inbox/templates'); const d = await r.json(); _CZ_TEMPLATES = d.templates || d || []; } catch(_) { _CZ_TEMPLATES = []; }
  }
  if (!_CZ_TEMPLATES.length) { alert('Nenhum template WATI disponível.'); return; }
  const lista = _CZ_TEMPLATES.map((t,i) => `${i+1}. ${t.elementName||t.name}`).join('\n');
  const escolha = prompt('Escolha um template:\n\n' + lista + '\n\n(digite o número)');
  if (!escolha) return;
  const tpl = _CZ_TEMPLATES[parseInt(escolha,10) - 1];
  if (!tpl) { alert('Número inválido'); return; }
  if (!confirm('Enviar template "' + (tpl.elementName||tpl.name) + '" pra ' + _CZ_CONV_DEAL.phone + '?')) return;
  try {
    const r = await fetch('/inbox/template', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ phone: _CZ_CONV_DEAL.phone, templateName: tpl.elementName||tpl.name, params: [] }),
    });
    const d = await r.json();
    if (d.error) { alert('❌ ' + d.error); return; }
    alert('✅ Template enviado');
    setTimeout(() => czCarregarMensagens(_CZ_CONV_DEAL.phone, true), 1500);
  } catch(e) { alert('Erro: '+e.message); }
}

async function czPedirDiretor(){
  if (!_CZ_CONV_DEAL) return;
  const msgsEl = document.getElementById('cz-conv-msgs');
  const aviso = document.createElement('div');
  aviso.style.cssText = 'background:rgba(220,38,38,.12);border:1px solid rgba(220,38,38,.4);color:#fca5a5;padding:12px;border-radius:8px;margin:8px 0;font-size:11px;align-self:stretch';
  aviso.innerHTML = '🎙️ <strong>Diretor IA</strong> analisando conversa...';
  msgsEl.appendChild(aviso);
  msgsEl.scrollTop = msgsEl.scrollHeight;
  try {
    const r = await fetch('/inbox/diretor-vendas', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ phone: _CZ_CONV_DEAL.phone, dealId: _CZ_CONV_DEAL.dealId }),
    });
    const d = await r.json();
    if (d.error) {
      aviso.innerHTML = '🎙️ <strong style="color:#ef4444">Diretor IA falhou:</strong> ' + d.error;
      return;
    }
    const sugestao = d.sugestao || d.message || d.texto || JSON.stringify(d);
    aviso.innerHTML = `
      <div style="font-weight:800;color:#dc2626;font-size:11px;margin-bottom:6px">🎙️ DIRETOR IA</div>
      <div style="color:#fff;line-height:1.4">${(sugestao||'').replace(/</g,'&lt;').replace(/\n/g,'<br>')}</div>
      ${d.msgPronta ? `
        <div style="margin-top:10px;padding-top:8px;border-top:1px solid #4a1a1a">
          <div style="color:#fbbf24;font-size:10px;font-weight:700;margin-bottom:4px">✏️ Mensagem sugerida:</div>
          <div style="color:#fff;background:#161616;padding:8px;border-radius:5px;font-size:11px;line-height:1.4">${d.msgPronta.replace(/</g,'&lt;').replace(/\n/g,'<br>')}</div>
          <button onclick="document.getElementById('cz-conv-input').value=this.dataset.msg;this.parentElement.parentElement.scrollIntoView();" data-msg="${(d.msgPronta||'').replace(/"/g,'&quot;')}" style="background:#22c55e;color:#000;border:none;border-radius:5px;padding:5px 10px;font-size:10px;font-weight:800;cursor:pointer;margin-top:6px">📋 Usar essa mensagem</button>
        </div>` : ''}
    `;
  } catch(e) { aviso.innerHTML = '🎙️ <strong style="color:#ef4444">Erro:</strong> ' + e.message; }
}

czInit();
</script>

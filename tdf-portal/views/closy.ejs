function czFecharConversa(){
  const d = document.getElementById('cz-conv-drawer');
  if (d) d.style.right = '-580px';
  if (_CZ_CONV_REFRESH_TIMER) { clearInterval(_CZ_CONV_REFRESH_TIMER); _CZ_CONV_REFRESH_TIMER = null; }

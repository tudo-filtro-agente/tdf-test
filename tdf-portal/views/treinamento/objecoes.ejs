.spin-p { background: rgba(210,153,34,0.15); border-left: 4px solid #D29922; color: #D29922; }
.spin-i { background: rgba(248,81,73,0.15); border-left: 4px solid #F85149; color: #F85149; }
.spin-n { background: rgba(46,160,67,0.15); border-left: 4px solid #2EA043; color: #3FB950; }
</style>


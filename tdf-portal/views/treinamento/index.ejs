<style>
.treino-progress-bar {
  background: #161B22;
  border: 1px solid #30363D;
  border-radius: 12px;
  height: 48px;
  position: relative;
  overflow: hidden;
}
.treino-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #0066CC, #00AAFF);
  border-radius: 12px;
  transition: width 0.6s ease;
}
.treino-progress-text {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-weight: 700;
  font-size: 14px;
  color: #E6EDF3;
  text-shadow: 0 1px 4px rgba(0,0,0,0.5);
}
</style>

<script>
(function() {
  var modules = ['rapport','sondagem','gatilhos','objecoes','fechamento','pos-venda','whatsapp'];
  var done = 0;
  modules.forEach(function(m) {
    var completed = localStorage.getItem('treino_' + m) === '1';
    if (completed) {
      done++;
      var el = document.getElementById('status-' + m);
      if (el) { el.textContent = 'Concluido ✓'; el.style.color = '#3FB950'; }
    }
  });
  var pct = Math.round((done / modules.length) * 100);
  document.getElementById('progressFill').style.width = pct + '%';
  document.getElementById('progressText').textContent = done + ' de ' + modules.length + ' concluidos';
})();
</script>
